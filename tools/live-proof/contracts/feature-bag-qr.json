 "card_schema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
   "host",
   "url",
   "c",
   "svg",
   "offer",
   "commission_pct",
   "stamps_on",
   "stats"
  ],
  "additionalProperties": false,
  "properties": {
   "host": {
    "type": "string"
   },
   "url": {
    "type": "string",
    "pattern": "^https://[a-z0-9.-]+/\\?src=bag(&c=[a-z0-9-]{1,24})?$"
   },
   "c": {
    "type": [
     "string",
     "null"
    ]
   },
   "svg": {
    "type": "string",
    "pattern": "^<svg "
   },
   "offer": {
    "anyOf": [
     {
      "type": "null"
     },
     {
      "$ref": "#/$defs/offer"
     }
    ]
   },
   "commission_pct": {
    "type": [
     "integer",
     "null"
    ],
    "minimum": 1,
    "maximum": 60
   },
   "stamps_on": {
    "type": "boolean"
   },
   "stats": {
    "type": "object",
    "required": [
     "orders",
     "guests",
     "repeat",
     "direct_total",
     "saved",
     "by_campaign",
     "scans"
    ],
    "additionalProperties": false,
    "properties": {
     "orders": {
      "type": "integer",
      "minimum": 0
     },
     "guests": {
      "type": "integer",
      "minimum": 0
     },
     "repeat": {
      "type": "integer",
      "minimum": 0
     },
     "direct_total": {
      "type": "integer",
      "minimum": 0
     },
     "saved": {
      "type": [
       "integer",
       "null"
      ]
     },
     "scans": {
      "type": "null"
     },
     "by_campaign": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "c",
        "orders"
       ],
       "additionalProperties": false,
       "properties": {
        "c": {
         "type": "string"
        },
        "orders": {
         "type": "integer",
         "minimum": 0
        }
       }
      }
     }
    }
   }
  },
  "$defs": {
   "offer": {
    "oneOf": [
     {
      "type": "object",
      "required": [
       "kind",
       "value",
       "min"
      ],
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "fixed"
       },
       "value": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
       },
       "min": {
        "type": "integer",
        "minimum": 0
       }
      }
     },
     {
      "type": "object",
      "required": [
       "kind",
       "product"
      ],
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "gift"
       },
       "product": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
       }
      }
     },
     {
      "type": "object",
      "required": [
       "kind"
      ],
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "stamps"
       }
      }
     }
    ]
   }
  }
 },
