{
  "id": "feature-stock-avt",
  "name": "analytics.avt",
  "contract_version": "1.0.0",
  "class": "LIVE-NOW",
  "description": {
    "en": "Unexplained loss between two counts (W-STOCK P4): per supply a recipe names, between its last two counts, actual = opening + came in - closing, theoretical = the sales' recipe draws, explained = write-offs + prep; unexplained = actual - theoretical - explained, which equals minus the closing count's drift, valued in minor units at the average cost of that count and as per mille of the window's food sales. Top 5 losses lead; a supply counted once is 'count twice'; a supply no recipe names is 'not tracked', never a loss.",
    "uk": "Непояснені втрати між двома інвентаризаціями, у леках, топ-5 із записами; без техкарти - не відстежується, ніколи не втрата."
  },
  "producer": {
    "file": "workers/api/src/services/analytics/kitchen/avt.rs",
    "line": 154,
    "what": "report(): the avt block, added to the kitchen numbers by kitchen/report.rs avt_of"
  },
  "consumer": {
    "file": "workers/api/public/admin/ingredients-loss.js",
    "line": 12,
    "what": "open(): the Losses sheet (Ingredients > Losses), drawn by ingredients-loss-view.js"
  },
