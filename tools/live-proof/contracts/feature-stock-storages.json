{
  "id": "feature-stock-storages",
  "name": "stock.storages",
  "contract_version": "1.0.0",
  "class": "LIVE-NOW",
  "description": {
    "en": "Named storages per venue (P12, W-STORE): kitchen, bar and freezer built in, more named by the owner; a storage is renamed or archived (never deleted, refused while it holds stock). A transfer {item, qty, from, to} is a NOTE on the stock log: it never makes or destroys stock (ledger, cost, lots, carry and old checkpoints byte-equal); per-storage levels are a fold of each record's on_hand delta into the record's `store` key, else the storage that last received the item (Poster's rule), else kitchen -- so the storages always sum to onHand. Every record written before storages is the kitchen's. A delivery, write-off, prep or count may name its storage (`store`); a count in one storage tells the shelf that storage plus every other one. Read back in GET /api/owner/stock: `storages` and each supply's `byStore {stores, home}`.",
    "uk": "Склади закладу (кухня, бар, морозильник і свої): переміщення ніколи не створює і не знищує залишок; залишок по складах — згортка журналу, старі образи без змін."
  },
  "producer": {
    "file": "workers/api/src/services/operations/stock/storages.rs",
    "line": 78,
    "what": "run(): kinds storage / moved -> dowiz_hub StockLog::put_storage / move_stock (crates/dowiz-hub/src/stock/storages.rs)"
  },
  "consumer": {
    "file": "workers/api/public/admin/stock-storages.js",
    "line": 14,
    "what": "open(): storage filter, per-storage rows, Move sheet (openMove line 47), count of one storage, storage cards; ingredients.js openMove sends `store` and `treated`"
  },
  "transport": [
    {
      "method": "POST",
      "path": "/api/owner/stock/moved",
      "body": "{item, qty, from, to}"
    },
    {
      "method": "POST",
      "path": "/api/owner/stock/storage",
      "body": "{card: {id?, name, archived?}}"
    },
    {
      "method": "POST",
      "path": "/api/owner/stock/received|wasted|stocktake|count|produced",
      "body": "... plus store?: <storage id>, received also treated?: <paper no.>"
    },
    {
      "method": "GET",
      "path": "/api/owner/stock",
      "field": "storages, supplies[].byStore"
    }
  ],
  "external": null,
  "auth": {
