// R-SPIKE: oracle check -- the closed form after 20 carried reps must equal the loop after 20 carried reps.
// Returns closed - loop (0 = agree) * 1 + loop * 0... bebop main returns one i64: we return the loop value
// when they agree and -1 when they do not.
fn mmul(a: [i64], b: [i64], r: [i64]) -> i64 {
  let i = 0;
  while i < 3 {
    let j = 0;
    while j < 3 {
      let _ = r[i * 3 + j] = a[i * 3] * b[j] + a[i * 3 + 1] * b[3 + j] + a[i * 3 + 2] * b[6 + j];
      let j = j + 1;
      0
    };
    let i = i + 1;
    0
  };
  0
}
fn copy9(src: [i64], dst: [i64]) -> i64 {
  let i = 0;
  while i < 9 { let _ = dst[i] = src[i]; let i = i + 1; 0 };
  0
}
fn ident9(r: [i64]) -> i64 {
  let i = 0;
  while i < 9 { let _ = r[i] = 0; let i = i + 1; 0 };
  let _ = r[0] = 1; let _ = r[4] = 1; let _ = r[8] = 1;
  0
}
fn setm(m: [i64]) -> i64 {
  let _ = m[0] = 3; let _ = m[1] = 1; let _ = m[2] = 0;
  let _ = m[3] = 0; let _ = m[4] = 1; let _ = m[5] = 0 - 1;
  let _ = m[6] = 0; let _ = m[7] = 0; let _ = m[8] = 1;
  0
}
fn step_r(r: [i64], m: [i64], t: [i64]) -> i64 { let _ = mmul(r, m, t); copy9(t, r) }
fn closed(s0: i64, n: i64, m: [i64], r: [i64], t: [i64]) -> i64 {
  let _ = setm(m);
  let _ = ident9(r);
  let e = n;
  while e > 0 {
    let odd = e & 1;
    let _ = if odd == 1 then step_r(r, m, t) else 0;
    let _ = mmul(m, m, t);
    let _ = copy9(t, m);
    let e = e >> 1;
    0
  };
  r[0] * s0 + r[1] * n + r[2]
}
fn main() -> i64 {
  let m = zeros(9);
  let r = zeros(9);
  let t = zeros(9);
  let s = 0;
  let c = 0;
  let rep = 20;
  while rep > 0 {
    let i = 1000000;
    while i > 0 { let s = s * 3 + i; let i = i - 1; 0 };
    let c = closed(c, 1000000, m, r, t);
    let rep = rep - 1;
    0
  };
  if s == c then s else 0 - 1
}
