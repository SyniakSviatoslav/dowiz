use "selfhost/std/block.bp"
// bench/vs_rust/std_tests/block_schema.bp -- `gate block_schema` (row DG9, SPEC-DATALOG-AND-CODEC B-2):
// bebop's copy of the §B.4 schema table (selfhost/std/block.bp bk_table), printed as
//   schema <name> k64=<hex> <string>
// -- the line DG7's table (crates/dowiz-hub/examples/block_read.rs --schemas) and oracle.py --schemas
// print; crates/bebop-wasm/gate.sh compares the three. Returns the keys folded acc*31 + K64.

module core { }

fn main() -> i64 {
  let t = zeros(320);
  let s = zeros(1024);
  let o = zeros(512);
  let n = bk_table(t, s);
  let acc = 0;
  let i = 0;
  while i < n {
    let r = 64 * i;
    let p = bk_puts(o, 0, "schema ");
    let p = bk_putcells(o, p, s, t[r + 3], t[r + 4]);
    let p = bk_puthex(o, bk_puts(o, p, " k64="), t[r], 16);
    let _ = o[p] = 32;
    let st = t[r + 3];
    let en = if i < n - 1 then t[r + 64 + 3] else t[256];
    let p = bk_putcells(o, p + 1, s, st, en - st);
    let _ = o[p] = 10;
    let _ = sys_write(1, o, p + 1);
    let acc = acc * 31 + t[r];
    let i = i + 1;
    0
  };
  acc
}
