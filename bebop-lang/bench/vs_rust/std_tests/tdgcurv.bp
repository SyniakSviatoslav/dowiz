// selfhost/prelude/fp.bp — Q32 fixed-point core shared by every fp gate (T38).
// Textual include: a gate whose first line is `// prelude: fp ...` gets this file
// prepended by tools/gen_selfsrc.sh std (L9 mechanism until T47 `use`).
// fp_mul: signed 64x64 -> Q32 product via 32/16-bit limbs (no i128, no >> on
// negatives); isqrt: digit-by-digit integer sqrt over bits 60..0.
fn fp_mul(a: i64, b: i64) -> i64 {
  let na = if a < 0 then 1 else 0;
  let aa = if na == 1 then 0 - a else a;
  let nb = if b < 0 then 1 else 0;
  let ab = if nb == 1 then 0 - b else b;
  let a1 = aa >> 32;
  let a0 = aa - (a1 << 32);
  let b1 = ab >> 32;
  let b0 = ab - (b1 << 32);
  let hi = a1 * b1;
  let mid = a1 * b0 + a0 * b1;
  let ah = a0 >> 16;
  let al = a0 - (ah << 16);
  let bh = b0 >> 16;
  let bl = b0 - (bh << 16);
  let ll_h = ah * bh;
  let ll_m = ah * bl + al * bh;
  let ll_l = al * bl;
  let low = ll_h + ((ll_m + (ll_l >> 16)) >> 16);
  let p = (hi << 32) + mid + low;
  let flip = na + nb;
  let flip = flip - (flip / 2) * 2;
  let p = if flip == 1 then 0 - p else p;
  p
}
fn isqrt(s: i64) -> i64 {
  let rem = 0;
  let root = 0;
  let i = 0;
  while i < 31 {
    let sh = 60 - i * 2;
    let rem = (rem << 2) + ((s >> sh) & 3);
    let tst = (root << 2) + 1;
    let take = if tst <= rem then 1 else 0;
    let root = (root << 1) + take;
    let rem = rem - take * tst;
    let i = i + 1;
    0
  };
  root
}
// prelude: fp
module core { }

// tdgcurv.bp — T18: Riemann R^i_jkl from Christoffel Γ (+ tabulated ∂Γ),
// Ricci R_jl = R^i_jil, scalar R = g^jl R_jl, sectional K(x,y). n = 2,
// i64 fixed-point 2^32 (fp_mul verbatim). Geometry: unit 2-sphere S² in
// (θ, φ), g = diag(1, sin²θ), Γ^θ_φφ = -sinθcosθ, Γ^φ_θφ = Γ^φ_φθ = cotθ,
// ∂_θ Γ^θ_φφ = -(cos²-sin²), ∂_θ Γ^φ_θφ = -csc²θ (closed-form derivative
// evaluated in fp; all φ-derivatives 0). Table: θ ∈ {π/6, π/4, π/3, π/2}
// as fp (sinθ, cosθ, cscθ) via isqrt — no division anywhere.
// Convention R^i_jkl = ∂_k Γ^i_lj - ∂_l Γ^i_kj + Γ^i_km Γ^m_lj - Γ^i_lm Γ^m_kj;
// K = R_ijkl x^i y^j x^k y^l / (xx*yy - xy²) (mirror of dowiz-core
// academia_p2p.rs sectional_curvature: numerator contraction + Gram denom).
// Known values (not invented): scalar R = 2, K = 1 at EVERY point of S²,
// checked as |R - 2| < 2^-16 and |num - denom| < 2^-16 (K=1 without a div).
// Fold = okcount*10^15 + Σ_p (num_p>>12)*10^8 + Σ_p (R_p>>12) == python oracle.

fn fill(a: [i64], n: i64, v: i64) -> i64 {
  let i = 0;
  while i < n {
    let _ = a[i] = v;
    let i = i + 1;
    0
  };
  0
}

// gg[0..4] = g_ij, gg[4..8] = g^ij; gam[i*4+j*2+k] = Γ^i_jk;
// dgam[m*8+i*4+j*2+k] = ∂_m Γ^i_jk.
fn setup(s: i64, c: i64, cs: i64, gg: [i64], gam: [i64], dgam: [i64]) -> i64 {
  let one = 4294967296;
  let _ = fill(gg, 8, 0);
  let _ = fill(gam, 8, 0);
  let _ = fill(dgam, 16, 0);
  let _ = gg[0] = one;
  let _ = gg[3] = fp_mul(s, s);
  let _ = gg[4] = one;
  let _ = gg[7] = fp_mul(cs, cs);
  let cot = fp_mul(c, cs);
  let _ = gam[3] = 0 - fp_mul(s, c);
  let _ = gam[5] = cot;
  let _ = gam[6] = cot;
  let _ = dgam[3] = fp_mul(s, s) - fp_mul(c, c);
  let csc2 = 0 - fp_mul(cs, cs);
  let _ = dgam[5] = csc2;
  let _ = dgam[6] = csc2;
  0
}

// riem[i*8+j*4+k*2+l] = R^i_jkl
fn riemann(gam: [i64], dgam: [i64], riem: [i64]) -> i64 {
  let i = 0;
  while i < 2 {
    let j = 0;
    while j < 2 {
      let k = 0;
      while k < 2 {
        let l = 0;
        while l < 2 {
          let r = dgam[k * 8 + i * 4 + l * 2 + j] - dgam[l * 8 + i * 4 + k * 2 + j];
          let m = 0;
          while m < 2 {
            let r = r + fp_mul(gam[i * 4 + k * 2 + m], gam[m * 4 + l * 2 + j]) - fp_mul(gam[i * 4 + l * 2 + m], gam[m * 4 + k * 2 + j]);
            let m = m + 1;
            0
          };
          let _ = riem[i * 8 + j * 4 + k * 2 + l] = r;
          let l = l + 1;
          0
        };
        let k = k + 1;
        0
      };
      let j = j + 1;
      0
    };
    let i = i + 1;
    0
  };
  0
}

// ric[j*2+l] = R^i_jil ; returns scalar R = g^jl R_jl
fn ricci_scalar(gg: [i64], riem: [i64], ric: [i64]) -> i64 {
  let j = 0;
  while j < 2 {
    let l = 0;
    while l < 2 {
      let _ = ric[j * 2 + l] = riem[j * 4 + l] + riem[8 + j * 4 + 2 + l];
      let l = l + 1;
      0
    };
    let j = j + 1;
    0
  };
  let sc = 0;
  let t = 0;
  while t < 4 {
    let sc = sc + fp_mul(gg[4 + t], ric[t]);
    let t = t + 1;
    0
  };
  sc
}

// numerator R_ijkl x^i y^j x^k y^l with R_ijkl = g_im R^m_jkl; xy[0..2]=x, xy[2..4]=y
fn sec_num(gg: [i64], riem: [i64], xy: [i64]) -> i64 {
  let num = 0;
  let i = 0;
  while i < 2 {
    let j = 0;
    while j < 2 {
      let k = 0;
      while k < 2 {
        let l = 0;
        while l < 2 {
          let low = fp_mul(gg[i * 2], riem[j * 4 + k * 2 + l]) + fp_mul(gg[i * 2 + 1], riem[8 + j * 4 + k * 2 + l]);
          let w = fp_mul(fp_mul(xy[i], xy[2 + j]), fp_mul(xy[k], xy[2 + l]));
          let num = num + fp_mul(low, w);
          let l = l + 1;
          0
        };
        let k = k + 1;
        0
      };
      let j = j + 1;
      0
    };
    let i = i + 1;
    0
  };
  num
}

fn gram(gg: [i64], xy: [i64], a: i64, b: i64) -> i64 {
  let acc = 0;
  let i = 0;
  while i < 2 {
    let j = 0;
    while j < 2 {
      let acc = acc + fp_mul(gg[i * 2 + j], fp_mul(xy[a + i], xy[b + j]));
      let j = j + 1;
      0
    };
    let i = i + 1;
    0
  };
  acc
}

fn point(s: i64, c: i64, cs: i64, gg: [i64], gam: [i64], dgam: [i64], riem: [i64], ric: [i64], xy: [i64]) -> i64 {
  let one = 4294967296;
  let eps = 65536;
  let _ = setup(s, c, cs, gg, gam, dgam);
  let _ = riemann(gam, dgam, riem);
  let sc = ricci_scalar(gg, riem, ric);
  let num = sec_num(gg, riem, xy);
  let xx = gram(gg, xy, 0, 0);
  let yy = gram(gg, xy, 2, 2);
  let xyg = gram(gg, xy, 0, 2);
  let den = fp_mul(xx, yy) - fp_mul(xyg, xyg);
  let e1 = sc - 2 * one;
  let e1 = if e1 < 0 then 0 - e1 else e1;
  let e2 = num - den;
  let e2 = if e2 < 0 then 0 - e2 else e2;
  let ok = (if e1 < eps then 1 else 0) * (if e2 < eps then 1 else 0);
  let asc = if sc < 0 then 0 - sc else sc;
  let anum = if num < 0 then 0 - num else num;
  ok * 1000000000000000 + (anum >> 12) * 100000000 + (asc >> 12)
}

fn main() -> i64 {
  let tab = [2147483648, 3719550786, 8589934592, 3037000499, 3037000499, 6074000999, 3719550786, 2147483648, 4959401049, 4294967296, 0, 4294967296];
  let gg = zeros(8);
  let gam = zeros(8);
  let dgam = zeros(16);
  let riem = zeros(16);
  let ric = zeros(4);
  let xy = [4294967296, 0, 0, 4294967296];
  let fold = 0;
  let p = 0;
  while p < 4 {
    let fold = fold + point(tab[p * 3], tab[p * 3 + 1], tab[p * 3 + 2], gg, gam, dgam, riem, ric, xy);
    let p = p + 1;
    0
  };
  fold
}
