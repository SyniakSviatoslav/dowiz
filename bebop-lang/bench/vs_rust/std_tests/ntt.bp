// ntt.bp — Self-contained std twin for the MESO-tier gate: NTT forward/inverse
// over i64 modulo MOD = 998244353 = 2^23 * 119 + 1, primitive root 3.
// Exact finite-field arithmetic: every intermediate product < MOD^2 fits i64.
// Gate (word*1000 + ok):
//   word = 141 — sign binarization of the centered spectrum of the ramp
//          [1..8] (bits 0,2,3,7 set ↔ cells +36, +346334868, +201631260, +103943341)
//          goldens: centered_spectrum = [36, -103943349, 346334868, 201631260, -4,
//          -201631268, -346334876, 103943341] (oracle: Python NTT over MOD)
//   ok   = 1 if NTT(ramp)∘NTT⁻¹ == ramp (exact roundtrip)
//        + 2 if circular convolution of ramp ⊛ reverse(ramp) == [176, 156, 144,
//          140, 144, 156, 176, 204] (computed by NTT multiply-then-invert).

module core { }

// rem: least non-negative residue of x modulo m (m > 0). Result in [0, m).
fn rem(x: i64, m: i64) -> i64 {
  let r = x - (x / m) * m;
  if r < 0 then r + m else r
}

// mod_mul: (a * b) mod m. Operands are reduced first; (m-1)^2 must fit i64.
fn mod_mul(a: i64, b: i64, m: i64) -> i64 {
  rem(rem(a, m) * rem(b, m), m)
}

// mod_pow: base^exp mod m via square-and-multiply (exp >= 0). Result in [0, m).
fn mod_pow(base: i64, exp: i64, m: i64) -> i64 {
  let b = rem(base, m);
  let e = exp;
  let r = 1;
  while e != 0 {
    let r = if e - (e / 2) * 2 == 1 then rem(r * b, m) else r;
    let b = rem(b * b, m);
    let e = e / 2;
    0
  };
  r
}

// mod_inv: multiplicative inverse of a modulo m via Fermat's little theorem
// (m prime): a^(m-2) mod m. Returns 0 when a == 0 (never used for the roots).
fn mod_inv(a: i64, m: i64) -> i64 {
  mod_pow(a, m - 2, m)
}

// ntt: in-place iterative forward NTT over MOD. a[0..n) holds the data, n must
// be a power of two; elements are reduced into [0, MOD) on input. Returns 0.
fn ntt(a: [i64], n: i64) -> i64 {
  let m = 998244353;
  let i = 0;
  while i < n {
    let _ = a[i] = rem(a[i], m);
    let i = i + 1;
    0
  };
  let i = 1;
  while i < n {
    let x = i;
    let rev = 0;
    let place = n / 2;
    while place > 0 {
      let lb = x - (x / 2) * 2;
      let rev = if lb == 1 then rev + place else rev;
      let x = x / 2;
      let place = place / 2;
      0
    };
    let _ = if i < rev then (let t = a[i]; let _ = a[i] = a[rev]; let _ = a[rev] = t; 0) else 0;
    let i = i + 1;
    0
  };
  let len = 2;
  while len <= n {
    let root = mod_pow(3, (m - 1) / len, m);
    let i = 0;
    while i < n {
      let w = 1;
      let j = 0;
      let half = len / 2;
      while j < half {
        let u = a[i + j];
        let v = mod_mul(a[i + j + half], w, m);
        let uv = u + v;
        let x0 = if uv >= m then uv - m else uv;
        let _ = a[i + j] = x0;
        let x1 = if u >= v then u - v else u + m - v;
        let _ = a[i + j + half] = x1;
        let w = mod_mul(w, root, m);
        let j = j + 1;
        0
      };
      let i = i + len;
      0
    };
    let len = len * 2;
    0
  };
  0
}

// ntt_inv: in-place iterative inverse NTT over MOD. Mirrors ntt but walks the
// butterfly with inverse roots and finally scales by n^-1, so that
// ntt_inv(a, n) after ntt(a, n) restores the original cells exactly.
// Straight-line body only (no conditional block) per L1 law. Returns 0.
fn ntt_inv(a: [i64], n: i64) -> i64 {
  let m = 998244353;
  let i = 0;
  while i < n {
    let _ = a[i] = rem(a[i], m);
    let i = i + 1;
    0
  };
  let i = 1;
  while i < n {
    let x = i;
    let rev = 0;
    let place = n / 2;
    while place > 0 {
      let lb = x - (x / 2) * 2;
      let rev = if lb == 1 then rev + place else rev;
      let x = x / 2;
      let place = place / 2;
      0
    };
    let _ = if i < rev then (let t = a[i]; let _ = a[i] = a[rev]; let _ = a[rev] = t; 0) else 0;
    let i = i + 1;
    0
  };
  let len = 2;
  while len <= n {
    let root = mod_pow(3, (m - 1) / len, m);
    let wlen = mod_inv(root, m);
    let i = 0;
    while i < n {
      let w = 1;
      let j = 0;
      let half = len / 2;
      while j < half {
        let u = a[i + j];
        let v = mod_mul(a[i + j + half], w, m);
        let uv = u + v;
        let x0 = if uv >= m then uv - m else uv;
        let _ = a[i + j] = x0;
        let x1 = if u >= v then u - v else u + m - v;
        let _ = a[i + j + half] = x1;
        let w = mod_mul(w, wlen, m);
        let j = j + 1;
        0
      };
      let i = i + len;
      0
    };
    let len = len * 2;
    0
  };
  let invn = mod_inv(n, m);
  let i = 0;
  while i < n {
    let _ = a[i] = mod_mul(a[i], invn, m);
    let i = i + 1;
    0
  };
  0
}

// centered: map a residue in [0, MOD) back to the signed range (-MOD/2, MOD/2],
// so a correlation result round-trips its sign through the NTT.
fn centered(v: i64) -> i64 {
  let m = 998244353;
  let r = rem(v, m);
  if r > m / 2 then r - m else r
}

fn main() -> i64 {
  let a = zeros(8);
  let _ = a[0] = 1;
  let _ = a[1] = 2;
  let _ = a[2] = 3;
  let _ = a[3] = 4;
  let _ = a[4] = 5;
  let _ = a[5] = 6;
  let _ = a[6] = 7;
  let _ = a[7] = 8;
  let _ = ntt(a, 8);
  let w = (if centered(a[0]) > 0 then 1 else 0) + (if centered(a[1]) > 0 then 2 else 0) + (if centered(a[2]) > 0 then 4 else 0) + (if centered(a[3]) > 0 then 8 else 0) + (if centered(a[4]) > 0 then 16 else 0) + (if centered(a[5]) > 0 then 32 else 0) + (if centered(a[6]) > 0 then 64 else 0) + (if centered(a[7]) > 0 then 128 else 0);
  let _ = ntt_inv(a, 8);
  let rt = (if a[0] == 1 then 1 else 0) + (if a[1] == 2 then 1 else 0) + (if a[2] == 3 then 1 else 0) + (if a[3] == 4 then 1 else 0) + (if a[4] == 5 then 1 else 0) + (if a[5] == 6 then 1 else 0) + (if a[6] == 7 then 1 else 0) + (if a[7] == 8 then 1 else 0);
  let b = zeros(8);
  let _ = b[0] = 8;
  let _ = b[1] = 7;
  let _ = b[2] = 6;
  let _ = b[3] = 5;
  let _ = b[4] = 4;
  let _ = b[5] = 3;
  let _ = b[6] = 2;
  let _ = b[7] = 1;
  let _ = ntt(b, 8);
  let _ = ntt(a, 8);
  let c = zeros(8);
  let i = 0;
  while i < 8 {
    let _ = c[i] = mod_mul(a[i], b[i], 998244353);
    let i = i + 1;
    0
  };
  let _ = ntt_inv(c, 8);
  let cv = (if centered(c[0]) == 176 then 1 else 0) + (if centered(c[1]) == 156 then 1 else 0) + (if centered(c[2]) == 144 then 1 else 0) + (if centered(c[3]) == 140 then 1 else 0) + (if centered(c[4]) == 144 then 1 else 0) + (if centered(c[5]) == 156 then 1 else 0) + (if centered(c[6]) == 176 then 1 else 0) + (if centered(c[7]) == 204 then 1 else 0);
  let ok = (if rt == 8 then 1 else 0) + (if cv == 8 then 2 else 0);
  w * 1000 + ok
}