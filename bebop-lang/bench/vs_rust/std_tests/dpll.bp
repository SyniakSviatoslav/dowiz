// dpll.bp — T86: bounded bit-vector DPLL in Bebop, zero deps. Formulas
// are CNF over <=16 boolean vars; a clause is one (pos, neg) bitmask pair,
// a partial assignment is (A assigned-mask, V value-mask, V subset A).
// Unit propagation = in-order passes over the clauses until A stops
// changing or a clause is falsified (branch-free multiply-select
// updates); branching = lowest unassigned var, TRUE first, on an explicit
// stack (identical visit order to the recursive DFS). Step budget 2000
// pops per instance (-1 = budget out, honest UNKNOWN). Table: 20
// instances, 10 SAT (model V returned as V+1) + 10 UNSAT (pigeonhole
// 3->2 and 4->3, odd-cycle 2-colouring, parity, full 3-var cube, 16-var
// implication chains). Fold = fold_k (fold*1000003 + (r+2)*4096 + nodes)
// mod 1000000007 == bench/oracles/dpll.py (same encoding + search order).

// one unit-propagation fixpoint: st[0]=A, st[1]=V in/out; returns
// conflict*1024 + number of satisfied clauses.
fn prop(cl: [i64], lo: i64, hi: i64, st: [i64]) -> i64 {
  let full = 65535;
  let go = 1;
  let conf = 0;
  let ns = 0;
  while go == 1 {
    let a0 = st[0];
    let conf = 0;
    let ns = 0;
    let c = lo;
    while c < hi {
      let p = cl[c * 2];
      let n = cl[c * 2 + 1];
      let av = st[0];
      let vv = st[1];
      let sat = if ((p & vv) | (n & av & (full ^ vv))) != 0 then 1 else 0;
      let unl = (p | n) & (full ^ av);
      let one = (if unl != 0 then 1 else 0) * (if (unl & (unl - 1)) == 0 then 1 else 0);
      let unit = (1 - sat) * one;
      let _ = st[0] = av | (unl * unit);
      let _ = st[1] = vv | ((unl & p) * unit);
      let conf = conf + (1 - sat) * (if unl == 0 then 1 else 0);
      let ns = ns + sat;
      let c = c + 1;
      0
    };
    let go = (if st[0] != a0 then 1 else 0) * (if conf == 0 then 1 else 0);
    let _ = st[2] = conf;
    let _ = st[3] = ns;
    0
  };
  st[2] * 1024 + st[3]
}

// DFS over an explicit stack of (A, V) alternatives. Returns
// r*4096 + nodes with r in {-1 unknown, 0 unsat, V+1 sat}.
fn solve(cl: [i64], lo: i64, hi: i64, nv: i64, st: [i64], sk: [i64]) -> i64 {
  let full = (1 << nv) - 1;
  let nc = hi - lo;
  let _ = sk[0] = 0;
  let _ = sk[1] = 0;
  let sp = 1;
  let res = 0;
  let nodes = 0;
  while (sp > 0) * (if res == 0 then 1 else 0) * (if nodes < 2000 then 1 else 0) == 1 {
    let sp = sp - 1;
    let _ = st[0] = sk[sp * 2];
    let _ = st[1] = sk[sp * 2 + 1];
    let nodes = nodes + 1;
    let pr = prop(cl, lo, hi, st);
    let av = st[0];
    let vv = st[1];
    let conf = pr / 1024;
    let ns = pr & 1023;
    let issat = (if conf == 0 then 1 else 0) * (if ns == nc then 1 else 0);
    let open = (if conf == 0 then 1 else 0) * (if ns < nc then 1 else 0);
    let res = res + (vv + 1) * issat;
    let fr = full ^ av;
    let u = fr & (0 - fr);
    let _ = sk[sp * 2] = av | u;
    let _ = sk[sp * 2 + 1] = vv;
    let _ = sk[sp * 2 + 2] = av | u;
    let _ = sk[sp * 2 + 3] = vv | u;
    let sp = sp + 2 * open;
    0
  };
  let unk = (if res == 0 then 1 else 0) * (if sp > 0 then 1 else 0) * (if nodes >= 2000 then 1 else 0);
  let r = res - unk;
  r * 4096 + nodes
}

fn main() -> i64 {
  let cl = [1, 0, 3, 0, 2, 1, 1, 0, 2, 1, 4, 2, 8, 4, 7, 0, 2, 1, 4, 2, 0, 5, 3, 0, 12, 0, 0, 5, 0, 10, 3, 0, 6, 0, 12, 0, 24, 0, 48, 0, 96, 0, 192, 0, 129, 0, 1, 2, 2, 4, 4, 8, 8, 16, 16, 32, 32, 64, 64, 128, 128, 256, 256, 512, 512, 1024, 1024, 2048, 2048, 4096, 4096, 8192, 8192, 16384, 16384, 32768, 32768, 0, 3, 0, 0, 3, 6, 0, 3, 0, 0, 3, 6, 0, 0, 6, 12, 0, 0, 12, 24, 0, 0, 24, 0, 3, 0, 6, 0, 12, 5, 0, 1, 0, 0, 1, 3, 0, 2, 1, 1, 2, 0, 3, 3, 0, 12, 0, 48, 0, 0, 5, 0, 17, 0, 20, 0, 10, 0, 34, 0, 40, 7, 0, 3, 4, 5, 2, 1, 6, 6, 1, 2, 5, 4, 3, 0, 7, 1, 0, 2, 1, 4, 2, 8, 4, 0, 8, 3, 0, 0, 3, 6, 0, 0, 6, 5, 0, 0, 5, 7, 0, 56, 0, 448, 0, 3584, 0, 0, 9, 0, 65, 0, 513, 0, 72, 0, 520, 0, 576, 0, 18, 0, 130, 0, 1026, 0, 144, 0, 1040, 0, 1152, 0, 36, 0, 260, 0, 2052, 0, 288, 0, 2080, 0, 2304, 2, 1, 1, 2, 4, 2, 2, 4, 5, 0, 0, 5, 3, 0, 1, 2, 4, 1, 0, 5, 10, 0, 1, 0, 2, 1, 4, 2, 8, 4, 16, 8, 32, 16, 64, 32, 128, 64, 256, 128, 512, 256, 1024, 512, 2048, 1024, 4096, 2048, 8192, 4096, 16384, 8192, 32768, 16384, 0, 32768];
  let lo = [0, 1, 3, 7, 11, 15, 23, 39, 42, 50, 54, 56, 60, 69, 77, 82, 88, 110, 116, 121, 138];
  let nv = [1, 2, 4, 3, 4, 8, 16, 3, 5, 4, 1, 2, 6, 3, 4, 3, 12, 3, 4, 16];
  let st = zeros(8);
  let sk = zeros(64);
  let m = 1000000007;
  let fold = 0;
  let k = 0;
  while k < 20 {
    let x = solve(cl, lo[k], lo[k + 1], nv[k], st, sk);
    let neg = if x < 0 then 1 else 0;
    let r = (x + 4096 * neg) / 4096 - neg;
    let nodes = x - r * 4096;
    let fold = (fold * 1000003 + (r + 2) * 4096 + nodes) % m;
    let k = k + 1;
    0
  };
  fold
}
