module core { }

// tern.bp — T1: ternary Clifford basis {-1,0,1}, 2 bits per blade, 8 blades
// packed into one i64 (blade index = basis bitmask of Cl(3)). Blade
// multiplication = the Cayley table as combinatorial masks: merged blade =
// i ^ j, sign = (-1)^t where t = #pairs (x in i, y in j, x > y) — pure
// bitwise arithmetic, zero float MUL. Gate: A = e1+e2, B = e2+e3 ->
// A*B = 1 + e12 + e13 + e23; rotor sandwich R x R~ with R = 1+e12,
// R~ = 1-e12 rotates e1 -> -2 e2. Fold = Sum (accAB[b]+8)*10^b +
// Sum (accS[b]+8)*10^(b+8) == python mirror (journal at gate time).

fn gprod(pa: i64, pb: i64, acc: [i64]) -> i64 {
  let i = 0;
  while i < 8 {
    let j = 0;
    while j < 8 {
      let ca = ((pa >> (i * 2)) & 3) - 1;
      let cb = ((pb >> (j * 2)) & 3) - 1;
      let c = i ^ j;
      let x = 0;
      let t = 0;
      while x < 3 {
        let bx = (i >> x) & 1;
        let y = 0;
        while y < 3 {
          let by = (j >> y) & 1;
          let gt = (if x == 1 then 1 else 0) * (if y == 0 then 1 else 0) + (if x == 2 then 1 else 0) * (if y < 2 then 1 else 0);
          let t = t + bx * by * gt;
          let y = y + 1;
          0
        };
        let x = x + 1;
        0
      };
      let tp = t - (t / 2) * 2;
      let sgn = 1 - tp * 2;
      let _ = acc[c] = acc[c] + ca * cb * sgn;
      let j = j + 1;
      0
    };
    let i = i + 1;
    0
  };
  0
}

// pack an acc array (ternary coefficients, guaranteed in {-1,0,1}) into
// the 2-bit-per-blade i64 form: enc = coef + 1.
fn pack(acc: [i64]) -> i64 {
  let tp = 0;
  let k = 0;
  while k < 8 {
    let enc = acc[k] + 1;
    let tp = tp + enc * (1 << (k * 2));
    let k = k + 1;
    0
  };
  tp
}

fn main() -> i64 {
  let base = 21845;
  let ap = base + 4 + 16;
  let bp = base + 16 + 256;
  let rp = base + 1 + 64;
  let rt = base + 1 - 64;
  let e1p = base + 4;
  let ab = zeros(8);
  let t1 = zeros(8);
  let s1 = zeros(8);
  let _ = gprod(ap, bp, ab);
  let _ = gprod(rp, e1p, t1);
  let tp = pack(t1);
  let _ = gprod(tp, rt, s1);
  let fold = [0];
  let b = 0;
  while b < 8 {
    let p = (if b == 0 then 1 else 0) + (if b == 1 then 10 else 0) + (if b == 2 then 100 else 0) + (if b == 3 then 1000 else 0) + (if b == 4 then 10000 else 0) + (if b == 5 then 100000 else 0) + (if b == 6 then 1000000 else 0) + (if b == 7 then 10000000 else 0);
    let _ = fold[0] = fold[0] + (ab[b] + 8) * p;
    let _ = fold[0] = fold[0] + (s1[b] + 8) * p * 100000000;
    let b = b + 1;
    0
  };
  fold[0]
}
