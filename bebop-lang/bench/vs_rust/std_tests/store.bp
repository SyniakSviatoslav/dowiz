// bt.bp — Ф2/F4: .bt rank-4 word-tensor codec (canonical artifact format v1).
// Format (little-endian, deterministic, self-describing):
//   magic  : 4 bytes "BT4R"
//   version: u32 = 1
//   rank   : u32 = 4
//   dims   : u32 x 4 (d0,d1,d2,d3)
//   data   : d0*d1*d2*d3 x i64 (LE two's complement, dense row-major)
// Header size = 4+4+4+16 = 28 bytes; total = 28 + 8*count.
// Byte convention matches the .bp I/O tier: buffers are byte-per-cell
// (sys_write packs low bytes of cells), so pack writes bytes into cells.
// Golden: ".bt RANK-4 GOLDEN" section in bench/vs_rust/spectral_golden/
// golden.txt (bt_fnv = FNV-1a 64 over the exact byte stream).

// bt_offset(d, i, j, k, l): rank-4 row-major stride view offset.
fn bt_offset(d: [i64], i: i64, j: i64, k: i64, l: i64) -> i64 {
  ((i * d[1] + j) * d[2] + k) * d[3] + l
}

// bt_pack(d, data, out): serialize dims[4] + data (count = d0*d1*d2*d3)
// into the byte-per-cell buffer out (needs 28 + 8*count cells). Returns the
// byte count. data cells carry full i64 values.
fn bt_pack(d: [i64], data: [i64], out: [i64]) -> i64 {
  // magic "BT4R"
  let _ = out[0] = 66;
  let _ = out[1] = 84;
  let _ = out[2] = 52;
  let _ = out[3] = 82;
  // version u32 LE = 1
  let _ = out[4] = 1;
  let _ = out[5] = 0;
  let _ = out[6] = 0;
  let _ = out[7] = 0;
  // rank u32 LE = 4
  let _ = out[8] = 4;
  let _ = out[9] = 0;
  let _ = out[10] = 0;
  let _ = out[11] = 0;
  // dims u32 LE x4
  let q = 0;
  while q < 4 {
    let v = d[q];
    let _ = out[12 + q * 4] = v & 255;
    let _ = out[13 + q * 4] = (v >> 8) & 255;
    let _ = out[14 + q * 4] = (v >> 16) & 255;
    let _ = out[15 + q * 4] = (v >> 24) & 255;
    let q = q + 1;
    0
  };
  let count = (d[0] * d[1] * d[2]) * d[3];
  let o = 28;
  let k = 0;
  while k < count {
    let v = data[k];
    let b = 0;
    while b < 8 {
      let _ = out[o + k * 8 + b] = (v >> (b * 8)) & 255;
      let b = b + 1;
      0
    };
    let k = k + 1;
    0
  };
  28 + count * 8
}

// bt_fnv(out, len): FNV-1a 64 over the byte-per-cell buffer — the .bt
// fingerprint (golden bt_fnv). h = (h ^ b) * 0x100000001b3, wrapping.
// Offset basis 0xcbf29ce484222325 as i64: 0 - 3750763034362895579.
fn bt_fnv(out: [i64], len: i64) -> i64 {
  let h = 0 - 3750763034362895579;
  let i = 0;
  while i < len {
    let h = (h ^ (out[i] & 255)) * 1099511628211;
    let i = i + 1;
    0
  };
  h
}

// bt_unpack(src, d, data): parse a .bt byte stream (byte-per-cell) —
// validates magic "BT4R", version 1, rank 4; fills d[0..4) and data
// (needs d0*d1*d2*d3 cells). Returns 0 on success, -1 on a bad header
// (buffers hold garbage then — check the return before use).
fn bt_unpack(src: [i64], d: [i64], data: [i64]) -> i64 {
  let ok = (if src[0] == 66 then 1 else 0) + (if src[1] == 84 then 1 else 0)
         + (if src[2] == 52 then 1 else 0) + (if src[3] == 82 then 1 else 0);
  let ok = ok + (if src[4] == 1 then 1 else 0) + (if src[5] == 0 then 1 else 0)
         + (if src[6] == 0 then 1 else 0) + (if src[7] == 0 then 1 else 0);
  let ok = ok + (if src[8] == 4 then 1 else 0) + (if src[9] == 0 then 1 else 0)
         + (if src[10] == 0 then 1 else 0) + (if src[11] == 0 then 1 else 0);
  let q = 0;
  while q < 4 {
    let _ = d[q] = src[12 + q * 4] + (src[13 + q * 4] << 8) + (src[14 + q * 4] << 16) + (src[15 + q * 4] << 24);
    let q = q + 1;
    0
  };
  let count = (d[0] * d[1] * d[2]) * d[3];
  let k = 0;
  while k < count {
    let v = 0;
    let b = 7;
    while b >= 0 {
      let v = (v << 8) + (src[28 + k * 8 + b] & 255);
      let b = b - 1;
      0
    };
    let _ = data[k] = v;
    let k = k + 1;
    0
  };
  let res = if ok == 12 then 0 else 0 - 1;
  res
}


// store.bp — Ф2/F4: .bt store (F2 I/O artifacts). Atomic publish path:
//   tmp -> sys_open(O_RDWR|O_CREAT|O_TRUNC) -> sys_export(fd, bytes, n)
//   (ftruncate + mmap MAP_SHARED + stores + munmap, zero sys_write on the
//   critical path) -> sys_close -> sys_rename(tmp, out) = renameat publish.
//   rename(x,x) is a no-op, so re-storing over the same path is idempotent.
// The caller supplies byte-per-cell buffers (the .bp I/O tier convention).
// Golden: the same 220-byte "BT4R" stream bt.bp packs, with bt_fnv read
// back AFTER the atomic publish must still equal golden.txt's bt_fnv.
// Interp==JIT on all builtins here (L5 twins closed, parity gate 720000).

// bt_store(tmp, tlen, out, olen, bytes, n): atomically publish n bytes of the
// byte-per-cell buffer `bytes` onto path `out` via a tmp file. Returns
// 7 only when export, close and rename all return 0. Flags 578 = O_RDWR|O_CREAT|
// O_TRUNC (2|64|512): sys_export mmaps PROT_READ|WRITE|MAP_SHARED, which needs
// O_RDWR — O_WRONLY (577) make mmap fail with EACCES and the stores SIGSEGV.
fn bt_store(tmp: [i64], tlen: i64, out: [i64], olen: i64, bytes: [i64], n: i64) -> i64 {
  let fd = sys_open(tmp, tlen, 578);
  let e = sys_export(fd, bytes, n);
  let c = sys_close(fd);
  let r = sys_rename(tmp, tlen, out, olen);
  (if e == 0 then 1 else 0) + (if c == 0 then 2 else 0) + (if r == 0 then 4 else 0)
}

fn main() -> i64 {
  let d = zeros(8);
  let _ = d[0] = 2;
  let _ = d[1] = 3;
  let _ = d[2] = 2;
  let _ = d[3] = 2;
  let data = zeros(64);
  let data2 = zeros(64);
  let d2 = zeros(8);
  let out = zeros(512);
  let rbuf = zeros(512);
  let mask = 17592186044415;
  let base = 8796093022208;
  let k = 0;
  while k < 24 {
    let _ = data[k] = ((k * 2654435761 + 7) & mask) - base;
    let k = k + 1;
    0
  };
  let tp = zeros(40);
  let _ = tp[0] = 47; let _ = tp[1] = 116; let _ = tp[2] = 109; let _ = tp[3] = 112; let _ = tp[4] = 47;
  let _ = tp[5] = 111; let _ = tp[6] = 112; let _ = tp[7] = 101; let _ = tp[8] = 110; let _ = tp[9] = 99;
  let _ = tp[10] = 111; let _ = tp[11] = 100; let _ = tp[12] = 101; let _ = tp[13] = 47; let _ = tp[14] = 98;
  let _ = tp[15] = 116; let _ = tp[16] = 95; let _ = tp[17] = 115; let _ = tp[18] = 116; let _ = tp[19] = 111;
  let _ = tp[20] = 114; let _ = tp[21] = 101; let _ = tp[22] = 95; let _ = tp[23] = 116; let _ = tp[24] = 109;
  let _ = tp[25] = 112; let _ = tp[26] = 46; let _ = tp[27] = 98; let _ = tp[28] = 105; let _ = tp[29] = 110;
  let op = zeros(40);
  let _ = op[0] = 47; let _ = op[1] = 116; let _ = op[2] = 109; let _ = op[3] = 112; let _ = op[4] = 47;
  let _ = op[5] = 111; let _ = op[6] = 112; let _ = op[7] = 101; let _ = op[8] = 110; let _ = op[9] = 99;
  let _ = op[10] = 111; let _ = op[11] = 100; let _ = op[12] = 101; let _ = op[13] = 47; let _ = op[14] = 98;
  let _ = op[15] = 116; let _ = op[16] = 95; let _ = op[17] = 115; let _ = op[18] = 116; let _ = op[19] = 111;
  let _ = op[20] = 114; let _ = op[21] = 101; let _ = op[22] = 95; let _ = op[23] = 111; let _ = op[24] = 117;
  let _ = op[25] = 116; let _ = op[26] = 46; let _ = op[27] = 98; let _ = op[28] = 105; let _ = op[29] = 110;
  let acc = 0;
  let len = bt_pack(d, data, out);
  let acc = acc * 131 + (if len == 220 then 1 else 0);
  let fnv0 = bt_fnv(out, len);
  let acc = acc * 131 + (if fnv0 == 0 - 6204655307031605165 then 1 else 0);
  let src = bt_store(tp, 30, op, 30, out, len);
  let acc = acc * 131 + (if src == 7 then 1 else 0);
  let fd = sys_open(op, 30, 0);
  let acc = acc * 131 + (if fd >= 0 then 1 else 0);
  let nr = sys_read(fd, rbuf, 220);
  let _ = sys_close(fd);
  let acc = acc * 131 + (if nr == 220 then 1 else 0);
  let fnv1 = bt_fnv(rbuf, nr);
  let acc = acc * 131 + (if fnv1 == 0 - 6204655307031605165 then 1 else 0);
  let rc = bt_unpack(rbuf, d2, data2);
  let acc = acc * 131 + (if rc == 0 then 1 else 0);
  let k = 0;
  while k < 24 {
    let eq = if data2[k] == data[k] then 0 else 1;
    let acc = acc * 131 + eq;
    let k = k + 1;
    0
  };
  let v22 = bt_offset(d, 1, 2, 1, 0);
  let acc = acc * 131 + (if v22 == 22 then 1 else 0);
  let acc = acc * 131 + (if d2[0] == 2 then 1 else 0) + (if d2[3] == 2 then 1 else 0);
  acc
}
