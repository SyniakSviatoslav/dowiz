// msuper.bp — N7: multiversal superposition branching (spectral collapse).

fn fp_mul(a: i64, b: i64) -> i64 {
  let na = if a < 0 then 1 else 0;
  let aa = if na == 1 then 0 - a else a;
  let nb = if b < 0 then 1 else 0;
  let ab = if nb == 1 then 0 - b else b;
  let a1 = aa >> 32;
  let a0 = aa - (a1 << 32);
  let b1 = ab >> 32;
  let b0 = ab - (b1 << 32);
  let hi = a1 * b1;
  let mid = a1 * b0 + a0 * b1;
  let ah = a0 >> 16;
  let al = a0 - (ah << 16);
  let bh = b0 >> 16;
  let bl = b0 - (bh << 16);
  let ll_h = ah * bh;
  let ll_m = ah * bl + al * bh;
  let ll_l = al * bl;
  let low = ll_h + ((ll_m + (ll_l >> 16)) >> 16);
  let p = (hi << 32) + mid + low;
  let flip = na + nb;
  let flip = flip - (flip / 2) * 2;
  let p = if flip == 1 then 0 - p else p;
  p
}

// isqrt(s): floor(sqrt(s)) for 0 <= s < 2^62 — bit-by-bit restoring method,
// 31 steps, shifts and subtracts only (no division, fully deterministic).
fn isqrt(s: i64) -> i64 {
  let rem = 0;
  let root = 0;
  let i = 0;
  while i < 31 {
    let sh = 60 - i * 2;
    let rem = (rem << 2) + ((s >> sh) & 3);
    let tst = (root << 2) + 1;
    let take = if tst <= rem then 1 else 0;
    let root = (root << 1) + take;
    let rem = rem - take * tst;
    let i = i + 1;
    0
  };
  root
}

// lcg_next(rng): the golden start-vector LCG step (SPECTRAL LAW constants:
// mul 6364136223846793005, add 1442695040888963407 — wrapping i64).
fn lcg_next(rng: i64) -> i64 {
  let rng = rng * 6364136223846793005;
  let rng = rng + 1442695040888963407;
  rng
}

// spmv_fp(rp,ci,vv,n, x, out): out = A·x in fp. Fixed order: rows 0..n,
// ascending columns within a row (the Csr::spmv contract); out zeroed first.
fn spmv_fp(rp: [i64], ci: [i64], vv: [i64], n: i64, x: [i64], out: [i64]) -> i64 {
  let j = 0;
  while j < n {
    let _ = out[j] = 0;
    let j = j + 1;
    0
  };
  let i = 0;
  while i < n {
    let xi = x[i];
    let lo = rp[i];
    let hi = rp[i + 1];
    let k = lo;
    while k < hi {
      let j = ci[k];
      let _ = out[j] = out[j] + fp_mul(vv[k], xi);
      let k = k + 1;
      0
    };
    let i = i + 1;
    0
  };
  n
}

// normalize_fp(x, n): scale so the Euclidean norm is 2^32. Sum of squares is
// taken on |x_i|>>8 (LAW: >> is logical — abs first!); for |x| <= 2^36 the
// square <= 2^56 and the sum <= 2^62 — inside isqrt's range. The isqrt
// rounding (+-1 at the |x|>>8 scale) bounds the normalized-component error
// near 2^-24 relative — lambda error ~256 fp units, well inside the 1e-6
// drift band (4295 fp units). Reciprocal R = 2^56/nrm = fp(2^32/|x|).
fn normalize_fp(x: [i64], n: i64) -> i64 {
  let ss = 0;
  let i = 0;
  while i < n {
    let ai = x[i];
    let ai = if ai < 0 then 0 - ai else ai;
    let t = ai >> 8;
    let ss = ss + t * t;
    let i = i + 1;
    0
  };
  let nrm = isqrt(ss);
  let isz = if nrm == 0 then 1 else 0;
  let nrm = nrm + isz;
  let r = 72057594037927936 / nrm;
  let i = 0;
  while i < n {
    let _ = x[i] = fp_mul(x[i], r);
    let i = i + 1;
    0
  };
  nrm << 14
}

// topk_symmetric_fp(rp,ci,vv,n, k, iters, evals, evecs): the golden oracle's
// power+Hotelling loop in fp. evals[0..k] = λ descending |λ| (fp); evecs
// [m*n+j] = sign-fixed unit eigenvectors. evals/evecs caller-provided.
// Iteration: A·x via spmv, deflate found pairs (per-iteration Hotelling),
// normalize. λ = Rayleigh quotient on the deflated space, recompute-deflate.
fn topk_symmetric_fp(rp: [i64], ci: [i64], vv: [i64], n: i64, k: i64, iters: i64, evals: [i64], evecs: [i64]) -> i64 {
  let x = zeros(192);
  let ax = zeros(192);
  let tmp = zeros(192);
  let m = 0;
  let found = 0;
  while m < k {
    let rng = 0 - 7046029254386353131;
    let j = 0;
    while j < n {
      let rng = lcg_next(rng);
      let frac = (rng >> 11) >> 20;
      let _ = x[j] = frac + frac - 4294967296;
      let j = j + 1;
      0
    };
    let _ = normalize_fp(x, n);
    let om = 0;
    while om < found {
      let proj = 0;
      let j = 0;
      while j < n {
        let proj = proj + fp_mul(evecs[om * n + j], x[j]);
        let j = j + 1;
        0
      };
      let j = 0;
      while j < n {
        let _ = x[j] = x[j] - fp_mul(proj, evecs[om * n + j]);
        let j = j + 1;
        0
      };
      let om = om + 1;
      0
    };
    let _ = normalize_fp(x, n);
    let it = 0;
    while it < iters {
      let _ = spmv_fp(rp, ci, vv, n, x, ax);
      let om = 0;
      while om < found {
        let proj = 0;
        let j = 0;
        while j < n {
          let proj = proj + fp_mul(evecs[om * n + j], ax[j]);
          let j = j + 1;
          0
        };
        let j = 0;
        while j < n {
          let _ = ax[j] = ax[j] - fp_mul(proj, evecs[om * n + j]);
          let j = j + 1;
          0
        };
        let om = om + 1;
        0
      };
      let _ = normalize_fp(ax, n);
      let j = 0;
      while j < n {
        let _ = x[j] = ax[j];
        let j = j + 1;
        0
      };
      let it = it + 1;
      0
    };
    let _ = spmv_fp(rp, ci, vv, n, x, tmp);
    let om = 0;
    while om < found {
      let proj = 0;
      let j = 0;
      while j < n {
        let proj = proj + fp_mul(evecs[om * n + j], tmp[j]);
        let j = j + 1;
        0
      };
      let j = 0;
      while j < n {
        let _ = tmp[j] = tmp[j] - fp_mul(proj, evecs[om * n + j]);
        let j = j + 1;
        0
      };
      let om = om + 1;
      0
    };
    let lambda = 0;
    let j = 0;
    while j < n {
      let lambda = lambda + fp_mul(x[j], tmp[j]);
      let j = j + 1;
      0
    };
    let om = 0;
    while om < found {
      let proj = 0;
      let j = 0;
      while j < n {
        let proj = proj + fp_mul(evecs[om * n + j], x[j]);
        let j = j + 1;
        0
      };
      let j = 0;
      while j < n {
        let _ = x[j] = x[j] - fp_mul(proj, evecs[om * n + j]);
        let j = j + 1;
        0
      };
      let om = om + 1;
      0
    };
    let _ = normalize_fp(x, n);
    let fpos = 0;
    let j = 0;
    while j < n {
      let mag = x[j];
      let mag = if mag < 0 then 0 - mag else mag;
      let big = if mag > 65536 then 1 else 0;
      let seen = if fpos != 0 then 1 else 0;
      let fpos = if seen == 0 then x[j] * big else fpos;
      let j = j + 1;
      0
    };
    let neg = if fpos < 0 then 1 else 0;
    let j = 0;
    while j < n {
      let _ = evecs[found * n + j] = if neg == 1 then 0 - x[j] else x[j];
      let j = j + 1;
      0
    };
    let _ = evals[found] = lambda;
    let found = found + 1;
    let m = m + 1;
    0
  };
  // descending |λ|: insertion sort of (λ, eigenvector) pairs; the candidate
  // row is held in kr (shifts overwrite row i when j+1 == i).
  let kr = zeros(64);
  let i = 1;
  while i < found {
    let key = evals[i];
    let jj = 0;
    while jj < n {
      let _ = kr[jj] = evecs[i * n + jj];
      let jj = jj + 1;
      0
    };
    let ke = key;
    let ke = if ke < 0 then 0 - ke else ke;
    let j = i - 1;
    let go = 1;
    while go == 1 {
      let inb = if j >= 0 then 1 else 0;
      let je = evals[j];
      let je = if je < 0 then 0 - je else je;
      let lt = if je < ke then 1 else 0;
      let move_ = lt * inb;
      let _ = if move_ == 1 then (let _ = evals[j + 1] = evals[j] in 0) else 0;
      let jj = 0;
      while jj < n {
        let _ = if move_ == 1 then (let _ = evecs[(j + 1) * n + jj] = evecs[j * n + jj] in 0) else 0;
        let jj = jj + 1;
        0
      };
      let j = j - move_;
      let go = move_;
      0
    };
    let _ = evals[j + 1] = key;
    let jj = 0;
    while jj < n {
      let _ = evecs[(j + 1) * n + jj] = kr[jj];
      let jj = jj + 1;
      0
    };
    let i = i + 1;
    0
  };
  found
}

// csr_from_dense(a, n, rp, ci, vv): row-major scan, non-zero cells -> edges.
fn csr_from_dense(a: [i64], n: i64, rp: [i64], ci: [i64], vv: [i64]) -> i64 {
  let nnzc = zeros(1);
  let i = 0;
  while i < n {
    let _ = rp[i] = nnzc[0];
    let j = 0;
    while j < n {
      let w = a[i * n + j];
      let nz = if w == 0 then 0 else 1;
      let _ = if nz == 1 then (let _ = ci[nnzc[0]] = j in (let _ = vv[nnzc[0]] = w in (let _ = nnzc[0] = nnzc[0] + 1 in 0))) else 0;
      let j = j + 1;
      0
    };
    let i = i + 1;
    0
  };
  let _ = rp[n] = nnzc[0];
  nnzc[0]
}


// ═══ N7: multiversal superposition branching ═══
// All 4 logic branches compute simultaneously in one bit array: the
// superposition S = sum w_b*H_b with weights {+1,+1,-1,-1} over 16-cell
// branch hypervectors. The COLLAPSE is spectral: the branch Gram matrix
// G[i][j] = <H_i,H_j> (fp) is eigen-decomposed (Hotelling topk, k=2,
// iters=32) and the dominant eigenvector's SIGN pattern {+,+,-,-} masks
// out the false branches EXACTLY (collapse_ok - the eigenvalue break
// lambda1=50.08 vs lambda2=10.47 is decisive: gap>>22 = 40561 >= 100).
// The collapsed readout = argmax <S, H_b> = branch 0 of the surviving
// group {0,1} (read_ok). Fold = collapse_ok*10^12 + read_ok*10^11 +
// decisive*10^10 + gap*10^5 + win. Machine embedded verbatim from
// spectral_machinery.bp (sha c184416666fe).

fn main() -> i64 {
  let h = zeros(64);
  let g = zeros(16);
  let svec = zeros(16);
  let rp = zeros(16);
  let ci = zeros(64);
  let vv = zeros(64);
  let ev = zeros(8);
  let ec = zeros(64);
  let one = 4294967296;
  // branch hypervectors: H0 = popcount parity; H1 = H0 flip bits {0,1};
  // H2 = -H0 flip {2}; H3 = -H1 flip {3}
  let i = 0;
  while i < 16 {
    let p = 0;
    let x = i;
    let t = 0;
    while t < 4 {
      let p = p + x - (x / 2) * 2;
      let x = x / 2;
      let t = t + 1;
      0
    };
    let h0 = if p - (p / 2) * 2 == 0 then 1 else 0 - 1;
    let f01 = if i == 0 then 0 - 1 else 1;
    let f01 = if i == 1 then 0 - f01 else f01;
    let h1 = h0 * f01;
    let f2 = if i == 2 then 0 - 1 else 1;
    let h2 = (0 - h0) * f2;
    let f3 = if i == 3 then 0 - 1 else 1;
    let h3 = (0 - h1) * f3;
    let _ = h[i] = h0;
    let _ = h[16 + i] = h1;
    let _ = h[32 + i] = h2;
    let _ = h[48 + i] = h3;
    let i = i + 1;
    0
  };
  // superposition S = H0 + H1 - H2 - H3
  let i = 0;
  while i < 16 {
    let _ = svec[i] = h[i] + h[16 + i] - h[32 + i] - h[48 + i];
    let i = i + 1;
    0
  };
  // Gram matrix G (fp)
  let i = 0;
  while i < 4 {
    let j = 0;
    while j < 4 {
      let acc = 0;
      let k = 0;
      while k < 16 {
        let acc = acc + h[i * 16 + k] * h[j * 16 + k];
        let k = k + 1;
        0
      };
      let _ = g[i * 4 + j] = acc * one;
      let j = j + 1;
      0
    };
    let i = i + 1;
    0
  };
  let _ = csr_from_dense(g, 4, rp, ci, vv);
  let _ = topk_symmetric_fp(rp, ci, vv, 4, 2, 32, ev, ec);
  let gap = (ev[0] - ev[1]) >> 22;
  let decisive = if gap >= 100 then 1 else 0;
  let collapse_ok = 1;
  let b = 0;
  while b < 4 {
    let ecv = ec[b];
    let sgn = if ecv > 0 then 1 else 0 - 1;
    let exp = if b < 2 then 1 else 0 - 1;
    let ok = if sgn == exp then 1 else 0;
    let collapse_ok = collapse_ok * ok;
    let b = b + 1;
    0
  };
  // readout: argmax <S, H_b>
  let win = 0;
  let best = 0 - 999999999;
  let b = 0;
  while b < 4 {
    let acc = 0;
    let k = 0;
    while k < 16 {
      let acc = acc + svec[k] * h[b * 16 + k];
      let k = k + 1;
      0
    };
    let better = if acc > best then 1 else 0;
    let win = win + better * (b - win);
    let best = best + better * (acc - best);
    let b = b + 1;
    0
  };
  let read_ok = if win < 2 then 1 else 0;
  collapse_ok * 1000000000000 + read_ok * 100000000000 + decisive * 10000000000 + gap * 100000 + win
}
