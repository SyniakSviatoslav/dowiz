use "selfhost/prelude/sha256.bp"
// selfhost/std/sha256.bp — SHA-256 gate; the algorithm lives in selfhost/prelude/sha256.bp
// since the T47c split (2026-09-05, so the store can `use` it for layout digests).
// 64-round K table + message schedule + compression + Merkle-Damgard
// padding (0x80 … 64-bit BE bit length). i64 cells carry u32 words;
// every addition is masked & 0xffffffff. ~e is (0 - 1 - e). Bitwise
// tier (& | ^ << >>) is in the self-hosted emitter; >> is logical (lsr).
//
// API: sha256_fold(data: [i64], n: i64) -> i64 — folds the 8 output
// words of SHA-256 over byte cells data[0..n) as acc*31 + word (u64 wrap),
// mirroring the golden driver's fold_u64. Blocks are 64 bytes; the padded
// length is ((n+9+63)/64)*64.

module core { }

fn main() -> i64 {
  let abc = [97, 98, 99];
  sha256_fold(abc, 3)
}
