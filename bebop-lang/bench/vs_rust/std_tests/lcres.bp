// lcres.bp — SS-3: LC resonance as agent-loop timing (the arithmetic core).
// Agent loop = LC tank: L = latency, C = arena capacity; f0 = 1/(2*pi*sqrt
// (L*C)) drives the target inter-iteration period (minimal jitter without
// an OS scheduler). Two tanks: (L=1/16,C=1) -> f0 = 2/pi; (L=1/4,C=1/16) ->
// f0 = 4/pi, period T = 1/f0 = pi/4. fp 2^32; sqrt via isqrt (v*2^32 < 2^62
// contract - tank values chosen inside); reciprocal via 32-step restoring
// long division WITH an integer-part pre-loop (the r < b invariant requires
// it for ratios >= 1 - fp_div escaped to all-ones for f2 without it). The
// jitter done-check half (clock_ms + PID-in-.bp drift compensation over
// 1000 real cycles) needs the clock syscall - not on the std gate surface
// (innovate: add sys_clock, then gate jitter < 1%). Fold = ok1*10^15 +
// ok2*10^14 + okT*10^13 + f1q*10^7 + f2q (q = >>12, positives only).
// Machine: fp_mul + isqrt embedded verbatim (sha c184416666fe).
fn fp_mul(a: i64, b: i64) -> i64 {
  let na = if a < 0 then 1 else 0;
  let aa = if na == 1 then 0 - a else a;
  let nb = if b < 0 then 1 else 0;
  let ab = if nb == 1 then 0 - b else b;
  let a1 = aa >> 32;
  let a0 = aa - (a1 << 32);
  let b1 = ab >> 32;
  let b0 = ab - (b1 << 32);
  let hi = a1 * b1;
  let mid = a1 * b0 + a0 * b1;
  let ah = a0 >> 16;
  let al = a0 - (ah << 16);
  let bh = b0 >> 16;
  let bl = b0 - (bh << 16);
  let ll_h = ah * bh;
  let ll_m = ah * bl + al * bh;
  let ll_l = al * bl;
  let low = ll_h + ((ll_m + (ll_l >> 16)) >> 16);
  let p = (hi << 32) + mid + low;
  let flip = na + nb;
  let flip = flip - (flip / 2) * 2;
  let p = if flip == 1 then 0 - p else p;
  p
}

// isqrt(s): floor(sqrt(s)) for 0 <= s < 2^62 — bit-by-bit restoring method,
// 31 steps, shifts and subtracts only (no division, fully deterministic).
fn isqrt(s: i64) -> i64 {
  let rem = 0;
  let root = 0;
  let i = 0;
  while i < 31 {
    let sh = 60 - i * 2;
    let rem = (rem << 2) + ((s >> sh) & 3);
    let tst = (root << 2) + 1;
    let take = if tst <= rem then 1 else 0;
    let root = (root << 1) + take;
    let rem = rem - take * tst;
    let i = i + 1;
    0
  };
  root
}


// fp_div(a, b): floor(a * 2^32 / b), a >= 0, b > 0. Integer part by repeated
// subtraction (restores the r < b invariant), then 32 fractional steps.
fn fp_div(a: i64, b: i64) -> i64 {
  let qint = 0;
  let r = a;
  while r >= b {
    let qint = qint + 1;
    let r = r - b;
    0
  };
  let qf = 0;
  let i = 0;
  while i < 32 {
    let r = r * 2;
    let bit = if r >= b then 1 else 0;
    let qf = qf * 2 + bit;
    let r = r - bit * b;
    let i = i + 1;
    0
  };
  qint * 4294967296 + qf
}

// f0_of(L, C): 1 / (2*pi*sqrt(L*C)), all fp 2^32.
fn f0_of(l: i64, c: i64) -> i64 {
  let one = 4294967296;
  let two_pi = 26986075410;
  let lc = fp_mul(l, c);
  let sqrtlc = isqrt(lc * one);
  let den = fp_mul(two_pi, sqrtlc);
  fp_div(one, den)
}

fn main() -> i64 {
  let one = 4294967296;
  let f1 = f0_of(one / 16, one);
  let f2 = f0_of(one / 4, one / 16);
  let t2 = fp_div(one, f2);
  let e1 = f1 - 2734260830;
  let e1 = if e1 < 0 then 0 - e1 else e1;
  let ok1 = if e1 < 4294967 then 1 else 0;
  let e2 = f2 - 5468521660;
  let e2 = if e2 < 0 then 0 - e2 else e2;
  let ok2 = if e2 < 4294967 then 1 else 0;
  let et = t2 - 3373259426;
  let et = if et < 0 then 0 - et else et;
  let okT = if et < 4294967 then 1 else 0;
  let f1q = f1 >> 12;
  let f2q = f2 >> 12;
  ok1 * 1000000000000000 + ok2 * 100000000000000 + okT * 10000000000000 + f1q * 10000000 + f2q
}
