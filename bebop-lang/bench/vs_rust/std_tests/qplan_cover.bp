use "selfhost/std/qplan.bp"
// qplan_cover.bp -- std_golden `gate qplan_cover`: every function of selfhost/std/qplan.bp (B7
// step 2's planner) executed, and each observed value folded as acc*31 + v.
//
// HISTORY. 8e438580 wrote this file to wire up six qplan_* functions arch_check named dead. Six
// hours later a8afebde rewrote qplan.bp -- renamed qplan_join_order -> qplan_order and
// qplan_group_strategy -> qplan_group, gave qplan_access a third parameter, and put its own
// self-test in a `main` inside the library. Nothing ran this file, so nothing noticed: it called
// functions that no longer existed, qplan_cost and qplan_plan_query had no caller at all, and the
// library's `main` was executed by no gate either. W-BATGREEN (2026-09-29) rewrote it against the
// current API, moved a8afebde's self-test here, and made it a GATE with an oracle that derives
// every value from the cost model independently (bench/oracles/qplan_cover.py), so the next
// API change turns the battery red instead of rotting in silence.
//
// What is pinned, in fold order (the oracle's list is the same list):
//   qplan_access(0,0,a)            0  -- a STUB: scan is the only access path until indexes land
//   qplan_cost(7, 0|1|2)           7, 140, 105  (per-row 1 / 20 / 15)
//   qplan_order k=1 rows [7]       rc 0, cost 7, order [0]
//   qplan_order k=2 [1000,10]      rc 0, cost 10 + 10*1000 = 10010, order [1,0]
//   qplan_order k=3 [1000,10,100]  rc 0, cost 10 + 10*100 + 10*100*1000 = 1001010, order [1,2,0]
//   qplan_order k=4 [2,3,4,5]      rc 0, cost 2 + 6 + 24 + 120 = 152, order [0,1,2,3]
//                                  (k=4 compares only 3 of the 24 orders; this input's true
//                                  minimum is one of them, so the oracle's full search agrees)
//   qplan_order k=5                92, the refusal for k > 4
//   qplan_group(4096), (4097)      0, 1   -- the dense/counting-sort boundary is inclusive
//   qplan_fingerprint(2,1,0),(1,0,1)  102, 11
//   qplan_validate, 6 / 7 children 1, 0   -- it reads the child COUNT and nothing else
//   qplan_explain(1)               25 = len("access=0 group=0 tables=1"), then every byte
//   qplan_plan_query               1 for "q { from T }", 0 for "x" (unparseable). The planner's
//                                  fingerprint is 1 for EVERY parseable query today: access is
//                                  the stub's 0, n_tables is fixed at 1, and a group clause asks
//                                  qplan_group(100), which is dense (0) -- pinned so it moves.
fn qc_fold(acc: i64, v: i64) -> i64 { acc * 31 + v }

fn qc_order(acc: i64, k: i64, rows: [i64]) -> i64 {
  let order = zeros(8);
  let cost = zeros(2);
  let rc = qplan_order(k, rows, order, cost, zeros(1));
  let acc = qc_fold(qc_fold(acc, rc), cost[0]);
  let i = 0;
  while i < k {
    let acc = qc_fold(acc, order[i]);
    let i = i + 1;
    0
  };
  acc
}

fn main() -> i64 {
  let a = zeros(64);
  let rows = zeros(8);
  let acc = qc_fold(0, qplan_access(0, 0, a));
  let acc = qc_fold(acc, qplan_cost(7, 0));
  let acc = qc_fold(acc, qplan_cost(7, 1));
  let acc = qc_fold(acc, qplan_cost(7, 2));
  let _ = rows[0] = 7;
  let acc = qc_order(acc, 1, rows);
  let _ = rows[0] = 1000;
  let _ = rows[1] = 10;
  let acc = qc_order(acc, 2, rows);
  let _ = rows[2] = 100;
  let acc = qc_order(acc, 3, rows);
  let _ = rows[0] = 2;
  let _ = rows[1] = 3;
  let _ = rows[2] = 4;
  let _ = rows[3] = 5;
  let acc = qc_order(acc, 4, rows);
  let acc = qc_fold(acc, qplan_order(5, rows, zeros(8), zeros(2), zeros(1)));
  let acc = qc_fold(qc_fold(acc, qplan_group(4096)), qplan_group(4097));
  let acc = qc_fold(qc_fold(acc, qplan_fingerprint(2, 1, 0)), qplan_fingerprint(1, 0, 1));
  let _ = a[1] = 6;
  let acc = qc_fold(acc, qplan_validate(0, a));
  let _ = a[1] = 7;
  let acc = qc_fold(acc, qplan_validate(0, a));
  let buf = zeros(64);
  let n = qplan_explain(1, a, buf);
  let acc = qc_fold(acc, n);
  let i = 0;
  while i < n {
    let acc = qc_fold(acc, buf[i]);
    let i = i + 1;
    0
  };
  let q = zeros(4096);
  let qp = zeros(1);
  let sb = zeros(512);
  let sp = zeros(1);
  let acc = qc_fold(acc, qplan_plan_query("q { from T }", q, qp, sb, sp));
  let _ = qp[0] = 0;
  let _ = sp[0] = 0;
  qc_fold(acc, qplan_plan_query("x", q, qp, sb, sp))
}
