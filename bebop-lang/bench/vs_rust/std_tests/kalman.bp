use "selfhost/prelude/fp.bp"
// (T47c 2026-09-05: was `// prelude: fp`; the expansion used to be textual via tools/gen_selfsrc.sh)
// kalman.bp — SS-1: Kalman filter as a pure .bp computation (zero alloc,
// zero heap, scalar-only 1-D fixed-point step response). Predict/update in
// fp 2^32: predict x'=F*x, P'=F*P*F+Q; update S=P+R, K=P/S (32-step long
// division, no overflow), x=x+K*(z-x), P=(1-K)*P. Constants F=H=1.0,
// Q=0.001, R=0.01, z=5.0, 1000 iterations (the done-check horizon). Claims:
// the Riccati map reaches an EXACT fp fixpoint (P1000==P999 -> fix=1, zero
// drift - deterministic fixed tick count by construction, no data-dependent
// loops); the state tracks z inside the 0.1% band (err = 3 fp units -> trk=1).
// Fold = kq*10^8 + pq*10^4 + trk*10 + fix (kq=K>>12, pq=P>>20).
// Machine: fp_mul verbatim from spectral_machinery.bp (sha256 c184416666fe).

// fp_div(a, b): floor(a * 2^32 / b), a >= 0, b > 0. Restoring long division,
// 32 steps: r stays < 2b <= 2^36 - no overflow, fully deterministic.
fn fp_div(a: i64, b: i64) -> i64 {
  let q = 0;
  let r = a;
  let i = 0;
  while i < 32 {
    let r = r * 2;
    let bit = if r >= b then 1 else 0;
    let q = q * 2 + bit;
    let r = r - bit * b;
    let i = i + 1;
    0
  };
  q
}

fn main() -> i64 {
  let one = 4294967296;
  let q = one / 1000;
  let r = one / 100;
  let z = one * 5;
  let x = 0;
  let p = one;
  let prevp = one;
  let fix = 0;
  let k = 0;
  let s = 0;
  let y = 0;
  let t = 0;
  while t < 1000 {
    let x = fp_mul(one, x);
    let p = fp_mul(one, p) + q;
    let s = p + r;
    let k = fp_div(p, s);
    let y = z - x;
    let x = x + fp_mul(k, y);
    let p = fp_mul(one - k, p);
    let fix = if p == prevp then 1 else 0;
    let prevp = p;
    let t = t + 1;
    0
  };
  let err = z - x;
  let err = if err < 0 then 0 - err else err;
  let trk = if err < 4294967 then 1 else 0;
  let kq = k >> 12;
  let pq = p >> 20;
  kq * 100000000 + pq * 10000 + trk * 10 + fix
}
