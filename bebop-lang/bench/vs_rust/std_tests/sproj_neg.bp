use "selfhost/prelude/proj.bp"
// sproj_neg (DG5, RT P-3's run-time twin): a projection whose fold fn is NOT registered is refused
// with trap 124 BEFORE anything is read or written -- the exit code is the result (the gate reads
// it; nothing is printed on the refused path). The fn below has the step's exact signature and
// performs I/O, which is the case the refusal exists for. Until DG6 lands the `pure` class, the
// registry is proj.bp's allowlist (pj_registered); DG6 replaces it with the compiler's check.
// argv[2] = p: the POSITIVE twin -- the registered step on the same image, which must not trap
// (prints the first-read code 2).
fn sn_leaky(h: i64, base: [i64], ev: i64, ver: i64) -> i64 {
  let m = zeros(2);
  let _ = m[0] = 33;
  let _ = sys_write(2, m, 1);
  pj_log_step(h, base, ev, ver)
}
fn main(argc: i64, argv: [str]) -> i64 {
  let tmp = zeros(256);
  let path = zeros(64);
  let pl = st_str(path, "sproj_neg.store");
  let base = st_open(path, pl, 1048576, tmp);
  let tx = zeros(6);
  let how = zeros(3);
  let _ = pj_log_init(base, tx, tmp);
  let pos = if argc > 2 then (if char(argv[2], 0) == 112 then 1 else 0) else 0;
  let _ = if pos == 1 then st_proj_eval(base, tx, 7, pj_kind_log(), &pj_log_step, how, tmp) else st_proj_eval(base, tx, 7, pj_kind_log(), &sn_leaky, how, tmp);
  let _ = sys_munmap(st_addr(base), 1048576);
  how[0]
}
