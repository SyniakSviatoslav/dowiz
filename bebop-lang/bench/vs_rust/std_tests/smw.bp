// smw.bp — G10: multi-writer store. P writers on disjoint partitions, N updates each.
// Fold = total of all counter payloads across all partitions, walked out of the arena.
//
// THE SHAPE OF THIS FILE IS FORCED BY A MEASURED COMPILER LIMIT. A fn spanning a
// sys_clone may keep at most EIGHT symbols across the spawn; at nine one child is
// silently lost, at eleven both are, and there is no trap or diagnostic -- sys_clone
// returns valid child TIDs and the children simply never write (measured 2026-09-12,
// docs/TRAPS.md, docs/WORKER-CARD.md). Constants do not count; anything the register
// allocator must KEEP does, because spill slots live in the process-shared frame rather
// than per thread. main therefore keeps exactly FOUR across its loop -- env, cells, acur,
// w -- and everything else travels in `env` as an i64, arrays included: `[i64]` values are
// cell indices and st_addr/st_cells are identities, so a handle packs into a slot exactly.
use "selfhost/prelude/sha256.bp"
use "selfhost/prelude/store.bp"

// env layout: 0 base, 1 locks, 2 scratch(tmp), 3 P, 4 N, 5 arena_cells, 6 ptdig,
//             7 cdig, 8 cross_every, 9 txs, 10 roots
fn stk(cur: i64, w: i64) -> i64 { cur + 16384 + w * 8192 }

// setup: every allocation and every store call that main would otherwise have to keep
// live across the spawn. Nothing here survives into main except through env.
fn setup(env: [i64]) -> i64 {
  let P = env[3];
  let path = zeros(64);
  let pl = st_str(path, "smw.store");
  let tmp = zeros(256);
  let base = st_open(path, pl, 67108864 + 16777216 * P, tmp);
  let _ = env[0] = st_addr(base);
  let _ = env[1] = st_addr(zeros(4 * P + 1));
  let _ = env[2] = st_addr(zeros(P * 2048));
  let _ = env[9] = st_addr(zeros(P * 64));
  let _ = env[10] = st_addr(zeros(P + 1));
  let _ = env[6] = st_digest("PartTab");
  let _ = env[7] = st_digest("C{i64}");
  // Without this every partition's cursor starts at 1024 and the writers allocate on top
  // of each other; partition disjointness is the whole premise of G10.
  let _ = st_init_p(st_cells(env[0]), st_cells(env[1]), P, env[5], tmp, env[6]);
  0
}

// writer: N transactions in partition p, each allocating and committing one C{i64}
// counter carrying 1. The fold below sums those payloads out of the arena; the closed
// form is deliberately absent from this file.
fn writer(env: [i64], p: i64) -> i64 {
  let base = st_cells(env[0]);
  let locks = st_cells(env[1]);
  let tmp = st_tmp_p(st_cells(env[2]), p);
  let tx = st_tx_p(st_cells(env[9]), p);
  let k = 0;
  while k < env[4] {
    let _ = st_lock_p(locks, p);
    let _ = st_begin_p(base, tx, p, tmp);
    let c = st_alloc_p(base, tx, p, 1, env[7], env[3], env[5]);
    let _ = st_put(base, c, 0, 1);
    let _ = st_seal(base, c, tmp);
    let _ = st_commit_p(base, tx, p, c, locks, env[3], env[5], tmp, env[6]);
    let _ = st_unlock_p(locks, p);
    let k = k + 1;
    0
  };
  0
}

fn fold_partition(base: [i64], P: i64, arena_cells: i64, dc: i64) -> i64 {
  let total = 0;
  let region_size = arena_cells / P;
  let rp = 0;
  while rp < P {
    let off = 1024 + rp * region_size;
    let end = off + region_size;
    let o = off;
    while o < end {
      let len = base[o] & 4294967295;
      let digest = base[o] >> 32;
      let is_obj = if len >= 1 then 1 else 0;
      let is_counter = if digest == dc then 1 else 0;
      let add = if is_obj * is_counter == 1 then base[o + 2] else 0;
      let _ = total = total + add;
      let advance = if is_obj == 1 then 2 + len else 1;
      let o = o + advance;
      0
    };
    let rp = rp + 1;
    0
  };
  total
}

fn sm_atoi(t: str) -> i64 {
  let n = str_len(t);
  let i = 0;
  let v = 0;
  while i < n {
    let v = v * 10 + (char(t, i) - 48);
    let i = i + 1;
    0
  };
  v
}

// argv[0] is the seed loader and argv[1] the .bin, so the first user argument is argv[2].
fn main(argc: i64, argv: [str]) -> i64 {
  let env = zeros(16);
  let _ = env[3] = if argc >= 3 then sm_atoi(argv[2]) else 1;
  let _ = env[4] = if argc >= 4 then sm_atoi(argv[3]) else 1000;
  let _ = env[5] = 8388608;
  let _ = env[8] = 100;
  let _ = setup(env);
  // sampled AFTER every allocation, so no stack lands in allocated arena
  let acur = sys_arena_base();
  let cells = zeros(env[3] * 2 + 1);
  let w = 0;
  while w < env[3] {
    let r = sys_clone(68864, stk(acur, w));
    let is_child = if r == 0 then 1 else 0;
    let _ = sys_cond_set(is_child, cells, w, w + 100);
    let _ = if is_child == 1 then writer(env, w) else 0;
    let _ = sys_cond_set(is_child, cells, env[3] + w, 1);
    let _ = sys_futex_wake(cells, env[3] + w, 64);
    let parked = if is_child == 0 then 1 else 0;
    while parked == 0 {
      let _ = sys_futex_wait_guard(1 - is_child, cells, env[3] * 2, 0);
      let parked = if cells[env[3] * 2] == 1 then 1 else 0;
      0
    };
    let _ = sys_exit_thread_guard(is_child, 0);
    let w = w + 1;
    0
  };
  let w2 = 0;
  while w2 < env[3] {
    let d = 0;
    while d == 0 {
      let _ = sys_futex_wait_guard(0, cells, env[3] + w2, 0);
      let d = if cells[env[3] + w2] == 1 then 1 else 0;
      0
    };
    let w2 = w2 + 1;
    0
  };
  fold_partition(st_cells(env[0]), env[3], env[5], env[7])
}
