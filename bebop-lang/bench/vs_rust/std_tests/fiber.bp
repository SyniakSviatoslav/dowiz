module core { }

// fiber.bp — cooperative user-space fiber scheduler (the in-sandbox
// replacement for the kernel-thread pool semantics that ptrace/proot
// breaks: clone(CLONE_VM) returns 0 in both threads and the shared
// futex cells never synchronize, journal 1788385631). Here N agents
// alternate INSIDE ONE process with NO kernel calls: each round the
// scheduler dispatches every fiber in fixed order (branch-free guards,
// no queues) and each fiber updates its arena cell FROM the shared
// arena - true shared-memory visibility, which is exactly the property
// the proot clone loses. Deterministic by construction: R rounds x N
// fibers, the cells evolve by pure integer arithmetic and the python
// mirror reproduces the fold bit-exact.
// Semantics: cells[i] += cells[(i+1) & 3] + 1 per dispatch, sequential
// within a round, N=4, R=3, cells start at 1.
// Mirror: c=[1,1,1,1]
//   r1: c0=3, c1=3, c2=3, c3=5
//   r2: c0=7, c1=7, c2=9, c3=13
//   r3: c0=15, c1=17, c2=23, c3=29
// Fold = c0*10^6 + c1*10^4 + c2*10^2 + c3 + switches*10^8
//      = 15e6 + 170000 + 2300 + 29 + 1200000000 = 1215172329.

fn main() -> i64 {
  let cells = zeros(4);
  let _ = cells[0] = 1;
  let _ = cells[1] = 1;
  let _ = cells[2] = 1;
  let _ = cells[3] = 1;
  let switches = 0;
  let r = 0;
  while r < 3 {
    let _ = cells[0] = cells[0] + cells[1] + 1;
    let switches = switches + 1;
    let _ = cells[1] = cells[1] + cells[2] + 1;
    let switches = switches + 1;
    let _ = cells[2] = cells[2] + cells[3] + 1;
    let switches = switches + 1;
    let _ = cells[3] = cells[3] + cells[0] + 1;
    let switches = switches + 1;
    let r = r + 1;
    0
  };
  cells[0] * 1000000 + cells[1] * 10000 + cells[2] * 100 + cells[3] + switches * 100000000
}
