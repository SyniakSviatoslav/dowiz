// tdg.bp — T16: Einstein index notation + metric tensor over flat rank-n
// storage (i64 fixed-point 2^32). Rank-3 tensor T[2][2][2] lives in one
// flat array with strides (4,2,1) (bt.bp offset rule); a repeated index
// means "sum over it": C_ik = T_ijk v^j (contract axis 1), s = A_i B^i
// (full contraction = dowiz-core tensor.rs Tensor1::dot). Metric g_ij
// lowers (v_i = g_ij v^j), its inverse g^ij = adj(g)/det raises
// (v^i = g^ij v_j); raise(lower(v)) must return v up to fp rounding (the
// falsifiable round-trip: err < 8 ulps only if g^ij really is g^-1).
// Machine: fp_mul verbatim from spectral_machinery.bp; fp_div exact
// floor(a*2^32/b) (restoring, a>=0, b>0, any a/b ratio).
// Fold = mask56 chain hash of every output (h = (h*31 & (2^56-1)) +
// |v|*2 + neg) — mirrored by bench/oracles/tdg.py.

fn fp_mul(a: i64, b: i64) -> i64 {
  let na = if a < 0 then 1 else 0;
  let aa = if na == 1 then 0 - a else a;
  let nb = if b < 0 then 1 else 0;
  let ab = if nb == 1 then 0 - b else b;
  let a1 = aa >> 32;
  let a0 = aa - (a1 << 32);
  let b1 = ab >> 32;
  let b0 = ab - (b1 << 32);
  let hi = a1 * b1;
  let mid = a1 * b0 + a0 * b1;
  let ah = a0 >> 16;
  let al = a0 - (ah << 16);
  let bh = b0 >> 16;
  let bl = b0 - (bh << 16);
  let ll_h = ah * bh;
  let ll_m = ah * bl + al * bh;
  let ll_l = al * bl;
  let low = ll_h + ((ll_m + (ll_l >> 16)) >> 16);
  let p = (hi << 32) + mid + low;
  let flip = na + nb;
  let flip = flip - (flip / 2) * 2;
  let p = if flip == 1 then 0 - p else p;
  p
}

// fp_div(a, b) = floor(a * 2^32 / b), a >= 0, b > 0.
fn fp_div(a: i64, b: i64) -> i64 {
  let q0 = a / b;
  let r = a - q0 * b;
  let q = 0;
  let i = 0;
  while i < 32 {
    let r = r * 2;
    let bit = if r >= b then 1 else 0;
    let q = q * 2 + bit;
    let r = r - bit * b;
    let i = i + 1;
    0
  };
  (q0 << 32) + q
}

// contract1(t, v, out): C_ik = T_ijk v^j, T flat with strides (4,2,1).
fn contract1(t: [i64], v: [i64], out: [i64]) -> i64 {
  let i = 0;
  while i < 2 {
    let k = 0;
    while k < 2 {
      let s = fp_mul(t[i * 4 + k], v[0]) + fp_mul(t[i * 4 + 2 + k], v[1]);
      let _ = out[i * 2 + k] = s;
      let k = k + 1;
      0
    };
    let i = i + 1;
    0
  };
  0
}

// dot(a, b, n) = a_i b^i (tensor.rs Tensor1::dot in fp).
fn dot(a: [i64], b: [i64], n: i64) -> i64 {
  let s = 0;
  let i = 0;
  while i < n {
    let s = s + fp_mul(a[i], b[i]);
    let i = i + 1;
    0
  };
  s
}

// matvec(g, v, out): out_i = g_ij v^j (lower with g, raise with ginv).
fn matvec(g: [i64], v: [i64], out: [i64]) -> i64 {
  let _ = out[0] = fp_mul(g[0], v[0]) + fp_mul(g[1], v[1]);
  let _ = out[1] = fp_mul(g[2], v[0]) + fp_mul(g[3], v[1]);
  0
}

// inv2(g, out): g^ij = adj(g) / det(g), det > 0 required.
fn inv2(g: [i64], out: [i64]) -> i64 {
  let det = fp_mul(g[0], g[3]) - fp_mul(g[1], g[2]);
  let id = fp_div(4294967296, det);
  let _ = out[0] = fp_mul(g[3], id);
  let _ = out[1] = fp_mul(0 - g[1], id);
  let _ = out[2] = fp_mul(0 - g[2], id);
  let _ = out[3] = fp_mul(g[0], id);
  det
}

fn hmix(h: i64, v: i64) -> i64 {
  let neg = if v < 0 then 1 else 0;
  let av = if neg == 1 then 0 - v else v;
  ((h * 31) & 72057594037927935) + av * 2 + neg
}

fn main() -> i64 {
  let one = 4294967296;
  let half = 2147483648;
  // T_ijk = (i+1)*1.0 + j*0.5 - k*0.25  (flat, strides 4,2,1)
  let t = zeros(8);
  let i = 0;
  while i < 8 {
    let ii = i / 4;
    let jj = (i / 2) - ii * 2;
    let kk = i - (i / 2) * 2;
    let _ = t[i] = (ii + 1) * one + jj * half - kk * (half / 2);
    let i = i + 1;
    0
  };
  let v = zeros(2);
  let _ = v[0] = one + half;      // 1.5
  let _ = v[1] = 0 - half;        // -0.5
  let c = zeros(4);
  let _ = contract1(t, v, c);
  let h = hmix(hmix(hmix(hmix(0, c[0]), c[1]), c[2]), c[3]);
  // metric g = [[2, 0.5],[0.5, 1]], det = 1.75
  let g = zeros(4);
  let _ = g[0] = 2 * one;
  let _ = g[1] = half;
  let _ = g[2] = half;
  let _ = g[3] = one;
  let gi = zeros(4);
  let det = inv2(g, gi);
  let h = hmix(hmix(hmix(hmix(hmix(h, det), gi[0]), gi[1]), gi[2]), gi[3]);
  let lo = zeros(2);
  let _ = matvec(g, v, lo);       // v_i = g_ij v^j
  let up = zeros(2);
  let _ = matvec(gi, lo, up);     // v^i = g^ij v_j
  let e0 = up[0] - v[0];
  let e1 = up[1] - v[1];
  let e0 = if e0 < 0 then 0 - e0 else e0;
  let e1 = if e1 < 0 then 0 - e1 else e1;
  let rt = if e0 + e1 < 8 then 1 else 0;
  // invariant scalar v_i v^i (same under lower-then-dot as g_ij v^i v^j)
  let s = dot(lo, v, 2);
  let h = hmix(hmix(hmix(hmix(hmix(h, lo[0]), lo[1]), up[0]), up[1]), s);
  h * 2 + rt
}
