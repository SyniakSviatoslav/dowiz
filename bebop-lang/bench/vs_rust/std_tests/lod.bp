module core { }

// lod.bp — T5: fractal LOD zoom. The macro-rotor R = 1+e12 is stored as
// a packed ternary rule (the T1 2-bit form); the refined layer is the
// algae L-rule expansion (depth 6, 21 cells, each cell = a blade index:
// 0 -> 1, 1 -> e12). The LOD path expands the rule ON DEMAND, applies the
// rotor sandwich to every blade (R 1 R~ = 2, R e12 R~ = 2 e12 — the
// Cayley-mask arithmetic of T1), folds the result into the macro-index
// digest, and collapses (the expansion buffers are reused, high-water
// bounded at 21 cells). The direct path accumulates the same sandwich
// from the fully materialized expansion — the equality IS the LOD
// lossless-collapse check. Fold = digest + eq*10^12 == 1000088904914
// (python mirror, journal at gate time).

fn main() -> i64 {
  let buf1 = zeros(512);
  let buf2 = zeros(512);
  let _ = buf1[0] = 0;
  let len1 = [1];
  let d = 0;
  while d < 6 {
    let sl = len1[0];
    let n = [0];
    let k = 0;
    while k < sl {
      let s = buf1[k];
      let _ = buf2[n[0]] = 0;
      let _ = n[0] = n[0] + 1;
      let _ = buf2[n[0]] = 1 - s;
      let _ = n[0] = n[0] + 1 - s;
      let k = k + 1;
      0
    };
    let _ = len1[0] = n[0];
    let k2 = 0;
    while k2 < n[0] {
      let _ = buf1[k2] = buf2[k2];
      let k2 = k2 + 1;
      0
    };
    let d = d + 1;
    0
  };
  let length = len1[0];
  // direct path: accumulate the sandwich over the materialized cells
  let acc1 = zeros(8);
  let k = 0;
  while k < length {
    let b = buf1[k];
    let is0 = 1 - b;
    let _ = acc1[0] = acc1[0] + 2 * is0;
    let _ = acc1[3] = acc1[3] + 2 * b;
    let k = k + 1;
    0
  };
  let dig1 = [0];
  let b = 0;
  while b < 8 {
    let p = (if b == 0 then 1 else 0) + (if b == 1 then 10 else 0) + (if b == 2 then 100 else 0) + (if b == 3 then 1000 else 0) + (if b == 4 then 10000 else 0) + (if b == 5 then 100000 else 0) + (if b == 6 then 1000000 else 0) + (if b == 7 then 10000000 else 0);
    let _ = dig1[0] = dig1[0] + (acc1[b] + 8) * p;
    let b = b + 1;
    0
  };
  // LOD path: re-expand from the rule; the macro-index digest folds ON
  // THE FLY while the final level is written (the guard d2==5 selects
  // the final expansion pass), then the buffers collapse to the rule.
  let _ = buf1[0] = 0;
  let l2 = [1];
  let acc2 = zeros(8);
  let d2 = 0;
  while d2 < 6 {
    let sl = l2[0];
    let n = [0];
    let k = 0;
    let isfin = if d2 == 5 then 1 else 0;
    while k < sl {
      let s = buf1[k];
      let _ = acc2[0] = acc2[0] + 2 * isfin;
      let _ = acc2[3] = acc2[3] + 2 * isfin * (1 - s);
      let _ = buf2[n[0]] = 0;
      let _ = n[0] = n[0] + 1;
      let _ = buf2[n[0]] = 1 - s;
      let _ = n[0] = n[0] + 1 - s;
      let k = k + 1;
      0
    };
    let _ = l2[0] = n[0];
    let k2 = 0;
    while k2 < n[0] {
      let _ = buf1[k2] = buf2[k2];
      let k2 = k2 + 1;
      0
    };
    let d2 = d2 + 1;
    0
  };
  let dig2 = [0];
  let b2 = 0;
  while b2 < 8 {
    let p = (if b2 == 0 then 1 else 0) + (if b2 == 1 then 10 else 0) + (if b2 == 2 then 100 else 0) + (if b2 == 3 then 1000 else 0) + (if b2 == 4 then 10000 else 0) + (if b2 == 5 then 100000 else 0) + (if b2 == 6 then 1000000 else 0) + (if b2 == 7 then 10000000 else 0);
    let _ = dig2[0] = dig2[0] + (acc2[b2] + 8) * p;
    let b2 = b2 + 1;
    0
  };
  let eq = if dig2[0] == dig1[0] then 1 else 0;
  let _ = buf1[0] = 0;
  dig1[0] + eq * 1000000000000
}
