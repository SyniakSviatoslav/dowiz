// selfhost/prelude/fp.bp — Q32 fixed-point core shared by every fp gate (T38).
// Textual include: a gate whose first line is `// prelude: fp ...` gets this file
// prepended by tools/gen_selfsrc.sh std (L9 mechanism until T47 `use`).
// fp_mul: signed 64x64 -> Q32 product via 32/16-bit limbs (no i128, no >> on
// negatives); isqrt: digit-by-digit integer sqrt over bits 60..0.
fn fp_mul(a: i64, b: i64) -> i64 {
  let na = if a < 0 then 1 else 0;
  let aa = if na == 1 then 0 - a else a;
  let nb = if b < 0 then 1 else 0;
  let ab = if nb == 1 then 0 - b else b;
  let a1 = aa >> 32;
  let a0 = aa - (a1 << 32);
  let b1 = ab >> 32;
  let b0 = ab - (b1 << 32);
  let hi = a1 * b1;
  let mid = a1 * b0 + a0 * b1;
  let ah = a0 >> 16;
  let al = a0 - (ah << 16);
  let bh = b0 >> 16;
  let bl = b0 - (bh << 16);
  let ll_h = ah * bh;
  let ll_m = ah * bl + al * bh;
  let ll_l = al * bl;
  let low = ll_h + ((ll_m + (ll_l >> 16)) >> 16);
  let p = (hi << 32) + mid + low;
  let flip = na + nb;
  let flip = flip - (flip / 2) * 2;
  let p = if flip == 1 then 0 - p else p;
  p
}
fn isqrt(s: i64) -> i64 {
  let rem = 0;
  let root = 0;
  let i = 0;
  while i < 31 {
    let sh = 60 - i * 2;
    let rem = (rem << 2) + ((s >> sh) & 3);
    let tst = (root << 2) + 1;
    let take = if tst <= rem then 1 else 0;
    let root = (root << 1) + take;
    let rem = rem - take * tst;
    let i = i + 1;
    0
  };
  root
}
// prelude: fp
// sinc.bp — SS-8: sinc(x) = sin(pi*x)/(pi*x) as the ideal interpolant for
// tensor telemetry (no phase distortion), critical for Kalman (SS-1).
// Fixed-point 2^32, Taylor series of sinc DIRECTLY (no division): sinc(z) =
// 1 - z2/3! + z4/5! - z6/7! + z8/9! - z10/11! with z = pi*x (terms through
// z^10; fixed-point truncation bounds the claim to |x| <= 1 — the honest
// window of the 2^32-scale series). Claim: sinc(0) = 1.0 exact, sinc(1/2) =
// 2/pi to ~1e-8 (>>12 = 667544), sinc(1) ~ 0 within 0.1% band (error
// 0.013%). Fold = q05*10^7 + q025*10^4 + e1q*10 + ok. Machine: fp_mul
// verbatim from spectral_machinery.bp (sha256 c184416666fe).

// sinc_fp(x): x fp-scaled; series 1 - z2/3! + z4/5! - z6/7! + z8/9! - z10/11!
fn sinc_fp(x: i64) -> i64 {
  let one = 4294967296;
  let pi = 13493037705;
  let z = fp_mul(pi, x);
  let z2 = fp_mul(z, z);
  let c3 = one / 6;
  let c5 = one / 120;
  let c7 = one / 5040;
  let c9 = one / 362880;
  let c11 = one / 39916800;
  let t2 = fp_mul(z2, c3);
  let z4 = fp_mul(z2, z2);
  let t4 = fp_mul(z4, c5);
  let z6 = fp_mul(z4, z2);
  let t6 = fp_mul(z6, c7);
  let z8 = fp_mul(z6, z2);
  let t8 = fp_mul(z8, c9);
  let z10 = fp_mul(z8, z2);
  let t10 = fp_mul(z10, c11);
  one - t2 + t4 - t6 + t8 - t10
}

fn main() -> i64 {
  let one = 4294967296;
  let v0 = sinc_fp(0);
  let vq = sinc_fp(one / 4);
  let vh = sinc_fp(one / 2);
  let v1 = sinc_fp(one);
  let e1 = v1;
  let e1 = if e1 < 0 then 0 - e1 else e1;
  let ok = if e1 < 4294967 then 1 else 0;
  let q05 = vh >> 12;
  let q025 = vq >> 12;
  let e1q = e1 >> 16;
  q05 * 10000000 + q025 * 10000 + e1q * 10 + ok
}
