use "selfhost/prelude/sha256.bp"
use "selfhost/prelude/store.bp"
use "selfhost/prelude/gb.bp"
// gb_par_mxv.bp -- B6 step 2: par_run over mxv, 3 A78 cores (4-6). Sequential vs
// parallel fold + timing. Returns ok*1e12 + seq_ms*1e6 + par_ms (nn4 encoding).
// par_run: W workers pinned to cores 4..6 via sys_setaffinity; dynamic chunk
// queue (over-decompose n rows into W*4 chunks, sys_atomic_add on q). mxv's
// output rows are disjoint per range, so no merge needed -- fold the whole y.

fn wr_str(dst: [i64], pos: [i64], s: str) -> i64 {
  let off = pos[0];
  let n = str_len(s);
  let i = 0;
  while i < n {
    let _ = dst[off + i] = char(s, i);
    let i = i + 1;
    0
  };
  let _ = pos[0] = off + n;
  0
}

fn gb_mxv_row(base: [i64], M: i64, X: i64, i: i64) -> i64 {
  let lo = gb_row_lo(base, M, i);
  let hi = gb_row_hi(base, M, i);
  let k = lo;
  let acc = 0;
  while k < hi {
    let j = gb_col(base, M, k);
    let w = gb_val(base, M, k);
    let acc = acc + (arr_get(base, X, j) * w) / 4294967296;
    let k = k + 1;
    0
  };
  acc
}

// par_mxv(env, n, cells, W, q, y): spawn W workers, each runs par_mxv_worker.
// env = [base, M, X]. core_masks = cells[W*2+1..W*2+1+W).
fn par_mxv(env: [i64], n: i64, cells: [i64], W: i64, q: [i64], y: [i64]) -> i64 {
  let base2 = sys_arena_base();
  let i = 0;
  while i < W {
    let r = sys_clone(68864, base2 + 16384 + i * 8192);
    let _ = if r == 0 then sys_setaffinity(cells, W * 2 + 1 + i) else 0;
    let _ = if r == 0 then par_mxv_worker(env, n, cells, W, q, y) else 0;
    let _ = sys_cond_set(if r == 0 then 1 else 0, cells, W + i, 1);
    let _ = sys_futex_wake(cells, W + i, 64);
    let parked = if r == 0 then 0 else 1;
    while parked == 0 {
      let _ = sys_futex_wait_guard(if r == 0 then 0 else 1, cells, W * 2, 0);
      let parked = if cells[W * 2] == 1 then 1 else 0;
      0
    };
    let i = i + 1;
    0
  };
  let k = 0;
  while k < W {
    let parked = 0;
    while parked == 0 {
      let _ = sys_futex_wait_guard(0, cells, W + k, 0);
      let parked = if cells[W + k] == 1 then 1 else 0;
      0
    };
    let k = k + 1;
    0
  };
  0
}

// par_mxv_worker: the clone-spanning worker. <= 8 live symbols across sys_clone.
fn par_mxv_worker(env: [i64], n: i64, cells: [i64], W: i64, q: [i64], y: [i64]) -> i64 {
  let base = env[0];
  let M = env[1];
  let X = env[2];
  let chunk = (n + W * 4 - 1) / (W * 4);
  let go = 1;
  while go == 1 {
    let c = sys_atomic_add(q, 0, 1);
    let more = if c >= W * 4 then 0 else 1;
    let _ = if more == 1 then {
      let lo = c * chunk;
      let hi = if lo + chunk < n then lo + chunk else n;
      let i = lo;
      while i < hi {
        let acc = gb_mxv_row(base, M, X, i);
        let _ = y[i] = acc;
        let i = i + 1;
        0
      };
      0
    } else 0;
    let go = more;
    0
  };
  0
}

fn fold_vec(y: [i64], n: i64) -> i64 {
  let i = 0;
  let acc = 0;
  while i < n {
    let acc = acc + y[i];
    let i = i + 1;
    0
  };
  acc
}

fn main(argc: i64, argv: [str]) -> i64 {
  let dir = argv[2];
  let path = zeros(256);
  let ppos = zeros(1);
  let _ = wr_str(path, ppos, dir);
  let _ = wr_str(path, ppos, "/b6_mxv.store");
  let tmp = zeros(1024);
  let base = st_open(path, ppos[0], 4194304, tmp);
  let tx = zeros(6);
  let _ = st_begin(base, tx, tmp);
  let dg = zeros(6);
  let _ = gb_digests(dg);
  let A = gb_build_random_lcg(base, tx, tmp, dg);
  let n = 1000;
  let xloc = zeros(n);
  let i = 0;
  while i < n {
    let m3 = i - (i / 3) * 3;
    let m5 = i - (i / 5) * 5;
    let _ = xloc[i] = if m3 == 0 then 0 else (m5 + 1) * 4294967296;
    let i = i + 1;
    0
  };
  let X = arr_alloc(base, tx, st_digest("GbXV{arr i64}"), n);
  let k = 0;
  while k < n {
    let _ = arr_put(base, X, k, xloc[k]);
    let k = k + 1;
    0
  };
  let _ = st_seal(base, X, tmp);
  let root = st_alloc(base, tx, 2, st_digest("GbMxVRoot2{ref GbMatrix,ref GbVector}"));
  let _ = st_link(base, root, 0, A);
  let _ = st_link(base, root, 1, X);
  let _ = st_seal(base, root, tmp);
  let _ = st_commit(base, tx, root, tmp);

  // sequential mxv
  let y = zeros(n);
  let t0 = clock_ms();
  let i2 = 0;
  while i2 < n {
    let _ = y[i2] = gb_mxv_row(base, A, X, i2);
    let i2 = i2 + 1;
    0
  };
  let seq_ms = clock_ms() - t0;
  let fold_seq = fold_vec(y, n);

  // parallel mxv (W=3 workers on cores 4,5,6)
  let W = 3;
  let cells = zeros(W * 2 + 1 + W);
  let _ = cells[W * 2 + 1] = 16;
  let _ = cells[W * 2 + 2] = 32;
  let _ = cells[W * 2 + 3] = 64;
  let q = zeros(1);
  let y2 = zeros(n);
  let env = [base, A, X];
  let t1 = clock_ms();
  let _ = par_mxv(env, n, cells, W, q, y2);
  let par_ms = clock_ms() - t1;
  let fold_par = fold_vec(y2, n);

  let ok = if fold_par == fold_seq then 1 else 0;
  ok * 1000000000000 + seq_ms * 1000000 + par_ms
}
