// ROADMAP A7 step 3 (2026-09-10): scaled ingest twin, bebop CELLS row.
// sys_readbuf the file into the byte region, parse lines
// `id,u,v,cell,label` via char; fold = lines * 1000003 + sum(id).
// argv[2] = file path (seed convention: argv[0]=emulator, argv[1]=program).
fn main(argc: i64, argv: [str]) -> i64 {
  let p = zeros(256);
  let pn = str_len(argv[2]);
  let k = 0;
  while k < pn {
    let _ = p[k] = char(argv[2], k);
    let k = k + 1;
    0
  };
  // sys_open takes a [i64] cell buffer for the path, NOT a str handle.
  // p is the cell buffer containing the path bytes.
  let fd = sys_open(p, pn, 0);
  // sys_readbuf: allocate ceil(len/8) cells, read fd into byte region,
  // return (off<<32)|nread. Use 200MB ceiling for 100MB files.
  let s = sys_readbuf(fd, 209715200);
  let _ = sys_close(fd);
  let n = str_len(s);          // n = actual bytes read (file size)
  let i = 0;
  let lines = 0;
  let sum = 0;
  while i < n {
    let id = 0;
    let c = char(s, i);
    while c != 44 {
      let id = id * 10 + (c - 48);
      let i = i + 1;
      let c = char(s, i);
      0
    };
    let sum = sum + id;
    let d = char(s, i);
    while d != 10 {
      let i = i + 1;
      let d = char(s, i);
      0
    };
    let i = i + 1;
    let lines = lines + 1;
    0
  };
  lines * 1000003 + sum
}
