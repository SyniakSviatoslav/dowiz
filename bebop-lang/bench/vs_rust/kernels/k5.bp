// K5: NTT over Z/998244353, single-loop DIF (flattened butterflies).
fn mpow(b: i64, e: i64) -> i64 {
  let m = 998244353;
  let r = 1;
  let bb = b - (b / m) * m;
  let cont = if e > 0 then 1 else 0;
  while cont == 1 {
    let odd = e - (e / 2) * 2;
    let rb = r * bb;
    let r2 = if odd == 1 then rb - (rb / m) * m else r;
    let bsq = bb * bb;
    let bb2 = bsq - (bsq / m) * m;
    let e2 = e / 2;
    let r = r2;
    let bb = bb2;
    let e = e2;
    let cont = if e > 0 then 1 else 0;
    0
  };
  r
}
fn main() -> i64 {
  let m = 998244353;
  let n = 512;
  let half_total = n / 2;
  let stages = 9;
  let total = half_total * stages;
  let a = zeros(n);
  let i = 0;
  while i < n {
    let t = i * 2654435761;
    let _ = a[i] = t - (t / m) * m;
    let i = i + 1;
    0
  };
  let tt = 0;
  while tt < total {
    let stage = tt / half_total;
    let idx = tt - stage * half_total;
    let stg = 0;
    let lenv = 2;
    while stg < stage {
      let lenv = lenv * 2;
      let stg = stg + 1;
      0
    };
    let half = lenv / 2;
    let blk = idx / half;
    let j = idx - blk * half;
    let base = blk * lenv;
    let wl = mpow(3, 998244352 / lenv);
    let w = mpow(wl, j);
    let p1 = base + j;
    let p2 = base + j + half;
    let u = a[p1];
    let v0 = a[p2];
    let v1 = v0 * w;
    let v = v1 - (v1 / m) * m;
    let s0 = u + v;
    let s = if s0 >= m then s0 - m else s0;
    let d0 = u + m - v;
    let d1 = if d0 >= m then d0 - m else d0;
    let dw = d1 * w;
    let _ = a[p1] = s;
    let _ = a[p2] = dw - (dw / m) * m;
    let tt = tt + 1;
    0
  };
  let acc = 0;
  let i = 0;
  while i < n {
    let wt = (i + 1) * a[i];
    let acc = acc + wt - (wt / m) * m;
    let i = i + 1;
    0
  };
  acc - (acc / m) * m
}
