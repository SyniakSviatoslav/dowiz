// K6: hypervector bind+popcount on a 1024-bit VSA (16 x 64-bit words).
// Pure Bebop: XOR via native ^, population count via branch-free SWAR.
fn popcount(w: i64) -> i64 {
  let m1 = 6148914691236517205;
  let m2 = 3689348814741910323;
  let mh = 1085102592571150095;
  let x = w - ((w >> 1) & m1);
  let x = (x & m2) + ((x >> 2) & m2);
  let x = (x + (x >> 4)) & mh;
  let x = x + (x >> 8);
  let x = x + (x >> 16);
  let x = x + (x >> 32);
  x - (x / 128) * 128
}
fn main() -> i64 {
  let n = 16;
  let a = zeros(n);
  let b = zeros(n);
  let i = 0;
  while i < n {
    let ta = (i + 1) * 2654435761;
    let _ = a[i] = ta - (ta / 2147483647) * 2147483647;
    let tb = (i + 7) * 40503;
    let _ = b[i] = tb - (tb / 65521) * 65521;
    let i = i + 1;
    0
  };
  let i = 0;
  while i < n {
    let _ = a[i] = a[i] ^ b[i];
    let i = i + 1;
    0
  };
  let acc = 0;
  let i = 0;
  while i < n {
    let acc = acc + popcount(a[i]);
    let i = i + 1;
    0
  };
  acc
}
