// hv_stdlib.bp — pure-Bebo hypervector primitives (L3).
// A 1024-bit HV is [16]i64, little-endian words. All ops branch-free
// where it matters; popcount is SWAR on the native bitwise tier.

fn hv_pop1(w: i64) -> i64 {
  let m1 = 6148914691236517205;
  let m2 = 3689348814741910323;
  let mh = 1085102592571150095;
  let x = w - ((w >> 1) & m1);
  let x = (x & m2) + ((x >> 2) & m2);
  let x = (x + (x >> 4)) & mh;
  let x = x + (x >> 8);
  let x = x + (x >> 16);
  let x = x + (x >> 32);
  x - (x / 128) * 128
}

fn hv_rand(seed: i64, i: i64) -> i64 {
  let t = (i + 1) * seed;
  let s = t - (t / 2147483647) * 2147483647;
  let u = s * 2654435761;
  u - (u / 2147483647) * 2147483647
}

fn hv_hamming(a: [i64], b: [i64], n: i64) -> i64 {
  let acc = 0;
  let i = 0;
  while i < n {
    let x = a[i] ^ b[i];
    let acc = acc + hv_pop1(x);
    let i = i + 1;
    0
  };
  acc
}

fn hv_bind_into(a: [i64], b: [i64], n: i64) -> i64 {
  let i = 0;
  while i < n {
    let _ = a[i] = a[i] ^ b[i];
    let i = i + 1;
    0
  };
  0
}
