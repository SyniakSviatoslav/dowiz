// K8h (plain, no honest-twin REPS wrapper): same recurrence as bench630/k8ht.bp, one rep of
// 20000 iterations, used only for loop-word extraction (tools/perf.py loop_words()).
fn main() -> i64 {
  let acc = 0;
  let x = 1;
  let i = 20000;
  while i > 0 {
    let x = x * 6364136223846793005 + 1442695040888963407;
    let bit = (x >> 60) & 1;
    let acc = if bit == 1 then acc + x else acc - i;
    let i = i - 1;
    0
  };
  acc
}
