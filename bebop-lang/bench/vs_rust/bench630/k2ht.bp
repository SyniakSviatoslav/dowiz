// K2h bench: fib(25), REPS=100 reps in-process, main returns the TOTAL ms (honest.sh / REPS)
fn fib(n: i64) -> i64 { if n < 2 then n else fib(n - 1) + fib(n - 2) }
// REPS raised 100 -> 500 on 2026-09-08: at 100 this ran well under the ~100 ms floor
// bench/vs_rust/kernel_reps.txt now demands, so its bebop/Rust ratio was the box, not the
// code. Keep this number and rust_once/k2h.rs and kernel_reps.txt in step.
fn main() -> i64 {
  let t0 = clock_ms();
  let r = 0;
  let rep = 500;
  while rep > 0 { let r = r + fib(25); let rep = rep - 1; 0 };
  (clock_ms() - t0) + r * 0
}
