// K2h bench: fib(25), REPS=100 reps in-process, main returns the TOTAL ms (honest.sh / REPS)
fn fib(n: i64) -> i64 { if n < 2 then n else fib(n - 1) + fib(n - 2) }
fn main() -> i64 {
  let t0 = clock_ms();
  let r = 0;
  let rep = 100;
  while rep > 0 { let r = r + fib(25); let rep = rep - 1; 0 };
  (clock_ms() - t0) + r * 0
}
