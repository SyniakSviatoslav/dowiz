// K2 bench: fib(25) x20, in-process clock_ms delta (result = ms per fib)
fn fib(n: i64) -> i64 { if n < 2 then n else fib(n - 1) + fib(n - 2) }
fn main() -> i64 {
  let t0 = clock_ms();
  let r = 0;
  let k = 20;
  while k > 0 { let r = fib(25); let k = k - 1; 0 };
  ((clock_ms() - t0) * 10) / 20
}
