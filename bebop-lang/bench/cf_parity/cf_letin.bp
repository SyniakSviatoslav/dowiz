// W-CFVAL F2 (2026-10-09): `while` inside a parenthesised let-in is not a statement (`;` is `in` there):
// E101 without R-CF. R-CF folded it and the INVALID program compiled and printed 1600. Must stay refused.
// CF-EXPECT rc=101 out=- touched=0
fn main() -> i64 {
  let s = 1;
  let r = (let i = 0; while i < 4 { let s = s * 2; let i = i + 1; 0 });
  s * 100 + r
}
