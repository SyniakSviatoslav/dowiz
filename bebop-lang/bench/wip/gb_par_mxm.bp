use "selfhost/prelude/sha256.bp"
use "selfhost/prelude/store.bp"
use "selfhost/prelude/gb.bp"
// gb_par_mxm.bp -- B6 step 3: par_run over mxm, 3 A78 cores (4-6). Sequential vs
// parallel fold + timing. Returns ok*1e12 + seq_ms*1e6 + par_ms (nn4 encoding).
// par_run: W workers pinned to cores 4..6 via sys_setaffinity; dynamic chunk
// queue (over-decompose n rows into W*4 chunks, sys_atomic_add on q). mxm's
// output rows are disjoint per range, so no merge needed -- fold the whole C.

fn wr_str(dst: [i64], pos: [i64], s: str) -> i64 {
  let off = pos[0];
  let n = str_len(s);
  let i = 0;
  while i < n {
    let _ = dst[off + i] = char(s, i);
    let i = i + 1;
    0
  };
  let _ = pos[0] = off + n;
  0
}

// par_mxm: row-range partitioning of mxm over W workers. Each worker computes its own
// row range of C = A*B via Gustavson + SPA. Disjoint output rows = no merge needed.
fn par_mxm(base: [i64], tx: [i64], tmp: [i64], A: i64, B: i64, n: i64, m: i64, sr: i64, dg: [i64], W: i64, cells: [i64], q: [i64]) -> i64 {
  let stamp = zeros(m);
  let acc = zeros(m);
  let rs = zeros(1);
  let cnt = zeros(1);
  let rp = arr_alloc(base, tx, dg[0], n + 1);

  // pass 1: count nnz per row (parallel)
  let chunk = (n + W * 4 - 1) / (W * 4);
  let base2 = sys_arena_base();
  let i = 0;
  while i < W {
    let r = sys_clone(68864, base2 + 16384 + i * 8192);
    let _ = if r == 0 then sys_setaffinity(cells, W * 2 + 1 + i) else 0;
    let _ = if r == 0 then mxm_count_worker(base, A, B, sr, n, W, q, rp, stamp, acc, rs, cnt, chunk) else 0;
    let _ = sys_cond_set(if r == 0 then 1 else 0, cells, W + i, 1);
    let _ = sys_futex_wake(cells, W + i, 64);
    let parked = if r == 0 then 0 else 1;
    while parked == 0 {
      let _ = sys_futex_wait_guard(if r == 0 then 0 else 1, cells, W * 2, 0);
      let parked = if cells[W * 2] == 1 then 1 else 0;
      0
    };
    let i = i + 1;
    0
  };
  let k = 0;
  while k < W {
    let parked = 0;
    while parked == 0 {
      let _ = sys_futex_wait_guard(0, cells, W + k, 0);
      let parked = if cells[W + k] == 1 then 1 else 0;
      0
    };
    let k = k + 1;
    0
  };

  // prefix sum on rp
  let v = 0;
  while v < n {
    let _ = arr_put(base, rp, v + 1, arr_get(base, rp, v + 1) + arr_get(base, rp, v));
    let v = v + 1;
    0
  };
  let nnz = arr_get(base, rp, n);
  let ci = arr_alloc(base, tx, dg[1], nnz);
  let vv = arr_alloc(base, tx, dg[2], nnz);

  // pass 2: fill (parallel)
  let q2 = zeros(1);
  let i2 = 0;
  while i2 < W {
    let r = sys_clone(68864, base2 + 16384 + i2 * 8192);
    let _ = if r == 0 then sys_setaffinity(cells, W * 2 + 1 + i2) else 0;
    let _ = if r == 0 then mxm_fill_worker(base, A, B, sr, n, m, W, q2, rp, ci, vv, stamp, acc, rs, chunk) else 0;
    let _ = sys_cond_set(if r == 0 then 1 else 0, cells, W + i2 + 1, 1);
    let _ = sys_futex_wake(cells, W + i2 + 1, 64);
    let parked = if r == 0 then 0 else 1;
    while parked == 0 {
      let _ = sys_futex_wait_guard(if r == 0 then 0 else 1, cells, W * 2, 0);
      let parked = if cells[W * 2] == 1 then 1 else 0;
      0
    };
    let i2 = i2 + 1;
    0
  };
  let k2 = 0;
  while k2 < W {
    let parked = 0;
    while parked == 0 {
      let _ = sys_futex_wait_guard(0, cells, W + k2 + 1, 0);
      let parked = if cells[W + k2 + 1] == 1 then 1 else 0;
      0
    };
    let k2 = k2 + 1;
    0
  };

  let _ = st_seal(base, rp, tmp);
  let _ = st_seal(base, ci, tmp);
  let _ = st_seal(base, vv, tmp);
  gb_matrix_seal(base, tx, tmp, dg[3], n, m, nnz, 1, rp, ci, vv)
}

// mxm_count_worker: pass 1 of parallel mxm -- count nnz per row in range.
fn mxm_count_worker(base: [i64], A: i64, B: i64, sr: i64, n: i64, W: i64, q: [i64], rp: ref GbArr, stamp: [i64], acc: [i64], rs: [i64], cnt: [i64], chunk: i64) -> i64 {
  let go = 1;
  while go == 1 {
    let c = sys_atomic_add(q, 0, 1);
    let _ = if c >= W * 4 then go = 0 else 0;
    let _ = if go == 1 then {
      let lo = c * chunk;
      let hi = if lo + chunk < n then lo + chunk else n;
      let i = lo;
      while i < hi {
        let c2 = gb_mxm_row(base, A, B, sr, i, stamp, acc, rs, cnt);
        let _ = arr_put(base, rp, i + 1, c2);
        let i = i + 1;
        0
      };
      0
    } else 0;
    0
  };
  0
}

// mxm_fill_worker: pass 2 of parallel mxm -- fill ci/vv for rows in range.
fn mxm_fill_worker(base: [i64], A: i64, B: i64, sr: i64, n: i64, m: i64, W: i64, q: [i64], rp: ref GbArr, ci: ref GbArr, vv: ref GbArr, stamp: [i64], acc: [i64], rs: [i64], chunk: i64) -> i64 {
  let go = 1;
  while go == 1 {
    let c = sys_atomic_add(q, 0, 1);
    let _ = if c >= W * 4 then go = 0 else 0;
    let _ = if go == 1 then {
      let lo = c * chunk;
      let hi = if lo + chunk < n then lo + chunk else n;
      let i = lo;
      while i < hi {
        let _ = gb_mxm_row(base, A, B, sr, i, stamp, acc, rs, zeros(1));
        let s2 = rs[0];
        let wp = zeros(1);
        let _ = wp[0] = arr_get(base, rp, i);
        let _ = gb_mxm_write_row(base, ci, vv, m, s2, stamp, acc, wp);
        let i = i + 1;
        0
      };
      0
    } else 0;
    0
  };
  0
}

fn main(argc: i64, argv: [str]) -> i64 {
  let dir = argv[2];
  let path = zeros(256);
  let ppos = zeros(1);
  let _ = wr_str(path, ppos, dir);
  let _ = wr_str(path, ppos, "/b6_mxm.store");
  let tmp = zeros(1024);
  let base = st_open(path, ppos[0], 4194304, tmp);
  let tx = zeros(6);
  let _ = st_begin(base, tx, tmp);
  let dg = zeros(6);
  let _ = gb_digests(dg);
  let A = gb_build_random_lcg(base, tx, tmp, dg);
  let n = 1000;
  let nnz_A = st_get(base, A, 2);
  let esrc = zeros(nnz_A + 1);
  let edst = zeros(nnz_A + 1);
  let eval = zeros(nnz_A + 1);
  let cur = zeros(n);
  let B = gb_transpose(base, tx, tmp, A, dg, esrc, edst, eval, cur);
  let m = 1000;
  let sr = 3;
  let root = st_alloc(base, tx, 2, st_digest("GbMxMRoot2{ref GbMatrix,ref GbMatrix}"));
  let _ = st_link(base, root, 0, A);
  let _ = st_link(base, root, 1, B);
  let _ = st_seal(base, root, tmp);
  let _ = st_commit(base, tx, root, tmp);

  // sequential mxm
  let t0 = clock_ms();
  let C = gb_mxm(base, tx, tmp, A, B, sr, dg);
  let seq_ms = clock_ms() - t0;
  let fold_seq = gb_reduce_scalar(base, C);

  // parallel mxm (W=3 workers on cores 4,5,6)
  let W = 3;
  let cells = zeros(W * 2 + 1 + W);
  let _ = cells[W * 2 + 1] = 16;
  let _ = cells[W * 2 + 2] = 32;
  let _ = cells[W * 2 + 3] = 64;
  let q = zeros(1);
  let t1 = clock_ms();
  let C2 = par_mxm(base, tx, tmp, A, B, n, m, sr, dg, W, cells, q);
  let par_ms = clock_ms() - t1;
  let fold_par = gb_reduce_scalar(base, C2);

  let ok = if fold_par == fold_seq then 1 else 0;
  ok * 1000000000000 + seq_ms * 1000000 + par_ms
}
