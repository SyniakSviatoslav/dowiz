// T107 incremental-substrate curve (2026-09-05). A 16-layer x 4096-wide grid DAG
// (N = 2^16 cells; cell (l,c) = op(two cells of layer l-1 within c-1..c+1, chosen
// by an LCG), op(x,y) = (x*31 + y*17) ^ (x >>> 3), wrapping). Each rep changes k
// layer-0 inputs; mode f = full recompute of all 61440 non-input cells, mode s =
// sweep: dirty bitset (1024 words), drain each word LSB-first (x & -x, index via
// clz), recompute the cell, mark dependents in c-1..c+1 of the next layer that
// really read it. One pass is exact because dependents live in a later word.
// argv: <k> <s|f> <t|f>  -> prints microseconds per rep (t) or the fold (f).
// Rust twin: incr_twin.rs (same DAG, same ops, same fold). Runner: incr.sh.
fn parse(s: str) -> i64 {
  let n = str_len(s);
  let i = 0;
  let v = 0;
  while i < n {
    let v = v * 10 + (char(s, i) - 48);
    let i = i + 1;
    0
  };
  v
}
fn op(x: i64, y: i64) -> i64 {
  (x * 31 + y * 17) ^ (x >>> 3)
}
fn build(s1: [i64], s2: [i64], val: [i64]) -> i64 {
  let c = 0;
  while c < 4096 {
    let _ = val[c] = c * 2654435761;
    let c = c + 1;
    0
  };
  let g = 88172645463325252;
  let i = 4096;
  while i < 65536 {
    let g = (g * 6364136223846793005 + 1442695040888963407);
    let l = i >> 12;
    let c = i & 4095;
    let a = c + ((g >> 33) % 3) - 1;
    let b = c + ((g >> 40) % 3) - 1;
    let a = if a < 0 then 0 else if a > 4095 then 4095 else a;
    let b = if b < 0 then 0 else if b > 4095 then 4095 else b;
    let _ = s1[i] = (l - 1) * 4096 + a;
    let _ = s2[i] = (l - 1) * 4096 + b;
    let i = i + 1;
    0
  };
  0
}
fn full(s1: [i64], s2: [i64], val: [i64]) -> i64 {
  let i = 4096;
  while i < 65536 {
    let _ = val[i] = op(val[s1[i]], val[s2[i]]);
    let i = i + 1;
    0
  };
  0
}
// mark(j, i): dependents of i among cells j-1..j+1 (already layer-aligned).
fn mark(d: [i64], s1: [i64], s2: [i64], j: i64, i: i64) -> i64 {
  let t = j - 1;
  while t <= j + 1 {
    let reads = if s1[t] == i then 1 else if s2[t] == i then 1 else 0;
    let _ = if reads == 1 then (let _ = d[t >> 6] = d[t >> 6] | (1 << (t & 63)) in 0) else 0;
    let t = t + 1;
    0
  };
  0
}
fn sweep(d: [i64], s1: [i64], s2: [i64], val: [i64], fired: [i64]) -> i64 {
  let w = 0;
  while w < 1024 {
    while d[w] != 0 {
      let x = d[w];
      let low = x & (0 - x);
      let _ = d[w] = x - low;
      let i = w * 64 + 63 - clz(low);
      let _ = fired[0] = fired[0] + 1;
      let _ = if i >= 4096 then (let _ = val[i] = op(val[s1[i]], val[s2[i]]) in 0) else 0;
      let c = i & 4095;
      let j = i + 4096;
      let j0 = if c == 0 then j + 1 else if c == 4095 then j - 1 else j;
      let _ = if i < 61440 then mark(d, s1, s2, j0, i) else 0;
      0
    };
    let w = w + 1;
    0
  };
  0
}
fn fold(val: [i64]) -> i64 {
  let i = 0;
  let f = 0;
  while i < 65536 {
    let f = f + (val[i] ^ i);
    let i = i + 1;
    0
  };
  f
}
fn main(argc: i64, argv: [str]) -> i64 {
  let k = parse(argv[2]);
  let is_sweep = if char(argv[3], 0) == 115 then 1 else 0;
  let want_fold = if char(argv[4], 0) == 102 then 1 else 0;
  let s1 = zeros(65536);
  let s2 = zeros(65536);
  let val = zeros(65536);
  let d = zeros(1024);
  let fired = zeros(1);
  let _ = build(s1, s2, val);
  let _ = full(s1, s2, val);
  let t0 = clock_ms();
  let rep = 0;
  let g = 1;
  while rep < 64 {
    let j = 0;
    let g2 = g;
    while j < k {
      let g2 = (g2 * 6364136223846793005 + 1442695040888963407);
      let c = (g2 >> 20) & 4095;
      let _ = val[c] = val[c] + 12345 + rep;
      let _ = if is_sweep == 1 then (let _ = d[c >> 6] = d[c >> 6] | (1 << (c & 63)) in 0) else 0;
      let j = j + 1;
      0
    };
    let g = g2;
    let _ = if is_sweep == 1 then sweep(d, s1, s2, val, fired) else full(s1, s2, val);
    let rep = rep + 1;
    0
  };
  let t1 = clock_ms();
  if want_fold == 1 then fold(val) else (t1 - t0) * 1000 / 64
}
