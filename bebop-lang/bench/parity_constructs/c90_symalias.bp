// A4 fuzz DIVERGE round 2 (2026-09-07), root cause 5: a bare symbol operand
// pushes a lazy `SYM r` tag (no word) that only reads register/slot `r` at
// materialise time. A sibling operand evaluated afterward can itself write
// that same symbol (emit_let_chain / emit_compound_stmt call vs_bind
// directly, with no `let`-creation step for check_reg_collision to see) --
// the pending `SYM r` tag then reads the NEW value instead of the value it
// held when pushed. Same snapshot hazard as RC1 (emit_compound_rhs), one
// level more general: RC1 only guarded op='s own implicit left operand.
fn main() -> i64 {
  let v0 = 0;
  let a0 = [16, 1, 2, 3, 4, 5, 6, 15];
  (v0) > (let _ = v0 = a0[(v0) & 7] in 8)
}
