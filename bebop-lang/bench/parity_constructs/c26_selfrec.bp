// multi-argument self-recursion: emit_self_call used to parse exactly ONE
// argument and strand pos on the first ",", so every recursive fn with more
// than one parameter (gcd, ackermann, modular pow) silently returned garbage
// while 1-arg recursion (c09) was right (T42 2026-09-04)
fn gcd(a: i64, b: i64) -> i64 { if b == 0 then a else gcd(b, a % b) }
fn ack(m: i64, n: i64) -> i64 { if m == 0 then n + 1 else (if n == 0 then ack(m - 1, 1) else ack(m - 1, ack(m, n - 1))) }
fn powm(b: i64, e: i64, m: i64) -> i64 { if e == 0 then 1 else (b * powm(b, e - 1, m)) % m }
fn main() -> i64 { gcd(48, 18) * 10000 + ack(2, 3) * 100 + powm(3, 5, 100) }
