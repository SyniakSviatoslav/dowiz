// spilled-array-in-conditional guard: call with spilled array inside if
fn callee(tab: [i64], i: i64) -> i64 { tab[i] }
fn f(a: i64, b: i64, c: i64, d: i64, e: i64, g: i64, h: i64, k: i64, tab: [i64], flg: i64) -> i64 { if flg == 1 then callee(tab, 2) else 0 }
fn main() -> i64 { f(1,2,3,4,5,6,7,8,[7,8,99],1) }
