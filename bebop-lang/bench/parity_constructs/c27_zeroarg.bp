// T42(e) zero-arg builtin call as a let RHS: emit_clock_ms used to consume
// the `()` AND the trailing `;`, eating the first char of the next
// statement (`let i` -> `et i`: unbound-ident reads, hangs). The clock
// value is discarded; the gate is the statement sequence after it.
fn main() -> i64 { let t0 = clock_ms(); let i = 0; while i < 3 { let i = i + 1; 0 }; 7 }
