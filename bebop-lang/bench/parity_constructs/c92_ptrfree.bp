// c92_ptrfree (ROADMAP A5 step 1b, 2026-09-08; REWRITTEN 2026-09-09 for F3 commit 2,
// which makes cell stepping unrepresentable). No ADDRESS ever escapes into a cell: an
// array VALUE is carried through calls under two different names, indexed in a callee,
// and the fold must agree. Under the index model the value that travels is a small cell
// index, not a 2^47-ish pointer -- the same program, the same answer, with nothing
// pointer-shaped in the data.
// The second name was `let b = a + 5` and is now `let b = a`. The property being pinned
// is that the SAME STORAGE reached through TWO NAMES and carried through a call agrees;
// the stepping was only how that second name happened to be made. `deref` reads a[5]
// through `b` directly instead of b[0] through a stepped base.
// `deref` takes the carried value back as `[i64]` so the typecheck census (rung vii)
// still sees a typed array everywhere and never an i64 masquerading as one.
// THE VALUE IS UNCHANGED, 777920.
// EXPECT 777920 from: hand: pointer-free region
fn deref(t: [i64], k: i64) -> i64 { t[k] }
fn carry(t: [i64], a: [i64], b: [i64]) -> i64 {
  let _ = t[0] = deref(a, 2);
  let _ = t[1] = deref(b, 5);
  t[0] + t[1]
}
fn main() -> i64 {
  let a = zeros(8);
  let _ = a[2] = 777;
  let _ = a[5] = 13;
  let b = a;
  let t = zeros(2);
  let n = carry(t, a, b);
  t[0] * 1000 + t[1] * 10 + n
}
