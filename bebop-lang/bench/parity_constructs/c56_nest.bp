// IR-RUNG-BLUEPRINT §5 row 4: deep right-nesting, 8 symbols + a 9th (h) in an x15 slot.
fn nest(p: i64) -> i64 {
  let a = p+1; let b = p+2; let c = p+3; let d = p+4;
  let e = p+5; let f = p+6; let g = p+7; let h = p+8;
  (a*2+1) + ((b*2+1) + ((c*2+1) + ((d*2+1) + ((e*2+1) + ((f*2+1) + ((g*2+1) + (h*2+1)))))))
}
fn main() -> i64 { nest(10) }
