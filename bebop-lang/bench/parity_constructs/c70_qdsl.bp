// c70_qdsl.bp — c70 construct: verify qdsl parsing via bpref
// Tests that qdsl_parse returns correct fingerprints for various queries
// EXPECT 286389246398 from: hand: QDSL query (fingerprint B7) — includes identifier text

fn qdsl_char(s: str, i: i64) -> i64 { char(s, i) }
fn qdsl_len(s: str) -> i64 { str_len(s) }

fn qdsl_ws(s: str, p: i64) -> i64 {
  let n = qdsl_len(s);
  if p >= n then p
  else let c = char(s, p);
  if c == 32 then qdsl_ws(s, p+1)
  else if c == 9 then qdsl_ws(s, p+1)
  else if c == 10 then qdsl_ws(s, p+1)
  else if c == 13 then qdsl_ws(s, p+1)
  else p
}

fn qdsl_nsz(nc: i64) -> i64 { 3 + nc }

fn qdsl_alloc(kind: i64, nc: i64, attr: i64, a: [i64], ap: [i64]) -> i64 {
  let sz = qdsl_nsz(nc); let off = ap[0];
  let _ = a[off] = kind; let _ = a[off+1] = nc; let _ = a[off+2] = attr;
  let _ = ap[0] = off + sz; off
}

fn qdsl_set(node: i64, ci: i64, child: i64, a: [i64]) -> i64 { let _ = a[node+3+ci] = child; 0 }
fn qdsl_kind(node: i64, a: [i64]) -> i64 { a[node] }
fn qdsl_nch(node: i64, a: [i64]) -> i64 { a[node+1] }
fn qdsl_attr(node: i64, a: [i64]) -> i64 { a[node+2] }
fn qdsl_ch(node: i64, ci: i64, a: [i64]) -> i64 { a[node+3+ci] }

fn qdsl_and(a: i64, b: i64) -> i64 { if a == 0 then 0 else (if b == 0 then 0 else 1) }

fn qdsl_ident(s: str, p: i64, a: [i64], ap: [i64], sb: [i64], sp: [i64]) -> i64 {
  let p = qdsl_ws(s, p); let n = qdsl_len(s);
  let c = char(s, p);
  let ok = if qdsl_and(c >= 65, c <= 90) == 1 then 1 else if qdsl_and(c >= 97, c <= 122) == 1 then 1 else if c == 95 then 1 else 0;
  let _ = if ok == 0 then (let _ = p = n in 0) else 0;
  let bu = sp[0]; let pi = 0;
  // iterative loop instead of qdsl_ident_rec
  let done = 0; let result = 0;
  while done == 0 {
    let _ = if p >= n then (let _ = sp[0] = bu + pi + 1 in let _ = sb[bu+pi] = 0 in
      let node = qdsl_alloc(10, 0, bu, a, ap); let _ = done = 1 in let _ = result = (p << 32) | node in 0) else 0;
    let c2 = char(s, p);
    let ok2 = if qdsl_and(c2 >= 65, c2 <= 90) == 1 then 1 else if qdsl_and(c2 >= 97, c2 <= 122) == 1 then 1 else if c2 == 95 then 1 else if qdsl_and(c2 >= 48, c2 <= 57) == 1 then 1 else 0;
    let _ = if ok2 == 0 then (let _ = sp[0] = bu + pi + 1 in let _ = sb[bu+pi] = 0 in
      let node = qdsl_alloc(10, 0, bu, a, ap); let _ = done = 1 in let _ = result = (p << 32) | node in 0) else 0;
    let _ = sb[bu+pi] = c2;
    let _ = p = p + 1; let _ = pi = pi + 1;
    0
  };
  result
}

fn qdsl_int(s: str, p: i64, a: [i64], ap: [i64], sb: [i64], sp: [i64]) -> i64 {
  let p = qdsl_ws(s, p); let n = qdsl_len(s);
  let v = 0; let st = p;
  // iterative loop instead of qdsl_int_rec
  let done = 0; let result = 0;
  while done == 0 {
    let _ = if p >= n then (let _ = if p == st then (let _ = p = n in 0) else 0 in
      let node = qdsl_alloc(10, 0, v, a, ap); let _ = done = 1 in let _ = result = (p << 32) | node in 0) else 0;
    let c = char(s, p);
    let ok = if qdsl_and(c >= 48, c <= 57) == 1 then 1 else 0;
    let _ = if ok == 0 then (let _ = if p == st then (let _ = p = n in 0) else 0 in
      let node = qdsl_alloc(10, 0, v, a, ap); let _ = done = 1 in let _ = result = (p << 32) | node in 0) else 0;
    let _ = v = v * 10 + (c - 48); let _ = p = p + 1;
    0
  };
  result
}

fn qdsl_cmp(s: str, p: i64, a: [i64], ap: [i64], sb: [i64], sp: [i64]) -> i64 {
  let p = qdsl_ws(s, p); let n = qdsl_len(s);
  let r = qdsl_ident(s, p, a, ap, sb, sp);
  let _ = if r == 0 then (let _ = p = n in 0) else 0;
  let _ = if r == 0 then 0 else 0;
  let l = r & 0xffffffff; let _ = p = r >> 32;
  let p = qdsl_ws(s, p);
  let op = 0; let ol = 0; let m = 0;
  let _ = if qdsl_and(p < n, char(s,p) == 61) == 1 then (let _ = m = 1 in let _ = p = p + 1 in 0) else 0;
  let _ = if qdsl_and(qdsl_and(m == 1, p < n), char(s,p) == 61) == 1 then (let _ = op = 1 in let _ = ol = 2 in 0) else 0;
  let _ = if qdsl_and(m == 1, op == 0) == 1 then (let _ = op = 1 in let _ = ol = 1 in 0) else 0;
  let _ = if qdsl_and(qdsl_and(op == 0, p < n), char(s,p) == 33) == 1 then (let _ = m = 1 in let _ = p = p + 1 in 0) else 0;
  let _ = if qdsl_and(qdsl_and(m == 1, p < n), char(s,p) == 61) == 1 then (let _ = op = 2 in let _ = ol = 2 in 0) else 0;
  let _ = if qdsl_and(m == 1, op == 0) == 1 then (let _ = p = p - 1 in 0) else 0;
  let _ = if qdsl_and(qdsl_and(op == 0, p < n), char(s,p) == 60) == 1 then (let _ = m = 1 in let _ = p = p + 1 in 0) else 0;
  let _ = if qdsl_and(qdsl_and(m == 1, p < n), char(s,p) == 61) == 1 then (let _ = op = 3 in let _ = ol = 1 in 0) else 0;
  let _ = if qdsl_and(m == 1, op == 0) == 1 then (let _ = op = 5 in let _ = ol = 0 in 0) else 0;
  let _ = if qdsl_and(qdsl_and(op == 0, p < n), char(s,p) == 62) == 1 then (let _ = m = 1 in let _ = p = p + 1 in 0) else 0;
  let _ = if qdsl_and(qdsl_and(m == 1, p < n), char(s,p) == 61) == 1 then (let _ = op = 4 in let _ = ol = 1 in 0) else 0;
  let _ = if qdsl_and(m == 1, op == 0) == 1 then (let _ = op = 6 in let _ = ol = 0 in 0) else 0;
  let _ = if op == 0 then (let _ = p = n in 0) else 0;
  let _ = if op == 0 then 0 else 0;
  let _ = p = p + ol; let p = qdsl_ws(s, p);
  let p_rhs = p;
  let r2 = qdsl_ident(s, p, a, ap, sb, sp);
  let _ = if r2 == 0 then (let _ = p = n in 0) else 0;
  let rt = r2 & 0xffffffff; let _ = p = r2 >> 32;
  let _ = if p == n then (let r2 = qdsl_int(s, p_rhs, a, ap, sb, sp) in let _ = rt = r2 & 0xffffffff in let _ = p = r2 >> 32 in 0) else 0;
  let node = qdsl_alloc(8, 2, op, a, ap);
  let _ = a[node+3] = l; let _ = a[node+4] = rt;
  (p << 32) | node
}

fn qdsl_pred(s: str, p: i64, a: [i64], ap: [i64], sb: [i64], sp: [i64]) -> i64 {
  let p = qdsl_ws(s, p); let n = qdsl_len(s);
  let r = qdsl_cmp(s, p, a, ap, sb, sp);
  let _ = if r == 0 then (let _ = p = n in 0) else 0;
  let _ = if r == 0 then 0 else 0;
  let root = r & 0xffffffff; let _ = p = r >> 32;
  // iterative loop instead of qdsl_pred_rec
  let done = 0; let result = 0;
  while done == 0 {
    let p = qdsl_ws(s, p);
    let _ = if p+3 > n || char(s,p) != 97 || char(s,p+1) != 110 || char(s,p+2) != 100 then
      (let _ = done = 1 in let _ = result = (p << 32) | root in 0) else 0;
    let p2 = p + 3; let p2 = qdsl_ws(s, p2);
    let r2 = qdsl_cmp(s, p2, a, ap, sb, sp);
    let _ = if r2 == 0 then (let _ = done = 1 in let _ = result = (p << 32) | root in 0) else 0;
    let rt = r2 & 0xffffffff; let _ = p2 = r2 >> 32;
    let node = qdsl_alloc(9, 2, 0, a, ap);
    let _ = a[node+3] = root; let _ = a[node+4] = rt;
    let p3 = qdsl_ws(s, p2);
    let _ = root = node; let _ = p = p3;
    0
  };
  result
}

fn qdsl_agg(s: str, p: i64, a: [i64], ap: [i64], sb: [i64], sp: [i64]) -> i64 {
  let p = qdsl_ws(s, p); let n = qdsl_len(s);
  let ak = 0; let kl = 0;
  let _ = if qdsl_and(qdsl_and(p+3 <= n, char(s,p)==115), qdsl_and(char(s,p+1)==117, char(s,p+2)==109)) == 1 then (let _ = ak = 11 in let _ = kl = 3 in 0) else 0;
  let _ = if qdsl_and(qdsl_and(qdsl_and(ak == 0, p+5 <= n), qdsl_and(qdsl_and(char(s,p)==99, char(s,p+1)==111), qdsl_and(char(s,p+2)==117, char(s,p+3)==110))), char(s,p+4)==116) == 1 then (let _ = ak = 12 in let _ = kl = 5 in 0) else 0;
  let _ = if qdsl_and(qdsl_and(ak == 0, p+3 <= n), qdsl_and(qdsl_and(char(s,p)==109, char(s,p+1)==105), char(s,p+2)==110)) == 1 then (let _ = ak = 13 in let _ = kl = 3 in 0) else 0;
  let _ = if qdsl_and(qdsl_and(qdsl_and(ak == 0, p+3 <= n), qdsl_and(char(s,p)==109, char(s,p+1)==97)), char(s,p+2)==120) == 1 then (let _ = ak = 14 in let _ = kl = 3 in 0) else 0;
  let _ = if qdsl_and(qdsl_and(qdsl_and(ak == 0, p+3 <= n), qdsl_and(char(s,p)==97, char(s,p+1)==118)), char(s,p+2)==103) == 1 then (let _ = ak = 15 in let _ = kl = 3 in 0) else 0;
  let _ = if ak == 0 then (let _ = p = n in 0) else 0;
  let _ = if ak == 0 then 0 else 0;
  let _ = p = p + kl; let p = qdsl_ws(s, p);
  let _ = if p >= n then (let _ = p = n in 0) else 0;
  let _ = if qdsl_and(p < n, char(s,p) != 40) == 1 then (let _ = p = n in 0) else 0;
  let _ = p = p + 1; let p = qdsl_ws(s, p);
  let r = qdsl_ident(s, p, a, ap, sb, sp);
  let _ = if r == 0 then (let _ = p = n in 0) else 0;
  let _ = if r == 0 then 0 else 0;
  let col = r & 0xffffffff; let _ = p = r >> 32;
  let p = qdsl_ws(s, p);
  let _ = if p >= n then (let _ = p = n in 0) else 0;
  let _ = if qdsl_and(p < n, char(s,p) != 41) == 1 then (let _ = p = n in 0) else 0;
  let _ = p = p + 1;
  let node = qdsl_alloc(ak, 1, 0, a, ap);
  let _ = a[node+3] = col;
  (p << 32) | node
}

fn qdsl_ckw(s: str, p: i64, n: i64, c0: i64, c1: i64, c2: i64, c3: i64, c4: i64) -> i64 {
  let kl = if c4 == 0 then 4 else 5;
  if p+kl > n then 0
  else if char(s,p) != c0 then 0
  else if char(s,p+1) != c1 then 0
  else if char(s,p+2) != c2 then 0
  else if char(s,p+3) != c3 then 0
  else if c4 == 0 then 1
  else if char(s,p+4) != c4 then 0
  else 1
}

fn qdsl_cc(s: str, p: i64, c0: i64, c1: i64, c2: i64, c3: i64, c4: i64, kl: i64) -> i64 {
  let n = qdsl_len(s);
  if p+kl > n then 0
  else if qdsl_and(kl > 0, char(s,p) != c0) == 1 then 0
  else if qdsl_and(kl > 1, char(s,p+1) != c1) == 1 then 0
  else if qdsl_and(kl > 2, char(s,p+2) != c2) == 1 then 0
  else if qdsl_and(kl > 3, char(s,p+3) != c3) == 1 then 0
  else if qdsl_and(kl > 4, char(s,p+4) != c4) == 1 then 0
  else 1
}

fn qdsl_query(s: str, a: [i64], ap: [i64], sb: [i64], sp: [i64]) -> i64 {
  let n = qdsl_len(s); let p = qdsl_ws(s, 0); let ok = 1;
  let _ = if p >= n then (let _ = ok = 0 in 0) else 0;
  let _ = if qdsl_and(ok == 1, char(s,p) != 113) == 1 then (let _ = ok = 0 in 0) else 0;
  let _ = if ok == 1 then (let _ = p = p + 1 in 0) else 0;
  let p = qdsl_ws(s, p);
  let _ = if p >= n then (let _ = ok = 0 in 0) else 0;
  let _ = if qdsl_and(ok == 1, char(s,p) != 123) == 1 then (let _ = ok = 0 in 0) else 0;
  let _ = if ok == 1 then (let _ = p = p + 1 in 0) else 0;
  let p = qdsl_ws(s, p);
  let _ = if ok == 1 then (let _ = if qdsl_ckw(s, p, n, 102, 114, 111, 109, 0) == 0 then (let _ = ok = 0 in 0) else (let _ = p = p + 4 in 0) in 0) else 0;
  let p = qdsl_ws(s, p);
  let r = qdsl_ident(s, p, a, ap, sb, sp);
  let _ = if r == 0 then (let _ = ok = 0 in 0) else 0;
  let _ = if ok == 0 then 0 else 0;
  let from_node = r & 0xffffffff; let _ = p = r >> 32;
  
  let join_node = 0;
  let _ = if qdsl_and(qdsl_and(qdsl_and(p+4 <= n, char(s,p)==106), char(s,p+1)==111), qdsl_and(qdsl_and(char(s,p+2)==105, char(s,p+3)==110), 1)) == 1 then
    (let p2 = p + 4 in let p2 = qdsl_ws(s, p2) in
     let r2 = qdsl_ident(s, p2, a, ap, sb, sp) in
     let _ = if r2 == 0 then 0 else 0;
     let jt = r2 & 0xffffffff; let _ = p = r2 >> 32;
     let p = qdsl_ws(s, p);
     let _ = if qdsl_and(qdsl_and(p+2 <= n, char(s,p)==111), char(s,p+1)==110) == 1 then
       (let p3 = p + 2 in let p3 = qdsl_ws(s, p3) in
        let r3 = qdsl_ident(s, p3, a, ap, sb, sp) in
        let _ = if r3 == 0 then 0 else 0;
        let jk = r3 & 0xffffffff; let _ = p = r3 >> 32;
        let p = qdsl_ws(s, p);
        let jrk = 0;
        let _ = if qdsl_and(p < n, char(s,p) == 61) == 1 then
          (let p4 = p + 1 in let p4 = qdsl_ws(s, p4) in
           let r4 = qdsl_ident(s, p4, a, ap, sb, sp) in
           let _ = if r4 == 0 then 0 else 0;
           let jrk = r4 & 0xffffffff; let _ = p = r4 >> 32; 0)
        else 0;
        let nc = if jrk == 0 then 2 else 3;
        let jnode = qdsl_alloc(3, nc, 0, a, ap);
        let _ = a[jnode+3] = jt; let _ = a[jnode+4] = jk;
        let _ = if jrk != 0 then (let _ = a[jnode+5] = jrk in 0) else 0;
        let _ = join_node = jnode; 0)
     else 0; 0)
  else 0;
  
  let where_node = 0;
  let p = qdsl_ws(s, p);
  let has_where = if p+5 > n then 0 else qdsl_cc(s, p, 119, 104, 101, 114, 101, 5);
  let _ = if (if ok == 1 then 1 else 0) * (if has_where == 1 then 1 else 0) == 1 then
    (let _ = p = p + 5 in let p = qdsl_ws(s, p) in
     let r = qdsl_pred(s, p, a, ap, sb, sp) in
     let _ = if r == 0 then (let _ = ok = 0 in 0) else 0;
     let _ = if ok == 0 then 0 else 0;
     let where_node = r & 0xffffffff; let _ = p = r >> 32; 0)
  else 0;
  
  let group_node = 0;
  let p = qdsl_ws(s, p);
  let has_group = if p+5 > n then 0 else qdsl_cc(s, p, 103, 114, 111, 117, 112, 5);
  let _ = if (if ok == 1 then 1 else 0) * (if has_group == 1 then 1 else 0) == 1 then
    (let _ = p = p + 5 in let p = qdsl_ws(s, p) in
     let _ = if p+2 > n then (let _ = ok = 0 in 0) else 0;
     let _ = if ok == 1 then (let _ = if qdsl_cc(s, p, 98, 121, 0, 0, 0, 2) == 0 then (let _ = ok = 0 in 0) else 0 in 0) else 0;
     let _ = if ok == 0 then 0 else 0;
     let _ = p = p + 2; let p = qdsl_ws(s, p) in
     let r = qdsl_ident(s, p, a, ap, sb, sp) in
     let _ = if r == 0 then (let _ = ok = 0 in 0) else 0;
     let _ = if ok == 0 then 0 else 0;
     let gk = r & 0xffffffff; let _ = p = r >> 32;
     let p = qdsl_ws(s, p);
     let _ = if qdsl_and(qdsl_and(qdsl_and(p+3 <= n, char(s,p)==97), char(s,p+1)==103), char(s,p+2)==103) == 1 then (let _ = p = p + 3 in 0) else 0;
     let _ = if p >= n then (let _ = ok = 0 in 0) else 0;
     let _ = if ok == 0 then 0 else 0;
     let p = qdsl_ws(s, p);
     let r2 = qdsl_agg(s, p, a, ap, sb, sp);
     let _ = if (r2 & 0xffffffff) == 0 then (let _ = ok = 0 in 0) else 0;
     let _ = if ok == 0 then 0 else 0;
     let agg_node = r2 & 0xffffffff; let _ = p = r2 >> 32;
     let gn = qdsl_alloc(5, 2, 0, a, ap);
     let _ = a[gn+3] = gk; let _ = a[gn+4] = agg_node;
     let _ = group_node = gn; 0)
  else 0;
  
  let order_node = 0;
  let p = qdsl_ws(s, p);
  let has_order = if p+5 > n then 0 else qdsl_cc(s, p, 111, 114, 100, 101, 114, 5);
  let _ = if (if ok == 1 then 1 else 0) * (if has_order == 1 then 1 else 0) == 1 then
    (let _ = p = p + 5 in let p = qdsl_ws(s, p) in
     let _ = if p+2 > n then (let _ = ok = 0 in 0) else 0;
     let _ = if ok == 1 then (let _ = if qdsl_cc(s, p, 98, 121, 0, 0, 0, 2) == 0 then (let _ = ok = 0 in 0) else 0 in 0) else 0;
     let _ = if ok == 0 then 0 else 0;
     let _ = p = p + 2; let p = qdsl_ws(s, p) in
     let r = qdsl_ident(s, p, a, ap, sb, sp) in
     let _ = if r == 0 then (let _ = ok = 0 in 0) else 0;
     let _ = if ok == 0 then 0 else 0;
     let oe = r & 0xffffffff; let _ = p = r >> 32;
     let desc = 0; let p = qdsl_ws(s, p);
     let _ = if qdsl_and(qdsl_and(qdsl_and(qdsl_and(p+4 <= n, char(s,p)==100), char(s,p+1)==101), char(s,p+2)==115), char(s,p+3)==99) == 1 then (let _ = desc = 1 in let _ = p = p + 4 in 0) else 0;
     let _ = if ok == 0 then 0 else 0;
     let on = qdsl_alloc(6, 1, desc, a, ap);
     let _ = a[on+3] = oe; let _ = order_node = on; 0)
  else 0;
  
  let limit_node = 0;
  let p = qdsl_ws(s, p);
  let has_limit = if p+5 > n then 0 else qdsl_cc(s, p, 108, 105, 109, 105, 116, 5);
  let _ = if (if ok == 1 then 1 else 0) * (if has_limit == 1 then 1 else 0) == 1 then
    (let _ = p = p + 5 in let p = qdsl_ws(s, p) in
     let r = qdsl_int(s, p, a, ap, sb, sp) in
     let _ = if (r & 0xffffffff) == 0 then (let _ = ok = 0 in 0) else 0;
     let _ = if ok == 0 then 0 else 0;
     let lv = r & 0xffffffff; let _ = p = r >> 32;
     let ln = qdsl_alloc(7, 0, lv, a, ap);
     let _ = limit_node = ln; 0)
  else 0;
  
  let p = qdsl_ws(s, p);
  let _ = if p >= n then (let _ = ok = 0 in 0) else 0;
  let _ = if qdsl_and(ok == 1, char(s,p) != 125) == 1 then (let _ = ok = 0 in 0) else 0;
  let _ = if ok == 0 then 0 else 0;
  
  let nc = 1 + (if join_node != 0 then 1 else 0) + (if where_node != 0 then 1 else 0) + (if group_node != 0 then 1 else 0) + (if order_node != 0 then 1 else 0) + (if limit_node != 0 then 1 else 0);
  let root = qdsl_alloc(1, nc, 0, a, ap);
  let ci = 0;
  let _ = a[root+3+ci] = from_node; let _ = ci = ci + 1;
  let _ = if join_node != 0 then (let _ = a[root+3+ci] = join_node in let _ = ci = ci + 1 in 0) else 0;
  let _ = if where_node != 0 then (let _ = a[root+3+ci] = where_node in let _ = ci = ci + 1 in 0) else 0;
  let _ = if group_node != 0 then (let _ = a[root+3+ci] = group_node in let _ = ci = ci + 1 in 0) else 0;
  let _ = if order_node != 0 then (let _ = a[root+3+ci] = order_node in let _ = ci = ci + 1 in 0) else 0;
  let _ = if limit_node != 0 then (let _ = a[root+3+ci] = limit_node in let _ = ci = ci + 1 in 0) else 0;
  if ok == 0 then 0 else root
}

fn qdsl_ident_hash(off: i64, h: i64, sb: [i64]) -> i64 {
  let byte = sb[off];
  if byte == 0 then h else qdsl_ident_hash(off + 1, h * 31 + byte, sb)
}

fn qdsl_fingerprint(node: i64, a: [i64], sb: [i64]) -> i64 {
  let kind = a[node]; let nc = a[node+1]; let attr = a[node+2];
  let h = kind * 1000 + attr;
  let h = if kind == 10 then qdsl_ident_hash(attr, h, sb) else h;
  let ci = 0;
  while ci < nc {
    let child = a[node+3+ci];
    let _ = h = h * 31 + qdsl_fingerprint(child, a, sb);
    let _ = ci = ci + 1;
  };
  h
}

fn qdsl_parse(query: str) -> i64 {
  let a = zeros(4096); let ap = zeros(1); let sb = zeros(512); let sp = zeros(1);
  let root = qdsl_query(query, a, ap, sb, sp);
  if root == 0 then 0 else qdsl_fingerprint(root, a, sb)
}

fn main() -> i64 {
  // Test case 1: basic query
  let r1 = qdsl_parse("q { from T }");
  if r1 == 0 then 1 else r1
}
