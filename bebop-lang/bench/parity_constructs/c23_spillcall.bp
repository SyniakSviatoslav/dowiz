// spilled-array-arg guard: 4-arg call with args from spill slots 0 and 4
fn callee4(a1: [i64], a2: [i64], rd: i64, a4: [i64]) -> i64 { a4[rd] + a1[0] + a2[0] }
fn f(s1: i64, s2: i64, s3: i64, s4: i64, s5: i64, s6: i64, s7: i64, s8: i64, n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 { callee4(n, stab, 2, fntab) }
fn main() -> i64 { f(1,2,3,4,5,6,7,8,[5],[6],7,8,[0,0,99,0]) }
