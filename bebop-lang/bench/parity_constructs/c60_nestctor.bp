// nested-ctor allocation order (§3.11): the payload of Node is itself a Node ctor,
// so the outer allocation must not bump x14 before the inner one is fully written.
// EXPECT 1 from: hand: nested constructor
fn main() -> i64 { match Node(Node(Leaf)) { Leaf => 0, Node(x) => 1 } } enum E { Leaf, Node(x) }
