+// ---- D3 kill test (docs/blueprints/D3-locality-relabel-at-compaction.md §5) ----
+// Assign vertex ids in BFS order of the generated graph instead of the generator's LCG
+// order. NO store change: the permutation is applied to the generated pair list BEFORE the
+// CSR is built, so the stored graph is the same graph up to isomorphism and every BFS fold
+// is invariant -- PROVIDED the BFS sources map to themselves, which fix_srcs enforces by
+// transposing at most 8 of the 1M ranks (no measurable locality effect, exact fold effect).
+// bfs_expand(v, prp, pci, pi, q, cnt): enqueue every unranked neighbour of v. prp/pci are
+// csr_passes' layout: row v is pci[1 + prp[1+v] .. 1 + prp[2+v]). cnt[0]=head, cnt[1]=tail.
+fn bfs_expand(v: i64, prp: [i64], pci: [i64], pi: [i64], q: [i64], cnt: [i64]) -> i64 {
+  let k = prp[1 + v];
+  let hi = prp[2 + v];
+  while k < hi {
+    let w = pci[1 + k];
+    let t = cnt[1];
+    let take = if pi[w] < 0 then 1 else 0;
+    let _ = if take == 1 then (let _ = pi[w] = t in 0) else 0;
+    let _ = if take == 1 then (let _ = q[t] = w in 0) else 0;
+    let _ = cnt[1] = t + take;
+    let k = k + 1;
+    0
+  };
+  0
+}
+// bfs_comp(root, ...): rank one connected component in BFS order from root.
+fn bfs_comp(root: i64, prp: [i64], pci: [i64], pi: [i64], q: [i64], cnt: [i64]) -> i64 {
+  let t = cnt[1];
+  let _ = pi[root] = t;
+  let _ = q[t] = root;
+  let _ = cnt[1] = t + 1;
+  while cnt[0] < cnt[1] {
+    let h = cnt[0];
+    let _ = cnt[0] = h + 1;
+    let _ = bfs_expand(q[h], prp, pci, pi, q, cnt);
+    0
+  };
+  0
+}
+// fix_srcs(n, pi, q): force pi to fix the first 8 vertices of the LCG-31337 source stream
+// that phase_bfs/phase_frontier draw from, so source (x>>20)%n denotes the SAME vertex in
+// both arms. q is the rank->vertex inverse of pi; each fixup is one transposition.
+fn fix_srcs(n: i64, pi: [i64], q: [i64]) -> i64 {
+  let x = 31337;
+  let i = 0;
+  while i < 8 {
+    let x = lcg(x);
+    let s = (x >> 20) % n;
+    let r = pi[s];
+    let u = q[s];
+    let _ = q[s] = s;
+    let _ = q[r] = u;
+    let _ = pi[s] = s;
+    let _ = pi[u] = r;
+    let i = i + 1;
+    0
+  };
+  0
+}
+// perm_bfs(n, prp, pci, pi, q): pi[v] = BFS rank of v over the whole graph (components in
+// ascending root order), q[rank] = vertex; then the source fixup.
+fn perm_bfs(n: i64, prp: [i64], pci: [i64], pi: [i64], q: [i64]) -> i64 {
+  let v = 0;
+  while v < n {
+    let _ = pi[v] = 0 - 1;
+    let v = v + 1;
+    0
+  };
+  let cnt = zeros(2);
+  let r = 0;
+  while r < n {
+    let _ = if pi[r] < 0 then bfs_comp(r, prp, pci, pi, q, cnt) else 0;
+    let r = r + 1;
+    0
+  };
+  fix_srcs(n, pi, q)
+}
+fn apply_perm(a: [i64], m: i64, pi: [i64]) -> i64 {
+  let i = 0;
+  while i < m {
