+// loc_row / phase_loc: the D3 locality statistic on the committed L1 CSR -- mean |w - v|
+// over every edge slot and the fraction of slots with |w - v| < 4096 (one 32 KB window of
+// the i64 ci array = 8 pages). Returned packed as mean * 10^6 + ppm_near so one i64 carries
+// both. This is what says whether a relabelling actually MOVED the layout.
+fn loc_row(base: [i64], rp: ref RP, ci: ref CI, v: i64, acc: [i64]) -> i64 {
+  let k = st_get(base, rp, 1 + v);
+  let hi = st_get(base, rp, 2 + v);
+  while k < hi {
+    let w = st_get(base, ci, 1 + k);
+    let d = if w < v then v - w else w - v;
+    let near = if d < 4096 then 1 else 0;
+    let _ = acc[0] = acc[0] + d;
+    let _ = acc[1] = acc[1] + near;
+    let k = k + 1;
+    0
+  };
+  0
+}
