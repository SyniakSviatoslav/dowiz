+// csr_build re-zeroes and re-fills afterwards; pi and the rank->vertex inverse come from two
+// 8 MB anonymous mmaps, NOT from zeros: the seed arena is 256 MB (seed/seed.S) and phase_build
+// already stands at src+dst+cur+prp+pci = 256 MB, so any zeros() here traps 80 (measured).
+fn relabel_apply(src: [i64], dst: [i64], m: i64, n: i64, prp: [i64], pci: [i64]) -> i64 {
+  let pa = sys_mmap(0, 8 * n, 3, 34, 0 - 1, 0);
