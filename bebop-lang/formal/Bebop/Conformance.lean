  ⟨"c71_csel_impure", "// A2 commit 1: then-arm calls g(i) -- must stay on the branch path (WORD_DELTA vs c70)\n// EXPECT -164832 from: hand: impure conditional select\nfn main() -> i64 { let a = 7; let b = 3; let i = 0; let acc = 0; while i < 1000 { let acc = acc + (if i * 7 % 3 == 1 then g(i) else b - i); let i = i + 1; 0 }; acc }\nfn g(x: i64) -> i64 { x + 1 }", (-164832)⟩,
  -- c72_hoist: hoisted computation
  ⟨"c72_hoist", "// A2 commit 2: K8H's loop shape -- two 64-bit LCG constants (>= 65536, hoisted out of the\n// loop entry into free cs registers) and a fold that depends on every iteration (acc/x/i\n// all carried across iterations). The `let bit`/`let acc` after the constants are used\n// (in `let x = ...`) exercises the §8 clobber risk: the hoisted registers must sit above\n// every register the body's own `let`s (x/bit/acc/i, one genuinely new: bit) will bind.\n// EXPECT 5504683299252448320 from: hand: loop hoisting\nfn main() -> i64 {\n  let acc = 0;\n  let x = 1;\n  let i = 1000;\n  while i > 0 {\n    let x = x * 6364136223846793005 + 1442695040888963407;\n    let bit = (x >> 60) & 1;\n    let acc = if bit == 1 then acc + x else acc - i;\n    let i = i - 1;\n    0\n  };\n  acc\n}", 5504683299252448320⟩,
  -- c73_hoistnest: hoisted nested computation
  ⟨"c73_hoistnest", "// A2b (2026-09-08): an outer loop that hoists a >=65536 literal at depth 0 AND nests a\n// `while`. Before A2b, hoist_scan declined the whole body (the outer cs temp stayed live\n// across the inner loop's cs-mask-must-be-0 entry assertion). Now the nested loop releases\n// the enclosing pairs at its entry and re-takes them after its own code, so `m` is hoisted\n// once per outer iteration and read on BOTH sides of the inner loop.\n// EXPECT 24000282 from: hand: hoist with nesting (A2b regression guard)\nfn main() -> i64 {\n  let acc = 0;\n  let rep = 3;\n  while rep > 0 {\n    let m = 1000003;\n    let acc = acc + m;\n    let i = 4;\n    while i > 0 {\n      let acc = acc + i * 7 + 1000003;\n      let i = i - 1;\n      0\n    };\n    let acc = acc + m * 2 + 1000003;\n    let rep = rep - 1;\n    0\n  };\n  acc\n}", 24000282⟩,
  -- c74_madd: multiply-add
  ⟨"c74_madd", "// c74_madd (ROADMAP A2b step 2a guard): the MADD fold in vs_try_madd. Freezes the four\n// shapes that decide whether `a * b + c` may collapse into the multiply's own word:\n//   x  mul then add, addend a permanent symbol register (the fold fires)\n//   y  the operands in the other order, `c + a * b` (fires -- `+` is commutative and the\n//      fold looks at both window entries, not just the top)\n//   z  two multiplies under one `+`, only the LAST of which is still the last word emitted\n//      (fires on that one; the first mul is an ordinary REG operand by then)\n//   w  the multiplicand is itself computed, `a * (b + c) + b` (fires: the inner `+` is\n//      emitted before the mul, so the mul is still the last word when the outer `+` lands)\n// and one shape that must NOT fold: `v * b + 4242` materialises its addend with a movz,\n// which would land AFTER the mul and be read a word before it was written -- the addend's\n// entry is a CONST, not one of vs_reg's is_direct kinds, so the fold declines and\n// vs_binop_reg emits the plain add. All five are folded into one printed value so a\n// regression in any of them moves the number.\n// EXPECT 82837312 from: hand: multiply-add folding (A2b step 2a - from tools/bpref.py)\nfn main() -> i64 {\n  let a = 7;\n  let b = 11;\n  let c = 5;\n  let x = a * b + c;\n  let y = c + a * b;\n  let z = a * b + a * c;\n  let w = a * (b + c) + b;\n  let v = a * b + 4242;\n  x * 1000003 + y * 10007 + z * 101 + w * 7 + v\n}", 82837312⟩,
  -- c75_andimm: AND with immediate
  ⟨"c75_andimm", "// c75_andimm (ROADMAP A2b step 2b guard): the AND-immediate fold in vs_try_and_imm. The fold\n// only accepts a LOW RUN of ones, C = 2^k - 1, which is the whole bitmask-immediate sub-case\n// this tree writes; everything else must still take the old vs_binop_reg path (materialise the\n// mask into a register, then `and` two registers). Both sides are frozen here:\n//   m1  (v >> 60) & 1                       k = 1  -- K8H's own branch bit\n//   m2  v & 255                             k = 8\n//   m3  v & 4294967295                      k = 32, the widest common mask\n//   m4  v & 6                               NOT a low run (110b) -- must fall through\n//   m5  v & 0                               c > 0 fails -- must fall through, and must still\n//                                           be 0, not a mis-encoded imms of -1\n// v is the K8H LCG multiplier, so m1 is a real high-bit test on a real 64-bit constant rather\n// than something the folder could see through.\n// EXPECT 1477639 from: hand: and immediate (A2b step 2b - from tools/bpref.py)\nfn main() -> i64 {\n  let v = 6364136223846793005;\n  let m1 = (v >> 60) & 1;\n  let m2 = v & 255;\n  let m3 = v & 4294967295;\n  let m4 = v & 6;\n  let m5 = v & 0;\n  m1 * 1000003 + m2 * 10007 + m3 % 100003 + m4 * 7 + m5\n}", 1477639⟩,
