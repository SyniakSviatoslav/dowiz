  -- c14_string: string literal operations
  ⟨"c14_string", "// let-in expression + nested lets\n// EXPECT 8 from: hand: string operations\nfn main() -> i64 { let x = 5 in let y = 3 in x + y }", 8⟩,
  -- c15_bitwise: bitwise operators
