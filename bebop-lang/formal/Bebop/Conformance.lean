  -- c68_strval: strings as values (A7 step 1)
  ⟨"c68_strval", "// ROADMAP A7 step 1 (2026-09-09): construct c68_strval -- strings as values.\n// Exercises, under today's raw-pointer strings AND unchanged after the handle\n// migration: a string passed through a call, stored in an array, str_len of a\n// literal, char at both ends, the (off<<32|len) handle-shape integer split and\n// the substr idiom ((off+i)<<32|n) as pure integers, and crc32b of a literal\n// vs the python zlib.crc32 value (\"abc\" -> 891568578, \"\" -> 0).\n// EXPECT from `python3 tools/bpref.py` (the oracle), not assumed.\n// EXPECT 101017189 from: hand: string values (ROADMAP A7 - from tools/bpref.py)\nfn id(s: str) -> str { s }\nfn main() -> i64 {\n  let b = id(\"hello\");\n  let n = str_len(b);\n  let f = char(b, 0);\n  let l = char(b, n - 1);\n  let acc = (n == 5) * 100000000 + (f == 104) * 1000000 + (l == 111) * 10000;\n  let t = [b];\n  let acc = acc + (t[0] == b) * 100;\n  let h = (128 << 32) | 5;\n  let acc = acc + ((h >> 32) == 128) * 10 + ((h & 0xffffffff) == 5);\n  let sub = (((h >> 32) + 1) << 32) | 3;\n  let acc = acc + ((sub >> 32) == 129) * 7000 + ((sub & 0xffffffff) == 3) * 70;\n  let acc = acc + (crc32b(\"abc\") == 891568578) * 7 + (crc32b(\"\") == 0);\n  acc\n}", 101017189⟩,
  -- c69_index_roundtrip: index roundtrip
  ⟨"c69_index_roundtrip", "// c69_index_roundtrip (ROADMAP A5 step 1b, 2026-09-08; REWRITTEN 2026-09-09 for F3\n// commit 2, which makes cell stepping unrepresentable). A `[i64]` VALUE is an\n// x17-relative CELL INDEX and an address exists only inside the instruction that\n// reads or writes. This construct pins that, and it pins it WITHOUT `a + k`.\n// What it still exercises, which is everything the row actually claims:\n//   a[63]  a large literal index -- the sharpest byte/cell unit check there is, since\n//          a base that had regressed to an ADDRESS would read cell 63*8 here\n//   a[0]   the index-0 fast path (no `add`) against the general form below\n//   a[i] / a[j] in two different fns -- the general `add xt,xbase,<idx> ;\n//          ldr/str [x17,xt,lsl #3]` form, and the array VALUE carried across a call\n// What it no longer pins: that `b = a + 3` names the same storage three cells in.\n// That is correct rather than a loss -- after F3 commit 2 stepping is not a property\n// of the language, so a construct must not assert it.\n// THE VALUE IS UNCHANGED, 3969009064380, and that is the point: the same cells are\n// named directly (a[3], a[8]) instead of through a stepped alias (b[0], c[0]), so the\n// evidence A5 landed is preserved exactly rather than weakened.\n// No allocation inside any while body (L8); <= 8 live symbols per fn (exit 89).\n// EXPECT 3969009064380 from: hand: index roundtrip\nfn fill(a: [i64], n: i64) -> i64 {\n  let i = 0;\n  while i < n {\n    let _ = a[i] = i * i;\n    let i = i + 1;\n    0\n  };\n  n\n}\nfn foldc(b: [i64], from: i64, n: i64) -> i64 {\n  let s = 0;\n  let j = from;\n  while j < n {\n    let s = s + b[j];\n    let j = j + 1;\n    0\n  };\n  s\n}\nfn main() -> i64 {\n  let a = zeros(64);\n  let _ = fill(a, 64);\n  let s = foldc(a, 3, 11);\n  a[63] * 1000000000 + a[3] * 1000000 + a[8] * 1000 + s\n}", 3969009064380⟩,
