  -- c53_param9: 9 parameters
  ⟨"c53_param9", "// c53_param9 (DIVERGE-42122, 2026-09-06): a callee with 9+ params stores p8 into its own\n// spill slot 0 -- the prologue's `add x15,sp,#256` must stay even when the BODY never\n// touches x15. Before the fix the callee wrote into the caller's slot 0 (= i2 here):\n// buggy value 5 - 17 = -12, correct 90 - 17 = 73.\n// EXPECT 73 from: hand: 9 parameters\nfn main() -> i64 {\n  let a = 1;\n  let b = 2;\n  let c = 3;\n  let d = 4;\n  let e = 5;\n  let f = 6;\n  let g = 7;\n  let h = 8;\n  let i2 = 90;\n  i2 - f9(a, b, 17, d, e, f, g, h, 5)\n}\nfn f9(p0: i64, p1: i64, p2: i64, p3: i64, p4: i64, p5: i64, p6: i64, p7: i64, p8: i64) -> i64 {\n  p2\n}", 73⟩,
  -- c55_vswindow: virtual space window
  ⟨"c55_vswindow", "// D14 item 3: force the x1-x7 operand window to spill. Eight call arguments,\n// each a live REG tag, are on the value stack at once: the eighth vs_alloc\n// finds fntab[3798] empty and vs_spill_deepest pushes argument 1 to [sp].\n// EXPECT 312 from: hand: value-set window\nfn s8(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {\n  a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8\n}\nfn main() -> i64 {\n  let k = 3;\n  s8(k + 1, k + 2, k + 3, k + 4, k + 5, k + 6, k + 7, k + 8)\n}", 312⟩,
