  ⟨"c34_loopescape", "// T43 negative-safety twin of c33: the loop REBINDS an outer name to a bare\n// array literal (a pointer escapes the iteration), so the scan must refuse the\n// reset; the allocation after the loop must not overwrite k. Expect 4 + 70 = 74.\n// EXPECT 74 from: hand: loop with escape\nfn main() -> i64 {\n  let k = [0, 0];\n  let i = 0;\n  while i < 3 {\n    let k = [i, i * i];\n    let i = i + 1;\n    0\n  };\n  let z = [7, 8];\n  k[1] + z[0] * 10\n}", 74⟩,
