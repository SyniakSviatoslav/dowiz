  -- c40_struct: struct with many fields
  ⟨"c40_struct", "// T43 rest (2026-09-05): struct literals re-enabled with a context guard (the\n// literal name must be the declared struct and we are not inside a while\n// condition); fields are stored in declaration order on the frame heap after all\n// field values are evaluated; `.f` is a fixed-offset load.\n// EXPECT 6420822 from: hand: struct operations\nstruct P { x: i64, y: i64, z: i64 }\nfn mk(a: i64) -> i64 {\n  let p = P { z: a * 3, x: a, y: a * 2 };\n  p.x + p.y * 10 + p.z * 100\n}\nfn main() -> i64 {\n  let q = P { x: 1, y: 2, z: 3 + 5 };\n  let i = 0;\n  let s = 0;\n  while i < q.y {\n    let r = P { x: i, y: 0, z: 0 };\n    let s = s + r.x;\n    let i = i + 1;\n    0\n  };\n  mk(2) * 10000 + q.z * 100 + q.y * 10 + q.x + s\n}", 6420822⟩,
  -- c43_arena_persist: arena persistence across calls
  ⟨"c43_arena_persist", "// T126 2026-09-05: an arena allocation made inside a fn with >= 9 live symbols\n// must survive its return (the prologue used to save/restore x27/x28 for such\n// fns, rolling the arena cursor back; the caller's next zeros() then overwrote\n// the returned array). bpref (no registers) defines the value.\n// EXPECT 16048003 from: hand: arena persistence\nfn big(a: i64, b: i64, c: i64) -> [i64] {\n  let d = a + 1;\n  let e = b + 2;\n  let f = c + 3;\n  let g = d + e;\n  let h = e + f;\n  let i = g + h;\n  let arr = zeros(8);\n  let _ = arr[0] = i;\n  let _ = arr[7] = d * e * f;\n  arr\n}\nfn main() -> i64 {\n  let x = big(1, 2, 3);\n  let y = zeros(8);\n  let _ = y[0] = 999;\n  let _ = y[7] = 999;\n  let z = zeros(8);\n  let _ = z[0] = 555;\n  x[0] * 1000000 + x[7] * 1000 + (if y[0] == 999 then 1 else 0) + (if z[0] == 555 then 2 else 0)\n}", 16048003⟩,
