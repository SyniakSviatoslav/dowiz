  -- c25_matchtail: match with tail position
  ⟨"c25_matchtail", "// match followed by more of the enclosing expression (array element, binop\n// operand): emit_match's arm loop used to run its arm tail at the closing \"}\"\n// and scan into the enclosing expression, swallowing the suffix (T42\n// 2026-09-04, root cause of all 56 CRASH/DIVERGE/TIMEOUT fuzz repros)\n// EXPECT 42 from: hand: match with tail expression\nfn main() -> i64 { let x = [match many(3) { none => 0, many(v) => v }, 5]; x[0] * 10 + x[1] + (match none { none => 7, some => 0 }) } enum opt { none, some, many }", 42⟩,
  -- c26_selfrec: self-recursive function
  ⟨"c26_selfrec", "// multi-argument self-recursion: emit_self_call used to parse exactly ONE\n// argument and strand pos on the first \",\", so every recursive fn with more\n// than one parameter (gcd, ackermann, modular pow) silently returned garbage\n// while 1-arg recursion (c09) was right (T42 2026-09-04)\n// EXPECT 60943 from: hand: self-recursive calculation\nfn gcd(a: i64, b: i64) -> i64 { if b == 0 then a else gcd(b, a % b) }\nfn ack(m: i64, n: i64) -> i64 { if m == 0 then n + 1 else (if n == 0 then ack(m - 1, 1) else ack(m - 1, ack(m, n - 1))) }\nfn powm(b: i64, e: i64, m: i64) -> i64 { if e == 0 then 1 else (b * powm(b, e - 1, m)) % m }\nfn main() -> i64 { gcd(48, 18) * 10000 + ack(2, 3) * 100 + powm(3, 5, 100) }", 60943⟩,
  -- c27_zeroarg: zero-argument function
  ⟨"c27_zeroarg", "// T42(e) zero-arg builtin call as a let RHS: emit_clock_ms used to consume\n// the `()` AND the trailing `;`, eating the first char of the next\n// statement (`let i` -> `et i`: unbound-ident reads, hangs). The clock\n// value is discarded; the gate is the statement sequence after it.\n// EXPECT 7 from: hand: zero-argument call\nfn main() -> i64 { let t0 = clock_ms(); let i = 0; while i < 3 { let i = i + 1; 0 }; 7 }", 7⟩,
