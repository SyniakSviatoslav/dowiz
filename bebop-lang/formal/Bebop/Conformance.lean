  -- c12_match: match expression
  ⟨"c12_match", "// match\n// EXPECT 6 from: hand: pattern match expression\nfn main() -> i64 { match some(5) { none => 0, some(x) => x + 1 } } enum opt { none, some }", 6⟩,
