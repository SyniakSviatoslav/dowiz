  ⟨"c44_use24", "// EXPECT 131 from: hand: 24-bit field operations\nuse \"bench/parity_constructs/mods/big24.bp\"\n// T126 2026-09-05: `use` of a 24-fn module (see mods/big24.bp).\nfn main() -> i64 {\n  m00(1) + m11(2) + m23(3)\n}", 131⟩,
  -- c46_andor: logical and/or
  ⟨"c46_andor", "// T125 2026-09-06: `&&` and `||` pinned: the `&` / `|` tiers on 0/1 comparison values\n// (bebop.bin consumes one `&`, the right operand parses the second), no short circuit.\n// EXPECT 111100 from: hand: logical AND/OR\nfn main() -> i64 {\n  let a = 3;\n  let b = 5;\n  let p = if a < b && b < 9 then 1 else 0;\n  let q = if a > b && b < 9 then 1 else 0;\n  let r = if a > b || b < 9 then 1 else 0;\n  let s = if a > b || b > 9 then 1 else 0;\n  let t = (a < b && b < 9) * 100 + (a > b || b > 9) * 10;\n  p * 100000 + q * 10000 + r * 1000 + s * 100 + t\n}", 111100⟩,
