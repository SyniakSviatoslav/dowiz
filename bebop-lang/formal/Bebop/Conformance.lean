-- The enum/match family (added 2026-09-14, lane l4lean).
--
-- These five are encoded from the REAL bench/parity_constructs/*.bp text
-- (now embedded verbatim in `oracleEntries` above), and they are the
-- constructs that exercise `Expr.matchExpr`. They are here because the match
-- rule had two defects and neither was visible from any sample:
--   * the scaffold read the scrutinee from an unbound env key "_scrutinee",
--     so every match was `none`;
--   * after that was fixed, the arm binder was bound to the arena OFFSET of
--     the payload instead of the payload VALUE, so c12_match evaluated to
--     `ok 1` against EXPECT 6 (measured 2026-09-14, then fixed in
--     Semantics.lean by reading the cell).
-- Each now carries a `#guard`, so `lake build` FAILS if any of them regresses
-- -- which is what the first five samples lacked.
-- ------------------------------------------------------------

/-- c11_enum: `match none { none => 5, some(x) => x + 1 }`, EXPECT 5.
    The nullary-scrutinee path. This one passed even with the payload bug,
    which is exactly why it was not enough on its own. -/
def sample_c11 : Result × Expected :=
  let prog : Program := {
    enums := #[{ name := "opt", ctors := #[{ name := "none", hasPayload := false },
                                           { name := "some", hasPayload := true }] }]
    structs := #[]
    fns := #[
      { name := "main", params := #[], paramTypes := #[], returnType := Ty.i64,
        body := #[
          Stmt.exprStmt (Expr.matchExpr (Expr.enumLit "none" none)
            #[{ ctor := "none", binder := none, body := Expr.lit 5 },
              { ctor := "some", binder := some "x",
                body := Expr.binop BinOp.add (Expr.var "x") (Expr.lit 1) }])
        ] }
    ]
  }
  (runProgram prog, positiveExpectations[10]!)

/-- c12_match: `match some(5) { none => 0, some(x) => x + 1 }`, EXPECT 6.
    The payload-binding path: `ok 1` before the 2026-09-14 fix, `ok 6` after. -/
def sample_c12 : Result × Expected :=
  let prog : Program := {
    enums := #[{ name := "opt", ctors := #[{ name := "none", hasPayload := false },
                                           { name := "some", hasPayload := true }] }]
    structs := #[]
    fns := #[
      { name := "main", params := #[], paramTypes := #[], returnType := Ty.i64,
        body := #[
          Stmt.exprStmt (Expr.matchExpr (Expr.enumLit "some" (some (Expr.lit 5)))
            #[{ ctor := "none", binder := none, body := Expr.lit 0 },
              { ctor := "some", binder := some "x",
                body := Expr.binop BinOp.add (Expr.var "x") (Expr.lit 1) }])
        ] }
    ]
  }
  (runProgram prog, positiveExpectations[11]!)

/-- c22_matchbind: `match some(5) { some(x) => 7 }`, EXPECT 7.
    A single arm, and a body that ignores the binder -- so it is `ok 7` either
    way. Kept because the .bp's own comment says this shape segfaulted the
    compiler before the inline-pop fix. -/
def sample_c22 : Result × Expected :=
  let prog : Program := {
    enums := #[{ name := "opt", ctors := #[{ name := "none", hasPayload := false },
                                           { name := "some", hasPayload := true }] }]
    structs := #[]
    fns := #[
      { name := "main", params := #[], paramTypes := #[], returnType := Ty.i64,
        body := #[
          Stmt.exprStmt (Expr.matchExpr (Expr.enumLit "some" (some (Expr.lit 5)))
            #[{ ctor := "some", binder := some "x", body := Expr.lit 7 }])
        ] }
    ]
  }
  (runProgram prog, positiveExpectations[21]!)

/-- c25_matchtail, EXPECT 42:
      let x = [match many(3) { none => 0, many(v) => v }, 5];
      x[0] * 10 + x[1] + (match none { none => 7, some => 0 })
    A match INSIDE an array literal and a second one as a binop operand -- the
    shape whose compiler bug (emit_match scanning into the enclosing
    expression) was the root cause of all 56 T42 fuzz repros. -/
def sample_c25 : Result × Expected :=
  let prog : Program := {
    enums := #[{ name := "opt", ctors := #[{ name := "none", hasPayload := false },
                                           { name := "some", hasPayload := true },
                                           { name := "many", hasPayload := true }] }]
    structs := #[]
    fns := #[
      { name := "main", params := #[], paramTypes := #[], returnType := Ty.i64,
        body := #[
          Stmt.let_ "x" (Expr.arrLit #[
            Expr.matchExpr (Expr.enumLit "many" (some (Expr.lit 3)))
              #[{ ctor := "none", binder := none, body := Expr.lit 0 },
                { ctor := "many", binder := some "v", body := Expr.var "v" }],
            Expr.lit 5]),
          Stmt.exprStmt (Expr.binop BinOp.add
            (Expr.binop BinOp.add
              (Expr.binop BinOp.mul (Expr.arrGet (Expr.var "x") (Expr.lit 0)) (Expr.lit 10))
              (Expr.arrGet (Expr.var "x") (Expr.lit 1)))
            (Expr.paren (Expr.matchExpr (Expr.enumLit "none" none)
              #[{ ctor := "none", binder := none, body := Expr.lit 7 },
                { ctor := "some", binder := none, body := Expr.lit 0 }])))
        ] }
    ]
  }
  (runProgram prog, positiveExpectations[24]!)

/-- c96_enumpay, EXPECT 8503009: three RUNTIME matches on VARIABLES.
      let a = some(7);  let ra = match a { none => 0, some(x) => x+1, many(y) => y };
      let b = many(500); let rb = match b { none => 0, some(x) => x, many(y) => y+3 };
      let c = none;      let rc = match c { none => 9, some(x) => x, many(y) => y };
      ra * 1000000 + rb * 1000 + rc
    This is the construct the "_scrutinee" hole made impossible: the scrutinee
    is a variable, not a literal constructor, so it has to be EVALUATED. It
    also covers two distinct payload tags and the nullary tag, so the tag
    compare is exercised and not just the payload load. -/
def sample_c96 : Result × Expected :=
  let optE : EnumDecl :=
    { name := "opt", ctors := #[{ name := "none", hasPayload := false },
                                { name := "some", hasPayload := true },
                                { name := "many", hasPayload := true }] }
  let armsOf (noneV someE manyE : Expr) : Array MatchArm :=
    #[{ ctor := "none", binder := none, body := noneV },
      { ctor := "some", binder := some "x", body := someE },
      { ctor := "many", binder := some "y", body := manyE }]
  let prog : Program := {
    enums := #[optE]
    structs := #[]
    fns := #[
      { name := "main", params := #[], paramTypes := #[], returnType := Ty.i64,
        body := #[
          Stmt.let_ "a" (Expr.enumLit "some" (some (Expr.lit 7))),
          Stmt.let_ "ra" (Expr.matchExpr (Expr.var "a")
            (armsOf (Expr.lit 0)
                    (Expr.binop BinOp.add (Expr.var "x") (Expr.lit 1))
                    (Expr.var "y"))),
          Stmt.let_ "b" (Expr.enumLit "many" (some (Expr.lit 500))),
          Stmt.let_ "rb" (Expr.matchExpr (Expr.var "b")
            (armsOf (Expr.lit 0)
                    (Expr.var "x")
                    (Expr.binop BinOp.add (Expr.var "y") (Expr.lit 3)))),
          Stmt.let_ "c" (Expr.enumLit "none" none),
          Stmt.let_ "rc" (Expr.matchExpr (Expr.var "c")
            (armsOf (Expr.lit 9) (Expr.var "x") (Expr.var "y"))),
          Stmt.exprStmt (Expr.binop BinOp.add
            (Expr.binop BinOp.add
              (Expr.binop BinOp.mul (Expr.var "ra") (Expr.lit 1000000))
              (Expr.binop BinOp.mul (Expr.var "rb") (Expr.lit 1000)))
            (Expr.var "rc"))
        ] }
    ]
  }
  (runProgram prog, positiveExpectations[71]!)

