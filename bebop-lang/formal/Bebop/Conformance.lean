  -- c32_asr: arithmetic shift right
  ⟨"c32_asr", "// T42(b) / D9(5) 2026-09-04: `>>>` is the ARITHMETIC shift (asrv), `>>` stays\n// LOGICAL (lsrv). Both on a negative value, plus a positive `>>>` and a\n// precedence check (`>>>` sits in the shift tier with `<<`/`>>`).\n// EXPECT 96138 from: hand: arithmetic shift right\nfn main() -> i64 {\n  let a = 0 - 16;\n  let lg = a >> 2;\n  let ar = a >>> 2;\n  let p = 1024 >>> 3;\n  let t = 1 + 2 >>> 1;\n  ar * 1000 + p + (lg == 4611686018427387900) * 100000 + t * 10\n}", 96138⟩,
  -- c33_loopalloc: allocation in loop
  ⟨"c33_loopalloc", "// T43 (2026-09-04): allocations inside a while body no longer leak the frame\n// heap — x14 is marked before the loop and restored at the back-edge/exit\n// when the body cannot leak a pointer. 100000 iterations x two array\n// literals (48 bytes) used to overflow the 15 KiB frame heap (SIGSEGV).\n// EXPECT 24999750000 from: hand: loop allocation\nfn main() -> i64 {\n  let s = 0;\n  let i = 0;\n  while i < 100000 {\n    let v = [i, i * 2, i * 3];\n    let w = [v[2], 1, 2];\n    let s = s + v[1] + w[0];\n    let i = i + 1;\n    0\n  };\n  s\n}", 24999750000⟩,
