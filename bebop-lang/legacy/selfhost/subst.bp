// selfhost/subst.bp — substitution over an array-encoded AST.
// AST = parallel [i64] arrays: k=kind, v=value, a=left child index, b=right child index.
// Node kinds (qtt_kernel.bp convention): 0=lit (v=integer literal), 5=var (v=name id), 2=add (a,b=child indices).
// subst returns the value of the subtree rooted at i with every var node whose
// name id equals var_id replaced by `replacement`. Substitution happens only at
// the leaves; add nodes recurse into both children and sum their results.

module core { }

fn subst(k:[i64], v:[i64], a:[i64], b:[i64], i:i64, var_id:i64, replacement:i64) -> i64 {
  let kd = k[i];
  let m = if v[i] == var_id then 1 else 0;
  let svar = if kd == 5 then (m * replacement) + ((1 - m) * v[i]) else 0;
  let slit = if kd == 0 then v[i] else 0;
  let sadd = if kd == 2 then subst(k,v,a,b,a[i],var_id,replacement) + subst(k,v,a,b,b[i],var_id,replacement) else 0;
  svar + slit + sadd
}
