// selfhost/registry.bp — flat AST node registry over parallel [i64] arrays.
// Each node occupies one slot (index = node id) across four parallel arrays:
//   kinds[i]    = node kind tag (0=lit 1=var 2=bin 3=if 4=let 5=app 6=lam 7=array)
//   payloads[i] = single-word payload (lit value / var name id / binop op id)
//   c1[i]       = first child node id  (-1 if none)
//   c2[i]       = second child node id (-1 if none)
// count = number of live nodes; arrays must be pre-sized large enough.
// ast.bp's mk_* return only the bare tag; the deferred child graph lands here.

module core { }

// reg_add: append one node (k, p, a, b) at index count, return new count.
fn reg_add(kinds: [i64], payloads: [i64], c1: [i64], c2: [i64], count: i64, k: i64, p: i64, a: i64, b: i64) -> i64 {
  let _ = kinds[count] = k;
  let _ = payloads[count] = p;
  let _ = c1[count] = a;
  let _ = c2[count] = b;
  count + 1
}

// reg_kind: node kind at index idx.
fn reg_kind(kinds: [i64], idx: i64) -> i64 { kinds[idx] }

// reg_payload: node payload at index idx.
fn reg_payload(payloads: [i64], idx: i64) -> i64 { payloads[idx] }

// reg_child1: first child node id at index idx.
fn reg_child1(c1: [i64], idx: i64) -> i64 { c1[idx] }

// reg_child2: second child node id at index idx.
fn reg_child2(c2: [i64], idx: i64) -> i64 { c2[idx] }
