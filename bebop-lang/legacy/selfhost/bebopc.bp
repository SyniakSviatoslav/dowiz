module core { }

// lex_skip: tokenize past whitespace (' '=32, '\t'=9, '\n'=10).
// Advances pos[0] over leading whitespace; returns 0.
fn lex_skip(s: str, pos: [i64]) -> i64 {
  let n = str_len(s);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= n then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_sp = if ch == 32 then 1 else 0;
    let is_tab = if ch == 9 then 1 else 0;
    let is_nl = if ch == 10 then 1 else 0;
    let adv = is_sp + is_tab + is_nl;
    let _ = pos[0] = pos[0] + adv;
    let done = if adv == 1 then 0 else 1;
    0
  };
  0
}

// lex_num: tokenize a run of ASCII digits ('0'=48 .. '9'=57).
// Advances pos[0] over the digits; returns their integer value.
fn lex_num(s: str, pos: [i64]) -> i64 {
  let n = str_len(s);
  let v = 0;
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= n then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let ge48 = if ch >= 48 then 1 else 0;
    let le57 = if ch <= 57 then 1 else 0;
    let is_d = ge48 * le57;
    let v = if is_d == 1 then v * 10 + (ch - 48) else v;
    let _ = pos[0] = pos[0] + is_d;
    let done = if is_d == 1 then 0 else 1;
    0
  };
  v
}

// parse_num: parse an integer OR float literal with optional leading +/- sign
// and surrounding whitespace. A trailing '.' + fractional digits are consumed
// (truncated toward zero, since the movz immediate is an integer).
fn parse_num(s: str, pos: [i64]) -> i64 {
  let _ = lex_skip(s, pos);
  let n = str_len(s);
  let ch = if pos[0] >= n then 0 else char(s, pos[0]);
  let is_plus = if ch == 43 then 1 else 0;
  let is_minus = if ch == 45 then 1 else 0;
  let is_sign = if is_plus == 1 then 1 else is_minus;
  let _ = pos[0] = pos[0] + is_sign;
  let mag = lex_num(s, pos);
  let n2 = str_len(s);
  let chd = if pos[0] >= n2 then 0 else char(s, pos[0]);
  let dot = if chd == 46 then 1 else 0;
  let _ = pos[0] = pos[0] + dot;
  let _ = lex_num(s, pos);
  if is_minus == 1 then (0 - mag) else mag
}

// emit_movz: AArch64 MOVZ X0, #imm16 (LSL #0) — 0xD2800000 | (imm16 << 5).
fn emit_movz(imm: i64) -> i64 { 3531603968 + imm * 32 }

// compile: end-to-end driver — lex -> parse -> emit movz.
fn compile(src: str) -> i64 {
  let pos = [0];
  let v = parse_num(src, pos);
  emit_movz(v)
}

// main: compile a signed float literal to exercise the full pipeline.
fn main() -> i64 { compile("  +42.5") }
