// selfhost/token.bp — token types + tagged-i64 pack/unpack.
// A token is a single i64: the low 5 bits hold the token-type tag (0..18),
// the high bits hold the payload (string index, int value, op code, ...).
// Bebop has no bitwise ops, so packing/unpacking uses * 32 and / 32.
// Payload is assumed non-negative (val * 32 + tag round-trips exactly).

module core { }

// ---- token type tags (low 5 bits) ----
fn tok_eof() -> i64 { 0 }
fn tok_ident() -> i64 { 1 }
fn tok_int() -> i64 { 2 }
fn tok_float() -> i64 { 3 }
fn tok_str() -> i64 { 4 }
fn tok_fn() -> i64 { 5 }
fn tok_let() -> i64 { 6 }
fn tok_if() -> i64 { 7 }
fn tok_then() -> i64 { 8 }
fn tok_else() -> i64 { 9 }
fn tok_while() -> i64 { 10 }
fn tok_op() -> i64 { 11 }
fn tok_lparen() -> i64 { 12 }
fn tok_rparen() -> i64 { 13 }
fn tok_comma() -> i64 { 14 }
fn tok_colon() -> i64 { 15 }
fn tok_arrow() -> i64 { 16 }
fn tok_equals() -> i64 { 17 }
fn tok_brace() -> i64 { 18 }

// ---- pack / unpack ----
fn mk_tok(ty: i64, val: i64) -> i64 { val * 32 + ty }
fn tok_type(t: i64) -> i64 { t - (t / 32) * 32 }
fn tok_val(t: i64) -> i64 { t / 32 }

// ---- predicates ----
fn is_op(t: i64) -> i64 { if tok_type(t) == 11 then 1 else 0 }
fn is_lit(t: i64) -> i64 {
  let ty = tok_type(t);
  if ty == 2 then 1 else (if ty == 3 then 1 else (if ty == 4 then 1 else 0))
}

// round-trip self check: pack a str token with payload 7, unpack the payload.
fn main() -> i64 { tok_val(mk_tok(tok_str(), 7)) }
