// selfhost/conv.bp — structural (definitional) equality of array-encoded AST nodes.
//
// Encoding (parallel arrays k,v,a,b — same as qtt_kernel.bp):
//   k[i]=0  lit   (value in v[i])
//   k[i]=2  add   (children at a[i], b[i])
// conv returns 1 iff node i and node j are structurally equal, else 0.

module core { }

fn conv(k:[i64],v:[i64],a:[i64],b:[i64],i:i64,j:i64)->i64 {
  let ki=k[i];let kj=k[j];let keq=if ki==kj then 1 else 0;
  let veq=if v[i]==v[j] then 1 else 0;
  let lit=if ki==0 then veq else 0;
  let add=if ki==2 then conv(k,v,a,b,a[i],a[j])*conv(k,v,a,b,b[i],b[j]) else 0;
  keq*(lit+add)
}
