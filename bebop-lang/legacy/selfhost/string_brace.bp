// string_brace.bp — regression test for BP_TOK_STR: braces and quotes-adjacent
// punctuation inside string literals must not terminate fn-body parsing.
// Before the fix, the native lexer emitted '{'/'}' inside a literal as real
// PUNCT tokens, so parser.c skip_balanced cut the body at the first '}' in a
// string (parse error / unbalanced braces).

module core { }

fn brace_text() -> str {
  "a{b}c"
}

fn json_ish() -> str {
  "{\"k\": 1}"
}

fn self_check() -> i64 {
  let fail = [0];

  // T1: literal with raw braces keeps its full length
  let t1 = brace_text();
  let l1 = str_len(t1);
  let _ = fail[0] = fail[0] + (if l1 == 5 then 0 else 1);

  // T2: escaped-quote literal parses and keeps its length
  let t2 = json_ish();
  let l2 = str_len(t2);
  let _ = fail[0] = fail[0] + (if l2 == 8 then 0 else 1);

  // T3: char() sees the brace characters
  let c1 = char(t1, 1);
  let c2 = char(t1, 3);
  let _ = fail[0] = fail[0] + (if c1 == 123 then 0 else 1);
  let _ = fail[0] = fail[0] + (if c2 == 125 then 0 else 1);

  // T4: concatenation across literals containing braces
  let t4 = t1 ++ t2;
  let _ = fail[0] = fail[0] + (if str_len(t4) == 13 then 0 else 1);

  fail[0]
}
