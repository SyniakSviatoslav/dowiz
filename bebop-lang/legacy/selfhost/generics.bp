// selfhost/generics.bp — generic instantiation for Bebop self-host compiler
//
// Type variables are encoded as tagged i64 values:
//   A type variable t >= 100000, with its id = t - 100000.
//   For example, type var #0 is encoded as 100000, type var #1 as 100001, etc.
//
// Functions:
//   type_var_id(t)   — returns 1 if t is a type variable (t >= 100000), 0 otherwise.
//   gen_instantiate  — if `type_var` is a type variable, substitute it with `arg`;
//                      otherwise return `type_var` unchanged.

module core { }

// type_var_id: is t a type variable? (t >= 100000)
fn type_var_id(t: i64) -> i64 {
  if t >= 100000 then 1 else 0
}

// gen_instantiate: substitute a type variable with its argument.
// If type_var is a type variable (>= 100000), return arg.
// Otherwise return type_var unchanged.
fn gen_instantiate(type_var: i64, arg: i64) -> i64 {
  if type_var >= 100000 then arg else type_var
}