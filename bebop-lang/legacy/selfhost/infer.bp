// selfhost/infer.bp — type inference rules (tagged i64 type codes)
// type codes: 0=i64, 1=f64, 2=bool, 3=str, 4=unit, -1=error
module core { }

fn is_num(t: i64) -> i64 {
  let a = if t == 0 then 1 else 0;
  let b = if t == 1 then 1 else 0;
  a + b
}

// add: i64+i64=i64, f64+f64=f64, mixed->f64, else error
fn infer_add(lt: i64, rt: i64) -> i64 {
  let ln = is_num(lt);
  let rn = is_num(rt);
  let pos = if (lt + rt) > 0 then 1 else 0;
  if ln + rn == 2 then pos else (0 - 1)
}

// cmp: bool if both numeric, else error
fn infer_cmp(lt: i64, rt: i64) -> i64 {
  let ln = is_num(lt);
  let rn = is_num(rt);
  if ln + rn == 2 then 2 else 0 - 1
}

// if: unify then/else branch types
fn infer_if(ct: i64, tt: i64, et: i64) -> i64 {
  if tt == et then tt else 0 - 1
}
