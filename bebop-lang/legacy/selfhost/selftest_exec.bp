  while q[0] < cnt[0] {
    let _ = compile_fn_at(s, fpos[q[0]], starts[q[0]], fntab, insns, n);
    let _ = q[0] = q[0] + 1;
    0
  };
  sum_words(insns, n[0])
}

// Convenience wrapper: compile a whole program to a fresh buffer and return the
