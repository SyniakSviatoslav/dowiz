// selfhost/type_eq.bp — type equality over tagged i64 type codes.
//
// Type tags: 0=i64 1=f64 2=bool 3=str 4=unit 5=arrow 6=array.
// Arrow types are packed as 1000*dom + cod (dom/cod are themselves type
// codes), matching the PI packing convention in dependent.bp.

module core { }

// type_eq: 1 if a == b, else 0.
fn type_eq(a: i64, b: i64) -> i64 {
  if a == b then 1 else 0
}

// type_neq: 1 if a != b, else 0.
fn type_neq(a: i64, b: i64) -> i64 {
  if a == b then 0 else 1
}

// arrow_dom: domain type code of a packed arrow (1000*dom + cod).
fn arrow_dom(t: i64) -> i64 {
  t / 1000
}

// arrow_cod: codomain type code of a packed arrow (1000*dom + cod).
// No % in Bebop, so cod = t - (t / 1000) * 1000.
fn arrow_cod(t: i64) -> i64 {
  t - (t / 1000) * 1000
}
