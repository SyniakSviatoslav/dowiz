module core { }

// selfhost/reduce.bp — weak-head-normal-form (whnf) reducer over parallel arrays.
// Node layout (parallel [i64] arrays, index = node id):
//   k[i] = kind tag   (0 = lit, 2 = add; operands deferred to a/b)
//   v[i] = payload    (lit value / op id)
//   a[i] = first child node id
//   b[i] = second child node id

// reduce: weak-head reduce. A lit is already in whnf -> v[i]. An add node is
// reduced by first reducing both children to whnf, then adding.
fn reduce(k:[i64],v:[i64],a:[i64],b:[i64],i:i64)->i64 {
  let tag = k[i];
  let lit = if tag == 0 then v[i] else 0;
  let add = if tag == 2 then reduce(k,v,a,b,a[i]) + reduce(k,v,a,b,b[i]) else 0;
  lit + add
}

// beta_step: apply a builtin fn id to arg via a simple lookup table.
//   fn_id 0 -> id   (arg)
//   fn_id 1 -> inc  (arg + 1)
//   fn_id 2 -> dbl  (arg * 2)
//   fn_id 3 -> sqr  (arg * arg)
fn beta_step(fn_id:i64, arg:i64)->i64 {
  let r = arg;
  let r = if fn_id == 1 then arg + 1 else r;
  let r = if fn_id == 2 then arg * 2 else r;
  let r = if fn_id == 3 then arg * arg else r;
  r
}
