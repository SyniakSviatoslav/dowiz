// sys_close(fd): raw close.
fn emit_sys_close(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 1);
  em(insns, n, 3531605800);
  em(insns, n, 3556769793);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_exit(code): raw exit_group — noreturn, nothing pushed.
fn emit_sys_exit(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 1);
  // 2026-09-12: this word was 3531606952 = 0xd2800ba8 = `movz x8,#93`, and syscall 93 is
  // EXIT -- it ends the calling THREAD only -- while the comment above has always claimed
  // exit_group. Inside a CLONE_THREAD child (flags 68864) that meant st_alloc_p's
  // sys_exit(80) killed just the thread, its done flag was never set, and the parent waited
  // for ever: a dead thread indistinguishable from a slow one, the costliest failure shape
  // in this project's record. 3531606984 = 0xd2800bc8 = `movz x8,#94` = exit_group, derived
  // by as+objdump per law L1 and never from memory. emit_sys_exit_thread_guard keeps #93
  // deliberately -- that one IS meant to end only its own thread.
  let _ = em(insns, n, 3531606984);
  let _ = em(insns, n, 3556769793);
  // BUGFIX (2026-09-06, bug 9 hunt, exit-107): sys_exit(...) is a NORETURN
  // builtin (raw svc, never returns to the caller) so it used to push
  // nothing -- harmless historically since the code path following it is
  // unreachable, but it desyncs the window's entry count whenever
  // sys_exit(...) is used AS AN EXPRESSION (e.g. the else-branch of
  // `if cond then 0 else sys_exit(64)`, main.bp's own argc guard): the
  // enclosing if-expression's machinery expects exactly one value on top
  // of the window after compiling either branch. Push a dummy result
  // (x0, matching every real call's convention) so the bookkeeping stays
  // consistent even though this value can never actually be read.
  vs_push(insns, n, fntab, stab, 2, 0, 0 - 1)
}

// clock_ms(): CLOCK_MONOTONIC via raw svc; ms = sec*1000 + nsec/1000000.
// timespec parked at x28-8208 (below the 8 KiB IO scratch zone).
fn emit_clock_ms(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  // R3.x(e) FIX: the zero-arg builtin consumed `()` AND the trailing ';' -
  // the extra skip ate the first char of the NEXT statement (`let i` became
  // `et i` -> unbound-ident reads, hangs/segfaults). Only the parens belong
  // to the builtin; the ';' is the statement layer's.
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 0);
  em(insns, n, 3531866625);
  em(insns, n, 3405841281);
  em(insns, n, 3531604000);
  em(insns, n, 3531607592);
  em(insns, n, 3556769793);
  em(insns, n, 4181721124);
  em(insns, n, 4181722149);
  em(insns, n, 3531635974);
  em(insns, n, 2600893572);
  em(insns, n, 3531739655);
  em(insns, n, 4070572519);
  em(insns, n, 2596735141);
  em(insns, n, 2332360832);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

