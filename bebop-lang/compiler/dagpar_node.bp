// bebop-lang/compiler/dagpar_node.bp -- part of the self-hosting compiler, NOT a standalone program.
// R7 (W-R7, 2026-10-11): the WORKER half of the parallel emit (compiler/dagpar.bp has the design note,
// the parent and the error funnel): the LPT node order, one node = one miss compiled into the worker's
// own state, and the link that copies a worker-compiled fn into source order as a memo hit is copied.

// dp_order(ws): fn indices by span bucket (bit length of the source bytes) from the largest bucket
// down, source order inside a bucket. 24 buckets cover a 16 MiB span.
fn dp_order(ws: [i64]) -> [i64] {
  let cnt = ws[0];
  let fpos = wsa(ws, 2);
  let o = zeros(cnt + 1);
  let at = 0;
  let k = 23;
  while k >= 0 {
    let at = dp_order_bucket(fpos, cnt, ws[20], o, at, k);
    let k = k - 1;
    0
  };
  o
}
fn dp_order_bucket(fpos: [i64], cnt: i64, strn: i64, o: [i64], at0: i64, k: i64) -> i64 {
  let at = at0;
  let q = 0;
  while q < cnt {
    let b = dp_bits(dp_span(fpos, q, cnt, strn));
    let _ = if b == k then (let _ = o[at] = q in 0) else 0;
    let at = at + (if b == k then 1 else 0);
    let q = q + 1;
    0
  };
  at
}
fn dp_bits(v: i64) -> i64 {
  let b = 0;
  let x = v;
  while x > 1 {
    let x = x / 2;
    let b = b + 1;
    0
  };
  if b > 23 then 23 else b
}

// dp_say_workers: `dp: worker <w> nodes <k> deferred <d> words <n> arena_left <cells>` per worker.
fn dp_say_workers(c: [i64], W: i64) -> i64 {
  let row = sch_h(c[16]);
  let b = zeros(256);
  let w = 0;
  while w < W {
    let wn = sch_h(if row[w * 8 + 2] == 0 then sch_a(b) else row[w * 8 + 2]);
    let a = sch_put(b, sch_lit(b, 0, "dp: worker "), w);
    let a = sch_put(b, sch_lit(b, a, " nodes "), row[w * 8 + 4]);
    let a = sch_put(b, sch_lit(b, a, " deferred "), row[w * 8 + 5]);
    let a = sch_put(b, sch_lit(b, a, " words "), wn[0]);
    let a = sch_put(b, sch_lit(b, a, " arena_left "), row[w * 8 + 3]);
    let _ = b[a] = 10;
    let _ = sys_write(2, b, a + 1);
    let w = w + 1;
    0
  };
  0
}

// ---- a worker: one node = one miss compiled into this worker's own state ----
fn dp_node(ctx: i64, k: i64) -> i64 {
  let c = sch_h(ctx);
  let ord = sch_h(c[20]);
  let q = ord[k];
  let hit = sch_h(c[7]);
  let skip = if c[6] != 0 then 1 else (if hit[q] > 0 then 1 else 0);
  if skip == 1 then 0 else dp_node_go(c, q)
}
fn dp_node_go(c: [i64], q: i64) -> i64 {
  let t = dp_tls(c);
  if t < 0 then dp_retire(c, q) else dp_compile(c, sch_h(t), q)
}
// dp_tls(c): this worker's TLS block, built on its first node (its first allocation, so it sits at
// the clone arena's base where dp_tls_here looks); -1 when that allocation did not land there.
fn dp_tls(c: [i64]) -> i64 {
  let t = dp_tls_here();
  if t >= 0 then t else dp_tls_init(c)
}
fn dp_tls_init(c: [i64]) -> i64 {
  let x = sys_arena_end();
  let b = zeros(16);
  let t = sch_a(b);
  if t == x - 1048576 then dp_tls_fill(c, b, t, x) else 0 - 1
}
// The worker's FIXED state does not touch its clone arena (8 MiB, all of it for the compile's own
// allocations -- measured 2026-10-11: with the buffers in the arena 93 of 716 fns ran out of room and
// fell back to the link): it lives in the unused 4 MiB between the stack top sp and the arena, zero
// from the mapping. g = sp: words dp_wcap()+8 | fntab 8192 | relocations 65536 pairs | tkb 1088 | n 4
// = 205,902 cells of 524,288.
fn dp_tls_fill(c: [i64], b: [i64], t: i64, x: i64) -> i64 {
  let w = (x - c[4]) / dp_pitch() - 1;
  let g = c[4] + w * dp_pitch() + 524288;
  let mf = sch_h(c[2]);
  let wf = sch_h(g + dp_wcap() + 8);
  let k = 0;
  while k < 8192 {
    let _ = wf[k] = mf[k];
    let k = k + 1;
    0
  };
  let rbo = g + dp_wcap() + 8 + 8192;
  let _ = wf[7111] = rbo;
  let _ = wf[7112] = 0;
  let _ = wf[7113] = 65536;
  let wn = sch_h(rbo + 65536 * 2 + 2 + 1088);
  let _ = wn[0] = 0;
  let _ = wn[1] = dp_wcap();
  let _ = wn[2] = 0;
  let row = sch_h(c[16]);
  let _ = row[w * 8] = g;
  let _ = row[w * 8 + 1] = sch_a(wf);
  let _ = row[w * 8 + 2] = sch_a(wn);
  let _ = b[3] = sch_a(c);
  let _ = b[4] = w;
  let _ = b[5] = rbo + 65536 * 2 + 2;
  let _ = b[1] = t;
  let _ = b[2] = x;
  let _ = b[0] = dp_magic();
  t
}
fn dp_defer(c: [i64], q: i64) -> i64 {
  let _ = sys_atomic_add(c, 18, 1);
  0
}
// dp_retire: a worker with no room left (or no TLS) defers fn q to the link and LEAVES the level, with
// the level exit and loop exit sch_worker would have counted. Measured 2026-10-11 at W=2: a full
// worker that kept claiming deferred 229 fns in a burst -- each claim is instant once it is full, so
// it starved the worker that still had room and the link compiled a third of the program serially.
fn dp_retire(c: [i64], q: i64) -> i64 {
  let _ = dp_defer(c, q);
  let e = sch_h(c[3]);
  let _ = sch_exit_level(e);
  let _ = sys_atomic_add(e, 12, 1);
  let _ = sys_futex_wake(e, 12, 1);
  sys_exit_thread_guard(1, 0)
}
// dp_room: the fn fits this worker -- dp_guard() cells of arena plus 16 per source byte (measured max
// 9.1 cells/byte over fns > 500 bytes, 25029 cells absolute), and its span in the buffer (an upper
// bound on its words: measured max 0.40 words/byte, 0.115 on average).
fn dp_room(c: [i64], n: [i64], q: i64) -> i64 {
  let ws = sch_h(c[1]);
  let sp = dp_span(wsa(ws, 2), q, ws[0], ws[20]);
  let ar = (if sys_arena_end() - sys_arena_base() >= dp_guard() + sp * 16 then 1 else 0);
  ar * (if n[0] + sp + 64 < n[1] then 1 else 0)
}
// row[w*8 + 3] arena cells left after its last node, + 4 nodes compiled, + 5 nodes it deferred.
fn dp_compile(c: [i64], b: [i64], q: i64) -> i64 {
  let w = b[4];
  let row = sch_h(c[16]);
  let wn = sch_h(row[w * 8 + 2]);
  let ok = dp_room(c, wn, q);
  let _ = row[w * 8 + 3] = sys_arena_end() - sys_arena_base();
  let _ = row[w * 8 + 4 + 1 - ok] = row[w * 8 + 4 + 1 - ok] + 1;
  if ok == 1 then dp_compile_go(c, b, q, row, wn) else dp_retire(c, q)
}
fn dp_compile_go(c: [i64], b: [i64], q: i64, row: [i64], wn: [i64]) -> i64 {
  let w = b[4];
  let wf = sch_h(row[w * 8 + 1]);
  let st = wn[0];
  let _ = wf[5552] = 0;
  let _ = wf[7114] = 0;
  let _ = wf[5266] = 0;
  let rlo = wf[7112];
  let _ = e1_compile(dp_i_str(c[0]), sch_h(c[1]), q, wf, sch_h(row[w * 8]), wn, sch_h(b[5]));
  let _ = dp_put(c, 9, q, st);
  let _ = dp_put(c, 10, q, wn[0] - st);
  let _ = dp_put(c, 11, q, rlo);
  let _ = dp_put(c, 12, q, wf[7112]);
  let _ = dp_put(c, 13, q, wf[5552]);
  let _ = dp_put(c, 14, q, wf[3670]);
  let _ = dp_put(c, 15, q, wf[7114]);
  let _ = dp_put(c, 17, q, wf[5266]);
  let _ = dp_put(c, 8, q, w);
  1
}
fn dp_put(c: [i64], k: i64, q: i64, v: i64) -> i64 {
  let a = sch_h(c[k]);
  let _ = a[q] = v;
  0
}
fn dp_get(c: [i64], k: i64, q: i64) -> i64 {
  let a = sch_h(c[k]);
  a[q]
}

// ---- the link (parent, dag_emit's loop): fn q compiled by worker wid[q], copied as a memo hit is ----
fn dp_wid(pre: i64, q: i64) -> i64 { if pre == 0 then 0 - 1 else dp_get(sch_h(pre), 8, q) }
fn dp_link_fn(pre: i64, q: i64, fntab: [i64], insns: [i64], n: [i64]) -> i64 {
  let c = sch_h(pre);
  let w = dp_get(c, 8, q);
  let row = sch_h(c[16]);
  let wi = sch_h(row[w * 8]);
  let wf = sch_h(row[w * 8 + 1]);
  let st = n[0];
  let nw = dp_get(c, 10, q);
  let w0 = dp_get(c, 9, q);
  let _ = if st + nw > n[1] then cap_exit(n) else 0;
  let k = 0;
  while k < nw {
    let _ = insns[st + k] = wi[w0 + k];
    let k = k + 1;
    0
  };
  let _ = n[0] = st + nw;
  let _ = dp_link_relocs(c, q, fntab, sch_h(wf[7111]), st - w0);
  let e89 = dp_get(c, 17, q);
  let _ = if fntab[5266] == 0 then (let _ = fntab[5266] = e89 in 0) else 0;
  let _ = fntab[3670] = dp_get(c, 14, q);
  let _ = fntab[7114] = dp_get(c, 15, q);
  let _ = fntab[5552] = fntab[5552] + dp_get(c, 13, q);
  0
}
fn dp_link_relocs(c: [i64], q: i64, fntab: [i64], rb: [i64], d: i64) -> i64 {
  let r = dp_get(c, 11, q);
  let hi = dp_get(c, 12, q);
  while r < hi {
    let kt = rb[r * 2 + 1];
    let lit = if (kt >> 56) == 3 then fntab[5552] else 0;
    let _ = dag_rel(fntab, rb[r * 2] + d, kt >> 56, (kt & 72057594037927935) + lit);
    let r = r + 1;
    0
  };
  0
}
