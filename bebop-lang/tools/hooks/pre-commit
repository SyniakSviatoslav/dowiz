#!/usr/bin/env bash
# pre-commit: two independent guards, both of which exist because the thing they
# guard has already drifted once.
#
# Enable once per clone: git config core.hooksPath bebop-lang/tools/hooks
#
# GUARD 1 (2026-09-12): refuse a commit that stages an UNCHAINED compiler.
#   Written after a `git add -A` swept a lane's in-flight bebop.bp edit into an
#   unrelated commit. arch_check's artifact-identity check caught it -- loudly and
#   correctly -- but only when it was run AFTER the commit. A safeguard that depends
#   on someone remembering to run it is prose. This is the same check at the one
#   moment it cannot be skipped.
#   bebop.bp is the self-hosting compiler: a staged change to it that has not been
#   chained to a fixpoint and promoted means bebop.bin is no longer compile(bebop.bp),
#   and every gate from then on measures a compiler nobody built.
#   Bypass deliberately with `git commit --no-verify` -- and say so in the message.
#
# GUARD 2 (D12-D, 2026-09-06): TASKS.md is GENERATED from HISTORY.md headers;
#   regenerate and stage it so the ledger can never drift from the headers (it did on
#   T90/T77/T101-T108 before this hook).

# --- Guard 1a: unchained compiler -------------------------------------------------
# 2026-09-29 split: the compiler source is bebop.bp AND bebop-lang/compiler/*.bp (its `use`
# includes, tools/bp_src.py); a staged change to ANY of them is a compiler change.
staged=$(git diff --cached --name-only)
# DG4 (2026-09-30): the compiler also reads the preludes it `use`s (selfhost/prelude/dagc.bp ->
# store.bp, sha256.bp): tools/bp_src.py --deps lists every one; a staged change to any is a compiler change.
cdeps=$(cd bebop-lang && python3 tools/bp_src.py --deps | sed 's|^|bebop-lang/|; s|\.|\\.|g' | paste -sd'|')
if printf '%s\n' "$staged" | grep -qE "^(bebop-lang/(bebop\.bp|compiler/[^/]+\.bp)|${cdeps:-bebop-lang/bebop\.bp})$"; then
  # A SOURCE-ONLY change that leaves the binary identical (a split, a comment) is accepted when a
  # staged MANIFEST row records THIS source (md5 of tools/bp_src.py --cat) against THIS bebop.bin,
  # written by `tools/bebopc.sh save` after compile(source) == bebop.bin was proven. No --no-verify.
  same_bin=0
  if printf '%s\n' "$staged" | grep -q '^bebop-lang/compilers/MANIFEST\.tsv$'; then
    bin8=$(md5sum bebop-lang/bebop.bin | cut -c1-8)
    src8=$(cd bebop-lang && python3 tools/bp_src.py --cat | md5sum | cut -c1-8)
    git show :bebop-lang/compilers/MANIFEST.tsv | awk -F'\t' -v b="$bin8" -v s="$src8" '$1==b && $3==s && $5=="yes" {f=1} END {exit !f}' && same_bin=1
  fi
  if [ "$same_bin" = 0 ] && ! printf '%s\n' "$staged" | grep -q '^bebop-lang/bebop\.bin$'; then
    echo "pre-commit REFUSED: compiler source ($(printf '%s\n' "$staged" | grep -E '^bebop-lang/(bebop\.bp|compiler/[^/]+\.bp)$' | tr '\n' ' ')) is staged but bebop.bin is not."
    echo "  A compiler source change that is not accompanied by a re-promoted binary"
    echo "  leaves bebop.bin != compile(bebop.bp). Chain it to a fixpoint (gen3 == gen4)"
    echo "  and promote, or commit with --no-verify and say in the message that the"
    echo "  compiler is deliberately left unpromoted."
    exit 1
  fi
fi

# --- Guard 1b: the promoted digest must have a manifest row -----------------------
# The first draft of this guard only checked that compilers/MANIFEST.tsv EXISTS. An
# enforcement that points at a file rather than at a fact is the law_manifest failure mode
# one layer down (AGENTS L25): it would have passed every commit that ever drifted. This
# checks the DIGEST -- the one thing that identifies a compiler -- and it resolves the
# manifest from the repo root, where the hook actually runs, not from bebop-lang/.
if printf '%s\n' "$staged" | grep -q '^bebop-lang/bebop\.bin$'; then
  MAN=bebop-lang/compilers/MANIFEST.tsv
  if [ ! -f "$MAN" ]; then
    echo "pre-commit REFUSED: bebop.bin is staged but $MAN does not exist."
    echo "  Every promoted compiler needs a row naming its source commit and whether its"
    echo "  fixpoint was MEASURED. Create it with: bebop-lang/tools/bebopc.sh save <note>"
    exit 1
  fi
  # The digest of the STAGED bytes, not of the working tree -- they can differ.
  d=$(git show :bebop-lang/bebop.bin | md5sum | cut -c1-8)
  if ! grep -v '^#' "$MAN" | cut -f1 | grep -qx "$d"; then
    echo "pre-commit REFUSED: bebop.bin being committed is $d, which has no row in $MAN."
    echo "  Add one with: bebop-lang/tools/bebopc.sh save <why this binary was promoted>"
    echo "  A promoted compiler with no recorded provenance is how 08cd9e46 shipped against"
    echo "  a source that produced 2822d7b5 (see the 08cd9e46 row)."
    exit 1
  fi
fi

# --- Guard 2: TASKS.md regenerated from HISTORY.md headers -----------------------
printf '%s\n' "$staged" | grep -q '^bebop-lang/HISTORY\.md$' || exit 0
cd "$(git rev-parse --show-toplevel)/bebop-lang" || exit 0
python3 tools/split_roadmap.py --from HISTORY.md > /dev/null \
  && git add TASKS.md \
  && echo "pre-commit: TASKS.md regenerated from HISTORY.md headers"
