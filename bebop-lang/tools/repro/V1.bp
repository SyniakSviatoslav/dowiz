// V1.bp — L2 regression for is_alpha/is_digit on char from zeros vs str
// Catches: TERM_ARRAY_SET void vs i64 in if branches (hq0/qws) and
// is_alpha/is_digit on char from array vs string.
//
// The bug: `if adv0==1 then hq0[0]=... else 0` where hq0[0]=... is void (array set)
// vs 0 is i64 → type mismatch. Also is_alpha(char(s,0)) where s is [i64] vs str.
// Both must be caught by `bebopc check` (strict) and by fuzz parity.

fn is_digit(c: i64) -> i64 {
  let ge48 = if c >= 48 then 1 else 0;
  let le57 = if c <= 57 then 1 else 0;
  ge48 * le57
}
fn is_alpha(c: i64) -> i64 {
  let ge97 = if c >= 97 then 1 else 0;
  let le122 = if c <= 122 then 1 else 0;
  ge97 * le122
}
fn main() -> i64 {
  // is_alpha/is_digit on char from str (via sys_slurp would be str, but here we test the pure logic)
  // The L2 bug was is_alpha(char(s,0)) where s is [i64] vs str — char expects str, is_alpha expects i64.
  // Here we test is_alpha/is_digit directly on i64 literals and on array-set-in-if void vs i64.
  let c0 = 102; // 'f'
  let c1 = 110; // 'n'
  let a0 = is_alpha(c0);
  let a1 = is_alpha(c1);
  let d0 = is_digit(48); // '0'
  let d1 = is_digit(97); // 'a' -> 0
  // Array-set-in-if must be `let _ = ... in 0` not bare `hq0[0]=...` (void vs i64)
  let hq0 = [0];
  let adv0 = 1;
  let _ = if adv0 == 1 then (let _ = hq0[0] = hq0[0] * 131 + 102 in 0) else 0;
  let wq0 = [0];
  let _ = wq0[0] = 5;
  a0 + a1*2 + d0*4 + d1*8 + hq0[0]
}
