// T84: sum.bp (ASCII) and sum_glyph.bp (glyphs) are ONE program in two spellings;
// both compile to a byte-identical binary. Glyphs are canonical, ASCII is the projection.
fn main() -> i64 {
  let arr = zeros(5);
  let _ = arr[0] = 1;
  let _ = arr[1] = 2;
  let _ = arr[2] = 3;
  let _ = arr[3] = 4;
  let _ = arr[4] = 5;
  let sum = 0;
  let i = 0;
  while i < 5 {
    let sum = sum + arr[i];
    let i = i + 1;
    0
  };
  sum
}
