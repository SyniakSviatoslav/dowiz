// bits.bp: Bitwise and shift operators
// Tests: & | ^ << >> >>>
// Compute: (0x0F & 0x33) | 0x80 ^ (1 << 2)
// 0x0F = 0000 1111, 0x33 = 0011 0011
// 0x0F & 0x33 = 0000 0011 = 3
// 3 | 0x80 = 1000 0011 = 131
// 1 << 2 = 4
// 131 ^ 4 = 1000 0011 ^ 0000 0100 = 1000 0111 = 135
fn main() -> i64 {
  let x = 0x0F & 0x33;
  let y = x | 0x80;
  let z = y ^ (1 << 2);
  z
}
