// T84: hello.bp (ASCII) and hello_glyph.bp (glyphs) are ONE program in two spellings;
// both compile to a byte-identical binary. Glyphs are canonical, ASCII is the projection.
fn main() -> i64 {
  let buf = zeros(16);
  let n = str_len("Hello, world!");
  let i = 0;
  while i < n {
    let _ = buf[i] = char("Hello, world!", i);
    let i = i + 1;
    0
  };
  let _ = buf[n] = 10;
  let _ = sys_write(1, buf, n + 1);
  0
}
