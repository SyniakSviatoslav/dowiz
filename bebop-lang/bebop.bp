// D14/register-model exit-89 rewrite: this was 30 `let is_XX = ...;`
// bindings ahead of a 34-way else-if dispatch. Under the register model the
// whole else-if chain is ONE tail expression, so its ~30 nested join
// registers (d1..d30, one per level, all alive until the innermost arm
// resolves) spill to temp slots once the 8 window/cs registers run out --
// and the 30 extra symbol bindings pushed S (spilled-symbol count) up
// enough that S + tsp tripped the 64-slot overflow trap (§5) durin the
// self-compile. Fix: compare `name` INLINE in each condition instead of
// pre-binding a symbol per case -- same dispatch, vc back down near the
// param count, S small again (the nesting depth itself, and its tsp cost,
// is unchanged and still within budget once S shrinks).
fn emit_call_or_ctor(s: str, name: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let tag = ft_ctor_tag(fntab, name);
  let tgt = fntab_lookup(fntab, name);
  if name == 30895064082 then emit_hvham(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 4047253394792 then emit_hvham2(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 76753189874778913 then emit_sys_mmap(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 585902212871437 then emit_sys_run(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 10054667876514197585 then emit_sys_wait4(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 7442662398273192292 then emit_sys_rename(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 12598865016055593546 then emit_sys_ftruncate(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 7442661902340062434 then emit_sys_export(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 7442662210087947144 then emit_sys_munmap(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 7040940390938053523 then emit_sys_arena_base(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 12163823898702034029 then emit_sys_arena_end(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 10054667870649030395 then emit_sys_clone(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 16710314075682296179 then emit_sys_cond_set(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 15293169932641766580 then emit_sys_futex_wait_guard(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 8779068393901189725 then emit_sys_futex_wake(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 1084841420853388659 then emit_sys_exit_thread_guard(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 7221016679989100487 then emit_sys_atomic_add(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 7304771531850188344 then emit_sys_setaffinity(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 1713209 then emit_clz(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 260242221 then emit_sys_scan(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 29413480223 then emit_crc32(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 3853165909311 then emit_crc32b(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == -8392076200099613766 then emit_sys_msync(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == -8392076202161113213 then emit_sys_fsync(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == -1729804160290675916 then emit_sys_mprotect(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 3853165909333 then emit_crc32x(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 10054667875361132632 then emit_sys_slurp(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 585709020818199 then emit_str_len_fn(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 224358574 then emit_char_fn(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 15758082337069564947 then emit_sys_readbuf(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 76753189879327100 then emit_sys_open(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 76753189885882068 then emit_sys_read(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 76753189874574932 then emit_sys_mapb(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 10054667876552415181 then emit_sys_write(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 10054667870649031050 then emit_sys_close(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 76753189856984008 then emit_sys_exit(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 66094333908796503 then emit_clock_ms(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == 36158018563 then emit_zeros(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if tag >= 0 then emit_enum_ctor(s, tag, pos, insns, n, stab, selfname, selfstart, fntab)
  else if name == selfname then emit_self_call(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if tgt >= 0 then emit_bl_call(s, name, pos, insns, n, stab, selfname, selfstart, fntab)
  else emit_call(s, name, pos, insns, n, stab, selfname, selfstart, fntab)
}

// Dispatch a bare name: nullary enum ctor or a variable reference.
fn emit_var_or_ctor(s: str, name: i64, npos: i64, insns: [i64], n: [i64], stab: [i64], fntab: [i64]) -> i64 {
  let tag = ft_ctor_tag(fntab, name);
  let is_ctor = if tag >= 0 then 1 else 0;
  let vreg = if is_ctor == 1 then 0 else sym_lookup(s, stab, name, npos);
  let _ = if vreg < 0 then diag_exit(s, npos, 101) else 0;
  if is_ctor == 1 then emit_enum_ctor_nullary(insns, n, tag, fntab, stab)
  else emit_var(insns, n, vreg, fntab, stab)
}

fn emit_match_payload(s: str, ppos: i64, vname: i64, vpos: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = ppos;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let reg = sym_bind(s, stab, vname, vpos);
  let _ = check_reg_collision(s, insns, n, fntab, stab, reg, vpos);
  vs_bind(insns, n, fntab, stab, reg)
}

// Emit a matching match-arm: bind the payload var (if any) then emit the arm body.
fn emit_match_arm(s: str, ppos: i64, has_var: i64, vname: i64, vpos: i64, bodypos: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let saved = pos[0];
  let _ = if has_var == 1 then emit_match_payload(s, ppos, vname, vpos, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
  let _ = pos[0] = bodypos;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = pos[0] = saved;
  n[0]
}

// Compile-time match on a literal enum scrutinee: match ctor(payload) { arm, ... }.
// The arm loop stops at the closing brace and consumes ONLY it (T42 2026-09-04:
// it used to run the arm tail at "}" and scan into the enclosing expression).
fn emit_match(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 5;
  let _ = skip_ws(s, pos);
  let cpos = pos[0];
  let cname = read_ident(s, pos);
  // A6 step 1 (2026-09-09): the scrutinee is a CTOR NAME (compile-time arm
  // selection, unchanged) or anything else, which is a bound variable holding
  // a ctor block -- the runtime path below.
  let ctag = ft_ctor_tag(fntab, cname);
  if ctag >= 0 then emit_match_lit(s, cname, pos, insns, n, stab, selfname, selfstart, fntab)
  else emit_match_var(s, cpos, cname, pos, insns, n, stab, selfname, selfstart, fntab)
}

fn emit_match_lit(s: str, cname: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let strn = slen(s, pos);
  let _ = skip_ws(s, pos);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  let is_lp = if ch == 40 then 1 else 0;
  let ppos = [0];
  let _ = if is_lp == 1 then (let _ = pos[0] = pos[0] + 1 in (let _ = ppos[0] = pos[0] in (let _ = skip_args(s, pos) in (let _ = pos[0] = pos[0] + 1 in 0)))) else 0;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch0 = if at_end == 1 then 0 else char(s, pos[0]);
    let is_rb = if ch0 == 125 then 1 else 0;
    let stop = if is_rb + at_end >= 1 then 1 else 0;
    let aname = read_ident(s, pos);
    let _ = skip_ws(s, pos);
    let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_lp2 = if ch2 == 40 then 1 else 0;
    let vpos = if is_lp2 == 1 then (let _ = pos[0] = pos[0] + 1 in pos[0]) else 0;
    let vname = if is_lp2 == 1 then read_ident(s, pos) else 0;
    let _ = if is_lp2 == 1 then (let _ = skip_ws(s, pos) in (let _ = pos[0] = pos[0] + 1 in 0)) else 0;
    let _ = skip_ws(s, pos);
    let adv = if stop == 1 then is_rb else 2;
    let _ = pos[0] = pos[0] + adv;
    let bodypos = pos[0];
    let _ = if stop == 0 then skip_to_field_delim(s, pos) else 0;
    let is_match = if aname == cname then 1 else 0;
    let has_var = is_lp * is_lp2;
    let _ = if is_match == 1 then emit_match_arm(s, ppos[0], has_var, vname, vpos, bodypos, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let ch3 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch3 == 44 then 1 - stop else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let done = stop;
    0
  };
  n[0]
}

// Restore the whole register-model state an if/match arm may have changed, so
// the next arm compiles from byte-identical bookkeeping (emit_cond_branch does
// this inline for its two arms; a match has N).
fn vs_restore(fntab: [i64], sw: i64, smask: i64, scs: i64, sslot: i64) -> i64 {
  let _ = fntab[5387] = sw;
  let _ = fntab[5388] = smask;
  let _ = fntab[5389] = scs;
  let _ = fntab[5390] = sslot;
  0
}

// Patch an already-emitted unconditional `b` placeholder at word p to `target`
// (imm26, forward). p < 0 = nothing to patch.
fn patch_b(insns: [i64], p: i64, target: i64) -> i64 {
  let _ = if p >= 0 then (let _ = insns[p] = 335544320 + (target - p) in 0) else 0;
  0
}

// RUNTIME match (A6 step 1, 2026-09-09) -- the second half of the ctor defect.
// `match v { a => .., b(x) => .. }` where v is a bound variable was emitting
// NOTHING at all (emit_match compared each arm name against the scrutinee TEXT,
// so no arm ever matched a variable) and the match evaluated to whatever was
// left in the result register -- the 8209 that remained after the two ctor
// stores were fixed. The block is [tag, payload] at the x17-relative CELL INDEX
// the variable holds, so the tag is read with the A5 step-1b index form
// (`ldr xtg,[x17,xsc,lsl #3]`, idx 0) and the payload with
// `add xp,xsc,#1 ; ldr xp,[x17,xp,lsl #3]` -- NOT an address dereference.
// sc (block index), tg (tag) and d (join) are held as free-mask reservations
// and NOT as window entries: an arm that parked a window entry would emit the
// park inside its own conditionally-executed code, which is exactly the
// arm-spanning fault emit_cond_branch's fntab[5402] guard exists for. Every arm
// compiles from the SAME saved window/cs/slot state and converges on d.
fn emit_match_var(s: str, cpos: i64, cname: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let vreg = sym_lookup(s, stab, cname, cpos);
  let _ = if vreg < 0 then diag_exit(s, cpos, 101) else 0;
  let _ = emit_var(insns, n, vreg, fntab, stab);
  // fntab[5403]: arms can bind, so surviving values go to temp SLOTS, not cs
  // registers (same rule emit_cond applies to a branch-shaped `if`).
  let _ = fntab[5403] = 1;
  let _ = vs_park(insns, n, fntab, stab, 1);
  let _ = vs_span_to_slots(insns, n, fntab, stab, 1);
  let _ = fntab[5403] = 0;
  let sc = vs_alloc(insns, n, fntab, stab);
  let _ = vs_to(insns, n, fntab, stab, sc);
  let _ = vs_pop(fntab);
  let _ = vs_mask_take(fntab, sc, 16);
  let tg = vs_alloc(insns, n, fntab, stab);
  let _ = vs_array_get_imm(insns, n, sc, 0, tg);
  let d = vs_alloc(insns, n, fntab, stab);
  let _ = emit_match_rt(s, pos, insns, n, stab, selfname, selfstart, fntab, sc, tg, d);
  let _ = vs_mask_free(fntab, sc, 16);
  let _ = vs_mask_free(fntab, tg, 16);
  let _ = vs_mask_free(fntab, d, 16);
  let _ = vs_push(insns, n, fntab, stab, 2, d, 0 - 1);
  n[0]
}

// One runtime arm: bind the payload (if the arm names one), compile the body
// from `bodypos` and converge it on the join register d.
fn emit_match_rt_arm(s: str, pos: [i64], bodypos: i64, vname: i64, vpos: i64, insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], sc: i64, d: i64) -> i64 {
  let saved = pos[0];
  let saved_arm = fntab[5402];
  let _ = fntab[5402] = fntab[5387];
  let _ = if vname != 0 then emit_match_rt_bind(s, vname, vpos, insns, n, stab, fntab, sc) else 0;
  let _ = pos[0] = bodypos;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = vs_to(insns, n, fntab, stab, d);
  let _ = vs_pop(fntab);
  let _ = fntab[5402] = saved_arm;
  let _ = pos[0] = saved;
  n[0]
}

// Bind an arm's payload variable: cell sc+1 of the block, through the index
// form, then the ordinary symbol bind every `let` uses.
fn emit_match_rt_bind(s: str, vname: i64, vpos: i64, insns: [i64], n: [i64], stab: [i64], fntab: [i64], sc: i64) -> i64 {
  let p = vs_alloc(insns, n, fntab, stab);
  let _ = vs_array_get_imm(insns, n, sc, 1, p);
  let _ = vs_push(insns, n, fntab, stab, 2, p, n[0] - 1);
  let reg = sym_bind(s, stab, vname, vpos);
  let _ = check_reg_collision(s, insns, n, fntab, stab, reg, vpos);
  vs_bind(insns, n, fntab, stab, reg)
}

// The arm chain: `cmp xtg,#tag ; b.ne <next arm>` per arm, the arm body, then a
// `b` to the join. The exit branches are CHAINED (arm i jumps to arm i+1's own
// exit branch, the last one to the join) so no per-match fixup list is needed --
// only the previous arm's word index is carried across the loop.
fn emit_match_rt(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], sc: i64, tg: i64, d: i64) -> i64 {
  let strn = slen(s, pos);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let sw = fntab[5387];
  let smask = fntab[5388];
  let scs = fntab[5389];
  let sslot = fntab[5390];
  let prevb = 0 - 1;
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch0 = if at_end == 1 then 0 else char(s, pos[0]);
    let is_rb = if ch0 == 125 then 1 else 0;
    let stop = if is_rb + at_end >= 1 then 1 else 0;
    let aname = read_ident(s, pos);
    let _ = skip_ws(s, pos);
    let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_lp2 = if ch2 == 40 then 1 else 0;
    let vpos = if is_lp2 == 1 then (let _ = pos[0] = pos[0] + 1 in pos[0]) else 0;
    let vname = if is_lp2 == 1 then read_ident(s, pos) else 0;
    let _ = if is_lp2 == 1 then (let _ = skip_ws(s, pos) in (let _ = pos[0] = pos[0] + 1 in 0)) else 0;
    let _ = skip_ws(s, pos);
    let adv = if stop == 1 then is_rb else 2;
    let _ = pos[0] = pos[0] + adv;
    let bodypos = pos[0];
    let _ = if stop == 0 then skip_to_field_delim(s, pos) else 0;
    let atag = if stop == 0 then ft_ctor_tag(fntab, aname) else 0;
    let _ = if atag < 0 then diag_exit(s, bodypos, 101) else 0;
    let _ = if stop == 0 then vs_restore(fntab, sw, smask, scs, sslot) else 0;
    let _ = if stop == 0 then em(insns, n, 4043309087 + atag * 1024 + tg * 32) else 0;
    let pne = n[0];
    let _ = if stop == 0 then em(insns, n, 1409286145) else 0;
    let _ = if stop == 0 then emit_match_rt_arm(s, pos, bodypos, vname, vpos, insns, n, stab, selfname, selfstart, fntab, sc, d) else 0;
    let q = n[0];
    let _ = if stop == 0 then em(insns, n, 335544320) else 0;
    let _ = if stop == 0 then patch_b(insns, prevb, q) else 0;
    let _ = if stop == 0 then (let _ = insns[pne] = insns[pne] + (n[0] - pne) * 32 in 0) else 0;
    let prevb = if stop == 0 then q else prevb;
    let ch3 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch3 == 44 then 1 - stop else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let done = stop;
    0
  };
  let _ = patch_b(insns, prevb, n[0]);
  let _ = vs_restore(fntab, sw, smask, scs, sslot);
  n[0]
}


// Skip a "//" line comment: advance pos to the newline (or end). pos is at '/'.
// PERF (2026-09-08): skip_line_comment/skip_string called str_len -- a byte-at-a-time
// NUL scan of the WHOLE source -- once per call. The four whole-source scans call them
// ~1,643 times each over a 337 KB self-source, i.e. 555 MB of NUL-scanning per scan to
// skip 337 KB of text. The `_n` twins take strn from the caller (the discipline
// docs/WORKER-CARD.md already states for text scanners); the bare names stay as wrappers
// so the two dozen cold call sites are untouched.
fn skip_line_comment_n(s: str, pos: [i64], strn: i64) -> i64 {
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_nl = if ch == 10 then 1 else 0;
    let adv = 1 - is_nl - at_end;
    let _ = pos[0] = pos[0] + adv;
    let done = if is_nl + at_end >= 1 then 1 else 0;
    0
  };
  0
}
fn skip_line_comment(s: str, pos: [i64]) -> i64 { skip_line_comment_n(s, pos, str_len(s)) }

// Skip a "..." string literal: pos is at the opening '"', leave it after the
// closing '"'.
fn skip_string_n(s: str, pos: [i64], strn: i64) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_q = if ch == 34 then 1 else 0;
    let adv = 1 - is_q - at_end;
    let _ = pos[0] = pos[0] + adv;
    let done = if is_q + at_end >= 1 then 1 else 0;
    0
  };
  let _ = pos[0] = pos[0] + 1;
  0
}
fn skip_string(s: str, pos: [i64]) -> i64 { skip_string_n(s, pos, str_len(s)) }

fn skip_ws(s: str, pos: [i64]) -> i64 {
  let n = slen(s, pos);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= n then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_sp = if ch == 32 then 1 else 0;
    let is_tab = if ch == 9 then 1 else 0;
    let is_nl = if ch == 10 then 1 else 0;
    let is_cr = if ch == 13 then 1 else 0;
    let is_ws = is_sp + is_tab + is_nl + is_cr;
    let _ = pos[0] = pos[0] + is_ws;
    let at_end2 = if pos[0] >= n then 1 else 0;
    let e1 = if pos[0] + 1 >= n then 1 else 0;
    let ch0 = if at_end2 == 1 then 0 else char(s, pos[0]);
    let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
    let is_sl = if ch0 == 47 then 1 else 0;
    let is_sl2 = if ch1 == 47 then 1 else 0;
    let is_comment = is_sl * is_sl2;
    let _ = if is_comment == 1 then skip_line_comment(s, pos) else 0;
    let done = if is_ws + is_comment >= 1 then 0 else 1;
    0
  };
  0
}

// Append one instruction word and advance the count.
// The stream counter is [n, cap]: em traps 83 BEFORE the write that would cross cap
// (planning tmp 65536 words per fn, program buffers 262144; roadmap 1b, 2026-09-06).
fn cap_exit(n: [i64]) -> i64 {
  let buf = zeros(64);
  let a1 = diag_str(buf, 0, "code buffer exhausted at ");
  let a2 = put_num(buf, a1, n[1]);
  let _ = buf[a2] = 32;
  let a3 = diag_str(buf, a2 + 1, "words (one fn or the program)");
  let _ = buf[a3] = 10;
  let _ = sys_write(2, buf, a3 + 1);
  sys_exit(83)
}
// ROADMAP F2 prerequisite (2026-09-09): THE EXIT-CODE SPACE IS PARTITIONED.
// Before this, vs_mask_take/vs_mask_free/vs_cs_take/vs_cs_free exited with
// `99 + site` / `100 + site` / `119 + site` / `120 + site` for a caller-chosen
// site in 1..20, so the compiler could emit ANY code in 99..140 -- a span that
// contains every documented compile-time diagnostic. Two codes were live
// ALIASES (102 = the kernel-fn diagnostic AND a window-mask self-check; 104 =
// "too many fns" AND a cs-mask self-check) and 103/105/106/107 were emitted and
// documented nowhere, against a table whose first line says a code not in it is
// a bug. The partition is now: USER-FACING DIAGNOSTICS BELOW 99 (plus the
// grandfathered 99..104 the gates and docs already pin), COMPILER SELF-CHECKS AT
// 201 -- one code, with the site printed on stderr, the same trade cap_exit and
// diag_exit already make. The site is not lost, it moves from the exit code
// (where it collided with real diagnostics) to the message (where it is free).
// kind: 1 window-mask register out of range   2 window mask corrupt past bit 7
//       3 cs-mask register out of range       4 cs mask corrupt past bit 7
//       5 window free-mask not fully released at a boundary
//       6 cs mask not released at a boundary
//       7 cs mask non-zero at a statement boundary (was diag_exit 103)
//       8 window not empty where it must be (was diag_exit 107)
// Kinds 7 and 8 give up diag_exit's line:col for the kind.site pair: for an
// invariant that can only be a bug in THIS compiler, the failing check names the
// bug better than the user source position that tripped over it.
fn selfcheck_exit(kind: i64, site: i64) -> i64 {
  let buf = zeros(64);
  let a1 = diag_str(buf, 0, "0:0: error[E201]: compiler self-check ");
  let a2 = put_num(buf, a1, kind);
  let _ = buf[a2] = 46;
  let a3 = put_num(buf, a2 + 1, site);
  let _ = buf[a3] = 10;
  let _ = sys_write(2, buf, a3 + 1);
  sys_exit(201)
}
// The source slurp cap, as ONE definition rather than a literal at four call sites.
// sys_slurp(fd, N) reads at most N bytes and NUL-terminates at nread, so a file
// LARGER than N is silently truncated and the compiler then parses a program that
// ends mid-expression. Measured 2026-09-13: bench/vs_rust/std_tests/gb_pool.bp
// concatenated onto a main-stripped bebop.bp reached 401529 bytes against this
// 400000 cap, the .use expansion ended inside `let P = pool_ref_i64(`, and the only
// symptom was `12247:25: error[E97]: fn body without a tail expression` at a line
// number PAST THE END of an 8253-line file. That is a capacity failing quietly and
// then lying about where, which is the L1 violation this trap closes.
// RAISED 2026-09-14, 400000 -> 1200000. The old "moves the child arena pitch" reason was
// WRONG: [sp+4 MiB, sp+12 MiB) is a CLONE CHILD's arena (emit_sys_clone), but every
// src_slurp_cap() slurp is CLI-side (cli_compile/check/cas, use_scan) in the seed's MAIN
// arena -- measured 33546736 cells free at entry, one slurp costs exactly N cells. Bound
// by use_expand's zeros(1600000); at 1200000 up to 24 includes fit (deepest real: 7).
fn src_slurp_cap() -> i64 { 1200000 }

fn cli_exit(code: i64, m: str) -> i64 {
  let buf = zeros(256);
  let a1 = diag_str(buf, 0, "0:0: error[E");
  let a2 = put_num(buf, a1, code);
  let a3 = diag_str(buf, a2, "]: ");
  let a4 = diag_str(buf, a3, m);
  let _ = buf[a4] = 10;
  let _ = sys_write(2, buf, a4 + 1);
  sys_exit(code)
}

fn em(insns: [i64], n: [i64], w: i64) -> i64 {
  let _ = if n[0] >= n[1] then cap_exit(n) else 0;
  let _ = insns[n[0]] = w;
  let _ = n[0] = n[0] + 1;
  n[0]
}

// ---- register model (REGISTER-MODEL-BLUEPRINT, 2026-09-06): the stack
// machine is gone. Every expression value lives in a register (the
// compile-time "window" x0..x7) or, when it cannot, in a callee-saved
// register or an x15 frame slot chosen at compile time -- never [sp].
// fntab[5387] w (0..512, window entry count) ; fntab[5388] free mask x0..x7
// (bit set = free) ; fntab[3700+3i..2802+3i] kind/payload0/payload1 of
// window entry i (0 = deepest .. w-1 = top; 512-entry LIST (A2 step 0
// relayout, moved from 2000+3i), decoupled from the 8-register mask above --
// only REG/MULC-window/FLAGS kinds actually consume a register bit) ;
// fntab[5389] cs mask (bit
// r-19 set = cs temp r LIVE) ; fntab[5390] temp slot cursor k ;
// fntab[5391] cs_hi (highest cs register index used, r-18, 0 = none, max
// over the fn) ; fntab[5392] tsp (max temp slots used, max over the fn) ;
// fntab[5393] S (emission-pass spilled-symbol count for slot addresses;
// planning pass 0). kinds: 1 CONST c  2 REG r,p  3 SYM r,-  4 CS r,-
// 5 SLOT k,-  6 MULC r,c  7 FLAGS cond,-. `p` on a REG entry is the index
// of the word that produced it when that word's rd field IS r and can be
// safely retargeted (movz, mov, ldr, any arithmetic result -- every
// integer instruction reads its sources by number; only movk depends on
// the OLD value of its own rd, so it never carries a valid p, encoded -1).
// ---- register model primitives (probe copy) ----
// Risk 4 (REGISTER-MODEL-BLUEPRINT §1.1/§7): a `let` binding whose new
// register (19+cnt) is currently owned by a LIVE cs temp (a call result
// parked across an earlier part of the same expression) would silently
// alias the temp's value -- exit 89 instead (bind the call result with a
// let first). Call after every sym_bind that creates a NEW binding.
// BUGFIX (2026-09-06, REGISTER-MODEL-BLUEPRINT §1.1): a `let` binding a
// NAME to a permanent symbol register used to trap (exit 89) whenever a
// LIVE cs temp already occupied that register -- correct in the stack
// machine (registers were never reused mid-expression) but a real false
// positive under the register model, where a call's result routinely
// lives in a cs temp (vs_park_to_cs) right up until the next `let`
// claims the same register number. Relocate the temp out of the way
// instead: move it to the lowest free cs register above the (now
// current) permanent range, or park it to a slot if none is free, then
// bind as normal. Both compile passes make this decision from the same
// published facts (S = stab[0], the cs mask), so the word count stays
// identical between planning and emission.
fn check_reg_collision(s: str, insns: [i64], n: [i64], fntab: [i64], stab: [i64], reg: i64, srcpos: i64) -> i64 {
  let is_reg = (if reg >= 19 then 1 else 0) * (if reg < 27 then 1 else 0);
  let bit = if is_reg == 1 then (fntab[5389] >> (reg - 19)) & 1 else 0;
  let w = if bit == 1 then fntab[5387] else 0;
  let i = 0;
  let idx = 0 - 1;
  while i < w {
    let k = vs_entry_kind(fntab, i);
    let p0 = vs_entry_p0(fntab, i);
    let hit = (if k == 4 then 1 else 0) * (if p0 == reg then 1 else 0) * (if idx < 0 then 1 else 0);
    let idx = if hit == 1 then i else idx;
    let i = i + 1;
    0
  };
  // BUGFIX (A4 fuzz DIVERGE hunt, 2026-09-07): relocating `idx` here emits
  // the move as part of whichever if-ARM is currently compiling -- fine
  // when `idx` was born inside this SAME arm (arm-local, dies with it), but
  // when idx predates the arm (idx < fntab[5402], the arm's own base --
  // i.e. this value must remain valid on BOTH arms and after the join) the
  // relocation mov only executes on THIS arm's runtime path, leaving the
  // other path (and the shared post-if code) reading a location nothing
  // ever wrote there. Same restriction as the call-temp case below (exit
  // 89, "let binding while a call temp is live") -- a `let` bound inside an
  // if-arm must not collide with a value that survives the whole `if`;
  // bind the surviving value with its own `let` first. Repro:
  // `v0 += (if c then (let t=4 in t*..) else ..)` with v0's op= snapshot
  // relocated by t's own bind.
  let arm_spanning = (if fntab[5402] >= 0 then 1 else 0) * (if idx >= 0 then (if idx < fntab[5402] then 1 else 0) else 0);
  let _ = if arm_spanning == 1 then diag_exit(s, srcpos, 89) else 0;
  let do_reloc = (if idx >= 0 then 1 else 0) * (1 - arm_spanning);
  let _ = if do_reloc == 1 then (let cfi = cs_free_idx(fntab[5389], stab[0]) in (let _ = if cfi < 8 then vs_park_to_cs(insns, n, fntab, idx, reg, cfi) else vs_park_to_slot(insns, n, fntab, idx, reg) in vs_cs_free(fntab, reg, 11))) else 0;
  // unreachable now that a real collision is always relocated (or trapped
  // 89) above -- kept as an assert: bit==1 with no owning window entry
  // found is an actual invariant violation elsewhere, not this fn's job.
  let _ = if (bit == 1) * (if idx < 0 then 1 else 0) == 1 then diag_exit(s, srcpos, 89) else 0;
  0
}

fn vs_reset(fntab: [i64]) -> i64 {
  let _ = fntab[5387] = 0;
  let _ = fntab[5388] = 255;
  let _ = fntab[5389] = 0;
  let _ = fntab[5390] = 0;
  let _ = fntab[5391] = 0;
  let _ = fntab[5392] = 0;
  // A4 fuzz DIVERGE hunt (2026-09-07): -1 = "not inside an if-arm"; see
  // emit_cond_branch / check_reg_collision.
  let _ = fntab[5402] = 0 - 1;
  // ROADMAP A14 (2026-09-07): 1 = "parks made right now must be path-independent"
  // (set only around emit_cond's pre-`if` park); see vs_park_move.
  let _ = fntab[5403] = 0;
  // A2 commit 2: hoist pairs are per-loop scratch, but ptab is REUSED across
  // functions on the planning pass (bebop.bp compile_fn's outer loop) -- a
  // stale pair from a previous fn's compile must never leak into the next.
  let _ = fntab[5394] = 0;
  let _ = fntab[5395] = 0;
  let _ = fntab[5396] = 0;
  let _ = fntab[5397] = 0;
  let _ = fntab[5398] = 0;
  let _ = fntab[5399] = 0;
  let _ = fntab[5400] = 0;
  let _ = fntab[5401] = 0;
  0
}

fn emit_half(insns: [i64], n: [i64], imm: i64, hw: i64, d: i64) -> i64 {
  let p = [1, 65536, 4294967296, 281474976710656, 18446744073709551616];
  let hi = imm / p[hw + 1];
  let lo = imm - hi * p[hw + 1];
  let lo2 = if lo < 0 then lo + p[hw + 1] else lo;
  let slraw = lo2 / p[hw];
  let hi3 = imm / p[3];
  let r3 = imm - hi3 * p[3];
  let adj3 = if r3 == 0 then 0 else 1;
  let sl3 = if imm < 0 then hi3 + 65536 - adj3 else hi3;
  let ishw3 = if hw == 3 then 1 else 0;
  let sl = ishw3 * sl3 + (1 - ishw3) * slraw;
  let _ = if sl > 0 then em(insns, n, 4068474880 + sl * 32 + hw * 2097152 + d) else 0;
  n[0]
}

fn mat_const(insns: [i64], n: [i64], imm: i64, d: i64) -> i64 {
  let imm16 = imm - (imm / 65536) * 65536;
  let imm16u = if imm16 < 0 then imm16 + 65536 else imm16;
  let _ = em(insns, n, 3531603968 + imm16u * 32 + d);
  let after_movz = n[0];
  let _ = emit_half(insns, n, imm, 1, d);
  let _ = emit_half(insns, n, imm, 2, d);
  let _ = emit_half(insns, n, imm, 3, d);
  if n[0] > after_movz then 0 - 1 else after_movz - 1
}

fn lsb_idx(mask: i64) -> i64 {
  let lsb = mask & (0 - mask);
  63 - clz(lsb)
}

fn vs_entry_kind(fntab: [i64], i: i64) -> i64 { fntab[3700 + 3 * i] }
fn vs_entry_p0(fntab: [i64], i: i64) -> i64 { fntab[3701 + 3 * i] }
fn vs_entry_p1(fntab: [i64], i: i64) -> i64 { fntab[3702 + 3 * i] }
fn vs_set_entry(fntab: [i64], i: i64, kind: i64, p0: i64, p1: i64) -> i64 {
  let _ = fntab[3700 + 3 * i] = kind;
  let _ = fntab[3701 + 3 * i] = p0;
  let _ = fntab[3702 + 3 * i] = p1;
  0
}

// Single choke point for every window-mask (fntab[5388], bits 0-7 = x0-x7)
// and cs-mask (fntab[5389], bits 0-7 = x19-x26) bit flip, per the
// coordinator's bug-9 postmortem: `1 << r` for r < 0 is `1 << (r mod 64)`
// on this target (lslv), so a stray -1 sets bit 63, not "no bit" -- the
// exact corruption chased across this session. `site` (1..20 window,
// 1..20 cs) is a caller-chosen constant that names the call site. F2
// prerequisite (2026-09-09): it no longer names it through the EXIT CODE --
// that spanned 99..140 and collided with every real diagnostic -- but through
// selfcheck_exit's stderr line, `compiler self-check <kind>.<site>`, with a
// single exit code 201. Two words of cost, kept permanently.
fn vs_mask_take(fntab: [i64], r: i64, site: i64) -> i64 {
  let _ = if (if r < 0 then 1 else 0) + (if r >= 8 then 1 else 0) > 0 then selfcheck_exit(1, site) else 0;
  let _ = fntab[5388] = fntab[5388] - (fntab[5388] & (1 << r));
  let _ = if (fntab[5388] & (0 - 256)) != 0 then selfcheck_exit(2, site) else 0;
  0
}
fn vs_mask_free(fntab: [i64], r: i64, site: i64) -> i64 {
  let _ = if (if r < 0 then 1 else 0) + (if r >= 8 then 1 else 0) > 0 then selfcheck_exit(1, site) else 0;
  let _ = fntab[5388] = fntab[5388] | (1 << r);
  let _ = if (fntab[5388] & (0 - 256)) != 0 then selfcheck_exit(2, site) else 0;
  0
}
// cs mask polarity is the OPPOSITE of the window mask: bit SET means the
// cs temp IS live (in use), so "take" (claim it) SETS the bit and "free"
// (release it) CLEARS it -- mirrored from vs_mask_take/vs_mask_free's
// window convention (bit SET = free) on purpose; do not swap these.
fn vs_cs_take(fntab: [i64], r: i64, site: i64) -> i64 {
  let _ = if (if r < 19 then 1 else 0) + (if r > 26 then 1 else 0) > 0 then selfcheck_exit(3, site) else 0;
  let _ = fntab[5389] = fntab[5389] | (1 << (r - 19));
  let _ = if (fntab[5389] & (0 - 256)) != 0 then selfcheck_exit(4, site) else 0;
  0
}
fn vs_cs_free(fntab: [i64], r: i64, site: i64) -> i64 {
  let _ = if (if r < 19 then 1 else 0) + (if r > 26 then 1 else 0) > 0 then selfcheck_exit(3, site) else 0;
  let _ = fntab[5389] = fntab[5389] - (fntab[5389] & (1 << (r - 19)));
  let _ = if (fntab[5389] & (0 - 256)) != 0 then selfcheck_exit(4, site) else 0;
  0
}

// A2 commit 2 (constant hoisting): 0 or a live hoisted pair's register for
// value `v` (fntab 4578+2k/4579+2k, k<4 -- register 0 = unused slot, real cs
// registers are 19..26). Single choke point so vs_push's CONST interception
// stays a one-line check; the pairs are 0 whenever no loop is mid-hoist, so
// this is a no-op everywhere except inside a hoisting loop's own body.
fn hoist_lookup(fntab: [i64], v: i64) -> i64 {
  let k = 0;
  let found = 0;
  while k < 4 {
    let reg = fntab[5395 + 2 * k];
    let found = if (if reg > 0 then 1 else 0) * (if fntab[5394 + 2 * k] == v then 1 else 0) == 1 then reg else found;
    let k = k + 1;
    0
  };
  found
}

// A2 commit 2: bitmask (bits 0-7 = x19-x26, same convention as fntab[5389]
// itself) of the cs registers currently held by a live hoisted pair. A
// hoisting loop's own body legitimately holds a cs register across many of
// its own statement boundaries -- unlike every other cs use, which is
// released again before the statement it was parked in ends -- so the
// generic per-statement invariant (emit_body's "window empty implies cs
// mask empty" check) must subtract this mask before comparing, or every
// multi-statement hoisting loop body (K8H included: 4 lets per iteration)
// would trip it on its own first statement.
fn hoist_mask(fntab: [i64]) -> i64 {
  let k = 0;
  let m = 0;
  while k < 4 {
    let reg = fntab[5395 + 2 * k];
    let m = if reg > 0 then m | (1 << (reg - 19)) else m;
    let k = k + 1;
    0
  };
  m
}


fn vs_alloc(insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let _ = if fntab[5388] == 0 then vs_park_deepest(insns, n, fntab, stab) else 0;
  let r = lsb_idx(fntab[5388]);
  let _ = vs_mask_take(fntab, r, 1);
  r
}

// ROADMAP A6 (2026-09-08): emit_heap_trap (the T118 frame-heap capacity trap,
// `add x2,x15,#12288 ; add x2,x2,#3840 ; cmp x14,x2 ; b.ls +2 ; brk #81`) lived
// here and was called from emit_array_lit / emit_struct_lit / emit_enum_ctor /
// emit_enum_ctor_nullary. All four now allocate on the arena cursor x27 and use
// `zeros`'s own trap (brk #80) instead, so the helper, the frame heap it guarded
// and exit 81 are all deleted. The A4-round-2 bugfix it carried (take the scratch
// register through vs_alloc, never a hardcoded x2) is moot: the replacement needs
// no scratch register at all -- `cmp x27,x28` reads two process registers. What
// DOES survive from that bugfix is the vs_settle_flags call in emit_array_lit:
// the new `cmp` clobbers NZCV exactly like the trap it replaces, so a trailing
// FLAGS element must still be settled before it.

// MULC r,c materialisation into x<d> (spec §2 fusion table): all 5 cases
// merged into one function (each was a single-caller helper) to keep the
// bootstrap compiler's own fn count under its 256-entry table cap.
fn mat_mulc(insns: [i64], n: [i64], fntab: [i64], stab: [i64], r: i64, c: i64, d: i64) -> i64 {
  let cm1 = c - 1;
  let cp1 = c + 1;
  let is_pow2 = if (c & (c - 1)) == 0 then 1 else 0;
  let is_p1 = (1 - is_pow2) * (if (cm1 & (cm1 - 1)) == 0 then 1 else 0);
  let done01 = is_pow2 + is_p1;
  let is_m1 = (1 - done01) * (if (cp1 & (cp1 - 1)) == 0 then 1 else 0);
  let done012 = done01 + is_m1;
  let r2b = c & (0 - c);
  let rest = c - r2b;
  let is_2b = (1 - done012) * (if rest > 0 then 1 else 0) * (if (rest & (rest - 1)) == 0 then 1 else 0);
  let is_gen = 1 - done012 - is_2b;
  let kpow2 = if is_pow2 == 1 then 63 - clz(c) else 0;
  let _ = if is_pow2 == 1 then em(insns, n, 3544186880 + ((64 - kpow2) & 63) * 65536 + (63 - kpow2) * 1024 + r * 32 + d) else 0;
  let kp1 = if is_p1 == 1 then 63 - clz(cm1) else 0;
  let _ = if is_p1 == 1 then em(insns, n, 2332033024 + kp1 * 1024 + r * 65536 + r * 32 + d) else 0;
  let km1 = if is_m1 == 1 then 63 - clz(cp1) else 0;
  let _ = if is_m1 == 1 then em(insns, n, 3544186880 + ((64 - km1) & 63) * 65536 + (63 - km1) * 1024 + r * 32 + d) else 0;
  let _ = if is_m1 == 1 then em(insns, n, 3405774848 + r * 65536 + d * 32 + d) else 0;
  let j2b = if is_2b == 1 then 63 - clz(r2b) else 0;
  let khi2b = if is_2b == 1 then 63 - clz(c) else 0;
  let _ = if is_2b == 1 then em(insns, n, 2332033024 + (khi2b - j2b) * 1024 + r * 65536 + r * 32 + d) else 0;
  let _ = if is_2b == 1 then em(insns, n, 3544186880 + ((64 - j2b) & 63) * 65536 + (63 - j2b) * 1024 + d * 32 + d) else 0;
  let m = if is_gen == 1 then vs_alloc(insns, n, fntab, stab) else 0;
  let _ = if is_gen == 1 then mat_const(insns, n, c, m) else 0;
  let _ = if is_gen == 1 then em(insns, n, 2600500224 + m * 65536 + r * 32 + d) else 0;
  let _ = if is_gen == 1 then vs_mask_free(fntab, m, 3) else 0;
  n[0]
}

fn cs_free_idx(csmask: i64, from: i64) -> i64 {
  let i = from;
  let found = 8;
  while i < 8 {
    let bit = (csmask >> i) & 1;
    let found = if bit == 0 then (if found == 8 then i else found) else found;
    let i = i + 1;
    0
  };
  found
}

// Park entry `idx` IN PLACE: the entry stays at the same index (deeper
// entries below a barrier must stay findable by the enclosing expression at
// their original relative position -- park only ever changes an entry's
// KIND/payload, never the window's length or ordering; only vs_pop removes
// an entry, always from the top).
fn vs_park_to_cs(insns: [i64], n: [i64], fntab: [i64], idx: i64, d0: i64, cfi: i64) -> i64 {
  let cr = 19 + cfi;
  let _ = em(insns, n, 2852127712 + d0 * 65536 + cr);
  let _ = vs_cs_take(fntab, cr, 1);
  // mask rule (2026-09-06, §3.8/bug 9): d0 can be an argument-placement
  // register 8..13 (kind 2 entries target x8..x13 for the 9th+ argument,
  // per emit_bl_call), not only a vs_alloc-sourced window temp 0..7 --
  // never OR that into the WINDOW mask (fntab[5388] tracks x0..x7 only).
  let _ = if d0 < 8 then vs_mask_free(fntab, d0, 4) else 0;
  let hi = cfi + 1;
  let _ = if hi > fntab[5391] then fntab[5391] = hi else 0;
  vs_set_entry(fntab, idx, 4, cr, 0)
}
fn vs_park_to_slot(insns: [i64], n: [i64], fntab: [i64], idx: i64, d0: i64) -> i64 {
  let k = fntab[5390];
  // BUGFIX (2026-09-06, window relocation follow-up): this word encoded
  // `str x0, [x<d0>, #(S+k)*8]` (base 4177526784 = 0xf9000000, Rn=0, and
  // `d0*32` landing in the Rn field, bits 5-9) instead of `str x<d0>, [x15,
  // #(S+k)*8]` -- the STORE's value register and the SLOT base register
  // (x15) were swapped/missing. Never exercised before this commit: it only
  // fires when a REG-kind entry is parked to a SLOT, i.e. all 8 cs registers
  // (x19-x26) are already live -- verified via `as`/objdump (base
  // `str x0,[x15]` = 4177527264 = 0xf90001e0; +1 per Rt register, +1024 per
  // slot index, matching vs_mat_slot's LOAD encoding below).
  let _ = em(insns, n, 4177527264 + d0 + (fntab[5393] + k) * 1024);
  // mask rule (2026-09-06, §3.8/bug 9): same as vs_park_to_cs -- d0 may be
  // an argument register 8..13, which the window mask does not track.
  let _ = if d0 < 8 then vs_mask_free(fntab, d0, 5) else 0;
  let _ = fntab[5390] = k + 1;
  let _ = if k + 1 > fntab[5392] then fntab[5392] = k + 1 else 0;
  vs_set_entry(fntab, idx, 5, k, 0)
}

fn vs_park_move(insns: [i64], n: [i64], fntab: [i64], stab: [i64], idx: i64, is_reg: i64, is_mulc_win: i64, is_flags: i64, p0: i64, p1: i64) -> i64 {
  let d0 = if is_reg == 1 then p0 else vs_alloc(insns, n, fntab, stab);
  let _ = if is_flags == 1 then em(insns, n, 2594113504 + (p0 ^ 1) * 4096 + d0) else 0;
  let _ = if is_mulc_win == 1 then mat_mulc(insns, n, fntab, stab, p0, p1, d0) else 0;
  // BUGFIX (2026-09-06, bug-11 class): mat_mulc materialises into a FRESH
  // d0 (is_reg==0 here), leaving the MULC's own pinned source register p0
  // (always <8, is_mulc_win's own guard) un-freed -- the same leak vs_mat's
  // kind==6 dispatch had before that fix, just reached via vs_park instead
  // of a normal materialise (e.g. emit_cond's vs_park(1) parking a pending
  // `acc*131` MULC that sits below the if-expression on the window).
  let _ = if is_mulc_win == 1 then vs_mask_free(fntab, p0, 21) else 0;
  let cfi = cs_free_idx(fntab[5389], stab[0]);
  // ROADMAP A14 (2026-09-07): under fntab[5403] a cs REGISTER is not a legal
  // park destination -- every binder inside the `if` arms about to be compiled
  // (a `let`, a match payload, an inlined call's parameters) claims 19+S
  // upward and collides with exactly those registers, and the relocation that
  // would free one is emitted inside ONE arm only (check_reg_collision's
  // arm_spanning exit 89, DIVERGE RC2's mechanism). A temp SLOT is read
  // identically on both arms and after the join, and costs the same one word
  // (str/ldr instead of mov/mov).
  let to_cs = (if cfi < 8 then 1 else 0) * (1 - fntab[5403]);
  if to_cs == 1 then vs_park_to_cs(insns, n, fntab, idx, d0, cfi) else vs_park_to_slot(insns, n, fntab, idx, d0)
}

fn vs_park_idx(insns: [i64], n: [i64], fntab: [i64], stab: [i64], idx: i64) -> i64 {
  let kind = vs_entry_kind(fntab, idx);
  let p0 = vs_entry_p0(fntab, idx);
  let p1 = vs_entry_p1(fntab, idx);
  let is_reg = if kind == 2 then 1 else 0;
  let is_mulc_win = if kind == 6 then (if p0 < 8 then 1 else 0) else 0;
  let is_flags = if kind == 7 then 1 else 0;
  let needs = if is_reg + is_mulc_win + is_flags > 0 then 1 else 0;
  let _ = if needs == 1 then vs_park_move(insns, n, fntab, stab, idx, is_reg, is_mulc_win, is_flags, p0, p1) else 0;
  0
}

fn vs_park(insns: [i64], n: [i64], fntab: [i64], stab: [i64], keep: i64) -> i64 {
  let target = fntab[5387] - keep;
  let i = 0;
  while i < target {
    let _ = vs_park_idx(insns, n, fntab, stab, i);
    let i = i + 1;
    0
  };
  0
}
// ROADMAP A14 (2026-09-07): the entries vs_park just moved are covered by
// fntab[5403], but an entry ALREADY resident in a cs register when the `if` is
// reached (parked by an earlier vs_alloc, before the flag was set) spans the
// arms just the same -- move those to temp slots too. After this runs, NO
// pre-`if` entry owns a register: no arm's binder can collide with one, no
// vs_park_deepest/vs_evict inside an arm can pick one up (kind 5 is neither
// parkable nor register-owning), and emit_cond_branch's counter-only restore
// between the arms is sound.
fn vs_span_to_slots(insns: [i64], n: [i64], fntab: [i64], stab: [i64], keep: i64) -> i64 {
  let target = fntab[5387] - keep;
  let i = 0;
  while i < target {
    let kind = vs_entry_kind(fntab, i);
    let p0 = vs_entry_p0(fntab, i);
    let is_cs = if kind == 4 then 1 else 0;
    let _ = if is_cs == 1 then (let _ = vs_park_to_slot(insns, n, fntab, i, p0) in vs_cs_free(fntab, p0, 12)) else 0;
    // ROADMAP A14b (2026-09-08): a pending `SYM r` entry (kind 3) is not
    // register-OWNING, so A14's park/demote left it alone -- but it is still
    // arm-INVALIDATABLE, and that is the property that matters here. A write
    // to symbol `r` inside one arm makes vs_settle_sym_alias (the RC2
    // snapshot fix) materialise this entry into a window register from
    // INSIDE that arm; the `mov` runs on one path only, and once the entry
    // owns a register vs_park_deepest can park it to a cs register that a
    // later `let` in the same arm then binds -- check_reg_collision's
    // arm_spanning exit 89, corpus seed 100744 (docs/blueprints/
    // A14b-corpus-leftovers.md). Snapshot SYM entries to a temp slot here
    // too: a slot read is identical on both arms and after the join, and
    // kind 5 is neither parkable nor register-owning, so nothing inside an
    // arm can relocate it. Both words already exist (vs_park_to_slot's
    // `str`, whose Rt field spans all 32 registers, and vs_mat_sym's own
    // spilled-symbol `ldr`) -- no new instruction word.
    let is_sym_r = (if kind == 3 then 1 else 0) * (if p0 < 100 then 1 else 0);
    let is_sym_s = (if kind == 3 then 1 else 0) * (if p0 >= 100 then 1 else 0);
    let _ = if is_sym_r == 1 then vs_park_to_slot(insns, n, fntab, i, p0) else 0;
    let _ = if is_sym_s == 1 then (let t = vs_alloc(insns, n, fntab, stab) in (let _ = em(insns, n, 4181721568 + (p0 - 100) * 1024 + t) in (let _ = vs_park_to_slot(insns, n, fntab, i, t) in vs_mask_free(fntab, t, 41)))) else 0;
    let i = i + 1;
    0
  };
  0
}
// BUGFIX (2026-09-06, bug 9 root cause): this used to always park index 0
// -- but the DEEPEST window entry is not necessarily one that owns a
// register (it can be a SYM/CS/CONST/SLOT tag, which vs_park_idx's own
// `needs` check correctly does nothing for). When that happens the free
// mask stays empty, vs_alloc's lsb_idx(0) returns -1, and everything
// downstream that shifts `1 << r` treats r=-1 as `1 << 63` (this target's
// `lslv` shift amount is mod 64) -- a phantom bit 63 in a mask that must
// only ever hold bits 0-7. Scan for the actual first (deepest) entry that
// owns a register (kind 2, kind 6 with p0<8, or kind 7 FLAGS) and park
// that one instead; vs_alloc's own guard (site 1) stays as the permanent
// backstop if this scan ever legitimately finds nothing to park.
fn vs_find_parkable(fntab: [i64], w: i64) -> i64 {
  // Prefer a plain REG entry (kind 2): freeing it needs no further
  // register (d0 = its own p0, vs_park_move's is_reg path). A MULC-window
  // or FLAGS entry (kind 6/7) must first MATERIALISE into a fresh window
  // register before it can be parked (vs_park_move's vs_alloc(...) call) --
  // picking one of those when the mask is already empty (the only time
  // vs_park_deepest runs) recurses into vs_alloc with nothing to give it.
  // Only fall back to kind 6/7 if no plain REG exists.
  let i = 0;
  let found = 0 - 1;
  while i < w {
    let kind = vs_entry_kind(fntab, i);
    let hit = (if kind == 2 then 1 else 0) * (if found < 0 then 1 else 0);
    let found = if hit == 1 then i else found;
    let i = i + 1;
    0
  };
  let i2 = 0;
  let found2 = found;
  while i2 < w {
    let kind = vs_entry_kind(fntab, i2);
    let p0 = vs_entry_p0(fntab, i2);
    let owns = (if kind == 6 then (if p0 < 8 then 1 else 0) else 0) + (if kind == 7 then 1 else 0);
    let hit = owns * (if found2 < 0 then 1 else 0);
    let found2 = if hit == 1 then i2 else found2;
    let i2 = i2 + 1;
    0
  };
  found2
}
fn vs_park_deepest(insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let idx = vs_find_parkable(fntab, fntab[5387]);
  let _ = if idx >= 0 then vs_park_idx(insns, n, fntab, stab, idx) else 0;
  0
}

fn vs_find_owning(fntab: [i64], r: i64, excl: i64) -> i64 {
  let w = fntab[5387];
  let i = 0;
  let found = 0 - 1;
  while i < w {
    let kind = vs_entry_kind(fntab, i);
    let p0 = vs_entry_p0(fntab, i);
    let owns = (if kind == 2 then 1 else 0) + (if kind == 6 then (if p0 < 8 then 1 else 0) else 0);
    let hit = owns * (if p0 == r then 1 else 0) * (if i != excl then 1 else 0);
    let found = if hit == 1 then i else found;
    let i = i + 1;
    0
  };
  found
}

fn vs_evict_move(insns: [i64], n: [i64], fntab: [i64], stab: [i64], idx: i64, r: i64, r2: i64) -> i64 {
  // BUGFIX (2026-09-06): vs_find_owning also matches a MULC-window entry
  // (kind 6, p0 < 8) as "owning" register r, since it does live in r until
  // materialised -- but that entry's r is a PENDING multiply operand, not
  // a finished value. A plain `mov r2, r` (the old body, unconditional)
  // discarded the entry's constant (p1) and downgraded it to a plain REG
  // holding the unmultiplied value -- e.g. `insns[0] * 2` silently became
  // `insns[0]` whenever the array-get's destination register collided
  // with vs_to's own target register, forcing an evict. vs_park_move
  // already gets this right (mat_mulc before parking); mirror it here.
  let is_mulc = if vs_entry_kind(fntab, idx) == 6 then 1 else 0;
  let c = vs_entry_p1(fntab, idx);
  let _ = if is_mulc == 1 then mat_mulc(insns, n, fntab, stab, r, c, r2) else em(insns, n, 2852127712 + r * 65536 + r2);
  let _ = vs_mask_take(fntab, r2, 6);
  // mask rule (2026-09-06, §3.8/bug 9): r may be an argument register
  // 8..13 (an unplaced call argument owning a REG/MULC-window entry that
  // vs_find_owning matched) -- outside the window mask's 0..7 range.
  let _ = if r < 8 then vs_mask_free(fntab, r, 7) else 0;
  vs_set_entry(fntab, idx, 2, r2, n[0] - 1)
}

fn vs_evict_at(insns: [i64], n: [i64], fntab: [i64], stab: [i64], idx: i64, r: i64) -> i64 {
  let mask = fntab[5388];
  if mask > 0 then vs_evict_move(insns, n, fntab, stab, idx, r, lsb_idx(mask)) else vs_park_idx(insns, n, fntab, stab, idx)
}

fn vs_evict(insns: [i64], n: [i64], fntab: [i64], stab: [i64], r: i64) -> i64 {
  let idx = vs_find_owning(fntab, r, 0 - 1);
  let _ = if idx >= 0 then vs_evict_at(insns, n, fntab, stab, idx, r) else 0;
  0
}

// A2 commit 1 (§1.2 rule suspended inside emit_cond's csel window,
// fntab[5290] = 1 while both pure arms are being compiled below a buried
// cond FLAGS entry): purity guarantees neither arm emits a flag-setting
// word, so the entry cannot be corrupted by sitting un-settled -- only this
// narrow window (set/cleared by emit_cond_csel, never left set on any
// return path since the arms it wraps can contain no nested `if`) disables
// the auto-materialise-on-push guard below.
fn vs_settle_flags(insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let w = fntab[5387];
  // ROADMAP A2b (2026-09-08): the suspension the comment above describes was
  // never actually READ -- fntab[5290] was set and cleared by emit_cond_csel
  // but no code consulted it, so every pure `if` still settled its condition
  // with a `cset` at the first arm push and emit_cond_csel then had to REBUILD
  // the flags with `cmp x<r>,#0` before the `csel`. Two dead words and a
  // 4-deep serial dependency (cmp -> cset -> cmp -> csel) on every csel,
  // including K8H's hot loop. Honouring the flag makes the FLAGS tag survive
  // as the csel's own cond field: cmp -> csel.
  let is_flags = if fntab[5290] == 1 then 0 else (if w > 0 then (if vs_entry_kind(fntab, w - 1) == 7 then 1 else 0) else 0);
  let _ = if is_flags == 1 then vs_mat(insns, n, fntab, stab, w - 1, vs_alloc(insns, n, fntab, stab)) else 0;
  0
}

fn vs_push(insns: [i64], n: [i64], fntab: [i64], stab: [i64], kind: i64, p0: i64, p1: i64) -> i64 {
  let _ = vs_settle_flags(insns, n, fntab, stab);
  // REGISTER-MODEL-BLUEPRINT window relocation: the entry LIST (fntab[3700..4335],
  // 512 slots -- raised from 128 2026-09-06: emit_cond's parkable-`d` fix keeps one
  // extra live entry per nested if-level for the whole else-branch compile, so a
  // deep `if..else if..` dispatch chain (dpll.bp's SAT-solver branching hit 256)
  // now needs several times the entries it used to) is decoupled from the
  // 8-register free mask (fntab[5388]; A2 step 0 2026-09-06/07 moved the
  // whole table from the old base 2000+3i to fntab[3700+3i] to make room for the
  // fn-cap-512 relayout) -- only REG/MULC-window/FLAGS kinds need a register, so a
  // pending SYM/CONST/etc. entry must never be forced through vs_park_deepest
  // just because w passed 8. The only cap left is the physical entry-list
  // capacity itself.
  let _ = if fntab[5387] >= 512 then sys_exit(89) else 0;
  let w = fntab[5387];
  // A2 commit 2 (constant hoisting): a CONST push whose value matches a live
  // hoisted pair (fntab 4578+2k/4579+2k, only ever nonzero inside one
  // `while` loop's own body compile) becomes a direct SYM(register) push
  // instead -- byte-identical to referencing a permanent local, and a no-op
  // everywhere hoist_lookup finds nothing (every construct outside a
  // hoisting loop's body sees kindH==kind, p0H==p0, zero behaviour change).
  let hreg = if kind == 1 then hoist_lookup(fntab, p0) else 0;
  let kindH = if hreg > 0 then 3 else kind;
  let p0H = if hreg > 0 then hreg else p0;
  let _ = vs_set_entry(fntab, w, kindH, p0H, p1);
  let _ = fntab[5387] = w + 1;
  // A REG push always OWNS its register in the free mask. Most callers get
  // this for free (the register came from vs_alloc, whose bit is already
  // clear) -- but a `bl`/builtin result and the -1 unbound-symbol path claim
  // a FIXED register (x0) without allocating it first; without this the
  // mask still showed it free and a later vs_alloc could hand the same
  // physical register to something else while this tag still owned it.
  let _ = if kindH == 2 then (if p0H < 8 then vs_mask_take(fntab, p0H, 8) else 0) else 0;
  0
}

fn vs_pop(fntab: [i64]) -> i64 {
  let w = fntab[5387];
  let top = w - 1;
  let kind = vs_entry_kind(fntab, top);
  let p0 = vs_entry_p0(fntab, top);
  // mask rule (2026-09-06, §3.8/bug 9): a popped kind-2 entry can be an
  // argument-placement register 8..13 (emit_bl_call pops every arg entry
  // after a call, including the 9th+ that target x8..x13) -- guard is_reg
  // by p0<8 too, not just is_mulc_win, so that never leaks into the
  // window mask (fntab[5388] tracks x0..x7 only).
  let is_reg = (if kind == 2 then 1 else 0) * (if p0 < 8 then 1 else 0);
  let is_mulc_win = if kind == 6 then (if p0 < 8 then 1 else 0) else 0;
  let is_cs = if kind == 4 then 1 else 0;
  // ROADMAP A27 (2026-09-14): a kind-6 MULC tag can own a CALLEE-SAVED register, not
  // only a window one. vs_try_mulc_new takes that bit itself (`vs_cs_take(fntab, r, 5)`
  // when the other operand is a kind-4 CS entry) and vs_mat already releases it with
  // exactly this 19..26 guard (:2923) -- but vs_pop only had the p0<8 window branch, so
  // popping such a tag freed NOTHING and left fntab[5389] dirty forever. At the next
  // statement boundary the window is 0 and the mask is not, which is self-check 7.1.
  // Five lines reproduce it: `let v0 = 1; v0 *= (let t1 = clz(1) in 17); v0` -- the call
  // parks the LHS in a cs register and the constant RHS takes the mulc fold. `*=` only:
  // += -= /= %= never reach vs_try_mulc_new.
  let is_mulc_cs = if kind == 6 then ((if p0 >= 19 then 1 else 0) * (if p0 <= 26 then 1 else 0)) else 0;
  let _ = if is_reg + is_mulc_win == 1 then vs_mask_free(fntab, p0, 9) else 0;
  let _ = if is_cs + is_mulc_cs > 0 then vs_cs_free(fntab, p0, 2) else 0;
  let _ = fntab[5387] = top;
  // statement boundary: the temp-slot cursor is bump-allocated per
  // expression statement and resets once the window is fully drained.
  let _ = if top == 0 then fntab[5390] = 0 else 0;
  // A "w==0" boundary here fires too often to double as a leak invariant
  // point (e.g. mid multi-arg call setup, well before the `bl`/result
  // push) -- tried fntab[5388]==255 and fntab[5389]==0 checks here per
  // the coordinator's bug-9 diagnostic; both false-positived on trivial,
  // already-correct programs (tfib.bp), so removed rather than shipped
  // broken. The real leaks found and fixed this round (vs_not_reg,
  // vs_neg_reg abandoning a REG/CS source register when the entry becomes
  // FLAGS) stand on their own regression evidence, not this check.
  0
}

fn vs_mat_reg(insns: [i64], n: [i64], fntab: [i64], i: i64, r: i64, d: i64) -> i64 {
  // mask rule (2026-09-06, §3.8 cycle-break fix): x16 (the scratch used to
  // evict a cycle's blocker) lives outside the window mask -- freeing "bit
  // 16" would set a bit >=8 in fntab[5388], the exact corruption bug 9
  // chased. r is always <8 for a genuine window REG except this one case.
  let _ = if r != d then (let _ = em(insns, n, 2852127712 + r * 65536 + d) in (let _ = if r < 8 then vs_mask_free(fntab, r, 10) else 0 in vs_set_entry(fntab, i, 2, d, n[0] - 1))) else 0;
  n[0]
}
fn vs_mat_sym(insns: [i64], n: [i64], fntab: [i64], i: i64, r: i64, d: i64) -> i64 {
  let is_spill = if r >= 100 then 1 else 0;
  // Per §1.1/§1.4: a SYMBOL slot's index is just `reg-100` (0..S-1, the
  // region BELOW the temp-slot base S) -- no `+S` here. (Coordinator
  // correction 2026-09-06: an earlier pass of this fix added `+S` to both
  // this read and vs_bind's write, moving symbols onto S..2S-1 and
  // aliasing them with temp slots at S..S+tsp-1. `+S` belongs ONLY on
  // temp-slot access -- vs_park_to_slot, vs_mat_slot, vs_break_cycle.)
  let _ = if is_spill == 0 then em(insns, n, 2852127712 + r * 65536 + d) else em(insns, n, 4181721568 + (r - 100) * 1024 + d);
  vs_set_entry(fntab, i, 2, d, n[0] - 1)
}
fn vs_mat_cs(insns: [i64], n: [i64], fntab: [i64], i: i64, r: i64, d: i64) -> i64 {
  let _ = em(insns, n, 2852127712 + r * 65536 + d);
  let _ = vs_cs_free(fntab, r, 3);
  vs_set_entry(fntab, i, 2, d, n[0] - 1)
}
fn vs_mat_slot(insns: [i64], n: [i64], fntab: [i64], i: i64, k: i64, d: i64) -> i64 {
  let _ = em(insns, n, 4181721568 + (fntab[5393] + k) * 1024 + d);
  vs_set_entry(fntab, i, 2, d, n[0] - 1)
}

fn vs_mat(insns: [i64], n: [i64], fntab: [i64], stab: [i64], i: i64, d: i64) -> i64 {
  let kind = vs_entry_kind(fntab, i);
  let p0 = vs_entry_p0(fntab, i);
  let p1 = vs_entry_p1(fntab, i);
  let _ = if kind == 1 then vs_set_entry(fntab, i, 2, d, mat_const(insns, n, p0, d)) else 0;
  let _ = if kind == 2 then vs_mat_reg(insns, n, fntab, i, p0, d) else 0;
  let _ = if kind == 3 then vs_mat_sym(insns, n, fntab, i, p0, d) else 0;
  let _ = if kind == 4 then vs_mat_cs(insns, n, fntab, i, p0, d) else 0;
  let _ = if kind == 5 then vs_mat_slot(insns, n, fntab, i, p0, d) else 0;
  // BUGFIX (2026-09-06, bug 9): mat_mulc consumes p0 (the MULC's own
  // pinned source register) to compute d = p0*p1, then the entry becomes
  // a plain REG owning d -- p0 itself is never referenced again, but
  // nothing freed its mask bit (window 0-7 or cs 19-26) unless d happens
  // to equal p0. Orphaned bit, one leak per MULC materialised into a
  // fresh register (e.g. `bi * 64` with bi spilled: t=ldr from slot,
  // lsl d,t,#6 into a NEW d, t's bit never released).
  let _ = if kind == 6 then (let _ = mat_mulc(insns, n, fntab, stab, p0, p1, d) in (let _ = if d != p0 then (if p0 < 8 then vs_mask_free(fntab, p0, 18) else (if p0 >= 19 then (if p0 <= 26 then vs_cs_free(fntab, p0, 9) else 0) else 0)) else 0 in vs_set_entry(fntab, i, 2, d, n[0] - 1))) else 0;
  let _ = if kind == 7 then (let _ = em(insns, n, 2594113504 + (p0 ^ 1) * 4096 + d) in vs_set_entry(fntab, i, 2, d, n[0] - 1)) else 0;
  n[0]
}

fn vs_reg(insns: [i64], n: [i64], fntab: [i64], stab: [i64], i: i64) -> i64 {
  let kind = vs_entry_kind(fntab, i);
  let p0 = vs_entry_p0(fntab, i);
  let is_direct = (if kind == 2 then 1 else 0) + (if kind == 3 then (if p0 < 100 then 1 else 0) else 0) + (if kind == 4 then 1 else 0);
  let _ = if is_direct == 0 then vs_mat(insns, n, fntab, stab, i, vs_alloc(insns, n, fntab, stab)) else 0;
  vs_entry_p0(fntab, i)
}


fn vs_to(insns: [i64], n: [i64], fntab: [i64], stab: [i64], d: i64) -> i64 {
  let w = fntab[5387];
  let top = w - 1;
  let owns = if vs_entry_kind(fntab, top) == 2 then (if vs_entry_p0(fntab, top) == d then 1 else 0) else 0;
  let _ = if owns == 0 then vs_evict(insns, n, fntab, stab, d) else 0;
  vs_mat(insns, n, fntab, stab, top, d)
}

// BUGFIX (A4 fuzz DIVERGE round 2, 2026-09-07): a bare symbol used as an
// operand pushes a lazy `SYM r` tag (no word, spec §1.2) that only reads
// register/slot `r` at MATERIALISE time -- fine when nothing between the
// push and the materialisation can change what `r` holds, but a sibling
// operand evaluated afterward (the RHS of `a OP (let _ = x = e in body)`,
// or an array-index self-store `a0[(x)&7] = ... ` used the same way) can
// itself be a write to that SAME symbol (emit_let_chain / emit_compound_stmt
// both call vs_bind directly, with no `let`-creation step for
// check_reg_collision to hook). The still-pending `SYM r` tag then reads
// the NEW value at materialise time instead of the value `x` held when it
// was pushed -- the same snapshot hazard as RC1 (emit_compound_rhs), one
// level more general: RC1 only guarded op='s OWN implicit left operand;
// this guards every OTHER pending `SYM r`/`SYM 100+k` window entry whenever
// ANY write to that register/slot is about to happen. Repro: `let v0=0;
// let a0=[16,1,2,3,4,5,6,15]; (v0) > (let _ = v0 = a0[(v0)&7] in 8)` --
// oracle 0 (LHS `v0` reads the OLD 0), was compiling to 1 (LHS re-read
// AFTER the RHS's reassignment). Fix: before a write to `reg`, materialise
// every OTHER live `SYM reg` entry into a real register first (vs_mat via
// vs_alloc) -- a compile-time-only scan, zero extra words unless the
// hazard is actually present (mirrors check_reg_collision's own scan/site
// shape, just against kind 3 instead of kind 4, and at write time instead
// of bind-a-new-name time).
fn vs_settle_sym_alias(insns: [i64], n: [i64], fntab: [i64], stab: [i64], reg: i64) -> i64 {
  let w = fntab[5387];
  let i = 0;
  while i < w {
    let k = vs_entry_kind(fntab, i);
    let p0 = vs_entry_p0(fntab, i);
    let hit = (if k == 3 then 1 else 0) * (if p0 == reg then 1 else 0);
    let _ = if hit == 1 then vs_mat(insns, n, fntab, stab, i, vs_alloc(insns, n, fntab, stab)) else 0;
    let i = i + 1;
    0
  };
  0
}

// Consume the top tag into symbol register/slot `reg` (spec §1.4 vs_bind).
// Merged into 2 functions (was 8 single-caller helpers) to stay under the
// bootstrap compiler's 256-fn table cap.
fn vs_bind(insns: [i64], n: [i64], fntab: [i64], stab: [i64], reg: i64) -> i64 {
  let is_neg = if reg < 0 then 1 else 0;
  let is_spill = (1 - is_neg) * (if reg >= 100 then 1 else 0);
  let is_reg = (1 - is_neg) * (1 - is_spill);
  let _ = if is_neg == 0 then vs_settle_sym_alias(insns, n, fntab, stab, reg) else 0;
  let w = fntab[5387];
  let r_spill = if is_spill == 1 then vs_reg(insns, n, fntab, stab, w - 1) else 0;
  let _ = if is_neg == 1 then em(insns, n, 3558866944) else 0;
  // same STR-to-slot encoding bugfix as vs_park_to_slot: base is
  // `str x0,[x15]` (4177527264), +1 per Rt register (not *32 -- that lands
  // in the Rn/base-register field instead), +1024 per slot index. This IS
  // the symbol region (index `reg-100`, 0..S-1) -- no `+S` here (that
  // belongs only to the temp region above it; see vs_mat_sym).
  let _ = if is_spill == 1 then em(insns, n, 4177527264 + r_spill + (reg - 100) * 1024) else 0;
  let _ = if is_reg == 1 then vs_bind_reg(insns, n, fntab, stab, reg) else 0;
  vs_pop(fntab)
}
fn vs_bind_reg(insns: [i64], n: [i64], fntab: [i64], stab: [i64], reg: i64) -> i64 {
  let w = fntab[5387];
  let top = w - 1;
  let kind = vs_entry_kind(fntab, top);
  let p0 = vs_entry_p0(fntab, top);
  let p1 = vs_entry_p1(fntab, top);
  let is_retgt = (if kind == 2 then 1 else 0) * (if p1 == n[0] - 1 then 1 else 0);
  let is_slow = 1 - is_retgt;
  let p = n[0] - 1;
  let _ = if is_retgt == 1 then insns[p] = insns[p] - p0 + reg else 0;
  // mask rule (2026-09-06, §3.8/bug 9): p0 here can be an argument register
  // 8..13, outside the window mask's 0..7 range -- guard both frees.
  let _ = if is_retgt * (if p0 < 8 then 1 else 0) == 1 then vs_mask_free(fntab, p0, 11) else 0;
  let is_spill_sym = if p0 >= 100 then 1 else 0;
  let _ = if is_slow * (if kind == 1 then 1 else 0) == 1 then mat_const(insns, n, p0, reg) else 0;
  let _ = if is_slow * (if kind == 2 then 1 else 0) == 1 then em(insns, n, 2852127712 + p0 * 65536 + reg) else 0;
  let _ = if is_slow * (if kind == 2 then 1 else 0) * (if p0 < 8 then 1 else 0) == 1 then vs_mask_free(fntab, p0, 12) else 0;
  let _ = if is_slow * (if kind == 3 then 1 else 0) * (1 - is_spill_sym) == 1 then em(insns, n, 2852127712 + p0 * 65536 + reg) else 0;
  // symbol region (index p0-100, 0..S-1) -- no `+S`, same as vs_mat_sym.
  let _ = if is_slow * (if kind == 3 then 1 else 0) * is_spill_sym == 1 then em(insns, n, 4181721568 + (p0 - 100) * 1024 + reg) else 0;
  let _ = if is_slow * (if kind == 4 then 1 else 0) == 1 then em(insns, n, 2852127712 + p0 * 65536 + reg) else 0;
  let _ = if is_slow * (if kind == 4 then 1 else 0) == 1 then vs_cs_free(fntab, p0, 4) else 0;
  let _ = if is_slow * (if kind == 5 then 1 else 0) == 1 then em(insns, n, 4181721568 + (fntab[5393] + p0) * 1024 + reg) else 0;
  let _ = if is_slow * (if kind == 6 then 1 else 0) == 1 then mat_mulc(insns, n, fntab, stab, p0, p1, reg) else 0;
  let _ = if is_slow * (if kind == 7 then 1 else 0) == 1 then em(insns, n, 2594113504 + (p0 ^ 1) * 4096 + reg) else 0;
  0
}

fn vs_pick_dest(insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let w = fntab[5387];
  let ak = vs_entry_kind(fntab, w - 2);
  let bk = vs_entry_kind(fntab, w - 1);
  if ak == 2 then vs_entry_p0(fntab, w - 2) else (if bk == 2 then vs_entry_p0(fntab, w - 1) else vs_alloc(insns, n, fntab, stab))
}

// Each vs_try_* below merges its old separate "_apply" helper directly (spec
// §2 table rows); every sub-case was previously a single-caller function --
// merged to stay under the bootstrap compiler's 256-fn table cap.
fn vs_try_fold(insns: [i64], n: [i64], fntab: [i64], stab: [i64], op: i64) -> i64 {
  let w = fntab[5387];
  let ak = vs_entry_kind(fntab, w - 2);
  let bk = vs_entry_kind(fntab, w - 1);
  let both = (if ak == 1 then 1 else 0) * (if bk == 1 then 1 else 0);
  let a = vs_entry_p0(fntab, w - 2);
  let b = vs_entry_p0(fntab, w - 1);
  let is_dm = (if op == 5 then 1 else 0) + (if op == 11 then 1 else 0);
  let unsafe = is_dm * (if b == 0 then 1 else 0);
  let ok = both * (1 - unsafe);
  let v = (if op == 2 then a + b else 0) + (if op == 3 then a - b else 0) + (if op == 4 then a * b else 0)
    + (if op == 5 then a / b else 0) + (if op == 11 then a - (a / b) * b else 0)
    + (if op == 12 then a & b else 0) + (if op == 13 then a | b else 0) + (if op == 14 then a ^ b else 0)
    + (if op == 15 then a << b else 0) + (if op == 16 then a >> b else 0) + (if op == 17 then a >>> b else 0);
  let _ = if ok == 1 then (let _ = vs_pop(fntab) in (let _ = vs_pop(fntab) in vs_push(insns, n, fntab, stab, 1, v, 0))) else 0;
  ok
}

fn vs_try_addsub_imm(insns: [i64], n: [i64], fntab: [i64], stab: [i64], op: i64) -> i64 {
  let w = fntab[5387];
  let bk = vs_entry_kind(fntab, w - 1);
  let is_addsub = (if op == 2 then 1 else 0) + (if op == 3 then 1 else 0);
  let is_c = if bk == 1 then 1 else 0;
  let c = vs_entry_p0(fntab, w - 1);
  let pos_ok = (if c >= 0 then 1 else 0) * (if c < 4096 then 1 else 0);
  let neg_ok = (if c > 0 - 4096 then 1 else 0) * (if c < 0 then 1 else 0);
  let ok = is_addsub * is_c * (pos_ok + neg_ok);
  let d = if ok == 1 then vs_pick_dest(insns, n, fntab, stab) else 0;
  let a = if ok == 1 then vs_reg(insns, n, fntab, stab, w - 2) else 0;
  let imm = if pos_ok == 1 then c else 0 - c;
  let use_add = if pos_ok == 1 then (if op == 2 then 1 else 0) else (if op == 2 then 0 else 1);
  let _ = if ok * use_add == 1 then em(insns, n, 2432696320 + imm * 1024 + a * 32 + d) else 0;
  let _ = if ok * (1 - use_add) == 1 then em(insns, n, 3506438144 + imm * 1024 + a * 32 + d) else 0;
  let _ = if ok == 1 then (let _ = vs_pop(fntab) in (let _ = vs_pop(fntab) in vs_push(insns, n, fntab, stab, 2, d, n[0] - 1))) else 0;
  ok
}

fn vs_try_mulc_new(insns: [i64], n: [i64], fntab: [i64], stab: [i64], op: i64) -> i64 {
  let w = fntab[5387];
  let is_mul = if op == 4 then 1 else 0;
  let ak = vs_entry_kind(fntab, w - 2);
  let bk = vs_entry_kind(fntab, w - 1);
  let a_isc = if ak == 1 then 1 else 0;
  let b_isc = if bk == 1 then 1 else 0;
  let other_is_c = a_isc + b_isc;
  let const_val = if b_isc == 1 then vs_entry_p0(fntab, w - 1) else vs_entry_p0(fntab, w - 2);
  let in_range = (if const_val >= 1 then 1 else 0) * (if const_val < 65536 then 1 else 0);
  let ok = is_mul * (if other_is_c == 1 then 1 else 0) * in_range;
  let other_idx = if b_isc == 1 then w - 2 else w - 1;
  let other_kind = if b_isc == 1 then ak else bk;
  // BUGFIX (2026-09-06): vs_pop (below) unconditionally frees the OTHER
  // operand's ownership bit (window mask fntab[5388] for a REG entry, cs
  // mask fntab[5389] for a CS entry) -- but the MULC tag pushed right
  // after still references that register (`r`, computed next) as live.
  // Without re-claiming the bit, a later vs_alloc/vs_park can hand it to
  // something else while the tag still owns it, silently dropping the
  // multiply. vs_alloc only ever hands out WINDOW registers (0-7), so `r`
  // ends up a window register whenever the operand was anything vs_reg
  // had to materialise (not already kind 2, not a direct kind-4 CS entry,
  // not a permanent symbol register) -- computed from the ORIGINAL
  // kind/p0, read here BEFORE vs_reg can mutate the entry (kind 3 with
  // p0>=100, a SPILLED symbol, is exactly bug 8: cli_compile's
  // `buf[k*4]=...` with k spilled -- vs_reg materialises it into a fresh
  // window register that vs_pop would otherwise silently free while the
  // MULC tag still owns it).
  let r_is_cs = if other_kind == 4 then 1 else 0;
  let r_is_winreg = (1 - r_is_cs) - ((if other_kind == 3 then 1 else 0) * (if vs_entry_p0(fntab, other_idx) < 100 then 1 else 0));
  let r = if ok == 1 then vs_reg(insns, n, fntab, stab, other_idx) else 0;
  let _ = if ok == 1 then (let _ = vs_pop(fntab) in (let _ = vs_pop(fntab) in (
    let _ = if r_is_winreg == 1 then vs_mask_take(fntab, r, 13) else 0 in
    (let _ = if r_is_cs == 1 then vs_cs_take(fntab, r, 5) else 0 in
     vs_push(insns, n, fntab, stab, 6, r, const_val))
  ))) else 0;
  ok
}

fn vs_try_shift_imm(insns: [i64], n: [i64], fntab: [i64], stab: [i64], op: i64) -> i64 {
  let w = fntab[5387];
  let is_shift = (if op == 15 then 1 else 0) + (if op == 16 then 1 else 0) + (if op == 17 then 1 else 0);
  let bk = vs_entry_kind(fntab, w - 1);
  let is_c = if bk == 1 then 1 else 0;
  let k = vs_entry_p0(fntab, w - 1);
  let in_range = (if k >= 0 then 1 else 0) * (if k < 64 then 1 else 0);
  let ok = is_shift * is_c * in_range;
  let d = if ok == 1 then vs_pick_dest(insns, n, fntab, stab) else 0;
  let a = if ok == 1 then vs_reg(insns, n, fntab, stab, w - 2) else 0;
  let _ = if ok * (if op == 15 then 1 else 0) == 1 then em(insns, n, 3544186880 + ((64 - k) & 63) * 65536 + (63 - k) * 1024 + a * 32 + d) else 0;
  let _ = if ok * (if op == 16 then 1 else 0) == 1 then em(insns, n, 3544186880 + k * 65536 + 63 * 1024 + a * 32 + d) else 0;
  let _ = if ok * (if op == 17 then 1 else 0) == 1 then em(insns, n, 2470445056 + k * 65536 + 63 * 1024 + a * 32 + d) else 0;
  let _ = if ok == 1 then (let _ = vs_pop(fntab) in (let _ = vs_pop(fntab) in vs_push(insns, n, fntab, stab, 2, d, n[0] - 1))) else 0;
  ok
}

// A2b step 2c (the last word of the K8H bit test that codegen can reach). After step 2b
// `(x >> 60) & 1` is `lsr` + `and #1` -- two words where AArch64 has one, because a right
// shift followed by a low-run mask IS a bitfield extract. Both are UBFM(64): `lsr Xd,Xn,#k`
// is immr=k imms=63, and `ubfx Xd,Xn,#lsb,#width` is immr=lsb imms=lsb+width-1, so the mask
// collapses into the shift by rewriting imms ALONE -- 63 -> lsb+width-1, i.e.
// -63*1024 + (lsb+width-1)*1024. `as`+objdump ($BEBOP_TMP/words.objdump): lsr x22,x20,#60 =
// 0xd37cfe96, ubfx x22,x20,#60,#1 = 0xd37cf296, exactly 3*1024 apart; lsr x0,x0,#0 =
// 0xd340fc00, ubfx x0,x0,#0,#63 = 0xd340f800, exactly 1*1024 apart.
//
// Same backward rewrite as vs_try_madd, same three guards: the masked operand must be a REG
// whose `p` still names the LAST word emitted (so nothing has run between), that word must
// really be a 64-bit UBFM with imms == 63 (bits 31:22 == 845 -- this deliberately EXCLUDES
// `>>>`/asr, which is SBFM 589 and whose sign bits an unsigned extract would drop), and its
// Rd must be the entry's own register. The fourth guard is arithmetic: the extract may not
// run off the top of the register, lsb + width <= 64. `(x >> 60) & 255` fails it (60 + 8 =
// 68) and keeps the old two words, which are what actually preserve the zeros above bit 3.
fn vs_try_ubfx(insns: [i64], n: [i64], fntab: [i64], stab: [i64], op: i64) -> i64 {
  let w = fntab[5387];
  let last = n[0] - 1;
  let lidx = if last > 0 then last else 0;
  let word = insns[lidx];
  let c = vs_entry_p0(fntab, w - 1);
  let r = vs_entry_p0(fntab, w - 2);
  let kw = 64 - clz(c);
  let lsb = (word >> 16) & 63;
  let mask_ok = (if op == 12 then 1 else 0) * (if vs_entry_kind(fntab, w - 1) == 1 then 1 else 0)
    * (if c > 0 then 1 else 0) * (if (c & (c + 1)) == 0 then 1 else 0);
  let src_ok = (if last > 0 then 1 else 0) * (if vs_entry_kind(fntab, w - 2) == 2 then 1 else 0)
    * (if vs_entry_p1(fntab, w - 2) == last then 1 else 0);
  let word_ok = (if (word >> 22) == 845 then 1 else 0) * (if ((word >> 10) & 63) == 63 then 1 else 0)
    * (if (word & 31) == r then 1 else 0);
  let ok = mask_ok * src_ok * word_ok * (if lsb + kw < 65 then 1 else 0);
  let _ = if ok == 1 then insns[lidx] = word - 64512 + (lsb + kw - 1) * 1024 else 0;
  let _ = if ok == 1 then (let _ = vs_pop(fntab) in (let _ = vs_pop(fntab) in vs_push(insns, n, fntab, stab, 2, r, n[0] - 1))) else 0;
  ok
}

// A2b step 2b (the K8H branch bit). `e & C` with C a CONST fell through every
// vs_try_* above into vs_binop_reg, which materialises C into a register
// first: K8H's `(x >> 60) & 1` compiled to `mov x1,#1` + `and x22,x0,x1`
// where the Rust twin needs no register at all, and the same two-words-for-one
// shows up on every mask in this tree (`& 1`, `& 7`, `& 31`, `& 63`, `& 255`
// are all over bebop.bp itself). AArch64's logical instructions take a bitmask
// immediate; the sub-case that matters is the low-run mask C = 2^k - 1, which
// encodes as N=1, immr=0, imms=k-1, i.e. `and Xd,Xn,#C` = 0x92400000 +
// (k-1)*1024 + Rn*32 + Rd. `as`+objdump ($BEBOP_TMP/words.objdump): and
// x0,x0,#1 = 0x92400000 = 2453667840, and x0,x0,#255 = 0x92401c00 =
// 2453667840 + 7*1024 (so imms really is at bits 15:10), and x1,x0,#1 = +1
// (Rd), and x0,x1,#1 = +32 (Rn).
//
// The FULL bitmask encoder (rotated runs, replicated 2/4/8/16/32-bit element
// widths) is deliberately not built: `c > 0 && (c & (c + 1)) == 0` is the
// whole test for a low run of ones, it is two instructions, and it covers
// every `&` constant this tree writes. c = 2^63-1 is included and is a legal
// immediate (k = 63, imms = 62); c <= 0 -- including -1, whose `and` is a
// no-op the fold above does not have -- is rejected and falls through to the
// old mov+and, which stays correct for everything this does not take.
fn vs_try_and_imm(insns: [i64], n: [i64], fntab: [i64], stab: [i64], op: i64) -> i64 {
  let w = fntab[5387];
  let c = vs_entry_p0(fntab, w - 1);
  let ok = (if op == 12 then 1 else 0) * (if vs_entry_kind(fntab, w - 1) == 1 then 1 else 0)
    * (if c > 0 then 1 else 0) * (if (c & (c + 1)) == 0 then 1 else 0);
  let k = if ok == 1 then 64 - clz(c) else 1;
  let d = if ok == 1 then vs_pick_dest(insns, n, fntab, stab) else 0;
  let a = if ok == 1 then vs_reg(insns, n, fntab, stab, w - 2) else 0;
  let _ = if ok == 1 then em(insns, n, 2453667840 + (k - 1) * 1024 + a * 32 + d) else 0;
  let _ = if ok == 1 then (let _ = vs_pop(fntab) in (let _ = vs_pop(fntab) in vs_push(insns, n, fntab, stab, 2, d, n[0] - 1))) else 0;
  ok
}

fn vs_try_mulc_add(insns: [i64], n: [i64], fntab: [i64], stab: [i64], op: i64) -> i64 {
  let w = fntab[5387];
  let is_add = if op == 2 then 1 else 0;
  let ak = vs_entry_kind(fntab, w - 2);
  let bk = vs_entry_kind(fntab, w - 1);
  let a_mulc = if ak == 6 then 1 else 0;
  let b_mulc = if bk == 6 then 1 else 0;
  let ok = is_add * (a_mulc + b_mulc) * (1 - a_mulc * b_mulc);
  let mulc_idx = if a_mulc == 1 then w - 2 else w - 1;
  let other_idx = if a_mulc == 1 then w - 1 else w - 2;
  let mr = if ok == 1 then vs_entry_p0(fntab, mulc_idx) else 0;
  let mc = if ok == 1 then vs_entry_p1(fntab, mulc_idx) else 0;
  let is_pow2 = if ok == 1 then (if (mc & (mc - 1)) == 0 then 1 else 0) else 0;
  let d = if ok == 1 then vs_pick_dest(insns, n, fntab, stab) else 0;
  let a = if ok == 1 then vs_reg(insns, n, fntab, stab, other_idx) else 0;
  let kshift = if ok * is_pow2 == 1 then 63 - clz(mc) else 0;
  let _ = if ok * is_pow2 == 1 then em(insns, n, 2332033024 + kshift * 1024 + mr * 65536 + a * 32 + d) else 0;
  let m = if ok * (1 - is_pow2) == 1 then vs_alloc(insns, n, fntab, stab) else 0;
  let _ = if ok * (1 - is_pow2) == 1 then mat_const(insns, n, mc, m) else 0;
  let _ = if ok * (1 - is_pow2) == 1 then em(insns, n, 2600468480 + m * 65536 + a * 1024 + mr * 32 + d) else 0;
  let _ = if ok * (1 - is_pow2) == 1 then vs_mask_free(fntab, m, 14) else 0;
  let _ = if ok == 1 then (let _ = vs_pop(fntab) in (let _ = vs_pop(fntab) in vs_push(insns, n, fntab, stab, 2, d, n[0] - 1))) else 0;
  ok
}

fn vs_try_mulc_sub(insns: [i64], n: [i64], fntab: [i64], stab: [i64], op: i64) -> i64 {
  let w = fntab[5387];
  let is_sub = if op == 3 then 1 else 0;
  let bk = vs_entry_kind(fntab, w - 1);
  let b_mulc = if bk == 6 then 1 else 0;
  let mc = vs_entry_p1(fntab, w - 1);
  let is_pow2 = if b_mulc == 1 then (if (mc & (mc - 1)) == 0 then 1 else 0) else 0;
  let ok = is_sub * b_mulc * is_pow2;
  let mr = vs_entry_p0(fntab, w - 1);
  let d = if ok == 1 then vs_pick_dest(insns, n, fntab, stab) else 0;
  let a = if ok == 1 then vs_reg(insns, n, fntab, stab, w - 2) else 0;
  let k = if ok == 1 then 63 - clz(mc) else 0;
  let _ = if ok == 1 then em(insns, n, 3405774848 + k * 1024 + mr * 65536 + a * 32 + d) else 0;
  let _ = if ok == 1 then (let _ = vs_pop(fntab) in (let _ = vs_pop(fntab) in vs_push(insns, n, fntab, stab, 2, d, n[0] - 1))) else 0;
  ok
}

// A2b step 2 (the K8H loop-carried recurrence). `x * C + K` compiled to a MUL
// and then a separate ADD -- two words, and, worse, TWO links on the
// loop-carried dependency chain (mul, then add) where the Rust twin emits one
// MADD and carries one. vs_try_mulc_add above already fuses, but only while
// the multiply is still PENDING as a MULC tag, and vs_try_mulc_new only ever
// creates that tag for a constant in 1..65535 -- K8H's LCG multiplier
// 6364136223846793005 is far outside it, and after A2's constant hoisting the
// multiplier is a cs REGISTER rather than a CONST tag anyway, so the multiply
// is a plain register-register MUL that vs_binop_reg has already EMITTED by
// the time the `+` is seen.
//
// So fold backwards instead, with the retarget trick vs_bind_reg already uses:
// a REG entry carries `p` = the index of the word that produced it, valid
// exactly when that word's Rd field IS the entry's register. When one of the
// add's two operands is such an entry whose producing word is STILL the last
// word emitted, and that word is a MUL, the add is folded INTO the multiply by
// rewriting that one word's Ra field. MUL *is* MADD with Ra = xzr (31):
// `as`+objdump, $BEBOP_TMP/words.objdump -- mul x0,x0,x0 = 0x9b007c00 =
// 2600500224, madd x0,x0,x0,x0 = 0x9b000000 = 2600468480, i.e. exactly
// 31 * 1024 apart in the Ra field at bits 14:10, and the same base
// vs_try_mulc_add already emits. Zero words emitted here, one word saved, one
// fewer link on the chain. The word is identified by its own bits, not by
// trusting `p`: bits 31:21 == 1240 (the MADD/MSUB family), bit 15 == 0 (MADD,
// not MSUB -- vs_binop_reg's `%` path emits a real MSUB), Ra == 31 (a MUL, not
// an already-fused MADD) and Rd == the entry's register.
//
// The addend must be readable WITHOUT emitting anything -- vs_reg's
// `is_direct` set (REG, an unspilled SYM, a CS temp). If materialising it
// emitted a word, that word would land after the MUL being rewritten and the
// MADD would read the addend register a word before it was written. `p ==
// n[0]-1` already guarantees nothing has been emitted since the MUL, so
// testing the addend's KIND is the whole check; everything else falls through
// to the plain ADD in vs_binop_reg, exactly as before.
fn vs_try_madd(insns: [i64], n: [i64], fntab: [i64], stab: [i64], op: i64) -> i64 {
  let w = fntab[5387];
  let last = n[0] - 1;
  let lidx = if last > 0 then last else 0;
  let word = insns[lidx];
  let mi = if vs_entry_p1(fntab, w - 1) == last then w - 1 else w - 2;
  let oi = if mi == w - 1 then w - 2 else w - 1;
  let mr = vs_entry_p0(fntab, mi);
  let ent_ok = (if last > 0 then 1 else 0) * (if op == 2 then 1 else 0)
    * (if vs_entry_kind(fntab, mi) == 2 then 1 else 0) * (if vs_entry_p1(fntab, mi) == last then 1 else 0);
  let word_ok = (if (word >> 21) == 1240 then 1 else 0) * (if ((word >> 15) & 1) == 0 then 1 else 0)
    * (if ((word >> 10) & 31) == 31 then 1 else 0) * (if (word & 31) == mr then 1 else 0);
  let okind = vs_entry_kind(fntab, oi);
  let op0 = vs_entry_p0(fntab, oi);
  let direct = (if okind == 2 then 1 else 0) + (if okind == 3 then (if op0 < 100 then 1 else 0) else 0) + (if okind == 4 then 1 else 0);
  let ok = ent_ok * word_ok * direct;
  let _ = if ok == 1 then insns[lidx] = word - 31744 + op0 * 1024 else 0;
  let _ = if ok == 1 then (let _ = vs_pop(fntab) in (let _ = vs_pop(fntab) in vs_push(insns, n, fntab, stab, 2, mr, n[0] - 1))) else 0;
  ok
}

fn vs_binop_reg(insns: [i64], n: [i64], fntab: [i64], stab: [i64], op: i64) -> i64 {
  let d = vs_pick_dest(insns, n, fntab, stab);
  let w = fntab[5387];
  let a = vs_reg(insns, n, fntab, stab, w - 2);
  let b = vs_reg(insns, n, fntab, stab, w - 1);
  let is_mod = if op == 11 then 1 else 0;
  let t = if is_mod == 1 then vs_alloc(insns, n, fntab, stab) else 0;
  let _ = if is_mod == 1 then em(insns, n, 2596277248 + b * 65536 + a * 32 + t) else 0;
  let _ = if is_mod == 1 then em(insns, n, 2600501248 + b * 65536 + a * 1024 + t * 32 + d) else 0;
  let _ = if is_mod == 1 then vs_mask_free(fntab, t, 15) else 0;
  let wadd = if op == 2 then 2332033024 else 0;
  let wsub = if op == 3 then 3405774848 else 0;
  let wmul = if op == 4 then 2600500224 else 0;
  let wdiv = if op == 5 then 2596277248 else 0;
  let wand = if op == 12 then 2315255808 else 0;
  let worr = if op == 13 then 2852126720 else 0;
  let weor = if op == 14 then 3388997632 else 0;
  let wshl = if op == 15 then 2596282368 else 0;
  let wshr = if op == 16 then 2596283392 else 0;
  let wasr = if op == 17 then 2596284416 else 0;
  let _ = if is_mod == 0 then em(insns, n, wadd + wsub + wmul + wdiv + wand + worr + weor + wshl + wshr + wasr + b * 65536 + a * 32 + d) else 0;
  let _ = vs_pop(fntab);
  let _ = vs_pop(fntab);
  vs_push(insns, n, fntab, stab, 2, d, n[0] - 1)
}

fn vs_binop(insns: [i64], n: [i64], fntab: [i64], stab: [i64], op: i64) -> i64 {
  let d1 = vs_try_fold(insns, n, fntab, stab, op);
  let d2 = if d1 == 1 then 1 else vs_try_addsub_imm(insns, n, fntab, stab, op);
  let d3 = if d1 + d2 > 0 then 1 else vs_try_mulc_new(insns, n, fntab, stab, op);
  let d4 = if d1 + d2 + d3 > 0 then 1 else vs_try_shift_imm(insns, n, fntab, stab, op);
  let d5 = if d1 + d2 + d3 + d4 > 0 then 1 else vs_try_mulc_add(insns, n, fntab, stab, op);
  let d6 = if d1 + d2 + d3 + d4 + d5 > 0 then 1 else vs_try_mulc_sub(insns, n, fntab, stab, op);
  let d7 = if d1 + d2 + d3 + d4 + d5 + d6 > 0 then 1 else vs_try_madd(insns, n, fntab, stab, op);
  let d8 = if d1 + d2 + d3 + d4 + d5 + d6 + d7 > 0 then 1 else vs_try_ubfx(insns, n, fntab, stab, op);
  let d9 = if d1 + d2 + d3 + d4 + d5 + d6 + d7 + d8 > 0 then 1 else vs_try_and_imm(insns, n, fntab, stab, op);
  let _ = if d1 + d2 + d3 + d4 + d5 + d6 + d7 + d8 + d9 == 0 then vs_binop_reg(insns, n, fntab, stab, op) else 0;
  0
}

// Comparison (spec §2 vs_cmp): both CONST -> CONST(0/1); b CONST fits imm12
// -> cmp x<a>,#c; a CONST (not b) -> mirror (eq/ne unchanged, lt<->gt,
// le<->ge) and cmp x<b>,#c / cmp x<b>,x<a>; else cmp x<a>,x<b>. Consumes a,b,
// pushes FLAGS cond (the REAL AArch64 code). Every case merged into one
// function (each sub-case was a single-caller helper) to stay under the
// bootstrap compiler's 256-fn table cap.
fn vs_cmp(insns: [i64], n: [i64], fntab: [i64], stab: [i64], cond: i64) -> i64 {
  let w = fntab[5387];
  let ak = vs_entry_kind(fntab, w - 2);
  let bk = vs_entry_kind(fntab, w - 1);
  let a0 = vs_entry_p0(fntab, w - 2);
  let b0 = vs_entry_p0(fntab, w - 1);
  let both = (if ak == 1 then 1 else 0) * (if bk == 1 then 1 else 0);
  let v = (if cond == 1 then (if a0 != b0 then 1 else 0) else 0)
    + (if cond == 11 then (if a0 < b0 then 1 else 0) else 0)
    + (if cond == 12 then (if a0 > b0 then 1 else 0) else 0)
    + (if cond == 13 then (if a0 <= b0 then 1 else 0) else 0)
    + (if cond == 10 then (if a0 >= b0 then 1 else 0) else 0)
    + (if cond == 0 then (if a0 == b0 then 1 else 0) else 0);
  let _ = if both == 1 then (let _ = vs_pop(fntab) in (let _ = vs_pop(fntab) in vs_push(insns, n, fntab, stab, 1, v, 0))) else 0;
  let _ = if both == 0 then vs_cmp_emit(insns, n, fntab, stab, cond, ak, bk, b0) else 0;
  n[0]
}

// A26: normalise the top window entry to 0/1 (`v != 0`) for the logical tier.
fn vs_to_bool(insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let _ = vs_push(insns, n, fntab, stab, 1, 0, 0);
  vs_cmp(insns, n, fntab, stab, 1)
}

fn vs_cmp_emit(insns: [i64], n: [i64], fntab: [i64], stab: [i64], cond: i64, ak: i64, bk: i64, b0: i64) -> i64 {
  let w = fntab[5387];
  let b_fits = (if bk == 1 then 1 else 0) * (if b0 >= 0 then 1 else 0) * (if b0 < 4096 then 1 else 0);
  let a_isc = if ak == 1 then 1 else 0;
  let _ = if b_fits == 1 then vs_cmp_imm(insns, n, fntab, stab, cond, b0) else 0;
  let _ = if b_fits == 0 then (if a_isc == 1 then vs_cmp_mirror(insns, n, fntab, stab, cond) else vs_cmp_regs2(insns, n, fntab, stab, cond)) else 0;
  n[0]
}
fn vs_cmp_imm(insns: [i64], n: [i64], fntab: [i64], stab: [i64], cond: i64, c: i64) -> i64 {
  let w = fntab[5387];
  let a = vs_reg(insns, n, fntab, stab, w - 2);
  let _ = em(insns, n, 4043309087 + c * 1024 + a * 32);
  let _ = vs_pop(fntab);
  let _ = vs_pop(fntab);
  vs_push(insns, n, fntab, stab, 7, cond, 0)
}
fn vs_cmp_mirror(insns: [i64], n: [i64], fntab: [i64], stab: [i64], cond: i64) -> i64 {
  let w = fntab[5387];
  let a_val = vs_entry_p0(fntab, w - 2);
  let a_fits = (if a_val >= 0 then 1 else 0) * (if a_val < 4096 then 1 else 0);
  let mcond = (if cond == 1 then 1 else 0) + (if cond == 11 then 12 else 0) + (if cond == 12 then 11 else 0) + (if cond == 13 then 10 else 0) + (if cond == 10 then 13 else 0);
  let b = vs_reg(insns, n, fntab, stab, w - 1);
  let a2 = if a_fits == 0 then vs_reg(insns, n, fntab, stab, w - 2) else 0;
  let _ = if a_fits == 1 then em(insns, n, 4043309087 + a_val * 1024 + b * 32) else em(insns, n, 3942645791 + a2 * 65536 + b * 32);
  let _ = vs_pop(fntab);
  let _ = vs_pop(fntab);
  vs_push(insns, n, fntab, stab, 7, mcond, 0)
}
fn vs_cmp_regs2(insns: [i64], n: [i64], fntab: [i64], stab: [i64], cond: i64) -> i64 {
  let w = fntab[5387];
  let a = vs_reg(insns, n, fntab, stab, w - 2);
  let b = vs_reg(insns, n, fntab, stab, w - 1);
  let _ = em(insns, n, 3942645791 + b * 65536 + a * 32);
  let _ = vs_pop(fntab);
  let _ = vs_pop(fntab);
  vs_push(insns, n, fntab, stab, 7, cond, 0)
}

// Emit a literal: push CONST imm (lazy -- materialises only when the tag
// is consumed by vs_reg/vs_mat/vs_bind/vs_to/vs_binop/vs_cmp).
fn emit_lit(insns: [i64], n: [i64], imm: i64, fntab: [i64], stab: [i64]) -> i64 {
  let _ = vs_push(insns, n, fntab, stab, 1, imm, 0);
  n[0]
}

// Emit a variable reference: push SYM reg (nothing emitted -- lazy). The two
// diagnostics stay: reg = -2 (table full) emits the trap word and pushes a
// dummy CONST 0; reg = -1 (unbound) evicts x0, emits `mov x0,x0` (the "xzr
// load": x0 keeps its value) and pushes REG 0,-1 (not retarget-eligible: p
// does not point at a real producer of the caller's intended value).
fn emit_var(insns: [i64], n: [i64], reg: i64, fntab: [i64], stab: [i64]) -> i64 {
  let is_full = if reg == 0 - 2 then 1 else 0;
  let is_unk = if reg == 0 - 1 then 1 else 0;
  let _ = if is_full == 1 then em(insns, n, 3558866944) else 0;
  let _ = if is_full == 1 then vs_push(insns, n, fntab, stab, 1, 0, 0) else 0;
  let _ = if is_unk == 1 then vs_evict(insns, n, fntab, stab, 0) else 0;
  let _ = if is_unk == 1 then em(insns, n, 2852127712) else 0;
  let _ = if is_unk == 1 then vs_push(insns, n, fntab, stab, 2, 0, 0 - 1) else 0;
  let _ = if is_full + is_unk == 0 then vs_push(insns, n, fntab, stab, 3, reg, 0) else 0;
  n[0]
}

// Read digits, emit their literal; returns the parsed value.
// hex_val: digit value of ch in base 16 (0-9, a-f, A-F), -1 otherwise.
fn hex_val(ch: i64) -> i64 {
  let d = if is_digit(ch) == 1 then ch - 48 else 0 - 1;
  let lo = (if ch >= 97 then 1 else 0) * (if ch <= 102 then 1 else 0);
  let up = (if ch >= 65 then 1 else 0) * (if ch <= 70 then 1 else 0);
  let d = if lo == 1 then ch - 87 else d;
  let d = if up == 1 then ch - 55 else d;
  d
}

// T99 (2026-09-04): `0x..` hex literals are a literal FORM (base 16 in the
// same digit loop), not sugar; bpref.py mirrors the token.
fn read_num_val(s: str, pos: [i64]) -> i64 {
  let strn = slen(s, pos);
  let ch0 = if pos[0] >= strn then 0 else char(s, pos[0]);
  let ch1 = if pos[0] + 1 >= strn then 0 else char(s, pos[0] + 1);
  let is_hex = (if ch0 == 48 then 1 else 0) * (if ch1 == 120 then 1 else 0);
  let base = if is_hex == 1 then 16 else 10;
  let _ = pos[0] = pos[0] + 2 * is_hex;
  let v = 0;
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let hv = if at_end == 1 then 0 - 1 else hex_val(ch);
    let dg = (if hv >= 0 then 1 else 0) * (if hv < base then 1 else 0);
    let v = if dg == 1 then (v * base) + hv else v;
    let adv = if dg == 1 then 1 else 0;
    let _ = pos[0] = pos[0] + adv;
    let done = if dg == 1 then 0 else 1;
    0
  };
  v
}

fn emit_num(s: str, pos: [i64], insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let num_start = pos[0];
  let v = read_num_val(s, pos);
  let strn = slen(s, pos);
  let ch_after = if pos[0] >= strn then 0 else char(s, pos[0]);
  let is_dot = if ch_after == 46 then 1 else 0;
  let _ = if is_dot == 1 then diag_exit(s, pos[0], 111) else 0;
  let _ = emit_lit(insns, n, v, fntab, stab);
  n[0]
}

// Consume one (+ or -) term, then combine the two tags via vs_binop.
fn emit_apply_op(s: str, pos: [i64], insns: [i64], n: [i64], is_minus: i64, stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_term(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let op = if is_minus == 1 then 3 else 2;
  vs_binop(insns, n, fntab, stab, op)
}

// Consume one (* or /) factor, then combine.
// R3.x(a) FIX: the right operand must parse at the BITLVL tier (factor plus
// &,|,^,<<,>> chains), not a bare factor — a bare factor left `<<c` dangling
// in `a*b<<c` and the detached tokens miscompiled to 0/1 garbage (journal
// 1788288190). With bitlvl (which binds tighter than mul by design) the
// expression is well-formed: a*b<<c == a*(b<<c).
fn emit_apply_mul(s: str, pos: [i64], insns: [i64], n: [i64], is_div: i64, stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_factor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let op = if is_div == 1 then 5 else 4;
  vs_binop(insns, n, fntab, stab, op)
}

// Apply a modulo step (a % b): same shape as mul/div; binop opcode 11.
// R3.x(a) FIX: bitlvl-tier right operand, same reasoning as mul/div.
fn emit_apply_mod(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_factor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  vs_binop(insns, n, fntab, stab, 11)
}

// Apply a bitwise operator (op: and=12 orr=13 eor=14 shl=15 shr=16 asr=17)
// between the value already on the window and the next factor. Shifts are
// two-char tokens (adv=2), the rest one char.
fn emit_apply_bits(s: str, pos: [i64], insns: [i64], n: [i64], op: i64, adv: i64, lvl: i64, stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + adv;
  // right operand = the next-tighter tier: lvl 3 (`|`) -> bxor, 2 (`^`) -> band,
  // 1 (`&`) -> shift, 0 (`<<` `>>`) -> expr
  let _ = if lvl == 3 then emit_bxor(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if lvl == 2 then emit_band(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if lvl == 1 then emit_shift(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else emit_expr(s, pos, insns, n, stab, selfname, selfstart, fntab);
  vs_binop(insns, n, fntab, stab, op)
}

// T42(a) 2026-09-04 (decision D5, measured zero fold delta on 85/85 gates):
// C precedence for the bit tier.  cmp > `|` > `^` > `&` > `<<` `>>` > + - > * / %
// bor = bxor ('|' bxor)*
fn emit_bor(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_bxor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = slen(s, pos);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let nch = if pos[0] + 1 >= strn then 0 else char(s, pos[0] + 1);
    let isop = (if ch == 124 then 1 else 0) * (if nch == 124 then 0 else 1);
    let _ = if isop == 1 then emit_apply_bits(s, pos, insns, n, 13, 1, 3, stab, selfname, selfstart, fntab) else 0;
    let done = 1 - isop;
    0
  };
  0
}

// bxor = band ('^' band)*
fn emit_bxor(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_band(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = slen(s, pos);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let isop = if ch == 94 then 1 else 0;
    let _ = if isop == 1 then emit_apply_bits(s, pos, insns, n, 14, 1, 2, stab, selfname, selfstart, fntab) else 0;
    let done = 1 - isop;
    0
  };
  0
}

// band = shift ('&' shift)*
fn emit_band(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_shift(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = slen(s, pos);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let nch = if pos[0] + 1 >= strn then 0 else char(s, pos[0] + 1);
    let isop = (if ch == 38 then 1 else 0) * (if nch == 38 then 0 else 1);
    let _ = if isop == 1 then emit_apply_bits(s, pos, insns, n, 12, 1, 1, stab, selfname, selfstart, fntab) else 0;
    let done = 1 - isop;
    0
  };
  0
}

// shift = expr (('<<'|'>>'|'>>>') expr)*   `>>` is LOGICAL (lsrv), `>>>` is
// ARITHMETIC (asrv) — decision D9(5) 2026-09-04: R3.x(b) is documented
// semantics, not a ban; bpref.py mirrors both; gate c32_asr.
fn emit_shift(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_expr(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = slen(s, pos);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let nch = if pos[0] + 1 >= strn then 0 else char(s, pos[0] + 1);
    let nch2 = if pos[0] + 2 >= strn then 0 else char(s, pos[0] + 2);
    let isshl = (if ch == 60 then 1 else 0) * (if nch == 60 then 1 else 0);
    let isshr2 = (if ch == 62 then 1 else 0) * (if nch == 62 then 1 else 0);
    let isasr = isshr2 * (if nch2 == 62 then 1 else 0);
    let isshr = isshr2 - isasr;
    let isop = isshl + isshr + isasr;
    let op = isshl * 15 + isshr * 16 + isasr * 17;
    let adv = 2 + isasr;
    let _ = if isop == 1 then emit_apply_bits(s, pos, insns, n, op, adv, 0, stab, selfname, selfstart, fntab) else 0;
    let done = 1 - isop;
    0
  };
  0
}

// Consume one comparison operator + right operand, then combine via vs_cmp.
// `cond` is the REAL AArch64 condition (eq=0 ne=1 ge=10 lt=11 gt=12 le=13).
fn emit_apply_cmp(s: str, pos: [i64], insns: [i64], n: [i64], cond: i64, adv: i64, stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + adv;
  let _ = emit_bor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  vs_cmp(insns, n, fntab, stab, cond)
}

// cmp = bor (('=='|'!='|'<'|'>'|'<='|'>=') bor)*
fn emit_rel(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_bor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = slen(s, pos);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let e1 = if pos[0] + 1 >= strn then 1 else 0;
    let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
    let is_eq = if ch == 61 then 1 else 0;
    let is_bang = if ch == 33 then 1 else 0;
    let is_lt = if ch == 60 then 1 else 0;
    let is_gt = if ch == 62 then 1 else 0;
    let is_e2 = if ch1 == 61 then 1 else 0;
    let is_eqop = is_eq * is_e2;
    let is_neop = is_bang * is_e2;
    let not_e2 = 1 - is_e2;
    let is_ltop = is_lt * not_e2;
    let is_gtop = is_gt * not_e2;
    let is_leop = is_lt * is_e2;
    let is_geop = is_gt * is_e2;
    let is_op = is_eqop + is_neop + is_ltop + is_gtop + is_leop + is_geop;
    let cond = is_neop * 1 + is_ltop * 11 + is_gtop * 12 + is_leop * 13 + is_geop * 10;
    let avv = 1 + is_eqop + is_neop + is_leop + is_geop;
    let _ = if is_op == 1 then emit_apply_cmp(s, pos, insns, n, cond, avv, stab, selfname, selfstart, fntab) else 0;
    let done = if is_op == 1 then 0 else 1;
    0
  };
  0
}

// A26: land = rel ('&&' rel)*   -- logical AND, value 0/1, NO short circuit
// (T125 pinned non-short-circuit semantics; that half is unchanged).
fn emit_land(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_rel(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = slen(s, pos);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let nch = if pos[0] + 1 >= strn then 0 else char(s, pos[0] + 1);
    let isop = (if ch == 38 then 1 else 0) * (if nch == 38 then 1 else 0);
    let _ = if isop == 1 then emit_apply_land(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let done = 1 - isop;
    0
  };
  0
}

fn emit_apply_land(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = vs_to_bool(insns, n, fntab, stab);
  let _ = pos[0] = pos[0] + 2;
  let _ = emit_rel(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = vs_to_bool(insns, n, fntab, stab);
  vs_binop(insns, n, fntab, stab, 12)
}

// A26: cmp = land ('||' land)*  -- this is the ENTRY point of the expression
// grammar; the old relational tier is now `emit_rel`. Precedence is C's:
// || < && < cmp < | < ^ < & < shifts < + - < * / %.
fn emit_cmp(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_land(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = slen(s, pos);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let nch = if pos[0] + 1 >= strn then 0 else char(s, pos[0] + 1);
    let isop = (if ch == 124 then 1 else 0) * (if nch == 124 then 1 else 0);
    let _ = if isop == 1 then emit_apply_lor(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let done = 1 - isop;
    0
  };
  0
}

fn emit_apply_lor(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = vs_to_bool(insns, n, fntab, stab);
  let _ = pos[0] = pos[0] + 2;
  let _ = emit_land(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = vs_to_bool(insns, n, fntab, stab);
  vs_binop(insns, n, fntab, stab, 13)
}

// expr = term ((+|-) term)*
fn emit_expr(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_term(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = slen(s, pos);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_plus = if ch == 43 then 1 else 0;
    let is_minus = if ch == 45 then 1 else 0;
    // T42(d) 2026-09-04: `++` (string concat) is NOT in the surface and there
    // is no third state -- it used to compile silently to a crashing binary;
    // now the compiler exits 96 (see the exit-code table at emit_paren).
    let e1 = if pos[0] + 1 >= strn then 1 else 0;
    let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
    let is_pp = is_plus * (if ch1 == 43 then 1 else 0);
    let _ = if is_pp == 1 then diag_exit(s, pos[0], 96) else 0;
    let is_op = is_plus + is_minus;
    let _ = if is_op == 1 then emit_apply_op(s, pos, insns, n, is_minus, stab, selfname, selfstart, fntab) else 0;
    let done = if is_op == 1 then 0 else 1;
    0
  };
  0
}

// term = factor ((*|/|%) factor)*
fn emit_term(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_factor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = slen(s, pos);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_mul = if ch == 42 then 1 else 0;
    let is_div = if ch == 47 then 1 else 0;
    let is_mod = if ch == 37 then 1 else 0;
    let is_op = is_mul + is_div + is_mod;
    let _ = if is_mod == 1 then emit_apply_mod(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let _ = if is_mul + is_div == 1 then emit_apply_mul(s, pos, insns, n, is_div, stab, selfname, selfstart, fntab) else 0;
    let done = if is_op == 1 then 0 else 1;
    0
  };
  0
}

// Compile-time trap exit codes of bebop.bin (the seed loader owns 90-94:
// 90 open, 91 read, 92 mmap, 94 fail -- seed/seed.S).
//
// F2 prerequisite (2026-09-09) -- THE SPACE IS PARTITIONED, and a code outside
// these two bands is a bug:
//   < 99 .. 104   user-facing diagnostics (this table). 99..104 are grandfathered
//                 because docs/TRAPS.md and construct_parity.sh's COMPILEFAIL
//                 expectations already pin them; everything NEW goes below 99.
//   201           compiler self-check, ONE code, with `compiler self-check
//                 <kind>.<site>` on stderr (selfcheck_exit). It replaces the old
//                 `99 + site` / `100 + site` / `119 + site` / `120 + site`
//                 families, which spanned 99..140 and could collide with any
//                 diagnostic in this table, and the bare 102/104/105/106 and the
//                 diag_exit 103/107 boundary checks.
//   FREE below 99, verified against this table + docs/TRAPS.md + the emitted
//   brk traps 2026-09-09: 65-79, 84, 85, 86 (18 codes). NOT 93: bebop.bp's own
//   line above gives 90-94 to the seed loader as a block, and 93 being unassigned
//   inside it is not the same as it being ours. NOT 81: retired by A6, not free.
//   102 and 104 are no longer ALIASES -- each now means only its diagnostic:
//   95  expected `)` (emit_paren) or `in` (emit_let_plain / emit_let_chain)
//   96  `++` in an expression: string concat is not in the surface (T42(d))
//   97  fn body without a tail expression (compile_fn_at; DIVERGE-81/128)
//   98  more than 17 `return` / 18 pending `break` in one fn (T99 lists)
//   99  fn named like a keyword or builtin (T122)
//   89  let binding while a call temp is live (REGISTER-MODEL-BLUEPRINT §1.1:
//       the register sym_bind needs collides with a live cs temp -- bind the
//       call result with a let first), S+tsp > 64 (§5), or fn table full
//       (512, A2 step 0 2026-09-06/07: compile_program_offs/cli_compile's own
//       fnames/fpos/sizes/starts/offs arrays are fixed-size (zeros(784) since the
//       2026-09-09 cap raise to 560 -- ALL FIVE of the `offs` sites had to widen,
//       including cli_compile's, which is the ordinary `bebop.bin compile` path);
//       silently
//       tolerating a 513th fn overflowed starts[512] into the next arena
//       cell and shifted every later word by one -- SIGILL, T96-class bug),
//       or expression nesting / pending operands > 512 (vs_push: the
//       window's 512-entry list at fntab[3700..4335] is full)
// Runtime capacity traps (T118, exit_group from the compiled program):
//   80  arena exhausted (zeros or an aggregate literal past x28; ROADMAP A6
//       2026-09-08 folded the former exit 81 into this one)   [81 DELETED: was
//       frame heap exhausted (x14 past
//   the 16 KiB frame)                         82  stack overflow (guard, T118 b)
// A trap fires before the output is opened (cli_compile), so no .bin is
// produced; bench/vs_rust/construct_parity.sh gates them as
// EXPECT=COMPILEFAIL:<code> from bench/parity_constructs/neg/.
// Consume ( expr ). T42 2026-09-04: the closing delimiter is CHECKED, not
// assumed -- a statement sequence inside parens (`( let i = 0; while ... ; r )`,
// the attic "if-while" shape) is outside the surface (`( cmp )`) and used to
// compile silently to garbage; now the compiler exits 95 (expected `)`).
// A21 step 2: the `, e1[, e2]` tail of a tuple in return / fn-tail position.
// Delivers k values to x0..x(k-1) through vs_deliver -- the SAME parallel move
// every builtin's operand list already uses, so there is NO new callee machinery --
// and then pushes ONE `REG x0` entry, so from the window's point of view a tuple is
// indistinguishable from an ordinary single-value expression. That is what makes the
// two legal positions need no code of their own: `return`'s own vs_deliver(1) is a
// no-op on a REG-x0 top, the fn tail's vs_to(x0)/vs_pop is a no-op, and a non-final
// tuple item is drained by emit_body's ordinary non-final-item pop.
// x1/x2 SURVIVE to the `ret` because emit_epilogue_sized restores only x19..x26 /
// sp / fp / lr and nothing emitted between here and the branch allocates a register.
fn emit_tuple_rest(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let tpos = pos[0];
  let k = [1];
  let go = 1;
  while go == 1 {
    let _ = pos[0] = pos[0] + 1;
    let _ = skip_ws(s, pos);
    let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
    let _ = k[0] = k[0] + 1;
    let _ = skip_ws(s, pos);
    let cc = if pos[0] >= slen(s, pos) then 0 else char(s, pos[0]);
    let go = (if cc == 44 then 1 else 0) * (if k[0] < 3 then 1 else 0);
    0
  };
  let want = fn_ret_arity(s, selfname, fntab, slen(s, pos));
  let _ = if k[0] == want then 0 else diag_exit(s, tpos, 118);
  let _ = vs_deliver(insns, n, fntab, stab, k[0]);
  vs_push(insns, n, fntab, stab, 2, 0, 0 - 1)
}

fn emit_paren(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  // A21 step 2: this paren is a TUPLE only when it is the very paren the enclosing
  // statement offered as a tuple position -- fntab[7100], set by emit_return_core
  // for `return (` and by emit_body for an item-initial `(` (the fn's own tail
  // expression is one of those). So `let t = (a, b)` keeps exit 95, which is what
  // A21 "IS NOT #1" asks for. Cleared immediately: in `((a), b)` the inner paren
  // must not inherit the offer.
  let is_tp = if pos[0] == fntab[7100] then 1 else 0;
  let _ = fntab[7100] = 0 - 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let cp = if pos[0] >= slen(s, pos) then 0 else char(s, pos[0]);
  let is_tup = is_tp * (if cp == 44 then 1 else 0);
  let _ = if is_tup == 1 then emit_tuple_rest(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
  let cp2 = if is_tup == 1 then (if pos[0] >= slen(s, pos) then 0 else char(s, pos[0])) else cp;
  let _ = if cp2 == 41 then 0 else diag_exit(s, pos[0], 95);
  let _ = pos[0] = pos[0] + 1;
  n[0]
}

// Branch-away-to-else placeholder for the tag on top of the window: a FLAGS
// tag branches directly on its INVERSE condition (no cset -- eq/ne/ge/lt/
// gt/le come in adjacent pairs that differ by their low bit, so `cond ^ 1`
// is the real AArch64 code of the negation); any other tag is materialised
// into a register first and takes the real `cbz` branch.
fn vs_cond_branch(insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let top = fntab[5387] - 1;
  if vs_entry_kind(fntab, top) == 7 then 1409286144 + (vs_entry_p0(fntab, top) ^ 1) else vs_cond_branch_reg(insns, n, fntab, stab, top)
}
fn vs_cond_branch_reg(insns: [i64], n: [i64], fntab: [i64], stab: [i64], top: i64) -> i64 {
  3019898880 + vs_reg(insns, n, fntab, stab, top)
}

// Continue-the-loop placeholder for a `while` bottom test: a FLAGS tag
// branches on its OWN (non-inverted) condition directly (b.<c>, backward,
// taken exactly when the loop should continue); any other tag materialises
// into a register and takes `cbnz`.
fn vs_loop_branch(insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let top = fntab[5387] - 1;
  if vs_entry_kind(fntab, top) == 7 then 1409286144 + vs_entry_p0(fntab, top) else vs_loop_branch_reg(insns, n, fntab, stab, top)
}
fn vs_loop_branch_reg(insns: [i64], n: [i64], fntab: [i64], stab: [i64], top: i64) -> i64 {
  3036676096 + vs_reg(insns, n, fntab, stab, top)
}

// Conditional `if c then a else b`: evaluate cond, park the deeper window
// (path-independent for both arms), branch away from the top tag, allocate
// the join register `d` BEFORE either arm, then run each arm from the SAME
// saved window/cs/slot state and materialise its value into `d` -- the join
// owns the one result tag, not each arm.
// A2 commit 1 (§3 "Commit 1: csel"): dispatch on a text pre-scan of both
// arms, done ONCE here so the planning and emission passes -- which compile
// this exact source twice -- see identical text at an identical `pos` and
// always agree. Neither scanner mutates `pos` (both take value copies), so
// the real compile below (branch or csel) starts from the same position
// regardless of which path the pre-scan chose.
fn emit_cond(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 2;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let strn = slen(s, pos);
  let peek = [pos[0], strn];
  let _ = skip_ws(s, peek);
  let _ = peek[0] = peek[0] + 4;
  let then_start = peek[0];
  let then_end = arm_end(s, then_start, strn);
  let peek2 = [then_end, strn];
  let _ = skip_ws(s, peek2);
  let else_start = peek2[0] + 4;
  let else_end = arm_end(s, else_start, strn);
  let pure = arm_is_pure(s, then_start, then_end, strn) * arm_is_pure(s, else_start, else_end, strn);
  // ROADMAP A14 (2026-09-07): the pre-`if` park moved down here, below the
  // (code-free, pos-free) arm pre-scan, so it can see `pure`. A csel arm binds
  // nothing by construction (kw_bad_at rejects let/if/while/match/return/break
  // and any call) and keeps the cheaper cs parks; a BRANCH arm can bind, so
  // every value that must survive the join goes to a temp slot instead.
  let _ = fntab[5403] = 1 - pure;
  let _ = vs_park(insns, n, fntab, stab, 1);
  let _ = if pure == 0 then vs_span_to_slots(insns, n, fntab, stab, 1) else 0;
  let _ = fntab[5403] = 0;
  if pure == 1 then emit_cond_csel(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else emit_cond_branch(s, pos, insns, n, stab, selfname, selfstart, fntab)
}

// A2 commit 1: csel path for two pure arms. `condw` is the cond entry's
// window index, already compiled+parked by emit_cond above -- it stays
// BURIED below the arms' own entries for the whole compile (§1.2's "FLAGS
// only at the top" rule is suspended for exactly this window via
// fntab[5290], vs_settle_flags). Purity guarantees neither arm emits a
// flag-setting word (cmp, T118 trap, `!`, a call), so nothing here can
// corrupt the buried cond entry.
fn emit_cond_csel(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let condw = fntab[5387] - 1;
  let _ = fntab[5290] = 1;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 4;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let ta = vs_reg(insns, n, fntab, stab, fntab[5387] - 1);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 4;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let tb = vs_reg(insns, n, fntab, stab, fntab[5387] - 1);
  let _ = fntab[5290] = 0;
  let d = vs_pick_dest(insns, n, fntab, stab);
  let ck = vs_entry_kind(fntab, condw);
  // cond wasn't (or no longer is) a FLAGS tag -- materialise it into a
  // register and derive FLAGS from `cmp xr,#0` (ne = nonzero = true,
  // matching every other truthiness test in the register model), inlined
  // rather than a helper fn (a separate `emit_cond_flags(insns,n,fntab,stab,
  // condw)` call here was a real, reproducible self-host miscompile: the
  // whole-program self-compile traps exit 107 deep in an unrelated later
  // function whenever this exact logic is a genuinely-called, separate
  // top-level fn -- confirmed independent of that fn's name, its exact
  // source position, and total fn count; disappears the moment the same
  // statements are inlined at the one call site instead. Root cause not
  // isolated further (open item); the extra `bl`/`ret` this avoids is also
  // strictly fewer words. Frees the register's own mask/cs bit afterward
  // exactly like vs_not_reg (bebop.bp, the `!` operator) -- the kind is
  // read AFTER vs_reg so a freshly materialised CONST/SLOT/MULC temp (now
  // kind REG) is freed, while a live SYM (a symbol's own permanent
  // register) is correctly left alone.
  let c = if ck == 7 then vs_entry_p0(fntab, condw) else (let cfr = vs_reg(insns, n, fntab, stab, condw) in (let cfak = vs_entry_kind(fntab, condw) in (let _ = em(insns, n, 4043309087 + cfr * 32) in (let _ = if cfak == 2 then vs_mask_free(fntab, cfr, 22) else 0 in (let _ = if cfak == 4 then vs_cs_free(fntab, cfr, 23) else 0 in 1)))));
  // csel xd,xn,xm,<cond> (as+objdump derived, $OUT/words.objdump): base
  // 2592079872 = 0x9A800000, + Rm*65536 + cond*4096 + Rn*32 + Rd.
  let _ = em(insns, n, 2592079872 + tb * 65536 + c * 4096 + ta * 32 + d);
  let _ = vs_pop(fntab);
  let _ = vs_pop(fntab);
  let _ = vs_pop(fntab);
  vs_push(insns, n, fntab, stab, 2, d, n[0] - 1)
}

// Branch path (byte-identical to pre-A2 emit_cond): an impure arm -- a call,
// `let`, `while`, nested `if`, array literal, string literal, struct/enum
// ctor, or a comparison/`!` that would clobber the flags -- stays here.
fn emit_cond_branch(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let bw = vs_cond_branch(insns, n, fntab, stab);
  let p1 = n[0];
  let _ = em(insns, n, bw);
  let _ = vs_pop(fntab);
  let d = vs_alloc(insns, n, fntab, stab);
  let sw = fntab[5387];
  let smask = fntab[5388];
  let scs = fntab[5389];
  let sslot = fntab[5390];
  // BUGFIX (A4 fuzz DIVERGE hunt, 2026-09-07): fntab[5402] marks "we are
  // now compiling an if-arm rooted at window index `sw`" so check_reg_collision
  // can tell a PRE-EXISTING entry (index < sw, alive before this `if`, whose
  // physical location must be valid on BOTH arms) from an arm-local one --
  // relocating a pre-existing entry INSIDE one arm only (the old behaviour)
  // emits the relocation `mov` as part of that arm's OWN conditionally-
  // executed code, so the other arm (and the shared code after the join)
  // silently reads a location nothing ever wrote on that path. See
  // check_reg_collision's own comment for the fix (exit 89, not a relocate).
  let saved_arm_base = fntab[5402];
  let _ = fntab[5402] = sw;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 4;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = vs_to(insns, n, fntab, stab, d);
  let _ = vs_pop(fntab);
  let _ = fntab[5402] = saved_arm_base;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 4;
  let p2 = n[0];
  let _ = em(insns, n, 335544320);
  let else_pos = n[0];
  let _ = insns[p1] = insns[p1] + (else_pos - p1) * 32;
  let _ = fntab[5387] = sw;
  let _ = fntab[5388] = smask;
  let _ = fntab[5389] = scs;
  let _ = fntab[5390] = sslot;
  let _ = fntab[5402] = sw;
  // BUGFIX (2026-09-06, bug 9 hunt / exit-101 mid-expression): `d` used to
  // be held as a bare register across the ENTIRE else-branch compile,
  // invisible to vs_park_deepest (no window entry represents it) -- a
  // long `if..else if..else if..` dispatch chain (e.g. emit_call_or_ctor's
  // 30+ branches) nests one emit_cond per level, each holding its own `d`,
  // and once the nesting exceeds the 8 physical registers vs_alloc has
  // nothing left to park and dies at exit 101. Fix: push `d` as a REAL,
  // parkable window entry before compiling the else-branch, so a deeply
  // nested chain can evict it (to a cs register, then a memory slot) via
  // the existing vs_park_deepest path exactly like any other value.
  let dix = fntab[5387];
  let _ = vs_push(insns, n, fntab, stab, 2, d, 0 - 1);
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = fntab[5402] = saved_arm_base;
  // The then-branch's code, already emitted above, is hard-coded to leave
  // its result in `d` -- so the else-branch's result must converge on
  // that exact same physical register regardless of which runtime path
  // executes. Do NOT force dix into `d` first: dix may not even be the
  // current occupant of `d` (something else, e.g. the else-branch's own
  // top-of-window value, may already sit there after a deeply nested
  // compile), and blindly moving dix there would clobber it. vs_to
  // already evicts whichever entry currently owns `d` (dix, if it's
  // still there) before materialising the else-branch's real result.
  let _ = vs_to(insns, n, fntab, stab, d);
  // BUGFIX: vs_to's internal vs_evict (triggered whenever dix's own claim
  // on `d` conflicts with the else-branch's top-of-window value) relocates
  // dix away and FREES `d`'s bit as part of that move, but neither
  // vs_evict nor vs_mat ever re-takes it for the value vs_to just placed
  // there -- every OTHER vs_to(d) call site never observes this because
  // its `d` is always exclusively pre-reserved (fresh from vs_alloc,
  // never freed elsewhere), so eviction is always a no-op there. Here it
  // is not a no-op, so `d` must be explicitly re-claimed or the mask
  // thinks a register the else-branch's result now legitimately occupies
  // is free.
  let _ = vs_mask_take(fntab, d, 20);
  let ek = vs_entry_kind(fntab, dix);
  let ep0 = vs_entry_p0(fntab, dix);
  let _ = if (ek == 2) * (if ep0 < 8 then 1 else 0) == 1 then vs_mask_free(fntab, ep0, 19) else 0;
  let _ = if ek == 4 then vs_cs_free(fntab, ep0, 10) else 0;
  let topk = vs_entry_kind(fntab, fntab[5387] - 1);
  let topp0 = vs_entry_p0(fntab, fntab[5387] - 1);
  // transplant the else-branch's (now `d`-resident) result down into dix's
  // slot, then drop the now-duplicate top slot WITHOUT vs_pop's free --
  // ownership of `d` is moving to dix's slot, not being released.
  // BUGFIX: p1 is forced to -1 (never a valid n[0]-1), NOT carried over from
  // the else-branch's own top entry. p1 == n[0]-1 is vs_bind_reg's "this
  // register was produced by the LAST emitted instruction, retarget that
  // instruction's own Rd field instead of emitting a mov" optimisation --
  // correct for a plain value, but an if-expression's result was produced
  // by ONE OF TWO instructions (whichever branch runs), and only the
  // textually-last one (the else-branch's) is ever "the last instruction".
  // Retargeting only that one leaves the then-branch's own materialisation
  // still writing its old register, which nothing then reads -- the
  // original design used p1=-1 here for exactly this reason (a plain
  // vs_push(...,d,0-1) at the end); the transplant must keep that sentinel.
  let _ = vs_set_entry(fntab, dix, topk, topp0, 0 - 1);
  let _ = fntab[5387] = fntab[5387] - 1;
  let end_pos = n[0];
  let _ = insns[p2] = 335544320 + (end_pos - p2);
  // the unified result is already on the window at index dix (transplanted
  // above) -- no further push here (the old unconditional `vs_push(d)`
  // would both duplicate the entry and reference the stale pre-else `d`).
  0
}

// Emit `let name = value in body` (expression form): bind name to a register,
// evaluate body as the result. The statement form (`let x = v;`) is handled by
// emit_body; this handles the `in` form nested inside if/while/match branches.
// R3.x(c) FIX: the chained discard-assign `let _ = NAME = RHS in body` lowers
// to NAME <- RHS (mirroring emit_let_stmt's chain); the old code parsed only
// NAME, then skipped two chars assuming "in" — landing inside the RHS and
// silently never storing (the loop-shaped conditional-store defect, journal
// 1788288197). The array-store chain `let _ = arr[i] = v in ...` already
// worked through emit_array_index; this adds the plain-name twin via a
// separate helper (if/else dispatch on a pre-computed flag, no consumption
// before the decision).
fn emit_let_in(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 3;
  let _ = skip_ws(s, pos);
  let npos = pos[0];
  let name = read_ident(s, pos);
  let reg = sym_bind(s, stab, name, npos);
  let _ = check_reg_collision(s, insns, n, fntab, stab, reg, npos);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  // F3: same length publication as emit_let_stmt (see rhs_len_p1).
  let lk = if reg >= 19 then (if reg <= 26 then reg - 19 else 0 - 1) else (if reg >= 100 then reg - 92 else 0 - 1);
  let _ = if lk >= 0 then fntab[5410 + lk] = rhs_len_p1(s, pos[0], slen(s, pos)) else 0;
  // chain detection: ident followed by '=' (but not '=='/'=>')
  let strq = slen(s, pos);
  let c0 = if pos[0] >= strq then 0 else char(s, pos[0]);
  let is_id = is_alpha(c0);
  let wq = pos[0];
  let go = is_id;
  while go == 1 {
    let cc = if wq >= strq then 0 else char(s, wq);
    let ga = is_alpha(cc);
    let gd = (if cc >= 48 then 1 else 0) * (if cc <= 57 then 1 else 0);
    let gu = if cc == 95 then 1 else 0;
    let adv = ga + gd + gu;
    let wq = wq + adv;
    let go = adv;
    0
  };
  let wq2 = if wq >= strq then wq else wq + ceq(s, wq, 32);
  let cw = if wq2 >= strq then 0 else char(s, wq2);
  let nw = if wq2 + 1 >= strq then 0 else char(s, wq2 + 1);
  let is_chain = is_id * (if cw == 61 then 1 else 0) * (if nw == 61 then 0 else 1);
  let _ = if is_chain == 1 then emit_let_chain(s, pos, insns, n, stab, selfname, selfstart, fntab) else emit_let_plain(s, pos, insns, n, stab, selfname, selfstart, fntab, reg, name);
  n[0]
}

// Plain `let x = RHS in body`: bind x to the RHS value (or discard when x is `_`).
fn emit_let_plain(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], reg: i64, name: i64) -> i64 {
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let ci = if pos[0] >= slen(s, pos) then 0 else char(s, pos[0]);
  // `in` or `;` (T42 2026-09-04: the corpus' `(let t = e; body)` form
  // only ever worked because `; ` was skipped as if it were `in`; make it
  // a real synonym instead of trapping it -- ntt/fno regression at 3eeb007)
  let is_in = if ci == 105 then 1 else 0;
  let is_semi = if ci == 59 then 1 else 0;
  let _ = if is_in + is_semi > 0 then 0 else diag_exit(s, pos[0], 95);
  let _ = pos[0] = pos[0] + 1 + is_in;
  let _ = if name == 95 then vs_pop(fntab) else vs_bind(insns, n, fntab, stab, reg);
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  n[0]
}

// Chained `let _ = NAME = RHS in body`: NAME <- RHS, discard.
fn emit_let_chain(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let tnpos = pos[0];
  let tname = read_ident(s, pos);
  let treg = sym_lookup(s, stab, tname, tnpos);
  let _ = if treg < 0 then diag_exit(s, tnpos, 101) else 0;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let ci = if pos[0] >= slen(s, pos) then 0 else char(s, pos[0]);
  // `in` or `;` (T42 2026-09-04: the corpus' `(let t = e; body)` form
  // only ever worked because `; ` was skipped as if it were `in`; make it
  // a real synonym instead of trapping it -- ntt/fno regression at 3eeb007)
  let is_in = if ci == 105 then 1 else 0;
  let is_semi = if ci == 59 then 1 else 0;
  let _ = if is_in + is_semi > 0 then 0 else diag_exit(s, pos[0], 95);
  let _ = pos[0] = pos[0] + 1 + is_in;
  let _ = vs_bind(insns, n, fntab, stab, treg);
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  n[0]
}

// R3.x(d) FIX: real string-literal codegen. The literal's BYTES ride in a
// data section appended after the code words (compile_program_to lays it out
// and records per-literal data word offsets in fntab[6000+i], code length in
// R3.x(d) FIX: real string-literal codegen. The literal's BYTES ride in a
// data section appended after the code words (compile_program_to lays it out
// and records per-literal data word offsets in fntab[6000+i], code length in
// fntab[5551], cursor in fntab[5552]). Emit `adr x0, #imm` with
// imm = (dw - cur)*4: the seed loader mmaps the whole .bin at the code base,
// so PC = base + cur*4 and the data cell sits at base + dw*4 — the address
// is a real pointer into the mapped image. Was: placeholder mov x0,#0 that
// segfaulted str_len/char (journal 1788288206).
fn emit_str(s: str, pos: [i64], insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let li = fntab[5552];
  let L = fntab[5551];
  let dw = fntab[6000 + li];
  let d = vs_alloc(insns, n, fntab, stab);
  let cur = n[0];
  let imm21 = dw - cur;
  let _ = em(insns, n, 268435456 + imm21 * 32 + d);
  let _ = fntab[5552] = li + 1;
  let _ = skip_string(s, pos);
  vs_push(insns, n, fntab, stab, 2, d, n[0] - 1)
}

// Emit an array literal [e0, e1, ...]: evaluate the elements left to right
// (each stays on the stack), THEN mov x0,x14; add x14,#8n, and pop them into
// [x0+i*8] from the last down. Immediate-offset stores, so valid for <=511
// elements (imm12). T42 2026-09-04 (fuzz DIVERGE-2131 shrunk): the old order
// stored each element at [x14+i*8] BEFORE the bump, so a nested literal or
// an allocating call inside an element reused the same x14 cells and
// silently overwrote the outer elements. Same word count, no extra pushes.
fn emit_array_lit(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let strn = slen(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let cnt = 0;
  let done = 0;
  while done == 0 {
    // progress guard: a malformed element (e.g. "[+4)") must not spin forever
    let before = pos[0];
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_rb = if ch == 93 then 1 else 0;
    let _ = if is_rb == 0 then emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let cnt = if is_rb == 0 then cnt + 1 else cnt;
    let _ = skip_ws(s, pos);
    let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch2 == 44 then 1 else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let stuck = if pos[0] > before then 0 else 1;
    let done = if is_rb + at_end >= 1 then 1 else stuck;
    0
  };
  let _ = pos[0] = pos[0] + 1;
  // Deviation from the spec's allocate-first ordering (VERDICT: open item):
  // arrays keep evaluate-then-allocate to avoid a fragile lexical pre-count
  // of the element list (struct/enum field counts are known up front from
  // the declaration/grammar; an array literal's count is not, short of a
  // second parse). The elements still ride the window/cs/slot bookkeeping
  // -- never [sp] -- so the push_words == 0 invariant is unaffected.
  // BUGFIX (A4 fuzz DIVERGE hunt, 2026-09-07): if the LAST element is a
  // raw comparison (a FLAGS tag -- per §1.2 only the TOP window entry may
  // ever be unmaterialised FLAGS, and vs_park below only touches entries
  // BELOW the kept `cnt` elements, never this one), it sits unconsumed
  // while the T118 frame-heap capacity trap check emitted a few words down
  // (`cmp x14,x2 ; b.ls ...`) clobbers NZCV -- the element-fill loop's
  // later `vs_reg`/`vs_mat` then `cset`s off the TRAP CHECK's flags, not
  // the comparison's. Settle it into a real register first (repro:
  // `let a0=[0, i0<i1]; a0[1]` with i0>i1 -- oracle 0, was compiling to 1).
  let _ = vs_settle_flags(insns, n, fntab, stab);
  let _ = vs_park(insns, n, fntab, stab, cnt);
  let _ = vs_evict(insns, n, fntab, stab, 0);
  let _ = vs_mask_take(fntab, 0, 16);
  let _ = em(insns, n, 2853897184);
  let _ = em(insns, n, 2432696320 + cnt * 8192 + 891);
  // ROADMAP A6 (2026-09-08): aggregates allocate at the ARENA CURSOR x27, the
  // same bump `zeros` uses, and inherit its capacity trap -- cmp x27,x28 ;
  // b.ls +2 ; brk #80. The T118 frame-heap trap (brk #81) and its helper
  // emit_heap_trap are DELETED: there is no frame heap any more, so exit 81
  // cannot be reached and the class is gone rather than merely under budget.
  let _ = em(insns, n, 3944481663);
  let _ = em(insns, n, 1409286217);
  let _ = em(insns, n, 3558869504);
  let k = [cnt];
  while k[0] > 0 {
    let _ = k[0] = k[0] - 1;
    let r = vs_reg(insns, n, fntab, stab, fntab[5387] - 1);
    let _ = em(insns, n, 4177526784 + k[0] * 1024 + r);
    let _ = vs_pop(fntab);
    0
  };
  // A5 step 1b: the elements were filled through the ADDRESS in x0; the VALUE
  // handed to the window is the cell INDEX (sub x0,x0,x17 ; lsr x0,x0,#3).
  let _ = em(insns, n, 3406888960);
  let _ = em(insns, n, 3544448000);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// Array get: base + index tags already on the window (base pushed first).
// index CONST c<4096 -> ldr x<d>,[x<base>,#c*8]; else ldr x<d>,[x<base>,x<idx>,lsl#3].
fn emit_array_get(insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let w = fntab[5387];
  let idxk = vs_entry_kind(fntab, w - 1);
  let idxc = vs_entry_p0(fntab, w - 1);
  let is_cimm = (if idxk == 1 then 1 else 0) * (if idxc >= 0 then 1 else 0) * (if idxc < 4096 then 1 else 0);
  let d = vs_pick_dest(insns, n, fntab, stab);
  let base = vs_reg(insns, n, fntab, stab, w - 2);
  let _ = if is_cimm == 1 then vs_array_get_imm(insns, n, base, idxc, d) else vs_array_get_reg(insns, n, fntab, stab, base, w - 1, d);
  let _ = vs_pop(fntab);
  let _ = vs_pop(fntab);
  vs_push(insns, n, fntab, stab, 2, d, n[0] - 1)
}
// A5 step 1b: the base is a cell INDEX, so the effective index is base+idx and the
// load is `ldr xd,[x17,xt,lsl #3]` (4167072288 = 0xf8607a20, Rn=x17). The scratch t
// is the DESTINATION register: `add xd,xbase,xidx` reads both operands before it
// writes xd, so d may alias base or idx safely and no vs_alloc is needed (which
// would risk parking one of the two live window entries). Index 0 needs no add.
fn vs_array_get_imm(insns: [i64], n: [i64], base: i64, idxc: i64, d: i64) -> i64 {
  let _ = if idxc > 0 then em(insns, n, 2432696320 + idxc * 1024 + base * 32 + d) else 0;
  let b = if idxc > 0 then d else base;
  em(insns, n, 4167072288 + b * 65536 + d)
}
fn vs_array_get_reg(insns: [i64], n: [i64], fntab: [i64], stab: [i64], base: i64, idxidx: i64, d: i64) -> i64 {
  let idx = vs_reg(insns, n, fntab, stab, idxidx);
  let _ = em(insns, n, 2332033024 + idx * 65536 + base * 32 + d);
  em(insns, n, 4167072288 + d * 65536 + d)
}

// Array set: base + index tags on the window; value emitted next, then the
// three are popped and CONST 0 is pushed (the statement's discard value).
fn emit_array_set(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let w = fntab[5387];
  let idxk = vs_entry_kind(fntab, w - 2);
  let idxc = vs_entry_p0(fntab, w - 2);
  let is_cimm = (if idxk == 1 then 1 else 0) * (if idxc >= 0 then 1 else 0) * (if idxc < 4096 then 1 else 0);
  let base = vs_reg(insns, n, fntab, stab, w - 3);
  let v = vs_reg(insns, n, fntab, stab, w - 1);
  let _ = if is_cimm == 1 then vs_array_set_imm(insns, n, base, idxc, v) else vs_array_set_reg(insns, n, fntab, stab, base, v, w - 2);
  let _ = vs_pop(fntab);
  let _ = vs_pop(fntab);
  let _ = vs_pop(fntab);
  vs_push(insns, n, fntab, stab, 1, 0, 0)
}
// A5 step 1b: `add x16,xbase,<idx> ; str xv,[x17,x16,lsl #3]` (4162877984 =
// 0xf8207a20, Rn=x17). A store has no destination register to borrow, so the
// scratch is x16 -- the register model's parallel-move scratch (REGISTER-MODEL
// §1.1), dead at every array-set site because vs_reg/vs_mat have already
// finished any move they needed. Taking one through vs_alloc instead could park
// the deepest window entry, which at a 3-entry window IS the array base.
fn vs_array_set_imm(insns: [i64], n: [i64], base: i64, idxc: i64, v: i64) -> i64 {
  let _ = if idxc > 0 then em(insns, n, 2432696320 + idxc * 1024 + base * 32 + 16) else 0;
  let b = if idxc > 0 then 16 else base;
  em(insns, n, 4162877984 + b * 65536 + v)
}
fn vs_array_set_reg(insns: [i64], n: [i64], fntab: [i64], stab: [i64], base: i64, v: i64, idxidx: i64) -> i64 {
  let idx = vs_reg(insns, n, fntab, stab, idxidx);
  let _ = em(insns, n, 2332033024 + idx * 65536 + base * 32 + 16);
  em(insns, n, 4162877984 + 16 * 65536 + v)
}

// Emit name[i] (get) or name[i] = v (set). `name` is a bound array variable;
// pos is at '['. Emit base (push), emit index (push), then get or set.
// ROADMAP F3 (2026-09-09) -- STATIC BOUNDS CHECK, exit 65, ZERO machine words.
// docs/LANGUAGE.md:68 documents reading past the end as UNDEFINED and :129 lists
// bounds checks among what the language does not have. The census calls this the
// one open row whose fix costs emitted words -- but only the DYNAMIC half does.
// Where the length is fixed by the `let` AND the index is a literal, both
// operands are TEXT at compile time, the check discharges in the compiler, and
// it emits nothing at all.
// The table is fntab[5410 + k] = length PLUS ONE (0 = unknown), keyed by the
// symbol's REGISTER, not its table index: sym_lookup already returns the
// register at both the `let` and the index site, so keying on it costs no extra
// scan -- k = reg - 19 for a cs register (19..26) and reg - 92 for a spill slot
// (100+, i.e. reg - 100 + 8). That key is written INLINE at its three sites as a
// single nested-if expression rather than as a fourth function: gb_pool leaves
// exactly TWO functions of headroom (measured 2026-09-09 -- +2 compiles, +3 gives
// `too many fns (cap 512)`) and this block already spends both. Only two right-hand sides publish a length, `zeros(<literal>)`
// and an array literal, because those are the two the grammar fixes at the
// `let`; a parameter, a call result or `zeros(n)` records 0 and is never
// guessed at. Every `let` writes the entry, so a rebinding that replaces the
// array replaces its length too and a stale length cannot outlive its name.
// FN BUDGET: this block is deliberately THREE functions. gb_pool compiles a
// main-stripped bebop.bp concatenated with gb_pool.bp and its six `use` files,
// which sits close to the 512-fn cap -- an eight-function first draft compiled
// bebop.bp fine and then failed that gate with `too many fns (cap 512)`.
// The literal value of the text from `at` up to the next unnested `closer`, or
// -1 if any byte before it is not a digit. One scanner serves the index site
// (`closer` = `]`) and `zeros(...)` (`closer` = `)`); merging them is what keeps
// this block inside the fn budget.
fn lit_upto(s: str, at: i64, strn: i64, closer: i64) -> i64 {
  let i = at;
  let v = 0;
  let any = 0;
  let bad = 0;
  let done = 0;
  while done == 0 {
    let c = if i >= strn then 0 else char(s, i);
    let atend = if i >= strn then 1 else 0;
    let hit = if c == closer then 1 else 0;
    let d = (if c >= 48 then 1 else 0) * (if c <= 57 then 1 else 0);
    let v = if d == 1 then v * 10 + (c - 48) else v;
    let any = if d == 1 then 1 else any;
    let sp = (if c == 32 then 1 else 0) + (if c == 10 then 1 else 0) + (if c == 9 then 1 else 0);
    let bad = if d + sp + hit + atend == 0 then 1 else bad;
    let done = hit + atend;
    let i = i + 1;
    0
  };
  if any * (1 - bad) == 1 then v else 0 - 1
}

// The static length published by the right-hand side at `at`, PLUS ONE, or 0.
// `zeros(<literal>)` gives its argument; an array literal gives its element
// count, with commas counted at bracket AND paren depth 0 so `[f(a, b), c]` is
// two elements and not three. Anything else -- including an empty `[]` or a
// literal the scan cannot see the end of -- gives 0, meaning "unknown".
fn rhs_len_p1(s: str, at: i64, strn: i64) -> i64 {
  let isz = if at + 6 <= strn then ceq(s, at, 122) * ceq(s, at + 1, 101) * ceq(s, at + 2, 114) * ceq(s, at + 3, 111) * ceq(s, at + 4, 115) * ceq(s, at + 5, 40) else 0;
  let zl = if isz == 1 then lit_upto(s, at + 6, strn, 41) else 0 - 1;
  let isarr = if at < strn then ceq(s, at, 91) else 0;
  let i = at + 1;
  let db = 0;
  let dp = 0;
  let cnt = 1;
  let seen = 0;
  let done = 1 - isarr;
  let res = 0 - 1;
  while done == 0 {
    let c = if i >= strn then 0 else char(s, i);
    let atend = if i >= strn then 1 else 0;
    let ise = if c == 93 then 1 else 0;
    let close = ise * (if db + dp == 0 then 1 else 0);
    let db = db + (if c == 91 then 1 else 0) - ise;
    let dp = dp + (if c == 40 then 1 else 0) - (if c == 41 then 1 else 0);
    let cnt = cnt + (if c == 44 then 1 else 0) * (if db + dp == 0 then 1 else 0);
    let ws = (if c == 32 then 1 else 0) + (if c == 10 then 1 else 0) + (if c == 9 then 1 else 0) + (if c == 13 then 1 else 0);
    let seen = if ws + close == 0 then 1 else seen;
    let res = if close * seen == 1 then cnt else res;
    let done = close + atend;
    let i = i + 1;
    0
  };
  let v = if zl >= 0 then zl else res;
  if v >= 0 then v + 1 else 0
}

fn emit_array_index(s: str, name: i64, npos: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let strn = slen(s, pos);
  let reg = sym_lookup(s, stab, name, npos);
  let _ = if reg < 0 then diag_exit(s, npos, 101) else 0;
  let _ = emit_var(insns, n, reg, fntab, stab);
  let _ = pos[0] = pos[0] + 1;
  // F3: discharge the bound HERE, before the index is emitted -- both operands
  // are text at this point, so the whole check is compile-time and costs no word.
  let bidx = lit_upto(s, pos[0], strn, 93);
  let bkey = if reg >= 19 then (if reg <= 26 then reg - 19 else 0 - 1) else (if reg >= 100 then reg - 92 else 0 - 1);
  let blen = if bkey >= 0 then fntab[5410 + bkey] else 0;
  let bbad = (if bidx >= 0 then 1 else 0) * (if blen > 0 then 1 else 0) * (if bidx >= blen - 1 then 1 else 0);
  let _ = if bbad == 1 then diag_exit(s, pos[0], 65) else 0;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  let e1 = if pos[0] + 1 >= strn then 1 else 0;
  let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
  let is_eq = if ch == 61 then 1 else 0;
  let is_eq2 = if ch1 == 61 then 1 else 0;
  let is_set = is_eq * (1 - is_eq2);
  let _ = if is_set == 1 then emit_array_set(s, pos, insns, n, stab, selfname, selfstart, fntab) else emit_array_get(insns, n, fntab, stab);
  n[0]
}

// `-<digits>`: negative literal (T99). pos is on the `-`.
fn emit_negnum(s: str, pos: [i64], insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let v = read_num_val(s, pos);
  let _ = emit_lit(insns, n, 0 - v, fntab, stab);
  n[0]
}

// Unary operator on the next factor (T99): kind 0 = `-` (CONST -> CONST(-c);
// else neg xd,xa -> REG), kind 1 = `!` (CONST -> CONST(c==0); FLAGS c ->
// FLAGS(c^1), no word; else cmp xa,#0 -> FLAGS eq). pos is on the operator char.
fn emit_unary(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], kind: i64) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_factor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  if kind == 0 then vs_neg(insns, n, fntab, stab) else vs_not(insns, n, fntab, stab)
}
fn vs_neg(insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let top = fntab[5387] - 1;
  if vs_entry_kind(fntab, top) == 1 then vs_neg_const(fntab, top) else vs_neg_reg(insns, n, fntab, stab, top)
}
fn vs_neg_const(fntab: [i64], top: i64) -> i64 {
  vs_set_entry(fntab, top, 1, 0 - vs_entry_p0(fntab, top), 0)
}
fn vs_neg_reg(insns: [i64], n: [i64], fntab: [i64], stab: [i64], top: i64) -> i64 {
  let a = vs_reg(insns, n, fntab, stab, top);
  let ak = vs_entry_kind(fntab, top);
  let d = if ak == 2 then a else vs_alloc(insns, n, fntab, stab);
  // BUGFIX (2026-09-06, bug 9 audit): when d reuses a (ak==2) nothing is
  // abandoned. Otherwise a fresh d is allocated and `a` is left behind --
  // if it was a CS temp (ak==4), that register is never freed (a symbol,
  // ak==3, owns its register permanently and correctly gets no free).
  let _ = if (ak == 4) * (if d != a then 1 else 0) == 1 then vs_cs_free(fntab, a, 7) else 0;
  let _ = em(insns, n, 3405775840 + a * 65536 + d);
  vs_set_entry(fntab, top, 2, d, n[0] - 1)
}
fn vs_not(insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let top = fntab[5387] - 1;
  let kind = vs_entry_kind(fntab, top);
  let _ = if kind == 1 then vs_set_entry(fntab, top, 1, (if vs_entry_p0(fntab, top) == 0 then 1 else 0), 0)
    else if kind == 7 then vs_set_entry(fntab, top, 7, vs_entry_p0(fntab, top) ^ 1, 0)
    else vs_not_reg(insns, n, fntab, stab, top);
  n[0]
}
fn vs_not_reg(insns: [i64], n: [i64], fntab: [i64], stab: [i64], top: i64) -> i64 {
  let a = vs_reg(insns, n, fntab, stab, top);
  let ak = vs_entry_kind(fntab, top);
  let _ = em(insns, n, 4043309087 + a * 32);
  // BUGFIX (2026-09-06, bug 9 audit, coordinator's item 3): `cmp x<a>,#0`
  // produces FLAGS, which owns nothing -- `a`'s register (window temp or
  // cs temp; ak was already mutated to 2 by vs_reg if it needed
  // materialising) must be freed here or it leaks (a permanent symbol,
  // ak==3, is correctly left alone).
  let _ = if ak == 2 then vs_mask_free(fntab, a, 17) else 0;
  let _ = if ak == 4 then vs_cs_free(fntab, a, 8) else 0;
  vs_set_entry(fntab, top, 7, 0, 0)
}

// factor = number | letter | ( expr ) | cond expr then expr else expr
fn emit_factor(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = skip_ws(s, pos);
  let strn = slen(s, pos);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  // unary not: !e desugars to (e == 0). The '!=' two-char token is left
  // alone for the comparison tier. (Desugar disabled: the nested
  // if-in-comparison branch code misfires in the JIT-compiled emitter;
  // the corpus never uses unary '!'.)
  let e1 = if pos[0] + 1 >= strn then 1 else 0;
  let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
  let is_lparen = if ch == 40 then 1 else 0;
  let is_i = if ch == 105 then 1 else 0;
  let is_f = if ch1 == 102 then 1 else 0;
  let is_ifkw = is_i * is_f;
  let e2 = if pos[0] + 2 >= strn then 1 else 0;
  let e3 = if pos[0] + 3 >= strn then 1 else 0;
  let e4 = if pos[0] + 4 >= strn then 1 else 0;
  let e5 = if pos[0] + 5 >= strn then 1 else 0;
  let e6 = if pos[0] + 6 >= strn then 1 else 0;
  let ch2 = if e2 == 1 then 0 else char(s, pos[0] + 2);
  let ch3 = if e3 == 1 then 0 else char(s, pos[0] + 3);
  let ch4 = if e4 == 1 then 0 else char(s, pos[0] + 4);
  let ch5 = if e5 == 1 then 0 else char(s, pos[0] + 5);
  let ch6 = if e6 == 1 then 0 else char(s, pos[0] + 6);
  let is_m = if ch == 109 then 1 else 0;
  let is_a = if ch1 == 97 then 1 else 0;
  let is_t = if ch2 == 116 then 1 else 0;
  let is_c = if ch3 == 99 then 1 else 0;
  let is_h = if ch4 == 104 then 1 else 0;
  let is_matchkw = is_m * is_a * is_t * is_c * is_h;
  let is_l = if ch == 108 then 1 else 0;
  let is_e = if ch1 == 101 then 1 else 0;
  let is_t2 = if ch2 == 116 then 1 else 0;
  let is_letkw = is_l * is_e * is_t2;
  let is_lb = if ch == 91 then 1 else 0;
  let is_quote = if ch == 34 then 1 else 0;
  let is_letter = is_alpha(ch);
  // A18 (2026-09-14): `return` and `break` in expression position.
  // Same product-of-flags style as emit_body_classify (line 5637/5638).
  let id5 = is_alpha(ch5) + is_digit(ch5) + (if ch5 == 95 then 1 else 0);
  let id6 = is_alpha(ch6) + is_digit(ch6) + (if ch6 == 95 then 1 else 0);
  let is_ret = (if ch == 114 then 1 else 0) * (if ch1 == 101 then 1 else 0) * (if ch2 == 116 then 1 else 0) * (if ch3 == 117 then 1 else 0) * (if ch4 == 114 then 1 else 0) * (if ch5 == 110 then 1 else 0) * (1 - id6);
  let is_brk = (if ch == 98 then 1 else 0) * (if ch1 == 114 then 1 else 0) * (if ch2 == 101 then 1 else 0) * (if ch3 == 97 then 1 else 0) * (if ch4 == 107 then 1 else 0) * (1 - id5);
  // T99 (2026-09-04) unary literal forms: `-x` = neg x0,x0; `!x` = cmp
  // x0,#0; cset x0,eq (`!=` stays a comparison token). `-<digits>` is a
  // negative literal (single movn/movk, fold model intact).
  let is_neg = (if ch == 45 then 1 else 0) * (1 - is_digit(ch1));
  let is_negnum = (if ch == 45 then 1 else 0) * is_digit(ch1);
  let is_not = (if ch == 33 then 1 else 0) * (if ch1 == 61 then 0 else 1);
  let _ = if is_neg == 1 then emit_unary(s, pos, insns, n, stab, selfname, selfstart, fntab, 0)
    else if is_not == 1 then emit_unary(s, pos, insns, n, stab, selfname, selfstart, fntab, 1)
    else if is_negnum == 1 then emit_negnum(s, pos, insns, n, fntab, stab)
    else if is_lparen == 1 then emit_paren(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if is_ifkw == 1 then emit_cond(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if is_letkw == 1 then emit_let_in(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if is_matchkw == 1 then emit_match(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if is_ret == 1 then (let _ = emit_return_core(s, pos, insns, n, stab, selfname, selfstart, fntab) in vs_push(insns, n, fntab, stab, 1, 0, 0))
    else if is_brk == 1 then (let _ = emit_break_core(s, pos, insns, n, fntab) in vs_push(insns, n, fntab, stab, 1, 0, 0))
    else if is_lb == 1 then emit_array_lit(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if is_quote == 1 then emit_str(s, pos, insns, n, fntab, stab)
    else if is_letter == 1 then emit_ident(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else emit_num(s, pos, insns, n, fntab, stab);
  let fd = 0;
  while fd == 0 {
    // progress guard: '.' that fails to consume input must not spin forever
    let before = pos[0];
    let _ = skip_ws(s, pos);
    let strn2 = slen(s, pos);
    let ch2 = if pos[0] >= strn2 then 0 else char(s, pos[0]);
    let is_dot = if ch2 == 46 then 1 else 0;
    let _ = if is_dot == 1 then emit_field_access(s, pos, insns, n, stab, fntab) else 0;
    let advanced = if pos[0] > before then 1 else 0;
    let stuck = is_dot * (1 - advanced);
    let fd = if is_dot == 1 then stuck else 1;
    0
  };
  n[0]
}



// Checksum of the emitted buffer (Bebop has no bitwise xor).
fn sum_words(insns: [i64], count: i64) -> i64 {
  let i = 0;
  let acc = 0;
  while i < count {
    let acc = acc + insns[i];
    let i = i + 1;
    0
  };
  acc
}

// Parse + emit an expression, return the checksum of the emitted words.
fn compile(s: str) -> i64 {
  let insns = zeros(256);
  let n = [0, 256];
  let pos = [0, 0];
  let stab = zeros(385);  // 1 + 3*128 (name,reg,srcpos) verified triples; overflow -> loud trap
  let selfname = 0 - 1;
  let selfstart = 0;
  let fnames_l = zeros(784);
  let fpos_l = zeros(784);
  let cnt_l = [0];
  let _ = collect_fns(s, fnames_l, fpos_l, cnt_l);
  // ROADMAP A16 prerequisite (2026-09-09): the fn cap is 560, not 512. RAISING IT
  // REQUIRED MOVING b1_scratch: fntab[2900+i] is the per-fn facts table and was
  // sized 512, so fn index 512..514 would have written straight through the
  // b1_scratch cells at 2712/2713/2714 -- the call-site counter and the skip-save
  // flag -- i.e. a wrong `bl` target, silently, on any program with 513+ fns. The
  // battery would not have caught it: no gate program has that many. b1_scratch
  // now lives at 2764..2766, leaving b1_facts 2200..2763 = 564 cells for a cap of
  // 560, still clear of the window zone at 2800. This
  // site now reports 104 like the other cap site instead of 89. 89 already means
  // three different things (register pressure, S+tsp > 64, window full), and a
  // cap that reported TWO codes is why A1b's gate passed with the wrong
  // diagnostic text -- one condition, one code.
  let _ = if cnt_l[0] >= 768 then diag_exit(s, 0, 104) else 0;
  let fntab = zeros(8192);
  let _ = fntab[0] = cnt_l[0];
  let _ = vs_reset(fntab);
  let fl_i = [0];
  let fl_d = if cnt_l[0] == 0 then 1 else 0;
  while fl_d == 0 {
    let _ = fntab[1 + fl_i[0]] = fnames_l[fl_i[0]];
    let _ = fntab[1 + cnt_l[0] + cnt_l[0] + fl_i[0]] = fpos_l[fl_i[0]];
    let _ = fl_i[0] = fl_i[0] + 1;
    let fl_d = if fl_i[0] >= cnt_l[0] then 1 else 0;
    0
  };
  let enames_l = zeros(256);
  let ecnt_l = [0];
  let _ = collect_ctors(s, enames_l, ecnt_l);
  let _ = if ecnt_l[0] >= 256 then diag_exit(s, 0, 89) else 0;
  let eb_l = cnt_l[0] + cnt_l[0] + cnt_l[0] + 1;
  let _ = fntab[eb_l] = ecnt_l[0];
  let ez_l = [0];
  let ezd_l = if ecnt_l[0] == 0 then 1 else 0;
  while ezd_l == 0 {
    let _ = fntab[eb_l + 1 + ez_l[0]] = enames_l[ez_l[0]];
    let _ = ez_l[0] = ez_l[0] + 1;
    let ezd_l = if ez_l[0] >= ecnt_l[0] then 1 else 0;
    0
  };
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = vs_deliver(insns, n, fntab, stab, 1);
  let _ = em(insns, n, 3596551104);
  sum_words(insns, n[0])
}


// Advance pos to just before the first occurrence of `target`.
fn skip_to(s: str, pos: [i64], target: i64) -> i64 {
  let strn = slen(s, pos);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let hit = if ch == target then 1 else 0;
    let adv = if hit == 1 then 0 else 1;
    let _ = pos[0] = pos[0] + adv;
    let at_end_done = if at_end == 1 then 1 else 0;
    let done = if hit == 1 then 1 else at_end_done;
    0
  };
  0
}

// Lexical validator for whitespace-only regions (module contents): walks [from, to)
// and returns the source offset of the first character that is NOT whitespace
// (space=32, tab=9, newline=10, carriage return=13).
// Returns -1 if the region is entirely whitespace or empty. Used to validate that
// module declarations contain only whitespace between { and }.
fn scan_nonspace(s: str, from: i64, to: i64) -> i64 {
  let i = from;
  let found = -1;
  while i < to {
    let c = char(s, i);
    let is_space = if c == 32 then 1 else 0;
    let is_tab = if c == 9 then 1 else 0;
    let is_newline = if c == 10 then 1 else 0;
    let is_cr = if c == 13 then 1 else 0;
    let is_whitespace = is_space + is_tab + is_newline + is_cr;
    let _ = if is_whitespace == 0 then (let _ = found = i in 0) else 0;
    let _ = if found >= 0 then (let i = to in 0) else 0;
    let i = i + 1;
    0
  };
  found
}

// Lexical validator for inert regions (requires/ensures/theorem): walks [from, to)
// and returns the source offset of the first character that is NOT one of:
// - whitespace (32, 9, 10, 13)
// - identifier chars: a-z A-Z 0-9 _
// - type/contract punctuation: - > < = + * / . : , ( ) [ ] ;
// Returns -1 if every character is allowed. REJECTED chars: @ % # $ ! & | ^ ~ ? \ " '
fn scan_inert(s: str, from: i64, to: i64) -> i64 {
  let found = [-1];
  let i = [from];
  while i[0] < to {
    let c = char(s, i[0]);
    // Check whitespace: 32=' ', 9=tab, 10=newline, 13=CR
    let is_ws = if c == 32 then 1 else 0;
    let is_ws2 = if c == 9 then 1 else 0;
    let is_ws3 = if c == 10 then 1 else 0;
    let is_ws4 = if c == 13 then 1 else 0;
    let is_whitespace = is_ws + is_ws2 + is_ws3 + is_ws4;
    // Check identifier chars: a-z (97-122), A-Z (65-90), 0-9 (48-57), _ (95)
    let is_lc = if c >= 97 then (if c <= 122 then 1 else 0) else 0;
    let is_uc = if c >= 65 then (if c <= 90 then 1 else 0) else 0;
    let is_digit = if c >= 48 then (if c <= 57 then 1 else 0) else 0;
    let is_underscore = if c == 95 then 1 else 0;
    let is_ident = is_lc + is_uc + is_digit + is_underscore;
    // Check allowed punctuation
    let is_punct = if c == 45 then 1 else 0;  // -
    let is_punct2 = if c == 62 then 1 else 0;  // >
    let is_punct3 = if c == 60 then 1 else 0;  // <
    let is_punct4 = if c == 61 then 1 else 0;  // =
    let is_punct5 = if c == 43 then 1 else 0;  // +
    let is_punct6 = if c == 42 then 1 else 0;  // *
    let is_punct7 = if c == 47 then 1 else 0;  // /
    let is_punct8 = if c == 46 then 1 else 0;  // .
    let is_punct9 = if c == 58 then 1 else 0;  // :
    let is_punct10 = if c == 44 then 1 else 0;  // ,
    let is_punct11 = if c == 40 then 1 else 0;  // (
    let is_punct12 = if c == 41 then 1 else 0;  // )
    let is_punct13 = if c == 91 then 1 else 0;  // [
    let is_punct14 = if c == 93 then 1 else 0;  // ]
    let is_punct15 = if c == 59 then 1 else 0;  // ;
    let is_allowed_punct = is_punct + is_punct2 + is_punct3 + is_punct4 + is_punct5 + is_punct6 + is_punct7 + is_punct8 + is_punct9 + is_punct10 + is_punct11 + is_punct12 + is_punct13 + is_punct14 + is_punct15;
    // Combine: character is allowed if it's whitespace, identifier, or allowed punctuation
    let is_allowed = if (is_whitespace + is_ident + is_allowed_punct) > 0 then 1 else 0;
    // If not allowed and we haven't found an error yet, record it
    let _ = if (is_allowed == 0) * (found[0] == -1) then found[0] = i[0] else 0;
    let _ = i[0] = i[0] + 1;
    0
  };
  found[0]
}

// Find the end of the current line (position of newline or EOF). pos is the starting position.
fn find_line_end(s: str, pos: i64, strn: i64) -> i64 {
  let i = pos;
  let done = 0;
  while done == 0 {
    let at_end = if i >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, i);
    let is_nl = if ch == 10 then 1 else 0;
    let adv = 1 - is_nl - at_end;
    let _ = i = i + adv;
    let done = if is_nl + at_end >= 1 then 1 else 0;
    0
  };
  i
}

// Count params in the ( ... ) list (commas + 1); advances pos past ')'.

// Prologue: save FP+LR, allocate a frame (spill slots + heap), save callee-saved
// x19..x28, then set x15 (spill base) and x14 (heap bump pointer). The frame is
// [sp, sp+16384): spills live at [x15, x15+…) (x15=sp+256), heap bumps up from
// x14=sp+2304 (add x14,sp,#0x900 = 2435056622, as+objdump; sp+768 and 64 slots
// before ROADMAP A14 2026-09-07), and the eval stack grows down from sp. x19-x28 are preserved for
// recursion + cross-function `bl`.
fn emit_prologue(insns: [i64], n: [i64]) -> i64 {
  let _ = em(insns, n, 2847898621);
  let _ = em(insns, n, 2432697341);
  let _ = em(insns, n, 3510637567);
  let _ = em(insns, n, 2835370995);
  let _ = em(insns, n, 2835438581);
  let _ = em(insns, n, 2835506167);
  let _ = em(insns, n, 2835573753);
  let _ = em(insns, n, 2835641339);
  let _ = em(insns, n, 2432959471);
  let _ = em(insns, n, 2435056622);
  n[0]
}

// Epilogue: restore x19..x28 (offset ldp), free the frame, restore FP+LR, ret.
fn emit_epilogue(insns: [i64], n: [i64]) -> i64 {
  let _ = em(insns, n, 2839835643);
  let _ = em(insns, n, 2839768057);
  let _ = em(insns, n, 2839700471);
  let _ = em(insns, n, 2839632885);
  let _ = em(insns, n, 2839565299);
  let _ = em(insns, n, 2436895743);
  let _ = em(insns, n, 2831252477);
  let _ = em(insns, n, 3596551104);
  n[0]
}

// B1 (2026-09-06): right-sized prologue for the emission pass, using facts
// (vc = final symbol count incl. params, has_alloc = body allocates on x14)
// published by the planning pass -- replaces OPT-A's post-hoc NOP patch and
// always omits pair 4 (x19..28 pair index 4 = x27/x28, the arena registers;
// T126: never a symbol register, was unconditionally NOPed already, so
// omitting it here is not a new elision). emit_prologue/emit_epilogue above
// stay untouched and unconditional -- used by the planning pass (its own
// facts aren't known yet: chicken-and-egg within one compile) and by the
// legacy single-fn compile_fn path, both of which must keep today's exact
// word count.
// ROADMAP A6 step 2 (2026-09-09): COMPUTED FRAME. The flat `sub sp,sp,#16384`
// was 14080 B of frame heap (deleted in step 1, so it was dead weight on every
// activation) plus the 80 B save area, 21 mark cells, the fn-mark cell and the
// x15 slot region. What is left is exactly F = 80 + 8*marks + 8 + 8*(S + tsp),
// rounded up to 16 for the AArch64 sp alignment rule, and x15 = sp + 80 +
// 8*marks + 8 -- which is today's constant sp+256 when marks = 21, the sanity
// check the blueprint asks for. compile_fn_at_facts already traps exit 89 at
// S + tsp > 256, so F <= 80 + 168 + 8 + 2048 = 2304 and the single-word
// `sub sp,sp,#F` imm12 (< 4096) can never overflow; no two-word fallback is
// emitted, and none is needed. WORD COUNT IS UNCHANGED by this step -- only the
// two immediates and the x15 offset move -- so compile_fn_at_total_saved's
// arithmetic correction, and with it the two-pass bl agreement, is untouched.
fn frame_x15off(marks: i64) -> i64 { 88 + 8 * marks }
fn frame_size(vc: i64, tsp: i64, marks: i64) -> i64 {
  let s0 = if vc > 8 then vc - 8 else 0;
  let raw = frame_x15off(marks) + 8 * (s0 + tsp);
  ((raw + 15) / 16) * 16
}
fn emit_prologue_sized(insns: [i64], n: [i64], vc: i64, has_alloc: i64, cs_hi: i64, tsp: i64, marks: i64) -> i64 {
  // callee-saved pairs: pair k kept iff max(vc, cs_hi) > 2k (a cs temp in
  // x20 needs pair 0 only, same as a symbol there).
  let mvc = if vc > cs_hi then vc else cs_hi;
  let _ = em(insns, n, 2847898621);
  let _ = em(insns, n, 2432697341);
  let _ = em(insns, n, 3506439167 + frame_size(vc, tsp, marks) * 1024);
  let _ = if mvc > 0 then em(insns, n, 2835370995) else 0;
  let _ = if mvc > 2 then em(insns, n, 2835438581) else 0;
  let _ = if mvc > 4 then em(insns, n, 2835506167) else 0;
  let _ = if mvc > 6 then em(insns, n, 2835573753) else 0;
  // A6 step 2 commit B: `alloc` no longer implies a live x15 -- aggregates are
  // on x27 and there is no frame heap. x15 is needed exactly when this fn has
  // spilled symbols (vc > 8) or temp slots (tsp > 0).
  let needs15raw = (if vc > 8 then 1 else 0) + (if tsp > 0 then 1 else 0);
  let needs15 = if needs15raw > 0 then 1 else 0;
  let _ = if needs15 == 1 then em(insns, n, 2432697327 + frame_x15off(marks) * 1024) else 0;
  // A6 step 2 commit B: `add x14,sp,#0x900` is GONE. It pointed at a frame heap
  // that step 1 deleted, and under the computed frame sp+0x900 is past the top
  // of the frame entirely. The emission pass now saves this word on EVERY fn,
  // not just the non-allocating ones -- see saved_x14 in
  // compile_fn_at_total_saved, which becomes an unconditional 1. `has_alloc`
  // stays in the signature: it is still a real published fact and the fn-mark
  // LIFO release is the next thing that reads it.
  n[0]
}

fn emit_epilogue_sized(insns: [i64], n: [i64], vc: i64, cs_hi: i64, tsp: i64, marks: i64) -> i64 {
  let mvc = if vc > cs_hi then vc else cs_hi;
  let _ = if mvc > 6 then em(insns, n, 2839768057) else 0;
  let _ = if mvc > 4 then em(insns, n, 2839700471) else 0;
  let _ = if mvc > 2 then em(insns, n, 2839632885) else 0;
  let _ = if mvc > 0 then em(insns, n, 2839565299) else 0;
  let _ = em(insns, n, 2432697343 + frame_size(vc, tsp, marks) * 1024);
  let _ = em(insns, n, 2831252477);
  let _ = em(insns, n, 3596551104);
  n[0]
}

// ---- T43 (2026-09-04): per-iteration allocation reset around `while` bodies.
// A body that allocates (array literal / enum ctor: the stream contains the
// sentinel `mov x0,x27` = 2853897184; ROADMAP A6 2026-09-08 moved these off the
// frame heap's `mov x0,x14` = 2853045216 onto the arena cursor) leaked 16 bytes+
// per iteration and overflowed the 15 KiB frame heap (L8 "no allocations inside
// while bodies"). Now the loop saves x27 once before loop_start (the mark cell
// at [sp,#80+8*depth], unchanged) and restores it at the back-edge and at
// the exit, PROVIDED the body cannot leak an allocated pointer: a
// conservative TEXT scan of the body says no `let` at paren-depth 0 binds an
// OUTER symbol (bound before the loop) to a BARE right-hand side (no
// arithmetic/comparison operator = possibly a pointer), and no `let _ = a[i] =
// v` stores a bare `v`. Anything else (rebinding outer scalars with arithmetic,
// new names, nested loops) is fine. Unsafe bodies keep today's behaviour
// (leak, never a wrong value). Slot = [sp, #80 + 8*depth], depth <= 20
// (frame words 80..256 are free below the x15 spill base).
fn sym_is_outer(s: str, stab: [i64], name: i64, srcpos: i64, cnt0: i64) -> i64 {
  let i = 0;
  let hit = 0;
  while i < cnt0 {
    let nm = stab[1 + 3 * i];
    let sp = stab[3 + 3 * i];
    let h = if nm == name then ident_eq(s, sp, srcpos) else 0;
    let hit = hit + h;
    let i = i + 1;
    0
  };
  if hit > 0 then 1 else 0
}

// 1 when [a,b) holds no operator character (+ - * / % & | ^ < > !) at
// paren/bracket depth 0: `s + v[1]` is a scalar, `[i, i * i]` and `f(a + b)`
// are bare values (an array literal / call may yield a pointer).
fn rhs_is_bare(s: str, a: i64, b: i64) -> i64 {
  let i = a;
  let ops = 0;
  let dp = 0;
  while i < b {
    let c = char(s, i);
    let o = (c == 43) + (c == 45) + (c == 42) + (c == 47) + (c == 37) + (c == 38) + (c == 124) + (c == 94) + (c == 60) + (c == 62) + (c == 33);
    let ops = ops + o * (if dp == 0 then 1 else 0);
    let dp = dp + (c == 40) + (c == 91) - (c == 41) - (c == 93);
    let i = i + 1;
    0
  };
  if ops == 0 then 1 else 0
}

// End of a right-hand side starting at r0: the first `;`, `}` or ` in ` at
// local paren/bracket depth 0 (never past b1).
fn rhs_end(s: str, r0: i64, b1: i64) -> i64 {
  let k = r0;
  let ld = 0;
  let done = 0;
  while done == 0 {
    let at_end = if k >= b1 then 1 else 0;
    let c = if at_end == 1 then 59 else char(s, k);
    let c1 = if k + 1 >= b1 then 0 else char(s, k + 1);
    let c2 = if k + 2 >= b1 then 0 else char(s, k + 2);
    let c3 = if k + 3 >= b1 then 0 else char(s, k + 3);
    let is_in = (c == 32) * (c1 == 105) * (c2 == 110) * (c3 == 32);
    let stop = (if ld == 0 then 1 else 0) * ((c == 59) + (c == 125) + is_in) + at_end;
    let ld = ld + (c == 40) + (c == 91) - (c == 41) - (c == 93);
    let k = k + (1 - (if stop >= 1 then 1 else 0));
    let done = if stop >= 1 then 1 else 0;
    0
  };
  k
}

fn loop_alloc_safe(s: str, b0: i64, b1: i64, stab: [i64], cnt0: i64) -> i64 {
  let p = zeros(2);
  let i = b0;
  let pd = 0;
  let bad = 0;
  while i < b1 {
    let c = char(s, i);
    let c1 = if i + 1 >= b1 then 0 else char(s, i + 1);
    let c2 = if i + 2 >= b1 then 0 else char(s, i + 2);
    let c3 = if i + 3 >= b1 then 0 else char(s, i + 3);
    let is_cm = (c == 47) * (c1 == 47);
    let is_q = if c == 34 then 1 else 0;
    let _ = p[0] = i;
    let _ = if is_cm == 1 then skip_line_comment(s, p) else 0;
    let _ = if is_q == 1 then skip_string(s, p) else 0;
    let skipped = is_cm + is_q;
    let prev = if i > b0 then char(s, i - 1) else 32;
    let prev_id = is_alpha(prev) + is_digit(prev) + (if prev == 95 then 1 else 0);
    let is_let = (1 - skipped) * (if pd == 0 then 1 else 0) * (c == 108) * (c1 == 101) * (c2 == 116) * (c3 == 32) * (1 - prev_id);
    let _ = if is_let == 1 then (let _ = p[0] = i + 4 in skip_ws(s, p)) else 0;
    let npos = p[0];
    let nch = if is_let == 1 then char(s, npos) else 0;
    let is_us = (if nch == 95 then 1 else 0) * (if is_alpha(char(s, npos + 1)) + is_digit(char(s, npos + 1)) == 0 then 1 else 0);
    let name = if is_let * (1 - is_us) == 1 then read_ident(s, p) else 0;
    let _ = if is_let == 1 then (let _ = if is_us == 1 then (let _ = p[0] = npos + 1 in 0) else 0 in skip_ws(s, p)) else 0;
    // p[0] is at `=` now (for a let); RHS starts after it
    let r0 = p[0] + 1;
    let r1 = if is_let == 1 then rhs_end(s, r0, b1) else r0;
    // `let _ = IDENT[...] = v`: find the store `=` (a `]` followed by ws and a single `=`)
    let st = if is_let * is_us == 1 then store_eq_pos(s, r0, r1) else 0 - 1;
    let v0 = if st >= 0 then st + 1 else r0;
    let bare = if is_let == 1 then rhs_is_bare(s, v0, r1) else 0;
    let outer = if is_let * (1 - is_us) == 1 then sym_is_outer(s, stab, name, npos, cnt0) else 0;
    let bad = bad + is_let * bare * (outer + (if st >= 0 then 1 else 0));
    let pd = pd + (1 - skipped) * ((c == 40) + (c == 91) - (c == 41) - (c == 93));
    let i = if skipped == 1 then p[0] else (if is_let == 1 then r1 else i + 1);
    0
  };
  if bad > 0 then 0 else 1
}

// Position of the store `=` in `a[i] = v` between r0 and r1 (a `]` then ws then
// `=` not followed by `=`), or -1.
fn store_eq_pos(s: str, r0: i64, r1: i64) -> i64 {
  let k = r0;
  let found = 0 - 1;
  while k < r1 {
    let c = char(s, k);
    let is_rb = if c == 93 then 1 else 0;
    let j = k + 1;
    let j = if is_rb * (if j < r1 then 1 else 0) * ceq(s, j, 32) == 1 then j + 1 else j;
    let hit = is_rb * (if j < r1 then 1 else 0) * ceq(s, j, 61) * (if j + 1 < r1 then (if char(s, j + 1) == 61 then 0 else 1) else 1);
    let found = if hit * (if found < 0 then 1 else 0) == 1 then j else found;
    let k = k + 1;
    0
  };
  found
}

fn count_word(insns: [i64], a: i64, b: i64, w: i64) -> i64 {
  let i = a;
  let c = 0;
  while i < b {
    let c = c + (if insns[i] == w then 1 else 0);
    let i = i + 1;
    0
  };
  c
}

// A18 (2026-09-14): `return e;` and `break;` now legal in expression position.
// Core forms emit the branch and placeholder without consuming the semicolon.
// T99 (2026-09-04): `return e;` -> e in x0, one placeholder `b` recorded in
// fntab[5601] (count) / 5602..5665 (positions, 64 slots), patched to the epilogue by
// compile_fn_at; `break;` -> placeholder `b` recorded in fntab[5666] / 5667..
// 5730 (64 slots), patched to the enclosing loop's exit by emit_while_stmt (which
// remembers the count at entry). More than 64 returns / 64 pending breaks in
// one fn traps loudly (exit 98, exit-code table at emit_paren).
fn emit_return_core(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let stmt_at = pos[0];
  let _ = pos[0] = pos[0] + 6;
  let _ = skip_ws(s, pos);
  // A21 step 2: offer TUPLE position to a `(` that opens the returned expression.
  let _ = fntab[7100] = if (if pos[0] >= slen(s, pos) then 0 else char(s, pos[0])) == 40 then pos[0] else 0 - 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = vs_deliver(insns, n, fntab, stab, 1);
  let k = fntab[5601];
  let _ = if k >= 64 then diag_exit(s, stmt_at, 98) else 0;
  let _ = fntab[5602 + k] = n[0];
  let _ = fntab[5601] = k + 1;
  let _ = em(insns, n, 335544320);
  n[0]
}

fn emit_return_stmt(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_return_core(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let cs = if pos[0] >= slen(s, pos) then 0 else char(s, pos[0]);
  let _ = if cs == 59 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  n[0]
}

fn emit_break_core(s: str, pos: [i64], insns: [i64], n: [i64], fntab: [i64]) -> i64 {
  let stmt_at = pos[0];
  let _ = pos[0] = pos[0] + 5;
  let k = fntab[5666];
  let _ = if k >= 64 then diag_exit(s, stmt_at, 98) else 0;
  let _ = fntab[5667 + k] = n[0];
  let _ = fntab[5666] = k + 1;
  let _ = em(insns, n, 335544320);
  n[0]
}

fn emit_break_stmt(s: str, pos: [i64], insns: [i64], n: [i64], fntab: [i64]) -> i64 {
  let _ = emit_break_core(s, pos, insns, n, fntab);
  let _ = skip_ws(s, pos);
  let cs = if pos[0] >= slen(s, pos) then 0 else char(s, pos[0]);
  let _ = if cs == 59 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  n[0]
}

// Patch the pending `b` placeholders recorded at fntab[base+1+j], j in
// [from, fntab[base]) to `target`, then rewind the count to `from`.
fn patch_jumps(insns: [i64], fntab: [i64], base: i64, from: i64, target: i64) -> i64 {
  let j = from;
  let cnt = fntab[base];
  while j < cnt {
    let p = fntab[base + 1 + j];
    let _ = insns[p] = 335544320 + (target - p);
    let j = j + 1;
    0
  };
  let _ = fntab[base] = from;
  0
}

// Skip a '...' char literal (defensive: the T39 surface has no char-literal
// syntax today -- `char(s,i)` is a builtin call, not a literal); mirrors
// skip_string for a single-quote delimiter.
fn skip_char_lit(s: str, pos: [i64]) -> i64 {
  let strn = slen(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_q = if ch == 39 then 1 else 0;
    let adv = 1 - is_q - at_end;
    let _ = pos[0] = pos[0] + adv;
    let done = if is_q + at_end >= 1 then 1 else 0;
    0
  };
  let _ = pos[0] = pos[0] + 1;
  0
}

// B5 (D14 item 1): scan from pcond (the start of a while condition's text) to
// the first '{' at paren/bracket depth 0, without parsing or emitting
// anything. The grammar guarantees a while condition is a `cmp` expression
// followed by `{` (fntab[5542] forbids struct literals there); this only
// needs to track paren/bracket nesting and skip string/char literals so a
// quoted brace or paren can't be mistaken for the body opener.
fn skip_while_cond(s: str, pos: [i64]) -> i64 {
  let strn = slen(s, pos);
  let depth = [0];
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_str = if ch == 34 then 1 else 0;
    let is_chr = if ch == 39 then 1 else 0;
    let _ = if is_str == 1 then skip_string(s, pos) else 0;
    let _ = if is_chr == 1 then skip_char_lit(s, pos) else 0;
    let dopen = (if ch == 40 then 1 else 0) + (if ch == 91 then 1 else 0);
    let dclose = (if ch == 41 then 1 else 0) + (if ch == 93 then 1 else 0);
    let _ = depth[0] = depth[0] + dopen - dclose;
    let stop = (if depth[0] == 0 then 1 else 0) * (if ch == 123 then 1 else 0);
    let adv = 1 - is_str - is_chr - stop - at_end;
    let _ = pos[0] = pos[0] + adv;
    let done = stop + at_end;
    0
  };
  0
}

// A2 commit 1 (csel): word-boundary keyword match for arm_end's terminator
// set {in, then, else} at depth 0. Checks BOTH boundaries (char before pos,
// char after the candidate word) so "index"/"win"/"elsewhere" never alias
// the keywords they merely contain as a substring.
fn kw_term_at(s: str, pos: i64, strn: i64) -> i64 {
  let cb = if pos <= 0 then 0 else char(s, pos - 1);
  let idb = is_alpha(cb) + is_digit(cb) + (if cb == 95 then 1 else 0);
  let c0 = if pos >= strn then 0 else char(s, pos);
  let c1 = if pos + 1 >= strn then 0 else char(s, pos + 1);
  let c2 = if pos + 2 >= strn then 0 else char(s, pos + 2);
  let c3 = if pos + 3 >= strn then 0 else char(s, pos + 3);
  let is_in = (if c0 == 105 then 1 else 0) * (if c1 == 110 then 1 else 0);
  let is_then = (if c0 == 116 then 1 else 0) * (if c1 == 104 then 1 else 0) * (if c2 == 101 then 1 else 0) * (if c3 == 110 then 1 else 0);
  let is_else = (if c0 == 101 then 1 else 0) * (if c1 == 108 then 1 else 0) * (if c2 == 115 then 1 else 0) * (if c3 == 101 then 1 else 0);
  let alen = 2 * is_in + 4 * is_then + 4 * is_else;
  let cafter = if pos + alen >= strn then 0 else char(s, pos + alen);
  let ida = is_alpha(cafter) + is_digit(cafter) + (if cafter == 95 then 1 else 0);
  let any = is_in + is_then + is_else;
  any * (1 - ida) * (1 - idb)
}

// A2 commit 1: scan from the start of an `if` arm (just past `then`/`else`)
// to its end -- the first `;`, `)`, `,`, `}`, or the keyword `in`/`then`/`else`
// at paren/bracket depth 0, or end of input (skip_while_cond's discipline:
// track depth, skip strings/chars/comments so a quoted or commented token
// can't be mistaken for a terminator). Used for BOTH arms: the then-arm's
// real terminator (`else`) is a member of this same set, so one scanner
// serves both call sites (blueprint §3). Restores nothing -- pos0 is a value,
// not the caller's own position ref, so there is nothing to restore.
fn arm_end(s: str, pos0: i64, strn: i64) -> i64 {
  let pos = [pos0, strn];
  let depth = [0];
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let e1 = if pos[0] + 1 >= strn then 1 else 0;
    let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
    let is_str = if ch == 34 then 1 else 0;
    let is_chr = if ch == 39 then 1 else 0;
    let is_cm = (if ch == 47 then 1 else 0) * (if ch1 == 47 then 1 else 0);
    let d0 = if depth[0] == 0 then 1 else 0;
    let is_open = (if ch == 40 then 1 else 0) + (if ch == 91 then 1 else 0);
    let is_close = (if ch == 41 then 1 else 0) + (if ch == 93 then 1 else 0);
    let is_punct = (if ch == 59 then 1 else 0) + (if ch == 44 then 1 else 0) + (if ch == 125 then 1 else 0) + is_close;
    let is_kw = kw_term_at(s, pos[0], strn);
    let is_term = d0 * (is_punct + is_kw);
    let stop = at_end + (1 - at_end) * is_term;
    let _ = if stop == 1 then 0
      else if is_str == 1 then skip_string(s, pos)
      else if is_chr == 1 then skip_char_lit(s, pos)
      else if is_cm == 1 then skip_line_comment(s, pos)
      else (let _ = depth[0] = depth[0] + is_open - is_close in (let _ = pos[0] = pos[0] + 1 in 0));
    let done = stop;
    0
  };
  pos[0]
}

// A2 commit 1: word-boundary match for arm_is_pure's forbidden keyword set
// {let, while, if, match, return, break}.
fn kw_bad_at(s: str, pos: i64, to: i64) -> i64 {
  let cb = if pos <= 0 then 0 else char(s, pos - 1);
  let idb = is_alpha(cb) + is_digit(cb) + (if cb == 95 then 1 else 0);
  let c0 = if pos >= to then 0 else char(s, pos);
  let c1 = if pos + 1 >= to then 0 else char(s, pos + 1);
  let c2 = if pos + 2 >= to then 0 else char(s, pos + 2);
  let c3 = if pos + 3 >= to then 0 else char(s, pos + 3);
  let c4 = if pos + 4 >= to then 0 else char(s, pos + 4);
  let c5 = if pos + 5 >= to then 0 else char(s, pos + 5);
  let is_let = (if c0 == 108 then 1 else 0) * (if c1 == 101 then 1 else 0) * (if c2 == 116 then 1 else 0);
  let is_if = (if c0 == 105 then 1 else 0) * (if c1 == 102 then 1 else 0);
  let is_while = (if c0 == 119 then 1 else 0) * (if c1 == 104 then 1 else 0) * (if c2 == 105 then 1 else 0) * (if c3 == 108 then 1 else 0) * (if c4 == 101 then 1 else 0);
  let is_match = (if c0 == 109 then 1 else 0) * (if c1 == 97 then 1 else 0) * (if c2 == 116 then 1 else 0) * (if c3 == 99 then 1 else 0) * (if c4 == 104 then 1 else 0);
  let is_return = (if c0 == 114 then 1 else 0) * (if c1 == 101 then 1 else 0) * (if c2 == 116 then 1 else 0) * (if c3 == 117 then 1 else 0) * (if c4 == 114 then 1 else 0) * (if c5 == 110 then 1 else 0);
  let is_break = (if c0 == 98 then 1 else 0) * (if c1 == 114 then 1 else 0) * (if c2 == 101 then 1 else 0) * (if c3 == 97 then 1 else 0) * (if c4 == 107 then 1 else 0);
  let alen = 3 * is_let + 2 * is_if + 5 * is_while + 5 * is_match + 6 * is_return + 5 * is_break;
  let cafter = if pos + alen >= to then 0 else char(s, pos + alen);
  let ida = is_alpha(cafter) + is_digit(cafter) + (if cafter == 95 then 1 else 0);
  let any = is_let + is_if + is_while + is_match + is_return + is_break;
  any * (1 - ida) * (1 - idb)
}

// A2 commit 1: pos0 is a fresh identifier's start (caller already verified a
// non-ident char precedes it). Peek past the identifier and any whitespace
// or `//` comments -- WITHOUT consuming the caller's own scan position --
// and report whether the next real token is `(` (a call or builtin, per
// emit_ident's own identical skip_ws-then-check-`(` grammar).
fn ident_call_at(s: str, pos0: i64, strn: i64) -> i64 {
  let p = [pos0, strn];
  let idone = 0;
  while idone == 0 {
    let ae = if p[0] >= strn then 1 else 0;
    let c = if ae == 1 then 0 else char(s, p[0]);
    let isid = is_alpha(c) + is_digit(c) + (if c == 95 then 1 else 0);
    let _ = p[0] = p[0] + isid;
    let idone = 1 - isid;
    0
  };
  let _ = skip_ws(s, p);
  let cf = if p[0] >= strn then 0 else char(s, p[0]);
  if cf == 40 then 1 else 0
}

// A2 commit 1 (§3 "Commit 1: csel"): returns 1 iff [from, to) contains none
// of: an identifier followed by `(` (call/builtin), the keywords let/while/
// if/match/return/break, `[` (array literal/index), `"` (string literal),
// `{` (struct/enum ctor), `.` (field access), or anything that sets flags --
// `<`, `>`, `==`, `!=`, unary `!` (all excluded via their shared `<`/`>`/`!`
// characters, `==` via the two-char `=`+`=`). Char/string literals and `//`
// comments are skipped transparently (their content can't disqualify or
// hide a real token). A bare `(`/`)`/digit/operator is fine -- only `[` and
// `identifier(` are banned, so pure grouping and arithmetic both pass.
fn arm_is_pure(s: str, from: i64, to: i64, strn: i64) -> i64 {
  let pos = [from, strn];
  let pure = [1];
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= to then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let e1 = if pos[0] + 1 >= to then 1 else 0;
    let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
    let is_str = if ch == 34 then 1 else 0;
    let is_chr = if ch == 39 then 1 else 0;
    let is_cm = (if ch == 47 then 1 else 0) * (if ch1 == 47 then 1 else 0);
    let is_lb = if ch == 91 then 1 else 0;
    let is_brc = if ch == 123 then 1 else 0;
    let is_dot = if ch == 46 then 1 else 0;
    let is_lt = if ch == 60 then 1 else 0;
    let is_gt = if ch == 62 then 1 else 0;
    let is_bang = if ch == 33 then 1 else 0;
    let is_eq2 = (if ch == 61 then 1 else 0) * (if ch1 == 61 then 1 else 0);
    let is_kw = kw_bad_at(s, pos[0], to);
    let cb = if pos[0] <= 0 then 0 else char(s, pos[0] - 1);
    let idb = is_alpha(cb) + is_digit(cb) + (if cb == 95 then 1 else 0);
    let is_id_start = (is_alpha(ch) + (if ch == 95 then 1 else 0)) * (1 - idb);
    let is_call = is_id_start * ident_call_at(s, pos[0], strn);
    let bad = is_str + is_lb + is_brc + is_dot + is_lt + is_gt + is_bang + is_eq2 + is_kw + is_call;
    let _ = if bad > 0 then (let _ = pure[0] = 0 in 0) else 0;
    let _ = if at_end == 1 then 0
      else if is_str == 1 then skip_string(s, pos)
      else if is_chr == 1 then skip_char_lit(s, pos)
      else if is_cm == 1 then skip_line_comment(s, pos)
      else (let _ = pos[0] = pos[0] + 1 in 0);
    let done = at_end;
    0
  };
  pure[0]
}

// A2 commit 2 (hoist): find the `}` matching the `{` at pos0-1 (pos0 is the
// char right after that `{`, same convention as skip_while_cond's own
// stopping point) -- depth-tracked over `{`/`}` only, strings/chars/`//`
// comments skipped transparently so a stray brace inside one can't
// mismatch the count. Used only for a text pre-scan (never touches the
// caller's own `pos`); the real body compile finds its own end the normal
// way (emit_body's own recursive-descent parse), so the two are never
// compared -- only b0 need agree, and it does (both are skip_while_cond's
// result + 1, read at the same pos before either pass has moved anything).
fn find_body_end(s: str, pos0: i64, strn: i64) -> i64 {
  let pos = [pos0, strn];
  let depth = 1;
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let e1 = if pos[0] + 1 >= strn then 1 else 0;
    let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
    let is_str = if ch == 34 then 1 else 0;
    let is_chr = if ch == 39 then 1 else 0;
    let is_cm = (if ch == 47 then 1 else 0) * (if ch1 == 47 then 1 else 0);
    let dopen = if ch == 123 then 1 else 0;
    let dclose = if ch == 125 then 1 else 0;
    let depth = depth + dopen - dclose;
    let stop = if depth == 0 then 1 else 0;
    let _ = if stop == 1 then 0
      else if is_str == 1 then skip_string(s, pos)
      else if is_chr == 1 then skip_char_lit(s, pos)
      else if is_cm == 1 then skip_line_comment(s, pos)
      else (let _ = pos[0] = pos[0] + 1 in 0);
    let done = stop + at_end;
    0
  };
  pos[0]
}

// A2 commit 2: record a hoist candidate value, deduped, capped at 4 (the
// number of pair slots, fntab 4578..4585). `vals` is the caller's scratch
// array (len >= 4); `nvals[0]` is the running count.
fn hoist_record(vals: [i64], nvals: [i64], v: i64) -> i64 {
  let i = 0;
  let found = 0;
  while i < nvals[0] {
    let found = if vals[i] == v then 1 else found;
    let i = i + 1;
    0
  };
  let _ = if (found == 0) * (if nvals[0] < 4 then 1 else 0) == 1 then (let _ = vals[nvals[0]] = v in (let _ = nvals[0] = nvals[0] + 1 in 0)) else 0;
  0
}

// A2 commit 2: scan a `while` body's text [b0, b1) once for (a) integer
// literal tokens (decimal or `0x` hex, T99) whose value is >= 65536 AND sit
// at BRACE DEPTH 0 relative to this body's own `{` -- recorded into `vals`
// (deduped, up to 4, via hoist_record) -- and (b) the count of `let`-bound
// names (ANY depth) that will consume a NEW permanent register (word-
// boundary `let`; a `let ... in ...` expression can nest anywhere, not only
// at statement level). The depth gate on (a) matters only for a NESTED
// `while`: its own body is a fresh `{...}` at depth 1+, and a constant used
// only there must be hoisted by ITS OWN emit_while_stmt call, not by this
// (outer) one too -- std_tests/ptrless.bp and deltasync.bp both nest a
// `while` with a >=65536 FNV multiplier one level in, and without this gate
// the outer scan saw straight through the brace and tried to ALSO take a cs
// register for it, colliding with the inner loop's own hoist (its entry
// assertion, cs mask must be 0, then fires). (b) stays depth-independent:
// a nested loop's own `let`s consume real registers too, so the outer
// hoist's floor must still count them. A name already bound OUTSIDE the
// loop -- `sym_lookup` against `stab`, the same lookup sym_bind itself uses
// -- or already counted earlier in THIS scan (a body-local `seen` list, cap
// 16) is a REBIND (sym_bind reuses its existing register, §1.1 "mutable
// let"): K8H's own body rebinds x/acc/i and only genuinely introduces `bit`,
// so counting every `let` keyword blindly (the first cut of this scanner)
// starved the hoist of registers and only fit one of its two constants.
// `_` (discard) never counts either, matching sym_bind's own is_discard.
// Past the 16-name cap this over-counts, which stays SAFE (just a higher
// hoist start register, §8), never unsafe. Strings/char literals/line
// comments are skipped transparently; O(body length) once per `while`
// (read_num_val/read_ident each advance `pos` themselves, so no token is
// re-scanned char by char from this loop too).
//
// ROADMAP A2b (2026-09-08): a nested `while` no longer turns hoisting off for
// this loop. A2 declined the whole class because an outer loop's hoisted cs
// register stayed live across the inner loop's entry assertion (cs mask must
// be 0 there) -- k1ht/k4t/ptrless/deltasync. The lift is the blueprint's own
// suggestion: emit_while_stmt now RELEASES the enclosing loop's hoisted pairs
// at its own entry and RE-TAKES them (one mat_const each) after the nested
// loop's code, so the inner loop sees a clean cs mask and its own hoist may
// even reuse those registers. The depth-0 literal gate above stays: a constant
// used only inside the nested body is still hoisted by ITS OWN emit_while_stmt.
fn hoist_scan(s: str, b0: i64, b1: i64, strn: i64, stab: [i64], vals: [i64]) -> i64 {
  let pos = [b0, strn];
  let nvals = [0];
  let seen = zeros(16);
  let nseen = 0;
  let nlets = 0;
  let depth = 0;
  let unknown = 0;
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= b1 then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let e1 = if pos[0] + 1 >= b1 then 1 else 0;
    let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
    let is_str = if ch == 34 then 1 else 0;
    let is_chr = if ch == 39 then 1 else 0;
    let is_cm = (if ch == 47 then 1 else 0) * (if ch1 == 47 then 1 else 0);
    let dopen = if ch == 123 then 1 else 0;
    let dclose = if ch == 125 then 1 else 0;
    let depth = depth + dopen - dclose;
    let cb = if pos[0] <= 0 then 0 else char(s, pos[0] - 1);
    let idb = is_alpha(cb) + is_digit(cb) + (if cb == 95 then 1 else 0);
    let is_lit = is_digit(ch) * (1 - idb);
    let c2 = if pos[0] + 2 >= b1 then 0 else char(s, pos[0] + 2);
    let c3 = if pos[0] + 3 >= b1 then 0 else char(s, pos[0] + 3);
    let c4 = if pos[0] + 4 >= b1 then 0 else char(s, pos[0] + 4);
    let c5 = if pos[0] + 5 >= b1 then 0 else char(s, pos[0] + 5);
    let c6 = if pos[0] + 6 >= b1 then 0 else char(s, pos[0] + 6);
    let ida3 = is_alpha(c3) + is_digit(c3) + (if c3 == 95 then 1 else 0);
    let is_letkw = (if ch == 108 then 1 else 0) * (if ch1 == 101 then 1 else 0) * (if c2 == 116 then 1 else 0) * (1 - ida3) * (1 - idb);
    let ida5 = is_alpha(c5) + is_digit(c5) + (if c5 == 95 then 1 else 0);
    let ida6 = is_alpha(c6) + is_digit(c6) + (if c6 == 95 then 1 else 0);
    // ROADMAP A14 (2026-09-07): `new_lets` is a text count of the body's own
    // `let` names -- it does NOT see the permanent registers a match payload
    // (`some(m0) =>`) or an INLINED call's parameters (emit_call binds every
    // callee parameter as a symbol in THIS frame) bind. Under-counting them
    // puts a body bind on a hoisted register: check_reg_collision then finds
    // the cs bit taken with no window entry owning it and exits 89 (fail-
    // closed -- 92 of the A14 corpus repros). Bail out of hoisting for such a
    // body: correctness over the hoist. A call is `(` directly after an
    // identifier character; missing a spaced `f (x)` costs at worst that same
    // fail-closed 89, never a wrong value.
    let is_matchkw = (if ch == 109 then 1 else 0) * (if ch1 == 97 then 1 else 0) * (if c2 == 116 then 1 else 0) * (if c3 == 99 then 1 else 0) * (if c4 == 104 then 1 else 0) * (1 - ida5) * (1 - idb);
    let is_callp = (if ch == 40 then 1 else 0) * idb;
    // A18 (2026-09-14): bail on return/break in arms to avoid hoisting issues
    let is_ret = (if ch == 114 then 1 else 0) * (if ch1 == 101 then 1 else 0) * (if c2 == 116 then 1 else 0) * (if c3 == 117 then 1 else 0) * (if c4 == 114 then 1 else 0) * (if c5 == 110 then 1 else 0) * (1 - ida6) * (1 - idb);
    let is_brk = (if ch == 98 then 1 else 0) * (if ch1 == 114 then 1 else 0) * (if c2 == 101 then 1 else 0) * (if c3 == 97 then 1 else 0) * (if c4 == 107 then 1 else 0) * (1 - ida5) * (1 - idb);
    let unknown = if is_matchkw + is_callp + is_ret + is_brk > 0 then 1 else unknown;
    let _ = if is_lit == 1 then (let v = read_num_val(s, pos) in (let _ = if (v >= 65536) * (if depth == 0 then 1 else 0) == 1 then hoist_record(vals, nvals, v) else 0 in 0)) else 0;
    let _ = if is_letkw == 1 then (let _ = pos[0] = pos[0] + 3 in skip_ws(s, pos)) else 0;
    let namepos = pos[0];
    let name = if is_letkw == 1 then read_ident(s, pos) else 0;
    let is_disc = if name == 95 then 1 else 0;
    let prior = if is_letkw == 1 then sym_lookup(s, stab, name, namepos) else 0 - 1;
    let si = 0;
    let sdup = 0;
    while si < nseen {
      let sdup = if seen[si] == name then 1 else sdup;
      let si = si + 1;
      0
    };
    let is_newname = is_letkw * (1 - is_disc) * (if prior < 0 then 1 else 0) * (1 - sdup);
    let nlets = nlets + is_newname;
    let room = if nseen < 16 then 1 else 0;
    let _ = if is_newname * room == 1 then (let _ = seen[nseen] = name in 0) else 0;
    let nseen = nseen + is_newname * room;
    let _ = if is_lit == 1 then 0
      else if is_letkw == 1 then 0
      else if is_str == 1 then skip_string(s, pos)
      else if is_chr == 1 then skip_char_lit(s, pos)
      else if is_cm == 1 then skip_line_comment(s, pos)
      else (let _ = pos[0] = pos[0] + 1 in 0);
    let done = if pos[0] >= b1 then 1 else 0;
    0
  };
  // 99 pushes hfrom past the 8 cs registers -> havail 0 -> hn 0 (no hoist).
  nlets + 99 * unknown
}

// A2 commit 2: release `hn` hoisted pairs starting at cs index `hfrom`
// (registers 19+hfrom .. 19+hfrom+hn-1) and clear their table cells.
fn hoist_release(fntab: [i64], hfrom: i64, hn: i64) -> i64 {
  let k = 0;
  while k < hn {
    let _ = vs_cs_free(fntab, 19 + hfrom + k, 31);
    let _ = fntab[5394 + 2 * k] = 0;
    let _ = fntab[5395 + 2 * k] = 0;
    let k = k + 1;
    0
  };
  0
}

// Emit one 'while cond { body };' statement: a real backward loop (no result).
// B5 (D14 item 1, research S2): loop rotation, bottom test -- one branch per
// iteration in steady state instead of two. The condition is parsed and
// emitted ONCE, at the bottom: skip_while_cond finds the body's '{' without
// parsing the condition, the body is emitted, then pos rewinds to pcond to
// parse+emit the condition for real and jumps forward to b1 (already
// recorded) rather than re-scanning the body text it already emitted.
// Mutable `let` (sym_bind reuse) makes loop vars update in place, so
// re-running the cond reads the updated values.
fn emit_while_stmt(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], cx: [i64], st: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 5;
  let _ = skip_ws(s, pos);
  let pcond = pos[0];
  let cnt0 = stab[0];
  let brk0 = fntab[5666];
  let ldepth = fntab[5246];
  let _ = fntab[5246] = ldepth + 1;
  // ROADMAP A6 step 2 (2026-09-09): fntab[5246] is the LIVE depth and is
  // restored on the way out, so it cannot size the frame. fntab[5404] is the
  // per-fn HIGH-WATER (max nesting + 1 = the number of mark cells the frame
  // must carry), published as the `marks` fact by compile_fn_at_total_saved.
  // 4800 is free in the register-model map (4547/4548, 4573-4577, 4578-4585
  // hoist pairs, 4591/4592 arm bases, 4640-4652, 4750 are all taken).
  let _ = if ldepth + 1 > fntab[5404] then fntab[5404] = ldepth + 1 else 0;
  let slot_ok = if ldepth <= 20 then 1 else 0;
  // statement context: the window is normally empty here; park makes it
  // exact for the inline-call path (a `let` binding an inlined call's
  // result before a nested while, say).
  let _ = vs_park(insns, n, fntab, stab, 0);
  let _ = if fntab[5388] != 255 then selfcheck_exit(5, 1) else 0;
  // ROADMAP A2b (2026-09-08): if an ENCLOSING loop is mid-hoist, its cs temps
  // are live right now and the assertion below (cs mask must be 0 at a loop
  // entry) would fire -- that is exactly why A2 declined to hoist any body
  // containing a nested `while`. Release them here and re-take them after this
  // loop's code (the tail of this fn), so the inner loop compiles against a
  // clean mask and may reuse the very same registers. Cost is one mat_const per
  // outer pair per OUTER iteration, paid outside the inner loop; the outer
  // hoist's own `hfrom` floor (cnt0 + new_lets, new_lets counted at ANY depth)
  // already sits above every symbol the whole outer body binds, including the
  // inner loop's, so the re-take can never land on a bound symbol register.
  let osave = zeros(8);
  let oscan = 0;
  let onh = 0;
  while oscan < 4 {
    let orv = fntab[5394 + 2 * oscan];
    let orr = fntab[5395 + 2 * oscan];
    let olive = if orr > 0 then 1 else 0;
    let _ = if olive == 1 then (let _ = osave[2 * onh] = orv in (let _ = osave[2 * onh + 1] = orr in vs_cs_free(fntab, orr, 32))) else 0;
    let onh = onh + olive;
    let _ = fntab[5394 + 2 * oscan] = 0;
    let _ = fntab[5395 + 2 * oscan] = 0;
    let oscan = oscan + 1;
    0
  };
  let _ = if fntab[5389] != 0 then selfcheck_exit(6, 5) else 0;
  // A2 commit 2 (constant hoisting, §3 blueprint): pre-scan the body text
  // (a throwaway copy of pos, never the real one) for 64-bit literals,
  // materialise up to 4 of them ONCE here -- before pmark/pjump, so this
  // code runs exactly once at loop entry, never inside the repeated body --
  // into free cs registers strictly ABOVE every register the body's own
  // `let`s will bind (§8 risk: cnt0 + new_lets, new_lets a conservative
  // text-scan upper bound). cnt0 == stab[0] here (nothing has bound a
  // target-program register yet), so it is available in both the planning
  // and emission passes from the same published state, and vs_cs_take
  // already bumps cs_hi (fntab[5391]) so the prologue saves them.
  let strn0 = slen(s, pos);
  let hpos = [pcond, strn0];
  let _ = skip_while_cond(s, hpos);
  let hb0 = hpos[0] + 1;
  let hb1 = find_body_end(s, hb0, strn0);
  let hvals = zeros(4);
  let new_lets = hoist_scan(s, hb0, hb1, strn0, stab, hvals);
  let hnv = (if hvals[0] != 0 then 1 else 0) + (if hvals[1] != 0 then 1 else 0) + (if hvals[2] != 0 then 1 else 0) + (if hvals[3] != 0 then 1 else 0);
  let hfrom = cnt0 + new_lets;
  let havail = if hfrom < 8 then 8 - hfrom else 0;
  let hn = if hnv < havail then hnv else havail;
  let _ = fntab[5394] = 0;
  let _ = fntab[5395] = 0;
  let _ = fntab[5396] = 0;
  let _ = fntab[5397] = 0;
  let _ = fntab[5398] = 0;
  let _ = fntab[5399] = 0;
  let _ = fntab[5400] = 0;
  let _ = fntab[5401] = 0;
  let hk = 0;
  while hk < hn {
    let hcr = 19 + hfrom + hk;
    let _ = mat_const(insns, n, hvals[hk], hcr);
    let _ = vs_cs_take(fntab, hcr, 30);
    let _ = if hfrom + hk + 1 > fntab[5391] then fntab[5391] = hfrom + hk + 1 else 0;
    let _ = fntab[5394 + 2 * hk] = hvals[hk];
    let _ = fntab[5395 + 2 * hk] = hcr;
    let hk = hk + 1;
    0
  };
  // T43 mark placeholder: a nop that becomes str x14,[sp,#80+8*depth]
  // (0xF90003EE + imm12<<10, as+objdump) once the body proves reset-safe.
  let pmark = n[0];
  let _ = em(insns, n, 3573751839);
  // forward placeholder `b -> test` (emit_cond's `b -> end` pattern),
  // patched once test's address is known below.
  let pjump = n[0];
  let _ = em(insns, n, 335544320);
  let body_start = n[0];
  let _ = skip_while_cond(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let b0 = pos[0];
  let bresl = emit_body(s, pos, insns, n, stab, selfname, selfstart, fntab, cx, st);
  let b1 = pos[0];
  let blastl = bresl - (bresl / 2) * 2;
  // emit_body's own lastf flag: the body leaves a final expression tag on
  // the window exactly when blastl == 1 (let/while/compound leave nothing).
  // A lazy CONST/SYM/etc. tag drops for free; nothing to "retract" (T96
  // step 2b's dead-literal scan is obsolete: a bare trailing `0` is a CONST
  // tag that never emitted a word in the first place).
  let _ = if blastl == 1 then vs_pop(fntab) else 0;
  // A2 commit 2: release the hoisted pairs right after the body compiles,
  // before the bottom-test condition is recompiled below -- the existing
  // selfcheck_exit(6, 4) invariant a few lines down requires the cs mask back at
  // 0 there, and hoisting is scoped to the loop body's own text anyway
  // (the condition is a separate reparse from pcond, not part of the body).
  let _ = hoist_release(fntab, hfrom, hn);
  // T43 reset: only when the body allocated on x14 and the text scan proves
  // no allocated pointer can leave the iteration. Once per iteration, right
  // after the body, before falling into the bottom test (same position
  // relative to the body as the old top-test loop's pre-backward-branch reset).
  let allocs = count_word(insns, body_start, n[0], 2853897184);
  let safe = if allocs > 0 then loop_alloc_safe(s, b0, b1, stab, cnt0) else 0;
  let do_reset = slot_ok * (if allocs > 0 then 1 else 0) * safe;
  let ldrw = 4181722107 + (10 + ldepth) * 1024;
  let _ = if do_reset == 1 then (let _ = em(insns, n, ldrw) in 0) else 0;
  // bottom test: parse+emit the condition here (once), then jump the text
  // pointer straight to b1 instead of re-scanning the already-emitted body.
  let test = n[0];
  let _ = insns[pjump] = 335544320 + (test - pjump);
  let _ = pos[0] = pcond;
  let _ = fntab[5542] = 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = fntab[5542] = 0;
  let bw = vs_loop_branch(insns, n, fntab, stab);
  let _ = vs_pop(fntab);
  let _ = if fntab[5388] != 255 then selfcheck_exit(5, 2) else 0;
  let _ = if fntab[5389] != 0 then selfcheck_exit(6, 6) else 0;
  // The bottom branch continues the loop on its OWN (non-inverted) tag and
  // is backward to body_start; the target is already fixed, so it is
  // emitted directly instead of placeholder+patch (the old `b loop_start`
  // pattern). B.cond/cbnz's imm19 sits at bits[23:5] (* 32), and a negative
  // (backward) delta borrows into bit 24, so this needs +16777216 the same
  // way the old unconditional backward `b` needed +0x04000000 for its imm26
  // at bit 0 -- derived with as+objdump, see $OUT/words.objdump (70/70 exact
  // matches across gap sizes and every condition code).
  let _ = em(insns, n, bw + 16777216 + (body_start - n[0]) * 32);
  let _ = pos[0] = b1;
  let endl = n[0];
  let _ = patch_jumps(insns, fntab, 5666, brk0, endl);
  let _ = if do_reset == 1 then (let _ = em(insns, n, ldrw) in 0) else 0;
  let _ = if do_reset == 1 then (let _ = insns[pmark] = 4177527803 + (10 + ldepth) * 1024 in 0) else 0;
  let _ = fntab[5246] = ldepth;
  // ROADMAP A2b: re-take the enclosing loop's hoisted constants (see the
  // release above). Emitted AFTER this loop's backward branch, so it runs once
  // per OUTER iteration, never inside this loop.
  let orst = 0;
  while orst < onh {
    let rrv = osave[2 * orst];
    let rrr = osave[2 * orst + 1];
    let _ = mat_const(insns, n, rrv, rrr);
    let _ = vs_cs_take(fntab, rrr, 33);
    let _ = fntab[5394 + 2 * orst] = rrv;
    let _ = fntab[5395 + 2 * orst] = rrr;
    let orst = orst + 1;
    0
  };
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let strnW = slen(s, pos);
  let cW = if pos[0] >= strnW then 0 else char(s, pos[0]);
  let _ = if cW == 59 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  n[0]
}

// Emit one 'let x = value;' statement: emit value, pop x0, mov x<reg>,x0
// (bind the single-letter var x to reg 19+(x-'a')).
// A21 step 2: `let (a, b[, c]) = f(args);` binds k <= 3 names from x0..x(k-1).
// The CALLEE's declared arity must equal k (E119) -- that check is the whole reason
// a silent x1 read cannot happen. Names are sym_bind'd BEFORE the RHS is emitted,
// exactly as a scalar `let` does, so `let (a, b) = f(a, b)` shadow-rebinds the same
// way. Caller cost is ZERO words: emit_bl_call already left x1/x2 live and unowned,
// so claiming them is two window pushes and no instruction. A `_` component is
// popped instead of bound, like `let _ = e;`.
fn emit_let_tuple(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let regs = zeros(3);
  let k = [0];
  let go = 1;
  while go == 1 {
    let _ = skip_ws(s, pos);
    let npos = pos[0];
    let nm = read_ident(s, pos);
    let _ = if k[0] >= 3 then diag_exit(s, npos, 121) else 0;
    let rg = sym_bind(s, stab, nm, npos);
    let _ = check_reg_collision(s, insns, n, fntab, stab, rg, npos);
    let _ = regs[k[0]] = if nm == 95 then 0 - 1 else rg;
    let _ = k[0] = k[0] + 1;
    let _ = skip_ws(s, pos);
    let cc = if pos[0] >= slen(s, pos) then 0 else char(s, pos[0]);
    let _ = if cc == 44 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let go = if cc == 44 then 1 else 0;
    0
  };
  let _ = skip_ws(s, pos);
  let crp = if pos[0] >= slen(s, pos) then 0 else char(s, pos[0]);
  let _ = if crp == 41 then 0 else diag_exit(s, pos[0], 95);
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let ceqc = if pos[0] >= slen(s, pos) then 0 else char(s, pos[0]);
  let _ = if ceqc == 61 then 0 else diag_exit(s, pos[0], 95);
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  // the RHS must name a fn whose declared arity is exactly k
  let rpos = pos[0];
  let pk = [rpos, slen(s, pos)];
  let rname = read_ident(s, pk);
  let want = fn_ret_arity(s, rname, fntab, pk[1]);
  let _ = if want == k[0] then 0 else diag_exit(s, rpos, 119);
  let _ = fntab[7102] = rname;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = fntab[7102] = 0;
  // x1 (and x2) still hold components 1..k-1: claim them, then bind TOP-DOWN so
  // component j lands in name j.
  let q = [1];
  while q[0] < k[0] {
    let _ = vs_push(insns, n, fntab, stab, 2, q[0], 0 - 1);
    let _ = q[0] = q[0] + 1;
    0
  };
  let b = [k[0] - 1];
  while b[0] >= 0 {
    let _ = if regs[b[0]] < 0 then vs_pop(fntab) else vs_bind(insns, n, fntab, stab, regs[b[0]]);
    let _ = b[0] = b[0] - 1;
    0
  };
  let _ = skip_ws(s, pos);
  let csm = if pos[0] >= slen(s, pos) then 0 else char(s, pos[0]);
  let _ = if csm == 59 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  n[0]
}

// A21 step 2: `let` dispatches on the character after the keyword -- `(` is the
// destructuring form, anything else is the scalar `let` this fn always was.
fn emit_let_stmt(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], cx: [i64], st: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 3;
  let _ = skip_ws(s, pos);
  let c0t = if pos[0] >= slen(s, pos) then 0 else char(s, pos[0]);
  if c0t == 40 then emit_let_tuple(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else emit_let_scalar(s, pos, insns, n, stab, selfname, selfstart, fntab, cx, st)
}

fn emit_let_scalar(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], cx: [i64], st: [i64]) -> i64 {
  let npos = pos[0];
  let name = read_ident(s, pos);
  let reg = sym_bind(s, stab, name, npos);
  let _ = check_reg_collision(s, insns, n, fntab, stab, reg, npos);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  // F3: publish this name's static cell length (0 = unknown). Written on EVERY
  // let, so a rebinding that changes the array also replaces the length.
  let _ = skip_ws(s, pos);
  let lk = if reg >= 19 then (if reg <= 26 then reg - 19 else 0 - 1) else (if reg >= 100 then reg - 92 else 0 - 1);
  let _ = if lk >= 0 then fntab[5410 + lk] = rhs_len_p1(s, pos[0], slen(s, pos)) else 0;
  // ---- chained discard-assign: `let _ = NAME = RHS;` lowers to NAME<-RHS ----
  let _ = skip_ws(s, pos);
  let sq0 = pos[0];
  let strq = slen(s, pos);
  let cq0 = if sq0 >= strq then 0 else char(s, sq0);
  let qa0 = is_alpha(cq0);
  let wq0 = [sq0];
  let hq0 = [0];
  let qgo0 = qa0;
  while qgo0 == 1 {
    let ccq0 = if wq0[0] >= strq then 0 else char(s, wq0[0]);
    let ga0 = is_alpha(ccq0);
    let gd0 = (if ccq0 >= 48 then 1 else 0) * (if ccq0 <= 57 then 1 else 0);
    let gu0 = if ccq0 == 95 then 1 else 0;
    let adv0 = ga0 + gd0 + gu0;
    let _ = if adv0 == 1 then (let _ = hq0[0] = hq0[0] * 131 + ccq0 in 0) else 0;
    let _ = wq0[0] = wq0[0] + adv0;
    let qgo0 = adv0;
    0
  };
  let e1q = if wq0[0] >= strq then 1 else 0;
  let qws = [wq0[0]];
  let qwg = 1 - e1q;
  while qwg == 1 {
    let cqw = if qws[0] >= strq then 0 else char(s, qws[0]);
    let isspw = if cqw == 32 then 1 else 0;
    let _ = if isspw == 1 then (let _ = qws[0] = qws[0] + 1 in 0) else 0;
    let qwg = isspw;
    0
  };
  let eq1 = if qws[0] >= strq then 0 else char(s, qws[0]);
  let eq2 = if qws[0] + 1 >= strq then 0 else char(s, qws[0] + 1);
  let is_chain = qa0 * (if eq1 == 61 then 1 else 0) * (if eq2 == 61 then 0 else 1);
  let treg_c = sym_lookup(s, stab, hq0[0], sq0);
  let unbound_c = is_chain * (if treg_c < 0 then 1 else 0);
  let _ = if unbound_c == 1 then diag_exit(s, sq0, 101) else 0;
  // ---- planning phase: every decision flag is computed BEFORE emission;
  // the emitter below only executes, it never re-decides ----
  let treg_chain = if treg_c >= 19 then treg_c else reg;
  let treg_i = if is_chain == 1 then treg_chain else reg;
  let _ = if is_chain == 1 then (let _ = pos[0] = qws[0] + 1 in (let _ = skip_ws(s, pos) in 0)) else 0;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let strnV = slen(s, pos);
  let cV = if pos[0] >= strnV then 0 else char(s, pos[0]);
  // T90 step 2 (2026-09-06): `;` or the closing `}` / end of input, nothing else (lax d10:
  // `let q = 5 let r = 6;` was accepted, the second let simply became the next item)
  let cV1 = if pos[0] + 1 >= strnV then 0 else char(s, pos[0] + 1);
  let cV2 = if pos[0] + 2 >= strnV then 0 else char(s, pos[0] + 2);
  let idV2 = is_alpha(cV2) + is_digit(cV2) + (if cV2 == 95 then 1 else 0);
  let inV = (if cV == 105 then 1 else 0) * (if cV1 == 110 then 1 else 0) * (1 - idV2);
  let okV = (if cV == 59 then 1 else 0) + (if cV == 125 then 1 else 0) + (if cV == 0 then 1 else 0) + inV;
  let _ = if okV >= 1 then 0 else diag_exit(s, pos[0], 95);
  let _ = if cV == 59 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  // A15 (2026-09-08): CONSUME the `in` terminator. Before the unbound-symbol
  // diagnostic existed, leaving it made emit_body classify `in <body>` as a
  // plain expression item, so `in` was read as an identifier and emitted as a
  // variable with sym_lookup == -1 -- a dead value that the item pop discarded.
  // With diag 101 that dead read is a hard error (c14_string), so the parser
  // now does what it always meant to: the statement owns its own `in`.
  let _ = if inV == 1 then (let _ = pos[0] = pos[0] + 2 in 0) else 0;
  // `let _ = e;` (name hash 95, discard): drop the value, no word, no register.
  let is_discard = (1 - is_chain) * (if name == 95 then 1 else 0);
  let _ = if is_discard == 1 then vs_pop(fntab) else vs_bind(insns, n, fntab, stab, treg_i);
  n[0]
}



// Emit a function body: zero or more 'let x = v;' statements, then the result
// expression.
// Emit a function/loop body: ';'-separated items until '}' or end of input.
// Items: 'let x = v;' (net 0 words), 'while ... { ... };' (net 0), or a plain
// expression (net +1 word on the value stack). All expression values except
// the FINAL one are popped, so the body leaves exactly one value -- matching
// interpreter semantics where ';' sequences statements and an if-expression
// ENDS at the first ';' outside parens (parity bug: the old body parser ran
// one expression to end-of-input, letting `if c then a else b; rest`
// swallow the rest into the else branch).
// Compound statement item: IDENT (+|-|*|/|%)= expr ';'
// Lowers to shadow-rebind: reg = sym_bind(name); old -> stack; rhs ->
// stack; binop; vs_bind(reg). Consumes the trailing ';'.
fn emit_compound_stmt(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let npos = pos[0];
  let name = read_ident(s, pos);
  let reg0 = sym_lookup(s, stab, name, npos);
  let _ = if reg0 < 0 then diag_exit(s, npos, 101) else 0;
  let _ = skip_ws(s, pos);
  let opch = if pos[0] >= slen(s, pos) then 0 else char(s, pos[0]);
  let is_add = if opch == 43 then 1 else 0;
  let is_sub = if opch == 45 then 1 else 0;
  let is_mul = if opch == 42 then 1 else 0;
  let is_div = if opch == 47 then 1 else 0;
  let is_mod = if opch == 37 then 1 else 0;
  let opcode = is_add * 2 + is_sub * 3 + is_mul * 4 + is_div * 5 + is_mod * 11;
  let is_plain = if opch == 61 then 1 else 0;
  let _ = pos[0] = pos[0] + 2;
  let _ = if is_plain == 1 then emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab) else emit_compound_rhs(s, pos, insns, n, stab, selfname, selfstart, fntab, reg0, opcode);
  let _ = vs_bind(insns, n, fntab, stab, reg0);
  let _ = skip_ws(s, pos);
  let strnC = slen(s, pos);
  let cC = if pos[0] >= strnC then 0 else char(s, pos[0]);
  let _ = if cC == 59 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  n[0]
}

// old -> new (retarget makes `i = i - 1` / `i -= 1` one word): push SYM x,
// the RHS, combine, then vs_bind(x).
// BUGFIX (A4 fuzz DIVERGE hunt, 2026-09-07): `x op= e` used to leave x as a
// lazy SYM tag (emit_var) while e was compiled -- if e contains a nested
// `let _ = x = ... in ...` (emit_let_chain) that reassigns x's own register
// or slot, vs_binop below reads x's CURRENT (post-e) value, not the value x
// held when the statement started. `x op= e` means `x = x_old + e` with
// x_old captured BEFORE e's side effects (bpref.py and the pre-A1 stack
// machine both do this; repro: `let v0=100; v0 += (let _ = v0 = 7 in 3);`
// must give 103, gave 10). Fix: materialise x into a fresh window register
// right away (vs_mat handles both a plain register SYM and a spilled-slot
// SYM identically), so nothing e does afterward can change the captured
// value.
fn emit_compound_rhs(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], reg0: i64, opcode: i64) -> i64 {
  let _ = emit_var(insns, n, reg0, fntab, stab);
  let d = vs_alloc(insns, n, fntab, stab);
  let _ = vs_mat(insns, n, fntab, stab, fntab[5387] - 1, d);
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  vs_binop(insns, n, fntab, stab, opcode)
}

// Register-model exit-89 rewrite: emit_body had 74 distinct local names (+10
// params = 84 symbols; S alone would be 76, already past the 64-slot cap
// before counting any temp-slot pressure). The per-character keyword
// classification (is_let/is_while/is_ret/is_brk and their ~25 intermediate
// ch/e/id locals) is pure lookahead with no side effect beyond `cls`, so it
// moves into its own function -- a fresh call frame is a fresh, small stab.
fn emit_body_classify(s: str, pos: [i64], strn: i64, cls: [i64]) -> i64 {
  let at_end0 = if pos[0] >= strn then 1 else 0;
  let ch = if at_end0 == 1 then 0 else char(s, pos[0]);
  let ch1 = if pos[0] + 1 >= strn then 0 else char(s, pos[0] + 1);
  let ch2 = if pos[0] + 2 >= strn then 0 else char(s, pos[0] + 2);
  let ch3 = if pos[0] + 3 >= strn then 0 else char(s, pos[0] + 3);
  let ch4 = if pos[0] + 4 >= strn then 0 else char(s, pos[0] + 4);
  let is_l = if ch == 108 then 1 else 0;
  let is_e = if ch1 == 101 then 1 else 0;
  let is_t = if ch2 == 116 then 1 else 0;
  let b3_num = (if ch3 >= 48 then 1 else 0) * (if ch3 <= 57 then 1 else 0);
  let is_let = is_l * is_e * is_t * (1 - is_alpha(ch3)) * (1 - b3_num) * (if ch3 == 95 then 0 else 1);
  let is_w = if ch == 119 then 1 else 0;
  let is_h = if ch1 == 104 then 1 else 0;
  let is_i = if ch2 == 105 then 1 else 0;
  let is_l2 = if ch3 == 108 then 1 else 0;
  let is_e2 = if ch4 == 101 then 1 else 0;
  let is_while = is_w * is_h * is_i * is_l2 * is_e2;
  // T99 (2026-09-04): `return e;` and `break;` are statements (literal forms:
  // one `b` each), recognised by keyword + a non-identifier follower.
  let ch5 = if pos[0] + 5 >= strn then 0 else char(s, pos[0] + 5);
  let ch6 = if pos[0] + 6 >= strn then 0 else char(s, pos[0] + 6);
  let id5 = is_alpha(ch5) + is_digit(ch5) + (if ch5 == 95 then 1 else 0);
  let id6 = is_alpha(ch6) + is_digit(ch6) + (if ch6 == 95 then 1 else 0);
  let is_ret = (if ch == 114 then 1 else 0) * (if ch1 == 101 then 1 else 0) * (if ch2 == 116 then 1 else 0) * (if ch3 == 117 then 1 else 0) * (if ch4 == 114 then 1 else 0) * (if ch5 == 110 then 1 else 0) * (1 - id6);
  let is_brk = (if ch == 98 then 1 else 0) * (if ch1 == 114 then 1 else 0) * (if ch2 == 101 then 1 else 0) * (if ch3 == 97 then 1 else 0) * (if ch4 == 107 then 1 else 0) * (1 - id5);
  let at_close = if ch == 125 then 1 else 0;
  let is_item = (1 - at_close) * (1 - at_end0);
  let _ = cls[0] = at_end0;
  let _ = cls[1] = ch;
  let _ = cls[2] = is_let;
  let _ = cls[3] = is_while;
  let _ = cls[4] = is_ret;
  let _ = cls[5] = is_brk;
  let _ = cls[6] = at_close;
  let _ = cls[7] = is_item;
  0
}

fn emit_body(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], cx: [i64], st: [i64]) -> i64 {
  let done = 0;
  let lastf = 0;
  let cls = zeros(8);
  while done == 0 {
    let before = pos[0];
    let _ = skip_ws(s, pos);
    let strn = slen(s, pos);
    let _ = emit_body_classify(s, pos, strn, cls);
    let at_end0 = cls[0];
    let ch = cls[1];
    let is_let = cls[2];
    let is_while = cls[3];
    let is_ret = cls[4];
    let is_brk = cls[5];
    let at_close = cls[6];
    let is_item = cls[7];
    let _ = if is_item * is_let == 1 then emit_let_stmt(s, pos, insns, n, stab, selfname, selfstart, fntab, cx, st) else 0;
    let _ = if is_item * is_while == 1 then emit_while_stmt(s, pos, insns, n, stab, selfname, selfstart, fntab, cx, st) else 0;
    let _ = if is_item * is_ret == 1 then emit_return_stmt(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let _ = if is_item * is_brk == 1 then emit_break_stmt(s, pos, insns, n, fntab) else 0;
    // compound statement? ident-start (not let/while) followed by ws + one of +-*/% then '='
    let id_start = is_alpha(ch) * (1 - is_let) * (1 - is_while) * (1 - is_ret) * (1 - is_brk);
    let wq = pos[0];
    let id_go = id_start;
    while id_go == 1 {
      let ccq = if wq >= strn then 0 else char(s, wq);
      let g_a = is_alpha(ccq);
      let g_d = (if ccq >= 48 then 1 else 0) * (if ccq <= 57 then 1 else 0);
      let g_u = if ccq == 95 then 1 else 0;
      let adv = g_a + g_d + g_u;
      let wq = wq + adv;
      let id_go = adv;
      0
    };
    let wq2 = if wq >= strn then wq else wq + ceq(s, wq, 32);
    let oc = if wq2 >= strn then 0 else char(s, wq2);
    let nc = if wq2 + 1 >= strn then 0 else char(s, wq2 + 1);
    let ok_op = (if oc == 43 then 1 else 0) + (if oc == 45 then 1 else 0) + (if oc == 42 then 1 else 0) + ((if oc == 47 then 1 else 0) * (if nc != 47 then 1 else 0)) + (if oc == 37 then 1 else 0);
    let is_compound = id_start * (if nc == 61 then ok_op else 0);
    let _ = if is_item * is_compound == 1 then emit_compound_stmt(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let is_expr = is_item * (1 - is_let) * (1 - is_while) * (1 - is_compound) * (1 - is_ret) * (1 - is_brk);
    let nb_item_w = fntab[5387];
    // F3 refined: dead-value suppression applies ONLY to the final expr
    // item of a while body (lookahead: next non-ws char is rbrace / EOF)
    let _ = skip_ws(s, pos);
    let strnE = slen(s, pos);
    let cE = if pos[0] >= strnE then 0 else char(s, pos[0]);
    let fin_brace = if cE == 125 then 1 else 0;
    let fin_eof = if pos[0] >= strnE then 1 else 0;
    let _ = cx[28] = is_expr * (fin_brace + fin_eof);
    let _ = cx[28] = 0;
    // planning phase: legacy-only decisions (the fast-path dispatch is
    // deleted; was_fast is the constant 0) -- every flag is fixed BEFORE
    // the emitter below runs, so guard and codegen can never desync
    let was_fast = 0;
    // A21 step 2: offer TUPLE position to an item-initial `(`. The fn's own tail
    // expression is exactly such an item, so this is the tuple-tail form; a
    // NON-final one is legal too and is drained by the non-final pop below.
    let _ = fntab[7100] = if is_expr * (if cE == 40 then 1 else 0) == 1 then pos[0] else 0 - 1;
    let _ = if is_expr == 1 then emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    // non-final legacy items must not leave values on the stack
    let _ = skip_ws(s, pos);
    let strn9 = slen(s, pos);
    let c9 = if pos[0] >= strn9 then 0 else char(s, pos[0]);
    let not_rbrace = if c9 == 125 then 0 else 1;
    let not_eof = if pos[0] >= strn9 then 0 else 1;
    let grew = if fntab[5387] > nb_item_w then 1 else 0;
    let leg_item = grew;
    let ma1 = if is_expr == 0 then 0 else not_rbrace;
    let more_ahead = if ma1 == 0 then 0 else not_eof;
    let _ = if more_ahead * leg_item == 1 then vs_pop(fntab) else 0;
    // statement boundary (bug 9): every item except the fn's own final
    // tail expression drains the window to 0 here (a `let`/`while`/
    // `return`/`break`/compound never leaves a value; a non-final expr
    // item was just popped above) -- assert the invariant whenever that
    // happened, skip it for the one case (the tail item) where w==1 by
    // design (fntab[5387]!=0 guards exactly that case).
    let _ = if (fntab[5387] == 0) * (if fntab[5388] != 255 then 1 else 0) == 1 then diag_exit(s, before, 102) else 0;
    // A2 commit 2: a live hoisted pair legitimately keeps a cs bit set
    // across this item boundary (§ hoist_mask) -- subtract it before the
    // leak check, everywhere else this is a no-op (hoist_mask is 0).
    let _ = if (fntab[5387] == 0) * (if (fntab[5389] & (255 - hoist_mask(fntab))) != 0 then 1 else 0) == 1 then selfcheck_exit(7, 1) else 0;
    // bug 9 hunt (2026-09-06): the check above only fires when w IS 0 -- a
    // leaked WINDOW ENTRY (not just leaked mask bits) leaves w != 0 after a
    // non-tail item and silently escapes it forever (every later item's
    // w==0 check is skipped too, since w never returns to 0 again). Assert
    // the stronger form: any item that is not the fn's own final tail expr
    // must leave the window EMPTY, period.
    let must_be_empty = is_item * (1 - is_expr * (1 - more_ahead));
    let _ = if (must_be_empty == 1) * (if fntab[5387] != 0 then 1 else 0) == 1 then selfcheck_exit(8, 1) else 0;
    // ROADMAP A14 (2026-09-07): the window is EMPTY at every item boundary
    // except the fn's own tail (the two asserts above), so every temp SLOT
    // this item parked into is dead -- reset the cursor so the next item
    // reuses them. Without it the cursor only grows, and A14's path-
    // independent parks (vs_park_move / fntab[5403]) push a long function
    // past `s0 + tsp0 > 64` in compile_fn_at_facts. fntab[5392] keeps the
    // high-water mark, so the frame size is unchanged by the reuse, and both
    // passes reset at the same published point.
    let _ = if fntab[5387] == 0 then fntab[5390] = 0 else 0;
    // lastf = 1 exactly when the body leaves ONE value on the stack
    // (final item was an expr and no more items followed it): the while
    // and fn emitters pop that value, and must NOT pop otherwise
    let lastf = if is_item == 1 then is_expr * (1 - more_ahead) else lastf;
    let _ = skip_ws(s, pos);
    let strn2 = slen(s, pos);
    let at_end1 = if pos[0] >= strn2 then 1 else 0;
    let c2 = if at_end1 == 1 then 0 else char(s, pos[0]);
    let is_semi = if c2 == 59 then 1 else 0;
    let _ = if is_semi == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    // progress guard: a dispatch that consumed nothing must not spin forever
    let advanced = if pos[0] > before then 1 else 0;
    let stuck = (1 - advanced) * (1 - at_close) * (1 - at_end0);
    let _ = if stuck == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let done = if at_close + at_end0 >= 1 then 1 else 0;
    0
  };
  n[0] * 2 + lastf
}

// Scan s for the definition "fn <fname>(" (single-letter fn name); record the
// position of its 'fn' in out[0], return 1 if found.
fn find_fn(s: str, name: i64, out: [i64]) -> i64 {
  // Lexical scan: skips strings/comments; requires ident char after "fn "
  // (scanner source text like `is_fn =` must not register phantoms).
  let strn = str_len(s);
  let j = 0;
  let tpos_c = [0, 0];
  let spc = [0];
  let cpc = [0];
  let found = 0;
  let best = 0;
  while j + 2 < strn {
    let c0 = char(s, j);
    let c1 = char(s, j + 1);
    let c2 = char(s, j + 2);
    let is_quote = if c0 == 34 then 1 else 0;
    let is_sl = if c0 == 47 then 1 else 0;
    let is_sl2 = if c1 == 47 then 1 else 0;
    let is_comment = is_sl * is_sl2;
    let isf = if c0 == 102 then 1 else 0;
    let isn = if c1 == 110 then 1 else 0;
    let issp = if c2 == 32 then 1 else 0;
    let cafter = if isf * isn * issp == 1 then char(s, j + 3) else 0;
    let is_fn = isf * isn * issp * (1 - is_quote) * (1 - is_comment) * is_alpha(cafter);
    let _ = tpos_c[0] = j + 3;
    let h = if is_fn == 1 then read_ident(s, tpos_c) else 0;
    let is_match = if h == name then 1 else 0;
    let hit = is_fn * is_match;
    let best = if hit == 1 then j else best;
    let found = if hit == 1 then 1 else found;
    let _ = spc[0] = j;
    let _ = cpc[0] = j;
    let _ = if is_quote == 1 then skip_string(s, spc) else 0;
    let _ = if is_comment == 1 then skip_line_comment(s, cpc) else 0;
    let jnext = (j + 1) * (1 - is_quote - is_comment - is_fn) + spc[0] * is_quote + cpc[0] * is_comment + tpos_c[0] * is_fn;
    let j = jnext;
    0
  };
  let _ = out[0] = best;
  found
}


// Inline a function call: find fname's def, bind args to its params (a->x19,
// b->x20, ...), emit the callee body from its source position, restore pos.
// Skip a parenthesised argument list LEXICALLY: pos is just after the opening
// "(", and stops ON the matching ")" (paren depth + strings + line comments;
// /* */ block comments are not skipped -- the corpus uses // only). Pure pos
// arithmetic, no emitter state. Shared by the unresolved-callee path of
// emit_call and by emit_match's payload scan (T42 2026-09-04: the payload
// used to end at the FIRST ")", so `match many((3)) {..}` bound `(3`).
fn skip_args(s: str, pos: [i64]) -> i64 {
  let go = 1;
  let depth = 0;
  while go == 1 {
    let strn3 = slen(s, pos);
    let at_end3 = if pos[0] >= strn3 then 1 else 0;
    let ch3 = if at_end3 == 1 then 0 else char(s, pos[0]);
    let nch3 = if pos[0] + 1 >= strn3 then 0 else char(s, pos[0] + 1);
    let is_q = if ch3 == 34 then 1 else 0;
    let is_sl = if ch3 == 47 then 1 else 0;
    let is_cmt = is_sl * (if nch3 == 47 then 1 else 0);
    let is_lp = if ch3 == 40 then 1 else 0;
    let is_rp = if ch3 == 41 then 1 else 0;
    let is_close0 = is_rp * (if depth == 0 then 1 else 0);
    let _ = if is_q == 1 then (let _ = pos[0] = pos[0] + 1 in (let _ = skip_string(s, pos) in 0)) else 0;
    let _ = if is_cmt == 1 then skip_line_comment(s, pos) else 0;
    let adv3 = 1 - is_q - is_cmt - is_close0;
    let _ = pos[0] = pos[0] + adv3;
    let depth = depth + is_lp - is_rp + is_close0;
    let stop3 = is_close0 + at_end3;
    let stop3 = if stop3 > 0 then 1 else 0;
    let go = 1 - stop3;
    0
  };
  0
}

// Register-model exit-89 rewrite: emit_call had 40 symbols (9 params + 30
// locals; S=32) plus enough temp-slot pressure from its own body (tsp=34)
// to trip S+tsp>64. The callee-resolution half (cache lookup / find_fn /
// budget) doesn't need anything from the rest of emit_call, so it moves
// into its own call frame -- packed result = pb*2+okres (pb is a small
// source byte offset, okres is 0/1, so this round-trips exactly).
fn emit_call_resolve(s: str, fname: i64, fntab: [i64]) -> i64 {
  let fnpos = [0];
  let cached = ft_cache_get(fntab, fname);
  let is_hit = if cached == 0 then 0 else 1;
  let sp = if is_hit == 1 then 0 - 1 else ft_srcpos(fntab, fname);
  let v = if cached > 0 then cached - 1 else 0 - cached - 2;
  let _ = if is_hit == 1 then (let _ = fnpos[0] = v in 0) else 0;
  // Resolution budget: cap total source scans; runaway repeats degrade.
  let _ = if is_hit == 1 then (let _ = fntab[5600] = fntab[5600] + 1 in 0) else 0;
  let mbudget = fntab[0] + fntab[0] + 8;
  // Branchless-law form of: scan only when unresolved AND under budget.
  let want_scan = if is_hit == 1 then 0 else 1;
  let under_budget = if fntab[5600] < mbudget then 1 else 0;
  let _ = if want_scan * under_budget == 1 then find_fn(s, fname, fnpos) else 0;
  let _ = if sp >= 0 then (let _ = fnpos[0] = sp in 0) else 0;
  let sv = if sp >= 0 then sp + 1 else 0 - fnpos[0] - 2;
  let _ = if is_hit == 1 then 0 else ft_cache_set(fntab, fname, sv);
  // unresolved callee: neutralize the inline (pcnt=0, no body re-parse) --
  // otherwise find_fn failure points body at a garbage offset and the
  // call/body mutual recursion runs away
  let okres = if fnpos[0] >= 3 then 1 else 0;
  let pb = fnpos[0] * okres + 3 * (1 - okres);
  pb * 2 + okres
}

fn emit_call(s: str, fname: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let packed = emit_call_resolve(s, fname, fntab);
  let okres = packed - (packed / 2) * 2;
  let pb = packed / 2;
  let pnames = zeros(14);
  let pparpos = zeros(14);
  let ppos = [pb, 0];
  let _ = read_ident(s, ppos);
  let _ = skip_ws(s, ppos);
  let pcnt0 = parse_params(s, ppos, pnames, pparpos);
  let pcnt = pcnt0 * okres;
  let _ = skip_to(s, ppos, 123);
  let body = ppos[0] + 1;
  // T130 (2026-09-06): a call whose callee never resolves is a RUNTIME trap (exit 87),
  // not a silent 0 -- `brk #87` (T90 2c: the stub's SIGTRAP handler prints the text); the push keeps the stack shape.
  let _ = if okres == 0 then (let _ = em(insns, n, 3558869728) in vs_push(insns, n, fntab, stab, 1, 0, 0)) else 0;
  let _ = pos[0] = pos[0] + 1;
  let i = 0;
  while i < pcnt {
    let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
    let reg = sym_bind(s, stab, pnames[i], pparpos[i]);
    let _ = check_reg_collision(s, insns, n, fntab, stab, reg, pparpos[i]);
    let _ = vs_bind(insns, n, fntab, stab, reg);
    let _ = skip_ws(s, pos);
    let strn = slen(s, pos);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch == 44 then 1 else 0;
    let need_comma = if i + 1 < pcnt then 1 else 0;
    let _ = if need_comma * (1 - is_comma) == 1 then diag_exit(s, pos[0], 95) else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let i = i + 1;
    0
  };
  // Unresolved callee (pcnt==0): the arg list was previously left unparsed,
  // stranding pos INSIDE the call — the body loop then saw ')' as "another
  // statement ahead", popped the value early, and emit_num(')') pushed a
  // phantom 0 (net -1 at ret: the run_program / depth_sim holdout). Skip the
  // args LEXICALLY (paren depth + strings + line comments) so pos resumes on
  // ')'. Pure pos arithmetic — no emitter state — so both engines agree.
  // Limit: /* */ block comments are not skipped (the corpus uses // only).
  let _ = if okres == 0 then skip_args(s, pos) else 0;
  let _ = skip_ws(s, pos);
  // T90 step 2 (2026-09-06): the closing `)` is CHECKED (lax d08: `g(k, e]` was accepted)
  let ccl = if pos[0] >= slen(s, pos) then 0 else char(s, pos[0]);
  let _ = if ccl == 41 then 0 else diag_exit(s, pos[0], 95);
  let _ = pos[0] = pos[0] + 1;
  let after = pos[0];
  let _ = pos[0] = body * okres;
  let macx = zeros(64);
  let matk = zeros(1088);
  let _eb = if okres == 1 then (let _r = emit_body(s, pos, insns, n, stab, fname, selfstart, fntab, macx, matk) in 0) else 0;
  let _ = pos[0] = after;
  n[0]
}


// Compile a complete function: fn name(a,b,...) { body }.
// Params are moved x0->x19, x1->x20, ... in the prologue; body references
// single-letter params a->x19, b->x20, ... Returns the checksum of the words.
fn compile_fn(s: str) -> i64 {
  let insns = zeros(256);
  let n = [0, 256];
  let pos = [0, 0];
  let stab = zeros(385);  // 1 + 3*128 (name,reg,srcpos) verified triples; overflow -> loud trap
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 2;
  let _ = skip_ws(s, pos);
  let selfname = read_ident(s, pos);
  let selfstart = 0;
  // Register-model exit-89 rewrite: compile_fn used to build a FULL fn-table
  // fntab first (collect_fns + the whole name/offset population loop) and
  // then immediately DISCARD it by rebinding fntab to a fresh, empty legacy
  // table two lines later -- dead code (verified: nothing below reads
  // fnames_l/fpos_l/cnt_l/eb_l/ez_l/ezd_l). Removing it needed no behaviour
  // change and cut compile_fn's own symbol count (S) enough, together with
  // emit_call_resolve/emit_body_classify upstream, to clear S+tsp<=64.
  let enames_l = zeros(256);
  let ecnt_l = [0];
  let _ = collect_ctors(s, enames_l, ecnt_l);
  let _ = if ecnt_l[0] >= 256 then diag_exit(s, 0, 89) else 0;
  // Legacy single-fn mode: fn-table stays EMPTY (cnt=0) so unresolved calls
  // take the find_fn inline path; only the enum-ctor zone is populated.
  let fntab = zeros(8192);
  let _ = fntab[0] = 0;
  let _ = vs_reset(fntab);
  let eb2 = 1;
  let _ = fntab[eb2] = ecnt_l[0];
  let ez2 = [0];
  let ezd2 = if ecnt_l[0] == 0 then 1 else 0;
  while ezd2 == 0 {
    let _ = fntab[eb2 + 1 + ez2[0]] = enames_l[ez2[0]];
    let _ = ez2[0] = ez2[0] + 1;
    let ezd2 = if ez2[0] >= ecnt_l[0] then 1 else 0;
    0
  };
  let _ = skip_ws(s, pos);
  let pnames = zeros(14);
  let pparpos = zeros(14);
  let nparams = parse_params(s, pos, pnames, pparpos);
  let i = [0];
  let mvdone = if nparams == 0 then 1 else 0;
  while mvdone == 0 {
    let _ = sym_bind(s, stab, pnames[i[0]], pparpos[i[0]]);
    let _ = i[0] = i[0] + 1;
    let mvdone = if i[0] >= nparams then 1 else 0;
    0
  };
  let _ = skip_to(s, pos, 123);
  let _ = pos[0] = pos[0] + 1;
  let cx = zeros(64);
  let tkbuf = zeros(1088);
  let _ = cx[26] = selfname;
  let _ = cx[27] = 0 - 1;
  let pbase = n[0];
  let _ = emit_prologue(insns, n);
  let j = [0];
  let mv2 = if nparams == 0 then 1 else 0;
  while mv2 == 0 {
    let p_is_sp = if j[0] >= 8 then 1 else 0;
    let p_movw = 2852127712 + j[0] * 65536 + 19 + j[0];
    let p_strw = 4177526784 + (j[0] - 8) * 1024 + 480 + j[0];
    let _ = em(insns, n, p_movw * (1 - p_is_sp) + p_strw * p_is_sp);
    let _ = j[0] = j[0] + 1;
    let mv2 = if j[0] >= nparams then 1 else 0;
    0
  };
  let nb_tail = n[0];
  let bres_t = if 1 == 1 then emit_body(s, pos, insns, n, stab, selfname, selfstart, fntab, cx, tkbuf) else 0;
  let blast_t = bres_t - (bres_t / 2) * 2;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  // fn tail: materialise the body's final value into x0 (blast_t == 1
  // means emit_body's own lastf flag: a real tail expression left a tag).
  let _ = if blast_t == 1 then vs_to(insns, n, fntab, stab, 0) else 0;
  let _ = if blast_t == 1 then vs_pop(fntab) else 0;
  let _ = if fntab[5388] != 255 then selfcheck_exit(5, 3) else 0;
  let _ = if fntab[5389] != 0 then selfcheck_exit(6, 1) else 0;
  let _ = patch_jumps(insns, fntab, 5601, 0, n[0]);
  let _ = emit_epilogue(insns, n);
  sum_words(insns, n[0])
}


// Collect all "fn <name>(" definitions in source order: fnames[i]=name hash,
// fpos[i]=byte offset of the 'f'. Returns the count via cnt[0].
fn collect_fns(s: str, fnames: [i64], fpos: [i64], cnt: [i64]) -> i64 {
  let strn = str_len(s);
  let j = 0;
  // tpos_c[1] = strn is read_ident's slen cache: [0,0] made every one of the 282
  // read_ident calls fall back to a full str_len.
  let tpos_c = [0, strn];
  let spc = [0];
  let cpc = [0];
  let tpc = [0];
  while j + 2 < strn {
    let c0 = char(s, j);
    let c1 = char(s, j + 1);
    let c2 = char(s, j + 2);
    let is_quote = if c0 == 34 then 1 else 0;
    let is_sl = if c0 == 47 then 1 else 0;
    let is_sl2 = if c1 == 47 then 1 else 0;
    let is_comment = is_sl * is_sl2;
    let isf = if c0 == 102 then 1 else 0;
    let isn = if c1 == 110 then 1 else 0;
    let issp = if c2 == 32 then 1 else 0;
    let cafter = if isf * isn * issp == 1 then char(s, j + 3) else 0;
    let is_fn = isf * isn * issp * is_alpha(cafter);
    let ist = if c0 == 116 then 1 else 0;
    let ise = if c1 == 101 then 1 else 0;
    let iss = if c2 == 115 then 1 else 0;
    let e3 = if j + 3 >= strn then 1 else 0;
    let c3 = if e3 == 1 then 0 else char(s, j + 3);
    let ist2 = if c3 == 116 then 1 else 0;
    let e4 = if j + 4 >= strn then 1 else 0;
    let c4 = if e4 == 1 then 0 else char(s, j + 4);
    let issp2 = if c4 == 32 then 1 else 0;
    let is_test = ist * ise * iss * ist2 * issp2;
    // WAVE 0: add recognition for module keyword (m-o-d-u-l-e space)
    let ism = if c0 == 109 then 1 else 0;
    let iso = if c1 == 111 then 1 else 0;
    let isd = if c2 == 100 then 1 else 0;
    let e6 = if j + 6 >= strn then 1 else 0;
    let c6m = if e6 == 1 then 0 else char(s, j + 6);
    let c5m = if j + 5 >= strn then 0 else char(s, j + 5);
    let c4m = if j + 4 >= strn then 0 else char(s, j + 4);
    let isu = if c3 == 117 then 1 else 0;
    let isl = if c4m == 108 then 1 else 0;
    let ise2 = if c5m == 101 then 1 else 0;
    let issp_m = if c6m == 32 then 1 else 0;
    let is_module = ism * iso * isd * isu * isl * ise2 * issp_m;
    // F8 step 0: add recognition for theorem keyword (t-h-e-o-r-e-m space)
    let ith = if c1 == 104 then 1 else 0;
    let ite2 = if c2 == 101 then 1 else 0;
    let e5 = if j + 5 >= strn then 1 else 0;
    let c5 = if e5 == 1 then 0 else char(s, j + 5);
    let c6 = if j + 6 >= strn then 0 else char(s, j + 6);
    let c7 = if j + 7 >= strn then 0 else char(s, j + 7);
    let e4b = if j + 4 >= strn then 1 else 0;
    let c4b = if e4b == 1 then 0 else char(s, j + 4);
    let iteo = if c3 == 111 then 1 else 0;
    let iteor = if c4b == 114 then 1 else 0;
    let iteoree = if c5 == 101 then 1 else 0;
    let iteoreem = if c6 == 109 then 1 else 0;
    let isthm_start = if ist == 1 then 1 else 0;
    let isthm = if (isthm_start * ith * ite2 * iteo * iteor * iteoree * iteoreem) > 0 then 1 else 0;
    let isthm_sp = if c7 == 32 then 1 else 0;
    let is_theorem = isthm * isthm_sp;
    let _ = tpos_c[0] = j + 3;
    let name = if is_fn == 1 then read_ident(s, tpos_c) else 0;
    let capok = if cnt[0] < 768 then 1 else 0;
    let _ = if is_fn * capok == 1 then (let _ = fnames[cnt[0]] = name in (let _ = fpos[cnt[0]] = j in 0)) else 0;
    let _ = cnt[0] = cnt[0] + is_fn;
    let _ = spc[0] = j;
    let _ = if is_quote == 1 then skip_string_n(s, spc, strn) else 0;
    let _ = cpc[0] = j;
    let _ = if is_comment == 1 then skip_line_comment_n(s, cpc, strn) else 0;
    let _ = tpc[0] = j;
    let _ = if is_test == 1 then (let _ = tpc[0] = find_body_end(s, j + 5, strn) in (let _ = tpc[0] = if tpc[0] >= strn then strn else tpc[0] + 1 in 0)) else 0;
    // F8 step 0: validate theorem line content
    let thm_line_end = if is_theorem == 1 then find_line_end(s, j + 8, strn) else j + 8;
    let thm_bad = if is_theorem == 1 then scan_inert(s, j + 8, thm_line_end) else -1;
    let _ = if thm_bad >= 0 then diag_exit(s, thm_bad, 110) else 0;
    let thm_next = if is_theorem == 1 then (if thm_line_end >= strn then strn else thm_line_end + 1) else j + 1;
    // WAVE 0: validate module declarations contain only whitespace between braces
    let mod_brace_pos = [j + 7];
    let _ = if is_module == 1 then skip_to(s, mod_brace_pos, 123) else 0;
    let mod_close_pos = [mod_brace_pos[0] + 1];
    let _ = if is_module == 1 then skip_to(s, mod_close_pos, 125) else 0;
    let mod_bad = if is_module == 1 then scan_nonspace(s, mod_brace_pos[0] + 1, mod_close_pos[0]) else -1;
    let _ = if mod_bad >= 0 then diag_exit(s, mod_bad, 112) else 0;
    let mod_next = if is_module == 1 then (if mod_close_pos[0] >= strn then strn else mod_close_pos[0] + 1) else j + 1;
    let jnext = (j + 1) * (1 - is_quote - is_comment - is_fn - is_test - is_theorem - is_module) + spc[0] * is_quote + cpc[0] * is_comment + tpos_c[0] * is_fn + tpc[0] * is_test + thm_next * is_theorem + mod_next * is_module;
    let j = jnext;
    0
  };
  cnt[0]
}

// Compile one function whose "fn" keyword is at source offset fpos, appending
// into the shared insns/n buffer. selfstart = its absolute word offset (0 in a
// single-fn compile); fntab = full name->start layout (for cross-call bl).
// B1 (2026-09-06): is_emission distinguishes the two calls compile_program_offs
// makes per fn -- 0 for the planning pass (facts not published yet: this is
// the very call that computes them; the old unconditional prologue/epilogue/
// call-site form is used, so the throwaway buffer's word count needs an
// arithmetic size correction at the end instead of a real omission), 1 for
// the emission pass (fntab[2900+i] already holds every fn's facts, looked up
// here by name and applied from the start -- no post-hoc patch or scan).
// Register-model exit-89 rewrite: compile_fn_at had 46 locals (+8 params =
// 54, S=46) before counting any temp-slot pressure from its own body. The
// planning-pass arithmetic correction (B1's "what emission will not emit")
// only needs (insns,n,fntab,stab,pbase,is_emission) and doesn't interact
// with anything else in compile_fn_at, so it moves to its own frame --
// also publishes fntab[3670] as a side effect, same as before.
fn compile_fn_at_total_saved(insns: [i64], n: [i64], fntab: [i64], stab: [i64], pbase: i64, is_emission: i64) -> i64 {
  let real_vc = stab[0];
  let real_alloc = if count_word(insns, pbase, n[0], 2853897184) > 0 then 1 else 0;
  // cs_hi/tsp: the max cs-temp register index and temp-slot count this fn's
  // OWN emission actually used (fntab[5391]/[3826], live-tracked by vs_park*
  // since vs_reset zeroed them at entry -- valid on either pass).
  let real_cs_hi = fntab[5391];
  let real_tsp = fntab[5392];
  let real_mvc = if real_vc > real_cs_hi then real_vc else real_cs_hi;
  let real_needs_save_raw = (if real_vc > 8 then 1 else 0) + (if real_tsp > 0 then 1 else 0);
  let real_needs_save = if real_needs_save_raw > 0 then 1 else 0;
  let saved_pairs01 = (if real_mvc <= 0 then 1 else 0) + (if real_mvc <= 2 then 1 else 0) + (if real_mvc <= 4 then 1 else 0) + (if real_mvc <= 6 then 1 else 0);
  let saved_x15 = 1 - real_needs_save;
  // A6 step 2 commit B: emit_prologue_sized NEVER emits `add x14,sp,#0x900`
  // any more, while the unsized emit_prologue this correction is measured
  // against still does -- so the emission pass saves that word on every fn,
  // unconditionally, where it used to save it only when real_alloc was 0.
  let saved_x14 = 1;
  let saved_calls = fntab[3668] * 2 * (1 - real_needs_save);
  let total_saved = (saved_pairs01 * 2 + 2 + saved_x15 + saved_x14 + saved_calls) * (1 - is_emission);
  // A6 step 2: `marks` joins the packed fact word at 2^22 (5 bits). It CANNOT
  // go at 2^20 as the blueprint first drafted: since A14 tsp reaches 256, the
  // 8192*tsp field occupies bits 13..21 and 2^20 sits inside it.
  let real_marks = if fntab[5404] > 21 then 21 else fntab[5404];
  let _ = fntab[3670] = real_vc + 256 * real_alloc + 512 * real_cs_hi + 8192 * real_tsp + 4194304 * real_marks;
  total_saved
}

// fw = vc + 256*alloc + 512*cs_hi + 8192*tsp (§5) -- tiny decoders so
// compile_fn_at itself only ever holds the packed `fw0`, not its 4
// unpacked fields (another symbol-count cut for the same reason as
// compile_fn_at_total_saved above).
fn fw_vc(fw: i64) -> i64 { fw - (fw / 256) * 256 }
fn fw_alloc(fw: i64) -> i64 { (fw / 256) - ((fw / 256) / 2) * 2 }
fn fw_cshi(fw: i64) -> i64 { ((fw / 256) / 2) - (((fw / 256) / 2) / 16) * 16 }
fn fw_tsp(fw: i64) -> i64 { let t = ((fw / 256) / 2) / 16; t - (t / 512) * 512 }
fn fw_marks(fw: i64) -> i64 { let m = fw / 4194304; m - (m / 32) * 32 }

fn compile_fn_at_facts(s: str, fntab: [i64], fpos: i64, namepos: i64, is_emission: i64) -> i64 {
  let fw0 = fntab_fact_lookup(fntab, fpos) * is_emission;
  let vc0 = fw_vc(fw0);
  let alloc0 = fw_alloc(fw0);
  let tsp0 = fw_tsp(fw0);
  let needs_save0raw = (if vc0 > 8 then 1 else 0) + (if tsp0 > 0 then 1 else 0);
  let needs_save0 = if needs_save0raw > 0 then 1 else 0;
  let _ = fntab[3669] = (1 - needs_save0) * is_emission;
  // S: the emission pass's spilled-symbol slot base (0 on the planning pass).
  let s0 = if vc0 > 8 then vc0 - 8 else 0;
  let _ = fntab[5393] = s0 * is_emission;
  // overflow trap (§5): this compiler does not spill further than 256 temp
  // slots beyond the spilled symbols (ROADMAP A14 2026-09-07: 64 before --
  // path-independent if-parks put values in slots that used to sit in cs
  // registers, and 94 of the A14 corpus repros then hit the old bound; the
  // x15 region grew 512 -> 2048 bytes, taken out of the frame heap, see
  // emit_prologue).
  let _ = if is_emission == 1 then (if s0 + tsp0 > 256 then diag_exit(s, namepos, 89) else 0) else 0;
  fw0
}

fn compile_fn_at(s: str, fpos: i64, selfstart: i64, fntab: [i64], insns: [i64], n: [i64], tkb: [i64], is_emission: i64) -> i64 {
  // Reset per-fn scan-budget so late functions don't exhaust the counter
  // accumulated by earlier ones (every cache-hit increments fntab[5600];
  // without reset, late fns compile ALL calls as unresolved/neutral).
  let _ = fntab[5600] = 0;
  let _ = fntab[5540] = 0;  // S3: rep=0 (all-memory) at function entry
  // T96 step 1: the label/barrier position is per-fn state. Without this
  // reset a position left by the previous fn (or the planning pass) could
  // coincide with n[0] here and block one elision in one pass only -> the
  // fntab offsets disagree with the emitted layout (ordfsm: every bl 3
  // words late, SIGBUS). -1 never equals a position.
  let _ = fntab[5245] = 0 - 1;
  let _ = fntab[5246] = 0;  // T43: while nesting depth (frame-heap mark slot)
  let _ = fntab[5404] = 0;
  // F3: clear the per-symbol static-length table (fntab[5410..5537]).
  let fz = [0];
  while fz[0] < 128 {
    let _ = fntab[5410 + fz[0]] = 0;
    let _ = fz[0] = fz[0] + 1;
    0
  };  // A6 step 2: per-fn marks high-water (frame sizing)
  let _ = fntab[7100] = 0 - 1;  // A21: no paren is in tuple position yet
  let _ = fntab[7102] = 0;      // A21: no callee is exempt from the arity guard
  let _ = fntab[5601] = 0;  // T99: pending `return` placeholders
  let _ = fntab[5666] = 0;  // T99: pending `break` placeholders
  let _ = fntab[5543] = kernel_marked(s, fpos);  // C1 step 2: `kernel fn` dialect bit
  let pos = [fpos, str_len(s)];
  let stab = zeros(385);  // 1 + 3*128 (name,reg,srcpos) verified triples; overflow -> loud trap
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 2;
  let _ = skip_ws(s, pos);
  let namepos = pos[0];
  let selfname = read_ident(s, pos);
  // T122 (D11-M, 2026-09-05): a fn named like a keyword or a builtin is REJECTED
  // (exit 99) -- `fn match` used to compile into a call of the match keyword
  // (T31 journal) and return 0. Hash table = read_ident of each reserved word.
  // F2 prerequisite (2026-09-09): the table was short by SEVEN of the 36 builtins
  // emit_call_or_ctor actually dispatches -- clz, crc32, crc32x, sys_msync,
  // sys_run, sys_setaffinity, sys_wait4 -- so `fn clz(x: i64) -> i64 { 5 }`
  // compiled rc=0 and `clz(8)` returned 60: the builtin ladder runs BEFORE the
  // user-fn lookup, so the user's function became silent dead code where T122
  // intends exit 99. The seven are appended to rsv3 below. NOTE THE SPELLING:
  // this table writes a wrapped hash SIGNED while the dispatch ladder writes the
  // same hash UNSIGNED, so the two must be compared modulo 2^64 -- comparing the
  // literals as written reports 16 shadowable builtins instead of 7.
  let rsv1 = (if selfname == 1866735 then 1 else 0) + (if selfname == 35281108217 then 1 else 0) + (if selfname == 13857 then 1 else 0) + (if selfname == 262576641 then 1 else 0) + (if selfname == 228925745 then 1 else 0) + (if selfname == 13865 then 1 else 0) + (if selfname == 13472 then 1 else 0) + (if selfname == 228960337 then 1 else 0) + (if selfname == 4471061603997 then 1 else 0) + (if selfname == 4238080694376 then 1 else 0) + (if selfname == 32320559965 then 1 else 0) + (if selfname == 4428069113672 then 1 else 0) + (if selfname == 29119020707 then 1 else 0) + (if selfname == 36158018563 then 1 else 0) + (if selfname == 224358574 then 1 else 0) + (if selfname == 585709020818199 then 1 else 0) + (if selfname == 66094333908796503 then 1 else 0) + (if selfname == 30895064082 then 1 else 0) + (if selfname == 4047253394792 then 1 else 0) + (if selfname == 260449716 then 1 else 0) + (if selfname == 249209392 then 1 else 0);
  let rsv2 = (if selfname == 246721067 then 1 else 0) + (if selfname == 76753189879327100 then 1 else 0) + (if selfname == 76753189885882068 then 1 else 0) + (if selfname == -8392076197157136435 then 1 else 0) + (if selfname == -8392076203060520566 then 1 else 0) + (if selfname == -2688661736639986669 then 1 else 0) + (if selfname == -8392076198348418984 then 1 else 0) + (if selfname == 76753189874778913 then 1 else 0) + (if selfname == 7442662210087947144 then 1 else 0) + (if selfname == -5847879057653958070 then 1 else 0) + (if selfname == 7442662398273192292 then 1 else 0) + (if selfname == 7442661902340062434 then 1 else 0) + (if selfname == 76753189856984008 then 1 else 0) + (if selfname == 7040940390938053523 then 1 else 0) + (if selfname == -6282920175007517587 then 1 else 0) + (if selfname == -8392076203060521221 then 1 else 0) + (if selfname == -1736429998027255437 then 1 else 0) + (if selfname == -3153574141067785036 then 1 else 0) + (if selfname == 8779068393901189725 then 1 else 0) + (if selfname == 7221016679989100487 then 1 else 0) + (if selfname == 1084841420853388659 then 1 else 0);
  let rsv3 = (if selfname == 260242221 then 1 else 0) + (if selfname == -8392076202161113213 then 1 else 0) + (if selfname == -1729804160290675916 then 1 else 0) + (if selfname == 1713209 then 1 else 0) + (if selfname == 29413480223 then 1 else 0) + (if selfname == 3853165909311 then 1 else 0) + (if selfname == 3853165909333 then 1 else 0) + (if selfname == -8392076200099613766 then 1 else 0) + (if selfname == 585902212871437 then 1 else 0) + (if selfname == 7304771531850188344 then 1 else 0) + (if selfname == -8392076197195354031 then 1 else 0);
  let _ = if rsv1 + rsv2 + rsv3 > 0 then diag_exit(s, namepos, 99) else 0;
  let _ = skip_ws(s, pos);
  let pnames = zeros(14);
  let pparpos = zeros(14);
  let nparams = parse_params(s, pos, pnames, pparpos);
  let i = [0];
  let mvdone = if nparams == 0 then 1 else 0;
  while mvdone == 0 {
    let _ = sym_bind(s, stab, pnames[i[0]], pparpos[i[0]]);
    let _ = i[0] = i[0] + 1;
    let mvdone = if i[0] >= nparams then 1 else 0;
    0
  };
  // F8 step 0: validate contract region (requires/ensures) before consuming it
  let contract_start = pos[0];
  let _ = skip_to(s, pos, 123);
  let contract_end = pos[0];
  let bad_pos = scan_inert(s, contract_start, contract_end);
  let _ = if bad_pos >= 0 then diag_exit(s, bad_pos, 110) else 0;
  let _ = pos[0] = pos[0] + 1;
  let cx = zeros(64);
  let tkbuf = tkb;
  let _ = cx[26] = selfname;
  let _ = cx[27] = selfstart;
  // B1: own-fn facts. fntab[3668] = call-site counter (this compile only,
  // read by the end-of-fn arithmetic adjustment on the planning pass);
  // fntab[3669] = skip-save flag read by emit_bl_call at every bl in this
  // fn's body (0 = save, the safe default; is_emission==0 forces 0 so the
  // planning pass reproduces today's unconditional call-site form exactly).
  let _ = fntab[3668] = 0;
  let _ = vs_reset(fntab);
  let fw0 = compile_fn_at_facts(s, fntab, fpos, namepos, is_emission);
  let pbase = n[0];
  let _ = if is_emission == 1 then emit_prologue_sized(insns, n, fw_vc(fw0), fw_alloc(fw0), fw_cshi(fw0), fw_tsp(fw0), fw_marks(fw0)) else emit_prologue(insns, n);
  // Params 1..8 -> x19..x26; params 9+ -> spill slots (sym_bind maps cnt>=8
  // to 100+slot). A register move for j>=8 emitted `mov x27,x8`-class words:
  // it CLOBBERED the reserved arena register AND left the spill slot unwritten
  // (9th param read as 0; heap corruption downstream). Spilled params get
  // str xj,[x15,#slot*8]; encoding verified against objdump reference.
  let j = [0];
  let mv2 = if nparams == 0 then 1 else 0;
  while mv2 == 0 {
    let p_is_sp = if j[0] >= 8 then 1 else 0;
    let p_movw = 2852127712 + j[0] * 65536 + 19 + j[0];
    let p_strw = 4177526784 + (j[0] - 8) * 1024 + 480 + j[0];
    let _ = em(insns, n, p_movw * (1 - p_is_sp) + p_strw * p_is_sp);
    let _ = j[0] = j[0] + 1;
    let mv2 = if j[0] >= nparams then 1 else 0;
    0
  };
  let nb_tail = n[0];
  let bres_t = if 1 == 1 then emit_body(s, pos, insns, n, stab, selfname, selfstart, fntab, cx, tkbuf) else 0;
  let blast_t = bres_t - (bres_t / 2) * 2;
  // T42 2026-09-04 (fuzz DIVERGE-81/128 shrunk): a body with NO tail
  // expression (empty, or ending in a let/while/compound statement, or
  // `e;` before the `}`) returned whatever x0 held; trap 97 instead
  // (exit-code table at emit_paren). bpref.py raises on the same shape.
  let _ = if blast_t == 1 then 0 else diag_exit(s, pos[0], 97);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  // fn tail: materialise the body's final value into x0 (blast_t == 1
  // means emit_body's own lastf flag: a real tail expression left a tag).
  let _ = if blast_t == 1 then vs_to(insns, n, fntab, stab, 0) else 0;
  let _ = if blast_t == 1 then vs_pop(fntab) else 0;
  let _ = if fntab[5388] != 255 then selfcheck_exit(5, 4) else 0;
  let _ = if fntab[5389] != 0 then selfcheck_exit(6, 2) else 0;
  let _ = patch_jumps(insns, fntab, 5601, 0, n[0]);
  let _ = if is_emission == 1 then emit_epilogue_sized(insns, n, fw_vc(fw0), fw_cshi(fw0), fw_tsp(fw0), fw_marks(fw0)) else emit_epilogue(insns, n);
  // B1 (2026-09-06): replaces OPT-A's post-hoc NOP patch of unused
  // callee-saved pairs and OPT-G1's generic register-field scan of the
  // emitted words (the DIVERGE-42122 bug: that scan false-positived on
  // emit_bl's own stp/ldp x15,x14 words, so any fn containing a call was
  // seen as "uses x15" regardless of its own facts). The real facts are
  // exact instead of scanned: real_vc = final stab[0] (params + lets,
  // covers spilled params too -- c53_param9) says whether ANY symbol
  // spilled (real_vc > 8) and drives the same per-pair keep/drop the old
  // OPT-A loop used (pair k kept iff real_vc > k*2; pair 4 = x27/x28 the
  // arena registers is never a symbol register, T126, always dropped);
  // real_alloc is an EXACT word match (2853897184 = "mov x0,x27", only ever
  // emitted by an allocation site) rather than a generic decode, so it
  // cannot alias a call site's own stp/ldp x15,x14.
  //
  // On the emission pass (is_emission==1) the words above were already
  // right-sized from the start via emit_prologue_sized/emit_epilogue_sized
  // and fntab[3669], using vc0/alloc0 published by the PRECEDING planning
  // run -- nothing more to do here. On the planning pass (is_emission==0)
  // emit_prologue/emit_epilogue/the call sites still emitted today's full,
  // unshrunk form (its buffer is thrown away; only the size matters), so
  // n[0] is corrected by exactly what emission will not emit, and the
  // just-computed real facts are published in fntab[3670] for
  // compile_program_offs to copy into the real fntab[2900+i] the emission
  // pass will read.
  let _ = n[0] = n[0] - compile_fn_at_total_saved(insns, n, fntab, stab, pbase, is_emission);
  n[0]
}

// Two-pass layout of a whole program: measure each fn's size (bl is a fixed
// 1-word size, so a placeholder-target pass yields correct sizes), compute
// start offsets by prefix sums, then re-emit with a full 3-zone table
// [cnt, names..., offsets..., srcpos...] so every bl resolves to a real offset
// AND every inline site finds the callee source position in O(#fns)
// (was: full-source rescan per call site -> superquadratic selfcompile).
// R3.x(d) literal data section: scan the source for string literals in order
// (skipping // comments), record per-literal DATA WORD offsets in
// R3.x(d) literal data section: scan the source for string literals in order
// (skipping // comments), record per-literal DATA WORD offsets in
// fntab[6000+i] (code length L + cumulative cell offset), the count in
// fntab[5550], L in fntab[5551], cursor 0 in fntab[5552], total cells in
// fntab[5549]. The cells are appended after the code words once emission
// completes (write_lit_cells); emit_str turns each literal into adr x0,<imm>.
fn scan_literals(s: str, fntab: [i64], L: i64) -> i64 {
  let strn = str_len(s);
  // pos[1] = strn: scan_one_lit calls slen(s,pos), which read pos[1] OUT OF BOUNDS on
  // the old 1-cell [0] (unchecked) and then fell back to a full str_len per literal.
  let pos = [0, strn];
  let lcnt = [0];
  let cum = [0];
  while pos[0] < strn {
    let c0 = char(s, pos[0]);
    let e1 = if pos[0] + 1 >= strn then 1 else 0;
    let c1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
    let is_sl = if c0 == 47 then 1 else 0;
    let is_sl2 = if c1 == 47 then 1 else 0;
    let is_cm = is_sl * is_sl2;
    let _ = if is_cm == 1 then skip_line_comment_n(s, pos, strn) else 0;
    let is_q = if c0 == 34 then 1 else 0;
    let _ = if is_q == 1 then (let _ = pos[0] = pos[0] + 1 in (let _ = scan_one_lit(s, pos, fntab, L, lcnt, cum) in 0)) else 0;
    let ist = if c0 == 116 then 1 else 0;
    let ise = if c1 == 101 then 1 else 0;
    let e2 = if pos[0] + 2 >= strn then 1 else 0;
    let c2 = if e2 == 1 then 0 else char(s, pos[0] + 2);
    let iss = if c2 == 115 then 1 else 0;
    let e3 = if pos[0] + 3 >= strn then 1 else 0;
    let c3 = if e3 == 1 then 0 else char(s, pos[0] + 3);
    let ist2 = if c3 == 116 then 1 else 0;
    let e4 = if pos[0] + 4 >= strn then 1 else 0;
    let c4 = if e4 == 1 then 0 else char(s, pos[0] + 4);
    let issp = if c4 == 32 then 1 else 0;
    let is_test = ist * ise * iss * ist2 * issp;
    let _ = if is_test == 1 then (let _ = pos[0] = find_body_end(s, pos[0] + 5, strn) in (let _ = pos[0] = if pos[0] >= strn then strn else pos[0] + 1 in 0)) else 0;
    let adv = 1 - is_q - is_cm - is_test;
    let _ = pos[0] = pos[0] + adv;
    0
  };
  let _ = fntab[5550] = lcnt[0];
  let _ = fntab[5551] = L;
  let _ = fntab[5552] = 0;
  let _ = fntab[5549] = cum[0];
  cum[0]
}

// Measure + register one literal: pos is INSIDE it (just after '"'). Record
// fntab[6000 + lcnt] = L + cum, advance cum by ceil((len+1)/8) cells, move
// pos past the closing '"'.
fn scan_one_lit(s: str, pos: [i64], fntab: [i64], L: i64, lcnt: [i64], cum: [i64]) -> i64 {
  let strn = slen(s, pos);
  let start = pos[0];
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_q = if ch == 34 then 1 else 0;
    let adv = 1 - is_q - at_end;
    let _ = pos[0] = pos[0] + adv;
    let done = if is_q + at_end >= 1 then 1 else 0;
    0
  };
  let _ = pos[0] = pos[0] + 1;
  let len = pos[0] - start - 1;
  let cells = (len + 1 + 3) / 4;
  // INHERITED GATE RED, closed 2026-09-14: check_abi.py's `literal trap (6000 + nlits
  // >= 7000)` check has read MISSING ever since the 2026-09-13 provenance audit made it
  // an error instead of a print -- the lit_table zone (fntab[6000..6999]) was the ONE
  // registered zone whose overflow was unguarded, and a 1000th string literal would have
  // written straight through the end of fntab silently. Now exit 114.
  let _ = if 6000 + lcnt[0] >= 7000 then diag_exit(s, start, 114) else 0;
  let _ = fntab[6000 + lcnt[0]] = L + cum[0];
  let _ = cum[0] = cum[0] + cells;
  let _ = lcnt[0] = lcnt[0] + 1;
  len
}

// speed-up (2026-09-06): the fn starts are a by-product of the planning pass; cli_compile
// used to run a THIRD full pass (emit_offsets) to learn main's offset. offs[0] = cnt,
// offs[1 + i] = start of fn i in source order.
fn compile_program_to(s: str, insns: [i64], n: [i64]) -> i64 {
  let offs = zeros(784);
  compile_program_offs(s, insns, n, offs)
}
fn compile_program_offs(s: str, insns: [i64], n: [i64], offs: [i64]) -> i64 {
  let fnames = zeros(784);
  let fpos = zeros(784);
  let cnt = [0];
  let _ = collect_fns(s, fnames, fpos, cnt);
  let _ = if cnt[0] >= 768 then diag_exit(s, 0, 104) else 0;
  let _ = offs[0] = cnt[0] + (idx_of_main(fnames, cnt[0]) << 32);
  let sizes = zeros(784);
  let starts = zeros(784);
  let ptab = zeros(8192);
  let _ = ptab[0] = cnt[0];
  let pm = [0];
  while pm[0] < cnt[0] {
    let _ = ptab[1 + pm[0]] = fnames[pm[0]];
    let _ = pm[0] = pm[0] + 1;
    0
  };

  let pz = [0];
  while pz[0] < cnt[0] {
    let _ = ptab[1 + cnt[0] + cnt[0] + pz[0]] = fpos[pz[0]];
    let _ = pz[0] = pz[0] + 1;
    0
  };

  let enames_pz = zeros(256);
  let ecnt_pz = [0];
  let _ = collect_ctors(s, enames_pz, ecnt_pz);
  let _ = if ecnt_pz[0] >= 256 then diag_exit(s, 0, 89) else 0;
  let eb_pz = cnt[0] + cnt[0] + cnt[0] + 1;
  let _ = ptab[eb_pz] = ecnt_pz[0];
  let ez_pz = [0];
  let ed_pz = if ecnt_pz[0] == 0 then 1 else 0;
  while ed_pz == 0 {
    let _ = ptab[eb_pz + 1 + ez_pz[0]] = enames_pz[ez_pz[0]];
    let _ = ez_pz[0] = ez_pz[0] + 1;
    let ed_pz = if ez_pz[0] >= ecnt_pz[0] then 1 else 0;
    0
  };
  let stk_a = zeros(1088);
    let tmp = zeros(65536);
  // B1 (2026-09-06): factbuf[i] harvests fn i's own facts (fntab[3670],
  // packed vc*2+has_alloc) right after its planning-pass compile, in the
  // same fn-index order as fnames/fpos/sizes/starts -- copied into the real
  // fntab[2900+i] below once fntab exists, for the emission pass to look up.
  let factbuf = zeros(784);
  let i = [0];
  while i[0] < cnt[0] {
    let tn = [0, 65536];
    let _ = compile_fn_at(s, fpos[i[0]], 0, ptab, tmp, tn, stk_a, 0);
    let _ = sizes[i[0]] = tn[0];
    let _ = factbuf[i[0]] = ptab[3670];
    let _ = i[0] = i[0] + 1;
    0
  };
  let acc = 0;
  let k = [0];
  while k[0] < cnt[0] {
    let _ = starts[k[0]] = acc;
    let _ = offs[1 + k[0]] = acc;
    let acc = acc + sizes[k[0]];
    let _ = k[0] = k[0] + 1;
    0
  };
  let fntab = zeros(8192);
  let _ = fntab[0] = cnt[0];
  let _ = scan_literals(s, fntab, acc);
  let m = [0];
  while m[0] < cnt[0] {
    let _ = fntab[1 + m[0]] = fnames[m[0]];
    let _ = fntab[1 + cnt[0] + m[0]] = starts[m[0]];
    let _ = fntab[2900 + m[0]] = factbuf[m[0]];  // B1: publish planning's facts for emission
    let _ = m[0] = m[0] + 1;
    0
  };

  let fz = [0];
  while fz[0] < cnt[0] {
    let _ = fntab[1 + cnt[0] + cnt[0] + fz[0]] = fpos[fz[0]];
    let _ = fz[0] = fz[0] + 1;
    0
  };

  let eb_fz = cnt[0] + cnt[0] + cnt[0] + 1;
  let ecnt_fz = [0];
  let _ = ecnt_fz[0] = ptab[eb_fz];
  let _ = fntab[eb_fz] = ecnt_fz[0];
  let ez_fz = [0];
  let ed_fz = if ecnt_fz[0] == 0 then 1 else 0;
  while ed_fz == 0 {
    let _ = fntab[eb_fz + 1 + ez_fz[0]] = ptab[eb_fz + 1 + ez_fz[0]];
    let _ = ez_fz[0] = ez_fz[0] + 1;
    let ed_fz = if ez_fz[0] >= ecnt_fz[0] then 1 else 0;
    0
  };
  let stk_b = zeros(1088);
  let q = [0];
  while q[0] < cnt[0] {
    let _ = compile_fn_at(s, fpos[q[0]], starts[q[0]], fntab, insns, n, stk_b, 1);
    let _ = q[0] = q[0] + 1;
    0
  };
  // R3.x(d): append the string-literal data section after the code words.
  // Scan the source in order, write each literal's bytes (NUL-terminated)
  // into the reserved cells at insns[L + cum].
  let dcell_tot = fntab[5549];
  let dlitc = fntab[5550];
  let Lcode = n[0];
  let strn = str_len(s);
  let sp = [0];
  let dli = [0];
  let dgo = if dlitc > 0 then 1 else 0;
  while dgo == 1 {
    let c0 = if sp[0] >= strn then 0 else char(s, sp[0]);
    let e1 = if sp[0] + 1 >= strn then 1 else 0;
    let c1 = if e1 == 1 then 0 else char(s, sp[0] + 1);
    let is_sl = if c0 == 47 then 1 else 0;
    let is_sl2 = if c1 == 47 then 1 else 0;
    let is_cm = is_sl * is_sl2;
    let _ = if is_cm == 1 then skip_line_comment_n(s, sp, strn) else 0;
    let is_q = if c0 == 34 then 1 else 0;
    let adv = 1 - is_q - is_cm;
    let _ = sp[0] = sp[0] + adv;
    let _ = if is_q == 1 then (let _ = sp[0] = sp[0] + 1 in (let _ = write_lit_cells(s, sp, insns, fntab, dli, strn) in 0)) else 0;
    let dgo = if dli[0] >= dlitc then 0 else 1;
    0
  };
  let _ = n[0] = Lcode + dcell_tot;
  sum_words(insns, n[0])
}

// Write literal li's bytes into cells starting at data word fntab[6000+li].
// sp points INSIDE the literal (just after '"'). Advances sp past '"',
// bumps dli. The trailing cell's unused bytes stay 0 -> NUL termination.
fn write_lit_cells(s: str, sp: [i64], insns: [i64], fntab: [i64], dli: [i64], strn: i64) -> i64 {
  let start = sp[0];
  let done = 0;
  while done == 0 {
    let at_end = if sp[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, sp[0]);
    let is_q = if ch == 34 then 1 else 0;
    let adv = 1 - is_q - at_end;
    let _ = sp[0] = sp[0] + adv;
    let done = if is_q + at_end >= 1 then 1 else 0;
    0
  };
  let _ = sp[0] = sp[0] + 1;
  let len = sp[0] - start - 1;
  let base = fntab[6000 + dli[0]];
  let j = 0;
  while j < len {
    let b = char(s, start + j);
    let cidx = j / 4;
    let sh = (j - cidx * 4) * 8;
    let _ = insns[base + cidx] = insns[base + cidx] + (b << sh);
    let j = j + 1;
    0
  };
  let _ = dli[0] = dli[0] + 1;
  len
}

// Convenience wrapper: compile a whole program to a fresh buffer and return the
// checksum of its words (kept for self_check regression tests).
fn compile_program(s: str) -> i64 {
  let insns = zeros(262144);
  let n = [0, 262144];
  let r = compile_program_to(s, insns, n);
  r
}


// Verify the emitted machine code against frozen checksums of the fixpoint-green
// self-hosted emitter (T44: re-frozen 2026-09-04; exec-based run checks removed --
// `exec` is not a builtin here, post-C execution is `seed <bin>`). 0 = pass.
fn self_check() -> i64 {
let c1 = if compile("42") == 21426575550 then 0 else 1;
let c2 = if compile("1+2") == 21426574302 then 0 else 1;
let c3 = if compile("1+2*3") == 38157695836 then 0 else 1;
let c4 = if compile("2*(3+4)") == 56155582491 then 0 else 1;
let c5 = if compile("8/2-1") == 73956217849 then 0 else 1;
let c6 = if compile("if 1 then 10 else 20") == 56260325310 then 0 else 1;
let c7 = if compile("if 0 then 10 else 20") == 56260325278 then 0 else 1;
let c8 = if compile("1 + if 2 then 3 else 4") == 90720865435 then 0 else 1;
let c9 = if compile("if 1 then 1+2 else 3*4") == 56260324830 then 0 else 1;
let c10 = if compile_fn("fn f(a) { a + 1 }") == 87633445511 then 0 else 1;
let c11 = if compile_fn("fn f(a,b) { a + b }") == 107536897562 then 0 else 1;
let c12 = if compile("1<2") == 60091882330 then 0 else 1;
let c13 = if compile("3==3") == 60091845562 then 0 else 1;
let c14 = if compile("2>3") == 60091894682 then 0 else 1;
let c15 = if compile("1+2<4") == 60091882458 then 0 else 1;
let c16 = if compile("5==2+3") == 60091845690 then 0 else 1;
let c17 = if compile_fn("fn f() { let a = 1; a + 2 }") == 105463469669 then 0 else 1;
let c18 = if compile_fn("fn f(a) { let b = a + 1; b * 2 }") == 142366438870 then 0 else 1;
let c19 = if compile_fn("fn main() { f(41) } fn f(a) { a + 1 }") == 120440118832 then 0 else 1;
let c20 = if compile_fn("fn main() { s(6) } fn s(a) { a * a }") == 119928510961 then 0 else 1;
let c21 = if compile_fn("fn main() { g(3,4) } fn g(a,b) { a + b }") == 140343439874 then 0 else 1;
let c22 = if compile_fn("fn main() { foo(41) } fn foo(x) { x + 1 }") == 105462224741 then 0 else 1;
let c23 = if compile_fn("fn main() { let acc = 10; let delta = 5; acc + delta }") == 143196878710 then 0 else 1;
let c24 = if compile_fn("fn main() { foo(3,4) } fn foo(a,b) { a + b }") == 143195633270 then 0 else 1;
let c25 = if compile_fn("fn main() { let total = 0; let extra = 7; total + extra * 2 }") == 177925886515 then 0 else 1;
let c26 = if compile_fn("fn main() { let p = pt { x: 1, y: 2 }; p.x + p.y } struct pt { x: i64, y: i64 }") == 212182316249 then 0 else 1;
let c27 = if compile_fn("fn main() { pt { x: 1, y: 2 } } struct pt { x: i64, y: i64 }") == 209330188518 then 0 else 1;
let c28 = if compile_fn("fn main(p) { p.x + p.y } struct pt { x: i64, y: i64 }") == 141644920226 then 0 else 1;
let c29 = if compile_fn("fn main() { some(5) } enum opt { none, some }") == 100199269538 then 0 else 1;
let c30 = if compile_fn("fn main() { none } enum opt { none, some }") == 78191717988 then 0 else 1;
let c31 = if compile_fn("fn main() { match some(5) { none => 0, some(x) => x + 1 } } enum opt { none, some }") == 105463468773 then 0 else 1;
let c32 = if compile_fn("fn main() { match none { none => 0, some(x) => x + 1 } } enum opt { none, some }") == 68728432374 then 0 else 1;
let c33 = if compile_fn("fn fact(n) { if n <= 1 then 1 else n * fact(n-1) }") == 243444346142 then 0 else 1;
let c34 = if compile_fn("fn main() { let i = 0; let acc = 0; while i < 5 { let acc = acc + i; let i = i + 1; 0 }; acc }") == 279438272540 then 0 else 1;
let c35 = if compile_program("fn main() { helper(41) } fn helper(x) { x + 1 }") == 219691780395 then 0 else 1;
let c36 = if compile_program("fn main() { add(3,4) } fn add(a,b) { a + b }") == 257425254461 then 0 else 1;
  c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15 + c16 + c17 + c18 + c19 + c20 + c21 + c22 + c23 + c24 + c25 + c26 + c27 + c28 + c29 + c30 + c31 + c32 + c33 + c34 + c35 + c36
}


fn emit_expr_words(src: str) -> [i64] {
  let insns = zeros(8192);
  let n = [0, 8192];
  let pos = [0, 0];
  let stab = zeros(512);
  let selfname = 0 - 1;
  let selfstart = 0;
  let fnames_l = zeros(784);
  let fpos_l = zeros(784);
  let cnt_l = [0];
  let _ = collect_fns(src, fnames_l, fpos_l, cnt_l);
  let fntab = zeros(8192);
  let _ = fntab[0] = cnt_l[0];
  let _ = vs_reset(fntab);
  let fl_i = [0];
  let fl_d = if cnt_l[0] == 0 then 1 else 0;
  while fl_d == 0 {
    let _ = fntab[1 + fl_i[0]] = fnames_l[fl_i[0]];
    let _ = fntab[1 + cnt_l[0] + cnt_l[0] + fl_i[0]] = fpos_l[fl_i[0]];
    let _ = fl_i[0] = fl_i[0] + 1;
    let fl_d = if fl_i[0] >= cnt_l[0] then 1 else 0;
    0
  };
  let enames_l = zeros(512);
  let ecnt_l = zeros(16);
  let _ = collect_ctors(src, enames_l, ecnt_l);
  let eb_l = cnt_l[0] + cnt_l[0] + cnt_l[0] + 1;
  let _ = fntab[eb_l] = ecnt_l[0];
  let ez_l = [0];
  let ezd_l = if ecnt_l[0] == 0 then 1 else 0;
  while ezd_l == 0 {
    let _ = fntab[eb_l + 1 + ez_l[0]] = enames_l[ez_l[0]];
    let _ = ez_l[0] = ez_l[0] + 1;
    let ezd_l = if ez_l[0] >= ecnt_l[0] then 1 else 0;
    0
  };
  let _ = emit_cmp(src, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = vs_deliver(insns, n, fntab, stab, 1);
  let _ = em(insns, n, 3596551104);
  let out = zeros(n[0] + 1);
  let _ = out[0] = n[0];
  let pk = [0];
  let pgo = 1;
  while pgo == 1 {
    let pdone = if pk[0] >= n[0] then 1 else 0;
    let _ = if pdone == 0 then (let _ = out[pk[0] + 1] = insns[pk[0]] in 0) else 0;
    let _ = pk[0] = pk[0] + 1;
    let pgo = 1 - pdone;
    0
  };
  out
}


// ---- M3 SELF-BOOTSTRAP ----
// Reads Bebop source from a fixed path into the arena, compiles it with
// THIS compiler (emit_words over a raw pointer), returns word checksum.
// Entry for beboSelf.bin: the frozen compiler compiling other programs.
// BENCH: two-pass compile of a whole fn-main program; returns [count, words...]
fn emit_words(src: str) -> [i64] {
  let offs = zeros(784);
  emit_words_offs(src, offs)
}
fn emit_words_offs(src: str, offs: [i64]) -> [i64] {
  let insns = zeros(262144);
  let n = [0, 262144];
  let _ = compile_program_offs(src, insns, n, offs);
  let out = zeros(n[0] + 1);
  let _ = out[0] = n[0];
  let k = [0];
  let go = 1;
  while go == 1 {
    let done = if k[0] >= n[0] then 1 else 0;
    let _ = if done == 0 then (let _ = out[k[0] + 1] = insns[k[0]] in 0) else 0;
    let _ = k[0] = k[0] + 1;
    let go = 1 - done;
    0
  };
  out
}


// ══════════════════════════════════════════════════════════════════════
// FAST PATH (OPT-C/D): virtual-register codegen for pure arithmetic,
// variable and literal subtrees. Everything else falls back to the
// legacy stack machine by resetting n[0] and pos[0] -- the insn buffer
// is append-only, so a failed attempt rolls back by counter alone.
//
// Virtual registers by expression depth: 0->x0, 1->x1, 2..6->x9..x13.
// Depth >= 7 or any non-arithmetic construct -> legacy path.
//
// Constant tracking (OPT-C): cx[10+d]=value, cx[30+d]=known-flag; when
// both operands of an op are known the operation is computed at compile
// time and NO instruction is emitted for it.
// ══════════════════════════════════════════════════════════════════════

// Register number for expression depth d (-1 => beyond fast capacity).
fn emit_zeros(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let base = fntab[5387] - 1;
  let _ = vs_park(insns, n, fntab, stab, 1);
  let _ = vs_evict(insns, n, fntab, stab, 1);
  let _ = vs_mat(insns, n, fntab, stab, base, 1);
  let _ = vs_pop(fntab);
  // lsl x1,x1,#3 (bytes): assembler-verified 0xD37DF421? no —
  // 0xD3400000-family UBFM alias; 3548246049 == true LSL #3.
  let _ = em(insns, n, 3548246049);
  let _ = em(insns, n, 2432711713);
  let _ = em(insns, n, 3544513569);
  let _ = em(insns, n, 3548179489);
  let _ = em(insns, n, 2334065504);
  let _ = em(insns, n, 2332099451);
  // T118 (D11-D, 2026-09-05): arena capacity trap -- cmp x27,x28 ; b.ls +2 ; brk #80
  // (exit 80 = arena exhausted, was a silent walk past the mapping and a SIGSEGV later;
  // T90 2c: the entry stub's SIGTRAP handler prints `trap 80: ...`)
  let _ = em(insns, n, 3944481663);
  let _ = em(insns, n, 1409286217);
  let _ = em(insns, n, 3558869504);
  // Interpreter zeros(n) zeroes every element (qtt.c TERM_ZEROS eval); the
  // JIT must too: exec_words resets the bump-arena cursor to its base on
  // every call_jit, so a second invocation re-allocates the SAME addresses
  // and would observe stale counts/pointers (stab[0] garbage -> sym_lookup
  // runs away). Zero the rounded region: sub x2,x27,x1; add x3,x27,#0;
  // cbz x1,+3; str xzr,[x2],#8; cmp x2,x3; b.ne -2. All assembler-verified.
  // T118d (2026-09-12): compute block start as x27-x1 (not x0), and block end
  // as x27 (not x0+x1), so the trap 80 check prevents SIGSEGV on overflow.
  let _ = em(insns, n, 3405841250);
  let _ = em(insns, n, 2432697187);
  let _ = em(insns, n, 3019899009);
  let _ = em(insns, n, 4160783455);
  let _ = em(insns, n, 3942842463);
  let _ = em(insns, n, 1426063297);
  // ROADMAP A5 step 1b (2026-09-08): the VALUE of a [i64] is an x17-relative CELL
  // INDEX, never an address -- sub x0,x0,x17 (3406888960) ; lsr x0,x0,#3
  // (3544448000). Logical shift is right here: x27 >= x17 always, so the byte
  // delta is non-negative. The T118 arena trap above is untouched.
  let _ = em(insns, n, 3406888960);
  let _ = em(insns, n, 3544448000);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// ---------- M4 CLI (bebop.bin) ----------
// Subcommands: compile <src.bp> <out.bin> | size <file> | version | run-via-exec <src.bp>
// Args contract (seed loader v4): x0 = argc, x1 = pointer array of
// NUL-terminated argument strings copied into the bump arena.

fn strequals(s: str, p: [i64]) -> i64 {
  let i = 0;
  let same = 1;
  let done = 0;
  while done == 0 {
    let c = char(s, i);
    let pc = p[i];
    let isz = if c == 0 then 1 else 0;
    let mdiff = if c == pc then 0 else 1;
    let snew = if isz == 1 then same else same * (1 - mdiff);
    let same = snew;
    let i = i + 1;
    let done = isz;
    0
  };
  same
}

// Copy a NUL-terminated byte string into cell slots (byte per element) —
// sys_open's path contract is a CELL buffer, argv strings are BYTE strings.
// T108 .becache (2026-09-05): `<out>.becache` = [compiler bytes][expanded source
// bytes]. A compile whose compiler binary (argv[1]), expanded source and existing
// <out> are byte-identical to that record returns before emit_words. No hash: the
// key is the exact bytes, so a hit can never be a collision (D11 honesty floor).
// Streamed in 8192-byte chunks (two scratch buffers, no arena growth: a 1M-cell
// buffer tripped the arena trap 80). Publish mode (argc >= 6) bypasses the cache.
// chunk_eq(ta, tb, n): 1 iff the first n cells agree.
fn chunk_eq(ta: [i64], tb: [i64], n: i64) -> i64 {
  let ok = 1;
  let k = 0;
  while k < n * ok {
    let ok = if ta[k] == tb[k] then 1 else 0;
    let k = k + 1;
    0
  };
  ok
}
// cache_hit(cfd, kfd, srcv): the cache stream == compiler stream ++ source bytes, exactly.
fn cache_hit(cfd: i64, kfd: i64, srcv: str, ta: [i64], tb: [i64]) -> i64 {
  let ok = 1;
  let go = 1;
  while go == 1 {
    let rk = sys_read(kfd, tb, 8192);
    let rc = if rk > 0 then sys_read(cfd, ta, rk) else 0;
    let ok = if rk > 0 then (if rc == rk then chunk_eq(ta, tb, rk) else 0) else ok;
    let go = if rk > 0 then ok else 0;
    0
  };
  let sl = str_len(srcv);
  let off = 0;
  while off < sl * ok {
    let want = if sl - off < 8192 then sl - off else 8192;
    let rc = sys_read(cfd, ta, want);
    let ok = if rc == want then 1 else 0;
    let k = 0;
    while k < rc * ok {
      let ok = if ta[k] == char(srcv, off + k) then 1 else 0;
      let k = k + 1;
      0
    };
    let off = off + want;
    0
  };
  let tail = if ok == 1 then sys_read(cfd, ta, 8192) else 1;
  if tail == 0 then ok else 0
}
// cache_write(cfd, kfd, srcv): stream the compiler bytes then the source bytes.
fn cache_write(cfd: i64, kfd: i64, srcv: str, ta: [i64]) -> i64 {
  let go = 1;
  while go == 1 {
    let rk = sys_read(kfd, ta, 8192);
    let _ = if rk > 0 then sys_write(cfd, ta, rk) else 0;
    let go = if rk > 0 then 1 else 0;
    0
  };
  let sl = str_len(srcv);
  let off = 0;
  while off < sl {
    let want = if sl - off < 8192 then sl - off else 8192;
    let k = 0;
    while k < want {
      let _ = ta[k] = char(srcv, off + k);
      let k = k + 1;
      0
    };
    let _ = sys_write(cfd, ta, want);
    let off = off + want;
    0
  };
  0
}

fn str_to_cells(dst: [i64], src: str) -> i64 {
  let i = 0;
  let done = 0;
  while done == 0 {
    let c = char(src, i);
    let isz = if c == 0 then 1 else 0;
    let _ = if isz == 0 then (let _ = dst[i] = c in 0) else 0;
    let i = i + 1;
    let done = isz;
    0
  };
  i
}

fn fill_compile(p: [i64]) -> i64 {
  let _ = p[0] = 99; let _ = p[1] = 111; let _ = p[2] = 109; let _ = p[3] = 112; let _ = p[4] = 105; let _ = p[5] = 108; let _ = p[6] = 101;
  7
}
fn fill_size(p: [i64]) -> i64 {
  let _ = p[0] = 115; let _ = p[1] = 105; let _ = p[2] = 122; let _ = p[3] = 101;
  4
}
fn fill_version(p: [i64]) -> i64 {
  let _ = p[0] = 118; let _ = p[1] = 101; let _ = p[2] = 114; let _ = p[3] = 115; let _ = p[4] = 105; let _ = p[5] = 111; let _ = p[6] = 110;
  7
}
fn fill_run(p: [i64]) -> i64 {
  let _ = p[0] = 114; let _ = p[1] = 117; let _ = p[2] = 110; let _ = p[3] = 45; let _ = p[4] = 118; let _ = p[5] = 105; let _ = p[6] = 97; let _ = p[7] = 45; let _ = p[8] = 101; let _ = p[9] = 120; let _ = p[10] = 101; let _ = p[11] = 99;
  12
}

fn idx_of_main(fnames: [i64], cnt: i64) -> i64 {
  let k = 0;
  let idx = 0;
  while k < cnt {
    let ism = if fnames[k] == 246720401 then 1 else 0;
    let idx = if ism == 1 then k else idx;
    let k = k + 1;
    0
  };
  idx
}

// ---- T47 (2026-09-05): `use "path"` textual inclusion, one level, deduped ----
// cli_compile scans the main source for lines that start with `use "` (column
// 0), reads each named file ONCE (path hash = sum(byte*131) over the path, kept
// in a 64-entry table), and builds one byte buffer: every included file in
// order of first use, then the main source with each `use` line turned into a
// `//` comment (positions inside the main text are unchanged). The buffer is
// exported to <out>.use and slurped back, so every later stage (emit_words,
// emit_offsets, collect_fns) sees one string. Nested `use` inside an included
// file is not followed (documented; T47b).
fn use_path_hash(cells: [i64], n: i64) -> i64 {
  let i = 0;
  let h = 0;
  while i < n {
    let h = h * 131 + cells[i];
    let i = i + 1;
    0
  };
  h
}

// Copy the bytes of str src (NUL-terminated) into dst cells at off; returns the new off.
fn use_append_str(dst: [i64], off: i64, src: str) -> i64 {
  let i = 0;
  let done = 0;
  while done == 0 {
    let c = char(src, i);
    let isz = if c == 0 then 1 else 0;
    let _ = if isz == 0 then (let _ = dst[off + i] = c in 0) else 0;
    let i = i + 1;
    let done = isz;
    0
  };
  off + i - 1
}

// ---- A25: Textual rewriter primitives ----
// src_copy_range(dst, off, s, from, to) -> new_off
// Copy bytes s[from..to) into dst starting at offset off.
// Returns the new offset after the copied bytes.
// Bounds-checked: if to > len(s) or from > to, exit 84.
fn src_copy_range(dst: [i64], off: i64, s: str, from: i64, to: i64) -> i64 {
  let strn = str_len(s);
  let oob = (if from < 0 then 1 else 0) + (if to > strn then 1 else 0) + (if from > to then 1 else 0);
  let _ = if oob > 0 then cli_exit(84, "src_copy_range: bounds check failed") else 0;
  let i = from;
  let out = off;
  while i < to {
    let c = char(s, i);
    let _ = dst[out] = c;
    let i = i + 1;
    let out = out + 1;
    0
  };
  out
}

// src_rename_idents: NOT IMPLEMENTED -- a LOUD trap on purpose, never a silent copy.
// The shape it needs is a FLAT while loop over [from, to) with a four-way branch, not
// nested lets: at each position dispatch on string start (skip_string_n, :2162), `//`
// comment start (skip_line_comment_n, :2146), identifier start (read_ident's 131-rolling
// hash, :154/:164 -- compare the hash plus a length rather than characters), else copy one
// byte. collect_fns (:6125) already skips strings and comments in exactly that shape at
// :6189-6190; copy its structure. The earlier attempt failed on exit 101 `unbound symbol`,
// which is a scoping mistake (a `let` inside an `if` arm does not escape the arm), not a
// limit of the language.
fn src_rename_idents(dst: [i64], off: i64, s: str, from: i64, to: i64, old: str, new: str) -> i64 {
  cli_exit(84, "src_rename_idents: NOT IMPLEMENTED")
}

// Expand `use` lines of srcv into a fresh source string (or return srcv when
// there are none). tmpc/tmpl = the scratch file path cells/length.
// use_comment(buf, base, txt): overwrite every line-initial `use "` in buf[base..] (a copy
// of txt) with `//` so the expanded text carries no raw use lines.
fn use_comment(buf: [i64], base: i64, txt: str) -> i64 {
  let strn = str_len(txt);
  let m = 0;
  let bol2 = 1;
  while m < strn {
    let c = char(txt, m);
    let is_use = bol2 * (if c == 117 then 1 else 0) * (if char(txt, m + 1) == 115 then 1 else 0) * (if char(txt, m + 2) == 101 then 1 else 0) * (if char(txt, m + 3) == 32 then 1 else 0) * (if char(txt, m + 4) == 34 then 1 else 0);
    let _ = if is_use == 1 then (let _ = buf[base + m] = 47 in (let _ = buf[base + m + 1] = 47 in 0)) else 0;
    let bol2 = if c == 10 then 1 else 0;
    let m = m + 1;
    0
  };
  0
}
// T80 (2026-09-06): content-addressed imports. `use "cas://sha256:<64 hex>"` resolves to
// `.bcas/<hex>.bp`; after the slurp the file's SHA-256 must equal the hex or the compile
// exits 88 -- a module is named by what it IS. cas_prefix: does the path start with
// "cas://sha256:" (13 chars) and carry 64 hex digits? cas_path: build the real path.
// cas_verify: sha256_words over the bytes, compare against the hex, exit 88 on mismatch.
fn cas_prefix(p: [i64], pl: i64) -> i64 {
  let pre = [99, 97, 115, 58, 47, 47, 115, 104, 97, 50, 53, 54, 58];
  let ok = if pl == 77 then 1 else 0;
  let i = 0;
  while i < 13 * ok {
    let ok = if p[i] == pre[i] then ok else 0;
    let i = i + 1;
    0
  };
  ok
}
fn cas_path(p: [i64], real: [i64]) -> i64 {
  let pre = [46, 98, 99, 97, 115, 47];
  let i = 0;
  while i < 6 {
    let _ = real[i] = pre[i];
    let i = i + 1;
    0
  };
  let j = 0;
  while j < 64 {
    let _ = real[6 + j] = p[13 + j];
    let j = j + 1;
    0
  };
  let _ = real[70] = 46;
  let _ = real[71] = 98;
  let _ = real[72] = 112;
  73
}
fn hexval(c: i64) -> i64 {
  if c >= 97 then c - 87 else if c >= 65 then c - 55 else c - 48
}
fn cas_verify(inc: str, p: [i64]) -> i64 {
  let n = str_len(inc);
  let bytes = zeros(n + 1);
  let i = 0;
  while i < n {
    let _ = bytes[i] = char(inc, i);
    let i = i + 1;
    0
  };
  let h = zeros(8);
  let _ = sha256_words(bytes, n, h);
  let ok = 1;
  let w = 0;
  while w < 8 {
    let want = 0;
    let d = 0;
    while d < 8 {
      let want = want * 16 + hexval(p[13 + w * 8 + d]);
      let d = d + 1;
      0
    };
    let ok = if h[w] == want then ok else 0;
    let w = w + 1;
    0
  };
  let _ = if ok == 0 then cli_exit(88, "CAS module hash does not match its name") else 0;
  ok
}
// use_scan(srcv, buf, off, seen, nseen): T47b (2026-09-06) nested `use`: for every
// line-initial `use "path"` of srcv, a fresh path (content hash not in seen) is slurped,
// scanned RECURSIVELY (its own uses land first, dependencies before dependents), then
// appended with its use lines commented. Returns the number of use lines seen at
// this level. Cycles and repeats are cut by the seen table (64 paths).
fn use_scan(srcv: str, buf: [i64], off: [i64], seen: [i64], nseen: [i64]) -> i64 {
  let strn = str_len(srcv);
  let pathc = zeros(512);
  let real = zeros(80);
  let i = 0;
  let bol = 1;
  let nuse = 0;
  while i < strn {
    let c = char(srcv, i);
    let is_use = bol * (if c == 117 then 1 else 0) * (if char(srcv, i + 1) == 115 then 1 else 0) * (if char(srcv, i + 2) == 101 then 1 else 0) * (if char(srcv, i + 3) == 32 then 1 else 0) * (if char(srcv, i + 4) == 34 then 1 else 0);
    let j = i + 5;
    let pl = 0;
    let go = is_use;
    while go == 1 {
      let pc = char(srcv, j + pl);
      let end = (if pc == 34 then 1 else 0) + (if pc == 0 then 1 else 0) + (if pc == 10 then 1 else 0);
      let _ = if end == 0 then (let _ = pathc[pl] = pc in 0) else 0;
      let pl = pl + (1 - end);
      let go = 1 - end;
      0
    };
    let h = if is_use == 1 then use_path_hash(pathc, pl) else 0;
    let k = 0;
    let dup = 0;
    while k < nseen[0] {
      let dup = dup + (if seen[k] == h then 1 else 0);
      let k = k + 1;
      0
    };
    let fresh = is_use * (if dup == 0 then 1 else 0) * (if nseen[0] < 64 then 1 else 0);
    let _ = if fresh == 1 then (let _ = seen[nseen[0]] = h in (let _ = nseen[0] = nseen[0] + 1 in 0)) else 0;
    let is_cas = fresh * cas_prefix(pathc, pl);
    let rl = if is_cas == 1 then cas_path(pathc, real) else pl;
    let src_path = if is_cas == 1 then real else pathc;
    let fd = if fresh == 1 then sys_open(src_path, rl, 0) else 0 - 1;
    let _ = if fd < 0 then (if fresh == 1 then cli_exit(90, "open failed (source, output or binary file)") else 0) else 0;
    let inc = if fresh == 1 then sys_slurp(fd, src_slurp_cap()) else srcv;
    let _ = if fresh == 1 then (if str_len(inc) >= src_slurp_cap() then cli_exit(113, "included file too large -- it reached the slurp cap and would be silently truncated mid-program") else 0) else 0;
    let _ = if fresh == 1 then sys_close(fd) else 0;
    let _ = if fresh * is_cas == 1 then cas_verify(inc, pathc) else 0;
    let _ = if fresh == 1 then use_scan(inc, buf, off, seen, nseen) else 0;
    let base = off[0];
    let _ = if fresh == 1 then (let _ = off[0] = use_append_str(buf, base, inc) in 0) else 0;
    let _ = if fresh == 1 then use_comment(buf, base, inc) else 0;
    let _ = if fresh == 1 then (let _ = buf[off[0]] = 10 in (let _ = off[0] = off[0] + 1 in 0)) else 0;
    let nuse = nuse + is_use;
    let bol = if c == 10 then 1 else 0;
    let i = i + 1;
    0
  };
  nuse
}
fn use_expand(srcv: str, tmpc: [i64], tmpl: i64) -> str {
  let seen = zeros(64);
  let nseen = zeros(1);
  let buf = zeros(1600000);
  let off = zeros(1);
  let nuse = use_scan(srcv, buf, off, seen, nseen);
  // main text, with every `use` line commented out in place
  let base = off[0];
  let _ = off[0] = use_append_str(buf, base, srcv);
  let _ = use_comment(buf, base, srcv);
  let total = off[0];
  let ofd = if nuse > 0 then sys_open(tmpc, tmpl, 578) else 0 - 1;
  let _ = if nuse > 0 then (if ofd < 0 then cli_exit(90, "open failed (source, output or binary file)") else 0) else 0;
  let _ = if nuse > 0 then sys_export(ofd, buf, total) else 0;
  let _ = if nuse > 0 then sys_close(ofd) else 0;
  let rfd = if nuse > 0 then sys_open(tmpc, tmpl, 0) else 0 - 1;
  let out = if nuse > 0 then sys_slurp(rfd, 1600000) else srcv;
  let _ = if nuse > 0 then sys_close(rfd) else 0;
  out
}

