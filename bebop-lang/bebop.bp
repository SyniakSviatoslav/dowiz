  // artifact to tmp via mmap (ftruncate + MAP_SHARED stores, NO sys_write on
  // the artifact path), close, then renameat(tmp, out): the artifact appears
  // atomically - readers never observe a partially-written .bin. Without
  // argv[5]: direct export to out.
  let rc2 = 0;
  let publish = if argc >= 6 then 1 else 0;
  let ptmp = zeros(256);
  let ptl = [0];
  let _ = if publish == 1 then (let _ = ptl[0] = str_len(argv[5]) in 0) else 0;
  let _ = if publish == 1 then str_to_cells(ptmp, argv[5]) else 0;
  let tg = if publish == 1 then ptmp else pout;
  let tl = if publish == 1 then ptl[0] else lo;
  let ofd = sys_open(tg, tl, 578);
  let _ = if ofd < 0 then cli_exit(90, "open failed (source, output or binary file)") else 0;
  let rc2 = sys_export(ofd, buf, nb);
  let _ = sys_close(ofd);
  let kfd1 = if nocache == 1 then 0 - 1 else sys_open(pcomp, lc, 0);
  let cfd1 = if kfd1 >= 0 then sys_open(cpath, lo + 8, 578) else 0 - 1;
  let _ = if cfd1 >= 0 then cache_write(cfd1, kfd1, srcv, ta) else 0;
  let _ = if cfd1 >= 0 then sys_close(cfd1) else 0;
  let _ = if kfd1 >= 0 then sys_close(kfd1) else 0;
  let rn = if publish == 1 then sys_rename(ptmp, ptl[0], pout, lo) else 0;
  rc2 * 10 + rn
}

// T90 step 2b (2026-09-06): `bebop.bin check <src.bp>` -- the whole compile (use expansion,
// planning, emission) without an output file: exit 0 when the program compiles, else the
// same `line:col: <message>` + exit 95-99 as `compile`. The T47 expansion scratch is
// `<src>.use` (written only when the source has `use` lines); nothing is cached.
fn fill_check(p: [i64]) -> i64 {
  let _ = p[0] = 99; let _ = p[1] = 104; let _ = p[2] = 101; let _ = p[3] = 99; let _ = p[4] = 107;
  5
}
fn cli_check(argc: i64, argv: [str]) -> i64 {
  let _ = if argc >= 4 then 0 else cli_exit(64, "unknown CLI command (compile, check, size, version, run-via-exec, cas) or check without a file");
  let src = argv[3];
  let ls = str_len(src);
  let psrc = zeros(ls + 1);
  let _ = str_to_cells(psrc, src);
  let fd = sys_open(psrc, ls, 0);
  let _ = if fd < 0 then cli_exit(90, "open failed (source, output or binary file)") else 0;
  let srcv0 = sys_slurp(fd, src_slurp_cap());
  let _ = if str_len(srcv0) >= src_slurp_cap() then cli_exit(113, "source file too large -- it reached the slurp cap and would be silently truncated mid-program") else 0;
  let _ = sys_close(fd);
  let tmpc = zeros(ls + 5);
  let _ = str_to_cells(tmpc, src);
  let _ = tmpc[ls] = 46;
  let _ = tmpc[ls + 1] = 117;
  let _ = tmpc[ls + 2] = 115;
  let _ = tmpc[ls + 3] = 101;
  let srcv = use_expand(srcv0, tmpc, ls + 4);
  let offs = zeros(784);
  let words0 = emit_words_offs(srcv, offs);
  words0[0] * 0
}

// T80 (2026-09-06): `bebop.bin cas add <file>` -- the file's SHA-256 names it: the bytes
// are stored as .bcas/<hex>.bp (the directory must exist; exit 90 otherwise) and the
// address line `cas://sha256:<hex>` is written to stdout, ready to paste into a `use`.
fn fill_cas(p: [i64]) -> i64 {
  let _ = p[0] = 99; let _ = p[1] = 97; let _ = p[2] = 115;
  3
}
fn fill_add(p: [i64]) -> i64 {
  let _ = p[0] = 97; let _ = p[1] = 100; let _ = p[2] = 100;
  3
}
fn hexdig(v: i64) -> i64 {
  if v < 10 then 48 + v else 87 + v
}
fn cli_cas(argc: i64, argv: [str]) -> i64 {
  let badd = zeros(8);
  let _ = fill_add(badd);
  let is_add = if argc >= 5 then strequals(argv[3], badd) else 0;
  let _ = if is_add == 0 then cli_exit(64, "unknown CLI command (compile, check, size, version, run-via-exec, cas) or check without a file") else 0;
  let f = argv[4];
  let lf = str_len(f);
  let pf = zeros(lf + 1);
  let _ = str_to_cells(pf, f);
  let fd = sys_open(pf, lf, 0);
  let _ = if fd < 0 then cli_exit(90, "open failed (source, output or binary file)") else 0;
  let src = sys_slurp(fd, src_slurp_cap());
  let _ = if str_len(src) >= src_slurp_cap() then cli_exit(113, "source file too large -- it reached the slurp cap and would be silently truncated mid-program") else 0;
  let _ = sys_close(fd);
  let n = str_len(src);
  let bytes = zeros(n + 1);
  let i = 0;
  while i < n {
    let _ = bytes[i] = char(src, i);
    let i = i + 1;
    0
  };
  let h = zeros(8);
  let _ = sha256_words(bytes, n, h);
  let addr = zeros(80);
  let pre = [99, 97, 115, 58, 47, 47, 115, 104, 97, 50, 53, 54, 58];
  let k = 0;
  while k < 13 {
    let _ = addr[k] = pre[k];
    let k = k + 1;
    0
  };
  let d = 0;
  while d < 64 {
    let _ = addr[13 + d] = hexdig((h[d / 8] >> (28 - 4 * (d % 8))) & 15);
    let d = d + 1;
    0
  };
  let _ = addr[77] = 10;
  let real = zeros(80);
  let rl = cas_path(addr, real);
  let ofd = sys_open(real, rl, 578);
  let _ = if ofd < 0 then cli_exit(90, "open failed (source, output or binary file)") else 0;
  let _ = sys_export(ofd, bytes, n);
  let _ = sys_close(ofd);
  let _ = sys_write(1, addr, 78);
  0
}
fn cli_size(argv: [str]) -> i64 {
  let f = argv[3];
  let lf = str_len(f);
  let pf = zeros(lf + 1);
  let _ = str_to_cells(pf, f);
  let fd = sys_open(pf, lf, 0);
  let buf = zeros(8192);
  let total = [0];
  let nr = sys_read(fd, buf, 8192);
  let _ = total[0] = total[0] + nr;
  let done = if nr > 0 then 0 else 1;
  while done == 0 {
    let nr2 = sys_read(fd, buf, 8192);
    let _ = total[0] = total[0] + nr2;
    let done = if nr2 > 0 then 0 else 1;
    0
  };
  let _ = sys_close(fd);
  total[0] / 4
}

fn cli_run(argv: [str]) -> i64 {
  // run-via-exec needs the C-side exec builtin (not in the self-hosted
  // emitter); post-C execution = `seed <compiled.bin>`. Return 2.
  2
}

// sys_ftruncate(fd,len): ftruncate — mmap-export path (F2).
fn emit_sys_ftruncate(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 2);
  em(insns, n, 3531605448);
  em(insns, n, 3556769793);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_munmap(addr,len): munmap — mmap-export path (F2).
fn emit_sys_munmap(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 2);
  // A5 step 1b: cell argument -> address, add x0,x17,x0,lsl #3.
  let _ = em(insns, n, 2332036640);
  em(insns, n, 3531610856);
  em(insns, n, 3556769793);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_export(fd, cells, len): F2 mmap-export — ftruncate, mmap the file,
// store low bytes of cells directly into the mapped region (NO scratch, NO
// sys_write), munmap. Returns 0. objdump-verified 2026-09-01.
fn emit_sys_export(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 3);
  // A5 step 1b: cell argument -> address, add x1,x17,x1,lsl #3.
  let _ = em(insns, n, 2332102177);
  em(insns, n, 2852127723);
  em(insns, n, 2852193260);
  em(insns, n, 2852258797);
  em(insns, n, 2852848608);
  em(insns, n, 2852979681);
  em(insns, n, 3531605448);
  em(insns, n, 3556769793);
  em(insns, n, 2854159328);
  em(insns, n, 2852979681);
  em(insns, n, 3531604066);
  em(insns, n, 3531604003);
  em(insns, n, 2852848612);
  em(insns, n, 2854159333);
  em(insns, n, 3531611080);
  em(insns, n, 3556769793);
  em(insns, n, 2852127722);
  em(insns, n, 2854159337);
  em(insns, n, 3943498047);
  em(insns, n, 1409286314);
  em(insns, n, 4167661959);
  em(insns, n, 942238023);
  em(insns, n, 2432697641);
  em(insns, n, 402653179);
  em(insns, n, 2852783072);
  em(insns, n, 2852979681);
  em(insns, n, 3531610856);
  em(insns, n, 3556769793);
  em(insns, n, 2854159328);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

fn emit_sys_mmap(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 6);
  // A5 step 1b: cell argument -> address, add x0,x17,x0,lsl #3.
  let _ = em(insns, n, 2332036640);
  em(insns, n, 3531611080);
  em(insns, n, 3556769793);
  // A5 step 1b: the mapping's address -> a cell INDEX. ARITHMETIC shift, not
  // logical: file maps are placed by the kernel and may land below the reserve,
  // and `add x0,x17,x0,lsl #3` inverts an asr exactly for a negative index too
  // (page-aligned => the low 3 bits are 0). A negative errno stays negative.
  em(insns, n, 3406888960);
  em(insns, n, 2470706176);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_mapb(path, len): mmap a file into the reserve — path is a str handle
// (off<<32|len), len is the map length. openat the path, mmap PROT_READ,
// close the fd, return ((addr-x17)<<32)|len as a str handle. The caller reads
// the mapped bytes through char(addr_handle, i) like any other handle (A7 step 3).
fn emit_sys_mapb(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  // REFUSED, 2026-09-12 (ROADMAP A7). This emitter was WRONG and its wrongness was silent.
  // Disassembled from its own words: `lsr x2,x0,#32; add x2,x17,x2; and x3,x0,#0xffffffff`
  // then `openat(-100, x2, x3, 0)` -- so it passed the path's LENGTH as openat's FLAGS, and
  // took the path pointer from a `str` handle whose bytes NOTHING copies into the arena
  // (A7 step 2 landed the consumers and never landed the producer; `LIT0` appears twice in
  // the tree, in a comment and in a formula). emit_sys_open and emit_sys_rename both marshal
  // a byte-per-cell path into the 8 KiB IO scratch below x28 and NUL-terminate it first
  // (`sub x10,x28,#0x2000` ... `strb wzr,[x10,x13]`); this had no copy loop at all.
  // The consequence was measured: an A7 step 3 run wrote NINE files whose names were raw
  // `0xa8`-prefixed ADDRESSES, ~160 MB, into the repository, and they are in git history
  // still -- GitHub warns on every push. `sys_mapb` has ZERO call sites in the whole tree,
  // so refusing it costs no program anything and turns a silent wrong-file-write into a
  // compile error. It returns when A7 step 2 re-lands WHOLE (producer copy + a literal table
  // that does not collide + every consumer), with a path length argument and a construct.
  let _ = selfname; let _ = selfstart; let _ = insns; let _ = n; let _ = stab; let _ = fntab;
  diag_exit(s, pos[0], 108)
}
fn emit_sys_rename(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 4);
  // A5 step 1b: cell argument -> address, add x0,x17,x0,lsl #3.
  let _ = em(insns, n, 2332036640);
  // A5 step 1b: cell argument -> address, add x2,x17,x2,lsl #3.
  let _ = em(insns, n, 2332167714);
  em(insns, n, 2852127723);
  em(insns, n, 2852193261);
  em(insns, n, 2852258800);
  em(insns, n, 2852324332);
  em(insns, n, 3531866122);
  em(insns, n, 3406431114);
  em(insns, n, 3531603977);
  em(insns, n, 3943498047);
  em(insns, n, 1409286314);
  em(insns, n, 4167661927);
  em(insns, n, 942238023);
  em(insns, n, 2432697641);
  em(insns, n, 402653179);
  em(insns, n, 942500191);
  em(insns, n, 2852783083);
  em(insns, n, 2332885355);
  em(insns, n, 2432697707);
  em(insns, n, 3531603977);
  em(insns, n, 3943432511);
  em(insns, n, 1409286314);
  em(insns, n, 4167662087);
  em(insns, n, 942238055);
  em(insns, n, 2432697641);
  em(insns, n, 402653179);
  em(insns, n, 942434687);
  em(insns, n, 2457865312);
  em(insns, n, 2852783073);
  em(insns, n, 2457865314);
  em(insns, n, 2852848611);
  em(insns, n, 3531605192);
  em(insns, n, 3556769793);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_wait4(pid, status, options, rusage): raw wait4. x0=pid,x1=status,x2=options,
// x3=rusage,x8=260. status is the address of a cells array; the kernel writes a
// 32-bit int there (exit code = (status[0] >> 8) & 255). Same shape as emit_sys_rename.
fn emit_sys_wait4(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 4);
  // A5 step 1b: cell argument -> address, add x1,x17,x1,lsl #3.
  let _ = em(insns, n, 2332102177);
  em(insns, n, 3531612296);
  em(insns, n, 3556769793);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// A11(b) standalone (docs/blueprints/A11-harness-dogfooding.md §3(b)): sys_run(addr,
// size, argc, argv) -- named sys_run, not the blueprint's bare `run`: bench/vs_rust/
// std_tests/tdggeo.bp (mirrored from selfhost/std/tdggeo.bp) and sheafh0.bp already
// define their own 5-param `fn run` and call it that way in the gate corpus; dispatch
// is by identifier hash alone (no arity check), so reserving the bare `run` would
// silently hijack their call sites (bpref.py's RESERVED-word parse guard catches this
// exactly: 'reserved word used as a fn name: run', found by running tools/typecheck.py
// over the full std_tests/ corpus before landing this). sys_run in-process runs of an
// already-mmapped .bin (PROT_READ|PROT_EXEC, the
// caller mmaps it exactly like seed.S does), following the seed calling contract
// (seed/seed.S:2,50-100): entry_off = LE64 at base[size-8], entry = base + entry_off,
// x0=argc, x1=argv (a pointer array whose cells are addresses of NUL-terminated byte
// buffers -- already in the shape seed.S itself builds before its own `blr`), `blr` into
// it. The callee is an ordinary bebop fn: it runs its own prologue/epilogue and saves
// whatever x19-x26 pairs it uses, but its prologue ALSO rebinds x14 (frame-heap cursor)
// and x15 (spill base) from ITS OWN sp -- exactly what a plain `bl` callee does (emit_bl's
// own comment) -- so this call site needs the identical caller-side save/restore of
// x14/x15 around it, keyed off the same conservative has_spills fact as every `bl` site
// in this fn, and the same call-site counter bump (fntab[3668]) so the planning pass's
// end-of-fn word-count correction (compile_fn_at_total_saved) accounts for this stp/ldp
// pair too. x9 is scratch (entry-offset arithmetic); named emit_sys_run so check_abi.py's
// sys_allow (regex over `fn emit_sys_\w+`) auto-allows its x9 writes the same way it
// already allows emit_sys_rename's x9 loop-index writes -- no check_abi.py change needed.
// Word-for-word derivation: as+objdump into $BEBOP_TMP/words.objdump before this edit.
fn emit_sys_run(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 4);
  // A5 step 1b: `addr` is a cell INDEX (it came from sys_mmap) -- add x0,x17,x0,lsl #3.
  let _ = em(insns, n, 2332036640);
  // A5 step 1b: argv is a cell INDEX too -- add x3,x17,x3,lsl #3 -- but its CELLS are
  // `str` values, and a caller can only build them out of [i64] arrays, i.e. out of
  // indices. So sys_run converts the argv VECTOR at its own boundary as well, in
  // place, argc entries of it:
  //   mov x9,xzr ; L: cmp x9,x2 ; b.ge +6 ; ldr x10,[x3,x9,lsl #3] ;
  //   add x10,x17,x10,lsl #3 ; str x10,[x3,x9,lsl #3] ; add x9,x9,#1 ; b L
  // The callee's entry stub then turns the vector itself back into an index for its
  // `main(argc, argv: [str])`, and the raw pointers inside it are what `char()` and
  // `str_len()` need. IN PLACE is safe for every caller in the corpus because sys_run
  // is only ever issued from a sys_clone(17) fork child (gb_run.bp's own comment says
  // why: entering another image's stub reconfigures the caller's arena registers), so
  // the array converted is always that child's private COW copy -- gb_pool builds its
  // argv2 once in the parent and 100 fork children each convert their own.
  let _ = em(insns, n, 2332233251);
  let _ = em(insns, n, 2854159337);
  let _ = em(insns, n, 3942777151);
  let _ = em(insns, n, 1409286346);
  let _ = em(insns, n, 4167661674);
  let _ = em(insns, n, 2332692010);
  let _ = em(insns, n, 4163467370);
  let _ = em(insns, n, 2432697641);
  let _ = em(insns, n, 402653178);
  let _ = fntab[3668] = fntab[3668] + 1;
  let has_spills = 1 - fntab[3669];
  let _ = if has_spills == 1 then em(insns, n, 4162785263) else 0;
  em(insns, n, 3506446377);
  em(insns, n, 4167657481);
  em(insns, n, 2332622857);
  em(insns, n, 2852258784);
  em(insns, n, 2852324321);
  em(insns, n, 3594453280);
  let _ = if has_spills == 1 then em(insns, n, 4165011439) else 0;
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}


fn main(argc: i64, argv: [str]) -> i64 {
  let cmd = if argc >= 3 then argv[2] else 0;
  let bcmp = zeros(16);
  let bsize = zeros(8);
  let bver = zeros(8);
  let brun = zeros(16);
  let bcas = zeros(8);
  let bchk = zeros(8);
  let _ = fill_check(bchk);
  let _ = fill_cas(bcas);
  let _ = fill_compile(bcmp);
  let _ = fill_size(bsize);
  let _ = fill_version(bver);
  let _ = fill_run(brun);
  let is_compile = if argc >= 3 then strequals(cmd, bcmp) else 0;
  let is_size = if argc >= 3 then strequals(cmd, bsize) else 0;
  let is_version = if argc >= 3 then strequals(cmd, bver) else 0;
  let is_run = if argc >= 3 then strequals(cmd, brun) else 0;
  let is_cas = if argc >= 3 then strequals(cmd, bcas) else 0;
  let is_check = if argc >= 3 then strequals(cmd, bchk) else 0;
  let r7 = if is_check == 1 then cli_check(argc, argv) else 0;
  let r1 = if is_compile == 1 then cli_compile(argc, argv) else 0;
  let r2 = if is_size == 1 then cli_size(argv) else 0;
  let r3 = if is_run == 1 then cli_run(argv) else 0;
  let r4 = if is_version == 1 then 1000000 else 0;
  let r6 = if is_cas == 1 then cli_cas(argc, argv) else 0;
  let known = is_compile + is_size + is_version + is_run + is_cas + is_check;
  let r5 = if known == 0 then 64 else 0;
  r1 + r2 + r3 + r4 + r5 + r6 + r7
}
