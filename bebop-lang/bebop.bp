// selfhost/expr_compile.bp - real expression + function compiler (self-host).
//
// Two stages toward a self-hosting compiler:
//   1. compile(s)    - an arithmetic expression (digits, + - * /, parens,
//                      precedence, branchless conditional) to a stack-machine
//                      instruction sequence.
//   2. compile_fn(s) - a complete function (fn name(a,b,...) { body }) to a
//                      full AArch64 function (prologue + param moves + body +
//                      epilogue). Params map a->x19, b->x20, ... (moved from
//                      x0, x1, ... in the prologue; the stack machine only
//                      clobbers x0/x1, so params live in callee-saved regs).
//
// A faithful port of native/src/native.c emit_expr for the LIT + BIN arith +
// conditional subset. AArch64 words are decimal (Bebop has no hex literals).

module core { }

fn is_digit(c: i64) -> i64 {
  let ge48 = if c >= 48 then 1 else 0;
  let le57 = if c <= 57 then 1 else 0;
  ge48 * le57
}

fn is_alpha(c: i64) -> i64 {
  let ge97 = if c >= 97 then 1 else 0;
  let le122 = if c <= 122 then 1 else 0;
  let ge65 = if c >= 65 then 1 else 0;
  let le90 = if c <= 90 then 1 else 0;
  ge97 * le122 + ge65 * le90
}

// Read a multi-char identifier (letters/digits/underscore) starting at pos[0];
// return its polynomial hash (h = h*131 + c, i64-wrapping), advance pos past it.
fn read_ident(s: str, pos: [i64]) -> i64 {
  let strn = str_len(s);
  let h = 0;
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_us = if ch == 95 then 1 else 0;
    let is_id = is_alpha(ch) + is_digit(ch) + is_us;
    let h = if is_id == 1 then (h * 131 + ch) else h;
    let _ = pos[0] = pos[0] + is_id;
    let done = if is_id == 1 then 0 else 1;
    0
  };
  h
}

// Symbol table: stab[0] = count; pairs (name, reg) at stab[1+2i], stab[2+2i].
// Lookup name -> register (or -1 if unbound).
fn sym_lookup(s: str, stab: [i64], name: i64, srcpos: i64) -> i64 {
  let cnt = stab[0];
  let i = 0;
  let reg = 0 - 1;
  while i < cnt {
    let nm = stab[1 + 3 * i];
    let rg = stab[2 + 3 * i];
    let sp = stab[3 + 3 * i];
    let hhit = if nm == name then 1 else 0;
    let bhit = if hhit == 1 then ident_eq(s, sp, srcpos) else 0;
    let reg = if hhit * bhit == 1 then rg else reg;
    let i = i + 1;
    0
  };
  reg
}

// Byte-compare two identifier spellings at source offsets pa/pb: equal if
// the char sequences match exactly AND both end at a non-ident char.
fn ident_eq(s: str, pa: i64, pb: i64) -> i64 {
  let strn = str_len(s);
  let same = 1;
  let ia = [pa];
  let ib = [pb];
  let done = 0;
  while done == 0 {
    let ca = if ia[0] >= strn then 0 else char(s, ia[0]);
    let cb = if ib[0] >= strn then 0 else char(s, ib[0]);
    let ida = is_alpha(ca) + is_digit(ca) + (if ca == 95 then 1 else 0);
    let idb = is_alpha(cb) + is_digit(cb) + (if cb == 95 then 1 else 0);
    let cmp = if ca == cb then 0 else 1;
    let mdiff = if ida * idb == 1 then cmp else 0;
    let snew = if ida + idb == 1 then 0 else same * (1 - mdiff);
    let same = snew;
    let _ = ia[0] = ia[0] + 1;
    let _ = ib[0] = ib[0] + 1;
    let done = if ida + idb == 0 then 1 else 0;
    0
  };
  same
}

// Bind name to the next free register (x19+cnt) or a spill slot. Registers
// x19..x26 hold the first 8 bindings (x27/x28 reserved for the runner's
// bump-arena cursor/end); the 9th+ spill to a frame slot [x15 + slot*8]. The returned value encodes the location:
//   19..28      -> register-resident (mov x<reg>, x0 / mov x0, x<reg>)
//   100..100+S  -> spilled to slot S (str x0,[x15,#S*8] / ldr x0,[x15,#S*8])
//   0-2         -> table full (capacity assert: caller must emit a trap)
// Entries are (name, reg, srcpos) triples: binding and lookup byte-compare
// the spelling at the stored/queried source position, so hash collisions
// can never silently alias two names onto one register.
fn sym_bind(s: str, stab: [i64], name: i64, srcpos: i64) -> i64 {
  // Identifiers are 131-rolling hashes; on 64-bit hosts long names wrap
  // NEGATIVE. Only an exact zero (empty ident) is invalid.
  let ok = if name == 0 then 0 else 1;
  let existing = sym_lookup(s, stab, name, srcpos) * ok - (1 - ok);
  let cnt = stab[0];
  // x27/x28 are RESERVED: exec_words runner keeps its bump-arena cursor/end
  // there (global asm register vars). Symbols may occupy x19..x26 only.
  let is_full = if cnt >= 128 then 1 else 0;
  let is_spill = if cnt >= 8 then 1 else 0;
  let reg_register = 19 + cnt;
  let reg_spill = 100 + cnt - 8;
  let newreg = reg_register * (1 - is_spill) + reg_spill * is_spill;
  let is_new = if existing < 0 then 1 else 0;
  let reg = if is_new == 1 then newreg else existing;
  let full = is_new * is_full;
  let _ = if is_new * ok * (1 - full) == 1 then (let _ = stab[1 + 3 * cnt] = name in (let _ = stab[2 + 3 * cnt] = reg in (let _ = stab[3 + 3 * cnt] = srcpos in 0))) else 0;
  let _ = stab[0] = cnt + is_new * ok * (1 - full);
  let ret = if full == 1 then 0 - 2 else reg;
  ret
}

// Skip over a param's type annotation up to the next ',' or ')'.
fn skip_to_delim(s: str, pos: [i64]) -> i64 {
  let strn = str_len(s);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_comma = if ch == 44 then 1 else 0;
    let is_rp = if ch == 41 then 1 else 0;
    let is_delim = is_comma + is_rp;
    let _ = pos[0] = pos[0] + (1 - is_delim - at_end);
    let done = if is_delim + at_end >= 1 then 1 else 0;
    0
  };
  0
}

// Parse a param list (pos at '('): read each param name hash into pnames,
// advance pos past ')', return the count.
fn parse_params(s: str, pos: [i64], pnames: [i64], ppos: [i64]) -> i64 {
  let strn = str_len(s);
  let _ = pos[0] = pos[0] + 1;
  let pcnt = 0;
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_rp = if ch == 41 then 1 else 0;
    let is_letter = is_alpha(ch);
    let _ = if pcnt < 14 then (let _ = ppos[pcnt] = pos[0] in 0) else 0;
    let name = read_ident(s, pos);
    let _ = if pcnt < 14 then (let _ = pnames[pcnt] = name in 0) else 0;
    let pcnt = pcnt + is_letter;
    let _ = skip_to_delim(s, pos);
    let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch2 == 44 then 1 else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let done = if is_rp + at_end >= 1 then 1 else 0;
    0
  };
  let _ = pos[0] = pos[0] + 1;
  pcnt
}

// Identifier: a function call name(args) or a variable reference.
fn emit_ident(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let npos = pos[0];
  let name = read_ident(s, pos);
  let _ = skip_ws(s, pos);
  let strn = str_len(s);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  let is_lp = if ch == 40 then 1 else 0;
  let is_br = if ch == 123 then 1 else 0;
  let is_lb = if ch == 91 then 1 else 0;
  // NOTE: a bare `ident {` here would eat a while/if body as a struct
  // literal (latent bug that surfaced once OPT-B stopped masking it for
  // spilled-symbol programs). Struct literals are currently unused by
  // every kernel/test; the branch stays disabled until a context flag
  // distinguishes real struct construction from block openers.
  // T43 rest (2026-09-05): the context guard -- `NAME {` is a struct literal
  // only when NAME is the declared (first) struct, cached in fntab[3891]
  // (0 = not yet scanned, -1 = no struct), and we are not inside a `while`
  // condition (fntab[3892], set by emit_while_stmt): `while i < n {` stays a loop.
  let _ = if fntab[3891] == 0 then (let _ = fntab[3891] = struct_name_hash(s) in 0) else 0;
  let is_sname = (if name == fntab[3891] then 1 else 0) * (if name == 0 then 0 else 1);
  let struct_ok = is_sname * (1 - fntab[3892]);
  if is_lp == 1 then emit_call_or_ctor(s, name, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_br * struct_ok == 1 then emit_struct_lit(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_lb == 1 then emit_array_index(s, name, npos, pos, insns, n, stab, selfname, selfstart, fntab)
  else emit_var_or_ctor(s, name, npos, insns, n, stab, fntab)
}



// Skip over a struct field's type annotation up to the next ',' or '}'.
fn skip_to_field_delim(s: str, pos: [i64]) -> i64 {
  let strn = str_len(s);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_comma = if ch == 44 then 1 else 0;
    let is_rb = if ch == 125 then 1 else 0;
    let is_delim = is_comma + is_rb;
    let _ = pos[0] = pos[0] + (1 - is_delim - at_end);
    let done = if is_delim + at_end >= 1 then 1 else 0;
    0
  };
  0
}

// Scan for the first struct declaration ("struct "); record pos in out[0].
fn find_struct(s: str, out: [i64]) -> i64 {
  let strn = str_len(s);
  let j = 0;
  let found = 0;
  let best = 0;
  while j + 6 < strn {
    let c0 = char(s, j);
    let c1 = char(s, j + 1);
    let c2 = char(s, j + 2);
    let c3 = char(s, j + 3);
    let c4 = char(s, j + 4);
    let c5 = char(s, j + 5);
    let c6 = char(s, j + 6);
    let is_s = if c0 == 115 then 1 else 0;
    let is_t1 = if c1 == 116 then 1 else 0;
    let is_r = if c2 == 114 then 1 else 0;
    let is_u = if c3 == 117 then 1 else 0;
    let is_c = if c4 == 99 then 1 else 0;
    let is_t2 = if c5 == 116 then 1 else 0;
    let is_sp = if c6 == 32 then 1 else 0;
    // T43 rest: a declaration starts a line -- `struct ` inside a comment or a
    // string is not one (bebop.bp's own comments say "struct literal")
    let at_bol = if j == 0 then 1 else (if char(s, j - 1) == 10 then 1 else 0);
    let hit = is_s * is_t1 * is_r * is_u * is_c * is_t2 * is_sp * at_bol;
    let best = if hit == 1 then j else best;
    let found = if hit == 1 then 1 else found;
    let j = j + 1;
    0
  };
  let _ = out[0] = best;
  found
}

// 0-based index of field fname in the struct decl at spos ("struct "), -1 if absent.
fn field_index(s: str, spos: i64, fname: i64) -> i64 {
  let strn = str_len(s);
  let pos = [spos + 7];
  let _ = read_ident(s, pos);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let i = 0;
  let idx = 0 - 1;
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_rb = if ch == 125 then 1 else 0;
    let name = read_ident(s, pos);
    let is_match = if name == fname then 1 else 0;
    let idx = if is_match == 1 then i else idx;
    let i = i + 1;
    let _ = skip_to_field_delim(s, pos);
    let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch2 == 44 then 1 else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let done = if is_rb + at_end >= 1 then 1 else 0;
    0
  };
  idx
}

// Hash of the first declared struct's name (read_ident hash), -1 when the
// program declares none. Cached per program in fntab[3891] by emit_ident.
fn struct_name_hash(s: str) -> i64 {
  let spos = [0];
  let found = find_struct(s, spos);
  let p = [spos[0] + 7];
  let h = if found == 1 then read_ident(s, p) else 0 - 1;
  if h == 0 then 0 - 1 else h
}

// Emit one struct-literal field: read the name, resolve its declaration index
// (slots[fcnt] = index in the first struct's field list), skip ':', emit the
// value (it stays pushed; emit_struct_lit stores it after the bump).
fn emit_struct_field(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], fcnt: i64, slots: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let fname = read_ident(s, pos);
  let spos = [0];
  let _ = find_struct(s, spos);
  let idx = field_index(s, spos[0], fname);
  let _ = slots[fcnt] = if idx < 0 then fcnt else idx;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  n[0]
}

// Emit a struct literal NAME { f: v, ... }: the declaration order is the layout
// (c40 writes the fields out of order on purpose). Every field value is
// evaluated first (each stays on the stack), THEN mov x0,x14; add x14,#8n
// (+ the T118 frame trap) and the values are popped into their slots from the
// last down -- the same order rule as emit_array_lit (T42).
fn emit_struct_lit(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let strn = str_len(s);
  let _ = pos[0] = pos[0] + 1;
  let slots = zeros(16);
  let fcnt = 0;
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_rb = if ch == 125 then 1 else 0;
    let _ = if is_rb == 0 then emit_struct_field(s, pos, insns, n, stab, fcnt, slots, selfname, selfstart, fntab) else 0;
    let fcnt = if is_rb == 0 then fcnt + 1 else fcnt;
    let _ = skip_ws(s, pos);
    let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch2 == 44 then 1 else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let done = if is_rb + at_end >= 1 then 1 else 0;
    0
  };
  let _ = pos[0] = pos[0] + 1;
  let _ = em(insns, n, 2853045216);
  let _ = em(insns, n, 2432696320 + fcnt * 8192 + 462);
  let _ = em(insns, n, 2436894178);
  let _ = em(insns, n, 2436628546);
  let _ = em(insns, n, 3942777311);
  let _ = em(insns, n, 1409286281);
  let _ = em(insns, n, 3531606560);
  let _ = em(insns, n, 3531606984);
  let _ = em(insns, n, 3556769793);
  let k = fcnt;
  while k > 0 {
    let k = k - 1;
    let _ = pop(insns, n, 1, fntab);
    let _ = em(insns, n, 4177526785 + slots[k] * 1024);
    0
  };
  let _ = push(insns, n, fntab);
  n[0]
}

// Emit a field access .f: pop the base pointer, ldr x0,[x0,#idx*8], push.
fn emit_field_access(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let fname = read_ident(s, pos);
  let spos = [0];
  let _ = find_struct(s, spos);
  let idx = field_index(s, spos[0], fname);
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 4181721088 + idx * 1024);
  let _ = push(insns, n, fntab);
  n[0]
}

// Scan for the first enum declaration ("enum "); record pos in out[0].
fn find_enum(s: str, out: [i64]) -> i64 {
  // Lexical scan: skips strings/comments (same discipline as find_fn).
  // Raw scanning matched "enum " inside comments and string literals of
  // the compiler's own source -> phantom decl -> collect_ctors loop over
  // garbage with names[] overrun. Self-source is the first input that
  // actually contains those tokens.
  let strn = str_len(s);
  let j = 0;
  let found = 0;
  let best = strn;
  let spc = [0];
  let cpc = [0];
  while j + 4 < strn {
    let c0 = char(s, j);
    let c1 = char(s, j + 1);
    let c2 = char(s, j + 2);
    let c3 = char(s, j + 3);
    let c4 = char(s, j + 4);
    let is_quote = if c0 == 34 then 1 else 0;
    let is_sl = if c0 == 47 then 1 else 0;
    let is_sl2 = if c1 == 47 then 1 else 0;
    let is_comment = is_sl * is_sl2;
    let is_e = if c0 == 101 then 1 else 0;
    let is_n = if c1 == 110 then 1 else 0;
    let is_u = if c2 == 117 then 1 else 0;
    let is_m = if c3 == 109 then 1 else 0;
    let is_sp = if c4 == 32 then 1 else 0;
    let hit = is_e * is_n * is_u * is_m * is_sp * (1 - is_quote) * (1 - is_comment);
    let best = if hit == 1 then j else best;
    let found = if hit == 1 then 1 else found;
    let _ = spc[0] = j;
    let _ = cpc[0] = j;
    let _ = if is_quote == 1 then skip_string(s, spc) else 0;
    let _ = if is_comment == 1 then skip_line_comment(s, cpc) else 0;
    let jnext = (j + 1) * (1 - is_quote - is_comment - hit) + spc[0] * is_quote + cpc[0] * is_comment;
    let j = if hit == 1 then j + 5 else jnext;
    0
  };
  let _ = out[0] = best;
  found
}

// Tag (0-based) of ctor name in the enum decl, or -1 if absent / no enum.

// Emit an enum ctor with a payload: ctor(expr) -> [tag, payload] block.
fn emit_enum_ctor(s: str, tag: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = em(insns, n, 3531603968 + tag * 32);
  let _ = em(insns, n, 4177527232);
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 4177528256);
  let _ = pos[0] = pos[0] + 1;
  let _ = em(insns, n, 2853045216);
  let _ = em(insns, n, 2432713166);
  // T118 (D11-D): frame-heap capacity trap -- the frame is 16 KiB from the
  // prologue sp and x15 = sp+256, so the heap end is x15 + 16128:
  // add x2,x15,#12288 ; add x2,x2,#3840 ; cmp x14,x2 ; b.ls +4 ; mov x0,#81 ;
  // mov x8,#94 ; svc  (exit 81 = frame heap exhausted)
  let _ = em(insns, n, 2436894178);
  let _ = em(insns, n, 2436628546);
  let _ = em(insns, n, 3942777311);
  let _ = em(insns, n, 1409286281);
  let _ = em(insns, n, 3531606560);
  let _ = em(insns, n, 3531606984);
  let _ = em(insns, n, 3556769793);
  let _ = push(insns, n, fntab);
  n[0]
}

// Emit a nullary enum ctor: ctor -> [tag] block (no payload).
fn emit_enum_ctor_nullary(insns: [i64], n: [i64], tag: i64, fntab: [i64]) -> i64 {
  let _ = em(insns, n, 3531603968 + tag * 32);
  let _ = em(insns, n, 4177527232);
  let _ = em(insns, n, 2853045216);
  let _ = em(insns, n, 2432713166);
  // T118 (D11-D): frame-heap capacity trap -- the frame is 16 KiB from the
  // prologue sp and x15 = sp+256, so the heap end is x15 + 16128:
  // add x2,x15,#12288 ; add x2,x2,#3840 ; cmp x14,x2 ; b.ls +4 ; mov x0,#81 ;
  // mov x8,#94 ; svc  (exit 81 = frame heap exhausted)
  let _ = em(insns, n, 2436894178);
  let _ = em(insns, n, 2436628546);
  let _ = em(insns, n, 3942777311);
  let _ = em(insns, n, 1409286281);
  let _ = em(insns, n, 3531606560);
  let _ = em(insns, n, 3531606984);
  let _ = em(insns, n, 3556769793);
  let _ = push(insns, n, fntab);
  n[0]
}

// Dispatch name( ... ): enum ctor (with payload) or a function call.
fn emit_bl(insns: [i64], n: [i64], target: i64, has_spills: i64) -> i64 {
  // x14 (frame-heap cursor) and x15 (spill base) are caller-saved: callees
  // rebind both from their own sp. A caller that allocates cells AFTER a
  // call (let k = [0] post-bl) or reads its own spill slots must get them
  // back. T103 (2026-09-05): one pair instead of the old 48-byte frame with
  // x15 saved twice -- stp x15,x14,[sp,#-16]! ; bl ; ldp x15,x14,[sp],#16
  // (0xA9BF3BEF / 0xA8C13BEF, as+objdump): 9 -> 3 words per call site.
  let _ = em(insns, n, 2847882223);
  let offset = target - n[0];
  let is_back = if offset < 0 then 1 else 0;
  let word = 2483027968 + offset + is_back * 67108864;
  let _ = em(insns, n, word);
  let _ = em(insns, n, 2831236079);
  n[0]
}

// Look up a function's start offset in the layout table; -1 if absent.
fn fntab_lookup(fntab: [i64], name: i64) -> i64 {
  let cnt = fntab[0];
  let i = 0;
  let start = 0 - 1;
  while i < cnt {
    let nm = fntab[1 + i];
    let st = fntab[1 + cnt + i];
    let is_match = if nm == name then 1 else 0;
    let start = if is_match == 1 then st else start;
    let i = i + 1;
    0
  };
  start
}

// Source-position ab over a 3-zone table [cnt, names..., offsets..., srcpos...]:
// returns the callee byte offset in source text, or -1 when absent
// (legacy single-fn path passes cnt=0). O(#fns) not O(source bytes).
fn ft_srcpos(tab: [i64], name: i64) -> i64 {
  let cnt = tab[0];

  let i = 0;
  let sp = 0 - 1;
  while i < cnt {
    let nm = tab[1 + i];
    let pos_i = tab[1 + cnt + cnt + i];
    let is_match = if nm == name then 1 else 0;
    let sp = if is_match == 1 then pos_i else sp;
    let i = i + 1;
    0
  };
  sp
}

// Collect ctor names of the FIRST enum decl into names[0..): single scan.
// Returns 1 when an enum decl exists, else 0 (cnt[0] stays 0).
fn collect_ctors(s: str, names: [i64], cnt: [i64]) -> i64 {
  let epos = [0];
  let found = find_enum(s, epos);
  let pos = [0];
  let _ = pos[0] = if found == 1 then epos[0] + 5 else 0;
  let nm = read_ident(s, pos);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let k = [0];
  let done = if found == 1 then 0 else 1;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let cname = read_ident(s, pos);
    let is_name = if cname == 0 then 0 else 1;
    let capok = if k[0] < 256 then 1 else 0;
    let _ = if is_name * capok == 1 then (let _ = names[k[0]] = cname in 0) else 0;
    let _ = k[0] = k[0] + is_name;
    let _ = skip_to_field_delim(s, pos);
    let ch = char(s, pos[0]);
    let is_rb = if ch == 125 then 1 else 0;
    let at_end = if ch == 0 then 1 else 0;
    let _ = if is_rb + at_end == 0 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let done = if is_rb + at_end >= 1 then 1 else 0;
    0
  };
  let _ = cnt[0] = k[0];
  found
}

// Tag of ctor name from table zone-4 [.., ecnt, c1, c2, ..]; -1 when absent.
// O(#ctors) per ab; replaces the full-source rescan per identifier.
fn ft_ctor_tag(tab: [i64], name: i64) -> i64 {
  let cnt = tab[0];

  let base = cnt + cnt + cnt + 1;
  let ecnt = tab[base];
  let i = 0;
  let tag = 0 - 1;
  while i < ecnt {
    let cn = tab[base + 1 + i];
    let is_match = if cn == name then 1 else 0;
    let tag = if is_match == 1 then i else tag;
    let i = i + 1;
    0
  };
  tag
}

// Callee-resolution cache (zone-5, 128 direct-mapped 2-word [name,val] slots
// after the ctor zone): val 0 = unresolved, k>0 = srcpos k-1 (ft_srcpos hit),
// k<0 = find_fn result -k-2. The name is stored beside the value so a hash
// collision between two callee names can never serve one name the other's
// resolution (was: bare slot -> colliding name reused a foreign fnpos ->
// wrong bl target / runaway inline parse). Memoizes the per-name resolve so
// each callee is scanned for once, not once per call site. Words emitted are
// unchanged: the resolved position is identical every time.
fn ft_cache_slot(tab: [i64], name: i64) -> i64 {
  let cnt = tab[0];

  let eb = cnt + cnt + cnt + 1;
  let ecnt = tab[eb];
  let cb = eb + ecnt + 2;
  let slot = name - name / 128 * 128;
  let slot2 = if slot < 0 then slot + 128 else slot;
  cb + slot2 + slot2
}

fn ft_cache_get(tab: [i64], name: i64) -> i64 {
  let s0 = ft_cache_slot(tab, name);
  let hit = if tab[s0] == name then 1 else 0;
  let v = if hit == 1 then tab[s0 + 1] else 0;
  v
}

fn ft_cache_set(tab: [i64], name: i64, val: i64) -> i64 {
  let s0 = ft_cache_slot(tab, name);
  let _ = tab[s0] = name;
  let _ = tab[s0 + 1] = val;
  0
}

// A real cross-function call via bl: eval args -> x0..x(n-1), bl target, push.
fn emit_bl_call(s: str, name: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let strn = str_len(s);
  let _ = pos[0] = pos[0] + 1;
  let nargs = 0;
  let done = 0;
  while done == 0 {
    // progress guard: a malformed argument (e.g. "(3,{") must not spin forever
    let before = pos[0];
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_rp = if ch == 41 then 1 else 0;
    let _ = if is_rp == 0 then emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let nargs = nargs + (1 - is_rp);
    let _ = skip_ws(s, pos);
    let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch2 == 44 then 1 else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let stuck = if pos[0] > before then 0 else 1;
    let done = if is_rp + at_end + stuck >= 1 then 1 else 0;
    0
  };
  let _ = pos[0] = pos[0] + 1;
  let i = nargs - 1;
  while i >= 0 {
    let _ = pop(insns, n, i, fntab);
    let i = i - 1;
    0
  };
  let tgt0 = fntab_lookup(fntab, name);
  let target = if name == selfname then selfstart else tgt0;
  let rep_save = fntab[3890];
  let _ = flush_on_bl(insns, n, fntab, rep_save);
  let _ = emit_bl(insns, n, target, 1);
  let _ = pop_back(insns, n, fntab, rep_save);
  let _ = push(insns, n, fntab);
  n[0]
}

// Self-recursive call: same N-argument path as any resolved callee, target =
// selfstart (T42 2026-09-04: this used to parse exactly ONE argument and
// strand pos on the first `,` -- every multi-arg recursion (gcd, ackermann)
// silently returned garbage; only 1-arg recursion (c09 factorial) was right).
fn emit_self_call(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  emit_bl_call(s, selfname, pos, insns, n, stab, selfname, selfstart, fntab)
}

// hvham(a, b, n): NEON popcount of a^b over floor(n/8)*8 words.
// Single-path loop form (works for any n%8==0). Dossier: BUGFIXES.md.
fn emit_hvham(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 2, fntab);
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  // ldp q0,q1 covers 32 BYTES = 4 words per iteration -> divide by 4
  let _ = em(insns, n, 3544382532);
  let _ = em(insns, n, 3019899236);
  let _ = em(insns, n, 1325458436);
  let _ = em(insns, n, 2898330624);
  let _ = em(insns, n, 2898332706);
  let _ = em(insns, n, 1847729152);
  let _ = em(insns, n, 1847794721);
  let _ = em(insns, n, 1310742528);
  let _ = em(insns, n, 1310742561);
  let _ = em(insns, n, 1310753924);
  let _ = em(insns, n, 1310819460);
  let _ = em(insns, n, 3506439300);
  let _ = em(insns, n, 3053453028);
  let _ = em(insns, n, 1848653957);
  let _ = em(insns, n, 235027622);
  let _ = em(insns, n, 2852520928);
  let _ = push(insns, n, fntab);
  n[0]
}

// hvham2(a, ao, b, bo, n): NEON hamming with row offsets — no bounce copy.
fn emit_hvham2(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 3, fntab);
  let _ = pop(insns, n, 5, fntab);
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 6, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 2332363809);
  let _ = em(insns, n, 2332429312);
  let _ = em(insns, n, 2852324322);
  let _ = em(insns, n, 1325458436);
  let _ = em(insns, n, 3544382532);
  let _ = em(insns, n, 3019899236);
  let _ = em(insns, n, 2898330624);
  let _ = em(insns, n, 2898332706);
  let _ = em(insns, n, 1847729152);
  let _ = em(insns, n, 1847794721);
  let _ = em(insns, n, 1310742528);
  let _ = em(insns, n, 1310742561);
  let _ = em(insns, n, 1310753924);
  let _ = em(insns, n, 1310819460);
  let _ = em(insns, n, 3506439300);
  let _ = em(insns, n, 3053453028);
  let _ = em(insns, n, 1848653957);
  let _ = em(insns, n, 235027622);
  let _ = em(insns, n, 2852520928);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_open(p,n,flags): pack byte-per-element path into the IO scratch zone
// (last 8 KiB below x28), then raw openat. Words assembler+execution-verified.
fn emit_sys_open(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
