use "selfhost/prelude/sha256.bp"
// selfhost/expr_compile.bp - real expression + function compiler (self-host).
//
// Two stages toward a self-hosting compiler:
//   1. compile(s)    - an arithmetic expression (digits, + - * /, parens,
//                      precedence, branchless conditional) to a stack-machine
//                      instruction sequence.
//   2. compile_fn(s) - a complete function (fn name(a,b,...) { body }) to a
//                      full AArch64 function (prologue + param moves + body +
//                      epilogue). Params map a->x19, b->x20, ... (moved from
//                      x0, x1, ... in the prologue; the stack machine only
//                      clobbers x0/x1, so params live in callee-saved regs).
//
// A faithful port of native/src/native.c emit_expr for the LIT + BIN arith +
// conditional subset. AArch64 words are decimal (Bebop has no hex literals).

module core { }

fn is_digit(c: i64) -> i64 {
  let ge48 = if c >= 48 then 1 else 0;
  let le57 = if c <= 57 then 1 else 0;
  ge48 * le57
}

fn is_alpha(c: i64) -> i64 {
  let ge97 = if c >= 97 then 1 else 0;
  let le122 = if c <= 122 then 1 else 0;
  let ge65 = if c >= 65 then 1 else 0;
  let le90 = if c <= 90 then 1 else 0;
  ge97 * le122 + ge65 * le90
}

// Read a multi-char identifier (letters/digits/underscore) starting at pos[0];
// return its polynomial hash (h = h*131 + c, i64-wrapping), advance pos past it.
// speed-up (2026-09-06): str_len is a NUL scan (~100 us over a 200 KB source) and the
// emitter asked for the source length about ten times per token -- O(source x tokens),
// most of a self-compile (4000 `let s = s + i;` statements took 15 s, +200 KB of comment
// made it 20x slower). compile_fn_at now carries the length in pos[1]; slen returns it
// when it is a valid end (char(s, L) == 0 and char(s, L - 1) != 0 -- a 1-cell pos from a
// whole-source scanner reads a neighbour cell here and the check rejects it) and scans
// otherwise. Lookahead past the end reads the zero tail of the slurp buffer.
// T90 step 1 (2026-09-06): compile-time errors say WHERE. diag_exit(s, p, code) writes
// `line:col: <message>` + newline (1-based, counted over the program the emitter sees --
// the `.use` expansion when the program has `use` lines) to stderr, then exits with the
// same code as before (the exit-code table is unchanged; docs/TRAPS.md).
fn put_num(buf: [i64], at: i64, v: i64) -> i64 {
  let d = zeros(24);
  let k = 0;
  let x = v;
  let go = 1;
  while go == 1 {
    let _ = d[k] = 48 + x - (x / 10) * 10;
    let x = x / 10;
    let k = k + 1;
    let go = if x > 0 then 1 else 0;
    0
  };
  let i = 0;
  while i < k {
    let _ = buf[at + i] = d[k - 1 - i];
    let i = i + 1;
    0
  };
  at + k
}
// A22: the `(if char(s,j)==C then 1 else 0)` idiom, spelled once. Byte budget:
// bebop.bp is 400 KB against src_slurp_cap() = 400000 (E113).
fn ceq(s: str, j: i64, c: i64) -> i64 { if char(s, j) == c then 1 else 0 }
fn diag_str(buf: [i64], at: i64, m: str) -> i64 {
  let n = str_len(m);
  let i = 0;
  while i < n { let _ = buf[at + i] = char(m, i); let i = i + 1; 0 };
  at + n
}
fn diag_exit(s: str, p: i64, code: i64) -> i64 {
  let line = 1;
  let col = 1;
  let i = 0;
  while i < p {
    let nl = ceq(s, i, 10);
    let line = line + nl;
    let col = if nl == 1 then 1 else col + 1;
    let i = i + 1;
    0
  };
  let buf = zeros(256);
  let a1 = put_num(buf, 0, line);
  let _ = buf[a1] = 58;
  let a2 = put_num(buf, a1 + 1, col);
  let _ = buf[a2] = 58;
  let _ = buf[a2 + 1] = 32;
  let a2b = diag_str(buf, a2 + 2, "error[E");
  let a3 = put_num(buf, a2b, code);
  let at = diag_str(buf, a3, "]: ");
  let at1 = if code == 95 then diag_str(buf, at, "expected `)` or `in`") else at;
  let at2 = if code == 96 then diag_str(buf, at, "`++` is not in the language") else at1;
  let at3 = if code == 97 then diag_str(buf, at, "fn body without a tail expression -- fn should return a value") else at2;
  let at4 = if code == 98 then diag_str(buf, at, "too many return/break in one fn") else at3;
  let at5 = if code == 99 then diag_str(buf, at, "reserved word used as a fn name") else at4;
  let at6 = if code == 89 then diag_str(buf, at, "let binding while a call temp is live -- bind the call result with a let first") else at5;
  let at7 = if code == 108 then diag_str(buf, at, "sys_mapb is refused (ROADMAP A7)") else at6;
  let at8 = if code == 100 then diag_str(buf, at, "fn with more than 14 parameters -- fn must have <= 14 parameters") else at7;
  let at9 = if code == 101 then diag_str(buf, at, "unbound symbol -- this name was not declared in this function") else at8;
  let at10 = if code == 65 then diag_str(buf, at, "index past the end") else at9;
  let at11 = if code == 104 then diag_str(buf, at, "too many fns (cap 768)") else at10;
  let at12 = if code == 102 then diag_str(buf, at, "sys_ name inside a kernel fn") else at11;
  let at13 = if code == 109 then diag_str(buf, at, "sys_clone: > 8 kept symbols (max 8)") else at12;
  let at14 = if code == 110 then diag_str(buf, at, "invalid syntax in contract position -- use only identifiers, type names, and operators") else at13;
  let at15 = if code == 111 then diag_str(buf, at, "decimal point in numeric literal -- use integer literals only") else at14;
  let at16 = if code == 112 then diag_str(buf, at, "module with contents -- module declarations must be empty") else at15;
  let at17 = if code == 114 then diag_str(buf, at, "too many string literals -- the literal table holds 1000 (fntab[6000..6999])") else at16;
  let at18 = if code == 115 then diag_str(buf, at, "too many structs (cap 32)") else at17;
  let at19 = if code == 116 then diag_str(buf, at, "too many fields in one struct (max 16)") else at18;
  let at20 = if code == 117 then diag_str(buf, at, "ambiguous field name -- structs disagree on its offset") else at19;
  let at21 = if code == 118 then diag_str(buf, at, "tuple width does not match the fn's declared return arity") else at20;
  let at22 = if code == 119 then diag_str(buf, at, "destructuring let does not match the callee's declared return arity") else at21;
  let at23 = if code == 120 then diag_str(buf, at, "multi-value fn called outside a destructuring let -- x1 and up would be dropped") else at22;
  let at24 = if code == 121 then diag_str(buf, at, "more than 3 return values -- the convention is x0..x2") else at23;
  let mlen = at24 - at;
  let final_at = at + mlen;
  let _ = buf[final_at] = 10;
  let _ = sys_write(2, buf, final_at + 1);
  sys_exit(code)
}
fn slen(s: str, pos: [i64]) -> i64 {
  let L = pos[1];
  let inr = (if L > 0 then 1 else 0) * (if L < 2000000 then 1 else 0);
  let c0 = if inr == 1 then char(s, L) else 1;
  let c1 = if inr == 1 then char(s, L - 1) else 0;
  let ok = inr * (if c0 == 0 then 1 else 0) * (if c1 == 0 then 0 else 1);
  if ok == 1 then L else str_len(s)
}
// ROADMAP C1 step 2 (2026-09-08): `kernel fn name(...)`. kernel_marked(s, fpos) is 1 when
// the token `kernel` sits immediately before the `fn` keyword at fpos ON THE SAME LINE. The
// backward scan crosses spaces and tabs only, never a newline, so a comment line whose last
// word is `kernel` cannot mark the next fn (collect_fns already skips `fn` inside a comment
// or a string, so only the marker itself needs guarding); kernel_word_at then requires a
// non-identifier byte before the `k`, so `mykernel fn` does not match either.
fn kernel_word_at(s: str, e: i64) -> i64 {
  let m = ceq(s, e, 108) * ceq(s, e - 1, 101) * ceq(s, e - 2, 110) * ceq(s, e - 3, 114) * ceq(s, e - 4, 101) * ceq(s, e - 5, 107);
  let pc = if e >= 6 then char(s, e - 6) else 0;
  let idc = is_alpha(pc) + is_digit(pc) + (if pc == 95 then 1 else 0);
  m * (if idc > 0 then 0 else 1)
}
fn kernel_marked(s: str, fpos: i64) -> i64 {
  let p = [fpos - 1];
  let done = if fpos < 6 then 1 else 0;
  while done == 0 {
    let c = char(s, p[0]);
    let is_sp = (if c == 32 then 1 else 0) + (if c == 9 then 1 else 0);
    let _ = p[0] = p[0] - is_sp;
    let done = (if is_sp == 1 then 0 else 1) + (if p[0] < 0 then 1 else 0);
    0
  };
  if p[0] < 5 then 0 else kernel_word_at(s, p[0])
}
// sys_prefix_at(s, p, strn): 1 when the four bytes at p are `sys_`. The out-of-range case
// reads index 0..3 instead and is multiplied out, so no byte past strn is ever touched.
fn sys_prefix_at(s: str, p: i64, strn: i64) -> i64 {
  let ok = if p + 3 < strn then 1 else 0;
  let q = ok * p;
  ok * ceq(s, q, 115) * ceq(s, q + 1, 121) * ceq(s, q + 2, 115) * ceq(s, q + 3, 95)
}
fn read_ident(s: str, pos: [i64]) -> i64 {
  let strn = slen(s, pos);
  let h = 0;
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_us = if ch == 95 then 1 else 0;
    let is_id = is_alpha(ch) + is_digit(ch) + is_us;
    let h = if is_id == 1 then (h * 131 + ch) else h;
    let _ = pos[0] = pos[0] + is_id;
    let done = if is_id == 1 then 0 else 1;
    0
  };
  h
}

// Symbol table: stab[0] = count; pairs (name, reg) at stab[1+2i], stab[2+2i].
// Lookup name -> register (or -1 if unbound).
fn sym_lookup(s: str, stab: [i64], name: i64, srcpos: i64) -> i64 {
  let cnt = stab[0];
  let i = 0;
  let reg = 0 - 1;
  while i < cnt {
    let nm = stab[1 + 3 * i];
    let rg = stab[2 + 3 * i];
    let sp = stab[3 + 3 * i];
    let hhit = if nm == name then 1 else 0;
    let bhit = if hhit == 1 then ident_eq(s, sp, srcpos) else 0;
    let reg = if hhit * bhit == 1 then rg else reg;
    let i = i + 1;
    0
  };
  reg
}

// Byte-compare two identifier spellings at source offsets pa/pb: equal if
// the char sequences match exactly AND both end at a non-ident char.
fn ident_eq(s: str, pa: i64, pb: i64) -> i64 {
  let strn = 2000000000;  // speed-up 2026-09-06: no NUL scan; the zero tail ends the loop
  let same = 1;
  let ia = [pa];
  let ib = [pb];
  let done = 0;
  while done == 0 {
    let ca = if ia[0] >= strn then 0 else char(s, ia[0]);
    let cb = if ib[0] >= strn then 0 else char(s, ib[0]);
    let ida = is_alpha(ca) + is_digit(ca) + (if ca == 95 then 1 else 0);
    let idb = is_alpha(cb) + is_digit(cb) + (if cb == 95 then 1 else 0);
    let cmp = if ca == cb then 0 else 1;
    let mdiff = if ida * idb == 1 then cmp else 0;
    let snew = if ida + idb == 1 then 0 else same * (1 - mdiff);
    let same = snew;
    let _ = ia[0] = ia[0] + 1;
    let _ = ib[0] = ib[0] + 1;
    let done = if ida + idb == 0 then 1 else 0;
    0
  };
  same
}

// Bind name to the next free register (x19+cnt) or a spill slot. Registers
// x19..x26 hold the first 8 bindings (x27/x28 reserved for the runner's
// bump-arena cursor/end); the 9th+ spill to a frame slot [x15 + slot*8]. The returned value encodes the location:
//   19..28      -> register-resident (mov x<reg>, x0 / mov x0, x<reg>)
//   100..100+S  -> spilled to slot S (str x0,[x15,#S*8] / ldr x0,[x15,#S*8])
//   0-2         -> table full (capacity assert: caller must emit a trap)
// Entries are (name, reg, srcpos) triples: binding and lookup byte-compare
// the spelling at the stored/queried source position, so hash collisions
// can never silently alias two names onto one register.
fn sym_bind(s: str, stab: [i64], name: i64, srcpos: i64) -> i64 {
  // BUGFIX (2026-09-06, window relocation follow-up): the discard name `_`
  // (hash 95) must never consume a register/slot -- its every caller
  // (emit_let_stmt, emit_let_in, ...) checks `is_discard` AFTER this call
  // and uses vs_pop instead of vs_bind, so the `reg` this returns is never
  // written to. But sym_bind used to insert it like any real name on its
  // first occurrence, permanently burning one of the 8 cs registers (or,
  // once a function is already at the boundary, forcing every subsequent
  // `let` to spill one register early) for a value nothing ever reads back
  // -- every later named binding's slot/register number silently shifted
  // by one. -1 is outside check_reg_collision's [19,27) range, so callers
  // that unconditionally check_reg_collision(reg) right after this are
  // unaffected.
  let is_discard = if name == 95 then 1 else 0;
  // Identifiers are 131-rolling hashes; on 64-bit hosts long names wrap
  // NEGATIVE. Only an exact zero (empty ident) is invalid.
  let ok = (if name == 0 then 0 else 1) * (1 - is_discard);
  let existing = sym_lookup(s, stab, name, srcpos) * ok - (1 - ok);
  let cnt = stab[0];
  // x27/x28 are RESERVED: exec_words runner keeps its bump-arena cursor/end
  // there (global asm register vars). Symbols may occupy x19..x26 only.
  let is_full = if cnt >= 128 then 1 else 0;
  let is_spill = if cnt >= 8 then 1 else 0;
  let reg_register = 19 + cnt;
  let reg_spill = 100 + cnt - 8;
  let newreg = reg_register * (1 - is_spill) + reg_spill * is_spill;
  let is_new = if existing < 0 then 1 else 0;
  let reg = if is_new == 1 then newreg else existing;
  let full = is_new * is_full;
  let _ = if is_new * ok * (1 - full) == 1 then (let _ = stab[1 + 3 * cnt] = name in (let _ = stab[2 + 3 * cnt] = reg in (let _ = stab[3 + 3 * cnt] = srcpos in 0))) else 0;
  let _ = stab[0] = cnt + is_new * ok * (1 - full);
  let ret = if full == 1 then 0 - 2 else reg;
  if is_discard == 1 then 0 - 1 else ret
}

// Skip over a param's type annotation up to the next ',' or ')'.
fn skip_to_delim(s: str, pos: [i64]) -> i64 {
  let strn = slen(s, pos);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_comma = if ch == 44 then 1 else 0;
    let is_rp = if ch == 41 then 1 else 0;
    let is_delim = is_comma + is_rp;
    let _ = pos[0] = pos[0] + (1 - is_delim - at_end);
    let done = if is_delim + at_end >= 1 then 1 else 0;
    0
  };
  0
}

// Parse a param list (pos at '('): read each param name hash into pnames,
// advance pos past ')', return the count.
fn parse_params(s: str, pos: [i64], pnames: [i64], ppos: [i64]) -> i64 {
  let strn = slen(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let pcnt = 0;
  let done = 0;
  let first_param_pos = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_rp = if ch == 41 then 1 else 0;
    let is_letter = is_alpha(ch);
    let _ = if pcnt < 14 then (let _ = ppos[pcnt] = pos[0] in 0) else 0;
    let _ = if pcnt == 0 then (let _ = first_param_pos = pos[0] in 0) else 0;
    let name = read_ident(s, pos);
    let _ = if pcnt < 14 then (let _ = pnames[pcnt] = name in 0) else 0;
    let pcnt = pcnt + is_letter;
    let _ = skip_to_delim(s, pos);
    let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch2 == 44 then 1 else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let done = if is_rp + at_end >= 1 then 1 else 0;
    0
  };
  let _ = pos[0] = pos[0] + 1;
  let _ = if pcnt > 14 then diag_exit(s, first_param_pos, 100) else 0;
  pcnt
}

// Identifier: a function call name(args) or a variable reference.
fn emit_ident(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let npos = pos[0];
  let name = read_ident(s, pos);
  let _ = skip_ws(s, pos);
  let strn = slen(s, pos);
  // C1 step 2: inside a `kernel fn` (fntab[5543]) any `sys_` name is a compile-time reject,
  // exit 102 (docs/TRAPS.md) -- the dialect's whole point is that a kernel cannot reach the
  // kernel. DIAGNOSTIC ONLY: fntab[5543] is 0 for every fn that is not marked, so an
  // unmarked fn's emitted word stream is unchanged, word for word.
  let _ = if fntab[5543] == 1 then (if sys_prefix_at(s, npos, strn) == 1 then diag_exit(s, npos, 102) else 0) else 0;
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  let is_lp = if ch == 40 then 1 else 0;
  let is_br = if ch == 123 then 1 else 0;
  let is_lb = if ch == 91 then 1 else 0;
  // T43 rest: a bare `ident {` would eat a while/if body, so `NAME {` is a
  // literal only when NAME is a table struct (A22: ANY of them, not the one
  // fntab[5541] hash) and fntab[5542] says we are not in a `while` condition.
  let si = st_find(s, name, fntab);
  let is_sname = if si >= 0 then 1 else 0;
  let struct_ok = is_sname * (1 - fntab[5542]);
  // A22 step 1: `T.f`/`T.size` on a struct NAME is a COMPILE-TIME CONSTANT (0
  // words, folds into `add #imm`). A bound symbol of that spelling wins first.
  let is_dot = if ch == 46 then 1 else 0;
  let const_ok = if is_dot * is_sname == 1 then (if sym_lookup(s, stab, name, npos) < 0 then 1 else 0) else 0;
  if is_lp == 1 then emit_call_or_ctor(s, name, pos, insns, n, stab, selfname, selfstart, fntab)
  else if const_ok == 1 then emit_struct_const(s, si, pos, insns, n, fntab, stab)
  else if is_br * struct_ok == 1 then emit_struct_lit(s, si, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_lb == 1 then emit_array_index(s, name, npos, pos, insns, n, stab, selfname, selfstart, fntab)
  else emit_var_or_ctor(s, name, npos, insns, n, stab, fntab)
}



// Skip over a struct field's type annotation up to the next ',' or '}'.
fn skip_to_field_delim(s: str, pos: [i64]) -> i64 {
  let strn = slen(s, pos);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_comma = if ch == 44 then 1 else 0;
    let is_rb = if ch == 125 then 1 else 0;
    let is_delim = is_comma + is_rb;
    let _ = pos[0] = pos[0] + (1 - is_delim - at_end);
    let done = if is_delim + at_end >= 1 then 1 else 0;
    0
  };
  0
}

// 0-based index of field fname in the struct decl at spos ("struct "), -1 if absent.
// A22: fcnt[0] = declared field count (one extra pass on `}`, so i - 1).
fn field_index(s: str, spos: i64, fname: i64, fcnt: [i64]) -> i64 {
  let strn = str_len(s);
  let pos = [spos + 7, 0];
  let _ = read_ident(s, pos);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let i = 0;
  let idx = 0 - 1;
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_rb = if ch == 125 then 1 else 0;
    let name = read_ident(s, pos);
    let is_match = if name == fname then 1 else 0;
    let idx = if is_match == 1 then i else idx;
    let i = i + 1;
    let _ = skip_to_field_delim(s, pos);
    let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch2 == 44 then 1 else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let done = if is_rb + at_end >= 1 then 1 else 0;
    0
  };
  let _ = fcnt[0] = i - 1;
  idx
}

// ---- A22 step 1: the program-wide struct table ----
// fntab[5541] held ONE struct name hash, so every other struct was invisible: its
// literal parsed as a block, its `.f` resolved against the cached layout. Now ONE
// pre-pass per unit, above the literal table (E114 caps that below 7000):
//   fntab[7000]      scanned flag: 0 = not built, 1 = built
//   fntab[7001]      struct count S (0..32)
//   fntab[7002 + i]  struct i: name hash (read_ident hash)
//   fntab[7034 + i]  struct i: byte offset of its `struct` keyword
// Top cell 7065, inside zeros(8192). Field NAMES are not copied: field k's cell
// offset IS k, read off the decl text. Caps trap: >32 E115, >16 fields E116
// (16 = emit_struct_lit's zeros(16) slots).
fn st_record(s: str, spos: i64, fntab: [i64]) -> i64 {
  let si = fntab[7001];
  let _ = if si >= 32 then diag_exit(s, spos, 115) else 0;
  let pos = [spos + 7, 0];
  let nm = read_ident(s, pos);
  let fc = [0];
  let _ = field_index(s, spos, 0, fc);
  let _ = if fc[0] > 16 then diag_exit(s, spos, 116) else 0;
  let _ = fntab[7002 + si] = nm;
  let _ = fntab[7034 + si] = spos;
  let _ = fntab[7001] = si + 1;
  si
}

// Every `struct ` STARTING A LINE, in source order; a `test ` body is skipped
// whole (as find_enum does): its decls are not part of the program.
fn collect_structs(s: str, fntab: [i64]) -> i64 {
  let strn = str_len(s);
  let j = 0;
  let _ = fntab[7001] = 0;
  let tpc = [0];
  while j + 6 < strn {
    let at_bol = if j == 0 then 1 else ceq(s, j - 1, 10);
    let t0 = at_bol * ceq(s, j, 116) * ceq(s, j + 1, 101);
    let is_test = t0 * ceq(s, j + 2, 115) * ceq(s, j + 3, 116) * ceq(s, j + 4, 32);
    let h0 = at_bol * ceq(s, j, 115) * ceq(s, j + 1, 116);
    let h1 = h0 * ceq(s, j + 2, 114) * ceq(s, j + 3, 117);
    let hit = h1 * ceq(s, j + 4, 99) * ceq(s, j + 5, 116) * ceq(s, j + 6, 32);
    let _ = if hit == 1 then st_record(s, j, fntab) else 0;
    let _ = tpc[0] = if is_test == 1 then find_body_end(s, j + 5, strn) else j;
    let j = if is_test == 1 then tpc[0] + 1 else j + 1;
    0
  };
  let _ = fntab[7000] = 1;
  fntab[7001]
}

// Index of the struct named by hash `name`, or -1. A stored hash is never 0 (an
// ident starts with a letter), so `name == 0` needs no guard.
fn st_find(s: str, name: i64, fntab: [i64]) -> i64 {
  let _ = if fntab[7000] == 0 then collect_structs(s, fntab) else 0;
  let cnt = fntab[7001];
  let i = 0;
  let got = 0 - 1;
  while i < cnt {
    let got = if fntab[7002 + i] == name then i else got;
    let i = i + 1;
    0
  };
  got
}

// Cell offset of field `fname` in struct `si`, -1 if absent.
fn st_field(s: str, si: i64, fname: i64, fntab: [i64]) -> i64 {
  let c = [0];
  field_index(s, fntab[7034 + si], fname, c)
}

// `x.f` on a VALUE has no type yet (step 2 tags symbols; needs A8). Step 1's
// rule: every struct declaring `f` puts it at the SAME offset, so the answer is
// independent of x's type. That disagreement was silent; it is E117 now.
fn st_field_any(s: str, fname: i64, npos: i64, fntab: [i64]) -> i64 {
  let _ = if fntab[7000] == 0 then collect_structs(s, fntab) else 0;
  let cnt = fntab[7001];
  let i = 0;
  let idx = 0 - 1;
  let bad = 0;
  while i < cnt {
    let k = st_field(s, i, fname, fntab);
    let clash = (if k >= 0 then 1 else 0) * (if idx >= 0 then 1 else 0) * (if k == idx then 0 else 1);
    let bad = if clash == 1 then 1 else bad;
    let idx = if k >= 0 then k else idx;
    let i = i + 1;
    0
  };
  let _ = if bad == 1 then diag_exit(s, npos, 117) else 0;
  idx
}

// A22 step 1: `T.f` = field f's cell OFFSET in T, `T.size` = T's field count in
// CELLS -- COMPILE-TIME CONSTANTS, so emit_lit's CONST push costs ZERO words
// until consumed and folds into `add #imm`. 260348453 = read_ident's hash of
// "size"; a real field named `size` wins, looked up first. Unknown field = E101.
fn emit_struct_const(s: str, si: i64, pos: [i64], insns: [i64], n: [i64], fntab: [i64], stab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let fp = pos[0];
  let c = [0];
  let fname = read_ident(s, pos);
  let idx = field_index(s, fntab[7034 + si], fname, c);
  let v = if idx >= 0 then idx else (if fname == 260348453 then c[0] else 0 - 1);
  let _ = if v < 0 then diag_exit(s, fp, 101) else 0;
  emit_lit(insns, n, v, fntab, stab)
}

// Emit one struct-literal field: read the name, resolve its declaration index
// (slots[fcnt] = index in STRUCT si's field list), skip ':', emit the value
// (it stays pushed; emit_struct_lit stores it after the bump).
fn emit_struct_field(s: str, si: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], fcnt: i64, slots: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let fname = read_ident(s, pos);
  let idx = st_field(s, si, fname, fntab);
  let _ = slots[fcnt] = if idx < 0 then fcnt else idx;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  n[0]
}

// Emit a struct literal NAME { f: v, ... }: the declaration order is the layout
// (c40 writes the fields out of order on purpose). Every field value is
// evaluated first (each stays on the stack), THEN mov x0,x14; add x14,#8n
// (+ the T118 frame trap) and the values are popped into their slots from the
// last down -- the same order rule as emit_array_lit (T42).
fn emit_struct_lit(s: str, si: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let strn = slen(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let slots = zeros(16);
  let fcnt = 0;
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_rb = if ch == 125 then 1 else 0;
    let _ = if is_rb == 0 then emit_struct_field(s, si, pos, insns, n, stab, fcnt, slots, selfname, selfstart, fntab) else 0;
    let fcnt = if is_rb == 0 then fcnt + 1 else fcnt;
    let _ = skip_ws(s, pos);
    let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch2 == 44 then 1 else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let done = if is_rb + at_end >= 1 then 1 else 0;
    0
  };
  let _ = pos[0] = pos[0] + 1;
  // Deviation from allocate-first (VERDICT: same reasoning as emit_array_lit
  // -- the literal's field count needs a pre-count the grammar does not
  // otherwise require).
  let _ = vs_park(insns, n, fntab, stab, fcnt);
  let _ = vs_evict(insns, n, fntab, stab, 0);
  let _ = vs_mask_take(fntab, 0, 2);
  let _ = em(insns, n, 2853897184);
  let _ = em(insns, n, 2432696320 + fcnt * 8192 + 891);
  // ROADMAP A6 (2026-09-08): aggregates allocate at the ARENA CURSOR x27, the
  // same bump `zeros` uses, and inherit its capacity trap -- cmp x27,x28 ;
  // b.ls +2 ; brk #80. The T118 frame-heap trap (brk #81) and its helper
  // emit_heap_trap are DELETED: there is no frame heap any more, so exit 81
  // cannot be reached and the class is gone rather than merely under budget.
  let _ = em(insns, n, 3944481663);
  let _ = em(insns, n, 1409286217);
  let _ = em(insns, n, 3558869504);
  let k = [fcnt];
  while k[0] > 0 {
    let _ = k[0] = k[0] - 1;
    let r = vs_reg(insns, n, fntab, stab, fntab[5387] - 1);
    let _ = em(insns, n, 4177526784 + slots[k[0]] * 1024 + r);
    let _ = vs_pop(fntab);
    0
  };
  // A5 step 1b: address -> cell index (sub x0,x0,x17 ; lsr x0,x0,#3).
  let _ = em(insns, n, 3406888960);
  let _ = em(insns, n, 3544448000);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// Emit a field access .f: pop the base pointer, ldr x0,[x0,#idx*8], push.
fn emit_field_access(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let fpos = pos[0];
  let fname = read_ident(s, pos);
  let idx = st_field_any(s, fname, fpos, fntab);
  let _ = vs_deliver(insns, n, fntab, stab, 1);
  // A5 step 1b: the struct VALUE in x0 is a cell INDEX, so the field load is
  // `add x0,x0,#idx ; ldr x0,[x17,x0,lsl #3]` (the add is dropped for field 0).
  // Base and destination are both x0, so no scratch register is needed.
  let _ = if idx > 0 then em(insns, n, 2432696320 + idx * 1024) else 0;
  let _ = em(insns, n, 4167072288);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// Scan for the first enum declaration ("enum "); record pos in out[0].
fn find_enum(s: str, out: [i64]) -> i64 {
  // Lexical scan: skips strings/comments (same discipline as find_fn).
  // Raw scanning matched "enum " inside comments and string literals of
  // the compiler's own source -> phantom decl -> collect_ctors loop over
  // garbage with names[] overrun. Self-source is the first input that
  // actually contains those tokens.
  let strn = str_len(s);
  let j = 0;
  let found = 0;
  let best = strn;
  let spc = [0];
  let cpc = [0];
  let tpc = [0];
  while j + 4 < strn {
    let c0 = char(s, j);
    let c1 = char(s, j + 1);
    let c2 = char(s, j + 2);
    let c3 = char(s, j + 3);
    let c4 = char(s, j + 4);
    let is_quote = if c0 == 34 then 1 else 0;
    let is_sl = if c0 == 47 then 1 else 0;
    let is_sl2 = if c1 == 47 then 1 else 0;
    let is_comment = is_sl * is_sl2;
    let is_e = if c0 == 101 then 1 else 0;
    let is_n = if c1 == 110 then 1 else 0;
    let is_u = if c2 == 117 then 1 else 0;
    let is_m = if c3 == 109 then 1 else 0;
    let is_sp = if c4 == 32 then 1 else 0;
    let hit = is_e * is_n * is_u * is_m * is_sp * (1 - is_quote) * (1 - is_comment);
    let ist = if c0 == 116 then 1 else 0;
    let ise = if c1 == 101 then 1 else 0;
    let iss = if c2 == 115 then 1 else 0;
    let ist2 = if c3 == 116 then 1 else 0;
    let issp = if c4 == 32 then 1 else 0;
    let is_test = ist * ise * iss * ist2 * issp;
    let best = if hit == 1 then j else best;
    let found = if hit == 1 then 1 else found;
    let _ = spc[0] = j;
    let _ = cpc[0] = j;
    let _ = tpc[0] = j;
    let _ = if is_quote == 1 then skip_string_n(s, spc, strn) else 0;
    let _ = if is_comment == 1 then skip_line_comment_n(s, cpc, strn) else 0;
    let _ = if is_test == 1 then (let _ = tpc[0] = find_body_end(s, j + 5, strn) in (let _ = tpc[0] = if tpc[0] >= strn then strn else tpc[0] + 1 in 0)) else 0;
    let jnext = (j + 1) * (1 - is_quote - is_comment - hit - is_test) + spc[0] * is_quote + cpc[0] * is_comment + tpc[0] * is_test;
    let j = if hit == 1 then j + 5 else jnext;
    0
  };
  let _ = out[0] = best;
  found
}

// Tag (0-based) of ctor name in the enum decl, or -1 if absent / no enum.

// Emit an enum ctor with a payload: ctor(expr) -> [tag, payload] block.
fn emit_enum_ctor(s: str, tag: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  // ROADMAP A6 step 1 defect, FIXED 2026-09-09: A6 moved the ctor's BUMP from
  // the frame heap x14 to the arena cursor x27 and left the two payload stores
  // on `str x0,[x14]` / `str x0,[x14,#8]`, so a payload ctor handed back an
  // UNINITIALISED arena block. The fix is an order change, not a register
  // rename: the payload expression must be evaluated FIRST (it may itself be a
  // ctor -- c60_nestctor -- and bump x27 out from under us), and only then is
  // the block reserved. `mov x16,x27` snapshots the base into the register
  // model's parallel-move scratch (x16, dead here exactly as at every
  // vs_array_set_imm site), the cursor is bumped and capacity-checked, the
  // payload (still in x0 from vs_deliver) is stored at [x16,#8], the tag
  // overwrites x0 and is stored at [x16], and the block index is
  // `mov x0,x16 ; sub x0,x0,x17 ; lsr x0,x0,#3` -- A5 step 1b's cell index,
  // which is what emit_match_rt then reads through `ldr xd,[x17,xi,lsl #3]`.
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = vs_deliver(insns, n, fntab, stab, 1);
  let _ = pos[0] = pos[0] + 1;
  let _ = em(insns, n, 2853897200);
  let _ = em(insns, n, 2432713595);
  // ROADMAP A6 (2026-09-08): aggregates allocate at the ARENA CURSOR x27, the
  // same bump `zeros` uses, and inherit its capacity trap -- cmp x27,x28 ;
  // b.ls +2 ; brk #80. The T118 frame-heap trap (brk #81) and its helper
  // emit_heap_trap are DELETED: there is no frame heap any more, so exit 81
  // cannot be reached and the class is gone rather than merely under budget.
  let _ = em(insns, n, 3944481663);
  let _ = em(insns, n, 1409286217);
  let _ = em(insns, n, 3558869504);
  let _ = em(insns, n, 4177528320);
  let _ = em(insns, n, 3531603968 + tag * 32);
  let _ = em(insns, n, 4177527296);
  let _ = em(insns, n, 2853176288);
  // A5 step 1b: address -> cell index.
  let _ = em(insns, n, 3406888960);
  let _ = em(insns, n, 3544448000);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// Emit a nullary enum ctor: ctor -> [tag] block (no payload).
fn emit_enum_ctor_nullary(insns: [i64], n: [i64], tag: i64, fntab: [i64], stab: [i64]) -> i64 {
  let _ = em(insns, n, 3531603968 + tag * 32);
  // A6 step 1 defect (2026-09-09): was `str x0,[x14]` -- the dead frame-heap
  // register -- while the block returned came from x27. Nothing runs between
  // the tag store and the bump, so the nullary form needs no x16 snapshot:
  // store straight through the cursor.
  let _ = em(insns, n, 4177527648);
  let _ = em(insns, n, 2853897184);
  let _ = em(insns, n, 2432713595);
  // ROADMAP A6 (2026-09-08): aggregates allocate at the ARENA CURSOR x27, the
  // same bump `zeros` uses, and inherit its capacity trap -- cmp x27,x28 ;
  // b.ls +2 ; brk #80. The T118 frame-heap trap (brk #81) and its helper
  // emit_heap_trap are DELETED: there is no frame heap any more, so exit 81
  // cannot be reached and the class is gone rather than merely under budget.
  let _ = em(insns, n, 3944481663);
  let _ = em(insns, n, 1409286217);
  let _ = em(insns, n, 3558869504);
  // A5 step 1b: address -> cell index.
  let _ = em(insns, n, 3406888960);
  let _ = em(insns, n, 3544448000);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// Dispatch name( ... ): enum ctor (with payload) or a function call.
fn emit_bl(insns: [i64], n: [i64], target: i64, has_spills: i64) -> i64 {
  // x15 (spill base) is caller-saved: callees rebind it from their own sp, so
  // a caller that reads its own spill slots after a call must get it back.
  // T103 (2026-09-05) made this ONE pair instead of the old 48-byte frame.
  // ROADMAP A6 step 2 commit B (2026-09-09): x14 was the frame-heap cursor and
  // A6 step 1 deleted the frame heap, so x14 is written by nothing and read by
  // nothing -- `stp x15,x14,[sp,#-16]!` / `ldp x15,x14,[sp],#16` (2847882223 /
  // 2831236079) become `str x15,[sp,#-16]!` / `ldr x15,[sp],#16` (4162785263 /
  // 4165011439, as+objdump). STILL TWO WORDS, so saved_calls' arithmetic keeps
  // its shape; what changes is has_spills' CONDITION, below.
  // B1 (2026-09-06): has_spills is the CALLER's own published fact (does the
  // caller itself bind a spill anywhere in its body) -- not the callee's. The
  // save is a conservative superset: it fires whenever the caller might need
  // x15 preserved across ANY call, regardless of what the specific callee does.
  let _ = if has_spills == 1 then em(insns, n, 4162785263) else 0;
  let offset = target - n[0];
  let is_back = if offset < 0 then 1 else 0;
  let word = 2483027968 + offset + is_back * 67108864;
  let _ = em(insns, n, word);
  let _ = if has_spills == 1 then em(insns, n, 4165011439) else 0;
  n[0]
}

// Look up a function's start offset in the layout table; -1 if absent.
fn fntab_lookup(fntab: [i64], name: i64) -> i64 {
  let cnt = fntab[0];
  let i = 0;
  let start = 0 - 1;
  while i < cnt {
    let nm = fntab[1 + i];
    let st = fntab[1 + cnt + i];
    let is_match = if nm == name then 1 else 0;
    let start = if is_match == 1 then st else start;
    let i = i + 1;
    0
  };
  start
}

// B1 (2026-09-06): look up a function's PUBLISHED planning-pass facts (packed
// as vc*2+has_alloc, vc = final symbol count incl. params, has_alloc = body
// allocates on x14) from fntab[2900+i]. 0 if absent (harmless default: a
// caller with no lookup hit behaves as if vc=0/has_alloc=0, i.e. does not
// need x15/x14 -- only used during the emission pass, where every fn's own
// source position is guaranteed to have been published by the planning pass
// first). A2 step 0 (2026-09-06/07) relayout: indices 2200..2763 are free
// (fn cap raised 300 -> 512; the ctor/name/start/fpos zones + ft_cache top
// out at 2046 worst case, cnt=511/ecnt=255), and 4410+ is claimed by
// unrelated per-fn scratch (loop/mask/struct/literal cells, window moved to
// fntab[3700+3i]).
//
// Keyed by SOURCE POSITION (srcpos, zone 3: fntab[1+2*cnt+i]), not by name:
// two `fn` DEFINITIONS CAN share a spelling (bench/vs_rust/std_tests/cache.bp
// has two differently-shaped `cache_lookup`s) and fntab_lookup's own
// name-keyed "last match wins" is harmless there (every caller ends up
// resolved to the same one implementation either way). Facts are NOT
// interchangeable across two same-named-but-different-bodied definitions --
// a name-keyed lookup silently handed instance A instance B's vc, dropping a
// callee-saved pair instance A genuinely used (wrong "needs save" -> a
// clobbered register survives past a `ret`, corrupting the caller). Source
// position is unique per `fn` keyword, so this cannot alias.
fn fntab_fact_lookup(fntab: [i64], srcpos: i64) -> i64 {
  let cnt = fntab[0];
  let i = 0;
  let val = 0;
  while i < cnt {
    let sp = fntab[1 + cnt + cnt + i];
    let is_match = if sp == srcpos then 1 else 0;
    let fv = fntab[2900 + i];
    let val = if is_match == 1 then fv else val;
    let i = i + 1;
    0
  };
  val
}

// Source-position ab over a 3-zone table [cnt, names..., offsets..., srcpos...]:
// returns the callee byte offset in source text, or -1 when absent
// (legacy single-fn path passes cnt=0). O(#fns) not O(source bytes).
fn ft_srcpos(tab: [i64], name: i64) -> i64 {
  let cnt = tab[0];

  let i = 0;
  let sp = 0 - 1;
  while i < cnt {
    let nm = tab[1 + i];
    let pos_i = tab[1 + cnt + cnt + i];
    let is_match = if nm == name then 1 else 0;
    let sp = if is_match == 1 then pos_i else sp;
    let i = i + 1;
    0
  };
  sp
}

// ---- ROADMAP A21 step 1 (2026-09-14): the return-arity table ----
// A fn's DECLARED return arity, read off its own header at the source offset
// collect_fns already recorded (ft_srcpos above, the table's 3rd zone). That table
// is complete before ANY fn is compiled, so the answer is order-independent BY
// CONSTRUCTION -- `divmod` may be declared after `main` -- and no new fntab zone is
// needed. 1 when the name is not a known fn (the legacy single-fn path passes
// cnt = 0) or when the header declares no tuple.
// THE `(` MUST FOLLOW `->` IMMEDIATELY, whitespace and `//` comments aside: the
// contract region between `)` and `{` may legally contain parens and commas
// (scan_inert permits both, bebop.bp:4697), so anchoring on `->` is what stops
// `requires (x > 0)` being read as a 2-tuple. > 3 is E121 at the header.
fn fn_ret_arity_tuple(s: str, arrow: i64, strn: i64) -> i64 {
  let j = [arrow];
  let cm = [0];
  let opened = [0];
  let k = [1];
  let go = 1;
  while go == 1 {
    let at_end = if j[0] >= strn then 1 else 0;
    let c = if at_end == 1 then 0 else char(s, j[0]);
    let c1 = if j[0] + 1 >= strn then 0 else char(s, j[0] + 1);
    let is_cmt = (if c == 47 then 1 else 0) * (if c1 == 47 then 1 else 0);
    let _ = cm[0] = j[0];
    let _ = if is_cmt == 1 then skip_line_comment_n(s, cm, strn) else 0;
    let is_ws = (if c == 32 then 1 else 0) + (if c == 9 then 1 else 0) + (if c == 10 then 1 else 0) + (if c == 13 then 1 else 0);
    let is_lp = if c == 40 then 1 else 0;
    let _ = if is_lp * (1 - opened[0]) == 1 then (let _ = opened[0] = 1 in 0) else 0;
    let _ = if (if c == 44 then 1 else 0) * opened[0] == 1 then (let _ = k[0] = k[0] + 1 in 0) else 0;
    // before the `(` only whitespace and comments may intervene
    let bail = (1 - opened[0]) * (1 - is_cmt) * (1 - is_ws) * (1 - is_lp);
    let stop = at_end + bail + (if c == 41 then 1 else 0) * opened[0] + (if c == 123 then 1 else 0);
    let go = if stop >= 1 then 0 else 1;
    let _ = j[0] = if is_cmt == 1 then cm[0] else j[0] + 1;
    0
  };
  if opened[0] == 1 then k[0] else 1
}

// `strn` is the CALLER's cached source length (slen's pos[1] cache): calling
// str_len here instead cost a full O(source) scan at every call site -- measured
// +25% on bebop.bp's own self-compile (0.965 s -> 1.203 s) before this parameter.
fn fn_ret_arity_at(s: str, sp: i64, strn: i64) -> i64 {
  let p = [sp, strn];
  let _ = skip_to(s, p, 40);
  let _ = skip_to(s, p, 41);
  let j = [p[0] + 1];
  let cm = [0];
  let arrow = [0 - 1];
  let go = 1;
  while go == 1 {
    let at_end = if j[0] >= strn then 1 else 0;
    let c = if at_end == 1 then 0 else char(s, j[0]);
    let c1 = if j[0] + 1 >= strn then 0 else char(s, j[0] + 1);
    let is_cmt = (if c == 47 then 1 else 0) * (if c1 == 47 then 1 else 0);
    let _ = cm[0] = j[0];
    let _ = if is_cmt == 1 then skip_line_comment_n(s, cm, strn) else 0;
    let is_arrow = (1 - is_cmt) * (if c == 45 then 1 else 0) * (if c1 == 62 then 1 else 0);
    let _ = if is_arrow == 1 then (let _ = arrow[0] = j[0] + 2 in 0) else 0;
    let stop = at_end + (if c == 123 then 1 else 0) + is_arrow;
    let go = if stop >= 1 then 0 else 1;
    let _ = j[0] = if is_cmt == 1 then cm[0] else j[0] + 1;
    0
  };
  let k = if arrow[0] < 0 then 1 else fn_ret_arity_tuple(s, arrow[0], strn);
  let _ = if k > 3 then diag_exit(s, sp, 121) else 0;
  k
}

fn fn_ret_arity(s: str, name: i64, fntab: [i64], strn: i64) -> i64 {
  let sp = ft_srcpos(fntab, name);
  if sp < 0 then 1 else fn_ret_arity_at(s, sp, strn)
}

// Does this compilation unit declare any tuple-returning fn? ONE source scan, cached in
// fntab[7101] (0 = not scanned, 1 = no, 2 = yes; a fresh fntab is zeros so the
// lifetime is the unit, exactly like A22's fntab[7000]). WHY IT EXISTS: emit_bl_call's
// arity guard needs ft_srcpos, an O(#fns) scan at EVERY call site on top of the
// fntab_lookup it already does, so this bounds that to programs that can actually
// have a multi-value callee. HONEST MEASUREMENT, 2026-09-14: it bought no measurable
// time -- bebop.bp self-compile is 1.128 s for the pre-A21 source and 1.227 s for
// this one either way, and that 8.8% is the 3.1% source growth and the extra fns,
// not the guard. It is kept because it bounds the cost, not because it moved a number.
// Conservative by design: an arrow-then-paren pair inside a comment or a string turns
// the guard ON, which costs time and changes no answer (bebop.bp's own comments had
// to stop spelling the pair literally for the flag to stay off for itself).
fn unit_tuple_scan(s: str, strn: i64) -> i64 {
  let j = [0];
  let hit = [0];
  let go = 1;
  while go == 1 {
    let c = if j[0] >= strn then 0 else char(s, j[0]);
    let c1 = if j[0] + 1 >= strn then 0 else char(s, j[0] + 1);
    let is_arrow = (if c == 45 then 1 else 0) * (if c1 == 62 then 1 else 0);
    let q = [j[0] + 2, strn];
    let _ = if is_arrow == 1 then skip_ws(s, q) else 0;
    let ca = if q[0] >= strn then 0 else char(s, q[0]);
    let _ = if is_arrow * (if ca == 40 then 1 else 0) == 1 then (let _ = hit[0] = 1 in 0) else 0;
    let _ = j[0] = j[0] + 1;
    let go = (1 - hit[0]) * (if j[0] + 1 < strn then 1 else 0);
    0
  };
  hit[0]
}

fn unit_has_tuple_fn(s: str, fntab: [i64], strn: i64) -> i64 {
  let _ = if fntab[7101] == 0 then (let _ = fntab[7101] = 1 + unit_tuple_scan(s, strn) in 0) else 0;
  fntab[7101] - 1
}

// Collect ctor names of the FIRST enum decl into names[0..): single scan.
// Returns 1 when an enum decl exists, else 0 (cnt[0] stays 0).
fn collect_ctors(s: str, names: [i64], cnt: [i64]) -> i64 {
  let epos = [0];
  let found = find_enum(s, epos);
  let pos = [0, 0];
  let _ = pos[0] = if found == 1 then epos[0] + 5 else 0;
  let nm = read_ident(s, pos);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let k = [0];
  let done = if found == 1 then 0 else 1;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let cname = read_ident(s, pos);
    let is_name = if cname == 0 then 0 else 1;
    let capok = if k[0] < 256 then 1 else 0;
    let _ = if is_name * capok == 1 then (let _ = names[k[0]] = cname in 0) else 0;
    let _ = k[0] = k[0] + is_name;
    let _ = skip_to_field_delim(s, pos);
    let ch = char(s, pos[0]);
    let is_rb = if ch == 125 then 1 else 0;
    let at_end = if ch == 0 then 1 else 0;
    let _ = if is_rb + at_end == 0 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let done = if is_rb + at_end >= 1 then 1 else 0;
    0
  };
  let _ = cnt[0] = k[0];
  found
}

// Tag of ctor name from table zone-4 [.., ecnt, c1, c2, ..]; -1 when absent.
// O(#ctors) per ab; replaces the full-source rescan per identifier.
fn ft_ctor_tag(tab: [i64], name: i64) -> i64 {
  let cnt = tab[0];

  let base = cnt + cnt + cnt + 1;
  let ecnt = tab[base];
  let i = 0;
  let tag = 0 - 1;
  while i < ecnt {
    let cn = tab[base + 1 + i];
    let is_match = if cn == name then 1 else 0;
    let tag = if is_match == 1 then i else tag;
    let i = i + 1;
    0
  };
  tag
}

// Callee-resolution cache (zone-5, 128 direct-mapped 2-word [name,val] slots
// after the ctor zone): val 0 = unresolved, k>0 = srcpos k-1 (ft_srcpos hit),
// k<0 = find_fn result -k-2. The name is stored beside the value so a hash
// collision between two callee names can never serve one name the other's
// resolution (was: bare slot -> colliding name reused a foreign fnpos ->
// wrong bl target / runaway inline parse). Memoizes the per-name resolve so
// each callee is scanned for once, not once per call site. Words emitted are
// unchanged: the resolved position is identical every time.
fn ft_cache_slot(tab: [i64], name: i64) -> i64 {
  let cnt = tab[0];

  let eb = cnt + cnt + cnt + 1;
  let ecnt = tab[eb];
  let cb = eb + ecnt + 2;
  let slot = name - name / 128 * 128;
  let slot2 = if slot < 0 then slot + 128 else slot;
  cb + slot2 + slot2
}

fn ft_cache_get(tab: [i64], name: i64) -> i64 {
  let s0 = ft_cache_slot(tab, name);
  let hit = if tab[s0] == name then 1 else 0;
  let v = if hit == 1 then tab[s0 + 1] else 0;
  v
}

fn ft_cache_set(tab: [i64], name: i64, val: i64) -> i64 {
  let s0 = ft_cache_slot(tab, name);
  let _ = tab[s0] = name;
  let _ = tab[s0 + 1] = val;
  0
}

// A real cross-function call via bl: eval args -> x0..x(n-1), bl target, push.
fn emit_bl_call(s: str, name: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let strn = slen(s, pos);
  // A21 step 1: a fn declared with k > 1 return values may only be called as the
  // whole RHS of a destructuring `let`, which publishes its name in fntab[7102].
  // Anywhere else x1..x(k-1) would be dropped silently -- exactly the "reads
  // garbage" failure the arity table exists to make impossible.
  let cpos = pos[0];
  let _ = if unit_has_tuple_fn(s, fntab, strn) == 1 then (if name == fntab[7102] then 0 else (if fn_ret_arity(s, name, fntab, strn) > 1 then diag_exit(s, cpos, 120) else 0)) else 0;
  let _ = pos[0] = pos[0] + 1;
  let nargs = 0;
  let done = 0;
  while done == 0 {
    // progress guard: a malformed argument (e.g. "(3,{") must not spin forever
    let before = pos[0];
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_rp = if ch == 41 then 1 else 0;
    let _ = if is_rp == 0 then emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let nargs = nargs + (1 - is_rp);
    let _ = skip_ws(s, pos);
    let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch2 == 44 then 1 else 0;
    // T90 step 2 (2026-09-06): after an argument only `,` or `)` may follow (lax d08:
    // `g(k, e]` compiled -- the progress guard consumed `]` as the closing paren)
    let at_end2 = if pos[0] >= strn then 1 else 0;
    let bad2 = (1 - is_comma) * (if ch2 == 41 then 0 else 1) * (1 - at_end2);
    let _ = if bad2 == 1 then diag_exit(s, pos[0], 95) else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let stuck = if pos[0] > before then 0 else 1;
    let done = if is_rp + at_end + stuck >= 1 then 1 else 0;
    0
  };
  let _ = pos[0] = pos[0] + 1;
  // Every window temp deeper than the args survives the call in cs/slot;
  // then a parallel move places the args into x0..x(nargs-1) (params 9-14
  // arrive in x8..x13, so target register == argument index uniformly).
  let base = fntab[5387] - nargs;
  let _ = vs_park(insns, n, fntab, stab, nargs);
  let _ = vs_place_args(insns, n, fntab, stab, base, nargs);
  let i = [nargs - 1];
  while i[0] >= 0 {
    let _ = vs_pop(fntab);
    let _ = i[0] = i[0] - 1;
    0
  };
  let tgt0 = fntab_lookup(fntab, name);
  let target = if name == selfname then selfstart else tgt0;
  // B1 (2026-09-06): fntab[3668]/[1801] are the current fn's own call-site
  // counter and skip-save flag (0 = save, matches the pre-B1 unconditional
  // behaviour and is the default in any fntab this mechanism never touches;
  // 1 = the caller's own facts say it never needs x15/x14 preserved).
  let _ = fntab[3668] = fntab[3668] + 1;
  let _ = emit_bl(insns, n, target, 1 - fntab[3669]);
  // x1..x7 are free (parked); x0 holds the result. `bl` has no destination
  // field to retarget, so p = -1.
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// Parallel move of the nargs argument tags (window indices base..base+nargs-1)
// into x0..x(nargs-1) (spec fix 2026-09-06, §3.8 was under-specified): each
// pass places every entry whose target register is free (materialising it
// there -- a plain SYM/CS/CONST/SLOT/FLAGS entry has no register of its own
// to free, so it is left for vs_mat to place directly once its target opens
// up). If a pass places nothing, the remaining args form a genuine register
// cycle among REG/MULC-window entries (arg i's register is arg j's target);
// break it by evicting ONE cycle member into the scratch x16 (outside both
// masks -- vs_find_blocker only ever names a REG/MULC-window entry, so this
// always frees a real register and the recursion-free bound (2*nargs+2
// passes) always settles). L8: all loop-carried state is hoisted above the
// while bodies.
fn vs_place_args(insns: [i64], n: [i64], fntab: [i64], stab: [i64], base: i64, nargs: i64) -> i64 {
  let progress = [1];
  let i = [0];
  let pass = [0];
  let j = [0 - 1];
  let bound = 2 * nargs + 2;
  while (progress[0] == 1) * (if pass[0] < bound then 1 else 0) {
    let _ = progress[0] = 0;
    let _ = i[0] = 0;
    while i[0] < nargs {
      let idx = base + i[0];
      let is_placed = (if vs_entry_kind(fntab, idx) == 2 then 1 else 0) * (if vs_entry_p0(fntab, idx) == i[0] then 1 else 0);
      let target_free = if vs_find_owning(fntab, i[0], idx) < 0 then 1 else 0;
      let _ = if is_placed == 0 then (if target_free == 1 then (let _ = vs_mat(insns, n, fntab, stab, idx, i[0]) in (let _ = progress[0] = 1 in 0)) else 0) else 0;
      let _ = i[0] = i[0] + 1;
      0
    };
    let _ = j[0] = if progress[0] == 0 then vs_find_blocker(fntab, base, nargs) else 0 - 1;
    let _ = if j[0] >= 0 then (let _ = vs_mat(insns, n, fntab, stab, base + j[0], 16) in (let _ = progress[0] = 1 in 0)) else 0;
    let _ = pass[0] = pass[0] + 1;
    0
  };
  let _ = if vs_find_unplaced(fntab, base, nargs) >= 0 then sys_exit(89) else 0;
  0
}
fn vs_find_unplaced(fntab: [i64], base: i64, nargs: i64) -> i64 {
  let i = [0];
  let found = [0 - 1];
  while i[0] < nargs {
    let idx = base + i[0];
    let placed = (if vs_entry_kind(fntab, idx) == 2 then 1 else 0) * (if vs_entry_p0(fntab, idx) == i[0] then 1 else 0);
    let _ = if placed == 0 then (if found[0] < 0 then found[0] = idx else 0) else 0;
    let _ = i[0] = i[0] + 1;
    0
  };
  found[0]
}
// The first arg (index 0..nargs-1) whose CURRENT register blocks another
// arg's target: a REG or MULC-window entry (owns a real register) sitting
// on a register < nargs that isn't its own index. One must exist whenever
// a pass makes no progress (else every target would already be free).
fn vs_find_blocker(fntab: [i64], base: i64, nargs: i64) -> i64 {
  let i = [0];
  let found = [0 - 1];
  while i[0] < nargs {
    let e = base + i[0];
    let k = vs_entry_kind(fntab, e);
    let p0 = vs_entry_p0(fntab, e);
    let is_reg_or_mulc = (if k == 2 then 1 else 0) + (if k == 6 then (if p0 < 8 then 1 else 0) else 0);
    let is_blocker = is_reg_or_mulc * (if p0 < nargs then 1 else 0) * (if p0 != i[0] then 1 else 0);
    let _ = if found[0] < 0 then (if is_blocker == 1 then found[0] = i[0] else 0) else 0;
    let _ = i[0] = i[0] + 1;
    0
  };
  found[0]
}

// Builtin operand delivery (replaces the old `pop k;...;pop 0` sequence):
// park everything below the nops operands, place them into x0..x(nops-1)
// via the same parallel-move as a call (identical order: "top -> x<nops-1>"
// is argument nops-1 -> x<nops-1>, matching today exactly), then drop the
// tags (the hand-word block below may clobber x0..x13 and the flags freely).
fn vs_deliver(insns: [i64], n: [i64], fntab: [i64], stab: [i64], nops: i64) -> i64 {
  let base = fntab[5387] - nops;
  let _ = vs_park(insns, n, fntab, stab, nops);
  let _ = vs_place_args(insns, n, fntab, stab, base, nops);
  let i = [nops - 1];
  while i[0] >= 0 {
    let _ = vs_pop(fntab);
    let _ = i[0] = i[0] - 1;
    0
  };
  0
}

// Self-recursive call: same N-argument path as any resolved callee, target =
// selfstart (T42 2026-09-04: this used to parse exactly ONE argument and
// strand pos on the first `,` -- every multi-arg recursion (gcd, ackermann)
// silently returned garbage; only 1-arg recursion (c09 factorial) was right).
fn emit_self_call(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  emit_bl_call(s, selfname, pos, insns, n, stab, selfname, selfstart, fntab)
}

// hvham(a, b, n): NEON popcount of a^b over floor(n/8)*8 words.
// Single-path loop form (works for any n%8==0). Dossier: BUGFIXES.md.
fn emit_hvham(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 3);
  // A5 step 1b: cell argument -> address, add x0,x17,x0,lsl #3.
  let _ = em(insns, n, 2332036640);
  // A5 step 1b: cell argument -> address, add x1,x17,x1,lsl #3.
  let _ = em(insns, n, 2332102177);
  // ldp q0,q1 covers 32 BYTES = 4 words per iteration -> divide by 4
  let _ = em(insns, n, 3544382532);
  let _ = em(insns, n, 3019899236);
  let _ = em(insns, n, 1325458436);
  let _ = em(insns, n, 2898330624);
  let _ = em(insns, n, 2898332706);
  let _ = em(insns, n, 1847729152);
  let _ = em(insns, n, 1847794721);
  let _ = em(insns, n, 1310742528);
  let _ = em(insns, n, 1310742561);
  let _ = em(insns, n, 1310753924);
  let _ = em(insns, n, 1310819460);
  let _ = em(insns, n, 3506439300);
  let _ = em(insns, n, 3053453028);
  let _ = em(insns, n, 1848653957);
  let _ = em(insns, n, 235027622);
  let _ = em(insns, n, 2852520928);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// hvham2(a, ao, b, bo, n): NEON hamming with row offsets — no bounce copy.
fn emit_hvham2(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  // non-sequential target registers (a->x0, ao->x6, b->x1, bo->x5, n->x3):
  // deliver sequentially (a->x0, ao->x1, b->x2, bo->x3, n->x4) then shuffle
  // with plain register moves into the real targets.
  let _ = vs_deliver(insns, n, fntab, stab, 5);
  // A5 step 1b: cell argument -> address, add x0,x17,x0,lsl #3.
  let _ = em(insns, n, 2332036640);
  // A5 step 1b: cell argument -> address, add x2,x17,x2,lsl #3.
  let _ = em(insns, n, 2332167714);
  let _ = em(insns, n, 2852193254);
  let _ = em(insns, n, 2852258785);
  let _ = em(insns, n, 2852324325);
  let _ = em(insns, n, 2852389859);
  let _ = em(insns, n, 2332363809);
  let _ = em(insns, n, 2332429312);
  let _ = em(insns, n, 2852324322);
  let _ = em(insns, n, 1325458436);
  let _ = em(insns, n, 3544382532);
  let _ = em(insns, n, 3019899236);
  let _ = em(insns, n, 2898330624);
  let _ = em(insns, n, 2898332706);
  let _ = em(insns, n, 1847729152);
  let _ = em(insns, n, 1847794721);
  let _ = em(insns, n, 1310742528);
  let _ = em(insns, n, 1310742561);
  let _ = em(insns, n, 1310753924);
  let _ = em(insns, n, 1310819460);
  let _ = em(insns, n, 3506439300);
  let _ = em(insns, n, 3053453028);
  let _ = em(insns, n, 1848653957);
  let _ = em(insns, n, 235027622);
  let _ = em(insns, n, 2852520928);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_open(p,n,flags): pack byte-per-element path into the IO scratch zone
// (last 8 KiB below x28), then raw openat. Words assembler+execution-verified.
fn emit_sys_open(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 3);
  // A5 step 1b: cell argument -> address, add x0,x17,x0,lsl #3.
  let _ = em(insns, n, 2332036640);
  em(insns, n, 2852127723);
  em(insns, n, 2852193261);
  em(insns, n, 2852258796);
  em(insns, n, 3531866122);
  em(insns, n, 3406431114);
  em(insns, n, 3531603977);
  em(insns, n, 3943498047);
  em(insns, n, 1409286314);
  em(insns, n, 4167661927);
  em(insns, n, 942238023);
  em(insns, n, 2432697641);
  em(insns, n, 402653179);
  em(insns, n, 942500191);
  em(insns, n, 2457865312);
  em(insns, n, 2852783073);
  em(insns, n, 2852914146);
  em(insns, n, 3531617411);  // mov x3, #0o644 = openat mode (was #0: files got mode 000, proot chmod races -> EACCES rc=90, journal 1788641800)
  em(insns, n, 3531605768);
  em(insns, n, 3556769793);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_read(fd,buf,len): raw read into scratch, unpack bytes to element slots.
fn emit_sys_read(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 3);
  // A5 step 1b: cell argument -> address, add x1,x17,x1,lsl #3.
  let _ = em(insns, n, 2332102177);
  em(insns, n, 2852127723);
  em(insns, n, 2852193260);
  em(insns, n, 3531866122);
  em(insns, n, 3406431114);
  em(insns, n, 2852848608);
  em(insns, n, 2852783073);
  em(insns, n, 3531605992);
  em(insns, n, 3556769793);
  em(insns, n, 2852127725);
  em(insns, n, 3531603977);
  em(insns, n, 3943498047);
  em(insns, n, 1409286314);
  em(insns, n, 946432327);
  em(insns, n, 4163467655);
  em(insns, n, 2432697641);
  em(insns, n, 402653179);
  em(insns, n, 2852979680);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_write(fd,buf,len): pack low bytes of elements to scratch, raw write.
fn emit_sys_write(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 3);
  // A5 step 1b: cell argument -> address, add x1,x17,x1,lsl #3.
  let _ = em(insns, n, 2332102177);
  em(insns, n, 2852127723);
  em(insns, n, 2852258797);
  em(insns, n, 3531866122);
  em(insns, n, 3406431114);
  em(insns, n, 3531603977);
  em(insns, n, 3943498047);
  em(insns, n, 1409286314);
  em(insns, n, 4167661607);
  em(insns, n, 942238023);
  em(insns, n, 2432697641);
  em(insns, n, 402653179);
  em(insns, n, 2852783073);
  em(insns, n, 2852848608);
  em(insns, n, 3531606024);
  em(insns, n, 3556769793);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_close(fd): raw close.
fn emit_sys_close(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 1);
  em(insns, n, 3531605800);
  em(insns, n, 3556769793);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_exit(code): raw exit_group — noreturn, nothing pushed.
fn emit_sys_exit(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 1);
  // 2026-09-12: this word was 3531606952 = 0xd2800ba8 = `movz x8,#93`, and syscall 93 is
  // EXIT -- it ends the calling THREAD only -- while the comment above has always claimed
  // exit_group. Inside a CLONE_THREAD child (flags 68864) that meant st_alloc_p's
  // sys_exit(80) killed just the thread, its done flag was never set, and the parent waited
  // for ever: a dead thread indistinguishable from a slow one, the costliest failure shape
  // in this project's record. 3531606984 = 0xd2800bc8 = `movz x8,#94` = exit_group, derived
  // by as+objdump per law L1 and never from memory. emit_sys_exit_thread_guard keeps #93
  // deliberately -- that one IS meant to end only its own thread.
  let _ = em(insns, n, 3531606984);
  let _ = em(insns, n, 3556769793);
  // BUGFIX (2026-09-06, bug 9 hunt, exit-107): sys_exit(...) is a NORETURN
  // builtin (raw svc, never returns to the caller) so it used to push
  // nothing -- harmless historically since the code path following it is
  // unreachable, but it desyncs the window's entry count whenever
  // sys_exit(...) is used AS AN EXPRESSION (e.g. the else-branch of
  // `if cond then 0 else sys_exit(64)`, main.bp's own argc guard): the
  // enclosing if-expression's machinery expects exactly one value on top
  // of the window after compiling either branch. Push a dummy result
  // (x0, matching every real call's convention) so the bookkeeping stays
  // consistent even though this value can never actually be read.
  vs_push(insns, n, fntab, stab, 2, 0, 0 - 1)
}

// clock_ms(): CLOCK_MONOTONIC via raw svc; ms = sec*1000 + nsec/1000000.
// timespec parked at x28-8208 (below the 8 KiB IO scratch zone).
fn emit_clock_ms(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  // R3.x(e) FIX: the zero-arg builtin consumed `()` AND the trailing ';' -
  // the extra skip ate the first char of the NEXT statement (`let i` became
  // `et i` -> unbound-ident reads, hangs/segfaults). Only the parens belong
  // to the builtin; the ';' is the statement layer's.
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 0);
  em(insns, n, 3531866625);
  em(insns, n, 3405841281);
  em(insns, n, 3531604000);
  em(insns, n, 3531607592);
  em(insns, n, 3556769793);
  em(insns, n, 4181721124);
  em(insns, n, 4181722149);
  em(insns, n, 3531635974);
  em(insns, n, 2600893572);
  em(insns, n, 3531739655);
  em(insns, n, 4070572519);
  em(insns, n, 2596735141);
  em(insns, n, 2332360832);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// ---- T45 (2026-09-04): thread/arena builtins ported verbatim from the legacy
// selfhost/expr_compile.bp (now attic). Word tables per L2; check_abi allowlists
// every em() inside fn emit_sys_* (clone re-homes x14/x15/x27/x28 for the child).
// sys_arena_base(): mov x0, x27 — the seed loader's arena cursor
// (post-argv). x27/x28 are reserved by the register protocol and survive
// into the program; callers derive shared cell addresses as
// sys_arena_base() + idx * 8. Assembler-verified (m6.s).
// ROADMAP A6 (2026-09-08): this used the ORR form `mov x0,x27` (2853897184).
// A6 makes that exact word the SENTINEL for "this fn allocates an aggregate on
// the arena cursor" (count_word in emit_while_stmt / compile_fn_at_total_saved
// is an exact 32-bit match), so sys_arena_base() would have false-positived as
// an allocation. Retargeted onto the ADD alias `add x0,x27,xzr` (2334065504),
// which is bit-identical in effect, sets no flags, and is already the word
// emit_zeros uses for the same move -- so it is not, and never was, a sentinel.
fn emit_sys_arena_base(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 0);
  // A5 step 1b: the cursor is returned as a cell INDEX -- sub x0,x27,x17
  // (3406889824) ; lsr x0,x0,#3 (3544448000). "base" still means CURSOR (the
  // store and pool code read it that way); only the units changed.
  let _ = em(insns, n, 3406889824);
  let _ = em(insns, n, 3544448000);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_arena_end(): mov x0, x28 — arena limit (seed loader's x28).
fn emit_sys_arena_end(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 0);
  // A5 step 1b: the arena end as a cell INDEX -- sub x0,x28,x17 (3406889856) ;
  // lsr x0,x0,#3 (3544448000).
  let _ = em(insns, n, 3406889856);
  let _ = em(insns, n, 3544448000);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_clone(flags, stack_top): raw clone. x0=flags, x1=stack_top, x2..x5=0.
// Returns child tid in the parent, 0 in the child. The child continues at
// the same instruction stream with the caller's registers (VM shared), so
// the worker must branch on r==0 and finish with sys_exit_thread.
// Register table: x0=flags (arg0), x1=stack_top (arg1), x2..x5=xzr, x8=220.
fn emit_sys_clone(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let srcpos = pos[0];
  // A19 step 1 (2026-09-13). MEASURED, not assumed: 8 symbols kept across a sys_clone -> both
  // children correct; 9 -> one child silently lost; 11 -> both. The mechanism is now measured
  // too -- lane L22's probe read the 9th symbol as 0 in the child on all five runs, which is the
  // FRESH x15 frame (the child re-homes x15 onto its own stack, so a symbol the allocator
  // SPILLED before the spawn reads 0 there). It is NOT the "shared frame" story that circulated
  // for a day: selfhost/std/pool.bp:6-7 says spilled slots are per-thread, and it is right.
  //
  // The metric is `stab[0]`, the number of symbols bound SO FAR -- which in a one-pass compiler
  // is exactly the set bound BEFORE this spawn, i.e. tools/arch_check.py CHECK 20's rule. The
  // withdrawn trap 103 used FUNCTION-WIDE counters (fntab[5393] + fntab[5391]) and that is why
  // it refused working programs and had to be removed; a function-wide count is not a
  // point-specific one, and re-deriving it here would repeat the same mistake.
  let _ = if stab[0] > 8 then diag_exit(s, srcpos, 109) else 0;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 2);
  // A5 step 1b: cell argument -> address, add x1,x17,x1,lsl #3.
  let _ = em(insns, n, 2332102177);
  let _ = em(insns, n, 2854159330);
  let _ = em(insns, n, 2854159331);
  let _ = em(insns, n, 2854159332);
  let _ = em(insns, n, 2854159333);
  let _ = em(insns, n, 2457660449);
  let _ = em(insns, n, 3531611016);
  let _ = em(insns, n, 3556769793);
  // A6 step 2 commit B (2026-09-09): the clone child no longer re-homes x14 --
  // it is a dead register since step 1 deleted the frame heap. x15/x27/x28 still
  // are. The child's x15 stays sp+256: that is a FRESH 12 MiB stack, not this
  // fn's frame, so it is deliberately independent of frame_x15off.
  // THE SKIP LENGTH IS COUPLED TO THE BLOCK: this `cbnz x0` is the PARENT's
  // branch OVER the child's re-home words, so dropping one word must shorten it
  // from `.+20` (3036676256) to `.+16` (3036676224), as+objdump-derived. Getting
  // this wrong is silent -- the parent lands one word past the block, mid-stream:
  // bisected 2026-09-09 from c84_run (got 0, want 1035) and the two gb_pool
  // gates, all three of which go through sys_run/sys_clone, with a two-variant
  // control that cleared the has_spills change of any part in it.
  let _ = em(insns, n, 3036676224);
  let _ = em(insns, n, 2432959471);
  let _ = em(insns, n, 2437940219);
  // T118 (2026-09-05): the child arena is [sp+4 MiB, sp+12 MiB) -- the arena
  // trap exposed that x28 = sp+8 MiB left par_compile's in-thread compiler
  // (slurp 3.2 MB + insns 2 MB + tables) only 4 MiB, which it silently overran
  // before; 12 MiB still leaves 4 MiB of stack for the next 16 MiB-pitched worker.
  let _ = em(insns, n, 2440037372);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_cond_set(cond, arr, idx, val): *arr[idx] = val iff cond != 0.
// Real cbz inside: both threads may execute it, only the guard-matching
// one writes — no branchless speculation, no lost updates on shared cells.
// Register table: x0=cond (arg0), x1=arr (arg1), x2=idx (arg2),
// x3=val (arg3); cbz x0,+3; add x1,x1,x2<<3; str x3,[x1]; mov x0,xzr.
fn emit_sys_cond_set(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 4);
  // A5 step 1b: cell argument -> address, add x1,x17,x1,lsl #3.
  let _ = em(insns, n, 2332102177);
  let _ = em(insns, n, 3019898976);
  let _ = em(insns, n, 2332167201);
  let _ = em(insns, n, 4177526819);
  let _ = em(insns, n, 2854159328);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_futex_wait_guard(cond, arr, idx, val): FUTEX_WAIT on arr[idx] iff
// cond == 0 (the parked/waiting side), else return cond untouched. Real
// cbnz (0xB5000100 = cbnz x0,+8 words): x0=cond (arg0), x1=arr, x2=idx,
// x3=val; mov x0,x1; add x0,x0,x2<<3; x1=0 (WAIT); x2=val; x3=0; x8=98;
// svc; mov x0,xzr. (The legacy comment said "iff cond != 0" - wrong; a
// worker that parks passes r (0 in the child), see D4-clone-3.)
fn emit_sys_futex_wait_guard(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 4);
  // A5 step 1b: cell argument -> address, add x1,x17,x1,lsl #3.
  let _ = em(insns, n, 2332102177);
  let _ = em(insns, n, 3036676352);
  let _ = em(insns, n, 2852193248);
  let _ = em(insns, n, 2332167168);
  let _ = em(insns, n, 2854159329);
  let _ = em(insns, n, 2852324322);
  let _ = em(insns, n, 2854159331);
  let _ = em(insns, n, 3531607112);
  let _ = em(insns, n, 3556769793);
  let _ = em(insns, n, 2854159328);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_futex_wake(arr, idx, n): futex WAKE n waiters on arr[idx].
// Register table: x0=base (arg0), x1=idx (arg1), x2=n (arg2),
// then x0+=x1<<3, x1=1 (FUTEX_WAKE), x3=0, x8=98.
fn emit_sys_futex_wake(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 3);
  // A5 step 1b: cell argument -> address, add x0,x17,x0,lsl #3.
  let _ = em(insns, n, 2332036640);
  let _ = em(insns, n, 2332101632);
  let _ = em(insns, n, 3531604001);
  let _ = em(insns, n, 2854159331);
  let _ = em(insns, n, 3573758911);
  let _ = em(insns, n, 3531607112);
  let _ = em(insns, n, 3556769793);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_atomic_add(arr, idx, val): LSE LDADDAL — *arr[idx] += val atomically,
// returns the OLD value (full barrier). Register table: x0=arr (arg0),
// x1=idx (arg1), x2=val (arg2); add x0,x0,x1<<3; ldaddal x2,x1,[x0];
// mov x0,x1.
fn emit_sys_atomic_add(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 3);
  // A5 step 1b: cell argument -> address, add x0,x17,x0,lsl #3.
  let _ = em(insns, n, 2332036640);
  let _ = em(insns, n, 2332101632);
  let _ = em(insns, n, 4175560705);
  let _ = em(insns, n, 2852193248);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_exit_thread_guard(cond, code): raw thread exit (svc 93 = exit; T127 2026-09-05:
// it emitted 94 = exit_group on AArch64 and killed the whole process) iff
// cond != 0 — the worker dies alone, the parent skips (real cbz) and
// returns 0. Never speculate this: svc 94 would kill the main thread.
fn emit_sys_exit_thread_guard(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 2);
  let _ = em(insns, n, 3019899008);
  let _ = em(insns, n, 2852193248);
  let _ = em(insns, n, 3531606952);
  let _ = em(insns, n, 3556769793);
  let _ = em(insns, n, 2854159328);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// sys_setaffinity(arr, idx): sched_setaffinity(0, 8, &arr[idx]) -- pin the calling
// thread to the CPU mask in arr[idx] (T72, 2026-09-05). Register table: x0=arr
// (arg0), x1=idx (arg1); add x0,x0,x1,lsl #3; mov x2,x0; mov x0,xzr (pid 0 =
// self); mov x1,#8 (cpusetsize); mov x8,#122; svc. Returns the syscall result.
fn emit_sys_setaffinity(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 2);
  // A5 step 1b: cell argument -> address, add x0,x17,x0,lsl #3.
  let _ = em(insns, n, 2332036640);
  let _ = em(insns, n, 2332101632);
  let _ = em(insns, n, 2852127714);
  let _ = em(insns, n, 2854159328);
  let _ = em(insns, n, 3531604225);
  let _ = em(insns, n, 3531607880);
  let _ = em(insns, n, 3556769793);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// clz(x): count leading zeros of the 64-bit word, clz(0) = 64 (T105, 2026-09-05).
// pop x0; clz x0,x0 (0xDAC01000); push. Seeds the Newton isqrt in prelude/fp.bp.
fn emit_clz(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 1);
  let _ = em(insns, n, 3670020096);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

// scan(s, pos, class) -> new pos (A9 step 3, scalar form). Advances pos[0] over bytes whose
// class matches: 0 = whitespace (' ' \t \n \r), 1 = ident [0-9A-Za-z_], 2 = not-'"'-not-'\\',
// anything else = 3 = not-'\n'. x0 = s (raw byte base, same address form as char()), x1 = the
// pos array, x2 = class (a runtime value, not a compile-time constant). The scan STOPS at
// pos[1] -- the caller's length bound -- so no byte past pos[1] is ever read (the over-read
// slack rule of the blueprint is not needed for the scalar form). pos[0] is written back and
// the same value is returned in x0. bpref stub (tools/bpref.py 'scan') mirrors all of this,
// bound included. Words: $BEBOP_TMP/words.objdump (as + objdump, 46 words).
fn emit_sys_scan(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 3);
  // A5 step 1b: cell argument -> address, add x1,x17,x1,lsl #3.
  let _ = em(insns, n, 2332102177);
  let _ = em(insns, n, -113246173);
  let _ = em(insns, n, -113245148);
  let _ = em(insns, n, -352059265);
  let _ = em(insns, n, 1409287466);
  let _ = em(insns, n, 946038789);
  let _ = em(insns, n, -251658145);
  let _ = em(insns, n, 1409286465);
  let _ = em(insns, n, 1895858367);
  let _ = em(insns, n, 1409287232);
  let _ = em(insns, n, 1895834815);
  let _ = em(insns, n, 1409287168);
  let _ = em(insns, n, 1895835839);
  let _ = em(insns, n, 1409287104);
  let _ = em(insns, n, 1895838911);
  let _ = em(insns, n, 1409287040);
  let _ = em(insns, n, 335544349);
  let _ = em(insns, n, -251657121);
  let _ = em(insns, n, 1409286657);
  let _ = em(insns, n, 1895922879);
  let _ = em(insns, n, 1409286880);
  let _ = em(insns, n, 1895874751);
  let _ = em(insns, n, 1409286891);
  let _ = em(insns, n, 1895883967);
  let _ = em(insns, n, 1409286765);
  let _ = em(insns, n, 1895892159);
  let _ = em(insns, n, 1409286763);
  let _ = em(insns, n, 1895917759);
  let _ = em(insns, n, 1409286637);
  let _ = em(insns, n, 1895924927);
  let _ = em(insns, n, 1409286635);
  let _ = em(insns, n, 1895950527);
  let _ = em(insns, n, 1409286509);
  let _ = em(insns, n, 335544332);
  let _ = em(insns, n, -251656097);
  let _ = em(insns, n, 1409286337);
  let _ = em(insns, n, 1895860415);
  let _ = em(insns, n, 1409286400);
  let _ = em(insns, n, 1895919807);
  let _ = em(insns, n, 1409286336);
  let _ = em(insns, n, 335544323);
  let _ = em(insns, n, 1895835839);
