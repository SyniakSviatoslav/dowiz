// clock_ms(): CLOCK_MONOTONIC via raw svc; ms = sec*1000 + nsec/1000000.
// timespec parked at x28-8208 (below the 8 KiB IO scratch zone).
fn emit_clock_ms(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  // R3.x(e) FIX: the zero-arg builtin consumed `()` AND the trailing ';' -
  // the extra skip ate the first char of the NEXT statement (`let i` became
  // `et i` -> unbound-ident reads, hangs/segfaults). Only the parens belong
  // to the builtin; the ';' is the statement layer's.
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  em(insns, n, 3531866625);
  em(insns, n, 3405841281);
  em(insns, n, 3531604000);
  em(insns, n, 3531607592);
  em(insns, n, 3556769793);
  em(insns, n, 4181721124);
  em(insns, n, 4181722149);
  em(insns, n, 3531635974);
  em(insns, n, 2600893572);
  em(insns, n, 3531739655);
  em(insns, n, 4070572519);
  em(insns, n, 2596735141);
  em(insns, n, 2332360832);
  let _ = push(insns, n, fntab);
  n[0]
}

// ---- T45 (2026-09-04): thread/arena builtins ported verbatim from the legacy
// selfhost/expr_compile.bp (now attic). Word tables per L2; check_abi allowlists
// every em() inside fn emit_sys_* (clone re-homes x14/x15/x27/x28 for the child).
// sys_arena_base(): mov x0, x27 — the seed loader's arena cursor
// (post-argv). x27/x28 are reserved by the register protocol and survive
// into the program; callers derive shared cell addresses as
// sys_arena_base() + idx * 8. Assembler-verified (m6.s).
fn emit_sys_arena_base(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = em(insns, n, 2853897184);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_arena_end(): mov x0, x28 — arena limit (seed loader's x28).
fn emit_sys_arena_end(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = em(insns, n, 2853962720);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_clone(flags, stack_top): raw clone. x0=flags, x1=stack_top, x2..x5=0.
// Returns child tid in the parent, 0 in the child. The child continues at
// the same instruction stream with the caller's registers (VM shared), so
// the worker must branch on r==0 and finish with sys_exit_thread.
// Register table: x0=flags (arg0), x1=stack_top (arg1), x2..x5=xzr, x8=220.
fn emit_sys_clone(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 2854159330);
  let _ = em(insns, n, 2854159331);
  let _ = em(insns, n, 2854159332);
  let _ = em(insns, n, 2854159333);
  let _ = em(insns, n, 2457660449);
  let _ = em(insns, n, 3531611016);
  let _ = em(insns, n, 3556769793);
  let _ = em(insns, n, 3036676256);
  let _ = em(insns, n, 2432959471);
  let _ = em(insns, n, 2433483758);
  let _ = em(insns, n, 2437940219);
  // T118 (2026-09-05): the child arena is [sp+4 MiB, sp+12 MiB) -- the arena
  // trap exposed that x28 = sp+8 MiB left par_compile's in-thread compiler
  // (slurp 3.2 MB + insns 2 MB + tables) only 4 MiB, which it silently overran
  // before; 12 MiB still leaves 4 MiB of stack for the next 16 MiB-pitched worker.
  let _ = em(insns, n, 2440037372);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_cond_set(cond, arr, idx, val): *arr[idx] = val iff cond != 0.
// Real cbz inside: both threads may execute it, only the guard-matching
// one writes — no branchless speculation, no lost updates on shared cells.
// Register table: x0=cond (arg0), x1=arr (arg1), x2=idx (arg2),
// x3=val (arg3); cbz x0,+3; add x1,x1,x2<<3; str x3,[x1]; mov x0,xzr.
fn emit_sys_cond_set(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 3, fntab);
  let _ = pop(insns, n, 2, fntab);
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 3019898976);
  let _ = em(insns, n, 2332167201);
  let _ = em(insns, n, 4177526819);
  let _ = em(insns, n, 2854159328);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_futex_wait_guard(cond, arr, idx, val): FUTEX_WAIT on arr[idx] iff
// cond == 0 (the parked/waiting side), else return cond untouched. Real
// cbnz (0xB5000100 = cbnz x0,+8 words): x0=cond (arg0), x1=arr, x2=idx,
// x3=val; mov x0,x1; add x0,x0,x2<<3; x1=0 (WAIT); x2=val; x3=0; x8=98;
// svc; mov x0,xzr. (The legacy comment said "iff cond != 0" - wrong; a
// worker that parks passes r (0 in the child), see D4-clone-3.)
fn emit_sys_futex_wait_guard(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 3, fntab);
  let _ = pop(insns, n, 2, fntab);
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 3036676352);
  let _ = em(insns, n, 2852193248);
  let _ = em(insns, n, 2332167168);
  let _ = em(insns, n, 2854159329);
  let _ = em(insns, n, 2852324322);
  let _ = em(insns, n, 2854159331);
  let _ = em(insns, n, 3531607112);
  let _ = em(insns, n, 3556769793);
  let _ = em(insns, n, 2854159328);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_futex_wake(arr, idx, n): futex WAKE n waiters on arr[idx].
// Register table: x0=base (arg0), x1=idx (arg1), x2=n (arg2),
// then x0+=x1<<3, x1=1 (FUTEX_WAKE), x3=0, x8=98.
fn emit_sys_futex_wake(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 2, fntab);
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 2332101632);
  let _ = em(insns, n, 3531604001);
  let _ = em(insns, n, 2854159331);
  let _ = em(insns, n, 3573758911);
  let _ = em(insns, n, 3531607112);
  let _ = em(insns, n, 3556769793);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_atomic_add(arr, idx, val): LSE LDADDAL — *arr[idx] += val atomically,
// returns the OLD value (full barrier). Register table: x0=arr (arg0),
// x1=idx (arg1), x2=val (arg2); add x0,x0,x1<<3; ldaddal x2,x1,[x0];
// mov x0,x1.
fn emit_sys_atomic_add(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 2, fntab);
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 2332101632);
  let _ = em(insns, n, 4175560705);
  let _ = em(insns, n, 2852193248);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_exit_thread_guard(cond, code): raw thread exit (svc 94) iff
// cond != 0 — the worker dies alone, the parent skips (real cbz) and
// returns 0. Never speculate this: svc 94 would kill the main thread.
fn emit_sys_exit_thread_guard(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 3019899008);
  let _ = em(insns, n, 2852193248);
  let _ = em(insns, n, 3531606984);
  let _ = em(insns, n, 3556769793);
  let _ = em(insns, n, 2854159328);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_setaffinity(arr, idx): sched_setaffinity(0, 8, &arr[idx]) -- pin the calling
// thread to the CPU mask in arr[idx] (T72, 2026-09-05). Register table: x0=arr
// (arg0), x1=idx (arg1); add x0,x0,x1,lsl #3; mov x2,x0; mov x0,xzr (pid 0 =
// self); mov x1,#8 (cpusetsize); mov x8,#122; svc. Returns the syscall result.
fn emit_sys_setaffinity(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 2332101632);
  let _ = em(insns, n, 2852127714);
  let _ = em(insns, n, 2854159328);
  let _ = em(insns, n, 3531604225);
  let _ = em(insns, n, 3531607880);
  let _ = em(insns, n, 3556769793);
  let _ = push(insns, n, fntab);
  n[0]
}

// clz(x): count leading zeros of the 64-bit word, clz(0) = 64 (T105, 2026-09-05).
// pop x0; clz x0,x0 (0xDAC01000); push. Seeds the Newton isqrt in prelude/fp.bp.
fn emit_clz(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 3670020096);
  let _ = push(insns, n, fntab);
  n[0]
}

// crc32(cells, n): zlib crc32 of n bytes held one per cell (T109, 2026-09-05), on the
// hardware CRC32B unit: pop x1 = n, pop x0 = cells; movn w2,#0; L: cbz x1,done;
// ldr x3,[x0],#8; crc32b w2,w2,w3; sub x1,x1,#1; b L; done: orn w0,wzr,w2; push.
// Bytes-in-cells is the language's byte form (sys_read, sys_export, str_to_cells),
// so crc.bp / tb.bp folds are unchanged; ~1 cell per cycle.
fn emit_crc32(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 310378498);
  let _ = em(insns, n, 3019899041);
  let _ = em(insns, n, 4164977667);
  let _ = em(insns, n, 449003586);
  let _ = em(insns, n, 3506439201);
  let _ = em(insns, n, 402653180);
  let _ = em(insns, n, 706872288);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_readbuf(fd,len): raw read into the IO scratch zone, returns its
// address — the standard handoff for feeding source text to emit_words.
fn emit_sys_readbuf(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  em(insns, n, 2852193250);
  em(insns, n, 3531866122);
  em(insns, n, 3406431114);
  em(insns, n, 2852783073);
  em(insns, n, 3531605992);
  em(insns, n, 3556769793);
  em(insns, n, 2852127725);
  em(insns, n, 942500191);
  em(insns, n, 2852783072);
  let _ = push(insns, n, fntab);
  n[0]
}

// str_len(s): NUL-scan over a raw byte pointer (JIT string contract).
fn emit_str_len_fn(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 0, fntab);
  em(insns, n, 3531603970);
  em(insns, n, 945973249);
  em(insns, n, 872415329);
  em(insns, n, 2432697410);
  em(insns, n, 402653181);
  em(insns, n, 2852258784);
  let _ = push(insns, n, fntab);
  n[0]
}

// char(s,i): zero-extended byte load from a raw pointer.
fn emit_char_fn(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  em(insns, n, 2852193250);
  em(insns, n, 2852127713);
  em(insns, n, 945907776);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_slurp(fd,len): arena-allocate round16(len*8) bytes, raw read into it,
// NUL-terminate at nread, return the base address. Feeds emit_words directly.
fn emit_sys_slurp(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  em(insns, n, 2852193250);
  em(insns, n, 3548246057);
  em(insns, n, 2432711977);
  em(insns, n, 3544513833);
  em(insns, n, 3548179753);
  em(insns, n, 2853897194);
  em(insns, n, 2332623739);
  em(insns, n, 2852783073);
  em(insns, n, 3531605992);
  em(insns, n, 3556769793);
  em(insns, n, 2852127725);
  em(insns, n, 942500191);
  em(insns, n, 2852783072);
  let _ = push(insns, n, fntab);
  n[0]
}

fn emit_call_or_ctor(s: str, name: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let tag = ft_ctor_tag(fntab, name);
  let is_ctor = if tag >= 0 then 1 else 0;
  let is_self = if name == selfname then 1 else 0;
  let tgt = fntab_lookup(fntab, name);
  let is_fn = if tgt >= 0 then 1 else 0;
  let is_zw = if name == 36158018563 then 1 else 0;
  let is_hh = if name == 30895064082 then 1 else 0;
  let is_hh2 = if name == 4047253394792 then 1 else 0;
  let is_so = if name == 76753189879327100 then 1 else 0;
  let is_sr = if name == 76753189885882068 then 1 else 0;
  let is_sw = if name == 10054667876552415181 then 1 else 0;
  let is_sc = if name == 10054667870649031050 then 1 else 0;
  let is_se = if name == 76753189856984008 then 1 else 0;
  let is_cm = if name == 66094333908796503 then 1 else 0;
  let is_rb = if name == 15758082337069564947 then 1 else 0;
  let is_sp = if name == 10054667875361132632 then 1 else 0;
  let is_sln = if name == 585709020818199 then 1 else 0;
  let is_chf = if name == 224358574 then 1 else 0;
  let is_smm = if name == 76753189874778913 then 1 else 0;
  let is_srn = if name == 7442662398273192292 then 1 else 0;
  let is_sft = if name == 12598865016055593546 then 1 else 0;
  let is_sex = if name == 7442661902340062434 then 1 else 0;
  let is_smun = if name == 7442662210087947144 then 1 else 0;
  let is_arb = if name == 7040940390938053523 then 1 else 0;
  let is_are = if name == 12163823898702034029 then 1 else 0;
  let is_cln = if name == 10054667870649030395 then 1 else 0;
  let is_fwk = if name == 8779068393901189725 then 1 else 0;
  let is_ext = if name == 1084841420853388659 then 1 else 0;
  let is_ata = if name == 7221016679989100487 then 1 else 0;
  let is_aff = if name == 7304771531850188344 then 1 else 0;
  let is_clz = if name == 1713209 then 1 else 0;
  let is_crc = if name == 29413480223 then 1 else 0;
  let is_fwg = if name == 15293169932641766580 then 1 else 0;
  let is_cs = if name == 16710314075682296179 then 1 else 0;
  if is_hh == 1 then emit_hvham(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_hh2 == 1 then emit_hvham2(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_smm == 1 then emit_sys_mmap(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_srn == 1 then emit_sys_rename(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_sft == 1 then emit_sys_ftruncate(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_sex == 1 then emit_sys_export(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_smun == 1 then emit_sys_munmap(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_arb == 1 then emit_sys_arena_base(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_are == 1 then emit_sys_arena_end(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_cln == 1 then emit_sys_clone(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_cs == 1 then emit_sys_cond_set(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_fwg == 1 then emit_sys_futex_wait_guard(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_fwk == 1 then emit_sys_futex_wake(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_ext == 1 then emit_sys_exit_thread_guard(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_ata == 1 then emit_sys_atomic_add(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_aff == 1 then emit_sys_setaffinity(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_clz == 1 then emit_clz(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_crc == 1 then emit_crc32(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_sp == 1 then emit_sys_slurp(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_sln == 1 then emit_str_len_fn(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_chf == 1 then emit_char_fn(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_rb == 1 then emit_sys_readbuf(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_so == 1 then emit_sys_open(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_sr == 1 then emit_sys_read(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_sw == 1 then emit_sys_write(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_sc == 1 then emit_sys_close(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_se == 1 then emit_sys_exit(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_cm == 1 then emit_clock_ms(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_zw == 1 then emit_zeros(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_ctor == 1 then emit_enum_ctor(s, tag, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_self == 1 then emit_self_call(s, pos, insns, n, stab, selfname, selfstart, fntab)
  else if is_fn == 1 then emit_bl_call(s, name, pos, insns, n, stab, selfname, selfstart, fntab)
  else emit_call(s, name, pos, insns, n, stab, selfname, selfstart, fntab)
}

// Dispatch a bare name: nullary enum ctor or a variable reference.
fn emit_var_or_ctor(s: str, name: i64, npos: i64, insns: [i64], n: [i64], stab: [i64], fntab: [i64]) -> i64 {
  let tag = ft_ctor_tag(fntab, name);
  let is_ctor = if tag >= 0 then 1 else 0;
  if is_ctor == 1 then emit_enum_ctor_nullary(insns, n, tag, fntab)
  else emit_var(insns, n, sym_lookup(s, stab, name, npos), fntab)
}

// Emit a matching match-arm: bind the payload var (if any) then emit the arm body.
fn emit_match_arm(s: str, ppos: i64, has_var: i64, vname: i64, vpos: i64, bodypos: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let saved = pos[0];
  let _ = if has_var == 1 then (let _ = pos[0] = ppos in (let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab) in (let _ = em(insns, n, 4181722080) in (let _ = em(insns, n, 2432713727) in (let _ = bind_reg(insns, n, sym_bind(s, stab, vname, vpos)) in 0))))) else 0;
  let _ = pos[0] = bodypos;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = pos[0] = saved;
  n[0]
}

// Compile-time match on a literal enum scrutinee: match ctor(payload) { arm, ... }.
// The arm loop stops at the closing brace and consumes ONLY it (T42 2026-09-04:
// it used to run the arm tail at "}" and scan into the enclosing expression).
fn emit_match(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let strn = str_len(s);
  let _ = pos[0] = pos[0] + 5;
  let _ = skip_ws(s, pos);
  let cname = read_ident(s, pos);
  let _ = skip_ws(s, pos);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  let is_lp = if ch == 40 then 1 else 0;
  let ppos = [0];
  let _ = if is_lp == 1 then (let _ = pos[0] = pos[0] + 1 in (let _ = ppos[0] = pos[0] in (let _ = skip_args(s, pos) in (let _ = pos[0] = pos[0] + 1 in 0)))) else 0;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch0 = if at_end == 1 then 0 else char(s, pos[0]);
    let is_rb = if ch0 == 125 then 1 else 0;
    let stop = if is_rb + at_end >= 1 then 1 else 0;
    let aname = read_ident(s, pos);
    let _ = skip_ws(s, pos);
    let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_lp2 = if ch2 == 40 then 1 else 0;
    let vpos = if is_lp2 == 1 then (let _ = pos[0] = pos[0] + 1 in pos[0]) else 0;
    let vname = if is_lp2 == 1 then read_ident(s, pos) else 0;
    let _ = if is_lp2 == 1 then (let _ = skip_ws(s, pos) in (let _ = pos[0] = pos[0] + 1 in 0)) else 0;
    let _ = skip_ws(s, pos);
    let adv = if stop == 1 then is_rb else 2;
    let _ = pos[0] = pos[0] + adv;
    let bodypos = pos[0];
    let _ = if stop == 0 then skip_to_field_delim(s, pos) else 0;
    let is_match = if aname == cname then 1 else 0;
    let has_var = is_lp * is_lp2;
    let _ = if is_match == 1 then emit_match_arm(s, ppos[0], has_var, vname, vpos, bodypos, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let ch3 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch3 == 44 then 1 - stop else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let done = stop;
    0
  };
  let _ = fold_clear(fntab);
  n[0]
}

// Skip a "//" line comment: advance pos to the newline (or end). pos is at '/'.
fn skip_line_comment(s: str, pos: [i64]) -> i64 {
  let strn = str_len(s);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_nl = if ch == 10 then 1 else 0;
    let adv = 1 - is_nl - at_end;
    let _ = pos[0] = pos[0] + adv;
    let done = if is_nl + at_end >= 1 then 1 else 0;
    0
  };
  0
}

// Skip a "..." string literal: pos is at the opening '"', leave it after the
// closing '"'.
fn skip_string(s: str, pos: [i64]) -> i64 {
  let strn = str_len(s);
  let _ = pos[0] = pos[0] + 1;
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_q = if ch == 34 then 1 else 0;
    let adv = 1 - is_q - at_end;
    let _ = pos[0] = pos[0] + adv;
    let done = if is_q + at_end >= 1 then 1 else 0;
    0
  };
  let _ = pos[0] = pos[0] + 1;
  0
}

fn skip_ws(s: str, pos: [i64]) -> i64 {
  let n = str_len(s);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= n then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_sp = if ch == 32 then 1 else 0;
    let is_tab = if ch == 9 then 1 else 0;
    let is_nl = if ch == 10 then 1 else 0;
    let is_cr = if ch == 13 then 1 else 0;
    let is_ws = is_sp + is_tab + is_nl + is_cr;
    let _ = pos[0] = pos[0] + is_ws;
    let at_end2 = if pos[0] >= n then 1 else 0;
    let e1 = if pos[0] + 1 >= n then 1 else 0;
    let ch0 = if at_end2 == 1 then 0 else char(s, pos[0]);
    let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
    let is_sl = if ch0 == 47 then 1 else 0;
    let is_sl2 = if ch1 == 47 then 1 else 0;
    let is_comment = is_sl * is_sl2;
    let _ = if is_comment == 1 then skip_line_comment(s, pos) else 0;
    let done = if is_ws + is_comment >= 1 then 0 else 1;
    0
  };
  0
}

// Append one instruction word and advance the count.
fn em(insns: [i64], n: [i64], w: i64) -> i64 {
  let _ = insns[n[0]] = w;
  let _ = n[0] = n[0] + 1;
  n[0]
}

// Push x0 (sub sp,#16 ; str x0,[sp]). R6.1 model: depth at fntab[3700],
// slot tag d+11 at 3701+d (guarded d<96). NO traps and NO stream side
// effects: the legacy emitter legitimately leaks +1 depth per unresolved
// call site (okres==0 dummy push) and big array literals reach depth ~99+
// transiently - checks/caps on that turned a benign leak into a stream
// pollution cascade (journal 1788288246). Bookkeeping only.
fn push(insns: [i64], n: [i64], fntab: [i64]) -> i64 {
  let d = fntab[3700];
  let wsl = if d < 96 then (if d >= 0 then 1 else 0) else 0;
  let _ = if wsl == 1 then (let _ = fntab[3701 + d] = d + 11 in 0) else 0;
  let _ = fntab[3700] = d + 1;
  let _ = fold_clear(fntab);
  let _ = em(insns, n, 3506455551);
  let _ = em(insns, n, 4177527776);
  n[0]
}

// Pop into x<rd> (ldr x<rd>,[sp] ; add sp,#16). R6.1 model bookkeeping
// only (depth at fntab[3700]); see push for why traps were removed.
// T96 step 1 (2026-09-04, D2): when the two words just emitted are exactly a
// push (sub sp,#16 ; str x0,[sp]) and no branch target was placed at the
// current position (fntab[3660] = last label, recorded by emit_cond and
// emit_while_stmt), the value is still in x0: retract the push and emit
// `mov x<rd>, x0` (nothing for rd == 0). L16 bans EXTRA words, not fewer;
// the retraction is stream-contiguous like fold_try's.
fn pop(insns: [i64], n: [i64], rd: i64, fntab: [i64]) -> i64 {
  let d = fntab[3700];
  let dm1 = if d > 0 then d - 1 else 0;
  let _ = fntab[3700] = dm1;
  let _ = fold_clear(fntab);
  let cur = n[0];
  let i2 = if cur >= 2 then cur - 2 else 0;
  let adj = (if cur >= 2 then 1 else 0) * (if insns[i2] == 3506455551 then 1 else 0) * (if insns[i2 + 1] == 4177527776 then 1 else 0) * (if fntab[3660] == cur then 0 else 1);
  let _ = if adj == 1 then (let _ = n[0] = i2 in 0) else 0;
  // rd == 0 retracts with NO word: x0 now holds the retracted value while the
  // stream may end with an OLDER push (push a; push b; pop 0; pop 1) -- that
  // older value is NOT in x0, so bar the position exactly like a label.
  let bar = adj * (if rd == 0 then 1 else 0);
  let _ = if bar == 1 then (let _ = fntab[3660] = i2 in 0) else 0;
  let _ = if adj * rd > 0 then (let _ = em(insns, n, 2852127712 + rd) in 0) else 0;
  let _ = if adj == 0 then (let _ = em(insns, n, 4181722080 + rd) in 0) else 0;
  let _ = if adj == 0 then (let _ = em(insns, n, 2432713727) in 0) else 0;
  n[0]
}

// S3: flush register window to stack before a bl (call site).
// Saves x9..x(9+rep-1) to stack, resets rep=-1. No-op when rep==0 (all-memory).
fn flush_on_bl(insns: [i64], n: [i64], fntab: [i64], rep: i64) -> i64 {
  let do_flush = if rep > 0 then 1 else 0;
  let _ = if do_flush == 1 then (let _ = fntab[3890] = 0 - 1 in 0) else 0;
  let _ = if do_flush == 1 then str_reg(insns, n, 0, rep) else 0;
  n[0]
}

fn str_reg(insns: [i64], n: [i64], i: i64, rep: i64) -> i64 {
  let done = if i >= rep then 1 else 0;
  let _ = if done == 0 then (let _ = em(insns, n, 4177527776 + (9 + i) + i * 8192) in 0) else 0;
  let _ = if done == 0 then (let _ = str_reg(insns, n, i + 1, rep) in 0) else 0;
  n[0]
}

// S3: pop_back after bl — restores flushed registers from stack. No-op when rep==0.
fn pop_back(insns: [i64], n: [i64], fntab: [i64], rep: i64) -> i64 {
  let do_restore = if rep > 0 then 1 else 0;
  let total = rep * 8 + 32;  // flush space + bl frame (16, T103) + push space (16); dead: rep is 0 since 4e6a1d6
  let _ = if do_restore == 1 then (let _ = em(insns, n, 2432713727 + (total - 16) * 1024) in 0) else 0;
  let _ = if do_restore == 1 then ldr_reg(insns, n, 0, rep) else 0;
  let _ = if do_restore == 1 then (let _ = fntab[3890] = rep in 0) else 0;
  n[0]
}

fn ldr_reg(insns: [i64], n: [i64], i: i64, rep: i64) -> i64 {
  let done = if i >= rep then 1 else 0;
  let _ = if done == 0 then (let _ = em(insns, n, 4181722080 + (9 + i) + i * 8192) in 0) else 0;
  let _ = if done == 0 then (let _ = ldr_reg(insns, n, i + 1, rep) in 0) else 0;
  n[0]
}

// Emit one movk half-slice for hw>=1 if non-zero. Negative immediates
// (source literals above 2^63 wrap on i64) must be normalized per half so
// the FULL 64-bit pattern materializes -- otherwise big builtin-hash
// constants compile to a bare 16-bit slice and every dispatch compare fails.
fn emit_half(insns: [i64], n: [i64], imm: i64, hw: i64, fntab: [i64]) -> i64 {
  let p = [1, 65536, 4294967296, 281474976710656, 18446744073709551616];
  let hi = imm / p[hw + 1];
  let lo = imm - hi * p[hw + 1];
  let lo2 = if lo < 0 then lo + p[hw + 1] else lo;
  let slraw = lo2 / p[hw];
  // hw==3: p[4] wraps to 0 (2^64) so lo2 stays negative for wrapped
  // literals; recover the exact top slice from the floored quotient
  let hi3 = imm / p[3];
  let r3 = imm - hi3 * p[3];
  let adj3 = if r3 == 0 then 0 else 1;
  let sl3 = if imm < 0 then hi3 + 65536 - adj3 else hi3;
  let ishw3 = if hw == 3 then 1 else 0;
  let sl = ishw3 * sl3 + (1 - ishw3) * slraw;
  let _ = if sl > 0 then (let _ = em(insns, n, 4068474880 + sl * 32 + hw * 2097152) in 0) else 0;
  n[0]
}

// Emit a literal (movz x0,#imm16 ; movk for higher halves ; push).
// Mirrors native.c emit_mov64: hw=0 always movz, hw=1..3 movk only if
// that 16-bit slice is non-zero. Without the movk halves any constant
// above 65535 was silently truncated (loop bounds > 64K hung/wrong).
fn emit_lit(insns: [i64], n: [i64], imm: i64, fntab: [i64]) -> i64 {
  let imm16 = imm - (imm / 65536) * 65536;
  let imm16u = if imm16 < 0 then imm16 + 65536 else imm16;
  let nb = n[0];
  // capture the model BEFORE the push: push clears the depth (unknown
  // value), and this literal re-records with the pre-push state shifted
  // down one slot (top -> second)
  let d0 = fntab[3655];
  let t0 = fntab[3656];
  let c0 = fntab[3657];
  let _ = em(insns, n, 3531603968 + imm16u * 32);
  let _ = emit_half(insns, n, imm, 1, fntab);
  let _ = emit_half(insns, n, imm, 2, fntab);
  let _ = emit_half(insns, n, imm, 3, fntab);
  let _ = push(insns, n, fntab);
  let cnt = n[0] - nb;
  let _ = fntab[3658] = t0;
  let _ = fntab[3659] = c0;
  let _ = fntab[3656] = imm;
  let _ = fntab[3657] = cnt;
  let _ = fntab[3655] = if d0 > 0 then 2 else 1;
  n[0]
}

// ---- R6.2 v5 constant folding: fixed-cell model (hard addressing) ----
// The fold model is FIVE FIXED CELLS with NO dynamic indexing and NO
// depth arithmetic (the v1-v3 failure mode, journal 1788285630, was the
// layout-sensitive dynamic-slot read):
//   fntab[3655] = const depth (0/1/2): the top N value-stack entries are
//                 literals recorded in the cells below
//   fntab[3656] = top value,     fntab[3657] = top word count
//   fntab[3658] = second value,  fntab[3659] = second word count
// push() and pop() clear the depth (unknown values on the stack);
// emit_lit records its literal after pushing; emit_cond/emit_match clear
// (their runtime value depends on the condition); fold_try consumes the
// two entries when depth==2. The depth cap at 2 only loses folding
// OPPORTUNITIES on deeper chains, never correctness.
fn fold_clear(fntab: [i64]) -> i64 {
  let _ = fntab[3655] = 0;
  fntab[3655]
}

// Try folding an add/sub/mul. Two cases, both model-driven and
// stream-contiguous by construction:
//  1. both-const (depth==2): the two literal chunks are retracted and one
//     folded literal is emitted;
//  2. right-const imm12 (depth==1, top const in [0,4095], op add/sub):
//     the literal chunk is retracted, a -> x0 via pop, add/sub x0,#imm,
//     push (the i+1 increment win: 5 words instead of 10).
// Returns 1 if folded, 0 otherwise (caller takes the legacy path).
fn fold_try(insns: [i64], n: [i64], fntab: [i64], op: i64) -> i64 {
  let d = fntab[3655];
  let opok = (if op == 2 then 1 else 0) + (if op == 3 then 1 else 0) + (if op == 4 then 1 else 0);
  let isb = (if d == 2 then 1 else 0) * opok;
  let vA = fntab[3658];
  let vB = fntab[3656];
  let cnt = fntab[3657] + fntab[3659];
  let vfold = (if op == 2 then 1 else 0) * (vA + vB) + (if op == 3 then 1 else 0) * (vA - vB) + (if op == 4 then 1 else 0) * (vA * vB);
  let _ = if isb == 1 then (let _ = n[0] = n[0] - cnt in 0) else 0;
  let _ = if isb == 1 then (let _ = fold_clear(fntab) in 0) else 0;
  let _ = if isb == 1 then (let _ = emit_lit(insns, n, vfold, fntab) in 0) else 0;
  // right-const imm12 path (only fires when the both-const fold did not)
  let vTop = fntab[3656];
  let cTop = fntab[3657];
  let ir = (if vTop >= 0 then 1 else 0) * (if vTop < 4096 then 1 else 0);
  let iadd = (if op == 2 then 1 else 0) + (if op == 3 then 1 else 0);
  let isi = (if d == 1 then 1 else 0) * ir * iadd;
  let wimm = (if op == 2 then 1 else 0) * (2432696320 + vTop * 1024) + (if op == 3 then 1 else 0) * (3506438144 + vTop * 1024);
  let _ = if isi == 1 then (let _ = n[0] = n[0] - cTop in 0) else 0;
  let _ = if isi == 1 then (let _ = pop(insns, n, 0, fntab) in 0) else 0;
  let _ = if isi == 1 then (let _ = em(insns, n, wimm) in 0) else 0;
  let _ = if isi == 1 then (let _ = push(insns, n, fntab) in 0) else 0;
  isb + isi
}

// T96 step 2 (2026-09-04, D2): bring the two operands of a binop/cmp into
// x0 (left) and x1 (right). When the stream ends with exactly
//   push(a) ; P ; push(b)        P = one word that loads x0 from a register
//                                (mov x0,xR), a spill slot (ldr x0,[x15,#k])
//                                or a 16-bit literal (movz x0,#imm)
// and no label/barrier sits inside (fntab[3660] < n-4), the three chunks are
// retracted and P is re-emitted with rd = x1: x0 still holds a, x1 gets b,
// zero memory traffic. Otherwise the canonical pops (which may still elide
// the last push, step 1).
fn pop2(insns: [i64], n: [i64], fntab: [i64]) -> i64 {
  let cur = n[0];
  let ok5 = if cur >= 5 then 1 else 0;
  let b0 = if ok5 == 1 then cur - 5 else 0;
  let w = insns[b0 + 2];
  let is_movr = if (w & 4292935679) == 2852127712 then 1 else 0;
  let is_ldr15 = if (w & 4290774015) == 4181721568 then 1 else 0;
  let is_movz = if (w & 4292870175) == 3531603968 then 1 else 0;
  let is_p = is_movr + is_ldr15 + is_movz;
  let pa = (if insns[b0] == 3506455551 then 1 else 0) * (if insns[b0 + 1] == 4177527776 then 1 else 0);
  let pb = (if insns[b0 + 3] == 3506455551 then 1 else 0) * (if insns[b0 + 4] == 4177527776 then 1 else 0);
  let nolab = if fntab[3660] < b0 + 1 then 1 else 0;
  let hit = ok5 * pa * pb * is_p * nolab;
  let d = fntab[3700];
  let dm2 = if d > 1 then d - 2 else 0;
  let _ = if hit == 1 then (let _ = fntab[3700] = dm2 in 0) else 0;
  let _ = if hit == 1 then (let _ = fold_clear(fntab) in 0) else 0;
  let _ = if hit == 1 then (let _ = n[0] = b0 in 0) else 0;
  let _ = if hit == 1 then (let _ = em(insns, n, w + 1) in 0) else 0;
  let _ = if hit == 0 then (let _ = pop(insns, n, 1, fntab) in 0) else 0;
  let _ = if hit == 0 then (let _ = pop(insns, n, 0, fntab) in 0) else 0;
  n[0]
}

// ---- T101 (2026-09-05, D11-G fallback: x0/x1 only, no IR): the left operand
// of a binop/cmp is one word P (mov x0,xR / ldr x0,[x15,#k] / movz x0,#imm)
// sitting under its push when the right operand starts. If the right operand
// R (a) is longer than one producer + push (else pop2 already handles it),
// (b) contains no label (fntab[3660] < L) and (c) never writes P's register or
// spill slot (mov xR,x0 / str x0,[x15,#k]), then R is slid down over [P][push]
// and the pair becomes `mov x1,x0 ; P ; op` -- the stack round trip of the
// left operand disappears (K4 loop: 24 -> 20 words). Positions inside R are
// PC-relative only (expressions hold no statements), so the slide is exact.
fn left_single_begin(insns: [i64], n: [i64], fntab: [i64]) -> i64 {
  let cur = n[0];
  let ok3 = if cur >= 3 then 1 else 0;
  let L = if ok3 == 1 then cur - 3 else 0;
  let w = insns[L];
  let is_movr = if (w & 4292935679) == 2852127712 then 1 else 0;
  let is_ldr15 = if (w & 4290774015) == 4181721568 then 1 else 0;
  let is_movz = if (w & 4292870175) == 3531603968 then 1 else 0;
  let pa = (if insns[L + 1] == 3506455551 then 1 else 0) * (if insns[L + 2] == 4177527776 then 1 else 0);
  let nolab = if fntab[3660] < L then 1 else 0;
  let hit = ok3 * (is_movr + is_ldr15 + is_movz) * pa * nolab;
  if hit == 1 then L else 0 - 1
}

// 1 when the words [a,b) write register/slot of the producer P (hazard).
fn writes_producer(insns: [i64], a: i64, b: i64, p: i64) -> i64 {
  let is_movr = if (p & 4292935679) == 2852127712 then 1 else 0;
  let is_ldr15 = if (p & 4290774015) == 4181721568 then 1 else 0;
  let reg = (p >> 16) & 31;
  let slot = (p >> 10) & 4095;
  let movw = 2852127712 + reg;
  let strw = 4177527264 + slot * 1024;
  let i = a;
  let hz = 0;
  while i < b {
    let w = insns[i];
    let hz = hz + is_movr * (if w == movw then 1 else 0) + is_ldr15 * (if w == strw then 1 else 0);
    let i = i + 1;
    0
  };
  if hz > 0 then 1 else 0
}

// Count words in [a,b) with (w & mask) == pat.
fn count_masked(insns: [i64], a: i64, b: i64, mask: i64, pat: i64) -> i64 {
  let i = a;
  let c = 0;
  while i < b {
    let c = c + (if (insns[i] & mask) == pat then 1 else 0);
    let i = i + 1;
    0
  };
  c
}

// After R was emitted (it ends with a push): perform the slide when legal.
// Returns 1 when the operands are now x0 = left, x1 = right (no pops needed).
fn left_single_finish(insns: [i64], n: [i64], fntab: [i64], L: i64) -> i64 {
  let cur = n[0];
  let rlen = cur - (L + 3) - 2;
  let p = insns[L];
  let long = if rlen > 1 then 1 else 0;
  let nolab = if fntab[3660] < L then 1 else 0;
  let endpush = (if insns[cur - 2] == 3506455551 then 1 else 0) * (if insns[cur - 1] == 4177527776 then 1 else 0);
  // PC-relative words inside R that target OUTSIDE R move with the slide:
  // `bl` (0x94000000) gets its imm26 bumped by 3; an `adr` (string literal
  // address, 0x10000000 family) refuses the slide (rare, not worth re-encoding).
  let has_adr = count_masked(insns, L + 3, cur - 2, 2667577344, 268435456);
  let go = (if L >= 0 then 1 else 0) * long * nolab * endpush * (1 - writes_producer(insns, L + 3, cur - 2, p)) * (if has_adr > 0 then 0 else 1);
  let i = 0;
  while i < rlen * go {
    let w = insns[L + 3 + i];
    let is_bl = if (w & 4227858432) == 2483027968 then 1 else 0;
    let _ = insns[L + i] = w + is_bl * 3;
    let i = i + 1;
    0
  };
  let _ = if go == 1 then (let _ = n[0] = L + rlen in 0) else 0;
  let _ = if go == 1 then (let _ = em(insns, n, 2852127713) in 0) else 0;
  let _ = if go == 1 then (let _ = em(insns, n, p) in 0) else 0;
  let d = fntab[3700];
  let _ = if go == 1 then (let _ = fntab[3700] = (if d > 1 then d - 2 else 0) in 0) else 0;
  let _ = if go == 1 then fold_clear(fntab) else 0;
  go
}

// Emit a binary op (2=add 3=sub 4=mul 5=div): pop b->x1, pop a->x0, op, push.
// R6.2 v4: const-const add/sub/mul fold via fold_try (stream decode);
// the legacy body lives in emit_binop_plain, dispatched at ONE level.
fn emit_binop(insns: [i64], n: [i64], op: i64, fntab: [i64]) -> i64 {
  let didf = fold_try(insns, n, fntab, op);
  let _ = if didf == 0 then (let _ = emit_binop_plain(insns, n, op, fntab) in 0) else 0;
  n[0]
}

// The legacy stack-machine binary op (see emit_binop).
fn emit_binop_plain(insns: [i64], n: [i64], op: i64, fntab: [i64]) -> i64 {
  let _ = pop2(insns, n, fntab);
  emit_binop_regs(insns, n, op, fntab)
}

// T104 (2026-09-05): multiply-add fusion. `xB + xA * c` (after the T101 slide)
// arrives as [mov x0,xA][mov x1,#c][mul x0,x0,x1][mov x1,x0][mov x0,xB] + add:
// the five words become [mov x1,#c][madd x0,xA,x1,xB] (0x9B010000 | B<<10 |
// A<<5; as+objdump). Same for xA * c + xB (the mul is the left, the var the
// right: [mov x0,xA][mov x1,#c][mul][mov x1,xB] + add -> [mov x1,#c][mov x2,xB]
// ... not done; only the slid form). Returns 1 when fused (the op is emitted).
fn madd_try(insns: [i64], n: [i64], op: i64, fntab: [i64]) -> i64 {
  let cur = n[0];
  let ok = if cur >= 5 then 1 else 0;
  let b0 = if ok == 1 then cur - 5 else 0;
  let w0 = insns[b0];
  let w1 = insns[b0 + 1];
  let w2 = insns[b0 + 2];
  let w3 = insns[b0 + 3];
  let w4 = insns[b0 + 4];
  let is_mova = if (w0 & 4292935679) == 2852127712 then 1 else 0;
  let is_movc = if (w1 & 4292870175) == 3531603969 then 1 else 0;
  let is_mul = if w2 == 2600565760 then 1 else 0;
  let is_mov10 = if w3 == 2852127713 then 1 else 0;
  let is_movb = if (w4 & 4292935679) == 2852127712 then 1 else 0;
  let nolab = if fntab[3660] < b0 then 1 else 0;
  let hit = ok * (if op == 2 then 1 else 0) * is_mova * is_movc * is_mul * is_mov10 * is_movb * nolab;
  let ra = (w0 >> 16) & 31;
  let rb = (w4 >> 16) & 31;
  let _ = if hit == 1 then (let _ = n[0] = b0 in 0) else 0;
  let _ = if hit == 1 then (let _ = em(insns, n, w1) in 0) else 0;
  let _ = if hit == 1 then (let _ = em(insns, n, 2600534016 + rb * 1024 + ra * 32) in 0) else 0;
  let _ = if hit == 1 then (let _ = push(insns, n, fntab) in 0) else 0;
  hit
}

// The op word(s) + push with x0 = left, x1 = right already in place.
fn emit_binop_regs(insns: [i64], n: [i64], op: i64, fntab: [i64]) -> i64 {
  let fused = madd_try(insns, n, op, fntab);
  if fused == 1 then n[0] else emit_binop_regs_plain(insns, n, op, fntab)
}

fn emit_binop_regs_plain(insns: [i64], n: [i64], op: i64, fntab: [i64]) -> i64 {
  let wadd = if op == 2 then 2332098560 else 0;
  let wsub = if op == 3 then 3405840384 else 0;
  let wmul = if op == 4 then 2600565760 else 0;
  let wdiv = if op == 5 then 2596342784 else 0;
  // bitwise tier (legacy stack machine): and/orr/eor/lslv/lsrv x0,x0,x1
  let wand = if op == 12 then 2315321344 else 0;
  let worr = if op == 13 then 2852192256 else 0;
  let weor = if op == 14 then 3389063168 else 0;
  let wshl = if op == 15 then 2596347904 else 0;
  let wshr = if op == 16 then 2596348928 else 0;
  // asrv x0,x0,x1 = 0x9AC12800 (lsrv 0x9AC12400 + 0x400; as+objdump)
  let wasr = if op == 17 then 2596349952 else 0;
  // modulo (op 11): a % b via mov x2,x0; sdiv x0,x0,x1; msub x0,x0,x1,x2
  let is_md = if op == 11 then 1 else 0;
  let _ = if is_md == 1 then (let _ = em(insns, n, 2852127714) in (let _ = em(insns, n, 2596342784) in (let _ = em(insns, n, 2600568832) in 0))) else 0;
  let _ = if is_md == 0 then (let _ = em(insns, n, wadd + wsub + wmul + wdiv + wand + worr + weor + wshl + wshr + wasr) in 0) else 0;
  let _ = push(insns, n, fntab);
  n[0]
}

// Emit a variable load: mov x0, x<reg> (register) or ldr x0,[x15,#slot*8]
// (spilled); push.
fn emit_var(insns: [i64], n: [i64], reg: i64, fntab: [i64]) -> i64 {
  let is_neg = if reg < 0 then 1 else 0;
  let is_spill = if reg >= 100 then 1 else 0;
  let slot = reg - 100;
  let movw = 2852127712 + reg * 65536;
  // ldr x0,[x15,#slot*8] : 0xF9400000 | imm12(slot)<<10 | Rn(x15)<<5
  // (0xF9400000 = 4181721088; +480 = Rn field for x15)
  let ldrw = 4181721568 + slot * 1024;
  // -2 (table full) traps loudly; -1 (unbound) keeps the legacy xzr load
  // (established checksums bless it: unresolved calls read xzr)
  let trapw = 3558866944;
  let zerow = 2852127712;
  let bad_full = if reg == 0 - 2 then 1 else 0;
  let unk = if reg == 0 - 1 then 1 else 0;
  let w = trapw * bad_full + (zerow * unk + (movw * (1 - is_spill) + ldrw * is_spill) * (1 - is_neg)) * (1 - bad_full);
  let _ = em(insns, n, w);
  let _ = push(insns, n, fntab);
  n[0]
}

// Bind a register/spill slot to the value in x0: mov x<reg>, x0 (register) or
// str x0, [x15, #slot*8] (spilled).
fn bind_reg(insns: [i64], n: [i64], reg: i64) -> i64 {
  let is_neg = if reg < 0 then 1 else 0;
  let is_spill = if reg >= 100 then 1 else 0;
  let slot = reg - 100;
  let movw = 2852127712 + reg;
  let strw = 4177527264 + slot * 1024;
  // table-full (-2) or unbound (-1): loud trap instead of a garbage mov
  let trapw = 3558866944;
  let w = trapw * is_neg + (movw * (1 - is_spill) + strw * is_spill) * (1 - is_neg);
  let _ = em(insns, n, w);
  n[0]
}

// Read digits, emit their literal; returns the parsed value.
// hex_val: digit value of ch in base 16 (0-9, a-f, A-F), -1 otherwise.
fn hex_val(ch: i64) -> i64 {
  let d = if is_digit(ch) == 1 then ch - 48 else 0 - 1;
  let lo = (if ch >= 97 then 1 else 0) * (if ch <= 102 then 1 else 0);
  let up = (if ch >= 65 then 1 else 0) * (if ch <= 70 then 1 else 0);
  let d = if lo == 1 then ch - 87 else d;
  let d = if up == 1 then ch - 55 else d;
  d
}

// T99 (2026-09-04): `0x..` hex literals are a literal FORM (base 16 in the
// same digit loop), not sugar; bpref.py mirrors the token.
fn read_num_val(s: str, pos: [i64]) -> i64 {
  let strn = str_len(s);
  let ch0 = if pos[0] >= strn then 0 else char(s, pos[0]);
  let ch1 = if pos[0] + 1 >= strn then 0 else char(s, pos[0] + 1);
  let is_hex = (if ch0 == 48 then 1 else 0) * (if ch1 == 120 then 1 else 0);
  let base = if is_hex == 1 then 16 else 10;
  let _ = pos[0] = pos[0] + 2 * is_hex;
  let v = 0;
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let hv = if at_end == 1 then 0 - 1 else hex_val(ch);
    let dg = (if hv >= 0 then 1 else 0) * (if hv < base then 1 else 0);
    let v = if dg == 1 then (v * base) + hv else v;
    let adv = if dg == 1 then 1 else 0;
    let _ = pos[0] = pos[0] + adv;
    let done = if dg == 1 then 0 else 1;
    0
  };
  v
}

fn emit_num(s: str, pos: [i64], insns: [i64], n: [i64], fntab: [i64]) -> i64 {
  let v = read_num_val(s, pos);
  let _ = emit_lit(insns, n, v, fntab);
  n[0]
}

// Consume one (+ or -) term, then fold (branchless helper).
fn emit_apply_op(s: str, pos: [i64], insns: [i64], n: [i64], is_minus: i64, stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let L = left_single_begin(insns, n, fntab);
  let _ = emit_term(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let op = if is_minus == 1 then 3 else 2;
  let slid = left_single_finish(insns, n, fntab, L);
  let _ = if slid == 1 then emit_binop_regs(insns, n, op, fntab) else emit_binop(insns, n, op, fntab);
  n[0]
}

// Consume one (* or /) factor, then fold (branchless helper).
// R3.x(a) FIX: the right operand must parse at the BITLVL tier (factor plus
// &,|,^,<<,>> chains), not a bare factor — a bare factor left `<<c` dangling
// in `a*b<<c` and the detached tokens miscompiled to 0/1 garbage (journal
// 1788288190). With bitlvl (which binds tighter than mul by design) the
// expression is well-formed: a*b<<c == a*(b<<c).
fn emit_apply_mul(s: str, pos: [i64], insns: [i64], n: [i64], is_div: i64, stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let L = left_single_begin(insns, n, fntab);
  let _ = emit_factor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let op = if is_div == 1 then 5 else 4;
  let slid = left_single_finish(insns, n, fntab, L);
  let _ = if slid == 1 then emit_binop_regs(insns, n, op, fntab) else emit_binop(insns, n, op, fntab);
  n[0]
}

// Apply a modulo step (a % b): same shape as mul/div; binop opcode 11.
// R3.x(a) FIX: bitlvl-tier right operand, same reasoning as mul/div.
fn emit_apply_mod(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let L = left_single_begin(insns, n, fntab);
  let _ = emit_factor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let slid = left_single_finish(insns, n, fntab, L);
  let _ = if slid == 1 then emit_binop_regs(insns, n, 11, fntab) else emit_binop(insns, n, 11, fntab);
  n[0]
}

// Emit a comparison (cond: eq=1 ne=0 lt=10 gt=13 le=12 ge=11): pop b->x1,
// pop a->x0, cmp x0,x1, cset x0,<cond>, push.
fn emit_cmp_op(insns: [i64], n: [i64], cond: i64, fntab: [i64]) -> i64 {
  let _ = pop2(insns, n, fntab);
  emit_cmp_regs(insns, n, cond, fntab)
}

fn emit_cmp_regs(insns: [i64], n: [i64], cond: i64, fntab: [i64]) -> i64 {
  let _ = em(insns, n, 3942711327);
  let _ = em(insns, n, 2594113504 + cond * 4096);
  let _ = push(insns, n, fntab);
  n[0]
}

// Apply a bitwise operator (op: and=12 orr=13 eor=14 shl=15 shr=16) between
// the value already on the stack and the next factor. Shifts are two-char
// tokens (adv=2), the rest one char.
fn emit_apply_bits(s: str, pos: [i64], insns: [i64], n: [i64], op: i64, adv: i64, lvl: i64, stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + adv;
  let L = left_single_begin(insns, n, fntab);
  // right operand = the next-tighter tier: lvl 3 (`|`) -> bxor, 2 (`^`) -> band,
  // 1 (`&`) -> shift, 0 (`<<` `>>`) -> expr
  let _ = if lvl == 3 then emit_bxor(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if lvl == 2 then emit_band(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if lvl == 1 then emit_shift(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else emit_expr(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let slid = left_single_finish(insns, n, fntab, L);
  let _ = if slid == 1 then emit_binop_regs(insns, n, op, fntab) else emit_binop(insns, n, op, fntab);
  n[0]
}

// T42(a) 2026-09-04 (decision D5, measured zero fold delta on 85/85 gates):
// C precedence for the bit tier.  cmp > `|` > `^` > `&` > `<<` `>>` > + - > * / %
// bor = bxor ('|' bxor)*
fn emit_bor(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_bxor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = str_len(s);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let isop = if ch == 124 then 1 else 0;
    let _ = if isop == 1 then emit_apply_bits(s, pos, insns, n, 13, 1, 3, stab, selfname, selfstart, fntab) else 0;
    let done = 1 - isop;
    0
  };
  0
}

// bxor = band ('^' band)*
fn emit_bxor(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_band(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = str_len(s);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let isop = if ch == 94 then 1 else 0;
    let _ = if isop == 1 then emit_apply_bits(s, pos, insns, n, 14, 1, 2, stab, selfname, selfstart, fntab) else 0;
    let done = 1 - isop;
    0
  };
  0
}

// band = shift ('&' shift)*
fn emit_band(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_shift(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = str_len(s);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let isop = if ch == 38 then 1 else 0;
    let _ = if isop == 1 then emit_apply_bits(s, pos, insns, n, 12, 1, 1, stab, selfname, selfstart, fntab) else 0;
    let done = 1 - isop;
    0
  };
  0
}

// shift = expr (('<<'|'>>'|'>>>') expr)*   `>>` is LOGICAL (lsrv), `>>>` is
// ARITHMETIC (asrv) — decision D9(5) 2026-09-04: R3.x(b) is documented
// semantics, not a ban; bpref.py mirrors both; gate c32_asr.
fn emit_shift(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_expr(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = str_len(s);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let nch = if pos[0] + 1 >= strn then 0 else char(s, pos[0] + 1);
    let nch2 = if pos[0] + 2 >= strn then 0 else char(s, pos[0] + 2);
    let isshl = (if ch == 60 then 1 else 0) * (if nch == 60 then 1 else 0);
    let isshr2 = (if ch == 62 then 1 else 0) * (if nch == 62 then 1 else 0);
    let isasr = isshr2 * (if nch2 == 62 then 1 else 0);
    let isshr = isshr2 - isasr;
    let isop = isshl + isshr + isasr;
    let op = isshl * 15 + isshr * 16 + isasr * 17;
    let adv = 2 + isasr;
    let _ = if isop == 1 then emit_apply_bits(s, pos, insns, n, op, adv, 0, stab, selfname, selfstart, fntab) else 0;
    let done = 1 - isop;
    0
  };
  0
}

// Consume one comparison operator + right operand, then fold (branchless).
fn emit_apply_cmp(s: str, pos: [i64], insns: [i64], n: [i64], cond: i64, adv: i64, stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + adv;
  let L = left_single_begin(insns, n, fntab);
  let _ = emit_bor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let slid = left_single_finish(insns, n, fntab, L);
  let _ = if slid == 1 then emit_cmp_regs(insns, n, cond, fntab) else emit_cmp_op(insns, n, cond, fntab);
  n[0]
}

// cmp = bor (('=='|'!='|'<'|'>'|'<='|'>=') bor)*
fn emit_cmp(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_bor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = str_len(s);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let e1 = if pos[0] + 1 >= strn then 1 else 0;
    let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
    let is_eq = if ch == 61 then 1 else 0;
    let is_bang = if ch == 33 then 1 else 0;
    let is_lt = if ch == 60 then 1 else 0;
    let is_gt = if ch == 62 then 1 else 0;
    let is_e2 = if ch1 == 61 then 1 else 0;
    let is_eqop = is_eq * is_e2;
    let is_neop = is_bang * is_e2;
    let not_e2 = 1 - is_e2;
    let is_ltop = is_lt * not_e2;
    let is_gtop = is_gt * not_e2;
    let is_leop = is_lt * is_e2;
    let is_geop = is_gt * is_e2;
    let is_op = is_eqop + is_neop + is_ltop + is_gtop + is_leop + is_geop;
    let cond = is_eqop + is_ltop * 10 + is_gtop * 13 + is_leop * 12 + is_geop * 11;
    let avv = 1 + is_eqop + is_neop + is_leop + is_geop;
    let _ = if is_op == 1 then emit_apply_cmp(s, pos, insns, n, cond, avv, stab, selfname, selfstart, fntab) else 0;
    let done = if is_op == 1 then 0 else 1;
    0
  };
  0
}

// expr = term ((+|-) term)*
fn emit_expr(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_term(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = str_len(s);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_plus = if ch == 43 then 1 else 0;
    let is_minus = if ch == 45 then 1 else 0;
    // T42(d) 2026-09-04: `++` (string concat) is NOT in the surface and there
    // is no third state -- it used to compile silently to a crashing binary;
    // now the compiler exits 96 (see the exit-code table at emit_paren).
    let e1 = if pos[0] + 1 >= strn then 1 else 0;
    let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
    let is_pp = is_plus * (if ch1 == 43 then 1 else 0);
    let _ = if is_pp == 1 then sys_exit(96) else 0;
    let is_op = is_plus + is_minus;
    let _ = if is_op == 1 then emit_apply_op(s, pos, insns, n, is_minus, stab, selfname, selfstart, fntab) else 0;
    let done = if is_op == 1 then 0 else 1;
    0
  };
  0
}

// term = factor ((*|/|%) factor)*
fn emit_term(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = emit_factor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let strn = str_len(s);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_mul = if ch == 42 then 1 else 0;
    let is_div = if ch == 47 then 1 else 0;
    let is_mod = if ch == 37 then 1 else 0;
    let is_op = is_mul + is_div + is_mod;
    let _ = if is_mod == 1 then emit_apply_mod(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let _ = if is_mul + is_div == 1 then emit_apply_mul(s, pos, insns, n, is_div, stab, selfname, selfstart, fntab) else 0;
    let done = if is_op == 1 then 0 else 1;
    0
  };
  0
}

// Compile-time trap exit codes of bebop.bin (the seed loader owns 90-94:
// 90 open, 91 read, 92 mmap, 94 fail -- seed/seed.S):
//   95  expected `)` (emit_paren) or `in` (emit_let_plain / emit_let_chain)
//   96  `++` in an expression: string concat is not in the surface (T42(d))
//   97  fn body without a tail expression (compile_fn_at; DIVERGE-81/128)
//   98  more than 17 `return` / 18 pending `break` in one fn (T99 lists)
//   99  fn named like a keyword or builtin (T122)
// Runtime capacity traps (T118, exit_group from the compiled program):
//   80  arena exhausted (zeros past x28)     81  frame heap exhausted (x14 past
//   the 16 KiB frame)                         82  stack overflow (guard, T118 b)
// A trap fires before the output is opened (cli_compile), so no .bin is
// produced; bench/vs_rust/construct_parity.sh gates them as
// EXPECT=COMPILEFAIL:<code> from bench/parity_constructs/neg/.
// Consume ( expr ). T42 2026-09-04: the closing delimiter is CHECKED, not
// assumed -- a statement sequence inside parens (`( let i = 0; while ... ; r )`,
// the attic "if-while" shape) is outside the surface (`( cmp )`) and used to
// compile silently to garbage; now the compiler exits 95 (expected `)`).
fn emit_paren(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let cp = if pos[0] >= str_len(s) then 0 else char(s, pos[0]);
  let _ = if cp == 41 then 0 else sys_exit(95);
  let _ = pos[0] = pos[0] + 1;
  n[0]
}

// ---- T102 (2026-09-05): condition fusion. A `while`/`if` condition that
// ends in `cmp ... ; cset x0,<c>` (any cmp form: subs/subs-imm sets the flags)
// no longer materialises the 0/1 and re-tests it (`cmp x0,#0 ; b.eq`): the
// cset is retracted and the placeholder becomes `b.<not c>` directly -- the
// encoded field of a cset IS the inverse condition, so the placeholder word is
// 0x54000000 | (cset >> 12 & 15). The patch sites add the offset to the word
// (they used to rebuild it as b.eq). Returns the placeholder word to emit.
fn cond_branch_word(insns: [i64], n: [i64], fntab: [i64]) -> i64 {
  let cur = n[0];
  let w1 = if cur >= 1 then insns[cur - 1] else 0;
  let w2 = if cur >= 2 then insns[cur - 2] else 0;
  let is_cset = if (w1 & 4294905855) == 2594113504 then 1 else 0;
  let is_cmp = (if (w2 & 4278190111) == 3942645791 then 1 else 0) + (if (w2 & 4286578719) == 4043309087 then 1 else 0);
  // fntab[3660] == cur here is the rd=0 pop barrier just placed, not a label: a
  // jump target at cur would follow a push, never a cmp+cset pair.
  let fuse = is_cset * (if is_cmp >= 1 then 1 else 0);
  let _ = if fuse == 1 then (let _ = n[0] = cur - 1 in 0) else 0;
  // the pop barrier pointed one past the cset; move it to the new end so the
  // body's first binop may still slide its left operand (T101)
  let _ = if fuse == 1 then (let _ = fntab[3660] = cur - 1 in 0) else 0;
  let _ = if fuse == 0 then (let _ = em(insns, n, 4043309087) in 0) else 0;
  if fuse == 1 then 1409286144 + ((w1 >> 12) & 15) else 1409286144
}

// Conditional `if c then a else b`: evaluate cond into x0, `cmp x0,#0`, then a
// `b.eq` placeholder to the else arm, the then-arm, a `b` placeholder to the
// end, the else-arm; both placeholders are patched once the arm lengths are
// known. Only the taken arm executes (branches are lazy, lazy2 micro-test).
fn emit_cond(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 2;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = pop(insns, n, 0, fntab);
  let bw = cond_branch_word(insns, n, fntab);
  let p1 = n[0];
  let _ = em(insns, n, bw);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 4;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 4;
  let p2 = n[0];
  let _ = em(insns, n, 335544320);
  let else_pos = n[0];
  let _ = fntab[3660] = else_pos;
  let _ = insns[p1] = insns[p1] + (else_pos - p1) * 32;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let end_pos = n[0];
  let _ = fntab[3660] = end_pos;
  let _ = insns[p2] = 335544320 + (end_pos - p2);
  let _ = fold_clear(fntab);
  n[0]
}

// Emit `let name = value in body` (expression form): bind name to a register,
// evaluate body as the result. The statement form (`let x = v;`) is handled by
// emit_body; this handles the `in` form nested inside if/while/match branches.
// R3.x(c) FIX: the chained discard-assign `let _ = NAME = RHS in body` lowers
// to NAME <- RHS (mirroring emit_let_stmt's chain); the old code parsed only
// NAME, then skipped two chars assuming "in" — landing inside the RHS and
// silently never storing (the loop-shaped conditional-store defect, journal
// 1788288197). The array-store chain `let _ = arr[i] = v in ...` already
// worked through emit_array_index; this adds the plain-name twin via a
// separate helper (if/else dispatch on a pre-computed flag, no consumption
// before the decision).
fn emit_let_in(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 3;
  let _ = skip_ws(s, pos);
  let npos = pos[0];
  let name = read_ident(s, pos);
  let reg = sym_bind(s, stab, name, npos);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  // chain detection: ident followed by '=' (but not '=='/'=>')
  let strq = str_len(s);
  let c0 = if pos[0] >= strq then 0 else char(s, pos[0]);
  let is_id = is_alpha(c0);
  let wq = pos[0];
  let go = is_id;
  while go == 1 {
    let cc = if wq >= strq then 0 else char(s, wq);
    let ga = is_alpha(cc);
    let gd = (if cc >= 48 then 1 else 0) * (if cc <= 57 then 1 else 0);
    let gu = if cc == 95 then 1 else 0;
    let adv = ga + gd + gu;
    let wq = wq + adv;
    let go = adv;
    0
  };
  let wq2 = if wq >= strq then wq else wq + (if char(s, wq) == 32 then 1 else 0);
  let cw = if wq2 >= strq then 0 else char(s, wq2);
  let nw = if wq2 + 1 >= strq then 0 else char(s, wq2 + 1);
  let is_chain = is_id * (if cw == 61 then 1 else 0) * (if nw == 61 then 0 else 1);
  let _ = if is_chain == 1 then emit_let_chain(s, pos, insns, n, stab, selfname, selfstart, fntab) else emit_let_plain(s, pos, insns, n, stab, selfname, selfstart, fntab, reg);
  n[0]
}

// Plain `let x = RHS in body`: bind x to the RHS value.
fn emit_let_plain(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], reg: i64) -> i64 {
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let ci = if pos[0] >= str_len(s) then 0 else char(s, pos[0]);
  // `in` or `;` (T42 2026-09-04: the corpus' `(let t = e; body)` form
  // only ever worked because `; ` was skipped as if it were `in`; make it
  // a real synonym instead of trapping it -- ntt/fno regression at 3eeb007)
  let is_in = if ci == 105 then 1 else 0;
  let is_semi = if ci == 59 then 1 else 0;
  let _ = if is_in + is_semi > 0 then 0 else sys_exit(95);
  let _ = pos[0] = pos[0] + 1 + is_in;
  let _ = pop(insns, n, 0, fntab);
  let _ = bind_reg(insns, n, reg);
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  n[0]
}

// Chained `let _ = NAME = RHS in body`: NAME <- RHS, discard.
fn emit_let_chain(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let tnpos = pos[0];
  let tname = read_ident(s, pos);
  let treg = sym_lookup(s, stab, tname, tnpos);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let ci = if pos[0] >= str_len(s) then 0 else char(s, pos[0]);
  // `in` or `;` (T42 2026-09-04: the corpus' `(let t = e; body)` form
  // only ever worked because `; ` was skipped as if it were `in`; make it
  // a real synonym instead of trapping it -- ntt/fno regression at 3eeb007)
  let is_in = if ci == 105 then 1 else 0;
  let is_semi = if ci == 59 then 1 else 0;
  let _ = if is_in + is_semi > 0 then 0 else sys_exit(95);
  let _ = pos[0] = pos[0] + 1 + is_in;
  let _ = pop(insns, n, 0, fntab);
  let _ = bind_reg(insns, n, treg);
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  n[0]
}

// R3.x(d) FIX: real string-literal codegen. The literal's BYTES ride in a
// data section appended after the code words (compile_program_to lays it out
// and records per-literal data word offsets in fntab[3903+i], code length in
// fntab[3901], cursor in fntab[3902]). Emit `adr x0, #imm` with
// imm = (dw - cur)*4: the seed loader mmaps the whole .bin at the code base,
// so PC = base + cur*4 and the data cell sits at base + dw*4 — the address
// is a real pointer into the mapped image. Was: placeholder mov x0,#0 that
// segfaulted str_len/char (journal 1788288206).
fn emit_str(s: str, pos: [i64], insns: [i64], n: [i64], fntab: [i64]) -> i64 {
  let li = fntab[3902];
  let L = fntab[3901];
  let dw = fntab[3903 + li];
  let cur = n[0];
  let imm21 = dw - cur;
  let adrw = 268435456 + imm21 * 32;
  let _ = em(insns, n, adrw);
  let _ = push(insns, n, fntab);
  let _ = fntab[3902] = li + 1;
  let _ = skip_string(s, pos);
  n[0]
}

// Emit an array literal [e0, e1, ...]: evaluate the elements left to right
// (each stays on the stack), THEN mov x0,x14; add x14,#8n, and pop them into
// [x0+i*8] from the last down. Immediate-offset stores, so valid for <=511
// elements (imm12). T42 2026-09-04 (fuzz DIVERGE-2131 shrunk): the old order
// stored each element at [x14+i*8] BEFORE the bump, so a nested literal or
// an allocating call inside an element reused the same x14 cells and
// silently overwrote the outer elements. Same word count, no extra pushes.
fn emit_array_lit(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let strn = str_len(s);
  let _ = pos[0] = pos[0] + 1;
  let cnt = 0;
  let done = 0;
  while done == 0 {
    // progress guard: a malformed element (e.g. "[+4)") must not spin forever
    let before = pos[0];
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_rb = if ch == 93 then 1 else 0;
    let _ = if is_rb == 0 then emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let cnt = if is_rb == 0 then cnt + 1 else cnt;
    let _ = skip_ws(s, pos);
    let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch2 == 44 then 1 else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let stuck = if pos[0] > before then 0 else 1;
    let done = if is_rb + at_end >= 1 then 1 else stuck;
    0
  };
  let _ = pos[0] = pos[0] + 1;
  let _ = em(insns, n, 2853045216);
  let _ = em(insns, n, 2432696320 + cnt * 8192 + 462);
  // T118 (D11-D): frame-heap capacity trap -- the frame is 16 KiB from the
  // prologue sp and x15 = sp+256, so the heap end is x15 + 16128:
  // add x2,x15,#12288 ; add x2,x2,#3840 ; cmp x14,x2 ; b.ls +4 ; mov x0,#81 ;
  // mov x8,#94 ; svc  (exit 81 = frame heap exhausted)
  let _ = em(insns, n, 2436894178);
  let _ = em(insns, n, 2436628546);
  let _ = em(insns, n, 3942777311);
  let _ = em(insns, n, 1409286281);
  let _ = em(insns, n, 3531606560);
  let _ = em(insns, n, 3531606984);
  let _ = em(insns, n, 3556769793);
  // pop x1 ; str x1,[x0,#k*8] (0xF9000001 + k*1024, as+objdump L1)
  let k = cnt;
  while k > 0 {
    let k = k - 1;
    let _ = pop(insns, n, 1, fntab);
    let _ = em(insns, n, 4177526785 + k * 1024);
    0
  };
  let _ = push(insns, n, fntab);
  n[0]
}

// Array get: base + index already on the stack (base pushed first). Pop index
// into x1, base into x2, then ldr x0,[x2,x1,lsl 3]; push.
fn emit_array_get(insns: [i64], n: [i64], fntab: [i64]) -> i64 {
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 2, fntab);
  let _ = em(insns, n, 4167137344);
  let _ = push(insns, n, fntab);
  n[0]
}

// Array set: base + index on the stack; value emitted next. Pop value->x0,
// index->x1, base->x2; str x0,[x2,x1,lsl 3]; result 0.
fn emit_array_set(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 2, fntab);
  let _ = em(insns, n, 4162943040);
  let _ = em(insns, n, 3531603968);
  let _ = push(insns, n, fntab);
  n[0]
}

// Emit name[i] (get) or name[i] = v (set). `name` is a bound array variable;
// pos is at '['. Emit base (push), emit index (push), then get or set.
fn emit_array_index(s: str, name: i64, npos: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let strn = str_len(s);
  let reg = sym_lookup(s, stab, name, npos);
  let _ = emit_var(insns, n, reg, fntab);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  let e1 = if pos[0] + 1 >= strn then 1 else 0;
  let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
  let is_eq = if ch == 61 then 1 else 0;
  let is_eq2 = if ch1 == 61 then 1 else 0;
  let is_set = is_eq * (1 - is_eq2);
  let _ = if is_set == 1 then emit_array_set(s, pos, insns, n, stab, selfname, selfstart, fntab) else emit_array_get(insns, n, fntab);
  n[0]
}

// `-<digits>`: negative literal (T99). pos is on the `-`.
fn emit_negnum(s: str, pos: [i64], insns: [i64], n: [i64], fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let v = read_num_val(s, pos);
  let _ = emit_lit(insns, n, 0 - v, fntab);
  n[0]
}

// Unary operator on the next factor (T99): kind 0 = `-` (neg x0,x0 =
// 0xCB0003E0), kind 1 = `!` (cmp x0,#0 = 0xF100001F; cset x0,eq =
// 0x9A9F17E0). Words from aarch64-linux-gnu-as + objdump (L1). pos is on
// the operator char.
fn emit_unary(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], kind: i64) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_factor(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = if kind == 0 then em(insns, n, 3405775840) else em(insns, n, 4043309087);
  let _ = if kind == 1 then em(insns, n, 2594117600) else 0;
  let _ = push(insns, n, fntab);
  n[0]
}

// factor = number | letter | ( expr ) | cond expr then expr else expr
fn emit_factor(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = skip_ws(s, pos);
  let strn = str_len(s);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  // unary not: !e desugars to (e == 0). The '!=' two-char token is left
  // alone for the comparison tier. (Desugar disabled: the nested
  // if-in-comparison branch code misfires in the JIT-compiled emitter;
  // the corpus never uses unary '!'.)
  let e1 = if pos[0] + 1 >= strn then 1 else 0;
  let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
  let is_lparen = if ch == 40 then 1 else 0;
  let is_i = if ch == 105 then 1 else 0;
  let is_f = if ch1 == 102 then 1 else 0;
  let is_ifkw = is_i * is_f;
  let e2 = if pos[0] + 2 >= strn then 1 else 0;
  let e3 = if pos[0] + 3 >= strn then 1 else 0;
  let e4 = if pos[0] + 4 >= strn then 1 else 0;
  let ch2 = if e2 == 1 then 0 else char(s, pos[0] + 2);
  let ch3 = if e3 == 1 then 0 else char(s, pos[0] + 3);
  let ch4 = if e4 == 1 then 0 else char(s, pos[0] + 4);
  let is_m = if ch == 109 then 1 else 0;
  let is_a = if ch1 == 97 then 1 else 0;
  let is_t = if ch2 == 116 then 1 else 0;
  let is_c = if ch3 == 99 then 1 else 0;
  let is_h = if ch4 == 104 then 1 else 0;
  let is_matchkw = is_m * is_a * is_t * is_c * is_h;
  let is_l = if ch == 108 then 1 else 0;
  let is_e = if ch1 == 101 then 1 else 0;
  let is_t2 = if ch2 == 116 then 1 else 0;
  let is_letkw = is_l * is_e * is_t2;
  let is_lb = if ch == 91 then 1 else 0;
  let is_quote = if ch == 34 then 1 else 0;
  let is_letter = is_alpha(ch);
  // T99 (2026-09-04) unary literal forms: `-x` = neg x0,x0; `!x` = cmp
  // x0,#0; cset x0,eq (`!=` stays a comparison token). `-<digits>` is a
  // negative literal (single movn/movk, fold model intact).
  let is_neg = (if ch == 45 then 1 else 0) * (1 - is_digit(ch1));
  let is_negnum = (if ch == 45 then 1 else 0) * is_digit(ch1);
  let is_not = (if ch == 33 then 1 else 0) * (if ch1 == 61 then 0 else 1);
  let _ = if is_neg == 1 then emit_unary(s, pos, insns, n, stab, selfname, selfstart, fntab, 0)
    else if is_not == 1 then emit_unary(s, pos, insns, n, stab, selfname, selfstart, fntab, 1)
    else if is_negnum == 1 then emit_negnum(s, pos, insns, n, fntab)
    else if is_lparen == 1 then emit_paren(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if is_ifkw == 1 then emit_cond(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if is_letkw == 1 then emit_let_in(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if is_matchkw == 1 then emit_match(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if is_lb == 1 then emit_array_lit(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else if is_quote == 1 then emit_str(s, pos, insns, n, fntab)
    else if is_letter == 1 then emit_ident(s, pos, insns, n, stab, selfname, selfstart, fntab)
    else emit_num(s, pos, insns, n, fntab);
  let fd = 0;
  while fd == 0 {
    // progress guard: '.' that fails to consume input must not spin forever
    let before = pos[0];
    let _ = skip_ws(s, pos);
    let strn2 = str_len(s);
    let ch2 = if pos[0] >= strn2 then 0 else char(s, pos[0]);
    let is_dot = if ch2 == 46 then 1 else 0;
    let _ = if is_dot == 1 then emit_field_access(s, pos, insns, n, stab, fntab) else 0;
    let advanced = if pos[0] > before then 1 else 0;
    let stuck = is_dot * (1 - advanced);
    let fd = if is_dot == 1 then stuck else 1;
    0
  };
  n[0]
}



// Checksum of the emitted buffer (Bebop has no bitwise xor).
fn sum_words(insns: [i64], count: i64) -> i64 {
  let i = 0;
  let acc = 0;
  while i < count {
    let acc = acc + insns[i];
    let i = i + 1;
    0
  };
  acc
}

// Parse + emit an expression, return the checksum of the emitted words.
fn compile(s: str) -> i64 {
  let insns = zeros(256);
  let n = [0];
  let pos = [0];
  let stab = zeros(385);  // 1 + 3*128 (name,reg,srcpos) verified triples; overflow -> loud trap
  let selfname = 0 - 1;
  let selfstart = 0;
  let fnames_l = zeros(256);
  let fpos_l = zeros(256);
  let cnt_l = [0];
  let _ = collect_fns(s, fnames_l, fpos_l, cnt_l);
  let _ = if cnt_l[0] >= 256 then em(insns, n, 3558866944) else 0;
  let fntab = zeros(4096);
  let _ = fntab[0] = cnt_l[0];
  let fl_i = [0];
  let fl_d = if cnt_l[0] == 0 then 1 else 0;
  while fl_d == 0 {
    let _ = fntab[1 + fl_i[0]] = fnames_l[fl_i[0]];
    let _ = fntab[1 + cnt_l[0] + cnt_l[0] + fl_i[0]] = fpos_l[fl_i[0]];
    let _ = fl_i[0] = fl_i[0] + 1;
    let fl_d = if fl_i[0] >= cnt_l[0] then 1 else 0;
    0
  };
  let enames_l = zeros(256);
  let ecnt_l = [0];
  let _ = collect_ctors(s, enames_l, ecnt_l);
  let _ = if ecnt_l[0] >= 256 then em(insns, n, 3558866944) else 0;
  let eb_l = cnt_l[0] + cnt_l[0] + cnt_l[0] + 1;
  let _ = fntab[eb_l] = ecnt_l[0];
  let ez_l = [0];
  let ezd_l = if ecnt_l[0] == 0 then 1 else 0;
  while ezd_l == 0 {
    let _ = fntab[eb_l + 1 + ez_l[0]] = enames_l[ez_l[0]];
    let _ = ez_l[0] = ez_l[0] + 1;
    let ezd_l = if ez_l[0] >= ecnt_l[0] then 1 else 0;
    0
  };
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 3596551104);
  sum_words(insns, n[0])
}


// Advance pos to just before the first occurrence of `target`.
fn skip_to(s: str, pos: [i64], target: i64) -> i64 {
  let strn = str_len(s);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let hit = if ch == target then 1 else 0;
    let adv = if hit == 1 then 0 else 1;
    let _ = pos[0] = pos[0] + adv;
    let at_end_done = if at_end == 1 then 1 else 0;
    let done = if hit == 1 then 1 else at_end_done;
    0
  };
  0
}

// Count params in the ( ... ) list (commas + 1); advances pos past ')'.

// Prologue: save FP+LR, allocate a frame (spill slots + heap), save callee-saved
// x19..x28, then set x15 (spill base) and x14 (heap bump pointer). The frame is
// [sp, sp+16384): spills live at [x15, x15+…) (x15=sp+256), heap bumps up from
// x14=sp+1024, and the eval stack grows down from sp. x19-x28 are preserved for
// recursion + cross-function `bl`.
fn emit_prologue(insns: [i64], n: [i64]) -> i64 {
  let _ = em(insns, n, 2847898621);
  let _ = em(insns, n, 2432697341);
  let _ = em(insns, n, 3510637567);
  let _ = em(insns, n, 2835370995);
  let _ = em(insns, n, 2835438581);
  let _ = em(insns, n, 2835506167);
  let _ = em(insns, n, 2835573753);
  let _ = em(insns, n, 2835641339);
  let _ = em(insns, n, 2432959471);
  let _ = em(insns, n, 2433483758);
  n[0]
}

// Epilogue: restore x19..x28 (offset ldp), free the frame, restore FP+LR, ret.
fn emit_epilogue(insns: [i64], n: [i64]) -> i64 {
  let _ = em(insns, n, 2839835643);
  let _ = em(insns, n, 2839768057);
  let _ = em(insns, n, 2839700471);
  let _ = em(insns, n, 2839632885);
  let _ = em(insns, n, 2839565299);
  let _ = em(insns, n, 2436895743);
  let _ = em(insns, n, 2831252477);
  let _ = em(insns, n, 3596551104);
  n[0]
}

// ---- T43 (2026-09-04): per-iteration frame-heap reset around `while` bodies.
// A body that allocates on x14 (array literal / enum ctor: the stream contains
// `mov x0,x14` = 2853045216) leaked 16 bytes+ per iteration and overflowed the
// 15 KiB frame heap (L8 "no allocations inside while bodies"). Now the loop
// saves x14 once before loop_start and restores it at the back-edge and at
// the exit, PROVIDED the body cannot leak an allocated pointer: a
// conservative TEXT scan of the body says no `let` at paren-depth 0 binds an
// OUTER symbol (bound before the loop) to a BARE right-hand side (no
// arithmetic/comparison operator = possibly a pointer), and no `let _ = a[i] =
// v` stores a bare `v`. Anything else (rebinding outer scalars with arithmetic,
// new names, nested loops) is fine. Unsafe bodies keep today's behaviour
// (leak, never a wrong value). Slot = [sp, #80 + 8*depth], depth <= 20
// (frame words 80..256 are free below the x15 spill base).
fn sym_is_outer(s: str, stab: [i64], name: i64, srcpos: i64, cnt0: i64) -> i64 {
  let i = 0;
  let hit = 0;
  while i < cnt0 {
    let nm = stab[1 + 3 * i];
    let sp = stab[3 + 3 * i];
    let h = if nm == name then ident_eq(s, sp, srcpos) else 0;
    let hit = hit + h;
    let i = i + 1;
    0
  };
  if hit > 0 then 1 else 0
}

// 1 when [a,b) holds no operator character (+ - * / % & | ^ < > !) at
// paren/bracket depth 0: `s + v[1]` is a scalar, `[i, i * i]` and `f(a + b)`
// are bare values (an array literal / call may yield a pointer).
fn rhs_is_bare(s: str, a: i64, b: i64) -> i64 {
  let i = a;
  let ops = 0;
  let dp = 0;
  while i < b {
    let c = char(s, i);
    let o = (c == 43) + (c == 45) + (c == 42) + (c == 47) + (c == 37) + (c == 38) + (c == 124) + (c == 94) + (c == 60) + (c == 62) + (c == 33);
    let ops = ops + o * (if dp == 0 then 1 else 0);
    let dp = dp + (c == 40) + (c == 91) - (c == 41) - (c == 93);
    let i = i + 1;
    0
  };
  if ops == 0 then 1 else 0
}

// End of a right-hand side starting at r0: the first `;`, `}` or ` in ` at
// local paren/bracket depth 0 (never past b1).
fn rhs_end(s: str, r0: i64, b1: i64) -> i64 {
  let k = r0;
  let ld = 0;
  let done = 0;
  while done == 0 {
    let at_end = if k >= b1 then 1 else 0;
    let c = if at_end == 1 then 59 else char(s, k);
    let c1 = if k + 1 >= b1 then 0 else char(s, k + 1);
    let c2 = if k + 2 >= b1 then 0 else char(s, k + 2);
    let c3 = if k + 3 >= b1 then 0 else char(s, k + 3);
    let is_in = (c == 32) * (c1 == 105) * (c2 == 110) * (c3 == 32);
    let stop = (if ld == 0 then 1 else 0) * ((c == 59) + (c == 125) + is_in) + at_end;
    let ld = ld + (c == 40) + (c == 91) - (c == 41) - (c == 93);
    let k = k + (1 - (if stop >= 1 then 1 else 0));
    let done = if stop >= 1 then 1 else 0;
    0
  };
  k
}

fn loop_alloc_safe(s: str, b0: i64, b1: i64, stab: [i64], cnt0: i64) -> i64 {
  let p = zeros(1);
  let i = b0;
  let pd = 0;
  let bad = 0;
  while i < b1 {
    let c = char(s, i);
    let c1 = if i + 1 >= b1 then 0 else char(s, i + 1);
    let c2 = if i + 2 >= b1 then 0 else char(s, i + 2);
    let c3 = if i + 3 >= b1 then 0 else char(s, i + 3);
    let is_cm = (c == 47) * (c1 == 47);
    let is_q = if c == 34 then 1 else 0;
    let _ = p[0] = i;
    let _ = if is_cm == 1 then skip_line_comment(s, p) else 0;
    let _ = if is_q == 1 then skip_string(s, p) else 0;
    let skipped = is_cm + is_q;
    let prev = if i > b0 then char(s, i - 1) else 32;
    let prev_id = is_alpha(prev) + is_digit(prev) + (if prev == 95 then 1 else 0);
    let is_let = (1 - skipped) * (if pd == 0 then 1 else 0) * (c == 108) * (c1 == 101) * (c2 == 116) * (c3 == 32) * (1 - prev_id);
    let _ = if is_let == 1 then (let _ = p[0] = i + 4 in skip_ws(s, p)) else 0;
    let npos = p[0];
    let nch = if is_let == 1 then char(s, npos) else 0;
    let is_us = (if nch == 95 then 1 else 0) * (if is_alpha(char(s, npos + 1)) + is_digit(char(s, npos + 1)) == 0 then 1 else 0);
    let name = if is_let * (1 - is_us) == 1 then read_ident(s, p) else 0;
    let _ = if is_let == 1 then (let _ = if is_us == 1 then (let _ = p[0] = npos + 1 in 0) else 0 in skip_ws(s, p)) else 0;
    // p[0] is at `=` now (for a let); RHS starts after it
    let r0 = p[0] + 1;
    let r1 = if is_let == 1 then rhs_end(s, r0, b1) else r0;
    // `let _ = IDENT[...] = v`: find the store `=` (a `]` followed by ws and a single `=`)
    let st = if is_let * is_us == 1 then store_eq_pos(s, r0, r1) else 0 - 1;
    let v0 = if st >= 0 then st + 1 else r0;
    let bare = if is_let == 1 then rhs_is_bare(s, v0, r1) else 0;
    let outer = if is_let * (1 - is_us) == 1 then sym_is_outer(s, stab, name, npos, cnt0) else 0;
    let bad = bad + is_let * bare * (outer + (if st >= 0 then 1 else 0));
    let pd = pd + (1 - skipped) * ((c == 40) + (c == 91) - (c == 41) - (c == 93));
    let i = if skipped == 1 then p[0] else (if is_let == 1 then r1 else i + 1);
    0
  };
  if bad > 0 then 0 else 1
}

// Position of the store `=` in `a[i] = v` between r0 and r1 (a `]` then ws then
// `=` not followed by `=`), or -1.
fn store_eq_pos(s: str, r0: i64, r1: i64) -> i64 {
  let k = r0;
  let found = 0 - 1;
  while k < r1 {
    let c = char(s, k);
    let is_rb = if c == 93 then 1 else 0;
    let j = k + 1;
    let j = if is_rb * (if j < r1 then 1 else 0) * (if char(s, j) == 32 then 1 else 0) == 1 then j + 1 else j;
    let hit = is_rb * (if j < r1 then 1 else 0) * (if char(s, j) == 61 then 1 else 0) * (if j + 1 < r1 then (if char(s, j + 1) == 61 then 0 else 1) else 1);
    let found = if hit * (if found < 0 then 1 else 0) == 1 then j else found;
    let k = k + 1;
    0
  };
  found
}

fn count_word(insns: [i64], a: i64, b: i64, w: i64) -> i64 {
  let i = a;
  let c = 0;
  while i < b {
    let c = c + (if insns[i] == w then 1 else 0);
    let i = i + 1;
    0
  };
  c
}

// T99 (2026-09-04): `return e;` -> e in x0, one placeholder `b` recorded in
// fntab[3662] (count) / 3663..3679 (positions), patched to the epilogue by
// compile_fn_at; `break;` -> placeholder `b` recorded in fntab[3680] / 3681..
// 3699, patched to the enclosing loop's exit by emit_while_stmt (which
// remembers the count at entry). More than 17 returns / 18 pending breaks in
// one fn traps loudly (exit 98, exit-code table at emit_paren).
fn emit_return_stmt(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 6;
  let _ = skip_ws(s, pos);
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = pop(insns, n, 0, fntab);
  let k = fntab[3662];
  let _ = if k >= 17 then sys_exit(98) else 0;
  let _ = fntab[3663 + k] = n[0];
  let _ = fntab[3662] = k + 1;
  let _ = em(insns, n, 335544320);
  let _ = skip_ws(s, pos);
  let cs = if pos[0] >= str_len(s) then 0 else char(s, pos[0]);
  let _ = if cs == 59 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  n[0]
}

fn emit_break_stmt(s: str, pos: [i64], insns: [i64], n: [i64], fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 5;
  let k = fntab[3680];
  let _ = if k >= 18 then sys_exit(98) else 0;
  let _ = fntab[3681 + k] = n[0];
  let _ = fntab[3680] = k + 1;
  let _ = em(insns, n, 335544320);
  let _ = skip_ws(s, pos);
  let cs = if pos[0] >= str_len(s) then 0 else char(s, pos[0]);
  let _ = if cs == 59 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  n[0]
}

// Patch the pending `b` placeholders recorded at fntab[base+1+j], j in
// [from, fntab[base]) to `target`, then rewind the count to `from`.
fn patch_jumps(insns: [i64], fntab: [i64], base: i64, from: i64, target: i64) -> i64 {
  let j = from;
  let cnt = fntab[base];
  while j < cnt {
    let p = fntab[base + 1 + j];
    let _ = insns[p] = 335544320 + (target - p);
    let j = j + 1;
    0
  };
  let _ = fntab[base] = from;
  0
}

// Emit one 'while cond { body };' statement: a real backward loop (no result).
// cond is re-evaluated each iteration (its code sits at loop_start); body's
// final expression is discarded. Mutable `let` (sym_bind reuse) makes loop
// vars update in place, so re-running the cond reads the updated values.
fn emit_while_stmt(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], cx: [i64], st: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 5;
  let _ = skip_ws(s, pos);
  let pcond = pos[0];
  let cnt0 = stab[0];
  let brk0 = fntab[3680];
  let ldepth = fntab[3661];
  let _ = fntab[3661] = ldepth + 1;
  let slot_ok = if ldepth <= 20 then 1 else 0;
  // T43 mark placeholder: a nop that becomes str x14,[sp,#80+8*depth]
  // (0xF90003EE + imm12<<10, as+objdump) once the body proves reset-safe.
  let pmark = n[0];
  let _ = em(insns, n, 3573751839);
  let loop_start = n[0];
  let _ = fntab[3660] = loop_start;
  // legacy stack-machine loop: emit the condition, materialize it, branch
  // with a PLACEHOLDER b.eq (fixup recorded at p1), emit the body, then
  // patch the placeholder once the target address is known. The backward
  // edge is emitted last with its exact delta (loop_start is fixed).
  let _ = fntab[3892] = 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = fntab[3892] = 0;
  let _ = pop(insns, n, 0, fntab);
  let bw = cond_branch_word(insns, n, fntab);
  let p1 = n[0];
  let _ = em(insns, n, bw);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let nb_body = n[0];
  let b0 = pos[0];
  let bresl = emit_body(s, pos, insns, n, stab, selfname, selfstart, fntab, cx, st);
  let b1 = pos[0];
  let blastl = bresl - (bresl / 2) * 2;
  let grewl_raw = if n[0] > nb_body then 1 else 0;
  // while-boundary fix (journal 1788288252): pop the body's leftover value
  // ONLY when the body leaves exactly ONE value on the stack (final item
  // was an expr; let/while/compound leave nothing); popping a let-final
  // body underflows the stack once per iteration. blastl = lastf = 1 in
  // exactly that case.
  let legbl = if blastl == 1 then grewl_raw else 0;
  // T96 step 2b: a body that ends in a bare 16-bit literal (`0`) leaves
  // [movz x0,#imm ; sub sp ; str x0] whose value is discarded -> retract
  // all three words (no label may sit inside: fntab[3660] < n-2).
  let curw = n[0];
  let w3 = if curw >= 3 then insns[curw - 3] else 0;
  let dead = legbl * (if curw >= 3 then 1 else 0) * (if (w3 & 4292870175) == 3531603968 then 1 else 0) * (if insns[curw - 2] == 3506455551 then 1 else 0) * (if insns[curw - 1] == 4177527776 then 1 else 0) * (if fntab[3660] < curw - 2 then 1 else 0);
  let _ = if dead == 1 then (let _ = n[0] = curw - 3 in 0) else 0;
  let _ = if dead == 1 then (let _ = fntab[3700] = (if fntab[3700] > 0 then fntab[3700] - 1 else 0) in 0) else 0;
  let _ = if dead == 1 then (let _ = fold_clear(fntab) in 0) else 0;
  let _ = if legbl * (1 - dead) == 1 then pop(insns, n, 0, fntab) else 0;
  // T43 reset: only when the body allocated on x14 and the text scan proves
  // no allocated pointer can leave the iteration.
  let allocs = count_word(insns, nb_body, n[0], 2853045216);
  let safe = if allocs > 0 then loop_alloc_safe(s, b0, b1, stab, cnt0) else 0;
  let do_reset = slot_ok * (if allocs > 0 then 1 else 0) * safe;
  let ldrw = 4181722094 + (10 + ldepth) * 1024;
  let _ = if do_reset == 1 then (let _ = em(insns, n, ldrw) in 0) else 0;
  let _ = em(insns, n, 402653184 + loop_start - n[0]);
  let endl = n[0];
  let _ = fntab[3660] = endl;
  let _ = patch_jumps(insns, fntab, 3680, brk0, endl);
  let _ = if do_reset == 1 then (let _ = em(insns, n, ldrw) in 0) else 0;
  let _ = if do_reset == 1 then (let _ = insns[pmark] = 4177527790 + (10 + ldepth) * 1024 in 0) else 0;
  let _ = fntab[3661] = ldepth;
  let _ = insns[p1] = insns[p1] + (endl - p1) * 32;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = skip_ws(s, pos);
  let strnW = str_len(s);
  let cW = if pos[0] >= strnW then 0 else char(s, pos[0]);
  let _ = if cW == 59 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  n[0]
}

// Emit one 'let x = value;' statement: emit value, pop x0, mov x<reg>,x0
// (bind the single-letter var x to reg 19+(x-'a')).
fn emit_let_stmt(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], cx: [i64], st: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 3;
  let _ = skip_ws(s, pos);
  let npos = pos[0];
  let name = read_ident(s, pos);
  let reg = sym_bind(s, stab, name, npos);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let nb_v = n[0];
  // ---- chained discard-assign: `let _ = NAME = RHS;` lowers to NAME<-RHS ----
  let _ = skip_ws(s, pos);
  let sq0 = pos[0];
  let strq = str_len(s);
  let cq0 = if sq0 >= strq then 0 else char(s, sq0);
  let qa0 = is_alpha(cq0);
  let wq0 = [sq0];
  let hq0 = [0];
  let qgo0 = qa0;
  while qgo0 == 1 {
    let ccq0 = if wq0[0] >= strq then 0 else char(s, wq0[0]);
    let ga0 = is_alpha(ccq0);
    let gd0 = (if ccq0 >= 48 then 1 else 0) * (if ccq0 <= 57 then 1 else 0);
    let gu0 = if ccq0 == 95 then 1 else 0;
    let adv0 = ga0 + gd0 + gu0;
    let _ = if adv0 == 1 then (let _ = hq0[0] = hq0[0] * 131 + ccq0 in 0) else 0;
    let _ = wq0[0] = wq0[0] + adv0;
    let qgo0 = adv0;
    0
  };
  let e1q = if wq0[0] >= strq then 1 else 0;
  let qws = [wq0[0]];
  let qwg = 1 - e1q;
  while qwg == 1 {
    let cqw = if qws[0] >= strq then 0 else char(s, qws[0]);
    let isspw = if cqw == 32 then 1 else 0;
    let _ = if isspw == 1 then (let _ = qws[0] = qws[0] + 1 in 0) else 0;
    let qwg = isspw;
    0
  };
  let eq1 = if qws[0] >= strq then 0 else char(s, qws[0]);
  let eq2 = if qws[0] + 1 >= strq then 0 else char(s, qws[0] + 1);
  let is_chain = qa0 * (if eq1 == 61 then 1 else 0) * (if eq2 == 61 then 0 else 1);
  let treg_c = sym_lookup(s, stab, hq0[0], sq0);
  // ---- planning phase: every decision flag is computed BEFORE emission;
  // the emitter below only executes, it never re-decides ----
  let treg_chain = if treg_c >= 19 then treg_c else reg;
  let treg_i = if is_chain == 1 then treg_chain else reg;
  let _ = if is_chain == 1 then (let _ = pos[0] = qws[0] + 1 in (let _ = skip_ws(s, pos) in 0)) else 0;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let strnV = str_len(s);
  let cV = if pos[0] >= strnV then 0 else char(s, pos[0]);
  let _ = if cV == 59 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  let grew_v = if n[0] > nb_v then 1 else 0;
  let _ = if grew_v == 1 then pop(insns, n, 0, fntab) else 0;
  let _ = bind_reg(insns, n, treg_i);
  n[0]
}



// Emit a function body: zero or more 'let x = v;' statements, then the result
// expression.
// Emit a function/loop body: ';'-separated items until '}' or end of input.
// Items: 'let x = v;' (net 0 words), 'while ... { ... };' (net 0), or a plain
// expression (net +1 word on the value stack). All expression values except
// the FINAL one are popped, so the body leaves exactly one value -- matching
// interpreter semantics where ';' sequences statements and an if-expression
// ENDS at the first ';' outside parens (parity bug: the old body parser ran
// one expression to end-of-input, letting `if c then a else b; rest`
// swallow the rest into the else branch).
// Compound statement item: IDENT (+|-|*|/|%)= expr ';'
// Lowers to shadow-rebind: reg = sym_bind(name); old -> stack; rhs ->
// stack; binop; bind_reg(reg). Consumes the trailing ';'.
fn emit_compound_stmt(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let npos = pos[0];
  let name = read_ident(s, pos);
  let reg0 = sym_lookup(s, stab, name, npos);
  let _ = skip_ws(s, pos);
  let opch = if pos[0] >= str_len(s) then 0 else char(s, pos[0]);
  let is_add = if opch == 43 then 1 else 0;
  let is_sub = if opch == 45 then 1 else 0;
  let is_mul = if opch == 42 then 1 else 0;
  let is_div = if opch == 47 then 1 else 0;
  let is_mod = if opch == 37 then 1 else 0;
  let opcode = is_add * 2 + is_sub * 3 + is_mul * 4 + is_div * 5 + is_mod * 11;
  let is_plain = if opch == 61 then 1 else 0;
  let _ = pos[0] = pos[0] + 2;
  let _ = if is_plain == 1 then (let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab) in 0) else (let _ = emit_var(insns, n, reg0, fntab) in (let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab) in (let _ = emit_binop(insns, n, opcode, fntab) in 0)));
  let _ = pop(insns, n, 0, fntab);
  let _ = bind_reg(insns, n, reg0);
  let _ = skip_ws(s, pos);
  let strnC = str_len(s);
  let cC = if pos[0] >= strnC then 0 else char(s, pos[0]);
  let _ = if cC == 59 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  n[0]
}

fn emit_body(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64], cx: [i64], st: [i64]) -> i64 {
  let done = 0;
  let lastf = 0;
  while done == 0 {
    let before = pos[0];
    let _ = skip_ws(s, pos);
    let strn = str_len(s);
    let at_end0 = if pos[0] >= strn then 1 else 0;
    let ch = if at_end0 == 1 then 0 else char(s, pos[0]);
    let e1 = if pos[0] + 1 >= strn then 1 else 0;
    let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
    let e2 = if pos[0] + 2 >= strn then 1 else 0;
    let ch2 = if e2 == 1 then 0 else char(s, pos[0] + 2);
    let e3 = if pos[0] + 3 >= strn then 1 else 0;
    let ch3 = if e3 == 1 then 0 else char(s, pos[0] + 3);
    let e4 = if pos[0] + 4 >= strn then 1 else 0;
    let ch4 = if e4 == 1 then 0 else char(s, pos[0] + 4);
    let is_l = if ch == 108 then 1 else 0;
    let is_e = if ch1 == 101 then 1 else 0;
    let is_t = if ch2 == 116 then 1 else 0;
    let b3_alpha = is_alpha(ch3);
    let b3_ge = if ch3 >= 48 then 1 else 0;
    let b3_le = if ch3 <= 57 then 1 else 0;
    let b3_num = b3_ge * b3_le;
    let b3_us = if ch3 == 95 then 1 else 0;
    let is_let = is_l * is_e * is_t * (1 - b3_alpha) * (1 - b3_num) * (1 - b3_us);
    let is_w = if ch == 119 then 1 else 0;
    let is_h = if ch1 == 104 then 1 else 0;
    let is_i = if ch2 == 105 then 1 else 0;
    let is_l2 = if ch3 == 108 then 1 else 0;
    let is_e2 = if ch4 == 101 then 1 else 0;
    let is_while = is_w * is_h * is_i * is_l2 * is_e2;
    // T99 (2026-09-04): `return e;` and `break;` are statements (literal forms:
    // one `b` each), recognised by keyword + a non-identifier follower.
    let e5 = if pos[0] + 5 >= strn then 1 else 0;
    let ch5 = if e5 == 1 then 0 else char(s, pos[0] + 5);
    let e6 = if pos[0] + 6 >= strn then 1 else 0;
    let ch6 = if e6 == 1 then 0 else char(s, pos[0] + 6);
    let id5 = is_alpha(ch5) + is_digit(ch5) + (if ch5 == 95 then 1 else 0);
    let id6 = is_alpha(ch6) + is_digit(ch6) + (if ch6 == 95 then 1 else 0);
    let is_ret = (if ch == 114 then 1 else 0) * (if ch1 == 101 then 1 else 0) * (if ch2 == 116 then 1 else 0) * (if ch3 == 117 then 1 else 0) * (if ch4 == 114 then 1 else 0) * (if ch5 == 110 then 1 else 0) * (1 - id6);
    let is_brk = (if ch == 98 then 1 else 0) * (if ch1 == 114 then 1 else 0) * (if ch2 == 101 then 1 else 0) * (if ch3 == 97 then 1 else 0) * (if ch4 == 107 then 1 else 0) * (1 - id5);
    let at_close = if ch == 125 then 1 else 0;
    let is_item = (1 - at_close) * (1 - at_end0);
    let _ = if is_item * is_let == 1 then emit_let_stmt(s, pos, insns, n, stab, selfname, selfstart, fntab, cx, st) else 0;
    let _ = if is_item * is_while == 1 then emit_while_stmt(s, pos, insns, n, stab, selfname, selfstart, fntab, cx, st) else 0;
    let _ = if is_item * is_ret == 1 then emit_return_stmt(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let _ = if is_item * is_brk == 1 then emit_break_stmt(s, pos, insns, n, fntab) else 0;
    // compound statement? ident-start (not let/while) followed by ws + one of +-*/% then '='
    let id_start = is_alpha(ch) * (1 - is_let) * (1 - is_while) * (1 - is_ret) * (1 - is_brk);
    let wq = pos[0];
    let id_go = id_start;
    while id_go == 1 {
      let ccq = if wq >= strn then 0 else char(s, wq);
      let g_a = is_alpha(ccq);
      let g_d = (if ccq >= 48 then 1 else 0) * (if ccq <= 57 then 1 else 0);
      let g_u = if ccq == 95 then 1 else 0;
      let adv = g_a + g_d + g_u;
      let wq = wq + adv;
      let id_go = adv;
      0
    };
    let wq2 = if wq >= strn then wq else wq + (if char(s, wq) == 32 then 1 else 0);
    let oc = if wq2 >= strn then 0 else char(s, wq2);
    let nc = if wq2 + 1 >= strn then 0 else char(s, wq2 + 1);
    let ok_op = (if oc == 43 then 1 else 0) + (if oc == 45 then 1 else 0) + (if oc == 42 then 1 else 0) + ((if oc == 47 then 1 else 0) * (if nc != 47 then 1 else 0)) + (if oc == 37 then 1 else 0);
    let is_compound = id_start * (if nc == 61 then ok_op else 0);
    let _ = if is_item * is_compound == 1 then emit_compound_stmt(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    let is_expr = is_item * (1 - is_let) * (1 - is_while) * (1 - is_compound) * (1 - is_ret) * (1 - is_brk);
    let nb_item = n[0];
    // F3 refined: dead-value suppression applies ONLY to the final expr
    // item of a while body (lookahead: next non-ws char is rbrace / EOF)
    let _ = skip_ws(s, pos);
    let strnE = str_len(s);
    let cE = if pos[0] >= strnE then 0 else char(s, pos[0]);
    let fin_brace = if cE == 125 then 1 else 0;
    let fin_eof = if pos[0] >= strnE then 1 else 0;
    let _ = cx[28] = is_expr * (fin_brace + fin_eof);
    let _ = cx[28] = 0;
    // planning phase: legacy-only decisions (the fast-path dispatch is
    // deleted; was_fast is the constant 0) -- every flag is fixed BEFORE
    // the emitter below runs, so guard and codegen can never desync
    let was_fast = 0;
    let _ = if is_expr == 1 then emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab) else 0;
    // non-final legacy items must not leave values on the stack
    let _ = skip_ws(s, pos);
    let strn9 = str_len(s);
    let c9 = if pos[0] >= strn9 then 0 else char(s, pos[0]);
    let not_rbrace = if c9 == 125 then 0 else 1;
    let not_eof = if pos[0] >= strn9 then 0 else 1;
    let grew = if n[0] > nb_item then 1 else 0;
    let leg_item = grew;
    let ma1 = if is_expr == 0 then 0 else not_rbrace;
    let more_ahead = if ma1 == 0 then 0 else not_eof;
    let _ = if more_ahead * leg_item == 1 then pop(insns, n, 0, fntab) else 0;
    // lastf = 1 exactly when the body leaves ONE value on the stack
    // (final item was an expr and no more items followed it): the while
    // and fn emitters pop that value, and must NOT pop otherwise
    let lastf = if is_item == 1 then is_expr * (1 - more_ahead) else lastf;
    let _ = skip_ws(s, pos);
    let strn2 = str_len(s);
    let at_end1 = if pos[0] >= strn2 then 1 else 0;
    let c2 = if at_end1 == 1 then 0 else char(s, pos[0]);
    let is_semi = if c2 == 59 then 1 else 0;
    let _ = if is_semi == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    // progress guard: a dispatch that consumed nothing must not spin forever
    let advanced = if pos[0] > before then 1 else 0;
    let stuck = (1 - advanced) * (1 - at_close) * (1 - at_end0);
    let _ = if stuck == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let done = if at_close + at_end0 >= 1 then 1 else 0;
    0
  };
  n[0] * 2 + lastf
}

// Scan s for the definition "fn <fname>(" (single-letter fn name); record the
// position of its 'fn' in out[0], return 1 if found.
fn find_fn(s: str, name: i64, out: [i64]) -> i64 {
  // Lexical scan: skips strings/comments; requires ident char after "fn "
  // (scanner source text like `is_fn =` must not register phantoms).
  let strn = str_len(s);
  let j = 0;
  let tpos_c = [0];
  let spc = [0];
  let cpc = [0];
  let found = 0;
  let best = 0;
  while j + 2 < strn {
    let c0 = char(s, j);
    let c1 = char(s, j + 1);
    let c2 = char(s, j + 2);
    let is_quote = if c0 == 34 then 1 else 0;
    let is_sl = if c0 == 47 then 1 else 0;
    let is_sl2 = if c1 == 47 then 1 else 0;
    let is_comment = is_sl * is_sl2;
    let isf = if c0 == 102 then 1 else 0;
    let isn = if c1 == 110 then 1 else 0;
    let issp = if c2 == 32 then 1 else 0;
    let cafter = if isf * isn * issp == 1 then char(s, j + 3) else 0;
    let is_fn = isf * isn * issp * (1 - is_quote) * (1 - is_comment) * is_alpha(cafter);
    let _ = tpos_c[0] = j + 3;
    let h = if is_fn == 1 then read_ident(s, tpos_c) else 0;
    let is_match = if h == name then 1 else 0;
    let hit = is_fn * is_match;
    let best = if hit == 1 then j else best;
    let found = if hit == 1 then 1 else found;
    let _ = spc[0] = j;
    let _ = cpc[0] = j;
    let _ = if is_quote == 1 then skip_string(s, spc) else 0;
    let _ = if is_comment == 1 then skip_line_comment(s, cpc) else 0;
    let jnext = (j + 1) * (1 - is_quote - is_comment - is_fn) + spc[0] * is_quote + cpc[0] * is_comment + tpos_c[0] * is_fn;
    let j = jnext;
    0
  };
  let _ = out[0] = best;
  found
}


// Inline a function call: find fname's def, bind args to its params (a->x19,
// b->x20, ...), emit the callee body from its source position, restore pos.
// Skip a parenthesised argument list LEXICALLY: pos is just after the opening
// "(", and stops ON the matching ")" (paren depth + strings + line comments;
// /* */ block comments are not skipped -- the corpus uses // only). Pure pos
// arithmetic, no emitter state. Shared by the unresolved-callee path of
// emit_call and by emit_match's payload scan (T42 2026-09-04: the payload
// used to end at the FIRST ")", so `match many((3)) {..}` bound `(3`).
fn skip_args(s: str, pos: [i64]) -> i64 {
  let go = 1;
  let depth = 0;
  while go == 1 {
    let strn3 = str_len(s);
    let at_end3 = if pos[0] >= strn3 then 1 else 0;
    let ch3 = if at_end3 == 1 then 0 else char(s, pos[0]);
    let nch3 = if pos[0] + 1 >= strn3 then 0 else char(s, pos[0] + 1);
    let is_q = if ch3 == 34 then 1 else 0;
    let is_sl = if ch3 == 47 then 1 else 0;
    let is_cmt = is_sl * (if nch3 == 47 then 1 else 0);
    let is_lp = if ch3 == 40 then 1 else 0;
    let is_rp = if ch3 == 41 then 1 else 0;
    let is_close0 = is_rp * (if depth == 0 then 1 else 0);
    let _ = if is_q == 1 then (let _ = pos[0] = pos[0] + 1 in (let _ = skip_string(s, pos) in 0)) else 0;
    let _ = if is_cmt == 1 then skip_line_comment(s, pos) else 0;
    let adv3 = 1 - is_q - is_cmt - is_close0;
    let _ = pos[0] = pos[0] + adv3;
    let depth = depth + is_lp - is_rp + is_close0;
    let stop3 = is_close0 + at_end3;
    let stop3 = if stop3 > 0 then 1 else 0;
    let go = 1 - stop3;
    0
  };
  0
}

fn emit_call(s: str, fname: i64, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let fnpos = [0];
  let cached = ft_cache_get(fntab, fname);
  let is_hit = if cached == 0 then 0 else 1;
  let sp = if is_hit == 1 then 0 - 1 else ft_srcpos(fntab, fname);
  let v = if cached > 0 then cached - 1 else 0 - cached - 2;
  let _ = if is_hit == 1 then (let _ = fnpos[0] = v in 0) else 0;
  // Resolution budget: cap total source scans; runaway repeats degrade.
  let _ = if is_hit == 1 then (let _ = fntab[4000] = fntab[4000] + 1 in 0) else 0;
  let mbudget = fntab[0] + fntab[0] + 8;
  // Branchless-law form of: scan only when unresolved AND under budget.
  let want_scan = if is_hit == 1 then 0 else 1;
  let under_budget = if fntab[4000] < mbudget then 1 else 0;
  let _ = if want_scan * under_budget == 1 then find_fn(s, fname, fnpos) else 0;
  let _ = if sp >= 0 then (let _ = fnpos[0] = sp in 0) else 0;
  let sv = if sp >= 0 then sp + 1 else 0 - fnpos[0] - 2;
  let _ = if is_hit == 1 then 0 else ft_cache_set(fntab, fname, sv);
  // unresolved callee: neutralize the inline (pcnt=0, no body re-parse) --
  // otherwise find_fn failure points body at a garbage offset and the
  // call/body mutual recursion runs away
  let okres = if fnpos[0] >= 3 then 1 else 0;
  let pb = fnpos[0] * okres + 3 * (1 - okres);
  let pnames = zeros(14);
  let pparpos = zeros(14);
  let ppos = [pb];
  let _ = read_ident(s, ppos);
  let _ = skip_ws(s, ppos);
  let pcnt0 = parse_params(s, ppos, pnames, pparpos);
  let pcnt1 = if pcnt0 > 14 then 14 else pcnt0;
  let _ = if pcnt0 > 14 then em(insns, n, 3558867200) else 0;
  let pcnt = pcnt1 * okres;
  let _ = skip_to(s, ppos, 123);
  let body = ppos[0] + 1;
  let _ = if okres == 0 then (let _ = em(insns, n, 3531603968) in (let _ = push(insns, n, fntab) in 0)) else 0;
  let _ = pos[0] = pos[0] + 1;
  let i = 0;
  while i < pcnt {
    let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
    let _ = pop(insns, n, 0, fntab);
    let reg = sym_bind(s, stab, pnames[i], pparpos[i]);
    let _ = bind_reg(insns, n, reg);
    let _ = skip_ws(s, pos);
    let strn = str_len(s);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_comma = if ch == 44 then 1 else 0;
    let _ = if is_comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let i = i + 1;
    0
  };
  // Unresolved callee (pcnt==0): the arg list was previously left unparsed,
  // stranding pos INSIDE the call — the body loop then saw ')' as "another
  // statement ahead", popped the value early, and emit_num(')') pushed a
  // phantom 0 (net -1 at ret: the run_program / depth_sim holdout). Skip the
  // args LEXICALLY (paren depth + strings + line comments) so pos resumes on
  // ')'. Pure pos arithmetic — no emitter state — so both engines agree.
  // Limit: /* */ block comments are not skipped (the corpus uses // only).
  let _ = if okres == 0 then skip_args(s, pos) else 0;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let after = pos[0];
  let _ = pos[0] = body * okres;
  let macx = zeros(64);
  let matk = zeros(1088);
  let _eb = if okres == 1 then (let _r = emit_body(s, pos, insns, n, stab, fname, selfstart, fntab, macx, matk) in 0) else 0;
  let _ = pos[0] = after;
  n[0]
}


// Compile a complete function: fn name(a,b,...) { body }.
// Params are moved x0->x19, x1->x20, ... in the prologue; body references
// single-letter params a->x19, b->x20, ... Returns the checksum of the words.
fn compile_fn(s: str) -> i64 {
  let insns = zeros(256);
  let n = [0];
  let pos = [0];
  let stab = zeros(385);  // 1 + 3*128 (name,reg,srcpos) verified triples; overflow -> loud trap
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 2;
  let _ = skip_ws(s, pos);
  let selfname = read_ident(s, pos);
  let selfstart = 0;
  let fnames_l = zeros(256);
  let fpos_l = zeros(256);
  let cnt_l = [0];
  let _ = collect_fns(s, fnames_l, fpos_l, cnt_l);
  let _ = if cnt_l[0] >= 256 then em(insns, n, 3558866944) else 0;
  let fntab = zeros(4096);
  let _ = fntab[0] = cnt_l[0];
  let fl_i = [0];
  let fl_d = if cnt_l[0] == 0 then 1 else 0;
  while fl_d == 0 {
    let _ = fntab[1 + fl_i[0]] = fnames_l[fl_i[0]];
    let _ = fntab[1 + cnt_l[0] + cnt_l[0] + fl_i[0]] = fpos_l[fl_i[0]];
    let _ = fl_i[0] = fl_i[0] + 1;
    let fl_d = if fl_i[0] >= cnt_l[0] then 1 else 0;
    0
  };
  let enames_l = zeros(256);
  let ecnt_l = [0];
  let _ = collect_ctors(s, enames_l, ecnt_l);
  let _ = if ecnt_l[0] >= 256 then em(insns, n, 3558866944) else 0;
  let eb_l = cnt_l[0] + cnt_l[0] + cnt_l[0] + 1;
  let _ = fntab[eb_l] = ecnt_l[0];
  let ez_l = [0];
  let ezd_l = if ecnt_l[0] == 0 then 1 else 0;
  while ezd_l == 0 {
    let _ = fntab[eb_l + 1 + ez_l[0]] = enames_l[ez_l[0]];
    let _ = ez_l[0] = ez_l[0] + 1;
    let ezd_l = if ez_l[0] >= ecnt_l[0] then 1 else 0;
    0
  };
  // Legacy single-fn mode: fn-table stays EMPTY (cnt=0) so unresolved calls
  // take the find_fn inline path; only the enum-ctor zone is populated.
  let fntab = zeros(4096);
  let _ = fntab[0] = 0;
  let eb2 = 1;
  let _ = fntab[eb2] = ecnt_l[0];
  let ez2 = [0];
  let ezd2 = if ecnt_l[0] == 0 then 1 else 0;
  while ezd2 == 0 {
    let _ = fntab[eb2 + 1 + ez2[0]] = enames_l[ez2[0]];
    let _ = ez2[0] = ez2[0] + 1;
    let ezd2 = if ez2[0] >= ecnt_l[0] then 1 else 0;
    0
  };
  let _ = skip_ws(s, pos);
  let pnames = zeros(14);
  let pparpos = zeros(14);
  let nparams = parse_params(s, pos, pnames, pparpos);
  let i = [0];
  let _ = if nparams > 14 then em(insns, n, 3558867200) else 0;
  let nb = if nparams > 14 then 14 else nparams;
  let mvdone = if nb == 0 then 1 else 0;
  while mvdone == 0 {
    let _ = sym_bind(s, stab, pnames[i[0]], pparpos[i[0]]);
    let _ = i[0] = i[0] + 1;
    let mvdone = if i[0] >= nb then 1 else 0;
    0
  };
  let _ = skip_to(s, pos, 123);
  let _ = pos[0] = pos[0] + 1;
  let cx = zeros(64);
  let tkbuf = zeros(1088);
  let _ = cx[26] = selfname;
  let _ = cx[27] = 0 - 1;
  let pbase = n[0];
  let _ = emit_prologue(insns, n);
  let j = [0];
  let mv2 = if nb == 0 then 1 else 0;
  while mv2 == 0 {
    let p_is_sp = if j[0] >= 8 then 1 else 0;
    let p_movw = 2852127712 + j[0] * 65536 + 19 + j[0];
    let p_strw = 4177526784 + (j[0] - 8) * 1024 + 480 + j[0];
    let _ = em(insns, n, p_movw * (1 - p_is_sp) + p_strw * p_is_sp);
    let _ = j[0] = j[0] + 1;
    let mv2 = if j[0] >= nb then 1 else 0;
    0
  };
  let nb_tail = n[0];
  let bres_t = if 1 == 1 then emit_body(s, pos, insns, n, stab, selfname, selfstart, fntab, cx, tkbuf) else 0;
  let blast_t = bres_t - (bres_t / 2) * 2;
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  // legacy emitter leaves the body value on the stack; fast path leaves it
  // in x0 -- pop exactly when something was pushed by a LEGACY final item
  let grew_t = if n[0] > nb_tail then 1 else 0;
  let leg_tail = if blast_t == 1 then grew_t else 0;
  let _ = if leg_tail == 1 then pop(insns, n, 0, fntab) else 0;
  let _ = fntab[3660] = n[0];
  let _ = patch_jumps(insns, fntab, 3662, 0, n[0]);
  let _ = emit_epilogue(insns, n);
  sum_words(insns, n[0])
}


// Collect all "fn <name>(" definitions in source order: fnames[i]=name hash,
// fpos[i]=byte offset of the 'f'. Returns the count via cnt[0].
fn collect_fns(s: str, fnames: [i64], fpos: [i64], cnt: [i64]) -> i64 {
  let strn = str_len(s);
  let j = 0;
  let tpos_c = [0];
  let spc = [0];
  let cpc = [0];
  while j + 2 < strn {
    let c0 = char(s, j);
    let c1 = char(s, j + 1);
    let c2 = char(s, j + 2);
    let is_quote = if c0 == 34 then 1 else 0;
    let is_sl = if c0 == 47 then 1 else 0;
    let is_sl2 = if c1 == 47 then 1 else 0;
    let is_comment = is_sl * is_sl2;
    let isf = if c0 == 102 then 1 else 0;
    let isn = if c1 == 110 then 1 else 0;
    let issp = if c2 == 32 then 1 else 0;
    let cafter = if isf * isn * issp == 1 then char(s, j + 3) else 0;
    let is_fn = isf * isn * issp * is_alpha(cafter);
    let _ = tpos_c[0] = j + 3;
    let name = if is_fn == 1 then read_ident(s, tpos_c) else 0;
    let capok = if cnt[0] < 256 then 1 else 0;
    let _ = if is_fn * capok == 1 then (let _ = fnames[cnt[0]] = name in (let _ = fpos[cnt[0]] = j in 0)) else 0;
    let _ = cnt[0] = cnt[0] + is_fn;
    let _ = spc[0] = j;
    let _ = if is_quote == 1 then skip_string(s, spc) else 0;
    let _ = cpc[0] = j;
    let _ = if is_comment == 1 then skip_line_comment(s, cpc) else 0;
    let jnext = (j + 1) * (1 - is_quote - is_comment - is_fn) + spc[0] * is_quote + cpc[0] * is_comment + tpos_c[0] * is_fn;
    let j = jnext;
    0
  };
  cnt[0]
}

// Compile one function whose "fn" keyword is at source offset fpos, appending
// into the shared insns/n buffer. selfstart = its absolute word offset (0 in a
// single-fn compile); fntab = full name->start layout (for cross-call bl).
fn compile_fn_at(s: str, fpos: i64, selfstart: i64, fntab: [i64], insns: [i64], n: [i64], tkb: [i64]) -> i64 {
  // Reset per-fn scan-budget so late functions don't exhaust the counter
  // accumulated by earlier ones (every cache-hit increments fntab[4000];
  // without reset, late fns compile ALL calls as unresolved/neutral).
  let _ = fntab[4000] = 0;
  let _ = fntab[3890] = 0;  // S3: rep=0 (all-memory) at function entry
  // T96 step 1: the label/barrier position is per-fn state. Without this
  // reset a position left by the previous fn (or the planning pass) could
  // coincide with n[0] here and block one elision in one pass only -> the
  // fntab offsets disagree with the emitted layout (ordfsm: every bl 3
  // words late, SIGBUS). -1 never equals a position.
  let _ = fntab[3660] = 0 - 1;
  let _ = fntab[3661] = 0;  // T43: while nesting depth (frame-heap mark slot)
  let _ = fntab[3662] = 0;  // T99: pending `return` placeholders
  let _ = fntab[3680] = 0;  // T99: pending `break` placeholders
  let pos = [fpos];
  let stab = zeros(385);  // 1 + 3*128 (name,reg,srcpos) verified triples; overflow -> loud trap
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 2;
  let _ = skip_ws(s, pos);
  let selfname = read_ident(s, pos);
  // T122 (D11-M, 2026-09-05): a fn named like a keyword or a builtin is REJECTED
  // (exit 99) -- `fn match` used to compile into a call of the match keyword
  // (T31 journal) and return 0. Hash table = read_ident of each reserved word.
  let rsv1 = (if selfname == 1866735 then 1 else 0) + (if selfname == 35281108217 then 1 else 0) + (if selfname == 13857 then 1 else 0) + (if selfname == 262576641 then 1 else 0) + (if selfname == 228925745 then 1 else 0) + (if selfname == 13865 then 1 else 0) + (if selfname == 13472 then 1 else 0) + (if selfname == 228960337 then 1 else 0) + (if selfname == 4471061603997 then 1 else 0) + (if selfname == 4238080694376 then 1 else 0) + (if selfname == 32320559965 then 1 else 0) + (if selfname == 4428069113672 then 1 else 0) + (if selfname == 29119020707 then 1 else 0) + (if selfname == 36158018563 then 1 else 0) + (if selfname == 224358574 then 1 else 0) + (if selfname == 585709020818199 then 1 else 0) + (if selfname == 66094333908796503 then 1 else 0) + (if selfname == 30895064082 then 1 else 0) + (if selfname == 4047253394792 then 1 else 0) + (if selfname == 260449716 then 1 else 0) + (if selfname == 249209392 then 1 else 0);
  let rsv2 = (if selfname == 246721067 then 1 else 0) + (if selfname == 76753189879327100 then 1 else 0) + (if selfname == 76753189885882068 then 1 else 0) + (if selfname == -8392076197157136435 then 1 else 0) + (if selfname == -8392076203060520566 then 1 else 0) + (if selfname == -2688661736639986669 then 1 else 0) + (if selfname == -8392076198348418984 then 1 else 0) + (if selfname == 76753189874778913 then 1 else 0) + (if selfname == 7442662210087947144 then 1 else 0) + (if selfname == -5847879057653958070 then 1 else 0) + (if selfname == 7442662398273192292 then 1 else 0) + (if selfname == 7442661902340062434 then 1 else 0) + (if selfname == 76753189856984008 then 1 else 0) + (if selfname == 7040940390938053523 then 1 else 0) + (if selfname == -6282920175007517587 then 1 else 0) + (if selfname == -8392076203060521221 then 1 else 0) + (if selfname == -1736429998027255437 then 1 else 0) + (if selfname == -3153574141067785036 then 1 else 0) + (if selfname == 8779068393901189725 then 1 else 0) + (if selfname == 7221016679989100487 then 1 else 0) + (if selfname == 1084841420853388659 then 1 else 0);
  let _ = if rsv1 + rsv2 > 0 then sys_exit(99) else 0;
  let _ = skip_ws(s, pos);
  let pnames = zeros(14);
  let pparpos = zeros(14);
  let nparams0 = parse_params(s, pos, pnames, pparpos);
  let nparams = if nparams0 > 14 then 14 else nparams0;
  let _ = if nparams0 > 14 then em(insns, n, 3558867200) else 0;
  let i = [0];
  let mvdone = if nparams == 0 then 1 else 0;
  while mvdone == 0 {
    let _ = sym_bind(s, stab, pnames[i[0]], pparpos[i[0]]);
    let _ = i[0] = i[0] + 1;
    let mvdone = if i[0] >= nparams then 1 else 0;
    0
  };
  let _ = skip_to(s, pos, 123);
  let _ = pos[0] = pos[0] + 1;
  let cx = zeros(64);
  let tkbuf = tkb;
  let _ = cx[26] = selfname;
  let _ = cx[27] = selfstart;
  let pbase = n[0];
  let _ = emit_prologue(insns, n);
  // Params 1..8 -> x19..x26; params 9+ -> spill slots (sym_bind maps cnt>=8
  // to 100+slot). A register move for j>=8 emitted `mov x27,x8`-class words:
  // it CLOBBERED the reserved arena register AND left the spill slot unwritten
  // (9th param read as 0; heap corruption downstream). Spilled params get
  // str xj,[x15,#slot*8]; encoding verified against objdump reference.
  let j = [0];
  let mv2 = if nparams == 0 then 1 else 0;
  while mv2 == 0 {
    let p_is_sp = if j[0] >= 8 then 1 else 0;
    let p_movw = 2852127712 + j[0] * 65536 + 19 + j[0];
    let p_strw = 4177526784 + (j[0] - 8) * 1024 + 480 + j[0];
    let _ = em(insns, n, p_movw * (1 - p_is_sp) + p_strw * p_is_sp);
    let _ = j[0] = j[0] + 1;
    let mv2 = if j[0] >= nparams then 1 else 0;
    0
  };
  let nb_tail = n[0];
  let bres_t = if 1 == 1 then emit_body(s, pos, insns, n, stab, selfname, selfstart, fntab, cx, tkbuf) else 0;
  let blast_t = bres_t - (bres_t / 2) * 2;
  // T42 2026-09-04 (fuzz DIVERGE-81/128 shrunk): a body with NO tail
  // expression (empty, or ending in a let/while/compound statement, or
  // `e;` before the `}`) returned whatever x0 held; trap 97 instead
  // (exit-code table at emit_paren). bpref.py raises on the same shape.
  let _ = if blast_t == 1 then 0 else sys_exit(97);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  // legacy emitter leaves the body value on the stack; fast path leaves it
  // in x0 -- pop exactly when something was pushed by a LEGACY final item
  let grew_t = if n[0] > nb_tail then 1 else 0;
  let leg_tail = if blast_t == 1 then grew_t else 0;
  let _ = if leg_tail == 1 then pop(insns, n, 0, fntab) else 0;
  let _ = fntab[3660] = n[0];
  let _ = patch_jumps(insns, fntab, 3662, 0, n[0]);
  let _ = emit_epilogue(insns, n);
  // OPT-A: only save/restore callee-saved pairs this fn actually binds.
  // Prologue words pbase+3..pbase+7 hold stp x19/x20 .. x27/x28; epilogue
  // holds the mirrored ldp pairs in reverse at ebase+0..ebase+4. Unused
  // pairs are patched to NOP after the fact (stab[0] is final here).
  // T126 (2026-09-05): pair 4 = x27/x28 is the ARENA cursor/end, never a symbol
  // register (symbols 9+ spill to [x15,...]). Saving and restoring it in fns with
  // >= 9 symbols rolled back every arena allocation they made (use_expand's
  // expanded source, emit_offsets' table) -- the caller then overwrote them with
  // its next zeros(): `use` of a module with >= 21 fns died with exit 97. The
  // pair is always NOPed now; x27 flows through calls as LANGUAGE.md says.
  let ebase = n[0] - 8;
  let nopw = 3573751839;
  let vc = stab[0];
  let k = [0];
  let pkgo = 1;
  while pkgo == 1 {
    let kdone = if k[0] > 4 then 1 else 0;
    let pair_used = if k[0] == 4 then 0 else if vc > k[0] * 2 then 1 else 0;
    let do_patch = (1 - kdone) * (1 - pair_used);
    let _ = if do_patch == 1 then (let _ = insns[pbase + 3 + k[0]] = nopw in 0) else 0;
    let _ = if do_patch == 1 then (let _ = insns[ebase + 4 - k[0]] = nopw in 0) else 0;
    let _ = k[0] = k[0] + 1;
    let pkgo = 1 - kdone;
    0
  };
  // OPT-G1: spill-base x15 / heap-bump x14 setups are pure overhead when
  // the compiled body never references those registers (typical for small
  // arithmetic/recursion fns): scan every emitted body word conservatively
  // (rn / rd / rm fields) and NOP the two prologue adds when unused.
  let u15 = [0];
  let u14 = [0];
  let gi = [nb_tail];
  let ggo = 1;
  while ggo == 1 {
    let gdone = if gi[0] >= n[0] then 1 else 0;
    let gw = insns[gi[0]];
    let grn = (gw / 32) - (gw / 1024) * 32;
    let grd = gw - (gw / 32) * 32;
    let grm = (gw / 65536) - (gw / 16777216) * 256;
    let h15 = (if grn == 15 then 1 else 0) + (if grd == 15 then 1 else 0) + (if grm == 15 then 1 else 0);
    let h14 = (if grn == 14 then 1 else 0) + (if grd == 14 then 1 else 0) + (if grm == 14 then 1 else 0);
    let _ = if gdone == 0 then (let _ = u15[0] = u15[0] + h15 in (let _ = u14[0] = u14[0] + h14 in 0)) else 0;
    let _ = gi[0] = gi[0] + 1;
    let ggo = 1 - gdone;
    0
  };
  let _ = if u15[0] == 0 then (let _ = insns[pbase + 8] = nopw in 0) else 0;
  let _ = if u14[0] == 0 then (let _ = insns[pbase + 9] = nopw in 0) else 0;
  n[0]
}

// Two-pass layout of a whole program: measure each fn's size (bl is a fixed
// 1-word size, so a placeholder-target pass yields correct sizes), compute
// start offsets by prefix sums, then re-emit with a full 3-zone table
// [cnt, names..., offsets..., srcpos...] so every bl resolves to a real offset
// AND every inline site finds the callee source position in O(#fns)
// (was: full-source rescan per call site -> superquadratic selfcompile).
// R3.x(d) literal data section: scan the source for string literals in order
// (skipping // comments), record per-literal DATA WORD offsets in
// fntab[3903+i] (code length L + cumulative cell offset), the count in
// fntab[3900], L in fntab[3901], cursor 0 in fntab[3902], total cells in
// fntab[3899]. The cells are appended after the code words once emission
// completes (write_lit_cells); emit_str turns each literal into adr x0,<imm>.
fn scan_literals(s: str, fntab: [i64], L: i64) -> i64 {
  let strn = str_len(s);
  let pos = [0];
  let lcnt = [0];
  let cum = [0];
  while pos[0] < strn {
    let c0 = char(s, pos[0]);
    let e1 = if pos[0] + 1 >= strn then 1 else 0;
    let c1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
    let is_sl = if c0 == 47 then 1 else 0;
    let is_sl2 = if c1 == 47 then 1 else 0;
    let is_cm = is_sl * is_sl2;
    let _ = if is_cm == 1 then skip_line_comment(s, pos) else 0;
    let is_q = if c0 == 34 then 1 else 0;
    let _ = if is_q == 1 then (let _ = pos[0] = pos[0] + 1 in (let _ = scan_one_lit(s, pos, fntab, L, lcnt, cum) in 0)) else 0;
    let adv = 1 - is_q - is_cm;
    let _ = pos[0] = pos[0] + adv;
    0
  };
  let _ = fntab[3900] = lcnt[0];
  let _ = fntab[3901] = L;
  let _ = fntab[3902] = 0;
  let _ = fntab[3899] = cum[0];
  cum[0]
}

// Measure + register one literal: pos is INSIDE it (just after '"'). Record
// fntab[3903 + lcnt] = L + cum, advance cum by ceil((len+1)/8) cells, move
// pos past the closing '"'.
fn scan_one_lit(s: str, pos: [i64], fntab: [i64], L: i64, lcnt: [i64], cum: [i64]) -> i64 {
  let strn = str_len(s);
  let start = pos[0];
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_q = if ch == 34 then 1 else 0;
    let adv = 1 - is_q - at_end;
    let _ = pos[0] = pos[0] + adv;
    let done = if is_q + at_end >= 1 then 1 else 0;
    0
  };
  let _ = pos[0] = pos[0] + 1;
  let len = pos[0] - start - 1;
  let cells = (len + 1 + 3) / 4;
  let _ = fntab[3903 + lcnt[0]] = L + cum[0];
  let _ = cum[0] = cum[0] + cells;
  let _ = lcnt[0] = lcnt[0] + 1;
  len
}

fn compile_program_to(s: str, insns: [i64], n: [i64]) -> i64 {
  let fnames = zeros(256);
  let fpos = zeros(256);
  let cnt = [0];
  let _ = collect_fns(s, fnames, fpos, cnt);
  let _ = if cnt[0] >= 256 then em(insns, n, 3558866944) else 0;
  let sizes = zeros(256);
  let starts = zeros(256);
  let ptab = zeros(4096);
  let _ = ptab[0] = cnt[0];
  let pm = [0];
  while pm[0] < cnt[0] {
    let _ = ptab[1 + pm[0]] = fnames[pm[0]];
    let _ = pm[0] = pm[0] + 1;
    0
  };

  let pz = [0];
  while pz[0] < cnt[0] {
    let _ = ptab[1 + cnt[0] + cnt[0] + pz[0]] = fpos[pz[0]];
    let _ = pz[0] = pz[0] + 1;
    0
  };

  let enames_pz = zeros(256);
  let ecnt_pz = [0];
  let _ = collect_ctors(s, enames_pz, ecnt_pz);
  let _ = if ecnt_pz[0] >= 256 then em(insns, n, 3558866944) else 0;
  let eb_pz = cnt[0] + cnt[0] + cnt[0] + 1;
  let _ = ptab[eb_pz] = ecnt_pz[0];
  let ez_pz = [0];
  let ed_pz = if ecnt_pz[0] == 0 then 1 else 0;
  while ed_pz == 0 {
    let _ = ptab[eb_pz + 1 + ez_pz[0]] = enames_pz[ez_pz[0]];
    let _ = ez_pz[0] = ez_pz[0] + 1;
    let ed_pz = if ez_pz[0] >= ecnt_pz[0] then 1 else 0;
    0
  };
  let stk_a = zeros(1088);
    let tmp = zeros(65536);
  let i = [0];
  while i[0] < cnt[0] {
    let tn = [0];
    let _ = compile_fn_at(s, fpos[i[0]], 0, ptab, tmp, tn, stk_a);
    let _ = sizes[i[0]] = tn[0];
    let _ = i[0] = i[0] + 1;
    0
  };
  let acc = 0;
  let k = [0];
  while k[0] < cnt[0] {
    let _ = starts[k[0]] = acc;
    let acc = acc + sizes[k[0]];
    let _ = k[0] = k[0] + 1;
    0
  };
  let fntab = zeros(4096);
  let _ = fntab[0] = cnt[0];
  let _ = scan_literals(s, fntab, acc);
  let m = [0];
  while m[0] < cnt[0] {
    let _ = fntab[1 + m[0]] = fnames[m[0]];
    let _ = fntab[1 + cnt[0] + m[0]] = starts[m[0]];
    let _ = m[0] = m[0] + 1;
    0
  };

  let fz = [0];
  while fz[0] < cnt[0] {
    let _ = fntab[1 + cnt[0] + cnt[0] + fz[0]] = fpos[fz[0]];
    let _ = fz[0] = fz[0] + 1;
    0
  };

  let enames_fz = zeros(256);
  let ecnt_fz = [0];
  let _ = collect_ctors(s, enames_fz, ecnt_fz);
  let _ = if ecnt_fz[0] >= 256 then em(insns, n, 3558866944) else 0;
  let eb_fz = cnt[0] + cnt[0] + cnt[0] + 1;
  let _ = fntab[eb_fz] = ecnt_fz[0];
  let ez_fz = [0];
  let ed_fz = if ecnt_fz[0] == 0 then 1 else 0;
  while ed_fz == 0 {
    let _ = fntab[eb_fz + 1 + ez_fz[0]] = enames_fz[ez_fz[0]];
    let _ = ez_fz[0] = ez_fz[0] + 1;
    let ed_fz = if ez_fz[0] >= ecnt_fz[0] then 1 else 0;
    0
  };
  let stk_b = zeros(1088);
  let q = [0];
  while q[0] < cnt[0] {
    let _ = compile_fn_at(s, fpos[q[0]], starts[q[0]], fntab, insns, n, stk_b);
    let _ = q[0] = q[0] + 1;
    0
  };
  // R3.x(d): append the string-literal data section after the code words.
  // Scan the source in order, write each literal's bytes (NUL-terminated)
  // into the reserved cells at insns[L + cum].
  let dcell_tot = fntab[3899];
  let dlitc = fntab[3900];
  let Lcode = n[0];
  let sp = [0];
  let dli = [0];
  let dgo = if dlitc > 0 then 1 else 0;
  while dgo == 1 {
    let strn = str_len(s);
    let c0 = if sp[0] >= strn then 0 else char(s, sp[0]);
    let e1 = if sp[0] + 1 >= strn then 1 else 0;
    let c1 = if e1 == 1 then 0 else char(s, sp[0] + 1);
    let is_sl = if c0 == 47 then 1 else 0;
    let is_sl2 = if c1 == 47 then 1 else 0;
    let is_cm = is_sl * is_sl2;
    let _ = if is_cm == 1 then skip_line_comment(s, sp) else 0;
    let is_q = if c0 == 34 then 1 else 0;
    let adv = 1 - is_q - is_cm;
    let _ = sp[0] = sp[0] + adv;
    let _ = if is_q == 1 then (let _ = sp[0] = sp[0] + 1 in (let _ = write_lit_cells(s, sp, insns, fntab, dli) in 0)) else 0;
    let dgo = if dli[0] >= dlitc then 0 else 1;
    0
  };
  let _ = n[0] = Lcode + dcell_tot;
  sum_words(insns, n[0])
}

// Write literal li's bytes into cells starting at data word fntab[3903+li].
// sp points INSIDE the literal (just after '"'). Advances sp past '"',
// bumps dli. The trailing cell's unused bytes stay 0 -> NUL termination.
fn write_lit_cells(s: str, sp: [i64], insns: [i64], fntab: [i64], dli: [i64]) -> i64 {
  let strn = str_len(s);
  let start = sp[0];
  let done = 0;
  while done == 0 {
    let at_end = if sp[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, sp[0]);
    let is_q = if ch == 34 then 1 else 0;
    let adv = 1 - is_q - at_end;
    let _ = sp[0] = sp[0] + adv;
    let done = if is_q + at_end >= 1 then 1 else 0;
    0
  };
  let _ = sp[0] = sp[0] + 1;
  let len = sp[0] - start - 1;
  let base = fntab[3903 + dli[0]];
  let j = 0;
  while j < len {
    let b = char(s, start + j);
    let cidx = j / 4;
    let sh = (j - cidx * 4) * 8;
    let _ = insns[base + cidx] = insns[base + cidx] + (b << sh);
    let j = j + 1;
    0
  };
  let _ = dli[0] = dli[0] + 1;
  len
}

// Convenience wrapper: compile a whole program to a fresh buffer and return the
// checksum of its words (kept for self_check regression tests).
fn compile_program(s: str) -> i64 {
  let insns = zeros(262144);
  let n = [0];
  let r = compile_program_to(s, insns, n);
  r
}


// Verify the emitted machine code against frozen checksums of the fixpoint-green
// self-hosted emitter (T44: re-frozen 2026-09-04; exec-based run checks removed --
// `exec` is not a builtin here, post-C execution is `seed <bin>`). 0 = pass.
fn self_check() -> i64 {
let c1 = if compile("42") == 21426575550 then 0 else 1;
let c2 = if compile("1+2") == 21426574302 then 0 else 1;
let c3 = if compile("1+2*3") == 38157695836 then 0 else 1;
let c4 = if compile("2*(3+4)") == 56155582491 then 0 else 1;
let c5 = if compile("8/2-1") == 73956217849 then 0 else 1;
let c6 = if compile("if 1 then 10 else 20") == 56260325310 then 0 else 1;
let c7 = if compile("if 0 then 10 else 20") == 56260325278 then 0 else 1;
let c8 = if compile("1 + if 2 then 3 else 4") == 90720865435 then 0 else 1;
let c9 = if compile("if 1 then 1+2 else 3*4") == 56260324830 then 0 else 1;
let c10 = if compile_fn("fn f(a) { a + 1 }") == 87633445511 then 0 else 1;
let c11 = if compile_fn("fn f(a,b) { a + b }") == 107536897562 then 0 else 1;
let c12 = if compile("1<2") == 60091882330 then 0 else 1;
let c13 = if compile("3==3") == 60091845562 then 0 else 1;
let c14 = if compile("2>3") == 60091894682 then 0 else 1;
let c15 = if compile("1+2<4") == 60091882458 then 0 else 1;
let c16 = if compile("5==2+3") == 60091845690 then 0 else 1;
let c17 = if compile_fn("fn f() { let a = 1; a + 2 }") == 105463469669 then 0 else 1;
let c18 = if compile_fn("fn f(a) { let b = a + 1; b * 2 }") == 142366438870 then 0 else 1;
let c19 = if compile_fn("fn main() { f(41) } fn f(a) { a + 1 }") == 120440118832 then 0 else 1;
let c20 = if compile_fn("fn main() { s(6) } fn s(a) { a * a }") == 119928510961 then 0 else 1;
let c21 = if compile_fn("fn main() { g(3,4) } fn g(a,b) { a + b }") == 140343439874 then 0 else 1;
let c22 = if compile_fn("fn main() { foo(41) } fn foo(x) { x + 1 }") == 105462224741 then 0 else 1;
let c23 = if compile_fn("fn main() { let acc = 10; let delta = 5; acc + delta }") == 143196878710 then 0 else 1;
let c24 = if compile_fn("fn main() { foo(3,4) } fn foo(a,b) { a + b }") == 143195633270 then 0 else 1;
let c25 = if compile_fn("fn main() { let total = 0; let extra = 7; total + extra * 2 }") == 177925886515 then 0 else 1;
let c26 = if compile_fn("fn main() { let p = pt { x: 1, y: 2 }; p.x + p.y } struct pt { x: i64, y: i64 }") == 212182316249 then 0 else 1;
let c27 = if compile_fn("fn main() { pt { x: 1, y: 2 } } struct pt { x: i64, y: i64 }") == 209330188518 then 0 else 1;
let c28 = if compile_fn("fn main(p) { p.x + p.y } struct pt { x: i64, y: i64 }") == 141644920226 then 0 else 1;
let c29 = if compile_fn("fn main() { some(5) } enum opt { none, some }") == 100199269538 then 0 else 1;
let c30 = if compile_fn("fn main() { none } enum opt { none, some }") == 78191717988 then 0 else 1;
let c31 = if compile_fn("fn main() { match some(5) { none => 0, some(x) => x + 1 } } enum opt { none, some }") == 105463468773 then 0 else 1;
let c32 = if compile_fn("fn main() { match none { none => 0, some(x) => x + 1 } } enum opt { none, some }") == 68728432374 then 0 else 1;
let c33 = if compile_fn("fn fact(n) { if n <= 1 then 1 else n * fact(n-1) }") == 243444346142 then 0 else 1;
let c34 = if compile_fn("fn main() { let i = 0; let acc = 0; while i < 5 { let acc = acc + i; let i = i + 1; 0 }; acc }") == 279438272540 then 0 else 1;
let c35 = if compile_program("fn main() { helper(41) } fn helper(x) { x + 1 }") == 219691780395 then 0 else 1;
let c36 = if compile_program("fn main() { add(3,4) } fn add(a,b) { a + b }") == 257425254461 then 0 else 1;
  c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15 + c16 + c17 + c18 + c19 + c20 + c21 + c22 + c23 + c24 + c25 + c26 + c27 + c28 + c29 + c30 + c31 + c32 + c33 + c34 + c35 + c36
}


fn emit_expr_words(src: str) -> [i64] {
  let insns = zeros(8192);
  let n = [0];
  let pos = [0];
  let stab = zeros(512);
  let selfname = 0 - 1;
  let selfstart = 0;
  let fnames_l = zeros(512);
  let fpos_l = zeros(512);
  let cnt_l = [0];
  let _ = collect_fns(src, fnames_l, fpos_l, cnt_l);
  let fntab = zeros(4096);
  let _ = fntab[0] = cnt_l[0];
  let fl_i = [0];
  let fl_d = if cnt_l[0] == 0 then 1 else 0;
  while fl_d == 0 {
    let _ = fntab[1 + fl_i[0]] = fnames_l[fl_i[0]];
    let _ = fntab[1 + cnt_l[0] + cnt_l[0] + fl_i[0]] = fpos_l[fl_i[0]];
    let _ = fl_i[0] = fl_i[0] + 1;
    let fl_d = if fl_i[0] >= cnt_l[0] then 1 else 0;
    0
  };
  let enames_l = zeros(512);
  let ecnt_l = zeros(16);
  let _ = collect_ctors(src, enames_l, ecnt_l);
  let eb_l = cnt_l[0] + cnt_l[0] + cnt_l[0] + 1;
  let _ = fntab[eb_l] = ecnt_l[0];
  let ez_l = [0];
  let ezd_l = if ecnt_l[0] == 0 then 1 else 0;
  while ezd_l == 0 {
    let _ = fntab[eb_l + 1 + ez_l[0]] = enames_l[ez_l[0]];
    let _ = ez_l[0] = ez_l[0] + 1;
    let ezd_l = if ez_l[0] >= ecnt_l[0] then 1 else 0;
    0
  };
  let _ = emit_cmp(src, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = pop(insns, n, 0, fntab);
  let _ = em(insns, n, 3596551104);
  let out = zeros(n[0] + 1);
  let _ = out[0] = n[0];
  let pk = [0];
  let pgo = 1;
  while pgo == 1 {
    let pdone = if pk[0] >= n[0] then 1 else 0;
    let _ = if pdone == 0 then (let _ = out[pk[0] + 1] = insns[pk[0]] in 0) else 0;
    let _ = pk[0] = pk[0] + 1;
    let pgo = 1 - pdone;
    0
  };
  out
}


// ---- M3 SELF-BOOTSTRAP ----
// Reads Bebop source from a fixed path into the arena, compiles it with
// THIS compiler (emit_words over a raw pointer), returns word checksum.
// Entry for beboSelf.bin: the frozen compiler compiling other programs.
// BENCH: two-pass compile of a whole fn-main program; returns [count, words...]
fn emit_words(src: str) -> [i64] {
  let insns = zeros(262144);
  let n = [0];
  let _ = compile_program_to(src, insns, n);
  let out = zeros(n[0] + 1);
  let _ = out[0] = n[0];
  let k = [0];
  let go = 1;
  while go == 1 {
    let done = if k[0] >= n[0] then 1 else 0;
    let _ = if done == 0 then (let _ = out[k[0] + 1] = insns[k[0]] in 0) else 0;
    let _ = k[0] = k[0] + 1;
    let go = 1 - done;
    0
  };
  out
}

// BENCH: offsets of each fn (source order) within the compiled word stream.
fn emit_offsets(src: str) -> [i64] {
  let offs = zeros(256);
  let insns = zeros(262144);
  let n = [0];
  let fnames = zeros(512);
  let fpos = zeros(512);
  let cnt = zeros(1024);
  let _ = collect_fns(src, fnames, fpos, cnt);
  let sizes = zeros(512);
  let starts = zeros(512);
  let ptab = zeros(512);
  let _ = ptab[0] = cnt[0];
  let pm = zeros(1024);
  while pm[0] < cnt[0] {
    let _ = ptab[1 + pm[0]] = fnames[pm[0]];
    let _ = pm[0] = pm[0] + 1;
    0
  };

  let pz = zeros(1024);
  while pz[0] < cnt[0] {
    let _ = ptab[1 + cnt[0] + cnt[0] + pz[0]] = fpos[pz[0]];
    let _ = pz[0] = pz[0] + 1;
    0
  };

  let enames_pz = zeros(512);
  let ecnt_pz = zeros(1024);
  let _ = collect_ctors(src, enames_pz, ecnt_pz);
  let eb_pz = cnt[0] + cnt[0] + cnt[0] + 1;
  let _ = ptab[eb_pz] = ecnt_pz[0];
  let ez_pz = zeros(1024);
  let ed_pz = if ecnt_pz[0] == 0 then 1 else 0;
  while ed_pz == 0 {
    let _ = ptab[eb_pz + 1 + ez_pz[0]] = enames_pz[ez_pz[0]];
    let _ = ez_pz[0] = ez_pz[0] + 1;
    let ed_pz = if ez_pz[0] >= ecnt_pz[0] then 1 else 0;
    0
  };
  let i = zeros(1024);
  while i[0] < cnt[0] {
    let tmp = zeros(65536);
    let tn = zeros(1024);
    // T48a (2026-09-05): the planning pass passed SIX args to a 7-param fn (the
    // token buffer came from whatever x6 held) -- found by tools/typecheck.py
    let stk_o = zeros(1088);
    let _ = compile_fn_at(src, fpos[i[0]], 0, ptab, tmp, tn, stk_o);
    let _ = sizes[i[0]] = tn[0];
    let _ = i[0] = i[0] + 1;
    0
  };
  let acc = 0;
  let k = zeros(1024);
  while k[0] < cnt[0] {
    let _ = starts[k[0]] = acc;
    let acc = acc + sizes[k[0]];
    let _ = k[0] = k[0] + 1;
    0
  };
  let fntab = zeros(4096);
  let _ = fntab[0] = cnt[0];
  let _ = scan_literals(src, fntab, acc);
  let m = zeros(1024);
  while m[0] < cnt[0] {
    let _ = fntab[1 + m[0]] = fnames[m[0]];
    let _ = fntab[1 + cnt[0] + m[0]] = starts[m[0]];
    let _ = m[0] = m[0] + 1;
    0
  };

  let fz = zeros(1024);
  while fz[0] < cnt[0] {
    let _ = fntab[1 + cnt[0] + cnt[0] + fz[0]] = fpos[fz[0]];
    let _ = fz[0] = fz[0] + 1;
    0
  };

  let enames_fz = zeros(512);
  let ecnt_fz = zeros(1024);
  let _ = collect_ctors(src, enames_fz, ecnt_fz);
  let eb_fz = cnt[0] + cnt[0] + cnt[0] + 1;
  let _ = fntab[eb_fz] = ecnt_fz[0];
  let ez_fz = zeros(1024);
  let ed_fz = if ecnt_fz[0] == 0 then 1 else 0;
  while ed_fz == 0 {
    let _ = fntab[eb_fz + 1 + ez_fz[0]] = enames_fz[ez_fz[0]];
    let _ = ez_fz[0] = ez_fz[0] + 1;
    let ed_fz = if ez_fz[0] >= ecnt_fz[0] then 1 else 0;
    0
  };
  let stk_p = zeros(1088);
  let q = zeros(1024);
  while q[0] < cnt[0] {
    let _ = offs[q[0]] = n[0];
    let _ = compile_fn_at(src, fpos[q[0]], starts[q[0]], fntab, insns, n, stk_p);
    let _ = q[0] = q[0] + 1;
    0
  };
    let out = zeros(cnt[0] + 1);
  let _ = out[0] = cnt[0];
  let oz = [0];
  let ogo = 1;
  while ogo == 1 {
    let odone = if oz[0] >= cnt[0] then 1 else 0;
    let _ = if odone == 0 then (let _ = out[oz[0] + 1] = offs[oz[0]] in 0) else 0;
    let _ = oz[0] = oz[0] + 1;
    let ogo = 1 - odone;
    0
  };
  out
}

// ══════════════════════════════════════════════════════════════════════
// FAST PATH (OPT-C/D): virtual-register codegen for pure arithmetic,
// variable and literal subtrees. Everything else falls back to the
// legacy stack machine by resetting n[0] and pos[0] -- the insn buffer
// is append-only, so a failed attempt rolls back by counter alone.
//
// Virtual registers by expression depth: 0->x0, 1->x1, 2..6->x9..x13.
// Depth >= 7 or any non-arithmetic construct -> legacy path.
//
// Constant tracking (OPT-C): cx[10+d]=value, cx[30+d]=known-flag; when
// both operands of an op are known the operation is computed at compile
// time and NO instruction is emitted for it.
// ══════════════════════════════════════════════════════════════════════

// Register number for expression depth d (-1 => beyond fast capacity).
fn emit_zeros(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 1, fntab);
  // lsl x1,x1,#3 (bytes): assembler-verified 0xD37DF421? no —
  // 0xD3400000-family UBFM alias; 3548246049 == true LSL #3.
  let _ = em(insns, n, 3548246049);
  let _ = em(insns, n, 2432711713);
  let _ = em(insns, n, 3544513569);
  let _ = em(insns, n, 3548179489);
  let _ = em(insns, n, 2334065504);
  let _ = em(insns, n, 2332099451);
  // T118 (D11-D, 2026-09-05): arena capacity trap -- cmp x27,x28 ; b.ls +4 ;
  // mov x0,#80 ; mov x8,#94 ; svc  (exit 80 = arena exhausted, was a silent
  // walk past the mapping and a SIGSEGV later)
  let _ = em(insns, n, 3944481663);
  let _ = em(insns, n, 1409286281);
  let _ = em(insns, n, 3531606528);
  let _ = em(insns, n, 3531606984);
  let _ = em(insns, n, 3556769793);
  // Interpreter zeros(n) zeroes every element (qtt.c TERM_ZEROS eval); the
  // JIT must too: exec_words resets the bump-arena cursor to its base on
  // every call_jit, so a second invocation re-allocates the SAME addresses
  // and would observe stale counts/pointers (stab[0] garbage -> sym_lookup
  // runs away). Zero the rounded region: mov x2,x0; add x3,x0,x1;
  // cbz x1,+3; str xzr,[x2],#8; cmp x2,x3; b.ne -2. All assembler-verified.
  let _ = em(insns, n, 2852127714);
  let _ = em(insns, n, 2332098563);
  let _ = em(insns, n, 3019899009);
  let _ = em(insns, n, 4160783455);
  let _ = em(insns, n, 3942842463);
  let _ = em(insns, n, 1426063297);
  let _ = push(insns, n, fntab);
  n[0]
}

// ---------- M4 CLI (bebop.bin) ----------
// Subcommands: compile <src.bp> <out.bin> | size <file> | version | run-via-exec <src.bp>
// Args contract (seed loader v4): x0 = argc, x1 = pointer array of
// NUL-terminated argument strings copied into the bump arena.

fn strequals(s: str, p: [i64]) -> i64 {
  let i = 0;
  let same = 1;
  let done = 0;
  while done == 0 {
    let c = char(s, i);
    let pc = p[i];
    let isz = if c == 0 then 1 else 0;
    let mdiff = if c == pc then 0 else 1;
    let snew = if isz == 1 then same else same * (1 - mdiff);
    let same = snew;
    let i = i + 1;
    let done = isz;
    0
  };
  same
}

// Copy a NUL-terminated byte string into cell slots (byte per element) —
// sys_open's path contract is a CELL buffer, argv strings are BYTE strings.
// T108 .becache (2026-09-05): `<out>.becache` = [compiler bytes][expanded source
// bytes]. A compile whose compiler binary (argv[1]), expanded source and existing
// <out> are byte-identical to that record returns before emit_words. No hash: the
// key is the exact bytes, so a hit can never be a collision (D11 honesty floor).
// Streamed in 8192-byte chunks (two scratch buffers, no arena growth: a 1M-cell
// buffer tripped the arena trap 80). Publish mode (argc >= 6) bypasses the cache.
// chunk_eq(ta, tb, n): 1 iff the first n cells agree.
fn chunk_eq(ta: [i64], tb: [i64], n: i64) -> i64 {
  let ok = 1;
  let k = 0;
  while k < n * ok {
    let ok = if ta[k] == tb[k] then 1 else 0;
    let k = k + 1;
    0
  };
  ok
}
// cache_hit(cfd, kfd, srcv): the cache stream == compiler stream ++ source bytes, exactly.
fn cache_hit(cfd: i64, kfd: i64, srcv: str, ta: [i64], tb: [i64]) -> i64 {
  let ok = 1;
  let go = 1;
  while go == 1 {
    let rk = sys_read(kfd, tb, 8192);
    let rc = if rk > 0 then sys_read(cfd, ta, rk) else 0;
    let ok = if rk > 0 then (if rc == rk then chunk_eq(ta, tb, rk) else 0) else ok;
    let go = if rk > 0 then ok else 0;
    0
  };
  let sl = str_len(srcv);
  let off = 0;
  while off < sl * ok {
    let want = if sl - off < 8192 then sl - off else 8192;
    let rc = sys_read(cfd, ta, want);
    let ok = if rc == want then 1 else 0;
    let k = 0;
    while k < rc * ok {
      let ok = if ta[k] == char(srcv, off + k) then 1 else 0;
      let k = k + 1;
      0
    };
    let off = off + want;
    0
  };
  let tail = if ok == 1 then sys_read(cfd, ta, 8192) else 1;
  if tail == 0 then ok else 0
}
// cache_write(cfd, kfd, srcv): stream the compiler bytes then the source bytes.
fn cache_write(cfd: i64, kfd: i64, srcv: str, ta: [i64]) -> i64 {
  let go = 1;
  while go == 1 {
    let rk = sys_read(kfd, ta, 8192);
    let _ = if rk > 0 then sys_write(cfd, ta, rk) else 0;
    let go = if rk > 0 then 1 else 0;
    0
  };
  let sl = str_len(srcv);
  let off = 0;
  while off < sl {
    let want = if sl - off < 8192 then sl - off else 8192;
    let k = 0;
    while k < want {
      let _ = ta[k] = char(srcv, off + k);
      let k = k + 1;
      0
    };
    let _ = sys_write(cfd, ta, want);
    let off = off + want;
    0
  };
  0
}

fn str_to_cells(dst: [i64], src: str) -> i64 {
  let i = 0;
  let done = 0;
  while done == 0 {
    let c = char(src, i);
    let isz = if c == 0 then 1 else 0;
    let _ = if isz == 0 then (let _ = dst[i] = c in 0) else 0;
    let i = i + 1;
    let done = isz;
    0
  };
  i
}

fn fill_compile(p: [i64]) -> i64 {
  let _ = p[0] = 99; let _ = p[1] = 111; let _ = p[2] = 109; let _ = p[3] = 112; let _ = p[4] = 105; let _ = p[5] = 108; let _ = p[6] = 101;
  7
}
fn fill_size(p: [i64]) -> i64 {
  let _ = p[0] = 115; let _ = p[1] = 105; let _ = p[2] = 122; let _ = p[3] = 101;
  4
}
fn fill_version(p: [i64]) -> i64 {
  let _ = p[0] = 118; let _ = p[1] = 101; let _ = p[2] = 114; let _ = p[3] = 115; let _ = p[4] = 105; let _ = p[5] = 111; let _ = p[6] = 110;
  7
}
fn fill_run(p: [i64]) -> i64 {
  let _ = p[0] = 114; let _ = p[1] = 117; let _ = p[2] = 110; let _ = p[3] = 45; let _ = p[4] = 118; let _ = p[5] = 105; let _ = p[6] = 97; let _ = p[7] = 45; let _ = p[8] = 101; let _ = p[9] = 120; let _ = p[10] = 101; let _ = p[11] = 99;
  12
}

fn idx_of_main(fnames: [i64], cnt: i64) -> i64 {
  let k = 0;
  let idx = 0;
  while k < cnt {
    let ism = if fnames[k] == 246720401 then 1 else 0;
    let idx = if ism == 1 then k else idx;
    let k = k + 1;
    0
  };
  idx
}

// ---- T47 (2026-09-05): `use "path"` textual inclusion, one level, deduped ----
// cli_compile scans the main source for lines that start with `use "` (column
// 0), reads each named file ONCE (path hash = sum(byte*131) over the path, kept
// in a 64-entry table), and builds one byte buffer: every included file in
// order of first use, then the main source with each `use` line turned into a
// `//` comment (positions inside the main text are unchanged). The buffer is
// exported to <out>.use and slurped back, so every later stage (emit_words,
// emit_offsets, collect_fns) sees one string. Nested `use` inside an included
// file is not followed (documented; T47b).
fn use_path_hash(cells: [i64], n: i64) -> i64 {
  let i = 0;
  let h = 0;
  while i < n {
    let h = h * 131 + cells[i];
    let i = i + 1;
    0
  };
  h
}

// Copy the bytes of str src (NUL-terminated) into dst cells at off; returns the new off.
fn use_append_str(dst: [i64], off: i64, src: str) -> i64 {
  let i = 0;
  let done = 0;
  while done == 0 {
    let c = char(src, i);
    let isz = if c == 0 then 1 else 0;
    let _ = if isz == 0 then (let _ = dst[off + i] = c in 0) else 0;
    let i = i + 1;
    let done = isz;
    0
  };
  off + i - 1
}

// Expand `use` lines of srcv into a fresh source string (or return srcv when
// there are none). tmpc/tmpl = the scratch file path cells/length.
fn use_expand(srcv: str, tmpc: [i64], tmpl: i64) -> str {
  let strn = str_len(srcv);
  let seen = zeros(64);
  let nseen = zeros(1);
  let buf = zeros(1600000);
  let off = zeros(1);
  let pathc = zeros(512);
  let i = 0;
  let bol = 1;
  let nuse = 0;
  while i < strn {
    let c = char(srcv, i);
    let is_use = bol * (if c == 117 then 1 else 0) * (if char(srcv, i + 1) == 115 then 1 else 0) * (if char(srcv, i + 2) == 101 then 1 else 0) * (if char(srcv, i + 3) == 32 then 1 else 0) * (if char(srcv, i + 4) == 34 then 1 else 0);
    // read the path
    let j = i + 5;
    let pl = 0;
    let go = is_use;
    while go == 1 {
      let pc = char(srcv, j + pl);
      let end = (if pc == 34 then 1 else 0) + (if pc == 0 then 1 else 0) + (if pc == 10 then 1 else 0);
      let _ = if end == 0 then (let _ = pathc[pl] = pc in 0) else 0;
      let pl = pl + (1 - end);
      let go = 1 - end;
      0
    };
    let h = if is_use == 1 then use_path_hash(pathc, pl) else 0;
    let k = 0;
    let dup = 0;
    while k < nseen[0] {
      let dup = dup + (if seen[k] == h then 1 else 0);
      let k = k + 1;
      0
    };
    let fresh = is_use * (if dup == 0 then 1 else 0) * (if nseen[0] < 64 then 1 else 0);
    let _ = if fresh == 1 then (let _ = seen[nseen[0]] = h in (let _ = nseen[0] = nseen[0] + 1 in 0)) else 0;
    let fd = if fresh == 1 then sys_open(pathc, pl, 0) else 0 - 1;
    let _ = if fd < 0 then (if fresh == 1 then sys_exit(90) else 0) else 0;
    let inc = if fresh == 1 then sys_slurp(fd, 400000) else srcv;
    let _ = if fresh == 1 then sys_close(fd) else 0;
    let _ = if fresh == 1 then (let _ = off[0] = use_append_str(buf, off[0], inc) in 0) else 0;
    let _ = if fresh == 1 then (let _ = buf[off[0]] = 10 in (let _ = off[0] = off[0] + 1 in 0)) else 0;
    let nuse = nuse + is_use;
    let bol = if c == 10 then 1 else 0;
    let i = i + 1;
    0
  };
  // main text, with every `use` line commented out in place
  let base = off[0];
  let _ = off[0] = use_append_str(buf, base, srcv);
  let m = 0;
  let bol2 = 1;
  while m < strn {
    let c = char(srcv, m);
    let is_use = bol2 * (if c == 117 then 1 else 0) * (if char(srcv, m + 1) == 115 then 1 else 0) * (if char(srcv, m + 2) == 101 then 1 else 0) * (if char(srcv, m + 3) == 32 then 1 else 0) * (if char(srcv, m + 4) == 34 then 1 else 0);
    let _ = if is_use == 1 then (let _ = buf[base + m] = 47 in (let _ = buf[base + m + 1] = 47 in 0)) else 0;
    let bol2 = if c == 10 then 1 else 0;
    let m = m + 1;
    0
  };
  let total = off[0];
  let ofd = if nuse > 0 then sys_open(tmpc, tmpl, 578) else 0 - 1;
  let _ = if nuse > 0 then sys_export(ofd, buf, total) else 0;
  let _ = if nuse > 0 then sys_close(ofd) else 0;
  let rfd = if nuse > 0 then sys_open(tmpc, tmpl, 0) else 0 - 1;
  let out = if nuse > 0 then sys_slurp(rfd, 1600000) else srcv;
  let _ = if nuse > 0 then sys_close(rfd) else 0;
  out
}

fn cli_compile(argc: i64, argv: [str]) -> i64 {
  let src = argv[3];
  let out = argv[4];
  let ls = str_len(src);
  let lo = str_len(out);
  let psrc = zeros(ls + 1);
  let pout = zeros(lo + 1);
  let _ = str_to_cells(psrc, src);
  let _ = str_to_cells(pout, out);
  let fd = sys_open(psrc, ls, 0);
  let srcv0 = sys_slurp(fd, 400000);
  let _ = sys_close(fd);
  // T47: `<out>.use` is the scratch file of the expansion (rewritten each compile)
  let tmpc = zeros(lo + 5);
  let _ = str_to_cells(tmpc, out);
  let _ = tmpc[lo] = 46;
  let _ = tmpc[lo + 1] = 117;
  let _ = tmpc[lo + 2] = 115;
  let _ = tmpc[lo + 3] = 101;
  let srcv = use_expand(srcv0, tmpc, lo + 4);
  let cpath = zeros(lo + 9);
  let _ = str_to_cells(cpath, out);
  let _ = cpath[lo] = 46;
  let _ = cpath[lo + 1] = 98;
  let _ = cpath[lo + 2] = 101;
  let _ = cpath[lo + 3] = 99;
  let _ = cpath[lo + 4] = 97;
  let _ = cpath[lo + 5] = 99;
  let _ = cpath[lo + 6] = 104;
  let _ = cpath[lo + 7] = 101;
  let lc = str_len(argv[1]);
  let pcomp = zeros(lc + 1);
  let _ = str_to_cells(pcomp, argv[1]);
  let ta = zeros(8192);
  let tb = zeros(8192);
  let nocache = if argc >= 6 then 1 else 0;
  let ofd0 = if nocache == 1 then 0 - 1 else sys_open(pout, lo, 0);
  let cfd0 = if ofd0 >= 0 then sys_open(cpath, lo + 8, 0) else 0 - 1;
  let kfd0 = if cfd0 >= 0 then sys_open(pcomp, lc, 0) else 0 - 1;
  let hit = if kfd0 >= 0 then cache_hit(cfd0, kfd0, srcv, ta, tb) else 0;
  let _ = if ofd0 >= 0 then sys_close(ofd0) else 0;
  let _ = if cfd0 >= 0 then sys_close(cfd0) else 0;
  let _ = if kfd0 >= 0 then sys_close(kfd0) else 0;
  while hit == 1 {
    return 0;
    0
  };
  let words = emit_words(srcv);
  let n = words[0];
  let offs = emit_offsets(srcv);
  let fnames = zeros(256);
  let fpos = zeros(256);
  let cnt = [0];
  let _ = collect_fns(srcv, fnames, fpos, cnt);
  let entry = offs[idx_of_main(fnames, cnt[0]) + 1];
  let e4 = entry * 4;
  let nb = n * 4 + 8;
  let buf = zeros(nb);
  let k = 0;
  while k < n {
    let w = words[k + 1];
    let _ = buf[k * 4] = w & 255;
    let _ = buf[k * 4 + 1] = (w >> 8) & 255;
    let _ = buf[k * 4 + 2] = (w >> 16) & 255;
    let _ = buf[k * 4 + 3] = (w >> 24) & 255;
    let k = k + 1;
    0
  };
  let _ = buf[n * 4] = e4 & 255;
  let _ = buf[n * 4 + 1] = (e4 >> 8) & 255;
  let _ = buf[n * 4 + 2] = (e4 >> 16) & 255;
  let _ = buf[n * 4 + 3] = (e4 >> 24) & 255;
  let _ = buf[n * 4 + 4] = (e4 >> 32) & 255;
  let _ = buf[n * 4 + 5] = (e4 >> 40) & 255;
  let _ = buf[n * 4 + 6] = (e4 >> 48) & 255;
  let _ = buf[n * 4 + 7] = (e4 >> 56) & 255;
  // F2 atomic publish (Ф6): argv[5] = tmp path (when argc >= 6) - export the
  // artifact to tmp via mmap (ftruncate + MAP_SHARED stores, NO sys_write on
  // the artifact path), close, then renameat(tmp, out): the artifact appears
  // atomically - readers never observe a partially-written .bin. Without
  // argv[5]: direct export to out.
  let rc2 = 0;
  let publish = if argc >= 6 then 1 else 0;
  let ptmp = zeros(256);
  let ptl = [0];
  let _ = if publish == 1 then (let _ = ptl[0] = str_len(argv[5]) in 0) else 0;
  let _ = if publish == 1 then str_to_cells(ptmp, argv[5]) else 0;
  let tg = if publish == 1 then ptmp else pout;
  let tl = if publish == 1 then ptl[0] else lo;
  let ofd = sys_open(tg, tl, 578);
  let rc2 = sys_export(ofd, buf, nb);
  let _ = sys_close(ofd);
  let kfd1 = if nocache == 1 then 0 - 1 else sys_open(pcomp, lc, 0);
  let cfd1 = if kfd1 >= 0 then sys_open(cpath, lo + 8, 578) else 0 - 1;
  let _ = if cfd1 >= 0 then cache_write(cfd1, kfd1, srcv, ta) else 0;
  let _ = if cfd1 >= 0 then sys_close(cfd1) else 0;
  let _ = if kfd1 >= 0 then sys_close(kfd1) else 0;
  let rn = if publish == 1 then sys_rename(ptmp, ptl[0], pout, lo) else 0;
  rc2 * 10 + rn
}

fn cli_size(argv: [str]) -> i64 {
  let f = argv[3];
  let lf = str_len(f);
  let pf = zeros(lf + 1);
  let _ = str_to_cells(pf, f);
  let fd = sys_open(pf, lf, 0);
  let buf = zeros(8192);
  let total = [0];
  let nr = sys_read(fd, buf, 8192);
  let _ = total[0] = total[0] + nr;
  let done = if nr > 0 then 0 else 1;
  while done == 0 {
    let nr2 = sys_read(fd, buf, 8192);
    let _ = total[0] = total[0] + nr2;
    let done = if nr2 > 0 then 0 else 1;
    0
  };
  let _ = sys_close(fd);
  total[0] / 4
}

fn cli_run(argv: [str]) -> i64 {
  // run-via-exec needs the C-side exec builtin (not in the self-hosted
  // emitter); post-C execution = `seed <compiled.bin>`. Return 2.
  2
}

// sys_ftruncate(fd,len): ftruncate — mmap-export path (F2).
fn emit_sys_ftruncate(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  em(insns, n, 3531605448);
  em(insns, n, 3556769793);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_munmap(addr,len): munmap — mmap-export path (F2).
fn emit_sys_munmap(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  em(insns, n, 3531610856);
  em(insns, n, 3556769793);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_export(fd, cells, len): F2 mmap-export — ftruncate, mmap the file,
// store low bytes of cells directly into the mapped region (NO scratch, NO
// sys_write), munmap. Returns 0. objdump-verified 2026-09-01.
fn emit_sys_export(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 2, fntab);
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  em(insns, n, 2852127723);
  em(insns, n, 2852193260);
  em(insns, n, 2852258797);
  em(insns, n, 2852848608);
  em(insns, n, 2852979681);
  em(insns, n, 3531605448);
  em(insns, n, 3556769793);
  em(insns, n, 2854159328);
  em(insns, n, 2852979681);
  em(insns, n, 3531604066);
  em(insns, n, 3531604003);
  em(insns, n, 2852848612);
  em(insns, n, 2854159333);
  em(insns, n, 3531611080);
  em(insns, n, 3556769793);
  em(insns, n, 2852127722);
  em(insns, n, 2854159337);
  em(insns, n, 3943498047);
  em(insns, n, 1409286314);
  em(insns, n, 4167661959);
  em(insns, n, 942238023);
  em(insns, n, 2432697641);
  em(insns, n, 402653179);
  em(insns, n, 2852783072);
  em(insns, n, 2852979681);
  em(insns, n, 3531610856);
  em(insns, n, 3556769793);
  em(insns, n, 2854159328);
  let _ = push(insns, n, fntab);
  n[0]
}

fn emit_sys_mmap(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 5, fntab);
  let _ = pop(insns, n, 4, fntab);
  let _ = pop(insns, n, 3, fntab);
  let _ = pop(insns, n, 2, fntab);
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  em(insns, n, 3531611080);
  em(insns, n, 3556769793);
  let _ = push(insns, n, fntab);
  n[0]
}

// sys_rename(old, oldlen, new, newlen): pack both byte-per-cell paths into
// the IO scratch zone (x28-8192, offsets 0..oldlen and oldlen+1..) with NUL
// termination (like sys_open), then renameat(AT_FDCWD, old, AT_FDCWD, new).
// Register table: x0=old ptr (pop0), x1=old len (pop1), x2=new ptr (pop2),
// x3=new len (pop3); x11/x13/x16/x12 hold the four args across packing;
// x10=scratch base old, x17=scratch base new, x9=loop i, x7=byte temp;
// x8=38 renameat; return errno-style negative on failure.
fn emit_sys_rename(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 3, fntab);
  let _ = pop(insns, n, 2, fntab);
  let _ = pop(insns, n, 1, fntab);
  let _ = pop(insns, n, 0, fntab);
  em(insns, n, 2852127723);
  em(insns, n, 2852193261);
  em(insns, n, 2852258800);
  em(insns, n, 2852324332);
  em(insns, n, 3531866122);
  em(insns, n, 3406431114);
  em(insns, n, 3531603977);
  em(insns, n, 3943498047);
  em(insns, n, 1409286314);
  em(insns, n, 4167661927);
  em(insns, n, 942238023);
  em(insns, n, 2432697641);
  em(insns, n, 402653179);
  em(insns, n, 942500191);
  em(insns, n, 2852783089);
  em(insns, n, 2332885553);
  em(insns, n, 2432697905);
  em(insns, n, 3531603977);
  em(insns, n, 3943432511);
  em(insns, n, 1409286314);
  em(insns, n, 4167662087);
  em(insns, n, 942238247);
  em(insns, n, 2432697641);
  em(insns, n, 402653179);
  em(insns, n, 942434879);
  em(insns, n, 2457865312);
  em(insns, n, 2852783073);
  em(insns, n, 2457865314);
  em(insns, n, 2853241827);
  em(insns, n, 3531605192);
  em(insns, n, 3556769793);
  let _ = push(insns, n, fntab);
  n[0]
}


fn main(argc: i64, argv: [str]) -> i64 {
  let cmd = if argc >= 3 then argv[2] else 0;
  let bcmp = zeros(16);
  let bsize = zeros(8);
  let bver = zeros(8);
  let brun = zeros(16);
  let _ = fill_compile(bcmp);
  let _ = fill_size(bsize);
  let _ = fill_version(bver);
  let _ = fill_run(brun);
  let is_compile = if argc >= 3 then strequals(cmd, bcmp) else 0;
  let is_size = if argc >= 3 then strequals(cmd, bsize) else 0;
  let is_version = if argc >= 3 then strequals(cmd, bver) else 0;
  let is_run = if argc >= 3 then strequals(cmd, brun) else 0;
  let r1 = if is_compile == 1 then cli_compile(argc, argv) else 0;
  let r2 = if is_size == 1 then cli_size(argv) else 0;
  let r3 = if is_run == 1 then cli_run(argv) else 0;
  let r4 = if is_version == 1 then 1000000 else 0;
  let known = is_compile + is_size + is_version + is_run;
  let r5 = if known == 0 then 64 else 0;
  r1 + r2 + r3 + r4 + r5
}
