}

// sys_readbuf(fd,len): allocate zeros(ceil(len/8)) in the byte region,
// read(fd, x17+off, len), return (off<<32)|nread handle. This replaces the
// old IO-scratch-zone version — the returned handle feeds char()/str_len()
// directly (A7 step 3).
fn emit_sys_readbuf(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = vs_deliver(insns, n, fntab, stab, 2);
  // x0=fd, x1=len. Save both in callee-saved regs, compute n_cells,
  // bump arena, zero, read, construct handle. 26 words + vs_push.
  em(insns, n, 2852127731);
  em(insns, n, 2852193268);
  em(insns, n, 2432704149);
  em(insns, n, 3544448693);
  em(insns, n, 3548246689);
  em(insns, n, 2853897206);
  em(insns, n, 2332099287);
  em(insns, n, 3944154015);
  em(insns, n, 1409286377);
  em(insns, n, 2332099451);
  em(insns, n, 2853569507);
  em(insns, n, 335544322);
  em(insns, n, 4160783487);
  em(insns, n, 3944153215);
  em(insns, n, 1426063307);
  em(insns, n, 3406889665);
  em(insns, n, 2332099108);
  em(insns, n, 2853372896);
  em(insns, n, 2852193251);
  em(insns, n, 2852389857);
  em(insns, n, 2853438434);
  em(insns, n, 3531605992);
  em(insns, n, 3556769793);
  em(insns, n, 2852127735);
  em(insns, n, 3546315872);
  em(insns, n, 2853634048);
  let _ = vs_push(insns, n, fntab, stab, 2, 0, 0 - 1);
  n[0]
}

