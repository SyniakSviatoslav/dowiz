// sys_write(fd,buf,len): pack low bytes of elements to scratch, raw write.
fn emit_sys_write(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
