// B2-2: aarch64_data.bp — data-heavy lowering: struct fields, arrays,
// enum tags/match, arena allocation. Complements aarch64.bp (control flow).
// Convention: x14/x19 hold the bump-arena base (sp+off); structs are
// fixed 8-byte slots; arrays are N*8 regions indexed [base, idx, lsl #3].
// All self_check tests are EXEC-verified via the exec builtin.

// ---- shared encoders (exec-verified in aarch64.bp) ----

fn em(words: [i64], pc: [i64], w: i64) -> i64 {
  let _ = words[pc[0]] = w;
  let _ = pc[0] = pc[0] + 1;
  0
}

fn w_movz(rd: i64, imm16: i64) -> i64 {
  3531603968 + imm16 * 32 + rd
}

fn w_add_reg(rd: i64, rn: i64, rm: i64) -> i64 {
  2332033024 + rm * 65536 + rn * 32 + rd
}

// MUL Xd,Xn,Xm = 0x9B007C00 | ...
fn w_mul(rd: i64, rn: i64, rm: i64) -> i64 {
  2600500224 + rm * 65536 + rn * 32 + rd
}

fn w_cmp(rn: i64, rm: i64) -> i64 {
  3942645791 + rm * 65536 + rn * 32
}

fn w_bcond(off19: i64, cond: i64) -> i64 {
  // negative offsets sign-wrap into the 19-bit field (.bp / truncates to 0)
  let isneg = if off19 < 0 then 1 else 0;
  let enc = off19 + isneg * 524288;
  1409286144 + enc * 32 + cond
}

fn w_b(off26: i64) -> i64 {
  let isneg = if off26 < 0 then 1 else 0;
  let enc = off26 + isneg * 67108864;
  335544320 + enc
}

fn w_cbz(rt: i64, off19: i64) -> i64 {
  let isneg = if off19 < 0 then 1 else 0;
  let enc = off19 + isneg * 524288;
  3019898880 + enc * 32 + rt
}

fn w_cbnz(rt: i64, off19: i64) -> i64 {
  let isneg = if off19 < 0 then 1 else 0;
  let enc = off19 + isneg * 524288;
  3036676096 + enc * 32 + rt
}

// ADD Xd,Xn,#imm12 = 0x91000000 | ...
fn w_add_imm(rd: i64, rn: i64, imm12: i64) -> i64 {
  // ADD Xd,Xn,#imm12 = 0x91000000 | ...
  2432696320 + imm12 * 1024 + rn * 32 + rd
}

// SUB Xd,Xn,#imm12 = 0xD1000000 | ...
fn w_sub_imm(rd: i64, rn: i64, imm12: i64) -> i64 {
  3506438144 + imm12 * 1024 + rn * 32 + rd
}

// reserve a scratch window below the caller frame so arena writes can never
// touch live C stack data (exec calls the words as fn(long))
fn d_frame_open(words: [i64], pc: [i64], bytes: i64) -> i64 {
  let _ = em(words, pc, w_sub_imm(31, 31, bytes));
  0
}

fn d_frame_close(words: [i64], pc: [i64], bytes: i64) -> i64 {
  let _ = em(words, pc, w_add_imm(31, 31, bytes));
  0
}

// ldr xt,[xn,#imm12*8]
fn w_ldr(rt: i64, rn: i64, imm12: i64) -> i64 {
  4181721088 + imm12 * 1024 + rn * 32 + rt
}

// str xt,[xn,#imm12*8]
fn w_str(rt: i64, rn: i64, imm12: i64) -> i64 {
  4177526784 + imm12 * 1024 + rn * 32 + rt
}

// reg-offset: ldr xt,[xb,xi,lsl #3]
fn w_ldr_arr(rt: i64, rb: i64, ri: i64) -> i64 {
  // ldr xt,[xb,xi,lsl #3] = 0xF8607800 | ...
  4167071744 + ri * 65536 + rb * 32 + rt
}

// reg-offset: str xt,[xb,xi,lsl #3]
fn w_str_arr(rt: i64, rb: i64, ri: i64) -> i64 {
  // str xt,[xb,xi,lsl #3] = 0xF8207800 | ...
  4162877440 + ri * 65536 + rb * 32 + rt
}

fn emit_prologue(words: [i64], pc: [i64]) -> i64 {
  let _ = em(words, pc, 2847898621);
  let _ = em(words, pc, 2432697341);
  let _ = em(words, pc, 2847888371);
  let _ = em(words, pc, 2847890421);
  let _ = em(words, pc, 2847892471);
  let _ = em(words, pc, 2847894521);
  let _ = em(words, pc, 2847896571);
  0
}

fn emit_epilogue(words: [i64], pc: [i64]) -> i64 {
  let _ = em(words, pc, 2831250427);
  let _ = em(words, pc, 2831248377);
  let _ = em(words, pc, 2831246327);
  let _ = em(words, pc, 2831244277);
  let _ = em(words, pc, 2831242227);
  let _ = em(words, pc, 2831252477);
  let _ = em(words, pc, 3596551104);
  0
}

// ---- data lowering ----

// ALLOC(n): x14 <- sp+frame_off (arena base), then bump by n*8 slots.
// base_reg must be callee-saved (x19..x28) to survive nested calls.
fn d_alloc(words: [i64], pc: [i64], base_reg: i64, frame_off: i64, nslots: i64) -> i64 {
  let _ = em(words, pc, w_add_imm(base_reg, 31, frame_off));
  let bump = nslots * 2;
  let _ = if bump > 0 then (let _ = em(words, pc, w_add_imm(14, base_reg, bump)) in 0) else 0;
  0
}

// ST_FIELD value(reg v) into struct at base_reg slot s
fn d_st_field(words: [i64], pc: [i64], v: i64, base_reg: i64, slot: i64) -> i64 {
  let _ = em(words, pc, w_str(v, base_reg, slot));
  0
}

// LD_FIELD from struct slot into rd
fn d_ld_field(words: [i64], pc: [i64], rd: i64, base_reg: i64, slot: i64) -> i64 {
  let _ = em(words, pc, w_ldr(rd, base_reg, slot));
  0
}

// ST_ARR: str xv,[xbase,xidx,lsl #3]
fn d_st_arr(words: [i64], pc: [i64], v: i64, base_reg: i64, idx: i64) -> i64 {
  let _ = em(words, pc, w_str_arr(v, base_reg, idx));
  0
}

// LD_ARR: ldr xd,[xbase,xidx,lsl #3]
fn d_ld_arr(words: [i64], pc: [i64], rd: i64, base_reg: i64, idx: i64) -> i64 {
  let _ = em(words, pc, w_ldr_arr(rd, base_reg, idx));
  0
}

// SYSCALL write(fd=1): movz x0,1 ; adr/msg unsupported in this slice — skipped

fn self_check(_ignored: str) -> i64 {
  let fail = [0];

  // T1 struct: {a=5,b=7}; return a+b == 12 (imm-slot addressing)
  let w1 = zeros(256);
  let p1 = [0];
  let _ = emit_prologue(w1, p1);
  let _ = d_frame_open(w1, p1, 4096);
  let _ = em(w1, p1, w_add_imm(19, 31, 2048));
  let _ = em(w1, p1, w_movz(0, 5));
  let _ = d_st_field(w1, p1, 0, 19, 0);
  let _ = em(w1, p1, w_movz(0, 7));
  let _ = d_st_field(w1, p1, 0, 19, 1);
  let _ = d_ld_field(w1, p1, 1, 19, 0);
  let _ = d_ld_field(w1, p1, 2, 19, 1);
  let _ = em(w1, p1, w_add_reg(0, 1, 2));
  let _ = d_frame_close(w1, p1, 4096);
  let _ = emit_epilogue(w1, p1);
  let r1 = exec(w1, p1[0], 0);
  let t1 = if r1 == 12 then 0 else 1;
  let _ = if t1 == 1 then (let _ = fail[0] = fail[0] + 1 in 0) else 0;

  // T2 array: arr[2]=9; read arr[2] via shifted register offset -> 9
  let w2 = zeros(256);
  let p2 = [0];
  let _ = emit_prologue(w2, p2);
  let _ = d_frame_open(w2, p2, 4096);
  let _ = em(w2, p2, w_add_imm(19, 31, 2048));
  let _ = em(w2, p2, w_movz(0, 9));
  let _ = em(w2, p2, w_movz(1, 2));
  let _ = d_st_arr(w2, p2, 0, 19, 1);
  let _ = em(w2, p2, w_movz(3, 2));
  let _ = d_ld_arr(w2, p2, 0, 19, 3);
  let _ = d_frame_close(w2, p2, 4096);
  let _ = emit_epilogue(w2, p2);
  let r2 = exec(w2, p2[0], 0);
  let t2 = if r2 == 9 then 0 else 1;
  let _ = if t2 == 1 then (let _ = fail[0] = fail[0] + 1 in 0) else 0;

  // T3 enum tag + match-by-cbz: tag=1 -> some arm -> 41+1=42
  let w3 = zeros(256);
  let p3 = [0];
  let _ = emit_prologue(w3, p3);
  let _ = d_frame_open(w3, p3, 4096);
  let _ = em(w3, p3, w_add_imm(19, 31, 2048));
  let _ = em(w3, p3, w_movz(0, 1));
  let _ = d_st_field(w3, p3, 0, 19, 0);
  let _ = d_ld_field(w3, p3, 1, 19, 0);
  let _ = em(w3, p3, w_movz(8, 0));
  let _ = em(w3, p3, w_cmp(1, 8));
  // b.ne skip_none ; none-arm sets x0=0 ; b join ; skip_none:
  let _ = em(w3, p3, w_bcond(2, 1));
  let _ = em(w3, p3, w_movz(0, 0));
  let _ = em(w3, p3, w_b(1));
  let _ = em(w3, p3, w_movz(0, 41));
  let _ = em(w3, p3, w_movz(1, 1));
  let _ = em(w3, p3, w_add_reg(0, 0, 1));
  let _ = d_frame_close(w3, p3, 4096);
  let _ = emit_epilogue(w3, p3);
  let r3 = exec(w3, p3[0], 0);
  let t3 = if r3 == 42 then 0 else 1;
  let _ = if t3 == 1 then (let _ = fail[0] = fail[0] + 1 in 0) else 0;

  // T4 array sweep in a real loop: arr[i]=i*i for i=1..4; sum=1+4+9+16=30
  let w4 = zeros(512);
  let p4 = [0];
  let _ = emit_prologue(w4, p4);
  let _ = d_frame_open(w4, p4, 4096);
  let _ = em(w4, p4, w_add_imm(19, 31, 2048));
  let _ = em(w4, p4, w_movz(20, 0));
  let loop_pc4 = p4[0];
  let _ = em(w4, p4, w_movz(1, 1));
  let _ = em(w4, p4, w_add_reg(20, 20, 1));
  let _ = em(w4, p4, w_mul(2, 20, 20));
  let _ = d_st_arr(w4, p4, 2, 19, 20);
  let _ = em(w4, p4, w_movz(9, 4));
  let _ = em(w4, p4, w_cmp(20, 9));
  let back4 = loop_pc4 - p4[0];
  let _ = em(w4, p4, w_bcond(back4, 11));
  let _ = d_ld_field(w4, p4, 1, 19, 1);
  let _ = d_ld_field(w4, p4, 2, 19, 2);
  let _ = em(w4, p4, w_add_reg(0, 1, 2));
  let _ = d_ld_field(w4, p4, 1, 19, 3);
  let _ = em(w4, p4, w_add_reg(0, 0, 1));
  let _ = d_ld_field(w4, p4, 1, 19, 4);
  let _ = em(w4, p4, w_add_reg(0, 0, 1));
  let _ = d_frame_close(w4, p4, 4096);
  let _ = emit_epilogue(w4, p4);
  let r4 = exec(w4, p4[0], 0);
  let t4 = if r4 == 30 then 0 else 1;
  let _ = if t4 == 1 then (let _ = fail[0] = fail[0] + 1 in 0) else 0;

  fail[0]
}
