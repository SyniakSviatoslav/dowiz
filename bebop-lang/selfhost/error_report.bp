// selfhost/error_report.bp — compiler error reporting (error codes).
// Error kinds are tagged i64: 1=parse, 2=type, 3=scope, 4=termination.
// err_code passes the kind through; err_line passes the line through;
// err_msg packs both into a single i64 as kind*100000 + line.
// No structs/pointers/%/bitwise — pure passthrough + positional pack.

module core { }

// err_code: passthrough of the error kind tag (1=parse, 2=type, 3=scope, 4=termination)
fn err_code(kind: i64) -> i64 {
  kind
}

// err_line: passthrough of the line number
fn err_line(line: i64) -> i64 {
  line
}

// err_msg: pack kind and line into one i64 as kind*100000 + line
fn err_msg(kind: i64, line: i64) -> i64 {
  kind * 100000 + line
}
