// selfhost/parser.bp — recursive descent arithmetic parser (self-host #2)
// parse_expr evaluates "1 + 2 * 3" = 7 using a mutable position array.
// Demonstrates: multi-param fns, pass-by-reference (mutable array), mutual recursion.

module core { }

fn is_digit(c: i64) -> i64 {
  let ge48 = if c >= 48 then 1 else 0;
  let le57 = if c <= 57 then 1 else 0;
  ge48 * le57
}

// skip_ws: advance pos[0] past spaces
fn skip_ws(s: str, pos: [i64]) -> i64 {
  let n = str_len(s);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= n then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_sp = if ch == 32 then 1 else 0;
    let pos_next = pos[0] + is_sp;
    let _ = pos[0] = pos_next;
    let done = if is_sp == 1 then 0 else 1;
    0
  };
  0
}

// parse_num: read digits at pos[0], advance, return value
fn parse_num(s: str, pos: [i64]) -> i64 {
  let n = str_len(s);
  let v = 0;
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= n then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let dg = if at_end == 1 then 0 else is_digit(ch);
    let v = if dg == 1 then (v * 10) + (ch - 48) else v;
    let adv = if dg == 1 then 1 else 0;
    let _ = pos[0] = pos[0] + adv;
    let done = if dg == 1 then 0 else 1;
    0
  };
  v
}

// apply_op: consume one ('+'|'-') term and fold it into acc. Helper keeps the
// parse_expr loop branchless (no if inside the then-branch of another if).
fn apply_op(s: str, pos: [i64], acc: i64, is_plus: i64) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let t = parse_term(s, pos);
  if is_plus == 1 then acc + t else acc - t
}

// parse_expr: expr = term (('+'|'-') term)*
fn parse_expr(s: str, pos: [i64]) -> i64 {
  let acc = parse_term(s, pos);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let n = str_len(s);
    let ch = if pos[0] >= n then 0 else char(s, pos[0]);
    let is_plus = if ch == 43 then 1 else 0;
    let is_minus = if ch == 45 then 1 else 0;
    let is_op = if is_plus == 1 then 1 else is_minus;
    let acc = if is_op == 1 then apply_op(s, pos, acc, is_plus) else acc;
    let done = if is_op == 1 then 0 else 1;
    0
  };
  acc
}

// parse_term: term = factor ('*' factor)*
fn parse_term(s: str, pos: [i64]) -> i64 {
  let acc = parse_factor(s, pos);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let n = str_len(s);
    let ch = if pos[0] >= n then 0 else char(s, pos[0]);
    let is_mul = if ch == 42 then 1 else 0;
    let acc = if is_mul == 1 then (let _ = pos[0] = pos[0] + 1 in (let t = parse_factor(s, pos) in acc * t)) else acc;
    let done = if is_mul == 1 then 0 else 1;
    0
  };
  acc
}

// parse_factor: factor = number | '(' expr ')'
fn parse_factor(s: str, pos: [i64]) -> i64 {
  let _ = skip_ws(s, pos);
  let n = str_len(s);
  let ch = if pos[0] >= n then 0 else char(s, pos[0]);
  let is_lparen = if ch == 40 then 1 else 0;
  if is_lparen == 1 then
    (let _ = pos[0] = pos[0] + 1 in
     (let v = parse_expr(s, pos) in
      (let _ = skip_ws(s, pos) in
       (let _ = pos[0] = pos[0] + 1 in v))))
  else
    parse_num(s, pos)
}

// eval: entry — parse an arithmetic expression from a string
fn eval(s: str) -> i64 {
  let pos = [0];
  parse_expr(s, pos)
}

// ---- AST node encoding: tagged i64 (tag in low 3 bits) ----
// tag: 0=lit 1=var 2=bin 3=if 4=let 5=app 6=lam 7=array
// op codes: + 43, - 45, * 42, / 47; comparisons (any other) -> precedence 3

// mk_lit: literal node -> payload (value) << 3
fn mk_lit(v: i64) -> i64 {
  v * 8
}

// mk_var: variable node -> payload (name index) << 3 | 1
fn mk_var(n: i64) -> i64 {
  (n * 8) + 1
}

// mk_bin: binary-op node -> payload (op) << 3 | 2 (payload-only demo, full tree later)
fn mk_bin(op: i64, a: i64, b: i64) -> i64 {
  (op * 8) + 2
}

// node_tag: low 3 bits of the tagged node
fn node_tag(t: i64) -> i64 {
  t - (t / 8) * 8
}

// node_payload: upper bits (value, name index, or op code)
fn node_payload(t: i64) -> i64 {
  t / 8
}

fn is_lit(t: i64) -> i64 {
  if node_tag(t) == 0 then 1 else 0
}

fn is_var(t: i64) -> i64 {
  if node_tag(t) == 1 then 1 else 0
}

fn is_bin(t: i64) -> i64 {
  if node_tag(t) == 2 then 1 else 0
}

fn is_if(t: i64) -> i64 {
  if node_tag(t) == 3 then 1 else 0
}

// precedence: 1 = + -, 2 = * /, 3 = comparison
fn precedence(op: i64) -> i64 {
  let p = 3;
  let p = if op == 42 then 2 else p;
  let p = if op == 47 then 2 else p;
  let p = if op == 43 then 1 else p;
  let p = if op == 45 then 1 else p;
  p
}

// ---- B1-1: full bp_lex parity — flat tokens [kind,off,len,line] ----
// kinds mirror BpTokKind: 0=EOF 1=IDENT 2=GLYPH 3=NUMBER 4=PUNCT.
fn utf8_len(c: i64) -> i64 {
  let is2 = (if c >= 192 then 1 else 0) * (if c <= 223 then 1 else 0);
  let is3 = (if c >= 224 then 1 else 0) * (if c <= 239 then 1 else 0);
  let is4 = (if c >= 240 then 1 else 0) * (if c <= 247 then 1 else 0);
  is2 * 2 + is3 * 3 + is4 * 4 + (1 - is2) * (1 - is3) * (1 - is4)
}
fn is_alpha(c: i64) -> i64 {
  let ge_a = if c >= 97 then 1 else 0;
  let le_z = if c <= 122 then 1 else 0;
  let ge_A = if c >= 65 then 1 else 0;
  let le_Z = if c <= 90 then 1 else 0;
  ge_a * le_z + ge_A * le_Z
}
fn lex_ident_start(c: i64) -> i64 {
  is_alpha(c) + (if c == 95 then 1 else 0)
}
fn is_ident_char(c: i64) -> i64 {
  is_alpha(c) + is_digit(c) + (if c == 95 then 1 else 0)
}
fn scan_ident(src: str, i: i64) -> i64 {
  let strn = str_len(src);
  let jb = [i];
  let gob = [1];
  while gob[0] == 1 {
    let at_end = if jb[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(src, jb[0]);
    let keep = is_ident_char(ch) * (1 - at_end);
    let _ = jb[0] = jb[0] + keep;
    let _ = gob[0] = keep;
    0
  };
  jb[0]
}
fn scan_digits(src: str, i: i64) -> i64 {
  let strn = str_len(src);
  let jb = [i];
  let gob = [1];
  while gob[0] == 1 {
    let at_end = if jb[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(src, jb[0]);
    let keep = is_digit(ch) * (1 - at_end);
    let _ = jb[0] = jb[0] + keep;
    let _ = gob[0] = keep;
    0
  };
  jb[0]
}
fn skip_lcomment(src: str, i: i64) -> i64 {
  let strn = str_len(src);
  let jb = [i];
  let gob = [1];
  while gob[0] == 1 {
    let at_end = if jb[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(src, jb[0]);
    let is_nl = if ch == 10 then 1 else 0;
    let keep = (1 - at_end) * (1 - is_nl);
    let _ = jb[0] = jb[0] + keep;
    let _ = gob[0] = keep;
    0
  };
  jb[0]
}
fn lex_emit(toks: [i64], n: [i64], kind: i64, off: i64, len: i64, line: i64) -> i64 {
  let b = n[0] * 4;
  let _ = toks[b] = kind;
  let _ = toks[b + 1] = off;
  let _ = toks[b + 2] = len;
  let _ = toks[b + 3] = line;
  let _ = n[0] = n[0] + 1;
  n[0]
}
fn lex(src: str, toks: [i64]) -> i64 {
  let strn = str_len(src);
  let i = [0];
  let line = [1];
  let n = [0];
  let done = if strn == 0 then 1 else 0;
  while done == 0 {
    let at_end = if i[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(src, i[0]);
    let nxt = if i[0] + 1 < strn then char(src, i[0] + 1) else 0;
    let is_nl = if ch == 10 then 1 else 0;
    let is_sp = (if ch == 32 then 1 else 0) + (if ch == 9 then 1 else 0) + (if ch == 13 then 1 else 0);
    let is_lc = (if ch == 47 then 1 else 0) * (if nxt == 47 then 1 else 0);
    let is_id = lex_ident_start(ch);
    let is_num = is_digit(ch);
    let is_gl = if ch >= 128 then 1 else 0;
    let is_pn = (1 - is_nl) * (1 - is_sp) * (1 - is_lc) * (1 - is_id) * (1 - is_num) * (1 - is_gl) * (1 - at_end);
    let _ = line[0] = line[0] + is_nl;
    let lc_end = if is_lc == 1 then skip_lcomment(src, i[0]) else i[0];
    let id_end = if is_id == 1 then scan_ident(src, i[0]) else i[0];
    let num_end = if is_num == 1 then scan_digits(src, i[0]) else i[0];
    let gl_len = utf8_len(ch) * is_gl;
    let _ = if is_id == 1 then (let _ = lex_emit(toks, n, 1, i[0], id_end - i[0], line[0]) in 0) else 0;
    let _ = if is_num == 1 then (let _ = lex_emit(toks, n, 3, i[0], num_end - i[0], line[0]) in 0) else 0;
    let _ = if is_gl == 1 then (let _ = lex_emit(toks, n, 2, i[0], gl_len, line[0]) in 0) else 0;
    let _ = if is_pn == 1 then (let _ = lex_emit(toks, n, 4, i[0], 1, line[0]) in 0) else 0;
    let step = is_nl + is_sp + is_lc * (lc_end - i[0]) + is_id * (id_end - i[0]) + is_num * (num_end - i[0]) + is_gl * gl_len + is_pn;
    let _ = i[0] = i[0] + step;
    let done = if i[0] >= strn then 1 else 0;
    0
  };
  let _ = lex_emit(toks, n, 0, strn, 0, line[0]);
  n[0]
}

// ---- B1-2: item-level bp_parse parity ----
// Item record flat 6-wide: [kind, namehash, nameoff, namelen, txtoff, txtlen]
// kinds: 0=MODULE 1=FN 2=STRUCT 3=ENUM 4=CONST 5=USE 6=TYPE 7=THEOREM
fn slice_hash(src: str, off: i64, len: i64) -> i64 {
  // accumulator lives in a box: cross-iteration scalar rebinding is not
  // guaranteed to survive the loop in every eval path (measured drift).
  let hb = [0];
  let k = [0];
  let go = 1;
  while go == 1 {
    let done = if k[0] >= len then 1 else 0;
    let ch = if done == 1 then 0 else char(src, off + k[0]);
    let _ = if done == 0 then (let _ = hb[0] = hb[0] * 131 + ch in 0) else 0;
    let _ = k[0] = k[0] + 1;
    let go = 1 - done;
    0
  };
  hb[0]
}
fn tok_kind(toks: [i64], ti: i64) -> i64 { toks[ti * 4] }
fn tok_off(toks: [i64], ti: i64) -> i64 { toks[ti * 4 + 1] }
fn tok_len(toks: [i64], ti: i64) -> i64 { toks[ti * 4 + 2] }
fn is_kw(src: str, toks: [i64], ti: i64, h: i64) -> i64 {
  let kindok = if tok_kind(toks, ti) == 1 then 1 else 0;
  kindok * (if slice_hash(src, tok_off(toks, ti), tok_len(toks, ti)) == h then 1 else 0)
}
fn item_kind_of(src: str, toks: [i64], ti: i64) -> i64 {
  // branchless keyword dispatch; 8 = not an item start
  let k0 = is_kw(src, toks, ti, 4238080694376);
  let k1 = is_kw(src, toks, ti, 13472);
  let k2 = is_kw(src, toks, ti, 4471061603997);
  let k3 = is_kw(src, toks, ti, 228960337);
  let k4 = is_kw(src, toks, ti, 29406933171);
  let k5 = is_kw(src, toks, ti, 2023003);
  let k6 = is_kw(src, toks, ti, 262869810);
  let k7 = is_kw(src, toks, ti, 590296187660116);
  let none = (1 - k0) * (1 - k1) * (1 - k2) * (1 - k3) * (1 - k4) * (1 - k5) * (1 - k6) * (1 - k7);
  k1 + k2 * 2 + k3 * 3 + k4 * 4 + k5 * 5 + k6 * 6 + k7 * 7 + none * 8
}
fn skip_balanced(src: str, toks: [i64], ti: [i64], ntoks: i64) -> i64 {
  let depth = [1];
  let bad = [0];
  let go = [1];
  while go[0] == 1 {
    let _ = ti[0] = ti[0] + 1;
    let at_end = if ti[0] >= ntoks then 1 else 0;
    let ch = if at_end == 1 then 0 else char(src, tok_off(toks, ti[0]));
    let openc = if ch == 123 then 1 else 0;
    let closec = if ch == 125 then 1 else 0;
    let kindp = if at_end == 1 then 0 else (if tok_kind(toks, ti[0]) == 4 then 1 else 0);
    let _ = if kindp == 1 then (let _ = depth[0] = depth[0] + openc - closec in 0) else 0;
    let closed = if depth[0] <= 0 then 1 else 0;
    let _ = if closed == 1 then (let _ = ti[0] = ti[0] + 1 in 0) else 0;
    let _ = if at_end == 1 then (let _ = bad[0] = 1 in 0) else 0;
    let stop = at_end + closed;
    let _ = go[0] = 1 - stop;
    0
  };
  let _ = ti[0] = ti[0] - 1;
  0 - bad[0]
}
fn skip_statement(src: str, toks: [i64], ti: [i64], ntoks: i64) -> i64 {
  let go = [1];
  while go[0] == 1 {
    let _ = ti[0] = ti[0] + 1;
    let at_end = if ti[0] >= ntoks then 1 else 0;
    let kindp = if at_end == 1 then 0 else tok_kind(toks, ti[0]);
    let ch = if at_end == 1 then 0 else char(src, tok_off(toks, ti[0]));
    let semi = kindp * (if ch == 59 then 1 else 0);
    let stop = at_end + semi;
    let _ = go[0] = 1 - stop;
    0
  };
  0
}
fn items_parse(src: str, toks: [i64], ntoks: i64, out: [i64]) -> i64 {
  // STATE RULE (measured): scalar let-rebinding inside a while body is not
  // guaranteed to persist across iterations on every eval path; ALL loop
  // control state therefore lives in [i64] boxes.
  let ti = [0];
  let cnt = [0];
  let errb = [0];
  let prog_done = [0];
  while prog_done[0] == 0 {
    let ntoks_i = ntoks;
    let at_eof_t = if ti[0] >= ntoks_i then 1 else 0;
    let kind_cur = if at_eof_t == 1 then 9 else tok_kind(toks, ti[0]);
    let is_eof_tok = if kind_cur == 0 then 1 else 0;
    let chcur = if at_eof_t == 1 then 0 else char(src, tok_off(toks, ti[0]));
    let c125 = if chcur == 125 then 1 else 0;
    let c41 = if chcur == 41 then 1 else 0;
    let c93 = if chcur == 93 then 1 else 0;
    let kind_is_pn = if kind_cur == 4 then 1 else 0;
    let is_closer = (1 - at_eof_t) * kind_is_pn * (c125 + c41 + c93);
    let _ = if is_closer == 1 then (let _ = ti[0] = ti[0] + 1 in 0) else 0;
    let kk_raw = item_kind_of(src, toks, ti[0]);
    let stop_a = if at_eof_t == 1 then 1 else 0;
    let stop_b = if is_eof_tok == 1 then 1 else 0;
    let bad_item = if kk_raw == 8 then 1 else 0;
    let alive = (1 - at_eof_t) * (1 - is_closer);
    let _ = if bad_item * alive == 1 then (let _ = errb[0] = 1 in 0) else 0;
    let _ = if bad_item * alive == 1 then (let _ = prog_done[0] = 1 in 0) else 0;
    let _ = if stop_a == 1 then (let _ = prog_done[0] = 1 in 0) else 0;
    let started = alive * (1 - bad_item) * (1 - stop_b);
    let text_start = if started == 1 then tok_off(toks, ti[0]) else 0;
    let _ = if started == 1 then (let _ = ti[0] = ti[0] + 1 in 0) else 0;
    let in_rng = if ti[0] < ntoks_i then 1 else 0;
    let safe_i = ti[0] * in_rng;
    let nk = started * in_rng * tok_kind(toks, safe_i);
    let nk_id = if nk == 1 then 1 else 0;
    let nk_gl = if nk == 2 then 1 else 0;
    let has_name = started * (nk_id + nk_gl);
    let nameoff = if has_name == 1 then tok_off(toks, ti[0]) else 0;
    let namelen = if has_name == 1 then tok_len(toks, ti[0]) else 0;
    let nh = slice_hash(src, nameoff, namelen) * has_name;
    let _ = if has_name == 1 then (let _ = ti[0] = ti[0] + 1 in 0) else 0;
    let k1_pre = if kk_raw == 1 then 1 else 0;
    let is_fnk = started * k1_pre;
    let gd2 = if is_fnk == 0 then 1 else 0;
    while gd2 == 0 {
      let ae = if ti[0] >= ntoks_i then 1 else 0;
      let cb = if ae == 1 then 0 else char(src, tok_off(toks, ti[0]));
      let hit = (1 - ae) * (if cb == 123 then 1 else 0);
      let _ = if hit == 0 then (let _ = ti[0] = ti[0] + 1 in 0) else 0;
      let gd2 = hit + ae;
      0
    };
    let k_mod = if started == 1 then kk_raw else 9;
    let k0f = if k_mod == 0 then 1 else 0;
    let k1f = if k_mod == 1 then 1 else 0;
    let k2f = if k_mod == 2 then 1 else 0;
    let k3f = if k_mod == 3 then 1 else 0;
    let braceable = started * (k0f + k1f + k2f + k3f);
    let _ = if braceable == 1 then (let r = skip_balanced(src, toks, ti, ntoks) in 0) else 0;
    let stmt_only = started * (1 - braceable);
    let _ = if stmt_only == 1 then (let r = skip_statement(src, toks, ti, ntoks) in 0) else 0;
    let last_ok = if ti[0] < ntoks_i then ti[0] else ntoks_i - 1;
    let text_end = if started == 1 then tok_off(toks, last_ok) + tok_len(toks, last_ok) else 0;
    let b = cnt[0] * 6;
    let _ = if started == 1 then (let _ = out[b] = kk_raw in 0) else 0;
    let _ = if started == 1 then (let _ = out[b + 1] = nh in 0) else 0;
    let _ = if started == 1 then (let _ = out[b + 2] = nameoff in 0) else 0;
    let _ = if started == 1 then (let _ = out[b + 3] = namelen in 0) else 0;
    let _ = if started == 1 then (let _ = out[b + 4] = text_start in 0) else 0;
    let _ = if started == 1 then (let _ = out[b + 5] = text_end - text_start in 0) else 0;
    let _ = if started == 1 then (let _ = cnt[0] = cnt[0] + 1 in 0) else 0;

    let _ = if errb[0] == 1 then (let _ = prog_done[0] = 1 in 0) else 0;
    0
  };
  cnt[0]
}

fn self_check() -> i64 {
  let src = "module core { }\nfn main() { 42 }\nstruct pt { x: i64 }\nenum opt { none }\nconst K = 3;";
  let toks = zeros(256);
  let nt = lex(src, toks);
  let items = zeros(128);
  let ni = items_parse(src, toks, nt, items);
  let f1 = if ni == 5 then 0 else 1;
  let f2 = if items[0] == 0 then 0 else 1;
  let f3 = if items[6] == 1 then 0 else 1;
  let f4 = if items[12] == 2 then 0 else 1;
  let f5 = if items[18] == 3 then 0 else 1;
  let f6 = if items[24] == 4 then 0 else 1;
  let f7 = if items[7] == 246720401 then 0 else 1;
  f1 + f2 + f3 + f4 + f5 + f6 + f7
}
