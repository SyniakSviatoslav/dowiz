  let _ = dst[27] = 0;
  let _ = dst[28] = 0;
  let _ = dst[29] = 10;
  let _ = dst[30] = 9;
  let _ = dst[31] = 1;
  let _ = dst[32] = 7;
  let _ = dst[33] = 0;
  let _ = dst[34] = 66;
  let _ = dst[35] = 7;
  let _ = dst[36] = 66;
  let _ = dst[37] = 6;
  let _ = dst[38] = 126;
  let _ = dst[39] = 11;
  40
}

fn parity_case1() -> i64 {
  let bad_sum = [0];
  // corpus entry 1: "1 + 2 * 3"
  let g1 = zeros(64);
  let gl1 = load_g1(g1);
  let m1 = zeros(256);
  let t1t = zeros(4096);
  let ptb = zeros(4096);
  let n1 = lex("1 + 2 * 3", t1t);
  let len1 = parity_module("1 + 2 * 3", t1t, n1, ptb, m1);
  let ok1 = bytes_match(g1, gl1, m1, len1);
    let bad1 = 1 - ok1;
  bad_sum[0]
}
fn parity_case2() -> i64 {
  let bad_sum = [0];
  // corpus entry 2: "(3 + 4) * 2"
  let g2 = zeros(64);
  let gl2 = load_g2(g2);
  let m2 = zeros(256);
  let t2t = zeros(4096);
  let ptb2 = zeros(4096);
  let n2 = lex("(3 + 4) * 2", t2t);
  let len2 = parity_module("(3 + 4) * 2", t2t, n2, ptb2, m2);
  let ok2 = bytes_match(g2, gl2, m2, len2);
    let bad2 = 1 - ok2;
  bad_sum[0]
}
fn parity_case3() -> i64 {
  let bad_sum = [0];
  // corpus entry 3: "100 - 50"
  let g3 = zeros(64);
  let gl3 = load_g3(g3);
  let m3 = zeros(256);
  let t3t = zeros(4096);
  let ptb3 = zeros(4096);
  let n3 = lex("100 - 50", t3t);
  let len3 = parity_module("100 - 50", t3t, n3, ptb3, m3);
  let ok3 = bytes_match(g3, gl3, m3, len3);
    let bad3 = 1 - ok3;
  bad_sum[0]
}
fn parity_case4() -> i64 {
  let bad_sum = [0];
  // corpus entry 4: "7 * 6"
  let g4 = zeros(64);
  let gl4 = load_g4(g4);
  let m4 = zeros(256);
  let t4t = zeros(4096);
  let ptb4 = zeros(4096);
  let n4 = lex("7 * 6", t4t);
  let len4 = parity_module("7 * 6", t4t, n4, ptb4, m4);
  let ok4 = bytes_match(g4, gl4, m4, len4);
    let bad4 = 1 - ok4;

  bad_sum[0]
}

fn self_check() -> i64 {
  let total = [0];
  let _ = total[0] = total[0] + parity_case1();
  let _ = total[0] = total[0] + parity_case2();
  let _ = total[0] = total[0] + parity_case3();
  let _ = total[0] = total[0] + parity_case4();
  total[0]
}
