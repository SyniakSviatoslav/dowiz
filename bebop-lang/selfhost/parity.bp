// C8: "70000" (39 bytes)
fn pc8() -> i64 {
  let esrc_8 = "70000";
  let wlen_8 = 39;
  let mb_8 = zeros(256);
  let tk_8 = zeros(4096);
  let tb_8 = zeros(4096);
