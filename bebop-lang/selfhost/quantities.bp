// selfhost/quantities.bp — QTT quantity algebra (0=unused, 1=linear, 2=omega)
// Semiring over {0,1,2}: addition and multiplication with the 0<1<2 order.

module core { }

fn qty_add(a: i64, b: i64) -> i64 {
  let az = if a == 0 then 1 else 0;
  let bz = if b == 0 then 1 else 0;
  if az == 1 then b
  else (if bz == 1 then a else 2)
}

fn qty_mult(a: i64, b: i64) -> i64 {
  let az = if a == 0 then 1 else 0;
  let bz = if b == 0 then 1 else 0;
  let zero = if az + bz >= 1 then 1 else 0;
  let a1 = if a == 1 then 1 else 0;
  let b1 = if b == 1 then 1 else 0;
  if zero == 1 then 0
  else (if a1 == 1 then b else (if b1 == 1 then a else 2))
}

fn qty_leq(a: i64, b: i64) -> i64 {
  if a <= b then 1 else 0
}

fn self_check() -> i64 {
  let c1  = if qty_add(0, 1) == 1 then 0 else 1;
  let c2  = if qty_add(1, 0) == 1 then 0 else 1;
  let c3  = if qty_add(0, 0) == 0 then 0 else 1;
  let c4  = if qty_add(1, 1) == 2 then 0 else 1;
  let c5  = if qty_add(1, 2) == 2 then 0 else 1;
  let c6  = if qty_add(2, 1) == 2 then 0 else 1;
  let c7  = if qty_add(2, 2) == 2 then 0 else 1;
  let c8  = if qty_mult(0, 1) == 0 then 0 else 1;
  let c9  = if qty_mult(1, 0) == 0 then 0 else 1;
  let c10 = if qty_mult(0, 2) == 0 then 0 else 1;
  let c11 = if qty_mult(1, 1) == 1 then 0 else 1;
  let c12 = if qty_mult(1, 2) == 2 then 0 else 1;
  let c13 = if qty_mult(2, 1) == 2 then 0 else 1;
  let c14 = if qty_mult(2, 2) == 2 then 0 else 1;
  let c15 = if qty_leq(0, 0) == 1 then 0 else 1;
  let c16 = if qty_leq(0, 1) == 1 then 0 else 1;
  let c17 = if qty_leq(1, 2) == 1 then 0 else 1;
  let c18 = if qty_leq(2, 2) == 1 then 0 else 1;
  let c19 = if qty_leq(1, 0) == 0 then 0 else 1;
  let c20 = if qty_leq(2, 1) == 0 then 0 else 1;
  c1+c2+c3+c4+c5+c6+c7+c8+c9+c10+c11+c12+c13+c14+c15+c16+c17+c18+c19+c20
}
