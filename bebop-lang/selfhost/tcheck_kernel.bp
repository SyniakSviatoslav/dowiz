// selfhost/tcheck_kernel.bp -- F7: the structural kernel of tcheck, written in Bebop.
//
// CONTRACT (2026-09-12, rewritten from scratch; the previous file had never compiled,
// exit 101, because ttag/targ1/targ2 read tm_tag/tm_a/tm_b as GLOBALS and this language
// has none):
//
//   * NO IO, NO sys_exit, NO printing. The kernel returns results and records a
//     rejection in K[4]; the driver does every side effect. That is what makes a
//     rejection a RESULT rather than a crash, which is exactly what the twin's
//     `kernel_internal` counter measures.
//   * ALL state travels in ONE flat array K, allocated once by the caller. There are
//     no globals and the 14-parameter cap makes a bag of arrays impossible.
//   * `return` is a STATEMENT ONLY in this language -- `(return v)` inside an `if` arm
//     does not parse (bebop.bp:4862/5469 classify it, the expression path never sees
//     it), which is why `return` appears in ZERO selfhost sources. So every branch is
//     written as `let res = if cond then <value> else res;` and errors propagate by
//     being recorded, never by early exit.
//   * Law L8: no allocation of any kind inside a `while` body. This file allocates
//     nothing at all.
//   * uid 0 is a reserved sentinel with tag 0. Nothing may hand out uid 0.
//
// K layout (cells):
//   K[0]  next uid high-water        K[2]  level rule (0=max, 1=imax)
//   K[3]  ctx depth                  K[4]  reject code, set-once
//   K[5]  checks completed
//   tag   at K[16    + uid]          uid < 8192
//   arg a at K[8208  + uid]
//   arg b at K[16400 + uid]
//   id2uid at K[24592 + fileid]      fileid < 1024
//   ctx    at K[27408 + depth]       depth < 256, outermost at 0
//   K[6]  inductive count            K[7]  constructor record count
//   K[8]  nominated numeral type hash (0 = none declared)
//   K[9]  conversion fuel remaining (refilled once per declaration)
//   ind hash K[27664+i] arity K[27728+i] first-ctor K[27792+i] nctors K[27856+i]   i < 64
//   ctor hash K[27920+j]  ctor type K[28176+j]                                     j < 256
//
// Tags: 1 sort, 2 var (de Bruijn), 3 const, 4 pi, 5 lam, 6 app, 7 num.
//
// TAG 7 `num` -- a NUMERAL, added 2026-09-14 so an arithmetic theorem can be
// STATED rather than approximated.  Everything else the statement needs (the type
// `I64`, the machine operators, `Eq`, a precondition predicate) is an ordinary
// `axiom` and therefore costs ZERO new trusted surface; a numeral is the one part
// an axiom cannot carry, because `axiom 4294967296 : I64` pins the number by
// NAMING CONVENTION outside the kernel, and a trusted artifact should not have its
// statements mean things by convention.  The whole addition is:
//   * one typing rule -- a numeral inhabits the NOMINATED numeral type (below);
//   * one conversion case -- two numerals are convertible iff their VALUES are
//     equal, the same leaf comparison `sort` and `var` already use.  That is sound
//     here ONLY because `num` is a one-field node: k_conv's leaf path compares k_a
//     and ignores k_b, so a two-field node kind added to that set would silently
//     ignore half of itself.
//   * NOTHING in k_shift or k_subst: a numeral is closed, exactly like `sort` and
//     `const`, so their default "return t unchanged" is already the right rule --
//     demonstrated by a substitution fixture rather than assumed.
// What the kernel still does NOT know: what the operators MEAN.  `mul`, `fdiv`,
// `absv` are axioms, so `mul (num 2) (num 3)` does not reduce to `num 6`.  Stating
// the theorem needs no such reduction; CHECKING it would, and that is a
// primitive-reduction rule per operator, not one typing rule.
//
// THE NUMERAL TYPE IS NOMINATED, NOT BUILT IN.  The kernel has no reserved name:
// a file says `numtype I64` and the kernel records the hash after checking that
// what was nominated is a type.  A numeral with nothing nominated has NO type and
// is refused (32) rather than being given one.  K[8] holds the hash, 0 = none.
// Reject codes: 13 undefined reference, 20 var unbound, 22 expected a type,
//               26 check mismatch, 27 large elimination from Sort 0,
//               28 elim of something that is not a declared inductive with a
//               literal Sort arity, 29 constructor type above the inductive's
//               sort, 32 a numeral with no nominated numeral type, 33 the
//               nominated numeral type is not a type, 34 conversion fuel
//               exhausted, 71 capacity.

fn k_rej(K: [i64], code: i64) -> i64 {
  let _ = if K[4] == 0 then (let _ = K[4] = code in 0) else 0;
  0
}

fn k_tag(K: [i64], u: i64) -> i64 { K[16 + u] }
fn k_a(K: [i64], u: i64) -> i64 { K[8208 + u] }
fn k_b(K: [i64], u: i64) -> i64 { K[16400 + u] }

// k_new: allocate a node. uid 0 stays reserved, so the first uid handed out is 1.
fn k_new(K: [i64], tag: i64, a: i64, b: i64) -> i64 {
  let u = K[0] + 1;
  let over = if u >= 8192 then 1 else 0;
  let _ = if over == 1 then k_rej(K, 71) else 0;
  let u = if over == 1 then 0 else u;
  let _ = if over == 0 then (let _ = K[0] = u in 0) else 0;
  let _ = if over == 0 then (let _ = K[16 + u] = tag in 0) else 0;
  let _ = if over == 0 then (let _ = K[8208 + u] = a in 0) else 0;
  let _ = if over == 0 then (let _ = K[16400 + u] = b in 0) else 0;
  u
}

// k_shift: add d to every var index at or above cut. Sorts and consts are closed,
// so they come back unchanged; pi and lam raise the cutoff under their binder.
fn k_shift(K: [i64], t: i64, d: i64, cut: i64) -> i64 {
  let tg = k_tag(K, t);
  let res = t;
  let vi = k_a(K, t);
  let up = if tg == 2 then (if vi >= cut then 1 else 0) else 0;
  let res = if up == 1 then k_new(K, 2, vi + d, 0) else res;
  let res = if tg == 4 then k_new(K, 4, k_shift(K, k_a(K, t), d, cut), k_shift(K, k_b(K, t), d, cut + 1)) else res;
  let res = if tg == 5 then k_new(K, 5, k_shift(K, k_a(K, t), d, cut), k_shift(K, k_b(K, t), d, cut + 1)) else res;
  let res = if tg == 6 then k_new(K, 6, k_shift(K, k_a(K, t), d, cut), k_shift(K, k_b(K, t), d, cut)) else res;
  res
}

// k_subst: substitute var j with term s inside t. As we descend past binders, we shift s
// to account for the increased binder depth, and we adjust free variables above j.
// Follows k_shift's recursive shape: sorts and consts are closed, pi/lam/app recurse,
// vars are checked and adjusted.
fn k_subst(K: [i64], t: i64, j: i64, s: i64) -> i64 {
  let tg = k_tag(K, t);
  let res = t;
  let vi = k_a(K, t);
  // Var case: check if this is the var we're replacing
  let is_match = if tg == 2 then (if vi == j then 1 else 0) else 0;
  let is_above = if tg == 2 then (if vi > j then 1 else 0) else 0;
  let res = if is_match == 1 then s else res;
  let res = if is_above == 1 then k_new(K, 2, vi - 1, 0) else res;
  // Pi case: shift s by 1 when entering the binder, recurse with j+1 in codomain
  let res = if tg == 4 then k_new(K, 4, k_subst(K, k_a(K, t), j, s), k_subst(K, k_b(K, t), j + 1, k_shift(K, s, 1, 0))) else res;
  // Lam case: same as pi
  let res = if tg == 5 then k_new(K, 5, k_subst(K, k_a(K, t), j, s), k_subst(K, k_b(K, t), j + 1, k_shift(K, s, 1, 0))) else res;
  // App case: no binder, so no shift needed
  let res = if tg == 6 then k_new(K, 6, k_subst(K, k_a(K, t), j, s), k_subst(K, k_b(K, t), j, s)) else res;
  res
}

// k_conv: conversion. Structural for now -- beta and delta are not reachable from
// the fixtures this step covers, and a stub that silently accepted them would be
// worse than one that is honestly absent.
// --- K-delta: unfolding conversion, and the bound that makes it safe ---
// DELTA (unfold a `def` to its body) and BETA (apply a `lam`) turn conversion from
// a syntactic test into a REDUCTION, and reduction is where a checker can hang.
// A kernel that hangs fails OPEN in practice, so every reduction step spends from
// one budget, and running out is FAIL-CLOSED: k_burn records 34 and k_whnf stops,
// so k_conv answers "not convertible" and the file is REJECTED.  Exhaustion can
// therefore only ever make the kernel reject more, never accept more.
// The budget is refilled once per declaration (kp_decl), so it bounds the work of
// one `check`, not of a whole file.
fn k_fuel_cap() -> i64 { 4096 }

fn k_burn(K: [i64]) -> i64 {
  let f = K[9];
  let _ = if f <= 0 then k_rej(K, 34) else 0;
  let _ = if f > 0 then (let _ = K[9] = f - 1 in 0) else 0;
  if f > 0 then 1 else 0
}

// k_whnf: weak-head normal form under delta and beta.  One step per iteration, tag
// recomputed at the top, and the loop only continues when a step actually happened
// AND was paid for.  An axiom has no body (k_def_body returns 0), so delta stops
// there rather than unfolding a name with nothing behind it.
fn k_whnf(K: [i64], t: i64) -> i64 {
  let cur = t;
  let go = 1;
  while go == 1 {
    let tg = k_tag(K, cur);
    let isc = if tg == 3 then 1 else 0;
    let body = if isc == 1 then k_def_body(K, k_a(K, cur)) else 0;
    let dodelta = if isc == 1 then (if body != 0 then 1 else 0) else 0;
    // beta needs the head in weak-head form first; that recursion is bounded by the
    // term's spine, and every reduction it performs spends from the same budget.
    let isa = if tg == 6 then 1 else 0;
    let hd = if isa == 1 then k_whnf(K, k_a(K, cur)) else 0;
    let dobeta = if isa == 1 then (if k_tag(K, hd) == 5 then 1 else 0) else 0;
    let step = if dodelta == 1 then 1 else dobeta;
    let paid = if step == 1 then k_burn(K) else 0;
    let nxt = if dodelta == 1 then body else (if dobeta == 1 then k_subst(K, k_b(K, hd), 0, k_b(K, cur)) else cur);
    let cur = if paid == 1 then nxt else cur;
    let go = paid;
    0
  };
  cur
}

fn k_conv(K: [i64], a: i64, b: i64) -> i64 {
  let ta = k_tag(K, a);
  let tb = k_tag(K, b);
  let same = if ta == tb then 1 else 0;
  let leaf = if ta == 1 then 1 else 0;
  let leaf = if ta == 2 then 1 else leaf;
  let leaf = if ta == 3 then 1 else leaf;
  // a numeral is a leaf compared by VALUE -- k_a holds the number and k_b is
  // unused, which is what makes this leaf case correct rather than lossy
  let leaf = if ta == 7 then 1 else leaf;
  let r = 0;
  let r = if same == 1 then (if leaf == 1 then (if k_a(K, a) == k_a(K, b) then 1 else 0) else r) else r;
  // The structural path is named by TAG, not by "whatever is not a leaf".  Found by
  // mutation 2026-09-14: with tag 7 removed from the leaf set, `deep` fired on a
  // numeral and k_conv recursed into k_a -- which for a numeral is its VALUE, not a
  // uid -- giving K[16 + 4294967296], a wild access that SIGSEGVs (trap 82).  So a
  // one-field node kind that someone forgets to add to `leaf` would not merely be
  // judged inconvertible, it would crash the kernel.  Listing 4/5/6 explicitly makes
  // an unrecognised tag answer "not convertible" instead, which is the safe default
  // for a checker: it can only ever reject more.
  let deep = if same == 1 then (if ta == 4 then 1 else (if ta == 5 then 1 else (if ta == 6 then 1 else 0))) else 0;
  let r = if deep == 1 then (if k_conv(K, k_a(K, a), k_a(K, b)) == 1 then k_conv(K, k_b(K, a), k_b(K, b)) else 0) else r;
  // K-delta.  Only reached when the SYNTACTIC comparison already failed, so nothing
  // that used to be convertible can stop being so.  Both sides are weak-head
  // normalised and compared again, and the retry happens ONLY if a side actually
  // moved -- which required a paid reduction step, so the retry chain is bounded by
  // the fuel and cannot spin on a term that is already normal.
  let na = if r == 0 then k_whnf(K, a) else a;
  let nb = if r == 0 then k_whnf(K, b) else b;
  let moved = if r == 0 then (if na != a then 1 else (if nb != b then 1 else 0)) else 0;
  let r = if moved == 1 then k_conv(K, na, nb) else r;
  r
}

// k_infer_pi: pi A B lives in sort (max u v), where A : sort u and B : sort v under
// the context extended by A. The extension is why this is its own function: an `if`
// arm cannot carry the push/pop sequence.
fn k_infer_pi(K: [i64], t: i64) -> i64 {
  let dom = k_a(K, t);
  let cod = k_b(K, t);
  let ta = k_infer(K, dom);
  let _ = if k_tag(K, ta) == 1 then 0 else k_rej(K, 22);
  let u = k_a(K, ta);
  let d = K[3];
  let _ = K[27408 + d] = dom;
  let _ = K[3] = d + 1;
  let tb = k_infer(K, cod);
  let _ = K[3] = d;
  let _ = if k_tag(K, tb) == 1 then 0 else k_rej(K, 22);
  let v = k_a(K, tb);
  // Level rule: under imax (K[2]==1), if codomain is Prop (v==0), result is Prop
  let is_imax = K[2];
  let m = if u > v then u else v;
  let m = if is_imax == 1 then (if v == 0 then 0 else m) else m;
  k_new(K, 1, m, 0)
}

// k_infer_lam: lam A b : pi A (type of b under A).
fn k_infer_lam(K: [i64], t: i64) -> i64 {
  let dom = k_a(K, t);
  let bod = k_b(K, t);
  let ta = k_infer(K, dom);
  let _ = if k_tag(K, ta) == 1 then 0 else k_rej(K, 22);
  let d = K[3];
  let _ = K[27408 + d] = dom;
  let _ = K[3] = d + 1;
  let tb = k_infer(K, bod);
  let _ = K[3] = d;
  k_new(K, 4, dom, tb)
}

// k_infer_app: app f a needs f's type to be a pi and a's type to convert to its
// domain. The codomain may depend on the argument, in which case we substitute.
// DELTA UNFOLDING: if the inferred head type is a const, unfold it to its body
// and infer the body's type. Repeat until we find a pi (tag 4) or can't unfold.
// Fuel-bounded to prevent infinite loops from circular definitions.
fn k_infer_app(K: [i64], t: i64) -> i64 {
  let fu = k_a(K, t);
  let au = k_b(K, t);
  let tf = k_infer(K, fu);
  // Delta unfolding loop: unfold consts to their bodies until we find a pi.
  // When tf is a const, replace it with the body (not the body's type).
  let fuel = 256;
  let isp = 0;
  while fuel > 0 {
    let tag = k_tag(K, tf);
    let isp_check = if tag == 4 then 1 else 0;
    let is_const = if tag == 3 then 1 else 0;
    let isp = if isp_check == 1 then 1 else isp;
    let should_unfold = if isp_check == 1 then 0 else is_const;
    // Unfold: replace const with its body (the body term itself, not its type)
    let body = if should_unfold == 1 then k_def_body(K, k_a(K, tf)) else 0;
    let tf = if should_unfold == 1 then body else tf;
    // Break if we found a pi or if we can't unfold further
    let continue_loop = if isp_check == 1 then 0 else (if should_unfold == 1 then 1 else 0);
    let fuel = if continue_loop == 1 then fuel - 1 else 0;
    0
  };
  let _ = if isp == 1 then 0 else k_rej(K, 23);
  let ta = k_infer(K, au);
  let dom = if isp == 1 then k_a(K, tf) else 0;
  let ok = if isp == 1 then k_conv(K, ta, dom) else 0;
  let _ = if isp == 1 then (if ok == 1 then 0 else k_rej(K, 24)) else 0;
  let cod = if isp == 1 then k_b(K, tf) else 0;
  // Substitute the argument into the codomain to handle dependent types
  let cod = if isp == 1 then k_subst(K, cod, 0, au) else cod;
  cod
}

// k_def_add / k_def_find: the constant table. `axiom n : T` records a name with no
// body; `def n : T := b` records one with a body after b has been checked against T.
// Names arrive from a file, so they are compared as hashes -- string VALUES cannot be
// built at run time here.
fn k_def_add(K: [i64], h: i64, ty: i64, body: i64) -> i64 {
  let i = K[1];
  let over = if i >= 256 then 1 else 0;
  let _ = if over == 1 then k_rej(K, 71) else 0;
  let _ = if over == 0 then (let _ = K[26640 + i] = h in 0) else 0;
  let _ = if over == 0 then (let _ = K[26896 + i] = ty in 0) else 0;
  let _ = if over == 0 then (let _ = K[27152 + i] = body in 0) else 0;
  let _ = if over == 0 then (let _ = K[1] = i + 1 in 0) else 0;
  0
}

// returns the declared type uid, or 0 and reject 21 when the name was never declared
fn k_def_type(K: [i64], h: i64) -> i64 {
  let i = 0;
  let cnt = K[1];
  let found = 0;
  while i < cnt {
    let hit = if K[26640 + i] == h then 1 else 0;
    let found = if hit == 1 then K[26896 + i] else found;
    let i = if hit == 1 then cnt else i + 1;
    0
  };
  let _ = if found == 0 then k_rej(K, 21) else 0;
  found
}

// returns the body uid of a const (def only; axioms have no body), or 0 if not found
fn k_def_body(K: [i64], h: i64) -> i64 {
  let i = 0;
  let cnt = K[1];
  let found = 0;
  while i < cnt {
    let hit = if K[26640 + i] == h then 1 else 0;
    let found = if hit == 1 then K[27152 + i] else found;
    let i = if hit == 1 then cnt else i + 1;
    0
  };
  found
}

// k_numtype_set: nominate the constant numerals inhabit.  Checked, not trusted:
// the name must already be declared (k_def_type rejects 21 otherwise) and its
// declared type must be a SORT, so `numtype b` for a value `b : A` is refused 33
// even though A is itself a type.  K[8] is only written when the nomination passes.
fn k_numtype_set(K: [i64], h: i64) -> i64 {
  let ty = k_def_type(K, h);
  let issort = if ty == 0 then 0 else (if k_tag(K, ty) == 1 then 1 else 0);
  let _ = if ty == 0 then 0 else (if issort == 1 then 0 else k_rej(K, 33));
  let _ = if issort == 1 then (let _ = K[8] = h in 0) else 0;
  0
}

// the type of a numeral is the nominated constant, built fresh each time.  With
// nothing nominated a numeral has no type and is REFUSED: the alternative -- a
// default type -- would let a file state a theorem about numerals it never
// declared a home for.
fn k_num_type(K: [i64]) -> i64 {
  let h = K[8];
  let _ = if h == 0 then k_rej(K, 32) else 0;
  if h == 0 then 0 else k_new(K, 3, h, 0)
}

// k_infer: the one rule that keeps the system consistent is the first line --
// Sort n : Sort (n+1). A kernel with Type : Type accepts n01 and can then prove False.
fn k_infer(K: [i64], t: i64) -> i64 {
  let bad = if K[4] != 0 then 1 else 0;
  let t = t * (1 - bad);
  let tg = k_tag(K, t);
  let res = 0;
  let _ = if tg == 0 then k_rej(K, 13) else 0;
  let res = if tg == 1 then k_new(K, 1, k_a(K, t) + 1, 0) else res;
  let d = K[3];
  let vi = k_a(K, t);
  let inb = if tg == 2 then (if vi < d then 1 else 0) else 0;
  let _ = if tg == 2 then (if inb == 1 then 0 else k_rej(K, 20)) else 0;
  let res = if inb == 1 then k_shift(K, K[27408 + d - 1 - vi], vi + 1, 0) else res;
  let res = if tg == 3 then k_def_type(K, k_a(K, t)) else res;
  let res = if tg == 4 then k_infer_pi(K, t) else res;
  let res = if tg == 5 then k_infer_lam(K, t) else res;
  let res = if tg == 6 then k_infer_app(K, t) else res;
  let res = if tg == 7 then k_num_type(K) else res;
  res
}

// k_check: the claimed type must itself be a type before anything is compared --
// that is the half of `check` a kernel is tempted to skip.
fn k_check(K: [i64], t: i64, ty: i64) -> i64 {
  let tt = k_infer(K, t);
  let tty = k_infer(K, ty);
  let _ = if k_tag(K, tty) == 1 then 0 else k_rej(K, 22);
  let ok = k_conv(K, tt, ty);
  let _ = if ok == 1 then 0 else k_rej(K, 26);
  let _ = K[5] = K[5] + 1;
  0
}

// k_ctor_ret: walk a constructor type's pi spine to its RETURN type. `zero : Nat`
// has an empty spine and returns itself; `succ : Nat -> Nat` returns the codomain.
fn k_ctor_ret(K: [i64], t: i64) -> i64 {
  let cur = t;
  while k_tag(K, cur) == 4 {
    let cur = k_b(K, cur);
    0
  };
  cur
}

// k_occurs: does the const with hash h appear anywhere inside t?
fn k_occurs(K: [i64], t: i64, h: i64) -> i64 {
  let tg = k_tag(K, t);
  let r = 0;
  let r = if tg == 3 then (if k_a(K, t) == h then 1 else 0) else r;
  let deep = if tg >= 4 then 1 else 0;
  let r = if deep == 1 then (if k_occurs(K, k_a(K, t), h) == 1 then 1 else k_occurs(K, k_b(K, t), h)) else r;
  r
}

// k_arg_pos: strict positivity of ONE constructor argument. The rule is applied to
// that argument's OWN pi spine, never to the constructor's top-level spine -- which
// is the entire difference between p03 and n03. In `succ : Nat -> Nat` the argument
// IS Nat, an ordinary recursive occurrence, and must be accepted. In
// `mk : (Bad -> Bad) -> Bad` the argument is itself a pi whose DOMAIN mentions Bad,
// and a domain is a negative position, which is what makes the system inconsistent.
// Returns 1 when the argument is positive, 0 when a negative occurrence was found.
fn k_arg_pos(K: [i64], a: i64, h: i64) -> i64 {
  let cur = a;
  let ok = 1;
  while k_tag(K, cur) == 4 {
    let ok = if k_occurs(K, k_a(K, cur), h) == 1 then 0 else ok;
    let cur = k_b(K, cur);
    0
  };
  ok
}

// k_check_inductive_ctor: the arity must be a LITERAL Sort u (28) -- the eliminator
// needs u as a number, and an arity hidden behind a def would need delta here --
// the constructor must RETURN the inductive being declared (31), every pi domain must
// be a type (22), every argument must be strictly positive (30), and the constructor
// type as a whole must be a type (22) living at or below Sort u (29).
//
// 29 is the check that the ELIMINATOR makes load-bearing. Without it
// `inductive U : Sort 1 | mk : Pi (A : Sort 2). U` is accepted (it was, 2026-09-13,
// by kernel and twin alike), and with a large eliminator `decode : U -> Sort 2`,
// `decode (mk A) = A` makes U a Sort 2 that lives in Sort 1 -- Type : Type by another
// name. Under imax the codomain `U : Sort 0` pulls the whole pi to Sort 0, so the same
// rule leaves the impredicative existential alone; 27 is what fences THAT one.
fn k_check_inductive_ctor(K: [i64], indtype_hash: i64, arity: i64, ctor_type: i64) -> i64 {
  let arity_lit = if k_tag(K, arity) == 1 then 1 else 0;
  let _ = if arity_lit == 1 then 0 else k_rej(K, 28);
  let u = k_a(K, arity);
  let r = k_ctor_ret(K, ctor_type);
  let okret = if k_tag(K, r) == 3 then (if k_a(K, r) == indtype_hash then 1 else 0) else 0;
  let _ = if okret == 1 then 0 else k_rej(K, 31);
  let cur = ctor_type;
  let neg = 0;
  while k_tag(K, cur) == 4 {
    let dom = k_a(K, cur);
    let neg = if k_arg_pos(K, dom, indtype_hash) == 0 then 1 else neg;
    let dom_type = k_infer(K, dom);
    let _ = if k_tag(K, dom_type) == 1 then 0 else k_rej(K, 22);
    let cur = k_b(K, cur);
    0
  };
  let _ = if neg == 1 then k_rej(K, 30) else 0;
  let cty_sort = k_infer(K, ctor_type);
  let is_sort = if k_tag(K, cty_sort) == 1 then 1 else 0;
  let _ = if is_sort == 1 then 0 else k_rej(K, 22);
  let above = if is_sort == 1 then (if k_a(K, cty_sort) > u then 1 else 0) else 0;
  let _ = if above == 1 then k_rej(K, 29) else 0;
  0
}

// ---------------------------------------------------------------- inductive table
// The def table knows a name and a type; an eliminator needs the SHAPE -- which
// constructors, in which order, with which types -- so inductives get their own table.
// A constructor record is appended to the MOST RECENT inductive: declarations are
// parsed in order and a `| c : T` belongs to the `inductive` line it follows.

fn k_ind_add(K: [i64], h: i64, arity: i64) -> i64 {
  let i = K[6];
  let over = if i >= 64 then 1 else 0;
  let _ = if over == 1 then k_rej(K, 71) else 0;
  let _ = if over == 0 then (let _ = K[27664 + i] = h in 0) else 0;
  let _ = if over == 0 then (let _ = K[27728 + i] = arity in 0) else 0;
  let _ = if over == 0 then (let _ = K[27792 + i] = K[7] in 0) else 0;
  let _ = if over == 0 then (let _ = K[27856 + i] = 0 in 0) else 0;
  let _ = if over == 0 then (let _ = K[6] = i + 1 in 0) else 0;
  0
}

// registers the constructor in the def table too, so `const zero` types as Nat --
// before 2026-09-13 the driver parsed the name and dropped it (kernel 21, twin accept).
fn k_ind_ctor_add(K: [i64], ch: i64, cty: i64) -> i64 {
  let j = K[7];
  let i = K[6] - 1;
  let over = if j >= 256 then 1 else 0;
  let over = if i < 0 then 1 else over;
  let _ = if over == 1 then k_rej(K, 71) else 0;
  let _ = if over == 0 then (let _ = K[27920 + j] = ch in 0) else 0;
  let _ = if over == 0 then (let _ = K[28176 + j] = cty in 0) else 0;
  let _ = if over == 0 then (let _ = K[27856 + i] = K[27856 + i] + 1 in 0) else 0;
  let _ = if over == 0 then (let _ = K[7] = j + 1 in 0) else 0;
  let _ = if over == 0 then k_def_add(K, ch, cty, 0) else 0;
  0
}

// 1-based index of the inductive named h; 0 when there is none (uid-0 style sentinel).
fn k_ind_find(K: [i64], h: i64) -> i64 {
  let i = 0;
  let cnt = K[6];
  let found = 0;
  while i < cnt {
    let hit = if K[27664 + i] == h then 1 else 0;
    let found = if hit == 1 then i + 1 else found;
    let i = if hit == 1 then cnt else i + 1;
    0
  };
  found
}

// ---------------------------------------------------------------- the eliminator
// CASE ANALYSIS ONLY (no recursive branch arguments, no iota in k_conv -- see the
// F7 verdict of 2026-09-13). For `inductive I : Sort u | c_1 : A_1 -> .. -> I | ..`
// with n constructors, `elim E I v` declares
//
//   E : Pi (P : I -> Sort v).
//         Pi (b_1 : Pi (a..: A_1..). P (c_1 a..)). ... Pi (b_n : ...).
//           Pi (x : I). P x
//
// as a bodiless const. De Bruijn, innermost first: at the tail P = var (n+1), x = var 0;
// inside branch i0 (0-based) under its k argument binders P = var (k + i0) and the
// arguments are var (k-1) .. var 0. A constructor type is closed, so the k_shift of
// its domains by (i0 + 1) above cutoff k is an identity in practice; it is what the
// rule says, so it is what is written.

// app (.. (app (const c) (var k-1)) ..) (var 0)
fn k_ctor_app(K: [i64], ch: i64, k: i64) -> i64 {
  let cur = k_new(K, 3, ch, 0);
  let j = k;
  while j > 0 {
    let cur = k_new(K, 6, cur, k_new(K, 2, j - 1, 0));
    let j = j - 1;
    0
  };
  cur
}

fn k_elim_branch(K: [i64], cty: i64, ch: i64, i0: i64, k: i64) -> i64 {
  let ispi = if k_tag(K, cty) == 4 then 1 else 0;
  let res = if ispi == 1 then k_new(K, 4, k_shift(K, k_a(K, cty), i0 + 1, k), k_elim_branch(K, k_b(K, cty), ch, i0, k + 1)) else 0;
  let res = if ispi == 0 then k_new(K, 6, k_new(K, 2, k + i0, 0), k_ctor_app(K, ch, k)) else res;
  res
}

// i is the 0-based inductive index. Built inside out: the tail first, then each
// branch pi wrapped around it from the last constructor to the first, then the motive.
fn k_elim_type(K: [i64], ih: i64, i: i64, v: i64) -> i64 {
  let first = K[27792 + i];
  let n = K[27856 + i];
  let tail = k_new(K, 4, k_new(K, 3, ih, 0), k_new(K, 6, k_new(K, 2, n + 1, 0), k_new(K, 2, 0, 0)));
  let i0 = n - 1;
  while i0 >= 0 {
    let br = k_elim_branch(K, K[28176 + first + i0], K[27920 + first + i0], i0, 0);
    let tail = k_new(K, 4, br, tail);
    let i0 = i0 - 1;
    0
  };
  k_new(K, 4, k_new(K, 4, k_new(K, 3, ih, 0), k_new(K, 1, v, 0)), tail)
}

// THE ELIMINATION RESTRICTION lives here and nowhere else: an inductive in Sort 0 may
// only be eliminated into Sort 0 (27). Under imax Sort 0 is impredicative, and a
// motive `I -> Sort v` with v > 0 on an `I : Sort 0` is exactly large elimination from
// Prop, the standard route from an impredicative universe to inconsistency. The rule
// is applied under BOTH arms: the max arm loses nothing it cannot recover by declaring
// the inductive in Sort 1, and one rule that holds everywhere is one rule to audit.
// (Relaxing it to the imax arm alone is a one-token change: guard `large` with K[2].)
fn k_elim(K: [i64], eh: i64, ih: i64, v: i64) -> i64 {
  let f = k_ind_find(K, ih);
  let _ = if f == 0 then k_rej(K, 28) else 0;
  let i = if f == 0 then 0 else f - 1;
  let arity = if f == 0 then 0 else K[27728 + i];
  let issort = if k_tag(K, arity) == 1 then 1 else 0;
  let _ = if issort == 1 then 0 else k_rej(K, 28);
  let u = k_a(K, arity);
  let large = if issort == 1 then (if u == 0 then (if v > 0 then 1 else 0) else 0) else 0;
  let _ = if large == 1 then k_rej(K, 27) else 0;
  let ok = if f == 0 then 0 else issort;
  let ok = if large == 1 then 0 else ok;
  let ty = if ok == 1 then k_elim_type(K, ih, i, v) else 0;
  let tty = if ok == 1 then k_infer(K, ty) else 0;
  let _ = if ok == 1 then (if k_tag(K, tty) == 1 then 0 else k_rej(K, 22)) else 0;
  let _ = if ok == 1 then k_def_add(K, eh, ty, 0) else 0;
  0
}
