// selfhost/typecheck.bp — Bebop typechecker (self-host module #3)
// Typechecks arithmetic + comparison expressions. Type codes: 0=i64, 1=bool.
// Returns 0 on type error, 1 on well-typed. Runs via `bebopc run`.

module core { }

fn is_digit(c: i64) -> i64 {
  if c >= 48 then (if c <= 57 then 1 else 0) else 0
}

fn skip_ws(s: str, pos: [i64]) -> i64 {
  let n = str_len(s);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= n then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_sp = if at_end == 1 then 0 else (if ch == 32 then 1 else 0);
    let _ = pos[0] = pos[0] + is_sp;
    let done = if is_sp == 1 then 0 else 1;
    0
  };
  0
}

// skip_num: advance past a number literal, return 0 (i64 type)
fn skip_num(s: str, pos: [i64]) -> i64 {
  let n = str_len(s);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= n then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let dg = if at_end == 1 then 0 else is_digit(ch);
    let _ = pos[0] = pos[0] + dg;
    let done = if dg == 1 then 0 else 1;
    0
  };
  0
}

// parse_expr_type: returns the type (0=i64) of an arithmetic expression.
// Reports type errors via *ok (0 = error). Grammar: expr := term (('+'|'-') term)*
fn parse_expr_type(s: str, pos: [i64], ok: [i64]) -> i64 {
  let t1 = parse_term_type(s, pos, ok);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let n = str_len(s);
    let ch = if pos[0] >= n then 0 else char(s, pos[0]);
    let is_op = if ch == 43 then 1 else (if ch == 45 then 1 else 0);
    let t1 = if is_op == 1 then (let _ = pos[0] = pos[0] + 1 in (let t2 = parse_term_type(s, pos, ok) in (if t1 == 0 then (if t2 == 0 then 0 else (let _ = ok[0] = 0 in 0)) else (let _ = ok[0] = 0 in 0)))) else t1;
    let done = if is_op == 1 then 0 else 1;
    0
  };
  t1
}

// parse_term_type: term := factor ('*' factor)*
fn parse_term_type(s: str, pos: [i64], ok: [i64]) -> i64 {
  let t1 = parse_factor_type(s, pos, ok);
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let n = str_len(s);
    let ch = if pos[0] >= n then 0 else char(s, pos[0]);
    let is_mul = if ch == 42 then 1 else 0;
    let t1 = if is_mul == 1 then (let _ = pos[0] = pos[0] + 1 in (let t2 = parse_factor_type(s, pos, ok) in (if t1 == 0 then (if t2 == 0 then 0 else (let _ = ok[0] = 0 in 0)) else (let _ = ok[0] = 0 in 0)))) else t1;
    let done = if is_mul == 1 then 0 else 1;
    0
  };
  t1
}

// parse_factor_type: factor := number | '(' expr ')'
fn parse_factor_type(s: str, pos: [i64], ok: [i64]) -> i64 {
  let _ = skip_ws(s, pos);
  let n = str_len(s);
  let ch = if pos[0] >= n then 0 else char(s, pos[0]);
  let is_lparen = if ch == 40 then 1 else 0;
  if is_lparen == 1 then
    (let _ = pos[0] = pos[0] + 1 in
     (let t = parse_expr_type(s, pos, ok) in
      (let _ = skip_ws(s, pos) in
       (let _ = pos[0] = pos[0] + 1 in t))))
  else
    (let _ = skip_num(s, pos) in 0)
}

// typecheck: entry — 1 if the expression is well-typed, 0 otherwise
fn typecheck(s: str) -> i64 {
  let pos = [0];
  let ok = [1];
  let t = parse_expr_type(s, pos, ok);
  ok[0]
}