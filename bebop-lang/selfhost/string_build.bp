// selfhost/string_build.bp — string builders: reverse, append, substring checksum.
// Built on str_len / char loops, chr(), and ++ concatenation.

module core { }

// str_reverse: reverse a string via a char loop (single-pass accumulator).
fn str_reverse(s: str) -> str {
  let n = str_len(s);
  let out = "";
  let i = 0;
  while i < n {
    let c = char(s, n - 1 - i);
    let out = out ++ chr(c);
    let i = i + 1;
    0
  };
  out
}

// str_append: append the character with code c to s.
fn str_append(s: str, c: i64) -> str {
  s ++ chr(c)
}

// substr_len: sum of char codes in s[start .. start+n).
fn substr_len(s: str, start: i64, n: i64) -> i64 {
  let len = str_len(s);
  let sum = 0;
  let i = 0;
  while i < n {
    let idx = start + i;
    let at_end = if idx >= len then 1 else 0;
    let at_end = if idx < 0 then 1 else at_end;
    let ch = if at_end == 1 then 0 else char(s, idx);
    let sum = sum + ch;
    let i = i + 1;
    0
  };
  sum
}
