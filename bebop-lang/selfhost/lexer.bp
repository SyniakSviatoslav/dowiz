// selfhost/lexer.bp — Bebop self-hosting lexer (module #1)
// Char classification + token-type classification + keyword lookup (tagged i64).
// No structs/enums in .bp: token kinds and keyword tags are plain i64 tags.
//   tok_kind:  0=EOF, 1=ident, 2=int, 3=float, 4=keyword, 5=op, 6=punct
//   keyword:   fn=1, let=2, if=3, then=4, else=5, while=6, module=7, type=8, theorem=9
// Runs via `bebopc check` (typecheck) or `bebopc run` (interpreter).

module core { }

// is_digit: '0' (48) .. '9' (57)
fn is_digit(c: i64) -> i64 {
  let ge48 = if c >= 48 then 1 else 0;
  let le57 = if c <= 57 then 1 else 0;
  ge48 * le57
}

// is_alpha: 'a'(97)..'z'(122) or 'A'(65)..'Z'(90)
fn is_alpha(c: i64) -> i64 {
  let ge97 = if c >= 97 then 1 else 0;
  let le122 = if c <= 122 then 1 else 0;
  let lower = ge97 * le122;
  let ge65 = if c >= 65 then 1 else 0;
  let le90 = if c <= 90 then 1 else 0;
  let upper = ge65 * le90;
  lower + upper
}

// is_ident_char: alpha + digit + underscore '_' (95)
fn is_ident_char(c: i64) -> i64 {
  let a = is_alpha(c);
  let d = is_digit(c);
  let u = if c == 95 then 1 else 0;
  if a + d + u > 0 then 1 else 0
}

// is_op_char: operator chars — + (43) - (45) * (42) / (47)
//   = (61) ! (33) < (60) > (62) : (58). The arrow '->' is '-' then '>',
//   both already operator chars.
fn is_op_char(c: i64) -> i64 {
  let op = 0;
  let op = if c == 43 then 1 else op;
  let op = if c == 45 then 1 else op;
  let op = if c == 42 then 1 else op;
  let op = if c == 47 then 1 else op;
  let op = if c == 61 then 1 else op;
  let op = if c == 33 then 1 else op;
  let op = if c == 60 then 1 else op;
  let op = if c == 62 then 1 else op;
  let op = if c == 58 then 1 else op;
  op
}

// lex_ident_start: alpha + underscore (a digit may not start an identifier)
fn lex_ident_start(c: i64) -> i64 {
  let a = is_alpha(c);
  let u = if c == 95 then 1 else 0;
  if a + u > 0 then 1 else 0
}

// is_space: ' ' (32)
fn is_space(c: i64) -> i64 {
  if c == 32 then 1 else 0
}

// count_tokens: number of whitespace-separated tokens
fn count_tokens(s: str) -> i64 {
  let n = str_len(s);
  let i = 0;
  let c = 0;
  while i < n {
    let ch = char(s, i);
    let sp = is_space(ch);
    let c = c + sp;
    let i = i + 1;
    0
  };
  c + 1
}

// count_numbers: tokens that START with a digit.
// A token starts at position 0 or after a space; classify by first char.
fn count_numbers(s: str) -> i64 {
  let n = str_len(s);
  let i = 0;
  let c = 0;
  let prev_space = 1;
  while i < n {
    let ch = char(s, i);
    let sp = is_space(ch);
    let dg = is_digit(ch);
    let c = c + (prev_space * dg);
    let prev_space = sp;
    let i = i + 1;
    0
  };
  c
}

// count_ifs: count occurrences of the 2-letter keyword "if".
// A token "if" has 'i'(105) at start and 'f'(102) next, followed by space/end.
fn count_ifs(s: str) -> i64 {
  let n = str_len(s);
  let i = 0;
  let c = 0;
  let prev_space = 1;
  while i < n {
    let ch = char(s, i);
    let sp = is_space(ch);
    let i1 = if ch == 105 then 1 else 0;
    let next_end = if i + 1 == n then 1 else 0;
    let ch2 = if next_end == 1 then 0 else char(s, i + 1);
    let f2 = if ch2 == 102 then 1 else 0;
    let after_end = if i + 2 >= n then 1 else 0;
    let after_sp = if after_end == 1 then 1 else is_space(char(s, i + 2));
    let is_if = prev_space * i1 * f2 * after_sp;
    let c = c + is_if;
    let prev_space = sp;
    let i = i + 1;
    0
  };
  c
}

// keyword_tag: map a keyword identifier to its tag (0 = not a keyword).
//   fn=1, let=2, if=3, then=4, else=5, while=6, module=7, type=8, theorem=9
fn keyword_tag(s: str) -> i64 {
  let tag = 0;
  let tag = if s == "fn" then 1 else tag;
  let tag = if s == "let" then 2 else tag;
  let tag = if s == "if" then 3 else tag;
  let tag = if s == "then" then 4 else tag;
  let tag = if s == "else" then 5 else tag;
  let tag = if s == "while" then 6 else tag;
  let tag = if s == "module" then 7 else tag;
  let tag = if s == "type" then 8 else tag;
  let tag = if s == "theorem" then 9 else tag;
  tag
}


// ---- B1-1: full bp_lex parity — flat tokens [kind,off,len,line] ----
// kinds mirror BpTokKind: 0=EOF 1=IDENT 2=GLYPH 3=NUMBER 4=PUNCT.
fn utf8_len(c: i64) -> i64 {
  let is2 = (if c >= 192 then 1 else 0) * (if c <= 223 then 1 else 0);
  let is3 = (if c >= 224 then 1 else 0) * (if c <= 239 then 1 else 0);
  let is4 = (if c >= 240 then 1 else 0) * (if c <= 247 then 1 else 0);
  is2 * 2 + is3 * 3 + is4 * 4 + (1 - is2) * (1 - is3) * (1 - is4)
}
fn scan_ident(src: str, i: i64) -> i64 {
  let strn = str_len(src);
  let j = i;
  let go = 1;
  while go == 1 {
    let at_end = if j >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(src, j);
    let keep = is_ident_char(ch) * (1 - at_end);
    let j = j + keep;
    let go = keep;
    0
  };
  j
}
fn scan_digits(src: str, i: i64) -> i64 {
  let strn = str_len(src);
  let j = i;
  let go = 1;
  while go == 1 {
    let at_end = if j >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(src, j);
    let keep = is_digit(ch) * (1 - at_end);
    let j = j + keep;
    let go = keep;
    0
  };
  j
}
fn skip_lcomment(src: str, i: i64) -> i64 {
  let strn = str_len(src);
  let j = i;
  let go = 1;
  while go == 1 {
    let at_end = if j >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(src, j);
    let is_nl = if ch == 10 then 1 else 0;
    let keep = (1 - at_end) * (1 - is_nl);
    let j = j + keep;
    let go = keep;
    0
  };
  j
}
fn lex_emit(toks: [i64], n: [i64], kind: i64, off: i64, len: i64, line: i64) -> i64 {
  let b = n[0] * 4;
  let _ = toks[b] = kind;
  let _ = toks[b + 1] = off;
  let _ = toks[b + 2] = len;
  let _ = toks[b + 3] = line;
  let _ = n[0] = n[0] + 1;
  n[0]
}
fn lex(src: str, toks: [i64]) -> i64 {
  let strn = str_len(src);
  let i = [0];
  let line = [1];
  let n = [0];
  let done = if strn == 0 then 1 else 0;
  while done == 0 {
    let at_end = if i[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(src, i[0]);
    let nxt = if i[0] + 1 < strn then char(src, i[0] + 1) else 0;
    let is_nl = if ch == 10 then 1 else 0;
    let is_sp = (if ch == 32 then 1 else 0) + (if ch == 9 then 1 else 0) + (if ch == 13 then 1 else 0);
    let is_lc = (if ch == 47 then 1 else 0) * (if nxt == 47 then 1 else 0);
    let is_id = lex_ident_start(ch);
    let is_num = is_digit(ch);
    let is_gl = if ch >= 128 then 1 else 0;
    let is_pn = (1 - is_nl) * (1 - is_sp) * (1 - is_lc) * (1 - is_id) * (1 - is_num) * (1 - is_gl) * (1 - at_end);
    let _ = line[0] = line[0] + is_nl;
    let lc_end = if is_lc == 1 then skip_lcomment(src, i[0]) else i[0];
    let id_end = if is_id == 1 then scan_ident(src, i[0]) else i[0];
    let num_end = if is_num == 1 then scan_digits(src, i[0]) else i[0];
    let gl_len = utf8_len(ch) * is_gl;
    let _ = if is_id == 1 then (let _ = lex_emit(toks, n, 1, i[0], id_end - i[0], line[0]) in 0) else 0;
    let _ = if is_num == 1 then (let _ = lex_emit(toks, n, 3, i[0], num_end - i[0], line[0]) in 0) else 0;
    let _ = if is_gl == 1 then (let _ = lex_emit(toks, n, 2, i[0], gl_len, line[0]) in 0) else 0;
    let _ = if is_pn == 1 then (let _ = lex_emit(toks, n, 4, i[0], 1, line[0]) in 0) else 0;
    let step = is_nl + is_sp + is_lc * (lc_end - i[0]) + is_id * (id_end - i[0]) + is_num * (num_end - i[0]) + is_gl * gl_len + is_pn;
    let _ = i[0] = i[0] + step;
    let done = if i[0] >= strn then 1 else 0;
    0
  };
  let _ = lex_emit(toks, n, 0, strn, 0, line[0]);
  n[0]
}

fn self_check() -> i64 {
  let src = "ab 12 //hey\né€ x_1 77z";
  let toks = zeros(64);
  let cnt = lex(src, toks);
  let f1 = if cnt == 8 then 0 else 1;
  let f2 = if toks[0] == 1 then 0 else 1;
  let f3 = if toks[1] == 0 then 0 else 1;
  let f4 = if toks[2] == 2 then 0 else 1;
  let f5 = if toks[4] == 3 then 0 else 1;
  let f6 = if toks[5] == 3 then 0 else 1;
  let f7 = if toks[6] == 2 then 0 else 1;
  let f8 = if toks[8] == 2 then 0 else 1;
  let f9 = if toks[9] == 12 then 0 else 1;
  let f10 = if toks[10] == 2 then 0 else 1;
  let f11 = if toks[11] == 2 then 0 else 1;
  let f12 = if toks[12] == 2 then 0 else 1;
  let f13 = if toks[13] == 14 then 0 else 1;
  let f14 = if toks[14] == 3 then 0 else 1;
  let f15 = if toks[15] == 2 then 0 else 1;
  let f16 = if toks[16] == 1 then 0 else 1;
  let f17 = if toks[17] == 18 then 0 else 1;
  let f18 = if toks[20] == 3 then 0 else 1;
  let f19 = if toks[21] == 22 then 0 else 1;
  let f20 = if toks[24] == 1 then 0 else 1;
  let f21 = if toks[25] == 24 then 0 else 1;
  let f22 = if toks[26] == 1 then 0 else 1;
  let f23 = if toks[28] == 0 then 0 else 1;
  f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10 + f11 + f12 + f13 + f14 + f15 + f16 + f17 + f18 + f19 + f20 + f21 + f22 + f23
}
