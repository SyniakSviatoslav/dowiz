// selfhost/lexer.bp — Bebop lexer (self-host module #1)
// Counts whitespace-separated tokens in a source string.
// Uses: char(), str_len(), while, let, if (surface only; runs via interpreter).

module core { }

// count_tokens: number of space/newline-separated tokens in `s`
fn count_tokens(s: str) -> i64 {
  let n = str_len(s);
  let i = 0;
  let c = 0;
  while i < n {
    let ch = char(s, i);
    let c = if ch == 32 then c + 1 else c;
    let i = i + 1;
    0
  };
  c + 1
}
