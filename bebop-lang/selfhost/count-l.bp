// selfhost/count-l.bp — count 'l' letters in "hello" (self-hosting demo).
// Bebop modules have no string-literal indexing, so "hello" is an [i64] of
// ASCII codes: h=104 e=101 l=108 l=108 o=111. Two 'l's -> main() == 2.
// run: bebopc run selfhost/count-l.bp main

module core { }

fn count_l(src: [i64], n: i64) -> i64 {
  let i = 0;
  let c = 0;
  let done = 0;
  while done == 0 {
    let at_end = if i >= n then 1 else 0;
    let ch = if at_end == 1 then 0 else src[i];
    let is_l = if ch == 108 then 1 else 0;
    let c = c + is_l;
    let i = i + 1;
    let done = if i >= n then 1 else 0;
    0
  };
  c
}

fn main() -> i64 { count_l([104, 101, 108, 108, 111], 5) }


// B3-2 twin: count-l golden ("hello" has two 'l's)
fn self_check() -> i64 {
  let fail = [0];
  let c1 = count_l([104, 101, 108, 108, 111], 5);
  let _ = fail[0] = fail[0] + (if c1 == 2 then 0 else 1);
  let c2 = count_l([104, 105], 2);
  let _ = fail[0] = fail[0] + (if c2 == 0 then 0 else 1);
  fail[0]
}
