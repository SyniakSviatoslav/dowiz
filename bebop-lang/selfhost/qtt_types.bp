// selfhost/qtt_types.bp — type rules (tagged i64) for Bebop self-host compiler
//
// Type constants (tagged i64, tag = t - (t/8)*8):
//   0=i64 1=f64 2=bool 3=str 4=unit 5=arrow 6=array
//   -1=error (returned on type mismatch)
//
// Functions: is_num, ty_unify, ty_if, ty_binop, ty_arr

module core { }

fn is_num(t: i64) -> i64 {
  let ni = if t == 0 then 1 else 0;
  let nf = if t == 1 then 1 else 0;
  ni + nf
}

fn ty_unify(a: i64, b: i64) -> i64 {
  let eq = if a == b then 1 else 0;
  let numnum = if is_num(a) + is_num(b) == 2 then 1 else 0 - 1;
  if eq == 1 then a else numnum
}

fn ty_if(ct: i64, tt: i64, et: i64) -> i64 {
  if ct == 2 then ty_unify(tt, et) else 0 - 1
}

fn ty_binop(lt: i64, op: i64, rt: i64) -> i64 {
  let arith = if op <= 3 then 1 else 0;
  let both_num = if is_num(lt) + is_num(rt) == 2 then 1 else 0;
  let ris1 = if rt == 1 then 1 else 0;
  let widest = if lt == 1 then 1 else ris1;
  let bn_res = if both_num == 1 then widest else 0 - 1;
  let arith_ok = if arith == 1 then bn_res else 0;
  let eqlt = if lt == rt then 1 else 0;
  let same = if arith == 0 then eqlt else 0;
  let sameres = if same == 1 then 2 else 0 - 1;
  let cmp_ok = if arith == 0 then sameres else 0;
  arith_ok + cmp_ok
}

fn ty_arr(elem: i64) -> i64 {
  elem * 8 + 6
}