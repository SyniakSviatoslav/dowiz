// selfhost/parse_struct.bp — parse a struct declaration into a field type array.
// struct decl syntax: struct Name { f1: t1, f2: t2, ... }
// Type tags:  0=i64, 1=f64, 2=bool, 3=str, -1=error (unknown type).
// parse_struct fills field_types[0..count-1] with the type tag of each field
// and returns the field count.  Returns 0 for empty/malformed input.

module core { }

fn is_alpha(c: i64) -> i64 {
  let lower = if c >= 97 then 1 else 0;
  let lower = if c <= 122 then lower else 0;
  let upper = if c >= 65 then 1 else 0;
  let upper = if c <= 90 then upper else 0;
  lower + upper
}

fn is_digit(c: i64) -> i64 {
  let d = if c >= 48 then 1 else 0;
  let d = if c <= 57 then d else 0;
  d
}

fn is_ident_char(c: i64) -> i64 {
  let a = is_alpha(c);
  let d = is_digit(c);
  let u = if c == 95 then 1 else 0;
  if a + d + u > 0 then 1 else 0
}

fn skip_ws(s: str, pos: [i64]) -> i64 {
  let n = str_len(s);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= n then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let ch32 = if ch == 32 then 1 else 0;
    let is_sp = if at_end == 1 then 0 else ch32;
    let pos_next = pos[0] + is_sp;
    let _ = pos[0] = pos_next;
    let done = if is_sp == 1 then 0 else 1;
    0
  };
  0
}

fn scan_ident(s: str, pos: [i64]) -> i64 {
  let n = str_len(s);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= n then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let ic = if at_end == 1 then 0 else is_ident_char(ch);
    let _ = pos[0] = pos[0] + ic;
    let done = if ic == 1 then 0 else 1;
    0
  };
  0
}

fn parse_type_name(s: str, pos: [i64]) -> i64 {
  let n = str_len(s);
  let at_end = if pos[0] >= n then 1 else 0;
  let first = if at_end == 1 then 0 else char(s, pos[0]);
  let tag = 0 - 1;
  let tag = if first == 105 then 0 else tag;
  let tag = if first == 102 then 1 else tag;
  let tag = if first == 98 then 2 else tag;
  let tag = if first == 115 then 3 else tag;
  let _ = scan_ident(s, pos);
  tag
}

fn parse_struct(s: str, field_types: [i64]) -> i64 {
  let pos = [0];
  let n = str_len(s);
  let _ = skip_ws(s, pos);
  let _ = scan_ident(s, pos);
  let _ = skip_ws(s, pos);
  let _ = scan_ident(s, pos);
  let _ = skip_ws(s, pos);
  let at_end0 = if pos[0] >= n then 1 else 0;
  let br = if at_end0 == 1 then 0 else char(s, pos[0]);
  let is_br = if br == 123 then 1 else 0;
  let _ = if is_br == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  let count = 0;
  let done = 0;
  while done == 0 {
    let _ = skip_ws(s, pos);
    let at_end = if pos[0] >= n then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let is_end = if ch == 125 then 1 else 0;
    let done = is_end;
    let _ = if is_end == 0 then scan_ident(s, pos) else 0;
    let _ = skip_ws(s, pos);
    let at_end2 = if pos[0] >= n then 1 else 0;
    let col_ch = if at_end2 == 1 then 0 else char(s, pos[0]);
    let col58 = if col_ch == 58 then 1 else 0;
    let col = if at_end2 == 1 then 0 else col58;
    let _ = if col == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let _ = skip_ws(s, pos);
    let ty = if is_end == 0 then parse_type_name(s, pos) else 0;
    let ft = if is_end == 0 then count else 0 - 1;
    let _ = if is_end == 0 then (let _ = field_types[ft] = ty in 0) else 0;
    let count = if is_end == 0 then count + 1 else count;
    let _ = skip_ws(s, pos);
    let at_end3 = if pos[0] >= n then 1 else 0;
    let comma_ch = if at_end3 == 1 then 0 else char(s, pos[0]);
    let comma44 = if comma_ch == 44 then 1 else 0;
    let comma = if at_end3 == 1 then 0 else comma44;
    let _ = if comma == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    0
  };
  let at_end4 = if pos[0] >= n then 1 else 0;
  let cb = if at_end4 == 1 then 0 else char(s, pos[0]);
  let _ = if cb == 125 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  count
}