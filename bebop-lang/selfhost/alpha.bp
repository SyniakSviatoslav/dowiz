// selfhost/alpha.bp — alpha-equivalence via (name_hash, type) pair comparison.
// Two occurrences are alpha-equivalent iff their name hashes AND their type
// tags agree. Under De Bruijn-style name hashing, renaming a bound variable
// leaves its hash invariant, so plain equality of the pairs is exactly the
// alpha-equivalence check.

module core { }

// alpha_eq: 1 iff (n1, t1) and (n2, t2) are alpha-equivalent, else 0.
fn alpha_eq(n1: i64, t1: i64, n2: i64, t2: i64) -> i64 {
  let n_eq = if n1 == n2 then 1 else 0;
  let t_eq = if t1 == t2 then 1 else 0;
  n_eq * t_eq
}
