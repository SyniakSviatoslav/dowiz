module core { }
fn fold_add(a: i64, b: i64) -> i64 { a + b }
fn fold_mul(a: i64, b: i64) -> i64 { a * b }
fn is_const(t: i64) -> i64 { if t == 0 then 1 else 0 }
fn const_val(t: i64) -> i64 { t }
fn main() -> i64 { fold_add(40, 2) }


// B3-2 twin: constant-folding helpers
fn self_check() -> i64 {
  let fail = [0];
  let f1 = fold_add(40, 2);
  let _ = fail[0] = fail[0] + (if f1 == 42 then 0 else 1);
  let f2 = fold_mul(6, 7);
  let _ = fail[0] = fail[0] + (if f2 == 42 then 0 else 1);
  // is_const checks the NODE TAG (0 = literal): 0 is const, 5 is not a tag
  let f3 = is_const(0);
  let _ = fail[0] = fail[0] + (if f3 == 1 then 0 else 1);
  let f4 = is_const(5);
  let _ = fail[0] = fail[0] + (if f4 == 0 then 0 else 1);
  fail[0]
}
