// selfhost/struct.bp — struct field get/set/index over parallel [i64] arrays.
// A struct is encoded as three pieces: fields[] (the name-hash of each live
// slot), values[] (the corresponding value), and n (the number of live fields).
// field_index scans fields[0..n) for name_hash; struct_get / struct_set build
// on it. Absent field -> -1; out-of-range set -> -1.

module core { }

// field_index: linear scan; first slot with fields[i] == name_hash, else -1.
fn field_index(fields: [i64], n: i64, name_hash: i64) -> i64 {
  let i = 0;
  let idx = 0 - 1;
  while i < n {
    let idx = if idx < 0 then (if fields[i] == name_hash then i else idx) else idx;
    let i = i + 1;
    0
  };
  idx
}

// struct_get: value at the field named name_hash, or -1 if absent.
fn struct_get(fields: [i64], values: [i64], n: i64, name_hash: i64) -> i64 {
  let idx = field_index(fields, n, name_hash);
  if idx < 0 then (0 - 1) else values[idx]
}

// struct_set: write val into values[idx]; 0 on success, -1 if idx out of [0,n).
fn struct_set(values: [i64], n: i64, idx: i64, val: i64) -> i64 {
  let bad = if idx < 0 then 1 else 0;
  let bad = if idx >= n then 1 else bad;
  if bad == 1 then (0 - 1) else (let _ = values[idx] = val in 0)
}
