// selfhost/eval.bp — recursive expression evaluator over a flat,
// array-encoded AST. Each node occupies one slot (index = node id) across
// four parallel [i64] arrays:
//   kind[i] = node kind   val[i] = payload / 3rd child   a[i] = 1st child   b[i] = 2nd child
//
// Node kinds:
//   0 = lit(int)   -> val[i] is the integer value
//   1 = lit(float) -> val[i] is the float value scaled *1000 (stored as i64)
//   2 = add, 3 = sub, 4 = mul, 5 = div   -> children a[i], b[i]
//   6 = var        -> val[i] is the environment index; value = env[val[i]]
//   7 = if         -> cond a[i], then b[i], else val[i]
//   8 = let        -> bind env[val[i]] = eval(a[i]), then eval(b[i])
//
// eval recurses over the AST; eval_node dispatches on a single node's kind.

module core { }

fn eval(k: [i64], v: [i64], a: [i64], b: [i64], i: i64, env: [i64]) -> i64 {
  eval_node(k, v, a, b, i, env)
}

// eval_let: bind env[val[i]] to the value of a[i], then evaluate body b[i].
fn eval_let(k: [i64], v: [i64], a: [i64], b: [i64], i: i64, env: [i64]) -> i64 {
  let _ = env[v[i]] = eval(k, v, a, b, a[i], env);
  eval(k, v, a, b, b[i], env)
}

// eval_ifnode: kind==7 (if node) — cond a[i] ? b[i] : v[i]. Helper keeps the
// eval_node dispatch branchless (no if nested inside the kind==7 branch).
fn eval_ifnode(k: [i64], v: [i64], a: [i64], b: [i64], i: i64, env: [i64]) -> i64 {
  let cond = eval(k, v, a, b, a[i], env);
  if cond != 0 then eval(k, v, a, b, b[i], env) else eval(k, v, a, b, v[i], env)
}

fn eval_node(k: [i64], v: [i64], a: [i64], b: [i64], i: i64, env: [i64]) -> i64 {
  let kind = k[i];
  let lit = if kind == 0 then v[i] else 0;
  let flt = if kind == 1 then v[i] else 0;
  let add = if kind == 2 then eval(k, v, a, b, a[i], env) + eval(k, v, a, b, b[i], env) else 0;
  let sub = if kind == 3 then eval(k, v, a, b, a[i], env) - eval(k, v, a, b, b[i], env) else 0;
  let mul = if kind == 4 then eval(k, v, a, b, a[i], env) * eval(k, v, a, b, b[i], env) else 0;
  let dv  = if kind == 5 then eval(k, v, a, b, a[i], env) / eval(k, v, a, b, b[i], env) else 0;
  let vr  = if kind == 6 then env[v[i]] else 0;
  let iff = if kind == 7 then eval_ifnode(k, v, a, b, i, env) else 0;
  let le  = if kind == 8 then eval_let(k, v, a, b, i, env) else 0;
  lit + flt + add + sub + mul + dv + vr + iff + le
}

// Self-test: (3 + 4) * 5 = 35.
//   node 0 = add(1, 2)   node 1 = lit 3   node 2 = lit 4
//   node 3 = mul(0, 4)   node 4 = lit 5
fn main() -> i64 {
  let k = [2, 0, 0, 4, 0];
  let v = [0, 3, 4, 0, 5];
  let a = [1, 0, 0, 0, 0];
  let b = [2, 0, 0, 4, 0];
  let env = [0];
  eval(k, v, a, b, 3, env)
}
