// hv.bp — Ф1 HDC core: canonical twin of dowiz-core/src/hypervector.rs.
// D=1024: an HV is [16]i64, little-endian words (word 0 first, bit 0 LSB).
// code(seed) = splitmix64 stream — golden-verified against the Rust
// extraction in bench/vs_rust/spectral_golden/golden.txt (HDC section).
// Constants: GOLDEN=0x9E3779B97F4A7C15, MUL1=0xBF58476D1CE4E5B9,
// MUL2=0x94D049BB133111EB as their two's-complement i64 literals.

// hv_code(seed,out): out[0..16) = splitmix64 stream seeded with `seed`.
// Contract: out is a fresh zeros(16) cell array; returns 16.
fn hv_code(seed: i64, out: [i64]) -> i64 {
  let golden = 0 - 7046029254386353131;
  let mul1 = 0 - 4658895280553007687;
  let mul2 = 0 - 7723592293110705685;
  let s = seed;
  let k = 0;
  while k < 16 {
    let s = s + golden;
    let z = (s ^ (s >> 30)) * mul1;
    let z = (z ^ (z >> 27)) * mul2;
    let _ = out[k] = z ^ (z >> 31);
    let k = k + 1;
    0
  };
  16
}

// hv_bind(a,b,out): ⊗ — wordwise XOR; self-inverse (a⊗b⊗b == a). 16 words.
fn hv_bind(a: [i64], b: [i64], out: [i64]) -> i64 {
  let k = 0;
  while k < 16 {
    let _ = out[k] = a[k] ^ b[k];
    let k = k + 1;
    0
  };
  16
}

// hv_bundle(vs,n,out): ⊕ — element-wise majority over n vectors stored flat
// (vector k occupies vs[k*16 .. k*16+16]). Ties (2c == n) resolve to 0,
// matching the Rust `c * 2 > n` rule, so bundling is stable. out pre-zeroed.
// Bit is folded branch-free (if-expr yields the bit, store unconditional).
// CALLER LAW: out must not alias any vs row — the w-loop writes out[w] while
// later k iterations still read vs[k*16+w].
fn hv_bundle(vs: [i64], n: i64, out: [i64]) -> i64 {
  let w = 0;
  while w < 16 {
    let b = 0;
    while b < 64 {
      let c = 0;
      let k = 0;
      while k < n {
        let c = c + ((vs[k * 16 + w] >> b) & 1);
        let k = k + 1;
        0
      };
      let bit = if c * 2 > n then 1 else 0;
      let _ = out[w] = out[w] | (bit << b);
      let b = b + 1;
      0
    };
    let w = w + 1;
    0
  };
  16
}

// hv_permute(v,shift,out): fixed bit-rotation over the whole D-bit vector —
// encodes sequence/order. shift is taken mod 1024; shift==0 returns v.
// Branch-free lo guard: when bs==0 the lo term is multiplied away instead of
// skipped (a >> 64 is out-of-range on the JIT tier).
fn hv_permute(v: [i64], shift: i64, out: [i64]) -> i64 {
  let sh = shift - (shift / 1024) * 1024;
  let ws = sh / 64;
  let bs = sh - ws * 64;
  let isz = if bs == 0 then 1 else 0;
  let shr = 64 - bs;
  let shr = if shr == 64 then 63 else shr;
  let i = 0;
  while i < 16 {
    let src = i + 16 - ws;
    let src = src - (src / 16) * 16;
    let pv = src + 15;
    let pv = pv - (pv / 16) * 16;
    let hi = v[src] << bs;
    let lo = (v[pv] >> shr) * (1 - isz);
    let _ = out[i] = hi | lo;
    let i = i + 1;
    0
  };
  16
}

// hv_pop1(w): SWAR population count of one 64-bit word (native bitwise tier;
// NEON cnt path can replace this per-vector later without ABI change).
fn hv_pop1(w: i64) -> i64 {
  let m1 = 6148914691236517205;
  let m2 = 3689348814741910323;
  let mh = 1085102592571150095;
  let x = w - ((w >> 1) & m1);
  let x = (x & m2) + ((x >> 2) & m2);
  let x = (x + (x >> 4)) & mh;
  let x = x + (x >> 8);
  let x = x + (x >> 16);
  let x = x + (x >> 32);
  x - (x / 128) * 128
}

// hv_hamming(a,b): count of disagreeing bits over all 16 words.
fn hv_hamming(a: [i64], b: [i64]) -> i64 {
  let acc = 0;
  let k = 0;
  while k < 16 {
    let acc = acc + hv_pop1(a[k] ^ b[k]);
    let k = k + 1;
    0
  };
  acc
}

// hv_popcount(v): set bits of the whole vector.
fn hv_popcount(v: [i64]) -> i64 {
  let acc = 0;
  let k = 0;
  while k < 16 {
    let acc = acc + hv_pop1(v[k]);
    let k = k + 1;
    0
  };
  acc
}
