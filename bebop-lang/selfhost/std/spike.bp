// spike.bp — the event-driven Spike Dispatcher (biti/dispatch tier): a
// dense bit-array of activity flags is scanned without queues by
// hardware-grade bit math — SWAR popcnt for the spike count and a
// de Bruijn multiply for tzcnt (lowest-set-bit index) - then each spike
// dispatches Base + idx*Stride in LSB-first order via branch-free
// arithmetic. This is the agent-runtime dispatcher layer the roadmap
// ordered AFTER the core (compiler/spectral) went stable.
// Constants: de Bruijn C = 0x03F79D71B4CB0A89 (the standard 64-bit
// sequence, shift 58), the 64-entry lookup table embedded verbatim.
// Gate: activity word 0x2000100002040028 = bits {3,5,9,20,33,45};
// dispatch addresses Base(1000) + idx*Stride(8) accumulated in order.
// Fold = addrs_sum*10^6 + popcnt*10^3 + last_idx =
// 6920*10^6 + 6*10^3 + 45 = 6920006045. Oracle = python mirror
// bit-exact (journal entry at gate time).

fn popc(w: i64) -> i64 {
  let m1 = 6148914691236517205;
  let m2 = 3689348814741910323;
  let mh = 1085102592571150095;
  let x = w - ((w >> 1) & m1);
  let x = (x & m2) + ((x >> 2) & m2);
  let x = (x + (x >> 4)) & mh;
  let x = x + (x >> 8);
  let x = x + (x >> 16);
  let x = x + (x >> 32);
  x - (x / 128) * 128
}

fn tzidx(b: i64) -> i64 {
  let db = zeros(64);
  let _ = db[0] = 0;
  let _ = db[1] = 1;
  let _ = db[2] = 48;
  let _ = db[3] = 2;
  let _ = db[4] = 57;
  let _ = db[5] = 49;
  let _ = db[6] = 28;
  let _ = db[7] = 3;
  let _ = db[8] = 61;
  let _ = db[9] = 58;
  let _ = db[10] = 50;
  let _ = db[11] = 42;
  let _ = db[12] = 38;
  let _ = db[13] = 29;
  let _ = db[14] = 17;
  let _ = db[15] = 4;
  let _ = db[16] = 62;
  let _ = db[17] = 55;
  let _ = db[18] = 59;
  let _ = db[19] = 36;
  let _ = db[20] = 53;
  let _ = db[21] = 51;
  let _ = db[22] = 43;
  let _ = db[23] = 22;
  let _ = db[24] = 45;
  let _ = db[25] = 39;
  let _ = db[26] = 33;
  let _ = db[27] = 30;
  let _ = db[28] = 24;
  let _ = db[29] = 18;
  let _ = db[30] = 12;
  let _ = db[31] = 5;
  let _ = db[32] = 63;
  let _ = db[33] = 47;
  let _ = db[34] = 56;
  let _ = db[35] = 27;
  let _ = db[36] = 60;
  let _ = db[37] = 41;
  let _ = db[38] = 37;
  let _ = db[39] = 16;
  let _ = db[40] = 54;
  let _ = db[41] = 35;
  let _ = db[42] = 52;
  let _ = db[43] = 21;
  let _ = db[44] = 44;
  let _ = db[45] = 32;
  let _ = db[46] = 23;
  let _ = db[47] = 11;
  let _ = db[48] = 46;
  let _ = db[49] = 26;
  let _ = db[50] = 40;
  let _ = db[51] = 15;
  let _ = db[52] = 34;
  let _ = db[53] = 20;
  let _ = db[54] = 31;
  let _ = db[55] = 10;
  let _ = db[56] = 25;
  let _ = db[57] = 14;
  let _ = db[58] = 19;
  let _ = db[59] = 9;
  let _ = db[60] = 13;
  let _ = db[61] = 8;
  let _ = db[62] = 7;
  let _ = db[63] = 6;
  let c = 285870213051386505;
  let i = db[((b * c) >> 58) & 63];
  i
}

fn main() -> i64 {
  let act = 35192963072552;
  let cnt = popc(act);
  let base = 1000;
  let stride = 8;
  let w = act;
  let acc = 0;
  let last = 0;
  let n = 0;
  while w != 0 {
    let lb = w & (0 - w);
    let idx = tzidx(lb);
    let addr = base + idx * stride;
    let acc = acc + addr;
    let last = idx;
    let n = n + 1;
    let w = w - lb;
    0
  };
  let nok = if n == cnt then 1 else 0;
  acc * 1000000 + nok * 1000 + last
}
