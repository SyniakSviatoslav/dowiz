// selfhost/std/roman.bp — Roman numeral -> integer value, i64 only.
//
// Symbols and their values:
//   I = 1, V = 5, X = 10, L = 50, C = 100, D = 500, M = 1000
// Standard subtractive parsing: a symbol immediately followed by a
// larger-valued symbol is subtracted (IV=4, IX=9, XL=40, XC=90,
// CD=400, CM=900); otherwise symbols add left-to-right.
// Uppercase input; ASCII codes: I=73 V=86 X=88 L=76 C=67 D=68 M=77.

module core { }

// roman_digit_val: value of one Roman numeral character (ASCII code), 0 otherwise.
fn roman_digit_val(c: i64) -> i64 {
  let v = 0;
  let v = if c == 73 then 1    else v;
  let v = if c == 86 then 5    else v;
  let v = if c == 88 then 10   else v;
  let v = if c == 76 then 50   else v;
  let v = if c == 67 then 100  else v;
  let v = if c == 68 then 500  else v;
  let v = if c == 77 then 1000 else v;
  v
}

// roman_value: integer value of a Roman numeral string (standard rule).
fn roman_value(s: str) -> i64 {
  let n = str_len(s);
  let total = 0;
  let i = 0;
  while i < n {
    let cur = roman_digit_val(char(s, i));
    let nxt = if i + 1 < n then roman_digit_val(char(s, i + 1)) else 0;
    let total = if cur < nxt then total - cur else total + cur;
    let i = i + 1;
    0
  };
  total
}
