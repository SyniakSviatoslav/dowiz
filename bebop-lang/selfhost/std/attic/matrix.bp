// selfhost/std/matrix.bp — BLAS-3 matrix kernels over flat row-major [f64],
// plus fixed 2x2/3x3 integer-matrix helpers ([i64]).
//
// BLAS-3 (f64): matvec (matrix-vector product), matmul (matrix-matrix product
// C = A*B), transpose (A^T). Matrices are flat row-major: element (i, j) of an
// r-by-c matrix lives at flat index i*c + j. There is no array-length builtin,
// so every array-taking fn carries explicit dims and loops i < dim (mirrors the
// C (data, rows, cols) signatures). Full f64 arithmetic throughout.

module core { }

// matvec: out[i] = sum_j a[i*n + j] * x[j] for i in [0, m). Mutates out in
// place; returns 0.
fn matvec(a: [f64], x: [f64], m: i64, n: i64, out: [f64]) -> i64 {
  let i = 0;
  let di = 0;
  while di == 0 {
    let j = 0;
    let acc = 0.0;
    let dj = 0;
    while dj == 0 {
      let acc = acc + a[i * n + j] * x[j];
      let j = j + 1;
      let dj = if j >= n then 1 else 0;
      0
    };
    let _ = out[i] = acc;
    let i = i + 1;
    let di = if i >= m then 1 else 0;
    0
  };
  0
}

// matmul: out = a * b for an (m x k) matrix a and a (k x n) matrix b, writing
// an (m x n) result. out[i*n + j] = sum_p a[i*k + p] * b[p*n + j]. n is capped
// at 8 by callers (small fixed inner dim). Mutates out in place; returns 0.
fn matmul(a: [f64], b: [f64], m: i64, k: i64, n: i64, out: [f64]) -> i64 {
  let i = 0;
  let di = 0;
  while di == 0 {
    let j = 0;
    let dj = 0;
    while dj == 0 {
      let p = 0;
      let acc = 0.0;
      let dp = 0;
      while dp == 0 {
        let acc = acc + a[i * k + p] * b[p * n + j];
        let p = p + 1;
        let dp = if p >= k then 1 else 0;
        0
      };
      let _ = out[i * n + j] = acc;
      let j = j + 1;
      let dj = if j >= n then 1 else 0;
      0
    };
    let i = i + 1;
    let di = if i >= m then 1 else 0;
    0
  };
  0
}

// transpose: out[j*m + i] = a[i*n + j] for i in [0, m), j in [0, n). Writes the
// (n x m) transpose of an (m x n) matrix a into out. Mutates out in place;
// returns 0.
fn transpose(a: [f64], m: i64, n: i64, out: [f64]) -> i64 {
  let i = 0;
  let di = 0;
  while di == 0 {
    let j = 0;
    let dj = 0;
    while dj == 0 {
      let _ = out[j * m + i] = a[i * n + j];
      let j = j + 1;
      let dj = if j >= n then 1 else 0;
      0
    };
    let i = i + 1;
    let di = if i >= m then 1 else 0;
    0
  };
  0
}

// ── fixed 2x2/3x3 integer matrices ([i64]) ──────────────────────────────

// mat2_mul: out = a * b for 2x2 matrices (out must be length 4).
fn mat2_mul(a: [i64], b: [i64], out: [i64]) -> i64 {
  let _ = out[0] = (a[0] * b[0]) + (a[1] * b[2]);
  let _ = out[1] = (a[0] * b[1]) + (a[1] * b[3]);
  let _ = out[2] = (a[2] * b[0]) + (a[3] * b[2]);
  let _ = out[3] = (a[2] * b[1]) + (a[3] * b[3]);
  0
}

// mat2_det: determinant of a 2x2 matrix.
fn mat2_det(a: [i64]) -> i64 { (a[0] * a[3]) - (a[1] * a[2]) }

// mat2_trace: trace of a 2x2 matrix.
fn mat2_trace(a: [i64]) -> i64 { a[0] + a[3] }

// mat2_identity: write the 2x2 identity into out.
fn mat2_identity(out: [i64]) -> i64 {
  let _ = out[0] = 1;
  let _ = out[1] = 0;
  let _ = out[2] = 0;
  let _ = out[3] = 1;
  0
}

// mat3_det: determinant of a 3x3 matrix (cofactor expansion on row 0).
fn mat3_det(a: [i64]) -> i64 {
  (a[0] * ((a[4] * a[8]) - (a[5] * a[7])))
    - (a[1] * ((a[3] * a[8]) - (a[5] * a[6])))
    + (a[2] * ((a[3] * a[7]) - (a[4] * a[6])))
}
