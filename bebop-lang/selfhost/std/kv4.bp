use "selfhost/prelude/store.bp"
use "selfhost/prelude/proj.bp"
// kv4.bp -- KV v4, the copy-on-write B+tree (W-ES-P8D; FORMAT §9.1 v4, crates/bebop-kv/src/tree/),
// read by kv.bp's `n` / `h` to the same count and the same FNV-1a fold as every other reader. The walk
// itself lives in the PRELUDE since W-ES-P8E (selfhost/prelude/kv4walk.bp), so that proj.bp's kind-2
// fold shares it; this file is the ORDER of its two passes for a reader that must name a bad crc:
//   crc first (pj_kv4_crc_ok: 0 = BAD_CRC -> -10), then the pure shape-and-fold pass (pj_kv4_fold_s:
//   -3 = NOT_A_KV), the verdict kv4.bp's single walk gave before (-10 before -3).
// State s: s[0] fold  s[1] count  s[2] status (0, -3, -10). THE ANSWER: s[2] = 0 and s[0]/s[1].
fn kv4_fold(base: [i64], root: i64, s: [i64], tmp: [i64]) -> i64 {
  let c = pj_kv4_crc_ok(base, root, tmp);
  let _ = if c == 0 then (let _ = s[2] = 0 - 10 in 0) else pj_kv4_fold_s(base, root, s);
  let _ = if c == 2 then (let _ = s[2] = (if s[2] == 0 then 0 - 3 else s[2]) in 0) else 0;
  s[0]
}
// kv.bp's `n` and `h` for a v4 image: the count / the fold, or the status (-3, -10) when refused
fn kv4_n(base: [i64], root: i64, tmp: [i64]) -> i64 {
  let s = zeros(8);
  let _ = kv4_fold(base, root, s, tmp);
  if s[2] != 0 then s[2] else s[1]
}
fn kv4_h(base: [i64], root: i64, tmp: [i64]) -> i64 {
  let s = zeros(8);
  let h = kv4_fold(base, root, s, tmp);
  if s[2] != 0 then s[2] else h
}
