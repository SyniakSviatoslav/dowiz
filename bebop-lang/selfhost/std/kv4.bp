use "selfhost/prelude/store.bp"
use "selfhost/prelude/proj.bp"
// kv4.bp -- KV v4, the copy-on-write B+tree (W-ES-P8D; FORMAT §9.1 v4, crates/bebop-kv/src/tree/),
// read by kv.bp's `n` / `h` to the same count and the same FNV-1a fold as every other reader
// (crates/bebop-wasm/src/kv4.rs, oracle.py kv4_entries, bebop-conform, the C ABI). A READER in std/,
// not the store prelude: the compiler's own store stays store.bp, and proj.bp's pj_kv_known still
// refuses v4 (trap 78) for kind-2/kind-4 projections, which no one has taught the tree yet.
//
// The image (every ref is an offset from the object, STRICTLY BACKWARD):
//   root  8 cells {n, 0, 0, 0, 0, VERSION = 4, ref TREE, DEPTH}; DEPTH 0 = the empty map (TREE 0, n 0)
//   LEAF  [META = 1<<56 | m] [K_i, ref VAL_i]... [key bytes]           reached at level 1
//   NODE  [META = 2<<56 | hc<<48 | m] [ref C_i, K_i, hc hash cells]... [key bytes]
//   VAL   [vlen] [bytes, 8 to a cell]
//   K_i   = koff << 16 | klen, into the node's key area, which starts at payload cell 1 + (2+hc) * m.
// Rules (TreeIn::verify): every reachable object's crc; a leaf exactly DEPTH <= 16 levels down; a
// separator K_i equals child i's first key; keys strictly ascending over the whole tree; a reachable
// node has >= 2 children; the root's n is the count of leaf entries.
//
// The walk is ITERATIVE: an explicit stack of frames, one per level, 8 cells each, at most 16 deep
// (the language has one-cell mutables and no closures; a frame's index cell is the loop variable).
//   fr[8d+0] obj   fr[8d+1] m   fr[8d+2] stride   fr[8d+3] key-area byte address
//   fr[8d+4] key-area bytes   fr[8d+5] next slot   fr[8d+6] leaf?   fr[136] LEAF digest  fr[137] NODE
// State s: s[0] fold  s[1] count  s[2] status (0, -3, -10)  s[3] last key byte address  s[4] its length
//   s[5] a last key exists  s[6] VAL digest.  w: a 4-cell scratch for (address, length) pairs.
// THE ANSWER: s[2] = 0 and s[0]/s[1]; -3 for any rule that does not hold (a v4 CLAIM that does not
// hold, NOT_A_KV, the word a v3 chain that does not hold gets, docs/STATUS-CODES.md 2); -10 for an
// object whose crc fails (BAD_CRC, 10). conformance.sh maps both.

// byte b of the image, b an ABSOLUTE byte address (`>>` is logical: the mask is exact)
fn kv4_byte(base: [i64], b: i64) -> i64 { (base[b >> 3] >> (8 * (b & 7))) & 255 }
// FNV-1a over len || the len bytes at byte address addr (pj_kv_frame's law, absolute addresses)
fn kv4_frame(h: i64, base: [i64], addr: i64, len: i64) -> i64 {
  let x = pj_fnv_u64(h, len);
  let j = 0;
  while j < len {
    let x = pj_fnv_byte(x, kv4_byte(base, addr + j));
    let j = j + 1;
    0
  };
  x
}
// lexicographic compare of two byte strings by (address, length): -1, 0, 1
fn kv4_cmp(base: [i64], a: i64, al: i64, b: i64, bl: i64) -> i64 {
  let n = if al < bl then al else bl;
  let j = 0;
  let r = 0;
  while (if r == 0 then (if j < n then 1 else 0) else 0) == 1 {
    let x = kv4_byte(base, a + j);
    let y = kv4_byte(base, b + j);
    let r = if x < y then 0 - 1 else (if x > y then 1 else 0);
    let j = j + 1;
    0
  };
  if r != 0 then r else (if al < bl then 0 - 1 else (if al > bl then 1 else 0))
}
// an object's layout digest, the high half of its first header cell (st_len is the low half)
fn kv4_digest(base: [i64], obj: i64) -> i64 { base[obj] >> 32 }
// the ref in payload cell i of obj, which must point strictly backward (rule 1): the target, or -1
fn kv4_back(base: [i64], obj: i64, i: i64) -> i64 {
  let off = st_get(base, obj, i);
  if off >= 0 then 0 - 1 else (if obj + off < 0 then 0 - 1 else obj + off)
}
// decode the node at obj (its crc already held) into frame d; leaf = 1 at level 1. 0, or -3.
fn kv4_node(base: [i64], obj: i64, leaf: i64, fr: [i64], d: i64) -> i64 {
  let want = if leaf == 1 then fr[136] else fr[137];
  let len = st_len(base, obj);
  let meta = st_get(base, obj, 0);
  let kind = meta >> 56;
  let hc = (meta >> 48) & 255;
  let m = meta & ((1 << 48) - 1);
  let ok = if kv4_digest(base, obj) != want then 0 else (if kind != (if leaf == 1 then 1 else 2) then 0
           else (if (if leaf == 1 then hc else 0) != 0 then 0 else (if m < 1 then 0 else (if m > 65535 then 0 else 1))));
  if ok == 0 then 0 - 3 else (
    let stride = 2 + hc in
    let karea = 1 + stride * m in
    if karea > len then 0 - 3 else (
      let _ = fr[8 * d] = obj in
      let _ = fr[8 * d + 1] = m in
      let _ = fr[8 * d + 2] = stride in
      let _ = fr[8 * d + 3] = (obj + 2 + karea) * 8 in
      let _ = fr[8 * d + 4] = (len - karea) * 8 in
      let _ = fr[8 * d + 5] = 0 in
      let _ = fr[8 * d + 6] = leaf in
      0))
}
// slot i of frame d: the payload cell of its key (a leaf's slot is (K, V), a node's (C, K, hash))
fn kv4_kcell(fr: [i64], d: i64, i: i64) -> i64 { 1 + fr[8 * d + 2] * i + (1 - fr[8 * d + 6]) }
fn kv4_rcell(fr: [i64], d: i64, i: i64) -> i64 { 1 + fr[8 * d + 2] * i + fr[8 * d + 6] }
// slot i's key of frame d as (byte address, length) into w[o], w[o+1]: 0, or -3 past the key area
fn kv4_key(base: [i64], fr: [i64], d: i64, i: i64, w: [i64], o: i64) -> i64 {
  let k = st_get(base, fr[8 * d], kv4_kcell(fr, d, i));
  let koff = k >> 16;
  let klen = k & 65535;
  if koff + klen > fr[8 * d + 4] then 0 - 3 else (
    let _ = w[o] = fr[8 * d + 3] + koff in
    let _ = w[o + 1] = klen in
    0)
}
// enter the node at obj as frame d: crc, decode, >= 2 children unless a leaf, first key = the
// separator (sa, sl) unless sl < 0 (the top). 0, -3 or -10.
fn kv4_enter(base: [i64], obj: i64, leaf: i64, fr: [i64], d: i64, sa: i64, sl: i64, w: [i64], tmp: [i64]) -> i64 {
  if st_check(base, obj, tmp) == 0 then 0 - 10 else (
    let r = kv4_node(base, obj, leaf, fr, d) in
    if r != 0 then r else (
      if (if leaf == 1 then 2 else fr[8 * d + 1]) < 2 then 0 - 3 else (
        if sl < 0 then 0 else (
          let kr = kv4_key(base, fr, d, 0, w, 2) in
          if kr != 0 then kr else (if kv4_cmp(base, w[2], w[3], sa, sl) != 0 then 0 - 3 else 0)))))
}
// one leaf entry: key (w[0], w[1]) already above the last; the value at r. Sets s[2] on a refusal.
fn kv4_leaf(base: [i64], s: [i64], r: i64, w: [i64], tmp: [i64]) -> i64 {
  if st_check(base, r, tmp) == 0 then (let _ = s[2] = 0 - 10 in 0) else (
    let vlen = st_get(base, r, 0) in
    let ok = if kv4_digest(base, r) != s[6] then 0 else (if vlen < 0 then 0 else (if vlen > (1 << 30) then 0
             else (if st_len(base, r) != 1 + ((vlen + 7) >> 3) then 0 else 1))) in
    if ok == 0 then (let _ = s[2] = 0 - 3 in 0) else (
      let _ = s[0] = kv4_frame(s[0], base, w[0], w[1]) in
      let _ = s[0] = kv4_frame(s[0], base, (r + 3) * 8, vlen) in
      let _ = s[1] = s[1] + 1 in
      let _ = s[3] = w[0] in
      let _ = s[4] = w[1] in
      let _ = s[5] = 1 in
      0))
}
// slot i of frame d (level = depth - d): descend into a child (returns 1 = one frame pushed) or
// take a leaf entry (returns 0). A refusal sets s[2] and returns 0.
fn kv4_step(base: [i64], depth: i64, s: [i64], fr: [i64], d: i64, i: i64, w: [i64], tmp: [i64]) -> i64 {
  let kr = kv4_key(base, fr, d, i, w, 0);
  let r = kv4_back(base, fr[8 * d], kv4_rcell(fr, d, i));
  if kr != 0 then (let _ = s[2] = 0 - 3 in 0) else (if r < 0 then (let _ = s[2] = 0 - 3 in 0) else (
    let level = depth - d in
    if level > 1 then (
      let e = kv4_enter(base, r, (if level == 2 then 1 else 0), fr, d + 1, w[0], w[1], w, tmp) in
      if e != 0 then (let _ = s[2] = e in 0) else 1
    ) else (
      let below = if s[5] == 1 then (if kv4_cmp(base, s[3], s[4], w[0], w[1]) >= 0 then 1 else 0) else 0 in
      if below == 1 then (let _ = s[2] = 0 - 3 in 0) else kv4_leaf(base, s, r, w, tmp))))
}
// the whole tree under top (DEPTH = depth >= 1), in key order, into s
fn kv4_walk(base: [i64], depth: i64, top: i64, s: [i64], fr: [i64], w: [i64], tmp: [i64]) -> i64 {
  let _ = s[2] = kv4_enter(base, top, (if depth == 1 then 1 else 0), fr, 0, 0, 0 - 1, w, tmp);
  let sp = if s[2] == 0 then 1 else 0;
  while sp > 0 {
    let d = sp - 1;
    let i = fr[8 * d + 5];
    let sp = if i == fr[8 * d + 1] then sp - 1 else (
      let _ = fr[8 * d + 5] = i + 1 in
      sp + kv4_step(base, depth, s, fr, d, i, w, tmp));
    let sp = if s[2] != 0 then 0 else sp;
    0
  };
  0
}
// kv4_fold: the fold of the v4 image under root (s[0]) and its entry count (s[1]); s[2] the status.
fn kv4_fold(base: [i64], root: i64, s: [i64], tmp: [i64]) -> i64 {
  let fr = zeros(140);
  let w = zeros(4);
  let _ = fr[136] = st_digest("KV4L{i64,[i64]}");
  let _ = fr[137] = st_digest("KV4N{i64,[i64]}");
  let _ = s[6] = st_digest("KV4V{i64,[i64]}");
  let _ = s[0] = pj_fnv_offset();
  let _ = s[1] = 0;
  let _ = s[5] = 0;
  let n = st_get(base, root, 0);
  let depth = st_get(base, root, 7);
  let zero14 = st_get(base, root, 1) + st_get(base, root, 2) + st_get(base, root, 3) + st_get(base, root, 4);
  let shape = if st_len(base, root) != 8 then 0 else (if zero14 != 0 then 0 else (if n < 0 then 0
              else (if depth < 0 then 0 else (if depth > 16 then 0 else 1))));
  let top = if depth == 0 then (if st_get(base, root, 6) != 0 then 0 - 1 else (if n != 0 then 0 - 1 else 0))
            else kv4_back(base, root, 6);
  let _ = s[2] = if shape == 0 then 0 - 3 else (if top < 0 then 0 - 3 else (if st_check(base, root, tmp) == 0 then 0 - 10 else 0));
  let _ = if s[2] == 0 then (if depth > 0 then kv4_walk(base, depth, top, s, fr, w, tmp) else 0) else 0;
  let _ = s[2] = if s[2] == 0 then (if s[1] != n then 0 - 3 else 0) else s[2];
  s[0]
}
// kv.bp's `n` and `h` for a v4 image: the count / the fold, or the status (-3, -10) when refused
fn kv4_n(base: [i64], root: i64, tmp: [i64]) -> i64 {
  let s = zeros(8);
  let _ = kv4_fold(base, root, s, tmp);
  if s[2] != 0 then s[2] else s[1]
}
fn kv4_h(base: [i64], root: i64, tmp: [i64]) -> i64 {
  let s = zeros(8);
  let h = kv4_fold(base, root, s, tmp);
  if s[2] != 0 then s[2] else h
}
