use "selfhost/prelude/sched.bp"
// selfhost/std/pool.bp — worker pool over the shared seed arena, a CLIENT of the DAG scheduler.
//
// DG6 (docs/design/SPEC-BEBOP-DAG-RUNTIME-2026-09-28.md §7.1 T-5, 2026-10-01): the worker loop is
// selfhost/prelude/sched.bp's -- persistent sys_clone workers (CLONE_VM | CLONE_FS | CLONE_FILES |
// CLONE_SIGHAND | CLONE_THREAD = 68864) parked on a futex, nodes claimed by LDADDAL, the parent woken
// once per level, outputs assembled in node-index order. This file used to carry its own three spawn
// loops (one per entry point) with per-worker done flags and never-woken park cells; each entry point
// is now ONE level of W nodes on the scheduler, and the same three values come out:
//   par_sum(4, 1000) = 10000, par_merge(4, 1000) = 10000, par_tids(4) = 4  (bench/vs_rust/pool_parity.sh)
// Every level here passes sch_always() as its estimate: these entry points exist to exercise the
// threads, so they ask for the workers whatever T-4's 10 ms threshold would say about 1000-unit nodes.
// W may exceed sch_w_max() (pool_parity runs W = 4 on the slot's three cores): T-3's cap is the
// scheduler's DEFAULT for real work, and par_tids' evidence is "W workers got W tids".

module core { }

// pool_part: node i of par_sum -- (i+1) * per, returned into out[i].
pure fn pool_part(ctx: i64, i: i64) -> i64 {
  let c = sch_h(ctx);
  (i + 1) * c[0]
}
// pool_merge_part: node i of par_merge -- adds (i+1) * per into ONE shared cell with LDADDAL; real
// threads race on it and the atomic merge must not lose an update.
fn pool_merge_part(ctx: i64, i: i64) -> i64 {
  let c = sch_h(ctx);
  sys_atomic_add(c, 1, (i + 1) * c[0])
}

// par_sum(W, per): W nodes on W workers; the merge sums out[0..W) in node-index order.
fn par_sum(W: i64, per: i64) -> i64 {
  let ctx = zeros(2);
  let out = zeros(W + 1);
  let _ = ctx[0] = per;
  let e = sch_new(W);
  let _ = sch_level(e, 0, W, sch_always(), &pool_part, sch_a(ctx), out);
  let _ = sch_stop(e);
  let k = 0;
  let acc = 0;
  while k < W {
    let acc = acc + out[k];
    let k = k + 1;
    0
  };
  acc
}

// par_merge(W, per): the same split, published into ctx[1] by sys_atomic_add.
fn par_merge(W: i64, per: i64) -> i64 {
  let ctx = zeros(2);
  let out = zeros(W + 1);
  let _ = ctx[0] = per;
  let e = sch_new(W);
  let _ = sch_level(e, 0, W, sch_always(), &pool_merge_part, sch_a(ctx), out);
  let _ = sch_stop(e);
  ctx[1]
}

// par_tids(W): real-thread evidence without /proc. sys_clone returns the child tid in the PARENT
// (0 in the child); sch_spawn records each one, sch_tids counts the nonzero entries. W real threads
// -> W. A sequential emulation (sys_clone always 0) -> 0.
fn par_tids(W: i64) -> i64 {
  let e = sch_new(W);
  let c = sch_tids(e);
  let _ = sch_stop(e);
  c
}
