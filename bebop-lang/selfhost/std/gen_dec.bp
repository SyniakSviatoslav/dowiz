// selfhost/std/gen_dec.bp -- ROADMAP E4: per-column JIT'd decoders, bit widths as `ubfx`
// immediates.
//
// WHY A NEW FILE AND NOT gen_gb.bp: gen_gb.bp is the GraphBLAS kernel generator -- every user of
// it must ALSO directly `use` sha256.bp + store.bp + gb.bp (its own header: a nested `use` inside
// an included file is not followed, T47b), and it is already 955 lines against a 400 KB source
// slurp cap with 1.6 % headroom. A packed-column decoder generator needs NONE of sha256/store/gb,
// so it is a self-contained file in gen_gb.bp's SHAPE (wr_str / wr_i64 / wr_ch cursor writers,
// sys_open + sys_export to publish the .bp) with no `use` line at all. The MECHANISM is
// gen_gb.bp's, unchanged: write Bebop SOURCE into a buffer, compile it.
//
// THE MECHANISM E4 RESTS ON IS ALREADY IN THE COMPILER, it is only unreachable from a header-
// driven decoder:
//   bebop.bp:3125 vs_try_shift_imm -- `x >> k` with k a CONSTANT in 0..63 is ONE UBFM word
//                                     (lsr imm) instead of lsrv.
//   bebop.bp:3196 vs_try_and_imm   -- `x & C` with C = 2^k - 1 is ONE `and Xd,Xn,#C` word
//                                     instead of mat_const + and-with-register.
//   bebop.bp:3144 vs_try_ubfx      -- and then the mask COLLAPSES BACKWARD INTO the shift:
//                                     `(x >> lsb) & (2^w - 1)` becomes a single `ubfx
//                                     Xd,Xn,#lsb,#w`, guarded by lsb + w <= 64.
// All three test `vs_entry_kind(...) == 1`, i.e. the operand is a compile-time CONSTANT. A
// decoder that reads `w` out of a column header can never satisfy that. A decoder GENERATED for a
// known `w` satisfies all three, which is the whole of E4.
//
// COLUMN LAYOUT (non-straddling): per = 64 / w values per i64 cell, field k of cell c at bit k*w.
// Non-straddling is not a simplification, it is the PRECONDITION: vs_try_ubfx's fourth guard is
// lsb + width <= 64, so a value that straddles a cell boundary cannot be one ubfx in either arm.
// bytes/slot = 8 / per. 64 mod w bits per cell are unused (w = 8, 16 waste nothing).
//
// WHAT IS GENERATED: a complete standalone program, no `use`, no string literal anywhere (a
// bebop string literal has no backslash escape -- scan_one_lit, bebop.bp:5709 -- so generated
// text that must contain a `"` can only get one via wr_ch; the generated program therefore
// prints a bare space-separated number line and needs no literal at all):
//     2 w per n cells reps fold ms ns_per_slot_x100 bytes_per_slot_x100
// The leading 2 marks the specialised arm (the generic probe prints its own labelled line).
// `build` in the generated program is deliberately the SAME generic packing loop the generic
// probe uses, so both arms fold byte-identical columns; it is outside the timed region.

// ---- text-buffer writers (gen_gb.bp:47-116, same caller-owned 1-cell cursor idiom) ----
fn wr_str(dst: [i64], pos: [i64], s: str) -> i64 {
  let off = pos[0];
  let n = str_len(s);
  let i = 0;
  while i < n {
    let _ = dst[off + i] = char(s, i);
    let i = i + 1;
    0
  };
  let _ = pos[0] = off + n;
  0
}
fn wr_i64(dst: [i64], pos: [i64], v: i64) -> i64 {
  let off = pos[0];
  let neg = if v < 0 then 1 else 0;
  let m = if v < 0 then 0 - v else v;
  let p = off + 23;
  let m2 = m;
  let go = 1;
  while go == 1 {
    let d = m2 - (m2 / 10) * 10;
    let _ = dst[p] = 48 + d;
    let p = p - 1;
    let m2 = m2 / 10;
    let go = if m2 > 0 then 1 else 0;
    0
  };
  let start = p + 1;
  let len = (off + 24) - start;
  let i = 0;
  while i < len {
    let _ = dst[off + neg + i] = dst[start + i];
    let i = i + 1;
    0
  };
  let _ = if neg == 1 then (let _ = dst[off] = 45 in 0) else 0;
  let _ = pos[0] = off + len + neg;
  0
}
fn wr_ch(dst: [i64], pos: [i64], c: i64) -> i64 {
  let off = pos[0];
  let _ = dst[off] = c;
  let _ = pos[0] = off + 1;
  0
}

// ---- generated part 1: the untimed helpers (decimal print, argv parse, column build) ----
fn gen_dec_helpers(dst: [i64], pos: [i64], w: i64, per: i64, mask: i64) -> i64 {
  let _ = wr_str(dst, pos, "fn p_num(buf: [i64], pos: [i64], v: i64) -> i64 {
  let off = pos[0];
  let p = off + 23;
  let m2 = v;
  let go = 1;
  while go == 1 {
    let d = m2 - (m2 / 10) * 10;
    let _ = buf[p] = 48 + d;
    let p = p - 1;
    let m2 = m2 / 10;
    let go = if m2 > 0 then 1 else 0;
    0
  };
  let start = p + 1;
  let len = (off + 24) - start;
  let i = 0;
  while i < len {
    let _ = buf[off + i] = buf[start + i];
    let i = i + 1;
    0
  };
  let _ = buf[off + len] = 32;
  let _ = pos[0] = off + len + 1;
  0
}
fn p_atoi(s: str) -> i64 {
  let n = str_len(s);
  let i = 0;
  let acc = 0;
  while i < n {
    let c = char(s, i);
    let ok = if c >= 48 then (if c <= 57 then 1 else 0) else 0;
    let acc = if ok == 1 then acc * 10 + (c - 48) else acc;
    let i = i + 1;
    0
  };
  acc
}
");
  // build: the SAME generic packing loop as tmp/dec_base.bp's, so the two arms fold identical
  // columns. Untimed, so its literals buy nothing and are only there to keep the text short.
  let _ = wr_str(dst, pos, "fn build(col: [i64], n: i64) -> i64 {
  let x = 88172645463325252;
  let i = 0;
  while i < n {
    let x = x * 6364136223846793005 + 1442695040888963407;
    let v = (x >> 17) & ");
  let _ = wr_i64(dst, pos, mask);
  let _ = wr_str(dst, pos, ";
    let ci = i / ");
  let _ = wr_i64(dst, pos, per);
  let _ = wr_str(dst, pos, ";
    let sh = (i - ci * ");
  let _ = wr_i64(dst, pos, per);
  let _ = wr_str(dst, pos, ") * ");
  let _ = wr_i64(dst, pos, w);
  let _ = wr_str(dst, pos, ";
    let _ = col[ci] = col[ci] | (v << sh);
    let i = i + 1;
    0
  };
  0
}
");
  0
}

// ---- generated part 2: THE POINT. cell_sum_s(c) with every field's lsb and the mask written out
// as LITERAL constants, so each extraction meets vs_try_ubfx's constant guard and becomes one
// `ubfx Xd,Xn,#(k*w),#w`. The generic twin (tmp/dec_base.bp cell_sum_g) is the identical walk with
// sh and mask as variables: lsrv + mat_const + and-reg, and a loop it cannot unroll because `per`
// is not known until run time. Field 0 is emitted as a bare `c & mask` (vs_try_and_imm alone) --
// `(c >> 0) & mask` would also fold, but the bare form is what the arithmetic actually is.
fn gen_cell_sum(dst: [i64], pos: [i64], w: i64, per: i64, mask: i64) -> i64 {
  let _ = wr_str(dst, pos, "fn cell_sum_s(c: i64) -> i64 {
  let acc = c & ");
  let _ = wr_i64(dst, pos, mask);
  let _ = wr_str(dst, pos, ";
");
  let k = 1;
  while k < per {
    let _ = wr_str(dst, pos, "  let acc = acc + ((c >> ");
    let _ = wr_i64(dst, pos, k * w);
    let _ = wr_str(dst, pos, ") & ");
    let _ = wr_i64(dst, pos, mask);
    let _ = wr_str(dst, pos, ");
");
    let k = k + 1;
    0
  };
  let _ = wr_str(dst, pos, "  acc
}
fn fold_s(col: [i64], nc: i64) -> i64 {
  let acc = 0;
  let ci = 0;
  while ci < nc {
    let acc = acc + cell_sum_s(col[ci]);
    let ci = ci + 1;
    0
  };
  acc
}
");
  0
}

// ---- generated part 3: main. nc and n are literals too (per is known, so they are), argv[2] is
// the rep count only. Timed region = the rep loop over fold_s, exactly as the generic probe times
// its rep loop over fold_a / fold_a2.
fn gen_dec_main(dst: [i64], pos: [i64], w: i64, per: i64, nc: i64) -> i64 {
  let _ = wr_str(dst, pos, "fn main(argc: i64, argv: [str]) -> i64 {
  let reps = p_atoi(argv[2]);
  let nc = ");
  let _ = wr_i64(dst, pos, nc);
  let _ = wr_str(dst, pos, ";
  let n = ");
  let _ = wr_i64(dst, pos, nc * per);
  let _ = wr_str(dst, pos, ";
  let col = zeros(nc);
  let _ = build(col, n);
  let fold1 = fold_s(col, nc);
  let t0 = clock_ms();
  let tot = 0;
  let r = 0;
  while r < reps {
    let tot = tot + fold_s(col, nc);
    let r = r + 1;
    0
  };
  let t1 = clock_ms();
  let buf = zeros(512);
  let pos = zeros(1);
  let _ = p_num(buf, pos, 2);
  let _ = p_num(buf, pos, ");
  let _ = wr_i64(dst, pos, w);
  let _ = wr_str(dst, pos, ");
  let _ = p_num(buf, pos, ");
  let _ = wr_i64(dst, pos, per);
  let _ = wr_str(dst, pos, ");
  let _ = p_num(buf, pos, n);
  let _ = p_num(buf, pos, nc);
  let _ = p_num(buf, pos, reps);
  let _ = p_num(buf, pos, fold1);
  let _ = p_num(buf, pos, t1 - t0);
  let _ = p_num(buf, pos, (t1 - t0) * 100000 / (reps * (n / 1000)));
  let _ = p_num(buf, pos, ");
  let _ = wr_i64(dst, pos, 800 / per);
  let _ = wr_str(dst, pos, ");
  let _ = p_num(buf, pos, tot);
  let _ = buf[pos[0]] = 10;
  let _ = sys_write(1, buf, pos[0] + 1);
  0
}
");
  0
}

// gen_dec_text: the whole specialised program for width w.
fn gen_dec_text(dst: [i64], pos: [i64], w: i64, slots: i64) -> i64 {
  let per = 64 / w;
  let mask = (1 << w) - 1;
  let nc = slots / per;
  let _ = gen_dec_helpers(dst, pos, w, per, mask);
  let _ = gen_cell_sum(dst, pos, w, per, mask);
  gen_dec_main(dst, pos, w, per, nc)
}

// gen_dec(dir, w, slots): writes <dir>/dec_w<w>.bp. Returns the byte length written.
fn gen_dec(dir: str, w: i64, slots: i64) -> i64 {
  let path = zeros(512);
  let ppos = zeros(1);
  let _ = wr_str(path, ppos, dir);
  let _ = wr_str(path, ppos, "/dec_w");
  let _ = wr_i64(path, ppos, w);
  let _ = wr_str(path, ppos, ".bp");
  let plen = ppos[0];
  let text = zeros(16384);
  let tpos = zeros(1);
  let _ = gen_dec_text(text, tpos, w, slots);
  let fd = sys_open(path, plen, 578);
  let _ = sys_export(fd, text, tpos[0]);
  let _ = sys_close(fd);
  tpos[0]
}

// argv[2] = output directory, argv[3] = w (bits per value), argv[4] = slot count.
fn a2i(s: str) -> i64 {
  let n = str_len(s);
  let i = 0;
  let acc = 0;
  while i < n {
    let c = char(s, i);
    let ok = if c >= 48 then (if c <= 57 then 1 else 0) else 0;
    let acc = if ok == 1 then acc * 10 + (c - 48) else acc;
    let i = i + 1;
    0
  };
  acc
}
fn main(argc: i64, argv: [str]) -> i64 {
  gen_dec(argv[2], a2i(argv[3]), a2i(argv[4]))
}
