// prelude: bits
// dispatcher.bp — T14 first rung: the .bt bridge artifact. A kernel's
// operand data lives as a rank-4 .bt word-tensor; execution = the event
// dispatcher scanning a dense activity word (SWAR popcnt + de Bruijn
// tzcnt, LSB-first, NO program counter, NO fetch-decode loop) and
// threshold-accumulating the active cells. The artifact round-trips
// (bt_pack -> bt_unpack == identical weights) and the dispatcher's
// accumulation over the active set equals the direct sum over that same
// set — execution is order-independent bit-exact (the set, not a stream,
// is what fires). This is the seed-runtime bridge: code lives only where
// a spike fires. Fold = sum*10^6 + rt*10^3 + n (python mirror at gate
// time; spike machinery embedded verbatim from spike.bp).

fn bt_offset(d: [i64], i: i64, j: i64, k: i64, l: i64) -> i64 {
  ((i * d[1] + j) * d[2] + k) * d[3] + l
}

fn bt_pack(d: [i64], data: [i64], out: [i64]) -> i64 {
  let _ = out[0] = 66;
  let _ = out[1] = 84;
  let _ = out[2] = 52;
  let _ = out[3] = 82;
  let _ = out[4] = 1;
  let _ = out[5] = 0;
  let _ = out[6] = 0;
  let _ = out[7] = 0;
  let _ = out[8] = 4;
  let _ = out[9] = 0;
  let _ = out[10] = 0;
  let _ = out[11] = 0;
  let q = 0;
  while q < 4 {
    let v = d[q];
    let _ = out[12 + q * 4] = v & 255;
    let _ = out[13 + q * 4] = (v >> 8) & 255;
    let _ = out[14 + q * 4] = (v >> 16) & 255;
    let _ = out[15 + q * 4] = (v >> 24) & 255;
    let q = q + 1;
    0
  };
  let count = (d[0] * d[1] * d[2]) * d[3];
  let o = 28;
  let k = 0;
  while k < count {
    let v = data[k];
    let b = 0;
    while b < 8 {
      let _ = out[o + k * 8 + b] = (v >> (b * 8)) & 255;
      let b = b + 1;
      0
    };
    let k = k + 1;
    0
  };
  28 + count * 8
}

fn bt_unpack(src: [i64], d: [i64], data: [i64]) -> i64 {
  let ok = (if src[0] == 66 then 1 else 0) + (if src[1] == 84 then 1 else 0)
         + (if src[2] == 52 then 1 else 0) + (if src[3] == 82 then 1 else 0);
  let ok = ok + (if src[4] == 1 then 1 else 0) + (if src[5] == 0 then 1 else 0)
         + (if src[6] == 0 then 1 else 0) + (if src[7] == 0 then 1 else 0);
  let ok = ok + (if src[8] == 4 then 1 else 0) + (if src[9] == 0 then 1 else 0)
         + (if src[10] == 0 then 1 else 0) + (if src[11] == 0 then 1 else 0);
  let q = 0;
  while q < 4 {
    let _ = d[q] = src[12 + q * 4] + (src[13 + q * 4] << 8) + (src[14 + q * 4] << 16) + (src[15 + q * 4] << 24);
    let q = q + 1;
    0
  };
  let count = (d[0] * d[1] * d[2]) * d[3];
  let k = 0;
  while k < count {
    let v = 0;
    let b = 7;
    while b >= 0 {
      let v = (v << 8) + (src[28 + k * 8 + b] & 255);
      let b = b - 1;
      0
    };
    let _ = data[k] = v;
    let k = k + 1;
    0
  };
  let res = if ok == 12 then 0 else 0 - 1;
  res
}

fn main() -> i64 {
  let d = zeros(4);
  let _ = d[0] = 1;
  let _ = d[1] = 1;
  let _ = d[2] = 8;
  let _ = d[3] = 1;
  let w8 = zeros(8);
  let i = 0;
  while i < 8 {
    let _ = w8[i] = i * i + 3;
    let i = i + 1;
    0
  };
  let buf = zeros(256);
  let by = bt_pack(d, w8, buf);
  let d2 = zeros(4);
  let w2 = zeros(8);
  let up = bt_unpack(buf, d2, w2);
  let rt = if up == 0 then 1 else 0;
  let same = [1];
  let k = 0;
  while k < 8 {
    let _ = same[0] = same[0] * (if w2[k] == w8[k] then 1 else 0);
    let k = k + 1;
    0
  };
  let rt = rt * same[0] * (if by == 92 then 1 else 0);
  let act = 94;
  let cnt = popc(act);
  let w = act;
  let acc = 0;
  let n = 0;
  while w != 0 {
    let lb = w & (0 - w);
    let idx = tzidx(lb);
    let _ = acc = acc + w8[idx];
    let n = n + 1;
    let w = w - lb;
    0
  };
  let nok = if n == cnt then 1 else 0;
  acc * 1000000 + rt * 1000 * nok + n
}
