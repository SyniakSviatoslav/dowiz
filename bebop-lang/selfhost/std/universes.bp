// universes.bp — Universe hierarchy and cumulativity for QTT.
// Implements universe polymorphism, cumulativity, and level constraints.

module core { }

// ============================================================
// Universe levels
// ============================================================

// Level expressions: constants, variables, max, suc
// Encoded as: 0 = zero, 1 = var 0, 2 = var 1, ... 
//             negative = operations: -1 = suc, -2 = max, -3 = imax

fn lvl_zero() -> i64 { 0 }
fn lvl_var(v: i64) -> i64 { v + 1 }  // 1 = var 0, 2 = var 1, ...
fn lvl_suc(l: i64) -> i64 { -1 }  // suc(l)
fn lvl_max(l1: i64, l2: i64) -> i64 { -2 }  // max(l1, l2)
fn lvl_imax(l1: i64, l2: i64) -> i64 { -3 }  // imax(l1, l2)

// ============================================================
// Universe constraints and solving
// ============================================================

// Constraint: l1 <= l2
