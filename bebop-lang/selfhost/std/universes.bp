}

// Constraint set: list of (l1, l2) pairs meaning l1 <= l2
fn cs_empty() -> [i64] { zeros(1) }
fn cs_add(cs: [i64], l1: i64, l2: i64) -> [i64] {
  let len = cs[0];
  let new = zeros(len + 3);
  let _ = new[0] = len + 2;
  let _ = new[1] = l1;
  let _ = new[2] = l2;
  let i = 1;
  while i <= len {
    let _ = new[i + 2] = cs[i];
    let i = i + 1;
    0
  };
  new
}

// Solve constraints: assign concrete levels to variables
