// qtt_kernel.bp — Core QTT type-checking kernel with output-buffer passing.
// All functions that produce terms take an output buffer as first argument.
// Return 1 on success, 0 on failure.

module core { }

// ============================================================
// Term representation
// ============================================================
// Term codes:
//  0 = Var (index)
//  1 = App (fn, arg)
//  2 = Lam (dom, body)
//  3 = Pi (dom, cod)
//  4 = Let (ty, val, body)
//  5 = Const (name_hash, universe)
//  6 = Type (universe)
//  7 = Sort (universe)

// Term is a tagged array: [code, field1, field2, ...]
// Var: [0, idx]
// App: [1, fn_term, arg_term]
// Lam: [2, dom_term, body_term]
// Pi:  [3, dom_term, cod_term]
// Let: [4, ty_term, val_term, body_term]
// Const: [5, name_hash, universe]
// Type: [6, universe]

// ============================================================
// Term constructors (output-buffer passing)
// ============================================================

// mk_var(out, idx)
fn mk_var(out: [i64], idx: i64) -> i64 {
  out[0] = 0;
  out[1] = idx;
  1
}

// mk_app(out, fn_term, arg_term)
fn mk_app(out: [i64], fn_term: [i64], arg_term: [i64]) -> i64 {
  out[0] = 1;
  out[1] = fn_term;
  out[2] = arg_term;
  1
}

// mk_lam(out, dom_term, body_term)
fn mk_lam(out: [i64], dom_term: [i64], body_term: [i64]) -> i64 {
  out[0] = 2;
  out[1] = dom_term;
  out[2] = body_term;
  1
}

// mk_pi(out, dom_term, cod_term)
fn mk_pi(out: [i64], dom_term: [i64], cod_term: [i64]) -> i64 {
  out[0] = 3;
  out[1] = dom_term;
  out[2] = cod_term;
  1
}

// mk_let(out, ty_term, val_term, body_term)
fn mk_let(out: [i64], ty_term: [i64], val_term: [i64], body_term: [i64]) -> i64 {
  out[0] = 4;
  out[1] = ty_term;
  out[2] = val_term;
  out[3] = body_term;
  1
}

// mk_const(out, name_hash, universe)
fn mk_const(out: [i64], name_hash: i64, universe: i64) -> i64 {
  out[0] = 5;
  out[1] = name_hash;
  out[2] = universe;
  1
}

// mk_type(out, universe)
fn mk_type(out: [i64], universe: i64) -> i64 {
  out[0] = 6;
  out[1] = universe;
  1
}

// ============================================================
// Term accessors
// ============================================================

fn tm_code(t: [i64]) -> i64 { t[0] }
fn tm_fst(t: [i64]) -> i64 { t[1] }
fn tm_snd(t: [i64]) -> i64 { t[2] }
fn tm_thd(t: [i64]) -> i64 { t[3] }

// ============================================================
// Context: list of (name_hash, type)
// ============================================================

// Context: [len, name1, type1, name2, type2, ...]
fn ctx_empty(out: [i64]) -> i64 {
  out[0] = 0;
  1
}

fn ctx_extend(out: [i64], ctx: [i64], name: i64, ty: [i64]) -> i64 {
  let len = ctx[0];
  out[0] = len + 2;
  out[1] = name;
  out[2] = ty;
  let i = 1;
  while i <= len {
    out[i * 2 + 1] = ctx[i * 2 - 1];
    out[i * 2 + 2] = ctx[i * 2];
    i = i + 1;
    0
  };
  1
}

fn ctx_lookup(out: [i64], ctx: [i64], name: i64) -> i64 {
  let len = ctx[0];
  let i = 1;
  while i <= len {
    if ctx[i * 2 - 1] == name {
      out[0] = ctx[i * 2];
      1
    } else { 0 };
    i = i + 1;
    0
  };
  out[0] = 0; // not found
  0
}

// ============================================================
// β-reduction (weak head normal form)
// ============================================================

// whnf(out, term, ctx)
fn whnf(out: [i64], term: [i64], ctx: [i64]) -> i64 {
  let code = tm_code(term);
  if code == 1 then { // App
    let fn = zeros(4);
    let _ = whnf(fn, tm_fst(term), ctx);
    let arg = tm_snd(term);
    let fn_code = tm_code(fn);
    if fn_code == 2 then { // Lam
      subst(out, tm_thd(fn), 0, tm_snd(term), zeros(1))
    } else {
      mk_app(out, fn, arg)
    }
  } else if code == 4 then { // Let
    subst(out, tm_thd(term), 0, tm_snd(term), zeros(1))
  } else {
    // Copy term to out
    let c = tm_code(term);
    out[0] = c;
    if c == 0 then out[1] = tm_fst(term)
    else if c == 5 then { out[1] = tm_fst(term); out[2] = tm_snd(term) }
    else if c == 6 then out[1] = tm_fst(term)
    else if c == 1 then { out[1] = tm_fst(term); out[2] = tm_snd(term) }
    else if c == 2 then { out[1] = tm_fst(term); out[2] = tm_snd(term) }
    else if c == 3 then { out[1] = tm_fst(term); out[2] = tm_snd(term) }
    else if c == 4 then { out[1] = tm_fst(term); out[2] = tm_snd(term); out[3] = tm_thd(term) }
    else { 0 };
    1
  }
}

// Substitute variable at depth d with value v
// subst(out, term, d, value, ctx)
fn subst(out: [i64], term: [i64], d: i64, value: [i64], ctx: [i64]) -> i64 {
  let code = tm_code(term);
  if code == 0 then { // Var
    if tm_fst(term) == d then {
      // Copy value to out
      let c = tm_code(value);
      out[0] = c;
      if c == 0 then out[1] = tm_fst(value)
      else if c == 5 then { out[1] = tm_fst(value); out[2] = tm_snd(value) }
      else if c == 6 then out[1] = tm_fst(value)
      else if c == 1 then { out[1] = tm_fst(value); out[2] = tm_snd(value) }
      else if c == 2 then { out[1] = tm_fst(value); out[2] = tm_snd(value) }
      else if c == 3 then { out[1] = tm_fst(value); out[2] = tm_snd(value) }
      else if c == 4 then { out[1] = tm_fst(value); out[2] = tm_snd(value); out[3] = tm_thd(value) }
      else { 0 };
      1
    } else {
      // Copy term to out
      let c = tm_code(term);
      out[0] = c;
      if c == 0 then out[1] = tm_fst(term)
      else if c == 5 then { out[1] = tm_fst(term); out[2] = tm_snd(term) }
      else if c == 6 then out[1] = tm_fst(term)
      else if c == 1 then { out[1] = tm_fst(term); out[2] = tm_snd(term) }
      else if c == 2 then { out[1] = tm_fst(term); out[2] = tm_snd(term) }
      else if c == 3 then { out[1] = tm_fst(term); out[2] = tm_snd(term) }
      else if c == 4 then { out[1] = tm_fst(term); out[2] = tm_snd(term); out[3] = tm_thd(term) }
      else { 0 };
      1
    }
  } else if code == 1 then { // App
    let fn = zeros(4);
    let _ = subst(fn, tm_fst(term), d, value, zeros(1));
    let arg = zeros(4);
    let _ = subst(arg, tm_snd(term), d, value, zeros(1));
    mk_app(out, fn, arg)
  } else if code == 2 then { // Lam
    let dom = zeros(4);
    let _ = subst(dom, tm_fst(term), d + 1, value, zeros(1));
    let body = zeros(4);
    let _ = subst(body, tm_snd(term), d + 1, value, zeros(1));
    mk_lam(out, dom, body)
  } else if code == 3 then { // Pi
    let dom = zeros(4);
    let _ = subst(dom, tm_fst(term), d, value, zeros(1));
    let cod = zeros(4);
    let _ = subst(cod, tm_snd(term), d + 1, value, zeros(1));
    mk_pi(out, dom, cod)
  } else if code == 4 then { // Let
    let ty = zeros(4);
    let _ = subst(ty, tm_fst(term), d, value, zeros(1));
    let val = zeros(4);
    let _ = subst(val, tm_snd(term), d, value, zeros(1));
    let body = zeros(4);
    let _ = subst(body, tm_thd(term), d + 1, value, zeros(1));
    mk_let(out, tm_fst(term), tm_snd(term), tm_thd(term)) // Note: this is simplified
  } else if code == 5 then { // Const
    out[0] = 5; out[1] = tm_fst(term); out[2] = tm_snd(term); 1
  } else {
    // Copy term
    let c = tm_code(term);
    out[0] = c;
    if c == 0 then out[1] = tm_fst(term)
    else if c == 5 then { out[1] = tm_fst(term); out[2] = tm_snd(term) }
    else if c == 6 then out[1] = tm_fst(term)
    else if c == 1 then { out[1] = tm_fst(term); out[2] = tm_snd(term) }
    else if c == 2 then { out[1] = tm_fst(term); out[2] = tm_snd(term) }
    else if c == 3 then { out[1] = tm_fst(term); out[2] = tm_snd(term) }
    else if c == 4 then { out[1] = tm_fst(term); out[2] = tm_snd(term); out[3] = tm_thd(term) }
    else { 0 };
    1
  }
}

// ============================================================
// Full normalization (β+δ)
// ============================================================

// normalize(out, term, ctx)
fn normalize(out: [i64], term: [i64], ctx: [i64]) -> i64 {
  let nf = zeros(4);
  let _ = whnf(nf, term, zeros(1));
  let code = tm_code(nf);
  if code == 1 then { // App
    let fn_n = zeros(4);
    let _ = normalize(fn, tm_fst(nf), zeros(1));
    let arg_n = zeros(4);
    let _ = normalize(arg_n, tm_snd(nf), zeros(1));
    mk_app(out, fn_n, arg_n)
  } else if code == 2 then { // Lam
    let dom_n = zeros(4);
    let _ = normalize(dom_n, tm_fst(nf), zeros(1));
    let body_n = zeros(4);
    let _ = normalize(body_n, tm_snd(nf), zeros(1));
    mk_lam(out, dom_n, body_n)
  } else if code == 3 then { // Pi
    let dom_n = zeros(4);
    let _ = normalize(dom_n, tm_fst(nf), zeros(1));
    let cod_n = zeros(4);
    let _ = normalize(cod_n, tm_snd(nf), zeros(1));
    mk_pi(out, dom_n, cod_n)
  } else if code == 4 then { // Let
    let ty_n = zeros(4);
    let _ = normalize(ty_n, tm_fst(nf), zeros(1));
    let val_n = zeros(4);
    let _ = normalize(val_n, tm_snd(nf), zeros(1));
    let body_n = zeros(4);
    let _ = normalize(body_n, tm_thd(nf), zeros(1));
    mk_let(out, tm_fst(nf), tm_snd(nf), tm_thd(nf))
  } else {
    // Copy nf to out
    let c = tm_code(nf);
    out[0] = c;
    if c == 0 then out[1] = tm_fst(nf)
    else if c == 5 then { out[1] = tm_fst(nf); out[2] = tm_snd(nf) }
    else if c == 6 then out[1] = tm_fst(nf)
    else if c == 1 then { out[1] = tm_fst(nf); out[2] = tm_snd(nf) }
    else if c == 2 then { out[1] = tm_fst(nf); out[2] = tm_snd(nf) }
    else if c == 3 then { out[1] = tm_fst(nf); out[2] = tm_snd(nf) }
    else if c == 4 then { out[1] = tm_fst(nf); out[2] = tm_snd(nf); out[3] = tm_thd(nf) }
    else { 0 };
    1
  }
}

// ============================================================
// Conversion (β+δ equality)
// ============================================================

// convert(t1, t2, ctx) -> i64 (1 if equal, 0 if not)
fn convert(t1: [i64], t2: [i64], ctx: [i64]) -> i64 {
  let n1 = zeros(4);
  let _ = normalize(n1, t1, zeros(1));
  let n2 = zeros(4);
  let _ = normalize(n2, t2, zeros(1));
  eq_term(n1, n2)
}

// eq_term(t1, t2) -> i64 (1 if equal, 0 if not)
fn eq_term(t1: [i64], t2: [i64]) -> i64 {
  let c1 = tm_code(t1);
  let c2 = tm_code(t2);
  if c1 != c2 then 0 else {
    let code = c1;
    if code == 0 then { // Var
      if tm_fst(t1) == tm_fst(t2) then 1 else 0
    } else if code == 1 then { // App
      eq_term(tm_fst(t1), tm_fst(t2)) * eq_term(tm_snd(t1), tm_snd(t2))
    } else if code == 2 then { // Lam
      eq_term(tm_fst(t1), tm_fst(t2)) * eq_term(tm_snd(t1), tm_snd(t2))
    } else if code == 3 then { // Pi
      eq_term(tm_fst(t1), tm_fst(t2)) * eq_term(tm_snd(t1), tm_snd(t2))
    } else if code == 4 then { // Let
      eq_term(tm_fst(t1), tm_fst(t2)) * eq_term(tm_snd(t1), tm_snd(t2)) * eq_term(tm_thd(t1), tm_thd(t2))
    } else if code == 5 then { // Const
      (tm_fst(t1) == tm_fst(t2)) * (tm_snd(t1) == tm_snd(t2))
    } else if code == 6 then { // Type
      if tm_fst(t1) == tm_fst(t2) then 1 else 0
    } else { 0 }
  }
}

// ============================================================
// Context operations
// ============================================================

fn tm_code(t: [i64]) -> i64 { t[0] }
fn tm_fst(t: [i64]) -> i64 { t[1] }
fn tm_snd(t: [i64]) -> i64 { t[2] }
fn tm_thd(t: [i64]) -> i64 { t[3] }

fn ctx_empty(out: [i64]) -> i64 { out[0] = 0; 1 }

fn ctx_extend(out: [i64], ctx: [i64], name: i64, ty: [i64]) -> i64 {
  let len = ctx[0];
  out[0] = len + 2;
  out[1] = name;
  out[2] = ty;
  let i = 1;
  while i <= ctx[0] {
    out[i * 2 + 1] = ctx[i * 2 - 1];
    out[i * 2 + 2] = ctx[i * 2];
    i = i + 1;
    0
  };
  1
}

fn ctx_lookup(out: [i64], ctx: [i64], name: i64) -> i64 {
  let len = ctx[0];
  let i = 1;
  while i <= ctx[0] {
    if ctx[i * 2 - 1] == name {
      out[0] = ctx[i * 2];
      1
    } else { 0 };
    i = i + 1;
    0
  };
  out[0] = 0;
  0
}

// ============================================================
// Conversion check
// ============================================================

fn check_refl(t1: [i64], t2: [i64]) -> i64 {
  convert(t1, t2, zeros(1))
}

// convert(t1, t2, ctx) -> i64 (1 if equal, 0 if not)
fn convert(t1: [i64], t2: [i64], ctx: [i64]) -> i64 {
  let n1 = zeros(4);
  let _ = normalize(n1, t1, zeros(1));
  let n2 = zeros(4);
  let _ = normalize(n2, t2, zeros(1));
  eq_term(n1, n2)
}

// eq_term(t1, t2) -> i64
fn eq_term(t1: [i64], t2: [i64]) -> i64 {
  let c1 = tm_code(t1);
  let c2 = tm_code(t2);
  if c1 != c2 then 0 else {
    let code = c1;
    if code == 0 then { if tm_fst(t1) == tm_fst(t2) then 1 else 0 }
    else if code == 1 then { eq_term(tm_fst(t1), tm_fst(t2)) * eq_term(tm_snd(t1), tm_snd(t2)) }
    else if code == 2 then { eq_term(tm_fst(t1), tm_fst(t2)) * eq_term(tm_snd(t1), tm_snd(t2)) }
    else if code == 3 then { eq_term(tm_fst(t1), tm_fst(t2)) * eq_term(tm_snd(t1), tm_snd(t2)) }
    else if code == 4 then { eq_term(tm_fst(t1), tm_fst(t2)) * eq_term(tm_snd(t1), tm_snd(t2)) * eq_term(tm_thd(t1), tm_thd(t2)) }
    else if code == 5 then { (tm_fst(t1) == tm_fst(t2)) * (tm_snd(t1) == tm_snd(t2)) }
    else if code == 6 then { if tm_fst(t1) == tm_fst(t2) then 1 else 0 }
    else { 0 }
  }
}

fn tm_code(t: [i64]) -> i64 { t[0] }
fn tm_fst(t: [i64]) -> i64 { t[1] }
fn tm_snd(t: [i64]) -> i64 { t[2] }
fn tm_thd(t: [i64]) -> i64 { t[3] }