// calcbound.bp — SS-5: calculus bounding (mean-value theorem + slope bounds
// -> automatic bounding boxes for mutations). f(x) = x^2 - x in fp 2^32;
// base x0 = 1.0; five golden mutations d in {-1/8, -1/16, 0, +1/16, +1/8}.
// Slope f' = 2x-1 on the mutated window lies in [0.75, 1.25]; mean-value box
// for each d: df = f(x0+d) - f(x0) in [min(fmin*d, fmax*d) - eps,
// max(fmin*d, fmax*d) + eps], eps = 0.01 slack (covers fp truncation).
// Done-check: the bounding box CONTAINS the actual result for every golden
// mutation. Branch-free min/max (even-difference division, no shift-origin
// trap); contained = product of per-mutation ok bits. Fold = contained*10^9
// + sum(fi>>16)*10^3 + (f0>>20). Machine: fp_mul verbatim (sha c184416666fe).

fn fp_mul(a: i64, b: i64) -> i64 {
  let na = if a < 0 then 1 else 0;
  let aa = if na == 1 then 0 - a else a;
  let nb = if b < 0 then 1 else 0;
  let ab = if nb == 1 then 0 - b else b;
  let a1 = aa >> 32;
  let a0 = aa - (a1 << 32);
  let b1 = ab >> 32;
  let b0 = ab - (b1 << 32);
  let hi = a1 * b1;
  let mid = a1 * b0 + a0 * b1;
  let ah = a0 >> 16;
  let al = a0 - (ah << 16);
  let bh = b0 >> 16;
  let bl = b0 - (bh << 16);
  let ll_h = ah * bh;
  let ll_m = ah * bl + al * bh;
  let ll_l = al * bl;
  let low = ll_h + ((ll_m + (ll_l >> 16)) >> 16);
  let p = (hi << 32) + mid + low;
  let flip = na + nb;
  let flip = flip - (flip / 2) * 2;
  let p = if flip == 1 then 0 - p else p;
  p
}

fn main() -> i64 {
  let one = 4294967296;
  let fmin = 3 * one / 4;
  let fmax = 5 * one / 4;
  let eps = one / 100;
  let x0 = one;
  let f0 = fp_mul(x0, x0) - x0;
  let contained = 1;
  let sq = 0;
  let m = 0;
  while m < 5 {
    let d = m * (one / 16) - (one / 8);
    let xi = x0 + d;
    let fi = fp_mul(xi, xi) - xi;
    let df = fi - f0;
    let d1 = fp_mul(fmin, d);
    let d2 = fp_mul(fmax, d);
    let s12 = d1 + d2;
    let a12 = d1 - d2;
    let a12 = if a12 < 0 then 0 - a12 else a12;
    let dmn = (s12 - a12) / 2;
    let dmx = (s12 + a12) / 2;
    let lo = dmn - eps;
    let hi = dmx + eps;
    let ok = (1 - (if df < lo then 1 else 0)) * (1 - (if df > hi then 1 else 0));
    let contained = contained * ok;
    let af = if fi < 0 then 0 - fi else fi;
    let sq = sq + (af >> 16);
    let m = m + 1;
    0
  };
  contained * 1000000000 + sq * 1000 + (f0 >> 20)
}
