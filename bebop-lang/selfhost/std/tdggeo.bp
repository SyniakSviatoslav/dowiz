use "selfhost/prelude/fp.bp"
// (T47c 2026-09-05: was `// prelude: fp`; the expansion used to be textual via tools/gen_selfsrc.sh)
// tdggeo.bp — T17: Christoffel symbols + covariant derivative (i64 fp 2^32).
// 2-D metric g(p) at p = (x, y): polar-style g = diag(1, x^2) (curved) or
// diag(1, 1) (flat, flag). Partials dg[k][i][j] = d_k g_ij by central
// difference with h = 0.25 (exact for the quadratic metric in fp:
// ((x+h)^2 - (x-h)^2) / 2h = 2x). First kind G_kij = (d_i g_jk + d_j g_ik
// - d_k g_ij) / 2, second kind G^k_ij = g^kl G_lij with g^kl = adj/det.
// Vector field V^j(p) = a_j + b_j x + c_j y; d_i V^j by central difference
// (exact, linear). Covariant nabla_i V^j = d_i V^j + G^j_ik V^k.
// Falsifiable checks: curved G^0_11 == -x (-1.5) within 8 ulps, flat metric =>
// nabla == partial for all 4 entries with nonzero partials (deg = 1).
// Fold = mask56 chain hash (h = (h*31 & (2^56-1)) + |v|*2 + neg) of the 8
// curved G^k_ij, 4 curved nabla, 4 flat nabla, times 4 + chk*2 + deg.
// Note: dowiz-core academia_p2p.rs christoffel() is a zero stub; this is
// the real formula, mirrored by bench/oracles/tdggeo.py.

// fp_div(a, b) = floor(a * 2^32 / b), a >= 0, b > 0.
fn fp_div(a: i64, b: i64) -> i64 {
  let q0 = a / b;
  let r = a - q0 * b;
  let q = 0;
  let i = 0;
  while i < 32 {
    let r = r * 2;
    let bit = if r >= b then 1 else 0;
    let q = q * 2 + bit;
    let r = r - bit * b;
    let i = i + 1;
    0
  };
  (q0 << 32) + q
}

// metric_at(g, x, y, flat): g = diag(1, x^2) or diag(1, 1) when flat.
fn metric_at(g: [i64], x: i64, y: i64, flat: i64) -> i64 {
  let one = 4294967296;
  let _ = g[0] = one;
  let _ = g[1] = 0;
  let _ = g[2] = 0;
  let _ = g[3] = if flat == 1 then one else fp_mul(x, x);
  0
}

// field_at(v, x, y): V^j = a_j + b_j x + c_j y, a=(1,-0.5) b=(0.5,1) c=(0.25,-1).
fn field_at(v: [i64], x: i64, y: i64) -> i64 {
  let one = 4294967296;
  let half = 2147483648;
  let _ = v[0] = one + fp_mul(half, x) + fp_mul(half / 2, y);
  let _ = v[1] = (0 - half) + fp_mul(one, x) - fp_mul(one, y);
  0
}

// dmetric(dg, gp, gm, x, y, flat): dg[k*4 + i*2 + j] = d_k g_ij, h = 0.25.
fn dmetric(dg: [i64], gp: [i64], gm: [i64], x: i64, y: i64, flat: i64) -> i64 {
  let h = 1073741824;
  let k = 0;
  while k < 2 {
    let dx = h * (1 - k);
    let dy = h * k;
    let _ = metric_at(gp, x + dx, y + dy, flat);
    let _ = metric_at(gm, x - dx, y - dy, flat);
    let m = 0;
    while m < 4 {
      let _ = dg[k * 4 + m] = (gp[m] - gm[m]) * 2;
      let m = m + 1;
      0
    };
    let k = k + 1;
    0
  };
  0
}

// dfield(dv, vp, vm, x, y): dv[i*2 + j] = d_i V^j, h = 0.25.
fn dfield(dv: [i64], vp: [i64], vm: [i64], x: i64, y: i64) -> i64 {
  let h = 1073741824;
  let i = 0;
  while i < 2 {
    let dx = h * (1 - i);
    let dy = h * i;
    let _ = field_at(vp, x + dx, y + dy);
    let _ = field_at(vm, x - dx, y - dy);
    let _ = dv[i * 2] = (vp[0] - vm[0]) * 2;
    let _ = dv[i * 2 + 1] = (vp[1] - vm[1]) * 2;
    let i = i + 1;
    0
  };
  0
}

// christoffel(g, dg, gi, g1, g2): g1[k*4+i*2+j] = G_kij (first kind),
// g2[k*4+i*2+j] = G^k_ij = g^kl G_lij (second kind). gi <- inverse metric.
fn christoffel(g: [i64], dg: [i64], gi: [i64], g1: [i64], g2: [i64]) -> i64 {
  let det = fp_mul(g[0], g[3]) - fp_mul(g[1], g[2]);
  let id = fp_div(4294967296, det);
  let _ = gi[0] = fp_mul(g[3], id);
  let _ = gi[1] = fp_mul(0 - g[1], id);
  let _ = gi[2] = fp_mul(0 - g[2], id);
  let _ = gi[3] = fp_mul(g[0], id);
  let n = 0;
  while n < 8 {
    let k = n / 4;
    let i = (n / 2) - k * 2;
    let j = n - (n / 2) * 2;
    let _ = g1[n] = (dg[i * 4 + j * 2 + k] + dg[j * 4 + i * 2 + k] - dg[k * 4 + i * 2 + j]) / 2;
    let n = n + 1;
    0
  };
  let n = 0;
  while n < 8 {
    let k = n / 4;
    let ij = n - k * 4;
    let _ = g2[n] = fp_mul(gi[k * 2], g1[ij]) + fp_mul(gi[k * 2 + 1], g1[4 + ij]);
    let n = n + 1;
    0
  };
  det
}

// covariant(dv, g2, v, out): out[i*2+j] = d_i V^j + G^j_ik V^k.
fn covariant(dv: [i64], g2: [i64], v: [i64], out: [i64]) -> i64 {
  let n = 0;
  while n < 4 {
    let i = n / 2;
    let j = n - i * 2;
    let _ = out[n] = dv[n] + fp_mul(g2[j * 4 + i * 2], v[0]) + fp_mul(g2[j * 4 + i * 2 + 1], v[1]);
    let n = n + 1;
    0
  };
  0
}

fn hmix(h: i64, v: i64) -> i64 {
  let neg = if v < 0 then 1 else 0;
  let av = if neg == 1 then 0 - v else v;
  ((h * 31) & 72057594037927935) + av * 2 + neg
}

// run(flat, x, y, g2, out): fill G^k_ij and nabla_i V^j at (x, y).
fn run(flat: i64, x: i64, y: i64, g2: [i64], out: [i64]) -> i64 {
  let g = zeros(4);
  let gp = zeros(4);
  let gm = zeros(4);
  let dg = zeros(8);
  let gi = zeros(4);
  let g1 = zeros(8);
  let _ = metric_at(g, x, y, flat);
  let _ = dmetric(dg, gp, gm, x, y, flat);
  let _ = christoffel(g, dg, gi, g1, g2);
  let v = zeros(2);
  let dv = zeros(4);
  let _ = field_at(v, x, y);
  let _ = dfield(dv, gp, gm, x, y);
  let _ = covariant(dv, g2, v, out);
  // |nabla - partial| summed (0 iff covariant == partial)
  let d = 0;
  let n = 0;
  while n < 4 {
    let e = out[n] - dv[n];
    let e = if e < 0 then 0 - e else e;
    let d = d + e;
    let n = n + 1;
    0
  };
  d
}

fn main() -> i64 {
  let one = 4294967296;
  let half = 2147483648;
  let x = one + half;            // 1.5
  let y = half;                  // 0.5
  let g2 = zeros(8);
  let nab = zeros(4);
  let dcur = run(0, x, y, g2, nab);
  let h = 0;
  let n = 0;
  while n < 8 {
    let h = hmix(h, g2[n]);
    let n = n + 1;
    0
  };
  let n = 0;
  while n < 4 {
    let h = hmix(h, nab[n]);
    let n = n + 1;
    0
  };
  // curved: G^0_11 == -x within 8 ulps (g^00 = 2.25/2.25 rounds), nabla != partial
  let e = g2[3] + x;
  let e = if e < 0 then 0 - e else e;
  let chk = if e < 8 then (if dcur > 0 then 1 else 0) else 0;
  let dflat = run(1, x, y, g2, nab);
  let n = 0;
  while n < 4 {
    let h = hmix(h, nab[n]);
    let n = n + 1;
    0
  };
  let deg = if dflat == 0 then 1 else 0;
  h * 4 + chk * 2 + deg
}
