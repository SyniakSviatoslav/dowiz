// nat_peano.bp — Peano arithmetic for QTT proofs.
// Natural numbers as inductive type with succ/pred/recursor.

module core { }

// ============================================================
// Natural number type (encoded as i64 for now)
// ============================================================

// Nat : Type 0
fn Nat() -> [i64] { tm_type(0) }

// Zero : Nat
fn zero() -> [i64] { tm_const(1, 0) }  // name hash for "zero"

// Succ : Nat -> Nat
fn succ(n: [i64]) -> [i64] { tm_app(tm_const(2, 0), n) }

// Pred : Nat -> Nat
fn pred(n: [i64]) -> [i64] { tm_app(tm_const(3, 0), n) }

// IsZero : Nat -> Bool
fn is_zero(n: [i64]) -> [i64] { tm_app(tm_const(4, 0), n) }

// ============================================================
// Recursor for Nat
// ============================================================

// rec : (P : Nat -> Type) -> P zero -> (n : Nat) -> P n -> P (succ n) -> (n : Nat) -> P n
fn Nat_rec(P: [i64], pz: [i64], ps: [i64], n: [i64]) -> [i64] {
  // In a real implementation, this would be the eliminator
  // For now, placeholder
  tm_const(5, 0)
}

// ============================================================
// Arithmetic (for computation in proofs)
// ============================================================

fn add(a: [i64], b: [i64]) -> [i64] {
  tm_app(tm_app(tm_const(5, 0), a), b)
}

fn mul(a: [i64], b: [i64]) -> [i64] {
  tm_app(tm_app(tm_const(6, 0), a), b)
}

// ============================================================
// Equality (definitional)
// ============================================================

fn eq_nat(a: [i64], b: [i64]) -> [i64] {
  tm_app(tm_app(tm_const(7, 0), a), b)
}

// ============================================================
// Induction principle
// ============================================================

fn Nat_ind(P: [i64], hz: [i64], hs: [i64]) -> [i64] {
  // Forall n, P n
  tm_const(8, 0)
}