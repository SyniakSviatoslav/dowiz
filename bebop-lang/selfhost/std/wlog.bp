use "selfhost/prelude/store.bp"
use "selfhost/prelude/sha256.bp"
use "selfhost/std/ordfsm.bp"
use "selfhost/std/money.bp"

// parse(s): decimal string -> i64. NOT a builtin -- every std program defines its own
// (selfhost/std/sgraph2.bp:1143, sgraph.bp:150). wlog.bp called it without defining it, so
// every invocation that passed argv[4] died with `trap 87: call to an unresolved function`;
// the `if argc >= 5` guard meant the call never executed until n/k were first passed.
fn parse(s: str) -> i64 {
  let n = str_len(s);
  let i = 0;
  let v = 0;
  while i < n {
    let v = v * 10 + (char(s, i) - 48);
    let i = i + 1;
    0
  };
  v
}

// CSR three-pass counting sort
fn csr_passes(src: [i64], dst: [i64], m: i64, n: i64, cur: [i64], prp: [i64], pci: [i64]) -> i64 {
  let z = 0;
  while z < n + 2 {
    let _ = prp[z] = 0;
    let z = z + 1;
    0
  };
  let _ = prp[0] = n + 1;
  let i = 0;
  while i < m {
    let a = src[i];
    let _ = prp[2 + a] = prp[2 + a] + 1;
    let i = i + 1;
    0
  };
  let v = 0;
  while v < n {
    let _ = prp[2 + v] = prp[2 + v] + prp[1 + v];
    let _ = cur[v] = prp[1 + v];
    let v = v + 1;
    0
  };
  let _ = pci[0] = m;
  let j = 0;
  while j < m {
    let a = src[j];
    let s = cur[a];
    let _ = pci[1 + s] = dst[j];
    let _ = cur[a] = s + 1;
    let j = j + 1;
    0
  };
  0
}

// pick_set(m, r): the index of the r-th SET bit of m (12-bit masks).
fn pick_set(m: i64, r: i64) -> i64 {
  let kk = zeros(1);
  let chosen = zeros(1);
  let j = 0;
  while j < 12 {
    let bit = (m >> j) & 1;
    let _ = if bit == 1 then (
      let _ = if kk[0] == r then (let _ = chosen[0] = j in 0) else 0 in
      let _ = kk[0] = kk[0] + 1 in
      0
    ) else 0;
    let j = j + 1;
    0
  };
  chosen[0]
}

// gen_events: WALK the FSM from state 0 per order, ~1% injected illegal steps.
// A legal step picks from adj[cur]'s set bits, so decide() returns 0.
// An illegal step picks from the FORBIDDEN pool = complement of adj[cur], minus the
// current state (decide would say 1 SameStatus) and minus state 8 (it would say 2
// ScaffoldDisabled) -- 3839 is exactly the non-scaffold 12-bit mask. So an injected
// step returns 3 IllegalTransition and nothing else does, which is what makes
// injected == found a real equality. An illegal step does NOT advance cur.
fn gen_events(order_id: [i64], from: [i64], to: [i64], t: [i64], amount: [i64],
              n: i64, k: i64, adj: [i64], illegal_count: [i64]) -> i64 {
  let ev = zeros(1);
  let oid = zeros(1);
  let cur = zeros(1);
  let lcg_st = zeros(1);
  let _ = lcg_st[0] = 1234;
  while oid[0] < n {
    let _ = cur[0] = 0;
    let ek = 0;
    while ek < k {
      let _ = if adj[cur[0]] == 0 then (let _ = cur[0] = 0 in 0) else 0;
      let mask = adj[cur[0]];
      let _ = lcg_st[0] = ((lcg_st[0] * 1103515245) + 12345) & 2147483647;
      let lv = lcg_st[0];
      let ill = if (lv % 100) == 0 then 1 else 0;
      let selfbit = 1 << cur[0];
      let forb = ((mask ^ 4095) & (selfbit ^ 4095)) & 3839;
      let pool = if ill == 1 then forb else mask;
      let np = pc12(pool);
      let r = if np == 0 then 0 else (lv / 100) % np;
      let nxt = pick_set(pool, r);
      let _ = order_id[ev[0]] = oid[0];
      let _ = from[ev[0]] = cur[0];
      let _ = to[ev[0]] = nxt;
      let _ = t[ev[0]] = (ek * 1000) + (lv % 1000);
      let _ = amount[ev[0]] = (lv % 100) + 1;
      let _ = if ill == 1 then (let _ = illegal_count[0] = illegal_count[0] + 1 in 0) else 0;
      let _ = if ill == 0 then (let _ = cur[0] = nxt in 0) else 0;
      let _ = ev[0] = ev[0] + 1;
      let ek = ek + 1;
      0
    };
    let _ = oid[0] = oid[0] + 1;
    0
  };
  ev[0]
}

// Phase q1: fold through events using CSR,  return sum of final states
fn phase_q1(base: [i64], tmp: [i64], n: i64, adj: [i64]) -> i64 {
  let g = st_root(base, tmp);
  let m = st_get(base, g, 0);
  let order_id = st_ref(base, g, 1);
  let from_st = st_ref(base, g, 2);
  let to_st = st_ref(base, g, 3);
  let rp = st_ref(base, g, 6);
  let ci = st_ref(base, g, 7);
  let state = zeros(n);
  let oid = 0;
  while oid < n {
    let lo = st_get(base, rp, 1 + oid);
    let hi = st_get(base, rp, 2 + oid);
    let ev_idx = lo;
    while ev_idx < hi {
      let ev = st_get(base, ci, 1 + ev_idx);
      let f = st_get(base, from_st, ev);
      let t = st_get(base, to_st, ev);
      let ok_code = decide(adj, f, t);
      let _ = if ok_code == 0 then state[oid] = t else 0;
      let ev_idx = ev_idx + 1;
      0
    };
    let oid = oid + 1;
    0
  };
  let fold_h = 0;
  let i = 0;
  while i < n {
    let fold_h = fold_h + state[i];
    let i = i + 1;
    0
  };
  fold_h
}

// Phase q3: count decide codes per argv[3]: '0'=ok, '1'=same, '2'=scaffold, '3'=illegal
fn phase_q3(base: [i64], tmp: [i64], adj: [i64], which: i64) -> i64 {
  let g = st_root(base, tmp);
  let m = st_get(base, g, 0);
  let from_st = st_ref(base, g, 2);
  let to_st = st_ref(base, g, 3);
  let c = zeros(4);
  let ev = 0;
  while ev < m {
    let f = st_get(base, from_st, ev);
    let t = st_get(base, to_st, ev);
    let code = decide(adj, f, t);
    let idx = if code == 0 then 0 else (if code == 1 then 1 else (if code == 2 then 2 else 3));
    let _ = c[idx] = c[idx] + 1;
    let ev = ev + 1;
    0
  };
  if which == 48 then c[0] else (if which == 49 then c[1] else (if which == 50 then c[2] else (if which == 51 then c[3] else 0)))
}

// Phase q2: orders in state s at time t (EvByT bucket + prefix fold)
// BUCKET width = 1000; t[i] / BUCKET gives bucket index
fn phase_q2(base: [i64], tmp: [i64], n: i64, adj: [i64], target_s: i64, target_t: i64) -> i64 {
  let g = st_root(base, tmp);
  let from_st = st_ref(base, g, 2);
  let to_st = st_ref(base, g, 3);
  let t_arr = st_ref(base, g, 4);
  let rp_o = st_ref(base, g, 6);
  let ci_o = st_ref(base, g, 7);
  let cnt = zeros(1);
  let state = zeros(1);
  let oid = 0;
  while oid < n {
    let lo = st_get(base, rp_o, 1 + oid);
    let hi = st_get(base, rp_o, 2 + oid);
    let _ = state[0] = 0;
    let ev_idx = lo;
    while ev_idx < hi {
      let ev = st_get(base, ci_o, 1 + ev_idx);
      let tv = st_get(base, t_arr, ev);
      let f = st_get(base, from_st, ev);
      let t = st_get(base, to_st, ev);
      let ok = decide(adj, f, t);
      let okz = if ok == 0 then 1 else 0;
      let inwin = if tv < target_t then 1 else 0;
      let _ = if okz * inwin == 1 then (let _ = state[0] = t in 0) else 0;
      let ev_idx = ev_idx + 1;
      0
    };
    let _ = if state[0] == target_s then (let _ = cnt[0] = cnt[0] + 1 in 0) else 0;
    let oid = oid + 1;
    0
  };
  cnt[0]
}

// Phase q4: revenue by state (money op_add over State-masked amounts)
fn phase_q4(base: [i64], tmp: [i64], n: i64, adj: [i64], target_s: i64, want_ref: i64) -> i64 {
  let g = st_root(base, tmp);
  let from_st = st_ref(base, g, 2);
  let to_st = st_ref(base, g, 3);
  let amt = st_ref(base, g, 5);
  let rp_o = st_ref(base, g, 6);
  let ci_o = st_ref(base, g, 7);
  let ms = zeros(5);
  let refusals = zeros(1);
  let total = zeros(1);
  let state = zeros(1);
  let sub = zeros(1);
  let oid = 0;
  while oid < n {
    let lo = st_get(base, rp_o, 1 + oid);
    let hi = st_get(base, rp_o, 2 + oid);
    let _ = state[0] = 0;
    let _ = sub[0] = 0;
    let ev_idx = lo;
    while ev_idx < hi {
      let ev = st_get(base, ci_o, 1 + ev_idx);
      let f = st_get(base, from_st, ev);
      let t = st_get(base, to_st, ev);
      let ok = decide(adj, f, t);
      let _ = if ok == 0 then (let _ = state[0] = t in 0) else 0;
      let av = st_get(base, amt, ev);
      let _ = op_add(ms, sub[0], 0, av, 0);
      let _ = if ms[3] == 0 then (let _ = refusals[0] = refusals[0] + 1 in 0) else 0;
      let _ = if ms[3] == 1 then (let _ = sub[0] = ms[4] in 0) else 0;
      let ev_idx = ev_idx + 1;
      0
    };
    let hit = if target_s < 0 then 1 else (if state[0] == target_s then 1 else 0);
    let _ = if hit == 1 then (
      let _ = op_add(ms, total[0], 0, sub[0], 0) in
      let _ = if ms[3] == 0 then (let _ = refusals[0] = refusals[0] + 1 in 0) else 0 in
      let _ = if ms[3] == 1 then (let _ = total[0] = ms[4] in 0) else 0 in
      0
    ) else 0;
    let oid = oid + 1;
    0
  };
  if want_ref == 1 then refusals[0] else total[0]
}

// Phase u: apply E new events. Reads each order's CURRENT state out of the committed log, walks
// the FSM forward from there, validates every appended event with decide() and counts any that is
// not code 0 as refused, then rebuilds BOTH indexes (EvByOrder and EvByT) and commits a new
// generation. EvByT must be rebuilt too: it is a root ref cell, and a root cell that is not
// re-linked is not copied by compaction.
// This is the EAGER form -- it rewrites the whole log rather than appending to a tail. The tiered
// append is what ROADMAP B4 exists to provide, and B5's partition-by-order-range half is out of
// scope here; both are named rather than silently skipped.
fn phase_u(base: [i64], tmp: [i64], d: [i64], n: i64, k: i64, adj: [i64], num_new: i64, want_ref: i64) -> i64 {
  let g = st_root(base, tmp);
  let m = st_get(base, g, 0);
  let o_oid = st_ref(base, g, 1);
  let o_from = st_ref(base, g, 2);
  let o_to = st_ref(base, g, 3);
  let o_t = st_ref(base, g, 4);
  let o_amt = st_ref(base, g, 5);
  let o_rp = st_ref(base, g, 6);
  let o_ci = st_ref(base, g, 7);

  // current state per order, from the committed log
  let cur = zeros(n + 1);
  let oid0 = 0;
  while oid0 < n {
    let lo = st_get(base, o_rp, 1 + oid0);
    let hi = st_get(base, o_rp, 2 + oid0);
    let st0 = zeros(1);
    let e0 = lo;
    while e0 < hi {
      let ev = st_get(base, o_ci, 1 + e0);
      let f = st_get(base, o_from, ev);
      let t = st_get(base, o_to, ev);
      let ok = decide(adj, f, t);
      let _ = if ok == 0 then (let _ = st0[0] = t in 0) else 0;
      let e0 = e0 + 1;
      0
    };
    let _ = cur[oid0] = st0[0];
    let oid0 = oid0 + 1;
    0
  };

  let m2 = m + num_new;
  let a_oid = zeros(m2 + 1);
  let a_from = zeros(m2 + 1);
  let a_to = zeros(m2 + 1);
  let a_t = zeros(m2 + 1);
  let a_amt = zeros(m2 + 1);
  let c = 0;
  while c < m {
    let _ = a_oid[c] = st_get(base, o_oid, c);
    let _ = a_from[c] = st_get(base, o_from, c);
    let _ = a_to[c] = st_get(base, o_to, c);
    let _ = a_t[c] = st_get(base, o_t, c);
    let _ = a_amt[c] = st_get(base, o_amt, c);
    let c = c + 1;
    0
  };

  let refused = zeros(1);
  let lcg_u = zeros(1);
  let _ = lcg_u[0] = 999331;
  let w = 0;
  while w < num_new {
    let oid = w % n;
    let _ = if adj[cur[oid]] == 0 then (let _ = cur[oid] = 0 in 0) else 0;
    let mask = adj[cur[oid]];
    let _ = lcg_u[0] = ((lcg_u[0] * 1103515245) + 12345) & 2147483647;
    let lv = lcg_u[0];
    let np = pc12(mask);
    let r = if np == 0 then 0 else (lv / 100) % np;
    let nxt = pick_set(mask, r);
    let f = cur[oid];
    let ok = decide(adj, f, nxt);
    let _ = if ok == 0 then (let _ = cur[oid] = nxt in 0) else (let _ = refused[0] = refused[0] + 1 in 0);
    let _ = a_oid[m + w] = oid;
    let _ = a_from[m + w] = f;
    let _ = a_to[m + w] = nxt;
    let _ = a_t[m + w] = k * 1000;
    let _ = a_amt[m + w] = (lv % 100) + 1;
    let w = w + 1;
    0
  };

  let prp = zeros(n + 2);
  let pci = zeros(m2 + 1);
  let cs = zeros(n + 1);
  // the CSR's VALUE array is the EVENT INDEX, not the `to` state -- q1 indexes from/to with it
  let a_idx = zeros(m2 + 1);
  let xi = 0;
  while xi < m2 { let _ = a_idx[xi] = xi; let xi = xi + 1; 0 };
  let _ = csr_passes(a_oid, a_idx, m2, n, cs, prp, pci);

  // EvByT must be rebuilt too: it is a ROOT ref cell, and a root cell that is not re-linked
  // is not copied by compaction. New events land in bucket k, which is < max_bucket = k + 1.
  let bucket_width = 1000;
  let max_bucket = (k * 1000) / bucket_width + 1;
  let b_src = zeros(m2 + 1);
  let b_idx = zeros(m2 + 1);
  let bi = 0;
  while bi < m2 {
    let _ = b_src[bi] = a_t[bi] / bucket_width;
    let _ = b_idx[bi] = bi;
    let bi = bi + 1;
    0
  };
  let cur_t = zeros(max_bucket + 1);
  let prp_t = zeros(max_bucket + 2);
  let pci_t = zeros(m2 + 1);
  let _ = csr_passes(b_src, b_idx, m2, max_bucket, cur_t, prp_t, pci_t);

  let tx = zeros(6);
  let _ = st_begin(base, tx, tmp);
  let n_oid = st_alloc(base, tx, m2 + 1, d[1]);
  let n_from = st_alloc(base, tx, m2 + 1, d[1]);
  let n_to = st_alloc(base, tx, m2 + 1, d[1]);
  let n_t = st_alloc(base, tx, m2 + 1, d[1]);
  let n_amt = st_alloc(base, tx, m2 + 1, d[1]);
  let n_rp = st_alloc(base, tx, n + 2, d[1]);
  let n_ci = st_alloc(base, tx, m2 + 1, d[1]);
  let n_rpt = st_alloc(base, tx, max_bucket + 2, d[1]);
  let n_cit = st_alloc(base, tx, m2 + 1, d[1]);
  let c2 = 0;
  while c2 < m2 {
    let _ = st_put(base, n_oid, c2, a_oid[c2]);
    let _ = st_put(base, n_from, c2, a_from[c2]);
    let _ = st_put(base, n_to, c2, a_to[c2]);
    let _ = st_put(base, n_t, c2, a_t[c2]);
    let _ = st_put(base, n_amt, c2, a_amt[c2]);
    let c2 = c2 + 1;
    0
  };
  let c3 = 0;
  while c3 < n + 2 { let _ = st_put(base, n_rp, c3, prp[c3]); let c3 = c3 + 1; 0 };
  let c4 = 0;
  while c4 < m2 + 1 { let _ = st_put(base, n_ci, c4, pci[c4]); let c4 = c4 + 1; 0 };
  let c5 = 0;
  while c5 < max_bucket + 2 { let _ = st_put(base, n_rpt, c5, prp_t[c5]); let c5 = c5 + 1; 0 };
  let c6 = 0;
  while c6 < m2 + 1 { let _ = st_put(base, n_cit, c6, pci_t[c6]); let c6 = c6 + 1; 0 };
  let _ = st_seal(base, n_oid, tmp);
  let _ = st_seal(base, n_from, tmp);
  let _ = st_seal(base, n_to, tmp);
  let _ = st_seal(base, n_t, tmp);
  let _ = st_seal(base, n_amt, tmp);
  let _ = st_seal(base, n_rp, tmp);
  let _ = st_seal(base, n_ci, tmp);
  let _ = st_seal(base, n_rpt, tmp);
  let _ = st_seal(base, n_cit, tmp);
  let root2 = st_alloc(base, tx, 10, d[0]);
  let _ = st_put(base, root2, 0, m2);
  let _ = st_link(base, root2, 1, n_oid);
  let _ = st_link(base, root2, 2, n_from);
  let _ = st_link(base, root2, 3, n_to);
  let _ = st_link(base, root2, 4, n_t);
  let _ = st_link(base, root2, 5, n_amt);
  let _ = st_link(base, root2, 6, n_rp);
  let _ = st_link(base, root2, 7, n_ci);
  let _ = st_link(base, root2, 8, n_rpt);
  let _ = st_link(base, root2, 9, n_cit);
  let _ = st_seal(base, root2, tmp);
  let _ = st_commit(base, tx, root2, tmp);
  if want_ref == 1 then refused[0] else m2
}

// ---- B6: q1 folded across P cores ----
// The shape is copied verbatim from bench/vs_rust/std_tests/b6core.bp, including the two rules
// that make sys_clone usable here: at most ~7 symbols may be KEPT across the spawn (a symbol
// spilled before it reads as 0 on the child's fresh frame, and the failure is SILENT), and the
// child's work therefore lives in its OWN function. Everything the child needs travels in one
// `env` array rather than as separate live names.
fn wl_stk(cur: i64, w: i64) -> i64 { cur + 16384 + w * 8192 }

fn wl_fold_range(env: [i64], lo: i64, hi: i64) -> i64 {
  let base = env[0];
  let rp = env[1];
  let ci = env[3];
  let fo = env[4];
  let to_o = env[5];
  let adj = env[6];
  let acc = 0;
  let state = zeros(1);
  let oid = lo;
  while oid < hi {
    let a0 = st_get(base, rp, 1 + oid);
    let b0 = st_get(base, rp, 2 + oid);
    let _ = state[0] = 0;
    let e = a0;
    while e < b0 {
      let ev = st_get(base, ci, 1 + e);
      let f = st_get(base, fo, ev);
      let t = st_get(base, to_o, ev);
      let ok = decide(adj, f, t);
      let _ = if ok == 0 then (let _ = state[0] = t in 0) else 0;
      let e = e + 1;
      0
    };
    let acc = acc + state[0];
    let oid = oid + 1;
    0
  };
  acc
}

fn wl_work(env: [i64], cells: [i64], w: i64, W: i64) -> i64 {
  let _ = sys_setaffinity(cells, 2 * W + 1 + w);
  let n = env[2];
  let lo = w * (n / W);
  let hi = if w == W - 1 then n else (w + 1) * (n / W);
  let part = wl_fold_range(env, lo, hi);
  let _ = sys_atomic_add(cells, w, part);
  part
}

fn wl_par(env: [i64], cells: [i64], W: i64) -> i64 {
  let cur = sys_arena_base();
  let w = 0;
  while w < W {
    let r = sys_clone(68864, wl_stk(cur, w));
    let is_child = if r == 0 then 1 else 0;
    let _ = if is_child == 1 then wl_work(env, cells, w, W) else 0;
    let _ = sys_atomic_add(cells, W + w, is_child);
    let _ = sys_futex_wake(cells, W + w, 64);
    let parked = if is_child == 0 then 1 else 0;
    while parked == 0 {
      let _ = sys_futex_wait_guard(if is_child == 0 then 1 else 0, cells, W + w, 0);
      let parked = if cells[W + w] == 1 then 1 else 0;
      0
    };
    let _ = sys_exit_thread_guard(is_child, 0);
    let w = w + 1;
    0
  };
  let w = 0;
  while w < W {
    let d = 0;
    while d == 0 {
      let _ = sys_futex_wait_guard(0, cells, W + w, 0);
      let d = if sys_atomic_add(cells, W + w, 0) == 1 then 1 else 0;
      0
    };
    let w = w + 1;
    0
  };
  0
}

// Phase p: the q1 fold over P cores. The fold MUST equal the sequential q1 -- a parallel
// answer that differs from the sequential one is not a speed-up, it is a wrong answer.
fn phase_par(base: [i64], tmp: [i64], n: i64, adj: [i64], W: i64) -> i64 {
  let g = st_root(base, tmp);
  let rp = st_ref(base, g, 6);
  let ci = st_ref(base, g, 7);
  let fo = st_ref(base, g, 2);
  let to_o = st_ref(base, g, 3);
  let env = [base, rp, n, ci, fo, to_o, adj, 0];
  let cells = zeros(6 * W + 8);
  let _ = cells[2 * W + 1] = 16;
  let _ = cells[2 * W + 2] = 32;
  let _ = cells[2 * W + 3] = 64;
  let _ = wl_par(env, cells, W);
  let acc = 0;
  let w = 0;
  while w < W {
    let acc = acc + cells[w];
    let w = w + 1;
    0
  };
  acc
}

// Phase c: the CRASH WRITER (B1 model, scrash.bp's shape). Repeatedly appends a batch and
// commits, so the harness can SIGKILL it at an arbitrary moment. Every append is deterministic,
// so generation g has ONE correct fold and a reader can check which generation survived.
// Commit is an append plus a superblock toggle -- nothing already committed is overwritten --
// so a kill must leave the store readable at generation k or k-1, never in between.
fn phase_crash(base: [i64], tmp: [i64], d: [i64], n: i64, k: i64, adj: [i64], rounds: i64, batch: i64) -> i64 {
  let r = 0;
  while r < rounds {
    let _ = phase_u(base, tmp, d, n, k, adj, batch, 0);
    let r = r + 1;
    0
  };
  rounds
}

// Phase r: reopen after a crash. argv[3] selects: 'g' the generation the store reopened at,
// 'v' st_reopen_verify's integrity result, 'm' the event count, anything else the q1 fold.
fn phase_reopen(base: [i64], tmp: [i64], n: i64, adj: [i64], which: i64) -> i64 {
  let gen = st_gen(base, tmp);
  let g = st_root(base, tmp);
  let m = st_get(base, g, 0);
  if which == 103 then gen
  else (if which == 118 then st_reopen_verify(base, tmp)
  else (if which == 109 then m
  else phase_q1(base, tmp, n, adj)))
}

fn phase_ingest(base: [i64], tmp: [i64], d: [i64], n: i64, k: i64, adj: [i64]) -> i64 {
  let m = n * k;
  let order_id = zeros(m + 1);
  let from = zeros(m + 1);
  let to = zeros(m + 1);
  let et = zeros(m + 1);
  let amount = zeros(m + 1);
  let illegal_count = zeros(1);
  let oid_for_csr = zeros(m + 1);
  let evt_idx = zeros(m + 1);

  let _ = gen_events(order_id, from, to, et, amount, n, k, adj, illegal_count);

  let i = 0;
  while i < m {
    let _ = oid_for_csr[i] = order_id[i];
    let _ = evt_idx[i] = i;
    let i = i + 1;
    0
  };

  let cur = zeros(n);
  let prp = zeros(n + 2);
  let pci = zeros(m + 1);
  let _ = csr_passes(oid_for_csr, evt_idx, m, n, cur, prp, pci);

  // BUCKET width = 1000 (matches time scale: t = ek*1000 + (lv%1000))
  let bucket_width = 1000;
  let max_bucket = (k * 1000) / bucket_width + 1;
  let bucket_for_csr = zeros(m + 1);
  let bucket_idx = zeros(m + 1);

  let i = 0;
  while i < m {
    let _ = bucket_for_csr[i] = et[i] / bucket_width;
    let _ = bucket_idx[i] = i;
    let i = i + 1;
    0
  };

  let cur_t = zeros(max_bucket);
  let prp_t = zeros(max_bucket + 2);
  let pci_t = zeros(m + 1);
  let _ = csr_passes(bucket_for_csr, bucket_idx, m, max_bucket, cur_t, prp_t, pci_t);

  let tx = zeros(6);
  let _ = st_begin(base, tx, tmp);

  let oid_obj = st_alloc(base, tx, m + 1, d[1]);
  let from_obj = st_alloc(base, tx, m + 1, d[1]);
  let to_obj = st_alloc(base, tx, m + 1, d[1]);
  let t_obj = st_alloc(base, tx, m + 1, d[1]);
  let amt_obj = st_alloc(base, tx, m + 1, d[1]);
  let rp_obj = st_alloc(base, tx, n + 2, d[1]);
  let ci_obj = st_alloc(base, tx, m + 1, d[1]);
  let rp_t_obj = st_alloc(base, tx, max_bucket + 2, d[1]);
  let ci_t_obj = st_alloc(base, tx, m + 1, d[1]);

  let j = 0;
  while j < m {
    let _ = st_put(base, oid_obj, j, order_id[j]);
    let _ = st_put(base, from_obj, j, from[j]);
    let _ = st_put(base, to_obj, j, to[j]);
    let _ = st_put(base, t_obj, j, et[j]);
    let _ = st_put(base, amt_obj, j, amount[j]);
    let j = j + 1;
    0
  };

  let p = 0;
  while p < n + 2 {
    let _ = st_put(base, rp_obj, p, prp[p]);
    let p = p + 1;
    0
  };

  let q = 0;
  while q < m + 1 {
    let _ = st_put(base, ci_obj, q, pci[q]);
    let q = q + 1;
    0
  };

  let p_t = 0;
  while p_t < max_bucket + 2 {
    let _ = st_put(base, rp_t_obj, p_t, prp_t[p_t]);
    let p_t = p_t + 1;
    0
  };

  let q_t = 0;
  while q_t < m + 1 {
    let _ = st_put(base, ci_t_obj, q_t, pci_t[q_t]);
    let q_t = q_t + 1;
    0
  };

  let _ = st_seal(base, oid_obj, tmp);
  let _ = st_seal(base, from_obj, tmp);
  let _ = st_seal(base, to_obj, tmp);
  let _ = st_seal(base, t_obj, tmp);
  let _ = st_seal(base, amt_obj, tmp);
  let _ = st_seal(base, rp_obj, tmp);
  let _ = st_seal(base, ci_obj, tmp);
  let _ = st_seal(base, rp_t_obj, tmp);
  let _ = st_seal(base, ci_t_obj, tmp);

  let root = st_alloc(base, tx, 10, d[0]);
  let _ = st_put(base, root, 0, m);
  let _ = st_link(base, root, 1, oid_obj);
  let _ = st_link(base, root, 2, from_obj);
  let _ = st_link(base, root, 3, to_obj);
  let _ = st_link(base, root, 4, t_obj);
  let _ = st_link(base, root, 5, amt_obj);
  let _ = st_link(base, root, 6, rp_obj);
  let _ = st_link(base, root, 7, ci_obj);
  let _ = st_link(base, root, 8, rp_t_obj);
  let _ = st_link(base, root, 9, ci_t_obj);
  let _ = st_seal(base, root, tmp);

  let _ = st_commit(base, tx, root, tmp);

  illegal_count[0]
}

fn main(argc: i64, argv: [str]) -> i64 {
  let path = zeros(64);
  let pl = st_str(path, "wlog.store");
  let tmp = zeros(256);
  let size = 536870912;
  let ph_first = char(argv[2], 0);
  let ph_second = char(argv[2], 1);
  let want_t = if char(argv[3], 0) == 116 then 1 else 0;
  let which_q3 = char(argv[3], 0);
  let n = if argc >= 5 then parse(argv[4]) else 10000;
  let k = if argc >= 6 then parse(argv[5]) else 8;

  let adj = zeros(12);
  let _ = adj[0] = 194;
  let _ = adj[1] = 1044;
  let _ = adj[2] = 1032;
  let _ = adj[3] = 1552;
  let _ = adj[4] = 1056;
  let _ = adj[10] = 2048;

  let d = zeros(2);
  let _ = d[0] = st_digest("ROOT{i64,ref [i64],ref [i64],ref [i64],ref [i64],ref [i64],ref [i64],ref [i64],ref [i64],ref [i64]}");
  let _ = d[1] = st_digest("arr i64");

  let base = st_open(path, pl, size, tmp);
  let t0 = clock_ms();

  let result = if ph_first == 105 then (
    phase_ingest(base, tmp, d, n, k, adj)
  ) else (if ph_second == 49 then (
    phase_q1(base, tmp, n, adj)
  ) else (if ph_second == 50 then (
    let q2s = if argc >= 7 then parse(argv[6]) else 1 in
    let q2t = if argc >= 8 then parse(argv[7]) else 99999999 in
    phase_q2(base, tmp, n, adj, q2s, q2t)
  ) else (if ph_second == 51 then (
    phase_q3(base, tmp, adj, which_q3)
  ) else (if ph_second == 52 then (
    let q4s = if argc >= 7 then parse(argv[6]) else 0 - 1 in
    let q4r = if char(argv[3], 0) == 114 then 1 else 0 in
    phase_q4(base, tmp, n, adj, q4s, q4r)
  ) else (if ph_first == 112 then (
    let W = if argc >= 7 then parse(argv[6]) else 1 in
    phase_par(base, tmp, n, adj, W)
  ) else (if ph_first == 99 then (
    let rounds = if argc >= 7 then parse(argv[6]) else 100 in
    let batch = if argc >= 8 then parse(argv[7]) else 200 in
    phase_crash(base, tmp, d, n, k, adj, rounds, batch)
  ) else (if ph_first == 114 then (
    phase_reopen(base, tmp, n, adj, char(argv[3], 0))
  ) else (if ph_first == 117 then (
    let num_new = if argc >= 7 then parse(argv[6]) else 1000 in
    let ur = if char(argv[3], 0) == 114 then 1 else 0 in
    phase_u(base, tmp, d, n, k, adj, num_new, ur)
  ) else 0))))))));

  let t1 = clock_ms();
  let ms = t1 - t0;
  let final_result = if want_t == 1 then ms else result;

  let _ = sys_munmap(st_addr(base), size);
  final_result
}
