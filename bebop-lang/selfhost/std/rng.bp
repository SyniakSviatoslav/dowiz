// selfhost/std/rng.bp — SplitMix64 / PCG64 RXS-M-XS (exact port of rng.c).
// Bitwise tier (& | ^ << >>) is in the self-hosted emitter, so the
// xor-shift-rotate output permutations are exact (no multiply-chain
// approximation). Constants: GOLDEN=0x9E3779B97F4A7C15,
// MUL1=0xBF58476D1CE4E5B9, MUL2=0x94D049BB133111EB,
// PCG_MUL=6364136223846793005. All written as their two's-complement
// i64 literals (0 - x).

module core { }

// splitmix64_next: the SplitMix64 mixer over an already-advanced state.
// Contract: caller advances the state itself (s = s + GOLDEN) — mirrors
// rng_splitmix64(&state) which adds GOLDEN before mixing.
fn splitmix64_next(state: i64) -> i64 {
  let golden = 0 - 7046029254386353131;
  let mul1   = 0 - 4658895280553007687;
  let mul2   = 0 - 7723592293110705685;
  let z = (state ^ (state >> 30)) * mul1;
  let z = (z ^ (z >> 27)) * mul2;
  z ^ (z >> 31)
}

// pcg_step: one LCG step — state * PCG_MUL + inc (rng.c rng_next_u64's
// first half). The LCG state (NOT the permuted output) feeds the next step.
fn pcg_step(state: i64, inc: i64) -> i64 {
  let mul = 6364136223846793005;
  state * mul + inc
}

// pcg_output: the RXS-M-XS output permutation of a post-step LCG state.
fn pcg_output(state: i64) -> i64 {
  let rot = (state >> 59) & 31;
  let xorshifted = (state ^ (state >> 18)) >> 27;
  (xorshifted >> rot) | (xorshifted << ((0 - rot) & 63))
}

// rng_init: mirrors rng_new(seed, stream) — returns the initial pcg state
// (already advanced once) and the caller pairs it with the increment:
// inc = (stream << 1) | 1.
fn rng_init(seed: i64, stream: i64) -> i64 {
  let golden = 0 - 7046029254386353131;
  let inc = (stream << 1) | 1;
  let tmp = (seed ^ golden) + golden;
  let st = splitmix64_next(tmp);
  let st = st + inc;
  pcg_step(st, inc)
}

fn main() -> i64 {
  let inc = 3;
  let st = rng_init(42, 1);
  let i = 0;
  let acc = 0;
  while i < 8 {
    let st = pcg_step(st, inc);
    let out = pcg_output(st);
    let acc = acc * 31 + out;
    let i = i + 1;
    0
  };
  acc
}
