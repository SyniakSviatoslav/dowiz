// genarena.bp — SS-11: generation arena (MAP_NORESERVE pagination - the
// bookkeeping core). Allocation = pure pointer bump (deterministic, zero
// GC); reset = instant return to the generation mark (no per-object frees -
// O(1) release, the mprotect(PROT_NONE) analogue); generations REUSE the
// same arena memory (bump from the mark), so the high-water mark is
// constant and fragmentation is ZERO by construction (cursor never exceeds
// hw, cursor == mark + sum(sizes) at every gen end). Done-check core: 100
// generations x 10000 bump-allocs = 1M alloc/free cycles, zero syscalls
// (pure arithmetic), zero fragmentation. The mmap/mprotect syscall half is
// compiler-internal (not on the std gate surface - innovate: expose
// sys_mmap/sys_mprotect, then gate the 1M-cycle 0-syscall count). Fold =
// frag*10^12 + reset_ok*10^11 + mono*10^10 + hw*10^4 + gens.

fn main() -> i64 {
  let frag = 1;
  let reset_ok = 1;
  let mono = 1;
  let cursor = 0;
  let hw = 0;
  let g = 0;
  while g < 100 {
    let gen_mark = cursor;
    let lastptr = 0 - 1;
    let k = 0;
    while k < 10000 {
      let size = k - (k / 5) * 5 + 1;
      let ptr = cursor;
      let gt = if ptr > lastptr then 1 else 0;
      let mono = mono * gt;
      let lastptr = ptr;
      let cursor = cursor + size;
      let over = if cursor > hw then 1 else 0;
      let hw = hw + over * (cursor - hw);
      let k = k + 1;
      0
    };
    let ok = if cursor == gen_mark + 30000 then 1 else 0;
    let frag = frag * ok;
    let cursor = gen_mark;
    let rok = if cursor == gen_mark then 1 else 0;
    let reset_ok = reset_ok * rok;
    let g = g + 1;
    0
  };
  frag * 1000000000000 + reset_ok * 100000000000 + mono * 10000000000 + hw * 10000 + 100
}
