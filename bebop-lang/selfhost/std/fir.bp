use "selfhost/prelude/fp.bp"
// (T47c 2026-09-05: was `// prelude: fp`; the expansion used to be textual via tools/gen_selfsrc.sh)
// fir.bp — SS-4: FIR as a structural ban on cyclic dependencies (BIBO).
// Forward-only flow: y = sum h[k]*x[k], fixed 4 taps h = {1, 1/2, 1/4, 1/8}
// (bounded masked iteration - the tap count is a literal, no data-dependent
// loop = zero infinite-loop risk by construction). Claims: (1) impulse at
// each lag reproduces the tap exactly (taps_ok); (2) BIBO bound: for |x|<=1
// every one of the 2^4=16 worst-case sign patterns gives |y| <= sum|h| =
// 15/8 exactly, equality at the aligned pattern (bib_ok); maxabs == bound.
// Fold = taps_ok*10^13 + bib_ok*10^12 + sumq*10^5 + maxq (q = >>16).
// Machine: fp_mul verbatim (sha c184416666fe); >> only on non-negative
// values (shift law).

// fir4(h, x): forward-only 4-tap convolution (fixed tap count).
fn fir4(h: [i64], x: [i64]) -> i64 {
  fp_mul(h[0], x[0]) + fp_mul(h[1], x[1]) + fp_mul(h[2], x[2]) + fp_mul(h[3], x[3])
}

fn main() -> i64 {
  let one = 4294967296;
  let h = zeros(4);
  let x = zeros(4);
  let _ = h[0] = one;
  let _ = h[1] = one / 2;
  let _ = h[2] = one / 4;
  let _ = h[3] = one / 8;
  // (1) impulse response == taps, per lag
  let taps_ok = 1;
  let k = 0;
  while k < 4 {
    let j = 0;
    while j < 4 {
      let _ = x[j] = if j == k then one else 0;
      let j = j + 1;
      0
    };
    let y = fir4(h, x);
    let ok = if y == h[k] then 1 else 0;
    let taps_ok = taps_ok * ok;
    let k = k + 1;
    0
  };
  // (2) BIBO over all 16 sign patterns |x| <= 1
  let bound = 15 * one / 8;
  let bib_ok = 1;
  let maxabs = 0;
  let sumabs = 0;
  let pat = 0;
  while pat < 16 {
    let j = 0;
    while j < 4 {
      let b = (pat >> j) - ((pat >> j) / 2) * 2;
      let _ = x[j] = if b == 1 then one else 0 - one;
      let j = j + 1;
      0
    };
    let y = fir4(h, x);
    let ay = if y < 0 then 0 - y else y;
    let over = if ay > bound then 1 else 0;
    let bib_ok = bib_ok * (1 - over);
    let take = if ay > maxabs then 1 else 0;
    let maxabs = maxabs + take * (ay - maxabs);
    let sumabs = sumabs + ay;
    let pat = pat + 1;
    0
  };
  let maxq = maxabs >> 16;
  let sumq = sumabs >> 16;
  taps_ok * 10000000000000 + bib_ok * 1000000000000 + sumq * 100000 + maxq
}
