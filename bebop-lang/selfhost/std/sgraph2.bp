use "selfhost/prelude/sha256.bp"
use "selfhost/prelude/store.bp"
// sgraph2.bp — G8 (T117) stage 2 on its own store: the stage-1 graph (1M nodes, 5M LCG
// pairs both ways = L1 CSR) plus (a) an EDGE LOG: 1M new directed edges (LCG 777) in
// 100 batches; each batch appends a chunk E{arr i64} (pairs) and rebuilds L0 = a CSR
// over every logged edge so far (RP0/CI0), one commit per batch; (b) TOMBSTONES: 10% of
// the L1 slots (LCG 555 over 2*E slots) set in a bitmap TB{arr i64}, one new bitmap
// version, one commit; (c) COMPACTION; (d) neighbour queries = L1 slice + L0 slice
// filtered by the tombstone bit (<= 3 slices). Root G2{N, E, ref RP, ref CI, ref LOG,
// ref RP0, ref CI0, ref TB, nlog}, LOG{arr ref E}. argv[2] phase, argv[3] f|t:
//   b : build L1 + empty log/L0/TB + commit (ms)
//   l : log batches argv[4] .. +argv[5] (default 0, 10); t = ns per logged edge * 1000
//       + the max batch stall in ms (the runner compacts between ranges)
//   n : 10^5 neighbour queries (LCG 4711) over L1 + L0 minus tombstones: fold; t = ns per query
//   d : tombstone 10% of L1 slots + commit (ms)
//   f : BFS (queue) over L1 minus tombstones + L0, from argv[4] sources (LCG 31337):
//       fold = sum(reached + sum levels); t = ns per live edge slot
//   c : compaction (ms); z : logical size (arena_used*8)
//   p : frontier (SpMSpV, push/pull, alpha 14) BFS from argv[4] sources on the L1 graph
//       (run before the log phase); fold == the queue BFS; t = ns per L1 edge slot
fn lcg(x: i64) -> i64 { x * 6364136223846793005 + 1442695040888963407 }
// csr_passes(src, dst, m, n, cur, prp, pci): the three counting-sort passes, over PLAIN arrays
// only. It is a SEPARATE function from csr_build on purpose, and its parameter list carries no
// store argument at all: measured on the D1 bench arm, running the passes and the publish in one
// function put the fill pass at 820 ms against 592 ms for byte-identical work over byte-identical
// anonymous memory, because base/tmp/rp/ci are live-out into the publish and the fill loop's own
// inductions spill (AGENTS.md T2.1, >8 live symbols). Split, the fill pass matches the plain arm.
fn csr_passes(src: [i64], dst: [i64], m: i64, n: i64, cur: [i64], prp: [i64], pci: [i64]) -> i64 {
  let z = 0;
  while z < n + 2 {
    let _ = prp[z] = 0;
    let z = z + 1;
    0
  };
  let _ = prp[0] = n + 1;
  let i = 0;
  while i < m {
    let a = src[i];
    let _ = prp[2 + a] = prp[2 + a] + 1;
    let i = i + 1;
    0
  };
  let v = 0;
  while v < n {
    let _ = prp[2 + v] = prp[2 + v] + prp[1 + v];
    let _ = cur[v] = prp[1 + v];
    let v = v + 1;
    0
  };
  let _ = pci[0] = m;
  let j = 0;
  while j < m {
    let a = src[j];
    let s = cur[a];
    let _ = pci[1 + s] = dst[j];
    let _ = cur[a] = s + 1;
    let j = j + 1;
    0
  };
  0
}
// csr_build(base, tmp, src, dst, m, n, rp, ci, cur, prp, pci): fill the caller-allocated RP
// (n+2 cells) and CI (m+1 cells) objects (refs stay refs: no i64 round trip through an out
// array). D1 (docs/blueprints/D1-build-in-ram-publish-sequentially.md): the three counting-sort
// passes scatter into the caller's PLAIN prp/pci arrays -- anonymous memory -- and the result is
// PUBLISHED into the store objects in one ascending pass each. R1 measured the same scatter
// writing straight into the store's 512 MB MAP_SHARED file mapping at 22x its cost into
// anonymous memory, single-variable, identical fold (journal 1788872878; WHICH mechanism inside
// the MAP_SHARED write path is undetermined on this box -- /proc/vmstat is frozen under the
// proot, 1788875683 -- and the fix does not depend on it). Nothing else moves: the caller still
// st_alloc's rp/ci at the same point in the transaction, so the arena layout, the object headers
// and the committed bytes are byte-identical to the scatter-in-place version. prp is zeroed here
// because phase_log reuses one pair of arrays across batches (a freshly bump-allocated store
// object got its zeros from the sparse file); pci needs no clear, every cell 0..m of it is
// written. Callers must size prp >= n+2 and pci >= m+1.
fn csr_build(base: [i64], tmp: [i64], src: [i64], dst: [i64], m: i64, n: i64, rp: ref RP, ci: ref CI, cur: [i64], prp: [i64], pci: [i64]) -> i64 {
  let _ = csr_passes(src, dst, m, n, cur, prp, pci);
  let p = 0;
  while p < n + 2 {
    let _ = st_put(base, rp, p, prp[p]);
    let p = p + 1;
    0
  };
  let q = 0;
  while q < m + 1 {
    let _ = st_put(base, ci, q, pci[q]);
    let q = q + 1;
    0
  };
  let _ = st_seal(base, rp, tmp);
  let _ = st_seal(base, ci, tmp);
  0
}
fn root_write(base: [i64], tx: [i64], tmp: [i64], dg: i64, n: i64, e: i64, rp: ref RP, ci: ref CI, log: ref LOG, rp0: ref RP, ci0: ref CI, tb: ref TB, nlog: i64, tl: ref TH) -> ref G2 {
  let g = st_alloc(base, tx, 10, dg);
  let _ = st_put(base, g, 0, n);
  let _ = st_put(base, g, 1, e);
  let _ = st_link(base, g, 2, rp);
  let _ = st_link(base, g, 3, ci);
  let _ = st_link(base, g, 4, log);
  let _ = if rp0 == 0 then st_put(base, g, 5, 0) else st_link(base, g, 5, rp0);
  let _ = if ci0 == 0 then st_put(base, g, 6, 0) else st_link(base, g, 6, ci0);
  let _ = st_link(base, g, 7, tb);
  let _ = st_put(base, g, 8, nlog);
  let _ = st_link(base, g, 9, tl);
  let _ = st_seal(base, g, tmp);
  g
}
// ---- B4 step 1 (docs/blueprints/B4-functional-tensor-updates.md §3): the tail tier ----
// tl_cap(): capacity of the append-only COO tail chunk, in entries. TL{arr i64} = cell 0
// cnt, then (row, col) pairs -- sgraph2's edges carry no value, so an entry is a pair, not
// a triple. 4096 is the blueprint's figure; §8 risk 1 (phase 'a' + phase 'n') measures what
// it costs on the read side, and phase_log's row measures what it buys on the write side.
// tl_cap(): 500000 since B4 candidate (b) (step 2''''). The run count R = 1e6 / tl_cap() is the
// L0 merge policy and it was SWEPT, medians of 3 on this box: R=5 (cap 200000, the committed
// policy) 593 ns/edge / 74 ms stall; R=3 495 / 86; R=2 443 / 101; R=1 370 / 141. R=2 is shipped:
// it is the first point that clears the <= 500 ns/edge gate with real margin (worst rep 469)
// while holding the stall regression to +36 % instead of R=1's +91 %. The stall RISES as R falls
// because the last promotion also has to drain a 1e6/R-entry tail out of the segments, measured
// at 61.6 ns per tail entry -- a term the arithmetic missed and the sweep caught.
fn tl_cap() -> i64 { 500000 }
// tl_seg(): entries per SEGMENT (B4 step 2'''). The tail is no longer one chunk: TH{arr ref TG}
// is the header (cell 0 = nseg, cells 1..nseg = segment refs) over TG{arr i64} segments (cell 0
// = cnt, then (row,col) pairs, capacity tl_seg()). Segments 1..nseg-1 are always FULL, so the
// total is (nseg-1)*tl_seg() + cnt(last) -- tl_count, O(1).
// WHY: step 2' measured phase_log's non-promotion floor at 426 ns/edge, 85 % of the whole
// 500 ns/edge gate budget, and it was tail_new copying the WHOLE shared tail plus st_seal's
// crc32 over it, twice per batch. Step 2'' measured a segmented probe at 4.0x less
// (291 -> 72 ns/entry) with a floor FLAT in the cap where the whole-chunk floor is LINEAR in it
// (307/545/1257 ns/entry at cap 100k/200k/500k) -- which is why the cap is 200000 here and was
// 100000 before: a bigger tail used to cost more per batch and now it does not, while the
// promotion total falls as the cap rises (at cap 200000 the tail fills exactly at the end of a
// 20-batch invocation, so there are 5 promotions over the run instead of 10).
// 256 is the measured optimum region (72-85 ns/entry flat over capS 64..1024, 143 at 16384).
fn tl_seg() -> i64 { 256 }
// tail_new(base, tx, d, old, room, tmp): blueprint invariant (1) -- an object is written only
// inside the transaction that allocated it. Segmenting keeps that EXACTLY: a FULL segment is
// immutable (nothing ever writes it again), so any number of live transactions and committed
// versions may share it BY REFERENCE; the PARTIAL last segment is the only mutable object and
// tl_open copies it into a segment allocated by THIS transaction before any append, leaving the
// old header pointing at the untouched original. The header itself is always fresh.
// st_compact PRESERVES that sharing rather than duplicating it: st_copy_obj leaves a forwarding
// pointer in the old object (store.bp:465-478, old[o] = 0 and old[o + 2] = at) and st_forward
// returns it, so a segment named by k versions is copied ONCE. bench/vs_rust/segtail.sh's
// Cheney block gates that with a pinned version re-folded AFTER a compaction.
fn tail_new(base: [i64], tx: [i64], d: [i64], old: ref TH, room: i64, tmp: [i64]) -> ref TH {
  let ns = if old == 0 then 0 else st_get(base, old, 0);
  let h = st_alloc(base, tx, 1 + ns + room / tl_seg() + 4, d[6]);
  let _ = st_put(base, h, 0, ns);
  let i = 1;
  while i <= ns {
    let _ = st_link(base, h, i, st_ref(base, old, i));
    let i = i + 1;
    0
  };
  let _ = tl_open(base, tx, d, h, tmp);
  let _ = st_seal(base, h, tmp);
  h
}
// tl_open: THE CoW, once per transaction. A partial last segment is copied (<= tl_seg()
// entries) and the copy replaces it in this transaction's header; a FULL last segment is not
// copied at all -- a fresh empty one is appended instead.
fn tl_open(base: [i64], tx: [i64], d: [i64], h: ref TH, tmp: [i64]) -> i64 {
  let ns = st_get(base, h, 0);
  let lsg = if ns == 0 then 0 else st_ref(base, h, ns);
  let c0 = if ns == 0 then tl_seg() else st_get(base, lsg, 0);
  let cc = if c0 < tl_seg() then c0 else 0;
  let idx = if c0 < tl_seg() then ns else ns + 1;
  let nl = st_alloc(base, tx, 1 + 2 * tl_seg(), d[7]);
  let _ = st_put(base, nl, 0, cc);
  let i = 0;
  while i < 2 * cc {
    let _ = st_put(base, nl, 1 + i, st_get(base, lsg, 1 + i));
    let i = i + 1;
    0
  };
  let _ = st_seal(base, nl, tmp);
  let _ = st_link(base, h, idx, nl);
  let _ = st_put(base, h, 0, idx);
  idx
}
fn tl_count(base: [i64], h: ref TH) -> i64 {
  let ns = st_get(base, h, 0);
  let lsg = if ns == 0 then 0 else st_ref(base, h, ns);
  let c = if ns == 0 then 0 else st_get(base, lsg, 0);
  if ns == 0 then 0 else (ns - 1) * tl_seg() + c
}
fn tl_addseg(base: [i64], tx: [i64], d: [i64], h: ref TH) -> ref TG {
  let idx = st_get(base, h, 0) + 1;
  let nl = st_alloc(base, tx, 1 + 2 * tl_seg(), d[7]);
  let _ = st_put(base, nl, 0, 0);
  let _ = st_link(base, h, idx, nl);
  let _ = st_put(base, h, 0, idx);
  nl
}
fn tl_put1(base: [i64], tx: [i64], d: [i64], h: ref TH, a: i64, w: i64) -> i64 {
  let cur = st_ref(base, h, st_get(base, h, 0));
  let c0 = st_get(base, cur, 0);
  let hit = if c0 < tl_seg() then 1 else 0;
  let sg = if hit == 1 then cur else tl_addseg(base, tx, d, h);
  let c = c0 * hit;
  let _ = st_put(base, sg, 1 + 2 * c, a);
  let _ = st_put(base, sg, 2 + 2 * c, w);
  let _ = st_put(base, sg, 0, c + 1);
  0
}
// tl_gen: append `take` LCG-777 edges. s[0] carries the generator state across sub-batches AND
// across phase invocations (the runner calls phase `l` five times). Every segment this call
// touched is sealed at the end -- the crc is over ONE segment, never over the whole tail, which
// is the other half of the step 2'' win.
fn tl_gen(base: [i64], tx: [i64], d: [i64], h: ref TH, take: i64, s: [i64], n: i64, tmp: [i64]) -> i64 {
  let i0 = st_get(base, h, 0);
  let k = 0;
  while k < take {
    let _ = s[0] = lcg(s[0]);
    let a = (s[0] >> 20) % n;
    let _ = s[0] = lcg(s[0]);
    let w = (s[0] >> 20) % n;
    let _ = tl_put1(base, tx, d, h, a, w);
    let k = k + 1;
    0
  };
  let i1 = st_get(base, h, 0);
  let j = i0;
  while j <= i1 {
    let _ = st_seal(base, st_ref(base, h, j), tmp);
    let j = j + 1;
    0
  };
  tl_count(base, h)
}
fn tl_copyout(base: [i64], h: ref TH, ns: i64, src: [i64], dst: [i64], m: i64) -> i64 {
  let j = 1;
  let p = m;
  while j <= ns {
    let sg = st_ref(base, h, j);
    let c = st_get(base, sg, 0);
    let i = 0;
    while i < c {
      let _ = src[p + i] = st_get(base, sg, 1 + 2 * i);
      let _ = dst[p + i] = st_get(base, sg, 2 + 2 * i);
      let i = i + 1;
      0
    };
    let p = p + c;
    let j = j + 1;
    0
  };
  p
}
// tail_drain: move the tail into the plain edge mirror at offset m and empty it. The segments
// are NOT written (older versions still name the full ones -- invariant (1)); only THIS
// transaction's header is reset, and its now-stale slots are ZEROED so st_compact's mask -1
// walk cannot resurrect drained segments through them.
fn tail_drain(base: [i64], tx: [i64], d: [i64], h: ref TH, src: [i64], dst: [i64], m: i64, tmp: [i64]) -> i64 {
  let ns = st_get(base, h, 0);
  let p = tl_copyout(base, h, ns, src, dst, m);
  let z = 1;
  while z <= ns {
    let _ = st_put(base, h, z, 0);
    let z = z + 1;
    0
  };
  let _ = st_put(base, h, 0, 0);
  let _ = tl_open(base, tx, d, h, tmp);
  p
}
fn tail_row_seg(base: [i64], sg: ref TG, v: i64) -> i64 {
  let c = st_get(base, sg, 0);
  let acc = 0;
  let i = 0;
  while i < c {
    let hit = if st_get(base, sg, 1 + 2 * i) == v then 1 else 0;
    let acc = acc + hit * (1 + st_get(base, sg, 2 + 2 * i));
    let i = i + 1;
    0
  };
  acc
}
// tail_row(base, h, v): sum of (1 + col) over the tail entries whose row is v -- the read side
// of read_row (blueprint section 3), applied as a delta after the L1 and L0 slices. STILL
// linear in the total entry count: segmenting is a WRITE-side win and buys the read side
// nothing. The read cost is why the cap can only be raised as far as the flush discipline
// allows -- phase_log promotes at the end of every invocation, so every committed version a
// read phase sees has an EMPTY tail (B4 step 2''' read-index arithmetic).
fn tail_row(base: [i64], h: ref TH, v: i64) -> i64 {
  let ns = st_get(base, h, 0);
  let acc = 0;
  let j = 1;
  while j <= ns {
    let acc = acc + tail_row_seg(base, st_ref(base, h, j), v);
    let j = j + 1;
    0
  };
  acc
}
fn tail_bfs_seg(base: [i64], sg: ref TG, v: i64, lv: i64, level: [i64], q: [i64], t: [i64]) -> i64 {
  let c = st_get(base, sg, 0);
  let i = 0;
  while i < c {
    let hit = if st_get(base, sg, 1 + 2 * i) == v then 1 else 0;
    let w = st_get(base, sg, 2 + 2 * i);
    let take = hit * (if level[w] < 0 then 1 else 0);
    let _ = if take == 1 then (let _ = level[w] = lv + 1 in 0) else 0;
    let _ = if take == 1 then (let _ = q[t[0]] = w in 0) else 0;
    let _ = t[0] = t[0] + take;
    let i = i + 1;
    0
  };
  0
}
fn tail_bfs(base: [i64], h: ref TH, v: i64, lv: i64, level: [i64], q: [i64], t: [i64]) -> i64 {
  let ns = st_get(base, h, 0);
  let j = 1;
  while j <= ns {
    let _ = tail_bfs_seg(base, st_ref(base, h, j), v, lv, level, q, t);
    let j = j + 1;
    0
  };
  0
}
// l0_load(base, tmp, src, dst, n): rebuild the plain edge mirror from the committed L0 CSR,
// so a promotion in THIS process can re-run csr_build over L0 union tail. Returns |L0|.
fn l0_load(base: [i64], tmp: [i64], src: [i64], dst: [i64], n: i64) -> i64 {
  let g = st_root(base, tmp);
  let has0 = if st_get(base, g, 5) == 0 then 0 else 1;
  let rp0 = st_ref(base, g, 5);
  let ci0 = st_ref(base, g, 6);
  let m = 0;
  let v = 0;
  while v < n * has0 {
    let k = st_get(base, rp0, 1 + v);
    let hi = st_get(base, rp0, 2 + v);
    while k < hi {
      let _ = src[m] = v;
      let _ = dst[m] = st_get(base, ci0, 1 + k);
      let m = m + 1;
      let k = k + 1;
      0
    };
    let v = v + 1;
    0
  };
  m
}
// pub_rp / pub_ci: allocate one L0 CSR object and publish the counting-sort output into it
// in a single ascending pass (D1 again). Split in two so the promotion site never holds
// both a fresh RP and a fresh CI plus the scratch arrays live at once.
fn pub_rp(base: [i64], tx: [i64], tmp: [i64], d: [i64], prp: [i64], n: i64) -> ref RP {
  let rp = st_alloc(base, tx, n + 2, d[0]);
  let p = 0;
  while p < n + 2 {
    let _ = st_put(base, rp, p, prp[p]);
    let p = p + 1;
    0
  };
  let _ = st_seal(base, rp, tmp);
  rp
}
fn pub_ci(base: [i64], tx: [i64], tmp: [i64], d: [i64], pci: [i64], m: i64) -> ref CI {
  let ci = st_alloc(base, tx, m + 1, d[1]);
  let p = 0;
  while p < m + 1 {
    let _ = st_put(base, ci, p, pci[p]);
    let p = p + 1;
    0
  };
  let _ = st_seal(base, ci, tmp);
  ci
}
// phase_build(base, tmp, d, skew): skew = 1 sends half of all destination endpoints to
// the 1% hub set (nodes 0..9999): the skewed variant of §9.5 (row 'uniform + 1%-hub').
fn phase_build(base: [i64], tmp: [i64], d: [i64], skew: i64) -> i64 {
  let n = 1000000;
  let e = 5000000;
  let tx = zeros(6);
  let _ = st_begin(base, tx, tmp);
  let src = zeros(2 * e);
  let dst = zeros(2 * e);
  let x = 4242;
  let i = 0;
  while i < e {
    let x = lcg(x);
    let a = (x >> 20) % n;
    let x = lcg(x);
    let hub = skew * ((x >> 10) & 1);
    let b = if hub == 1 then (x >> 20) % 10000 else (x >> 20) % n;
    let _ = src[2 * i] = a;
    let _ = dst[2 * i] = b;
    let _ = src[2 * i + 1] = b;
    let _ = dst[2 * i + 1] = a;
    let i = i + 1;
    0
  };
  let cur = zeros(n);
  let prp = zeros(n + 2);
  let pci = zeros(2 * e + 1);
  let rp1 = st_alloc(base, tx, n + 2, d[0]);
  let ci1 = st_alloc(base, tx, 2 * e + 1, d[1]);
  let _ = csr_build(base, tmp, src, dst, 2 * e, n, rp1, ci1, cur, prp, pci);
  let log = st_alloc(base, tx, 101, d[3]);
  let _ = st_put(base, log, 0, 0);
  let _ = st_seal(base, log, tmp);
  let tb = st_alloc(base, tx, 156251, d[4]);
  let _ = st_put(base, tb, 0, 156250);
  let _ = st_seal(base, tb, tmp);
  let tl = tail_new(base, tx, d, 0, 0, tmp);
  let g = root_write(base, tx, tmp, d[2], n, 2 * e, rp1, ci1, log, 0, 0, tb, 0, tl);
  st_commit(base, tx, g, tmp)
}
// phase_log(base, tmp, d, b0, nb, stall): log batches b0 .. b0+nb-1 (of 100). B4 STEP 1
// (docs/blueprints/B4-functional-tensor-updates.md §5 step 1): a batch's 10^4 LCG-777 edges
// are APPENDED TO THE TAIL instead of being appended to the log and triggering a rebuild of
// L0 over every logged edge; promote_tail (L0' = csr_build(L0 union tail), tail' empty)
// fires whenever the chunk fills, and once more at the end of the phase so a later read
// phase sees a committed version with an empty tail. The tail is CoW'd once per transaction
// (invariant (1)) and appended in place after that. The redundant second copy of every edge
// (the LOG chunk) is gone -- the tail and L0 are both durable, both committed; LOG stays in
// the root as an empty array so the G2 layout and st_compact's walk are unchanged.
// stall[0] = max batch ms.
// B4 candidate (b), step 2'''': the L0 RUN COUNT is a policy, and cap0/fl0 make it measurable.
// The tail caps at cap0 (or tl_cap() when cap0 == 0) and the end-of-invocation flush fires only
// on the FINAL invocation -- argv[7] = 1 restores the pre-2'''' flush-every-invocation policy,
// so `l t <b0> 20 200000 1` reproduces the COMMITTED control row from this same binary.
// The run count is R = 1e6 / cap and promotion p rewrites the whole L0 so far (an EAGER merge).
// Arithmetic, from the step 2''' fit promotion = 39.2 ms + 33.0 ns per L0 edge: total promotion
// = R*F + M*1e6*(R+1)/2, i.e. 295/239/184/128/72 ms at R = 5/4/3/2/1 -- MONOTONE DOWN in
// decreasing R, because F is the n-proportional rp0 write (n+2 cells = 8 MB) and does NOT shrink
// with the run size. That is also why LAZY sorted runs (write a run now, merge at the end) are
// strictly WORSE here at every R: they pay R*F_run AND the final F + M*1e6 (420-577 ns/edge with
// a dense per-run rp, 394-443 with a compact per-run directory) against R=1's 358. LSM
// amortisation assumes a run's cost is spread over later work; here the per-run cost is a
// constant independent of the run, so the amortisation constant is NEGATIVE -- cost per edge
// RISES with the run count.
// The <= 10 ms stall half is UNREACHABLE at any R, and this predicts it: the last promotion
// always materialises all 1e6 edges, writing 1e6 ci cells = 8 MB = 33.0 ms of marginal alone,
// 3.3x the gate, BEFORE the 39.2 ms fixed term.
fn phase_log(base: [i64], tmp: [i64], d: [i64], b0: i64, nb: i64, stall: [i64], cap0: i64, fl0: i64) -> i64 {
  let n = 1000000;
  let src = zeros(1000000);
  let dst = zeros(1000000);
  let cur = zeros(n);
  let prp = zeros(n + 2);
  let pci = zeros(1000001);
  let s = zeros(4);
  let _ = s[0] = 777;
  let _ = s[1] = l0_load(base, tmp, src, dst, n);
  let _ = s[2] = if fl0 == 1 then 1 else (if b0 + nb >= 100 then 1 else 0);
  let _ = s[3] = if cap0 == 0 then tl_cap() else cap0;
  let skip = 0;
  while skip < b0 * 20000 {
    let _ = s[0] = lcg(s[0]);
    let skip = skip + 1;
    0
  };
  let b = b0;
  let tx = zeros(6);
  while b < b0 + nb {
    let t0 = clock_ms();
    let _ = st_begin(base, tx, tmp);
    let g = st_root(base, tmp);
    let told = st_ref(base, g, 9);
    let tl = tail_new(base, tx, d, told, 10000, tmp);
    let _ = st_supersede(base, tx, told);
    let nold = if st_get(base, g, 5) == 0 then 0 else 1;
    let rp0 = if nold == 1 then st_ref(base, g, 5) else 0;
    let ci0 = if nold == 1 then st_ref(base, g, 6) else 0;
    let last = if b == b0 + nb - 1 then s[2] else 0;
    let done = 0;
    while done < 10000 {
      let room = s[3] - tl_count(base, tl);
      let left = 10000 - done;
      let take = if left < room then left else room;
      let cnt = tl_gen(base, tx, d, tl, take, s, n, tmp);
      let done = done + take;
      let full = if cnt == s[3] then 1 else 0;
      let atend = if done == 10000 then last else 0;
      let ne = if cnt > 0 then 1 else 0;
      let go = if full == 1 then 1 else atend * ne;
      let _ = if go == 1 then (let _ = s[1] = tail_drain(base, tx, d, tl, src, dst, s[1], tmp) in 0) else 0;
      let _ = if go == 1 then csr_passes(src, dst, s[1], n, cur, prp, pci) else 0;
      let _ = if go * nold == 1 then st_supersede(base, tx, rp0) else 0;
      let _ = if go * nold == 1 then st_supersede(base, tx, ci0) else 0;
      let rp0 = if go == 1 then pub_rp(base, tx, tmp, d, prp, n) else rp0;
      let ci0 = if go == 1 then pub_ci(base, tx, tmp, d, pci, s[1]) else ci0;
      let nold = if go == 1 then 1 else nold;
      0
    };
    let _ = st_seal(base, tl, tmp);
    let g2 = root_write(base, tx, tmp, d[2], n, st_get(base, g, 1), st_ref(base, g, 2), st_ref(base, g, 3), st_ref(base, g, 4), rp0, ci0, st_ref(base, g, 7), st_get(base, g, 8) + 10000, tl);
    let _ = st_supersede(base, tx, g);
    let _ = st_commit(base, tx, g2, tmp);
    let dt = clock_ms() - t0;
    let _ = if dt > stall[0] then (let _ = stall[0] = dt in 0) else 0;
    let b = b + 1;
    0
  };
  0
}
// phase_flush(base, tmp, d): promote whatever the tail holds into L0 and commit. This is
// the probe half of the blueprint's RED condition (§7): the same fold read THROUGH the tail
// delta and read after promotion must be identical -- a difference is a merge bug (a
// duplicate or a dropped edge), never a new baseline.
fn phase_flush(base: [i64], tmp: [i64], d: [i64]) -> i64 {
  let n = 1000000;
  let src = zeros(1200000);
  let dst = zeros(1200000);
  let cur = zeros(n);
  let prp = zeros(n + 2);
  let pci = zeros(1200001);
  let m = l0_load(base, tmp, src, dst, n);
  let tx = zeros(6);
  let _ = st_begin(base, tx, tmp);
  let g = st_root(base, tmp);
  let told = st_ref(base, g, 9);
  let tl = tail_new(base, tx, d, told, 0, tmp);
  let _ = st_supersede(base, tx, told);
  let m2 = tail_drain(base, tx, d, tl, src, dst, m, tmp);
  let _ = csr_passes(src, dst, m2, n, cur, prp, pci);
  let nold = if st_get(base, g, 5) == 0 then 0 else 1;
  let _ = if nold == 1 then st_supersede(base, tx, st_ref(base, g, 5)) else 0;
  let _ = if nold == 1 then st_supersede(base, tx, st_ref(base, g, 6)) else 0;
  let rp0 = pub_rp(base, tx, tmp, d, prp, n);
  let ci0 = pub_ci(base, tx, tmp, d, pci, m2);
  let _ = st_seal(base, tl, tmp);
  let g2 = root_write(base, tx, tmp, d[2], n, st_get(base, g, 1), st_ref(base, g, 2), st_ref(base, g, 3), st_ref(base, g, 4), rp0, ci0, st_ref(base, g, 7), st_get(base, g, 8), tl);
  let _ = st_supersede(base, tx, g);
  let _ = st_commit(base, tx, g2, tmp);
  m2
}
// phase_tail(base, tmp, d, k): B4 §8 risk-1 probe -- leave exactly k entries (k <= tl_cap())
// in the committed tail, never promoting, so the `n` phase can be timed against a loaded
// tail. The edges are a different stream (LCG 999331) on purpose: this phase is a read-cost
// probe, run after the folds, never part of the fold path.
fn phase_tail(base: [i64], tmp: [i64], d: [i64], k: i64) -> i64 {
  let tx = zeros(6);
  let _ = st_begin(base, tx, tmp);
  let g = st_root(base, tmp);
  let told = st_ref(base, g, 9);
  let tl = tail_new(base, tx, d, told, k, tmp);
  let _ = st_supersede(base, tx, told);
  let s = zeros(4);
  let _ = s[0] = 999331;
  let _ = tl_gen(base, tx, d, tl, k - tl_count(base, tl), s, 1000000, tmp);
  let _ = st_seal(base, tl, tmp);
  let nold = if st_get(base, g, 5) == 0 then 0 else 1;
  let rp0 = if nold == 1 then st_ref(base, g, 5) else 0;
  let ci0 = if nold == 1 then st_ref(base, g, 6) else 0;
  let g2 = root_write(base, tx, tmp, d[2], st_get(base, g, 0), st_get(base, g, 1), st_ref(base, g, 2), st_ref(base, g, 3), st_ref(base, g, 4), rp0, ci0, st_ref(base, g, 7), st_get(base, g, 8), tl);
  let _ = st_supersede(base, tx, g);
  let _ = st_commit(base, tx, g2, tmp);
  tl_count(base, tl)
}
fn tomb(base: [i64], tb: ref TB, slot: i64) -> i64 {
  (st_get(base, tb, 1 + (slot >> 6)) >> (slot & 63)) & 1
}
// nbr_fold(base, g, v): deg + sum of neighbours over L1 (minus tombstones) and L0.
fn nbr_fold(base: [i64], g: ref G2, v: i64) -> i64 {
  let rp = st_ref(base, g, 2);
  let ci = st_ref(base, g, 3);
  let tb = st_ref(base, g, 7);
  let lo = st_get(base, rp, 1 + v);
  let hi = st_get(base, rp, 2 + v);
  let acc = 0;
  let k = lo;
  while k < hi {
    let live = 1 - tomb(base, tb, k);
    let acc = acc + live * (1 + st_get(base, ci, 1 + k));
    let k = k + 1;
    0
  };
  let has0 = if st_get(base, g, 5) == 0 then 0 else 1;
  let rp0 = st_ref(base, g, 5);
  let ci0 = st_ref(base, g, 6);
  let lo0 = if has0 == 1 then st_get(base, rp0, 1 + v) else 0;
  let hi0 = if has0 == 1 then st_get(base, rp0, 2 + v) else 0;
  let k = lo0;
  while k < hi0 {
    let acc = acc + 1 + st_get(base, ci0, 1 + k);
    let k = k + 1;
    0
  };
  acc + tail_row(base, st_ref(base, g, 9), v)
}
fn phase_nbr(base: [i64], tmp: [i64]) -> i64 {
  let g = st_root(base, tmp);
  let x = 4711;
  let q = 0;
  let acc = 0;
  while q < 100000 {
    let x = lcg(x);
    let acc = acc + nbr_fold(base, g, (x >> 20) % 1000000);
    let q = q + 1;
    0
  };
  acc
}
fn phase_del(base: [i64], tmp: [i64], d: [i64]) -> i64 {
  let tx = zeros(6);
  let _ = st_begin(base, tx, tmp);
  let g = st_root(base, tmp);
  let old = st_ref(base, g, 7);
  let tb = st_alloc(base, tx, 156251, d[4]);
  let _ = st_put(base, tb, 0, 156250);
  let i = 0;
  while i < 156250 {
    let _ = st_put(base, tb, 1 + i, st_get(base, old, 1 + i));
    let i = i + 1;
    0
  };
  let x = 555;
  let k = 0;
  while k < 1000000 {
    let x = lcg(x);
    let slot = (x >> 20) % 10000000;
    let w = 1 + (slot >> 6);
    let _ = st_put(base, tb, w, st_get(base, tb, w) | (1 << (slot & 63)));
    let k = k + 1;
    0
  };
  let _ = st_seal(base, tb, tmp);
  let _ = st_supersede(base, tx, old);
  let g2 = root_write(base, tx, tmp, d[2], st_get(base, g, 0), st_get(base, g, 1), st_ref(base, g, 2), st_ref(base, g, 3), st_ref(base, g, 4), st_ref(base, g, 5), st_ref(base, g, 6), tb, st_get(base, g, 8), st_ref(base, g, 9));
  let _ = st_supersede(base, tx, g);
  st_commit(base, tx, g2, tmp)
}
fn bfs_from(base: [i64], g: ref G2, n: i64, s: i64, level: [i64], queue: [i64]) -> i64 {
  let rp = st_ref(base, g, 2);
  let ci = st_ref(base, g, 3);
  let tb = st_ref(base, g, 7);
  let has0 = if st_get(base, g, 5) == 0 then 0 else 1;
  let rp0 = st_ref(base, g, 5);
  let ci0 = st_ref(base, g, 6);
  let tl = st_ref(base, g, 9);
  let t = zeros(1);
  let i = 0;
  while i < n {
    let _ = level[i] = 0 - 1;
    let i = i + 1;
    0
  };
  let _ = level[s] = 0;
  let _ = queue[0] = s;
  let head = 0;
  let tail = 1;
  let acc = 0;
  // tl_count is O(1) but it is a call plus three loads, and this loop runs once per DEQUEUED
  // vertex, so it is hoisted: the tail cannot change during a read phase (B4 step 2''').
  let tc = tl_count(base, tl);
  while head < tail {
    let v = queue[head];
    let lv = level[v];
    let acc = acc + lv + 1;
    let k = st_get(base, rp, 1 + v);
    let hi = st_get(base, rp, 2 + v);
    while k < hi {
      let w = st_get(base, ci, 1 + k);
      let take = (1 - tomb(base, tb, k)) * (if level[w] < 0 then 1 else 0);
      let _ = if take == 1 then (let _ = level[w] = lv + 1 in 0) else 0;
      let _ = if take == 1 then (let _ = queue[tail] = w in 0) else 0;
      let tail = tail + take;
      let k = k + 1;
      0
    };
    let k0 = if has0 == 1 then st_get(base, rp0, 1 + v) else 0;
    let hi0 = if has0 == 1 then st_get(base, rp0, 2 + v) else 0;
    while k0 < hi0 {
      let w = st_get(base, ci0, 1 + k0);
      let take = if level[w] < 0 then 1 else 0;
      let _ = if take == 1 then (let _ = level[w] = lv + 1 in 0) else 0;
      let _ = if take == 1 then (let _ = queue[tail] = w in 0) else 0;
      let tail = tail + take;
      let k0 = k0 + 1;
      0
    };
    let _ = t[0] = tail;
    let _ = if tc > 0 then tail_bfs(base, tl, v, lv, level, queue, t) else 0;
    let tail = t[0];
    let head = head + 1;
    0
  };
  acc
}
// ---- frontier BFS (SpMSpV, §9.2): level-synchronous over bitmaps, push/pull switch ----
// bit(bm, i): bit i of bitmap bm (cells of 64 bits).
fn bit(bm: [i64], i: i64) -> i64 { (bm[i >> 6] >> (i & 63)) & 1 }
fn setbit(bm: [i64], i: i64) -> i64 {
  let _ = bm[i >> 6] = bm[i >> 6] | (1 << (i & 63));
  0
}
// nbr_live(base, g, k): the neighbour at L1 slot k, or -1 if tombstoned.
fn nbr_live(base: [i64], g: ref G2, k: i64) -> i64 {
  if tomb(base, st_ref(base, g, 7), k) == 1 then 0 - 1 else st_get(base, st_ref(base, g, 3), 1 + k)
}
// push_step: for every frontier vertex v (drain each word LSB-first, index by clz),
// mark every unvisited neighbour (L1 minus tombstones, then L0) in next.
fn push_step(base: [i64], g: ref G2, fr: [i64], vis: [i64], nx: [i64], level: [i64], lv: i64, nw: i64, cnt: [i64]) -> i64 {
  let rp = st_ref(base, g, 2);
  let ci = st_ref(base, g, 3);
  let tb = st_ref(base, g, 7);
  let has0 = if st_get(base, g, 5) == 0 then 0 else 1;
  let rp0 = st_ref(base, g, 5);
  let ci0 = st_ref(base, g, 6);
  let w = 0;
  while w < nw {
    while fr[w] != 0 {
      let x = fr[w];
      let low = x & (0 - x);
      let _ = fr[w] = x - low;
      let v = w * 64 + 63 - clz(low);
      let k = st_get(base, rp, 1 + v);
      let hi = st_get(base, rp, 2 + v);
      while k < hi {
        let u = st_get(base, ci, 1 + k);
        let take = (1 - tomb(base, tb, k)) * (1 - bit(vis, u));
        let _ = if take == 1 then setbit(vis, u) else 0;
        let _ = if take == 1 then setbit(nx, u) else 0;
        let _ = if take == 1 then (let _ = level[u] = lv in 0) else 0;
        let _ = cnt[0] = cnt[0] + take;
        let k = k + 1;
        0
      };
      let k0 = if has0 == 1 then st_get(base, rp0, 1 + v) else 0;
      let hi0 = if has0 == 1 then st_get(base, rp0, 2 + v) else 0;
      while k0 < hi0 {
        let u = st_get(base, ci0, 1 + k0);
        let take = 1 - bit(vis, u);
        let _ = if take == 1 then setbit(vis, u) else 0;
        let _ = if take == 1 then setbit(nx, u) else 0;
        let _ = if take == 1 then (let _ = level[u] = lv in 0) else 0;
        let _ = cnt[0] = cnt[0] + take;
        let k0 = k0 + 1;
        0
      };
      0
    };
    let w = w + 1;
    0
  };
  0
}
// pull_step: for every unvisited vertex u, scan its (undirected L1) neighbours until one
// is in the frontier; the log edges are directed, so a pull also scans u's L0 out-edges
// -- correct only because the log is small; the switch keeps pull to dense levels.
fn pull_step(base: [i64], g: ref G2, fr: [i64], vis: [i64], nx: [i64], level: [i64], lv: i64, n: i64, cnt: [i64]) -> i64 {
  let rp = st_ref(base, g, 2);
  let ci = st_ref(base, g, 3);
  let tb = st_ref(base, g, 7);
  let u = 0;
  while u < n {
    let unseen = 1 - bit(vis, u);
    let k = if unseen == 1 then st_get(base, rp, 1 + u) else 0;
    let hi = if unseen == 1 then st_get(base, rp, 2 + u) else 0;
    let found = 0;
    while k < hi {
      let v = st_get(base, ci, 1 + k);
      let hit = (1 - tomb(base, tb, k)) * bit(fr, v);
      let found = if hit == 1 then 1 else found;
      let k = if hit == 1 then hi else k + 1;
      0
    };
    let _ = if found == 1 then setbit(vis, u) else 0;
    let _ = if found == 1 then setbit(nx, u) else 0;
    let _ = if found == 1 then (let _ = level[u] = lv in 0) else 0;
    let _ = cnt[0] = cnt[0] + found;
    let u = u + 1;
    0
  };
  0
}
// ---- B3 step 4 design item (f): bfs_frontier dispatches to the GENERATED whole-loop Beamer
// kernel (selfhost/std/gen_gb.bp's op=5 "bfs" template, the SAME push/pull/alpha=14 algorithm
// as push_step/pull_step above -- kept in this file as the reference implementation the
// template was validated against, docs/blueprints/B3-graphblas-kernels-prejit.md section 5
// step 4) instead of looping push_step/pull_step in process. Dispatch = ONE shell-compiled
// program per BFS call (never per level, never per source-loop iteration beyond one dispatch
// each): bench/vs_rust/sgraph2.sh compiles the generated _addr-variant kernel (gen_gb(dir, 5,
// 1, 0, 2, 0), fmt=2) to the fixed path "sgraph2_bfs.bin" ONCE, ahead of every phase; NOT
// gb_run.bp's own in-process gb_kernel_run/Pool machinery -- that path compiles-on-miss
// inside a forked child via the FULL linked compiler (gb_compile1.bp/bebop.bp), which
// B3c's own coordinator notes already measured as arena-constrained inside a sys_clone(17,
// ...) child (~8-12 MiB window) and unnecessary here since the kernel's SOURCE is fixed and
// known ahead of time -- a plain `seed compile` from the shell is simpler and needs no
// compiler machinery linked into sgraph2.bp at all. bfs_matrix_wrap below builds a small
// GbMatrix-shaped SCRATCH object (gb.bp's own field layout: field 0 = n, field 4 = ref rp,
// field 5 = ref ci -- the only three fields the generated kernel's gb_row_lo/gb_row_hi/
// gb_col/st_get(base,M,0) ever read) wrapping G2's OWN, ALREADY-SEALED RP/CI objects with NO
// data copy (RP/CI share gb.bp's exact "count cell at 0, elements from 1" arr_get convention
// push_step/pull_step already read raw via st_get -- verified field-for-field against
// store.bp's st_ref/st_get). PRECONDITION (matches this fn's only caller/gate,
// bench/vs_rust/sgraph2.sh's own "p"/"ph" phase, which never runs after the log/tombstone/
// compaction phases on either store, docs/blueprints/B3-graphblas-kernels-prejit.md's own
// DEVIATION paragraph): has0 == 0 (no L0 log yet) -- the generated kernel is unweighted,
// unmasked, symmetric-CSR only (gen_gb.bp's own op=5 header comment) and does not see
// tombstones or the L0 log the way push_step/pull_step above do; frontier BFS on a graph with
// a live log or tombstones needs push_step/pull_step directly, not this dispatch.
// bfs_itoa(dst, v): byte-per-cell decimal digits of v (v >= 0 -- every dispatch value here is
// a store address, a store cell offset, or a vertex index) into dst[0..], returns the digit
// count. LOCAL copy of gen_gb.bp's wr_i64 algorithm with sign handling dropped (ponytail:
// `use`-ing gen_gb.bp/gb_run.bp here pulls in their whole flat-use chain -- sha256.bp/
// store.bp/gb.bp/gen_gb.bp, ~1200 lines of template-generation code sgraph2.bp otherwise has
// zero need for -- for two ~15-line helpers).
fn bfs_itoa(dst: [i64], v: i64) -> i64 {
  let p = 19;
  let m = v;
  let go = 1;
  while go == 1 {
    let d = m - (m / 10) * 10;
    let _ = dst[p] = 48 + d;
    let p = p - 1;
    let m = m / 10;
    let go = if m > 0 then 1 else 0;
    0
  };
  let start = p + 1;
  let len = 20 - start;
  let i = 0;
  while i < len {
    let _ = dst[i] = dst[start + i];
    let i = i + 1;
    0
  };
  len
}
// bfs_pack(buf, v): tight-packed decimal string of v (8 ASCII bytes per i64 cell, little-
// endian -- the real `str` layout char()/str_len() read) into buf (>= 4 cells). LOCAL copy of
// gb_run.bp's gb_pack_tight, same ponytail rationale as bfs_itoa above.
fn bfs_pack(buf: [i64], v: i64) -> i64 {
  let digs = zeros(24);
  let n = bfs_itoa(digs, v);
  let w = 0;
  while w < n / 8 + 1 {
    let word = 0;
    let k = 0;
    while k < 8 {
      let idx = w * 8 + k;
      let b = if idx < n then digs[idx] else 0;
      let word = word | (b << (k * 8));
      let k = k + 1;
      0
    };
    let _ = buf[w] = word;
    let w = w + 1;
    0
  };
  0
}
// bfs_kernel_size(path, plen) -> nb: chunked read-to-EOF just to discover a plain file's byte
// size (no fstat/lseek builtin in this tree -- gb_run.bp's own gb_slurp_all does the same
// "read until rc==0" loop for the identical reason; LOCAL copy, ponytail as above).
fn bfs_kernel_size(path: [i64], plen: i64) -> i64 {
  let fd = sys_open(path, plen, 0);
  let chunk = zeros(8192);
  let total = 0;
  let go = 1;
  while go == 1 {
    let rc = sys_read(fd, chunk, 8192);
    let total = total + rc;
    let go = if rc > 0 then 1 else 0;
    0
  };
  let _ = sys_close(fd);
  total
}
// bfs_write_i64_file / bfs_read_i64_file: 8-byte LE64 round-trip through a scratch file -- how
// a forked child (sys_clone flags 17, no CLONE_VM: shares nothing but a 1-byte exit code)
// hands a full i64 fold back to its parent. LOCAL copy of gb_run.bp's gb_write_i64_file/
// gb_read_i64_file, ponytail as above.
fn bfs_write_i64_file(path: [i64], plen: i64, v: i64) -> i64 {
  let buf = zeros(8);
  let _ = buf[0] = v & 255;
  let _ = buf[1] = (v >> 8) & 255;
  let _ = buf[2] = (v >> 16) & 255;
  let _ = buf[3] = (v >> 24) & 255;
  let _ = buf[4] = (v >> 32) & 255;
  let _ = buf[5] = (v >> 40) & 255;
  let _ = buf[6] = (v >> 48) & 255;
  let _ = buf[7] = (v >> 56) & 255;
  let fd = sys_open(path, plen, 578);
  let _ = sys_export(fd, buf, 8);
  sys_close(fd)
}
fn bfs_read_i64_file(path: [i64], plen: i64) -> i64 {
  let fd = sys_open(path, plen, 0);
  let buf = zeros(8);
  let _ = sys_read(fd, buf, 8);
  let _ = sys_close(fd);
  buf[0] | (buf[1] << 8) | (buf[2] << 16) | (buf[3] << 24) | (buf[4] << 32) | (buf[5] << 40) | (buf[6] << 48) | (buf[7] << 56)
}
// bfs_matrix_wrap(base, g, tmp) -> M: a scratch, NEVER-committed GbMatrix-shaped object (see
// this block's header comment) bump-allocated past the store's current committed cursor
// (st_begin is a plain superblock read, st_alloc only mutates the LOCAL tx, so skipping
// st_commit leaves the store untouched -- the next st_begin anywhere, including this
// function's own next call, reads the SAME cursor and simply reuses/overwrites this space).
fn bfs_matrix_wrap(base: [i64], g: ref G2, tmp: [i64]) -> i64 {
  let tx = zeros(6);
  let _ = st_begin(base, tx, tmp);
  let M = st_alloc(base, tx, 6, 0);
  let _ = st_put(base, M, 0, st_get(base, g, 0));
  let _ = st_link(base, M, 4, st_ref(base, g, 2));
  let _ = st_link(base, M, 5, st_ref(base, g, 3));
  M
}
// bfs_kernel_child(args): pid==0 branch ONLY, ends with sys_exit (never returns). args (7
// cells): 0=data-store base addr (inherited unchanged via the fork's COW duplication -- the
// generated kernel must never st_map_ro a second time, gen_gb.bp's op=5 header has the full
// story), 1=M (the scratch GbMatrix cell offset, object-relative so valid at this SAME
// inherited address), 2=source vertex, 3=kernel image addr (ALSO inherited -- mmap'd ONCE by
// phase_frontier, not re-mapped per dispatch), 4=kernel image byte size, 5=result path addr,
// 6=result path len.
fn bfs_kernel_child(args: [i64]) -> i64 {
  let dummy0 = zeros(1);
  let a0 = zeros(4);
  let _ = bfs_pack(a0, args[0]);
  let a1 = zeros(4);
  let _ = bfs_pack(a1, args[1]);
  let a2 = zeros(4);
  let _ = bfs_pack(a2, args[2]);
  let argv = zeros(5);
  let _ = argv[0] = st_addr(dummy0);
  let _ = argv[1] = st_addr(dummy0);
  let _ = argv[2] = st_addr(a0);
  let _ = argv[3] = st_addr(a1);
  let _ = argv[4] = st_addr(a2);
  let result = sys_run(args[3], args[4], 5, argv);
  let _ = bfs_write_i64_file(st_cells(args[5]), args[6], result);
  sys_exit(0)
}
// bfs_kernel_launch(args): only args + the new `pid` binding are live across the sys_clone
// call (WORKER-CARD's <=8-live-symbols-across-a-clone rule), matching gb_run.bp's own
// gb_kernel_run_launch shape.
fn bfs_kernel_launch(args: [i64]) -> i64 {
  let pid = sys_clone(17, sys_arena_base() + 2097152);
  let _ = if pid == 0 then bfs_kernel_child(args) else 0;
  let st = zeros(1);
  let w = sys_wait4(pid, st, 0, 0);
  bfs_read_i64_file(st_cells(args[5]), args[6])
}
// bfs_kernel_dispatch(base, M, s, kaddr, nb): ONE fork+sys_run dispatch of the already-mapped
// generated kernel (kaddr/nb: mmap'd once by phase_frontier, reused for every source via fork
// inheritance) against `base`/M/s -- never re-exports, never re-mmaps, never re-compiles.
fn bfs_kernel_dispatch(base: [i64], M: i64, s: i64, kaddr: i64, nb: i64) -> i64 {
  let respath = zeros(32);
  let rn = st_str(respath, "sgraph2_bfs.res");
  let args = zeros(7);
  let _ = args[0] = st_addr(base);
  let _ = args[1] = M;
  let _ = args[2] = s;
  let _ = args[3] = kaddr;
  let _ = args[4] = nb;
  let _ = args[5] = st_addr(respath);
  let _ = args[6] = rn;
  bfs_kernel_launch(args)
}
// bfs_frontier(base, g, n, s, kaddr, nb): see this block's header comment -- builds the
// scratch GbMatrix wrapper then dispatches the generated whole-loop kernel once. Fold matches
// bfs_from/the old push_step-pull_step loop (docs/blueprints/B3-graphblas-kernels-prejit.md
// section 5 step 4(f) gate: bench/oracles/gb_bfs_gen.py / bench/oracles/sgraph2.py).
fn bfs_frontier(base: [i64], g: ref G2, n: i64, s: i64, kaddr: i64, nb: i64) -> i64 {
  let tmp = zeros(16);
  let M = bfs_matrix_wrap(base, g, tmp);
  bfs_kernel_dispatch(base, M, s, kaddr, nb)
}
fn phase_frontier(base: [i64], tmp: [i64], nsrc: i64) -> i64 {
  let g = st_root(base, tmp);
  let n = st_get(base, g, 0);
  let kpath = zeros(32);
  let kn = st_str(kpath, "sgraph2_bfs.bin");
  let nb = bfs_kernel_size(kpath, kn);
  let kfd = sys_open(kpath, kn, 0);
  let kaddr = sys_mmap(0, nb, 5, 2, kfd, 0);
  let _ = sys_close(kfd);
  let x = 31337;
  let q = 0;
  let acc = 0;
  while q < nsrc {
    let x = lcg(x);
    let acc = acc + bfs_frontier(base, g, n, (x >> 20) % n, kaddr, nb);
    let q = q + 1;
    0
  };
  acc
}
fn phase_bfs(base: [i64], tmp: [i64], nsrc: i64) -> i64 {
  let g = st_root(base, tmp);
  let n = st_get(base, g, 0);
  let level = zeros(n);
  let queue = zeros(n);
  let x = 31337;
  let q = 0;
  let acc = 0;
  while q < nsrc {
    let x = lcg(x);
    let acc = acc + bfs_from(base, g, n, (x >> 20) % n, level, queue);
    let q = q + 1;
    0
  };
  acc
}
fn parse(s: str) -> i64 {
  let n = str_len(s);
  let i = 0;
  let v = 0;
  while i < n {
    let v = v * 10 + (char(s, i) - 48);
    let i = i + 1;
    0
  };
  v
}
fn main(argc: i64, argv: [str]) -> i64 {
  let path = zeros(64);
  let skew = if char(argv[2], 1) == 104 then 1 else 0;
  let pl = if skew == 1 then st_str(path, "sgraph2h.store") else st_str(path, "sgraph2.store");
  let tmp = zeros(256);
  let size = 536870912;
  let ph = char(argv[2], 0);
  let want_t = if char(argv[3], 0) == 116 then 1 else 0;
  let nsrc = if argc >= 5 then parse(argv[4]) else 3;
  let b0 = if argc >= 5 then parse(argv[4]) else 0;
  let nb = if argc >= 6 then parse(argv[5]) else 10;
  let cap0 = if argc >= 7 then parse(argv[6]) else 0;
  let fl0 = if argc >= 8 then parse(argv[7]) else 0;
  let d = zeros(8);
  let _ = d[0] = st_digest("RP{arr i64}");
  let _ = d[1] = st_digest("CI{arr i64}");
  let _ = d[2] = st_digest("G2{i64,i64,ref RP,ref CI,ref LOG,ref RP,ref CI,ref TB,i64,ref TH}");
  let _ = d[3] = st_digest("LOG{arr ref E}");
  let _ = d[4] = st_digest("TB{arr i64}");
  let _ = d[5] = st_digest("E{arr i64}");
  let _ = d[6] = st_digest("TH{arr ref TG}");
  let _ = d[7] = st_digest("TG{arr i64}");
  let stall = zeros(1);
  let lay = zeros(16);
  let _ = lay[0] = d[0];
  let _ = lay[2] = d[1];
  let _ = lay[4] = d[2];
  let _ = lay[5] = 764;
  let _ = lay[6] = d[3];
  let _ = lay[7] = 0 - 1;
  let _ = lay[8] = d[4];
  let _ = lay[10] = d[5];
  let _ = lay[12] = d[6];
  let _ = lay[13] = 0 - 1;
  let _ = lay[14] = d[7];
  let t0 = clock_ms();
  let live = if ph == 99 then st_compact(path, pl, size, lay, 8, tmp) else 0;
  let base = st_open(path, pl, size, tmp);
  let t1 = clock_ms();
  let r = if ph == 98 then phase_build(base, tmp, d, skew) else if ph == 108 then phase_log(base, tmp, d, b0, nb, stall, cap0, fl0) else if ph == 110 then phase_nbr(base, tmp) else if ph == 100 then phase_del(base, tmp, d) else if ph == 102 then phase_bfs(base, tmp, nsrc) else if ph == 112 then phase_frontier(base, tmp, nsrc) else if ph == 97 then phase_tail(base, tmp, d, nsrc) else if ph == 103 then phase_flush(base, tmp, d) else 0;
  let t2 = clock_ms();
  let g = st_root(base, tmp);
  let used = st_gen(base, tmp) * 0 + base[st_pick(base, tmp) + 4] * 8;
  let e1 = st_get(base, g, 1);
  let _ = sys_munmap(st_addr(base), size);
  let ms = if ph == 99 then t1 - t0 else t2 - t1;
  let val = if ph == 108 then (ms * 1000000 / (nb * 10000)) * 1000 + stall[0] else if ph == 102 then ms * 1000000 / ((e1 + 1000000) * nsrc) else if ph == 112 then ms * 1000000 / (e1 * nsrc) else if ph == 110 then ms * 1000000 / 100000 else ms;
  if ph == 122 then used else if ph == 109 then stall[0] else if ph == 99 then (if want_t == 1 then ms else live) else if want_t == 1 then val else r
}
