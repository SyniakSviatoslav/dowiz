// selfhost/std/set.bp — set operations over sorted, deduplicated i64 arrays.
// A "set" is a sorted [i64] of distinct values; n is its length.

module core { }

// is_member: 1 if x occurs in sorted arr[0..n), else 0.
fn is_member(arr: [i64], n: i64, x: i64) -> i64 {
  let lo = 0;
  let hi = n - 1;
  let found = 0;
  let done = if lo > hi then 1 else 0;
  while done == 0 {
    let mid = (lo + hi) / 2;
    let v = arr[mid];
    let eq = if v == x then 1 else 0;
    let lt = if v < x then 1 else 0;
    let lo = if eq == 1 then lo else (if lt == 1 then mid + 1 else lo);
    let hi = if eq == 1 then hi else (if lt == 1 then hi else mid - 1);
    let found = if eq == 1 then 1 else found;
    let done = if eq == 1 then 1 else (if lo > hi then 1 else 0);
    0
  };
  found
}

// union_size: number of distinct elements in a ∪ b.
fn union_size(a: [i64], na: i64, b: [i64], nb: i64) -> i64 {
  let i = 0;
  let j = 0;
  let count = 0;
  let ia = if i >= na then 1 else 0;
  let jb = if j >= nb then 1 else 0;
  let done = if (ia * jb) == 1 then 1 else 0;
  while done == 0 {
    let both = if (ia + jb) == 0 then 1 else 0;
    let lt = if both == 1 then (if a[i] < b[j] then 1 else 0) else 0;
    let gt = if both == 1 then (if a[i] > b[j] then 1 else 0) else 0;
    let eq = if both == 1 then (if lt == 0 then (if gt == 0 then 1 else 0) else 0) else 0;
    let adv_i = if jb == 1 then 1 else (if lt == 1 then 1 else (if eq == 1 then 1 else 0));
    let adv_j = if ia == 1 then 1 else (if gt == 1 then 1 else (if eq == 1 then 1 else 0));
    let i = if adv_i == 1 then i + 1 else i;
    let j = if adv_j == 1 then j + 1 else j;
    let count = count + 1;
    let ia = if i >= na then 1 else 0;
    let jb = if j >= nb then 1 else 0;
    let done = if (ia * jb) == 1 then 1 else 0;
    0
  };
  count
}

// intersection_size: number of distinct elements in a ∩ b.
fn intersection_size(a: [i64], na: i64, b: [i64], nb: i64) -> i64 {
  let i = 0;
  let j = 0;
  let count = 0;
  let ia = if i >= na then 1 else 0;
  let jb = if j >= nb then 1 else 0;
  let done = if (ia + jb) > 0 then 1 else 0;
  while done == 0 {
    let lt = if a[i] < b[j] then 1 else 0;
    let gt = if a[i] > b[j] then 1 else 0;
    let eq = if lt == 0 then (if gt == 0 then 1 else 0) else 0;
    let i = if lt == 1 then i + 1 else (if eq == 1 then i + 1 else i);
    let j = if gt == 1 then j + 1 else (if eq == 1 then j + 1 else j);
    let count = if eq == 1 then count + 1 else count;
    let ia = if i >= na then 1 else 0;
    let jb = if j >= nb then 1 else 0;
    let done = if (ia + jb) > 0 then 1 else 0;
    0
  };
  count
}

// is_subset: 1 if every element of a occurs in b (a ⊆ b), else 0.
fn is_subset(a: [i64], na: i64, b: [i64], nb: i64) -> i64 {
  let i = 0;
  let j = 0;
  let fail = 0;
  let ia = if i >= na then 1 else 0;
  let jb = if j >= nb then 1 else 0;
  let done = if ia == 1 then 1 else (if jb == 1 then 1 else 0);
  while done == 0 {
    let lt = if a[i] < b[j] then 1 else 0;
    let gt = if a[i] > b[j] then 1 else 0;
    let eq = if lt == 0 then (if gt == 0 then 1 else 0) else 0;
    let fail = if lt == 1 then 1 else fail;
    let i = if eq == 1 then i + 1 else (if lt == 1 then i + 1 else i);
    let j = if gt == 1 then j + 1 else (if eq == 1 then j + 1 else j);
    let ia = if i >= na then 1 else 0;
    let jb = if j >= nb then 1 else 0;
    let done = if fail == 1 then 1 else (if ia == 1 then 1 else (if jb == 1 then 1 else 0));
    0
  };
  if fail == 1 then 0 else (if ia == 1 then 1 else 0)
}
