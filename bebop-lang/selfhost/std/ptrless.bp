module core { }

// ptrless.bp — T12: .becache-as-the-only-pointer. States are addressed
// by their content digest (FNV-64 over the state cells) — there are no
// pointers or indices, the digest IS the reference; materialization
// verifies the fold, and a corrupted key must NOT resolve (the breaker:
// a loud mismatch, not a silent wrong read). Fold = digest mod 10^11 +
// verify*10^11 + corrupt_detected*10^12 (python mirror, journal at gate
// time).

fn fnv4(st: [i64]) -> i64 {
  let h = [14695981039346656037];
  let i = 0;
  while i < 4 {
    let v = st[i];
    let sh = 0;
    while sh < 8 {
      let byte = (v >> (sh * 8)) & 255;
      let _ = h[0] = (h[0] ^ byte) * 1099511628211;
      let sh = sh + 1;
      0
    };
    let i = i + 1;
    0
  };
  h[0]
}

fn main() -> i64 {
  let s0 = zeros(4);
  let s1 = zeros(4);
  let s2 = zeros(4);
  let _ = s0[0] = 1;
  let _ = s0[1] = 2;
  let _ = s0[2] = 3;
  let _ = s0[3] = 4;
  let _ = s1[0] = 2;
  let _ = s1[1] = 3;
  let _ = s1[2] = 4;
  let _ = s1[3] = 5;
  let _ = s2[0] = 3;
  let _ = s2[1] = 4;
  let _ = s2[2] = 5;
  let _ = s2[3] = 6;
  let d0 = fnv4(s0);
  let d1 = fnv4(s1);
  let d2 = fnv4(s2);
  // resolve the state whose digest == d1 (the "pointer" is d1)
  let tgt = zeros(4);
  let is0 = if d0 == d1 then 1 else 0;
  let is1 = if d1 == d1 then 1 else 0;
  let is2 = if d2 == d1 then 1 else 0;
  let k = 0;
  while k < 4 {
    let _ = tgt[k] = is0 * s0[k] + is1 * s1[k] + is2 * s2[k];
    let k = k + 1;
    0
  };
  let vd = fnv4(tgt);
  let verify = if vd == d1 then 1 else 0;
  // corrupted key: d1 + 1 must NOT resolve
  let ck = d1 + 1;
  let bad = [1];
  let _ = if d0 == ck then (let _ = bad[0] = 0 in 0) else 0;
  let _ = if d1 == ck then (let _ = bad[0] = 0 in 0) else 0;
  let _ = if d2 == ck then (let _ = bad[0] = 0 in 0) else 0;
  let r = d1 - (d1 / 100000000000) * 100000000000;
  let dl = r + (if r < 0 then 100000000000 else 0);
  dl + verify * 100000000000 + bad[0] * 1000000000000
}
