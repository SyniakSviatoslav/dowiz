// proof.bp — Proof terms and validation for QTT kernel.
// Implements proof term representation, validation, and checking.

module core { }

// ============================================================
// Proof terms
// ============================================================

// Proof term codes:
// 0 = Refl (equality proof by conversion)
// 1 = Lambda (lambda abstraction proof)
// 2 = Application (proof application)
// 3 = Let (let-binding proof)
// 4 = Const (named theorem reference)
// 5 = Induction (induction proof)
// 6 = Pair (conjunction proof)
// 7 = ProjL / ProjR (projections)

// Proof term structure: [code, field1, field2, ...]

fn pr_refl(t1: [i64], t2: [i64]) -> [i64] {
  let r = zeros(3);
  let _ = r[0] = 0;
  let _ = r[1] = t1;
  let _ = r[2] = t2;
  r
}

fn pr_lam(dom: [i64], body: [i64]) -> [i64] {
  let r = zeros(3);
  let _ = r[0] = 1;
  let _ = r[1] = dom;
  let _ = r[2] = body;
  r
}

fn pr_app(fn: [i64], arg: [i64]) -> [i64] {
  let r = zeros(3);
  let _ = r[0] = 2;
  let _ = r[1] = fn;
  let _ = r[2] = arg;
  r
}

fn pr_let(ty: [i64], val: [i64], body: [i64]) -> [i64] {
  let r = zeros(4);
  let _ = r[0] = 3;
  let _ = r[1] = ty;
  let _ = r[2] = val;
  let _ = r[3] = body;
  r
}

fn pr_const(name: i64) -> [i64] {
  let r = zeros(2);
  let _ = r[0] = 4;
  let _ = r[1] = name;
  r
}

fn pr_ind(hz: [i64], hs: [i64]) -> [i64] {
  let r = zeros(3);
  let _ = r[0] = 5;
  let _ = r[1] = hz;
  let _ = r[2] = hs;
  r
}

fn pr_pair(p1: [i64], p2: [i64]) -> [i64] {
  let r = zeros(3);
  let _ = r[0] = 6;
  let _ = r[1] = p1;
  let _ = r[2] = p2;
  r
}

fn pr_fst(p: [i64]) -> [i64] {
  let r = zeros(2);
  let _ = r[0] = 7;
  let _ = r[1] = p;
  r
}

fn pr_snd(p: [i64]) -> [i64] {
  let r = zeros(2);
  let _ = r[0] = 8;
  let _ = r[1] = p;
  r
}

// Proof term accessors
fn pf_code(p: [i64]) -> i64 { p[0] }
fn pf_fst(p: [i64]) -> i64 { p[1] }
fn pf_snd(p: [i64]) -> i64 { p[2] }
fn pf_thd(p: [i64]) -> i64 { p[3] }

// ============================================================
// Proof checking
// ============================================================

// check_proof(p, expected_type, ctx) -> i64 (1 = valid, 0 = invalid)
fn check_proof(p: [i64], ty: [i64], ctx: [i64]) -> i64 {
  let code = pf_code(p);
  if code == 0 then { // Refl
    let t1 = pf_fst(p);
    let t2 = pf_snd(p);
    // Check both sides have same type and are convertible
    let eq = check_refl(t1, t2);
    let ty1 = infer_type(t1, ctx_empty());
    let ty2 = infer_type(t2, ctx_empty());
    let eq_ty = convert(ty, infer_type(t1, ctx_empty()), ctx_empty());
    eq
  } else if code == 1 then { // Lambda
    let dom = pf_fst(p);
    let body = pf_snd(p);
    // Check body type matches codomain
    let body_ty = infer_type(pf_snd(p), ctx_extend(ctx_empty(), 0, pf_fst(p)));
    convert(pf_snd(p), tm_snd(ty), ctx_empty())
  } else if code == 2 then { // Application
    let fn = pf_fst(p);
    let arg = pf_snd(p);
    let fn_ty = infer_type(fn, ctx_empty());
    // Check fn is Pi type and arg matches domain
    let fn_code = tm_code(fn_ty);
    if tm_code(fn_ty) == 3 then { // Pi
      let dom = tm_fst(fn_ty);
      if check_proof(arg, dom, ctx_empty()) == 1 then 1 else 0
    } else {
      0
    }
  } else {
    0
  }
}

// ============================================================
// Theorem statement checking
// ============================================================

fn check_theorem(stmt: [i64], proof: [i64]) -> i64 {
  // Theorem statement should be a type (proposition = Type 0)
  let stmt_ty = infer_type(stmt, ctx_empty());
  if tm_code(stmt_ty) != 6 || tm_fst(stmt_ty) != 0 then 0 else {
    // Proof should type-check as the theorem statement
    check_proof(proof, stmt, ctx_empty())
  }
}

// ============================================================
// Refl checking (β+δ equality)
// ============================================================

fn check_refl(t1: [i64], t2: [i64]) -> i64 {
  convert(t1, t2, ctx_empty())
}

// ============================================================
// Built-in tactic: reflexivity
// ============================================================

fn tactic_refl(t1: [i64], t2: [i64]) -> i64 {
  check_refl(t1, t2)
}

// Built-in tactic: assumption
fn tactic_assumption(goal: [i64], ctx: [i64]) -> i64 {
  // Search context for matching hypothesis
  let len = ctx[0];
  let i = 1;
  let found = 0;
  while i <= len {
    let h = ctx[i * 2 - 1];
    let h_ty = ctx[i * 2];
    if convert(goal, h_ty, ctx_empty()) == 1 then 1 else 0;
    let i = i + 1;
    0
  };
  0
}

// Built-in tactic: apply
fn tactic_apply(goal: [i64], lemma: [i64], args: [i64], ctx: [i64]) -> i64 {
  // Apply lemma to arguments to prove goal
  // Simplified: just check if lemma type matches goal after applying args
  0
}

// ============================================================
// Tactics for induction
// ============================================================

fn tactic_induction(n: [i64], base: [i64], step: [i64]) -> [i64] {
  // Returns induction proof term
  pr_ind(base, step)
}

// ============================================================
// Proof normalization (for proof irrelevance)
// ============================================================

fn normalize_proof(p: [i64]) -> [i64] {
  let code = pf_code(p);
  if code == 1 then { // Lambda
    pr_lam(pf_fst(p), normalize_proof(pf_snd(p)))
  } else if code == 2 then { // App
    pr_app(normalize_proof(pf_fst(p)), normalize_proof(pf_snd(p)))
  } else if code == 3 then { // Let
    pr_let(pf_fst(p), normalize_proof(pf_snd(p)), normalize_proof(pf_thd(p)))
  } else if code == 2 then { // App
    pr_app(normalize_proof(pf_fst(p)), normalize_proof(pf_snd(p)))
  } else {
    p
  }
}

// Proof irrelevance: two proofs of same proposition are equal
fn proof_irrel(p1: [i64], p2: [i64]) -> i64 {
  1  // In QTT, all proofs of same proposition are definitionally equal
}