// selfhost/std/gb_run.bp -- B3 step 4 (docs/blueprints/B3-graphblas-kernels-prejit.md section 3
// "Pool"/"Kernel", section 5 step 4): the Pool/Kernel objects (their OWN store file, own root --
// a Pool object IS the root, no wrapper) + tier dispatch (digest lookup, kernel run via a
// file-backed executable mapping). Library only (no main); flat `use` convention (T47b) --
// every direct user of this file must also directly `use` sha256.bp, store.bp, gb.bp and
// gen_gb.bp (gen_gb.bp's wr_str/wr_i64 build the digest key text; gb.bp's arr_* accessors hold
// the Kernel's raw .bin bytes the same "arr i64" way rp/ci/vv do).
//
// Kernel {digest, op, sr, mask, fmt, tr, ref words, entry, gen, compiler_digest} -- 10 fields.
//   digest = sha256_lo64 of "gbk:<op>,<sr>,<mask>,<fmt>,<tr>" (compiler_digest is NOT folded
//   into the key -- deliberately: gb_pool_abi's probe forges compiler_digest ALONE on an
//   otherwise-valid Kernel and must still get a digest HIT + a compiler_digest MISMATCH, two
//   independently observable outcomes, not one hash collapsing them).
//   words = a GbArr-convention byte buffer (field 0 = nb, fields 1.. = one BYTE VALUE per
//   cell -- the sys_open/sys_export/pack_bytes convention used throughout the tree) holding
//   the FULL compiled .bin image: code words + literal cells + the LE64 entry footer, exactly
//   the bytes cli_compile (bebop.bp:5933) writes to a file and exactly what sys_run expects
//   mapped PROT_READ|EXEC (A11(b) standalone builtin).
//   entry = the byte offset of the entry stub (= n0*4, the same value the footer's LE64
//   encodes -- kept as a field too so a caller never needs to re-derive it from the mapping).
// Pool {count, ref kernels[CAP]} -- root-reachable: the Pool object's OWN offset IS the
// store's root (gb_pool_fresh/_append return it; the caller st_commits it directly, no
// wrapper object). CAP = 48 (gb_pool_cap()) is a fixed ceiling per Pool GENERATION -- a store
// commit never grows an existing Pool object in place: gb_pool_append allocates a FRESH Pool
// of the same cap, copies the live kernel refs, links the new one in, seals; the caller
// commits root = that new object. append/rebuild-on-miss never touches an already-sealed
// Kernel or Pool object, matching the store's append-only, root-swap discipline (B5 single-
// writer rule: only the process/child holding the pool file open RW ever calls
// gb_pool_append + st_commit; every reader maps it RO or shares the SAME RW mapping and only
// reads).
struct Kernel { n: i64 }
struct Pool { n: i64 }

fn gb_pool_cap() -> i64 { 48 }
fn gb_kernel_digest(base: [i64], K: i64) -> i64 { st_get(base, K, 0) }
fn gb_kernel_cmd(base: [i64], K: i64) -> i64 { st_get(base, K, 9) }
fn gb_kernel_entry(base: [i64], K: i64) -> i64 { st_get(base, K, 7) }
fn gb_kernel_words(base: [i64], K: i64) -> ref GbArr { st_ref(base, K, 6) }

// gb_pool_key(buf, op, sr, mask, fmt, tr) -> digest: buf is a caller-owned scratch byte
// buffer (>= 64 cells), wr_str/wr_i64 (selfhost/std/gen_gb.bp) build the text, sha256_lo64
// (selfhost/prelude/sha256.bp) hashes it -- the SAME primitive st_digest itself uses
// (store.bp:262), just over a runtime-built string instead of a compile-time literal: st_digest
// only ever accepts literals in this tree (grep-verified, 2026-09-07) and no `str` cast exists
// from a `[i64]` cell buffer (tools/typecheck.py's CASTS allowlist has none), so this goes
// around sha256_lo64 directly instead.
fn gb_pool_key(buf: [i64], op: i64, sr: i64, mask: i64, fmt: i64, tr: i64) -> i64 {
  let pos = zeros(1);
  let _ = wr_str(buf, pos, "gbk:");
  let _ = wr_i64(buf, pos, op);
  let _ = wr_str(buf, pos, ",");
  let _ = wr_i64(buf, pos, sr);
  let _ = wr_str(buf, pos, ",");
  let _ = wr_i64(buf, pos, mask);
  let _ = wr_str(buf, pos, ",");
  let _ = wr_i64(buf, pos, fmt);
  let _ = wr_str(buf, pos, ",");
  let _ = wr_i64(buf, pos, tr);
  sha256_lo64(buf, pos[0])
}

// gb_pool_open_rw / _ro: the pool's OWN store file, 4 MiB (plenty for 48 small kernels).
fn gb_pool_open_rw(path: [i64], plen: i64, tmp: [i64]) -> [i64] { st_open(path, plen, 4194304, tmp) }
fn gb_pool_open_ro(path: [i64], plen: i64) -> [i64] { st_map_ro(path, plen, 4194304) }

// gb_pool_fresh(base, tx, tmp): allocate+seal an EMPTY Pool object (count 0), return its
// offset -- caller commits root = this offset (a fresh/first-ever pool file).
fn gb_pool_fresh(base: [i64], tx: [i64], tmp: [i64]) -> i64 {
  let cap = gb_pool_cap();
  let P = st_alloc(base, tx, 1 + cap, st_digest("Pool{i64,ref Kernel[48]}"));
  let _ = st_put(base, P, 0, 0);
  let _ = st_seal(base, P, tmp);
  P
}
fn gb_pool_count(base: [i64], P: i64) -> i64 { st_get(base, P, 0) }
fn gb_pool_kernel(base: [i64], P: i64, i: i64) -> i64 { st_ref(base, P, 1 + i) }

// gb_pool_lookup(base, P, key, cmd) -> ref Kernel | 0: linear scan (<= 48 entries -- a hash
// table is not worth it at this N). A HIT needs digest AND compiler_digest to both match --
// an ABI-mismatched Kernel (gb_pool_abi's forged-field probe, or a genuine recompiled
// compiler) is treated exactly like a miss, driving the SAME rebuild path.
fn gb_pool_lookup(base: [i64], P: i64, key: i64, cmd: i64) -> i64 {
  let cnt = gb_pool_count(base, P);
  let i = 0;
  let found = 0;
  while i < cnt {
    let K = gb_pool_kernel(base, P, i);
    let hit = (if st_get(base, K, 0) == key then 1 else 0) * (if st_get(base, K, 9) == cmd then 1 else 0);
    let found = if hit == 1 then K else found;
    let i = i + 1;
    0
  };
  found
}

// gb_pool_append(base, tx, tmp, P, key, op, sr, mask, fmt, tr, cmd, wordsArr, entry) -> new
// Pool offset (a FRESH object, count+1 -- see the header comment). Caller commits
// root = the returned offset. Exit 89 (capacity) if the pool is already at gb_pool_cap().
fn gb_pool_append(base: [i64], tx: [i64], tmp: [i64], P: i64, key: i64, op: i64, sr: i64, mask: i64, fmt: i64, tr: i64, cmd: i64, wordsArr: ref GbArr, entry: i64) -> i64 {
  let cap = gb_pool_cap();
  let cnt = gb_pool_count(base, P);
  let _ = if cnt >= cap then sys_exit(89) else 0;
  let K = st_alloc(base, tx, 10, st_digest("Kernel{i64,i64,i64,i64,i64,i64,ref GbKW,i64,i64,i64}"));
  let _ = st_put(base, K, 0, key);
  let _ = st_put(base, K, 1, op);
  let _ = st_put(base, K, 2, sr);
  let _ = st_put(base, K, 3, mask);
  let _ = st_put(base, K, 4, fmt);
  let _ = st_put(base, K, 5, tr);
  let _ = st_link(base, K, 6, wordsArr);
  let _ = st_put(base, K, 7, entry);
  let _ = st_put(base, K, 8, 0);
  let _ = st_put(base, K, 9, cmd);
  let _ = st_seal(base, K, tmp);
  let P2 = st_alloc(base, tx, 1 + cap, st_digest("Pool{i64,ref Kernel[48]}"));
  let _ = st_put(base, P2, 0, cnt + 1);
  let i = 0;
  while i < cnt {
    let _ = st_link(base, P2, 1 + i, gb_pool_kernel(base, P, i));
    let i = i + 1;
    0
  };
  let _ = st_link(base, P2, 1 + cnt, K);
  let _ = st_seal(base, P2, tmp);
  P2
}

// ---- compiler identity: digest of the compiler binary's own bytes (a sha256_lo64 digest,
// NOT literal md5 -- no md5 implementation exists in this tree; sha256_lo64 is the store's own
// digest primitive, reused here rather than adding one -- deviation recorded in the B3 step 4
// report). gb_slurp_all mirrors bebop.bp's cache_hit/cache_write chunked-read loop
// (bebop.bp:5492/5521) but ACCUMULATES into one buffer instead of comparing/streaming, since
// sha256_words needs the whole message contiguous.
fn gb_slurp_all(fd: i64, big: [i64], cap: i64) -> i64 {
  let chunk = zeros(8192);
  let total = 0;
  let go = 1;
  while go == 1 {
    let rc = sys_read(fd, chunk, 8192);
    let j = 0;
    while j < rc {
      let _ = big[total + j] = chunk[j];
      let j = j + 1;
      0
    };
    let total = total + rc;
    let go = if rc > 0 then 1 else 0;
    0
  };
  total
}

// gb_kernel_export(base, K, path, plen): write the Kernel's raw .bin bytes to `path` (a
// caller-owned scratch file under $OUT/$BEBOP_TMP -- never inside a store file). Only ever
// needed once per digest (gb_kernel_run below probes existence first) -- ponytail: no live
// process-address cache table, a fresh sys_open+sys_mmap per call is well under the 0.1ms
// pool-hit target at this kernel count (measured, RESULT-gbpool.md); add a cached-address
// table if a workload calls the SAME kernel enough times in one process for mmap's own
// syscall cost to matter.
fn gb_kernel_export(base: [i64], K: i64, path: [i64], plen: i64) -> i64 {
  let W = gb_kernel_words(base, K);
  let nb = arr_n(base, W);
  let buf = zeros(nb);
  let i = 0;
  while i < nb {
    let _ = buf[i] = arr_get(base, W, i);
    let i = i + 1;
    0
  };
  let fd = sys_open(path, plen, 578);
  let _ = sys_export(fd, buf, nb);
  sys_close(fd)
}
// gb_kernel_cache_path(dir, kdigest, path) -> plen: "<dir>/k<digest>.bin".
fn gb_kernel_cache_path(dir: str, kdigest: i64, path: [i64]) -> i64 {
  let pos = zeros(1);
  let _ = wr_str(path, pos, dir);
  let _ = wr_str(path, pos, "/k");
  let _ = wr_i64(path, pos, kdigest);
  let _ = wr_str(path, pos, ".bin");
  pos[0]
}
// gb_write_i64_file / gb_read_i64_file: an 8-byte LE64 round-trip through a scratch file --
// how a forked child hands a full i64 result back to its parent (a real fork, sys_clone flags
// 17 -- SIGCHLD only, no CLONE_VM -- shares NOTHING but the exit code with its parent, and the
// exit code is one byte; a fold like 489626275115 does not fit in it).
fn gb_write_i64_file(path: [i64], plen: i64, v: i64) -> i64 {
  let buf = zeros(8);
  let _ = buf[0] = v & 255;
  let _ = buf[1] = (v >> 8) & 255;
  let _ = buf[2] = (v >> 16) & 255;
  let _ = buf[3] = (v >> 24) & 255;
  let _ = buf[4] = (v >> 32) & 255;
  let _ = buf[5] = (v >> 40) & 255;
  let _ = buf[6] = (v >> 48) & 255;
  let _ = buf[7] = (v >> 56) & 255;
  let fd = sys_open(path, plen, 578);
  let _ = sys_export(fd, buf, 8);
  sys_close(fd)
}
fn gb_read_i64_file(path: [i64], plen: i64) -> i64 {
  let fd = sys_open(path, plen, 0);
  let buf = zeros(8);
  let _ = sys_read(fd, buf, 8);
  let _ = sys_close(fd);
  buf[0] | (buf[1] << 8) | (buf[2] << 16) | (buf[3] << 24) | (buf[4] << 32) | (buf[5] << 40) | (buf[6] << 48) | (buf[7] << 56)
}
fn addr_of(a: [i64]) -> i64 { a }
// ==== ROADMAP C1 step 1, the mapping fence (docs/blueprints/C1-checked-kernel-dialect.md
// §3(v), 2026-09-08). A kernel is dispatched by a REAL fork -- sys_clone(17, ...) is SIGCHLD
// alone, no CLONE_VM -- and a fork keeps MAP_SHARED mappings shared. st_open maps the store
// prot=3 flags=1 (selfhost/prelude/store.bp:146), so a dispatching process that holds a
// WRITER's mapping hands the forked kernel write access to the store file. The parent form
// was chosen over the child form (the blueprint's own "prefer the parent form"): two
// syscalls against a 1.04 ms fork floor, and nothing to reason about in the child's window
// between clone and sys_run.
// Both calls are unconditional and neither branches on the mapping's mode, because both
// modes come out right: on a WRITER's mapping the drop to PROT_READ succeeds and the restore
// to PROT_READ|PROT_WRITE succeeds (the fd was opened O_RDWR, so the vma keeps VM_MAYWRITE);
// on a READER's mapping (st_map_ro, prot=1, fd opened O_RDONLY) the drop is a no-op and the
// restore returns -EACCES because MAP_SHARED of an O_RDONLY fd carries no VM_MAYWRITE -- the
// mapping is left exactly as it was found, which is the right outcome for a reader. Measured
// on this box, both rows, by bench/parity_constructs/c110_fence.bp.
// addr == 0 means "the caller has no store mapping to fence" and costs no syscall at all.
fn gb_fence_ro(addr: i64, len: i64) -> i64 { if addr == 0 then 0 else sys_mprotect(addr, len, 1) }
fn gb_fence_rw(addr: i64, len: i64) -> i64 { if addr == 0 then 0 else sys_mprotect(addr, len, 3) }
// gb_pack_tight(dst, src, n): repack a BYTE-PER-CELL buffer (n cells, each holding one 0..255
// value -- wr_str/wr_i64's own convention, sys_open/sys_export's convention) into a REAL
// packed-byte buffer (8 ASCII bytes little-endian per i64 cell) at dst -- the layout a `str`
// actually is (docs/LANGUAGE.md: "no strings beyond literals"; bebop.bp:1453 str_len is a
// raw-byte NUL-scan; bebop.bp:3172 a literal's bytes ride the data section as real packed
// bytes). B3 step 4 bug (coordinator, 2026-09-07, found by re-deriving from first principles
// after probe19-23 in $OUT): gb_kernel_run_child used to hand the generated kernel's
// gb_atoi(argv[2]) a wr_i64-built (byte-per-cell) buffer directly -- char()/str_len() read it
// as raw bytes, saw a NUL in the high 7 (always-zero) bytes of cell 0, and returned a
// length-1 string, so gb_atoi silently mis-parsed the mmap'd store address (verified: a
// standalone repro of "sys_run a program that gb_atoi's a byte-per-cell argv string" returns
// 1 instead of the real value; the same repro with THIS tight packing returns the correct
// value -- $OUT/probe20-23). dst must have >= n/8+1 cells.
fn gb_pack_tight(dst: [i64], src: [i64], n: i64) -> i64 {
  let w = [0];
  let nwords = n / 8 + 1;
  while w[0] < nwords {
    let word = [0];
    let k = [0];
    while k[0] < 8 {
      let idx = w[0] * 8 + k[0];
      let b = if idx < n then src[idx] else 0;
      let _ = word[0] = word[0] | (b << (k[0] * 8));
      let _ = k[0] = k[0] + 1;
      0
    };
    let _ = dst[w[0]] = word[0];
    let _ = w[0] = w[0] + 1;
    0
  };
  0
}
// gb_kernel_run_child: runs ONLY in the pid==0 branch, ends with sys_exit (never returns).
// Entering another compiled image's entry stub reconfigures the caller's own arena/signal-
// stack registers (bebop.bp's entry_stub comment, ~line 5800: "the kernel sigaction... are
// built in the ARENA at x27... x27 advances") -- unsafe to do in a process that must keep
// running afterward, so (matching c84_run.bp's own precedent) this ALWAYS happens inside a
// real fork (sys_clone(17, ...)) that exits immediately after using the one return value.
// The data store is mmap'd HERE (a NORMAL, non-sys_run'd mmap -- proven to work) and its
// address handed to the kernel as a DECIMAL argv string (gb_atoi'd by the generated kernel's
// own gen_kernel_body_addr template, gen_gb.bp) -- a SECOND file-backed mmap+dereference
// issued from CODE ENTERED VIA sys_run segfaults reproducibly (probed 2026-09-07,
// $OUT/repro_1.bp), so the kernel itself must never call st_map_ro.
fn gb_kernel_run_child(path: [i64], plen: i64, nb: i64, dpath: [i64], dplen: i64, respath: [i64], replen: i64) -> i64 {
  let fd = sys_open(path, plen, 0);
  let addr = sys_mmap(0, nb, 5, 2, fd, 0);
  let dfd = sys_open(dpath, dplen, 0);
  let daddr = sys_mmap(0, 4194304, 1, 1, dfd, 0);
  let _ = sys_close(dfd);
  let addrbuf = zeros(32);
  let apos = zeros(1);
  let _ = wr_i64(addrbuf, apos, daddr);
  let addrtight = zeros(4);
  let _ = gb_pack_tight(addrtight, addrbuf, apos[0]);
  let dummy0 = zeros(1);
  let argv2 = zeros(3);
  let _ = argv2[0] = addr_of(dummy0);
  let _ = argv2[1] = addr_of(dummy0);
  let _ = argv2[2] = addr_of(addrtight);
  let result = sys_run(addr, nb, 3, argv2);
  let _ = gb_write_i64_file(respath, replen, result);
  sys_exit(0)
}
// gb_kernel_run(base, K, dir, path, respath, replen, dpath, dplen): export-if-missing + fork +
// mmap PROT_READ|EXEC MAP_PRIVATE (the c84_run.bp precedent, docs/blueprints/A11-harness-
// dogfooding.md) + sys_run in the child, result handed back via respath. `path`/`respath`:
// caller-owned scratch cell buffers (>= 300 cells each, distinct files). `dpath`/`dplen`: the
// data store's path cells (the child mmaps it itself, see gb_kernel_run_child).
// gb_kernel_run: the parent-side prep (export-if-missing, resolve nb) runs BEFORE the clone;
// everything the child needs is packed into ONE cell array (`args`) first so only `args` + the
// new `pid` binding are live across the sys_clone call (WORKER-CARD: "a fn spanning clone keeps
// <= 8 live symbols" -- the previous shape passed path/plen/nb/dpath/dplen/respath/replen as 7
// separate live locals across the boundary; folding them into one array is the same fix
// pool_compile.bp/par_compile already uses for its own clone). st_cells is store.bp's own
// i64<->[i64] cast, reused rather than adding a new one (typecheck's CASTS allowlist).
fn gb_kernel_run(base: [i64], K: i64, dir: str, path: [i64], respath: [i64], replen: i64, dpath: [i64], dplen: i64) -> i64 {
  let kdigest = gb_kernel_digest(base, K);
  let plen = gb_kernel_cache_path(dir, kdigest, path);
  let probe = sys_open(path, plen, 0);
  let exists = if probe >= 0 then 1 else 0;
  let _ = if exists == 1 then sys_close(probe) else 0;
  let _ = if exists == 0 then gb_kernel_export(base, K, path, plen) else 0;
  let W = gb_kernel_words(base, K);
  let nb = arr_n(base, W);
  let args = zeros(9);
  let _ = args[0] = addr_of(path);
  let _ = args[1] = plen;
  let _ = args[2] = nb;
  let _ = args[3] = addr_of(dpath);
  let _ = args[4] = dplen;
  let _ = args[5] = addr_of(respath);
  let _ = args[6] = replen;
  // C1 step 1: cells 7/8 are the fence's operands -- this parent's own store mapping and
  // the size gb_pool_open_rw/gb_pool_open_ro both map. `base` is that mapping.
  let _ = args[7] = addr_of(base);
  let _ = args[8] = 4194304;
  gb_kernel_run_launch(args)
}
fn gb_kernel_run_launch(args: [i64]) -> i64 {
  let _ = gb_fence_ro(args[7], args[8]);
  let pid = sys_clone(17, sys_arena_base() + 16777216);
  let _ = if pid == 0 then gb_kernel_run_child(st_cells(args[0]), args[1], args[2], st_cells(args[3]), args[4], st_cells(args[5]), args[6]) else 0;
  let st = zeros(1);
  let w = sys_wait4(pid, st, 0, 0);
  let _ = gb_fence_rw(args[7], args[8]);
  gb_read_i64_file(st_cells(args[5]), args[6])
}

// ==== B3 step 4 coordinator tightened pass (2026-09-07, item (c)/(2)): background compile
// on miss + a pool-hit path that costs only sys_clone+sys_run+sys_wait4 (no per-call file
// I/O at all). Everything below is ADDITIVE -- gb_kernel_run/gb_kernel_run_launch/
// gb_kernel_run_child above are UNCHANGED (signature and body), kept for compat/reference.

// gb_pool_ref_i64(p): ref->i64 identity-cast launder, same technique + same rationale as
// bench/vs_rust/std_tests/gb_pool.bp's own `pool_ref_i64` (tools/typecheck.py treats
// st_root as unconditionally ref-producing regardless of a caller's plain-i64 use; retyping
// gb_pool_append's P param would ripple through every other caller in the tree). A LOCAL
// copy is needed here (not `use`d from gb_pool.bp) because gb_bg_child below -- which lives
// in THIS file -- is the one that now calls st_root itself (the single-writer child reads
// the pool's CURRENT root before appending). Zero runtime effect: types are erased before
// codegen (LANGUAGE.md); this typechecks with ZERO findings because the checker's return-
// type check only fires when the inferred body type is itself 'i64'/'[i64]'/'str' -- a ref
// type string never matches, so the check is skipped entirely (verified against
// tools/typecheck.py's TC.run: `if rt in (...) and v in (...) and v != rt`).
fn gb_pool_ref_i64(p: ref Pool) -> i64 { p }

// gb_str_to_file / gb_str_from_file: the ONLY way a `str` value crosses a sys_clone(17,...)
// packed-`args` boundary in this tree -- there is no i64<->str cast (tools/typecheck.py's
// CASTS has none), so this round-trips through a scratch file exactly the way
// gb_lib_expand (gb_compile1.bp) already does to manufacture a `str` from a buffer it just
// wrote: sys_slurp's own return type IS `str`, no cast needed on the read side.
fn gb_str_to_file(path: [i64], plen: i64, s: str) -> i64 {
  let n = str_len(s);
  let buf = zeros(n);
  let i = 0;
  while i < n {
    let _ = buf[i] = char(s, i);
    let i = i + 1;
    0
  };
  let fd = sys_open(path, plen, 578);
  let _ = sys_export(fd, buf, n);
  sys_close(fd)
}
fn gb_str_from_file(path: [i64], plen: i64, cap: i64) -> str {
  let fd = sys_open(path, plen, 0);
  let s = sys_slurp(fd, cap);
  let _ = sys_close(fd);
  s
}

// ---- background compile-on-miss (design item (c)): the child generates + compiles +
// appends + commits; the PARENT never writes the pool file (single-writer rule).
// gb_bg_compile_append: child-side gen+compile+append (build_one's own shape,
// bench/vs_rust/std_tests/gb_pool.bp, duplicated here since the child needs it standalone
// and gb_pool.bp is off-limits to `use` from a library file per the flat-use convention).
// ROOT-CAUSE FIX (B3c resume, 2026-09-07): this MUST drive gb_gen_and_compile_fast (the
// no-use_expand variant), NOT the original gb_gen_and_compile -- a sys_clone(17,...) child's
// own arena window is capped WAY below 12.8 MB (selfhost/tools/gbpool.bp's own header already
// records this: "a forked child's own arena is capped to ~8 MB by sys_clone's codegen ...
// too small to even hold that one scratch buffer"), so EVEN ONE use_expand call inside a
// forked child blows the budget -- not just 12 back-to-back calls in one process. Confirmed:
// the parked run's 12x "trap 80: arena exhausted" (one per background compile child) plus the
// 200x "trap 82: SIGSEGV/SIGBUS" downstream (hit_before/hit_after dispatching a Kernel that
// never got appended because its child died mid-compile, before st_commit) are ONE root
// cause, not two. `libtext` is built ONCE by the PARENT (gb_lib_expand, full 256 MB arena)
// and handed to every child via the same file round-trip `dir` already uses.
// gb_bg_compile_noexpand: a child-memory-safe copy of gb_compile1.bp's
// gb_compile_path_noexpand -- ONLY difference: `srccap` is caller-supplied (tightly sized to
// the actual kernel .bp source, libtext_len+3000) instead of a fixed 400000-cell sys_slurp
// scratch (400000*8 = 3.2 MB). ROOT-CAUSE FIX part 2 (B3c resume): even after routing through
// gb_gen_and_compile_fast (no use_expand), a forked child's ~8-12 MiB arena window was STILL
// exhausted -- emit_words_offs's own fixed 2 MB insns buffer (bebop.bp, shared compiler
// internals, out of scope to shrink here) plus this 3.2 MB oversized slurp cap (the real
// kernel+lib text is ~57 KB) left no headroom. Trimming the slurp cap to the actual known
// upper bound is the only knob available without touching codegen.
fn gb_bg_compile_noexpand(path: [i64], plen: i64, outbuf: [i64], outcap: i64, srccap: i64) -> i64 {
  let fd = sys_open(path, plen, 0);
  let srcv = sys_slurp(fd, srccap);
  let _ = sys_close(fd);
  let offs = zeros(512);
  let words0 = emit_words_offs(srcv, offs);
  let n0 = words0[0];
  let fnames = zeros(512);
  let fpos = zeros(512);
  let cnt = [0];
  let _ = collect_fns(srcv, fnames, fpos, cnt);
  let main_off = offs[idx_of_main(fnames, cnt[0]) + 1];
  let stub = zeros(131);
  let _ = entry_stub(stub);
  let _ = stub[42] = 335544320 + ((main_off - (n0 + 42)) & 67108863);
  let n = n0 + 131;
  let nb = n * 4 + 8;
  let _ = if nb > outcap then sys_exit(89) else 0;
  let _ = gb_pack_code(outbuf, words0, n0);
  let _ = gb_pack_stub(outbuf, stub, n0);
  let _ = gb_pack_footer(outbuf, n0, n);
  nb
}
fn gb_bg_compile_append(base: [i64], tx: [i64], tmp: [i64], P: i64, dir: str, op: i64, sr: i64, cmd: i64, outbuf: [i64], libtext: str, fieldidx: i64) -> i64 {
  let libbuf = zeros(str_len(libtext) + 3000);
  let path = zeros(512);
  let plen = gen_path(dir, op, sr, 0, 1, 0, path);
  let _ = gb_lib_write(libtext, sr, fieldidx, path, plen, libbuf);
  let nb = gb_bg_compile_noexpand(path, plen, outbuf, 131072, str_len(libtext) + 3000);
  let words = arr_alloc(base, tx, st_digest("GbKW{arr i64}"), nb);
  let i = 0;
  while i < nb {
    let _ = arr_put(base, words, i, outbuf[i]);
    let i = i + 1;
    0
  };
  let _ = st_seal(base, words, tmp);
  let keybuf = zeros(64);
  let key = gb_pool_key(keybuf, op, sr, 0, 1, 0);
  let entry = gb_entry_of(outbuf, nb);
  gb_pool_append(base, tx, tmp, P, key, op, sr, 0, 1, 0, cmd, words, entry)
}
// gb_bg_child(args): pid==0 branch ONLY, ends with sys_exit (never returns). args (12 cells):
// 0=dirpath addr, 1=dirpath len, 2=dirfile read cap, 3=pool path addr, 4=pool path len,
// 5=op, 6=sr, 7=compiler-digest cmd, 8=libtext-file addr, 9=libtext-file len, 10=libtext
// read cap, 11=fieldidx (op_fieldidx(op), computed by the parent). Opens the pool file RW
// itself (gb_pool_open_rw), reads the CURRENT committed root (gb_pool_fresh if this is the
// very first kernel -- root 0 is the null ref, T48b's own null idiom), appends, commits. No
// locals survive a clone inside this function (the clone already happened in gb_bg_launch
// below, before this was called), so the "<=8 live symbols across a clone" rule does not
// constrain this function's own (larger) local count -- it mirrors gb_kernel_run_child's
// already-proven shape instead.
fn gb_bg_child(args: [i64]) -> i64 {
  let dir = gb_str_from_file(st_cells(args[0]), args[1], args[2]);
  let ppath = st_cells(args[3]);
  let pplen = args[4];
  let op = args[5];
  let sr = args[6];
  let cmd = args[7];
  let libtext = gb_str_from_file(st_cells(args[8]), args[9], args[10]);
  let fieldidx = args[11];
  let tmp = zeros(1024);
  let base = gb_pool_open_rw(ppath, pplen, tmp);
  let tx = zeros(6);
  let _ = st_begin(base, tx, tmp);
  let Proot = st_root(base, tmp);
  let P0 = gb_pool_ref_i64(Proot);
  let P = if P0 == 0 then gb_pool_fresh(base, tx, tmp) else P0;
  let outbuf = zeros(131072);
  let P2 = gb_bg_compile_append(base, tx, tmp, P, dir, op, sr, cmd, outbuf, libtext, fieldidx);
  let _ = st_commit(base, tx, P2, tmp);
  sys_exit(0)
}
// gb_bg_launch(args) -> pid: NOT fenced (C1 step 1) -- this child IS the pool's single
// WRITER: gb_bg_child opens its own gb_pool_open_rw mapping after the fork and commits a
// new Kernel. The fence guards KERNEL dispatch (gb_kernel_run_launch/_launch2), not the
// compile-on-miss child.
// ONLY args + the new `pid` binding are live across the clone
// (WORKER-CARD's <=8-live-symbols-across-a-clone rule) -- same shape as
// gb_kernel_run_launch. Returns immediately in the PARENT with the child's pid; the caller
// records it and sys_wait4's it later (design item (c): "the parent records the child pid
// so a later call can sys_wait4 it").
fn gb_bg_launch(args: [i64]) -> i64 {
  let pid = sys_clone(17, sys_arena_base() + 16777216);
  let _ = if pid == 0 then gb_bg_child(args) else 0;
  pid
}
// gb_pool_dispatch_miss(base, A, sr, x, y, n, args) -> pid: the miss-path entry point.
// Computes the tier-0 fold into `y` (gb_mxv_generic, the SAME single source of truth every
// tier reads through -- unchanged from before) and returns to the caller as soon as the
// child is forked -- the caller folds `y` itself (fold_vec2-style) and gets the tier-0
// answer back BEFORE the child's compile has necessarily finished; the returned pid is
// sys_wait4'd later, once, to know when the pool has the new Kernel.
fn gb_pool_dispatch_miss(base: [i64], A: i64, sr: i64, x: [i64], y: [i64], n: i64, args: [i64]) -> i64 {
  let dummy = zeros(1);
  let _ = gb_mxv_generic(base, A, sr, x, y, n, 0, dummy, 0);
  gb_bg_launch(args)
}

// ---- pool-hit path, tightened (design item (2)): a process-local address-table cache
// (mmap each kernel image ONCE per process; a real fork always preserves existing memory
// mappings into the child -- COW for private, shared for MAP_SHARED -- so every dispatch
// after the first for a given kernel needs no sys_open/sys_mmap at all, just clone+run+
// wait4) and a result handed back through an anonymous MAP_SHARED mapping instead of a
// file (no sys_open/sys_export/sys_close on either side).
// cache layout: cache[0] = count; each entry is 3 cells (K, addr, nb) starting at cache[1].
fn gb_cache_find(cache: [i64], K: i64) -> i64 {
  let cnt = cache[0];
  let i = 0;
  let found = 0 - 1;
  while i < cnt {
    let ck = cache[1 + i * 3];
    let found = if ck == K then i else found;
    let i = i + 1;
    0
  };
  found
}
fn gb_cache_put(cache: [i64], K: i64, addr: i64, nb: i64) -> i64 {
  let cnt = cache[0];
  let b = 1 + cnt * 3;
  let _ = cache[b] = K;
  let _ = cache[b + 1] = addr;
  let _ = cache[b + 2] = nb;
  cache[0] = cnt + 1
}
// gb_kernel_mmap_into(base, K, dir, path, out): export-if-missing (same cache-path probe
// as gb_kernel_run above) + mmap PROT_READ|EXEC(5) MAP_PRIVATE(2) ONCE; out[0]=addr,
// out[1]=nb. Only ever called on a gb_cache_find miss.
fn gb_kernel_mmap_into(base: [i64], K: i64, dir: str, path: [i64], out: [i64]) -> i64 {
  let kdigest = gb_kernel_digest(base, K);
  let plen = gb_kernel_cache_path(dir, kdigest, path);
  let probe = sys_open(path, plen, 0);
  let exists = if probe >= 0 then 1 else 0;
  let _ = if exists == 1 then sys_close(probe) else 0;
  let _ = if exists == 0 then gb_kernel_export(base, K, path, plen) else 0;
  let W = gb_kernel_words(base, K);
  let nb = arr_n(base, W);
  let fd = sys_open(path, plen, 0);
  let addr = sys_mmap(0, nb, 5, 2, fd, 0);
  let _ = sys_close(fd);
  let _ = out[0] = addr;
  out[1] = nb
}
// gb_kernel_run_child2(args): args (4 cells) 0=kernel addr (already mapped, inherited via
// fork), 1=nb, 2=argv addr (a prebuilt 3-entry argv array, ALSO built once by the caller and
// inherited unchanged across every fork -- it never needs to be rebuilt per call since the
// data-store address it encodes never changes for the life of the process), 3=result mmap
// addr (an anonymous MAP_SHARED mapping, also built once -- a normal write here is visible
// to the parent's own mapping of the SAME pages immediately, no wait4-then-read-a-file).
fn gb_kernel_run_child2(args: [i64]) -> i64 {
  let addr = args[0];
  let nb = args[1];
  let argv2 = st_cells(args[2]);
  let resmem = st_cells(args[3]);
  let result = sys_run(addr, nb, 3, argv2);
  let _ = resmem[0] = result;
  sys_exit(0)
}
fn gb_kernel_run_launch2(args: [i64]) -> i64 {
  let _ = gb_fence_ro(args[4], args[5]);
  let pid = sys_clone(17, sys_arena_base() + 16777216);
  let _ = if pid == 0 then gb_kernel_run_child2(args) else 0;
  let st = zeros(1);
  let w = sys_wait4(pid, st, 0, 0);
  let _ = gb_fence_rw(args[4], args[5]);
  let resmem = st_cells(args[3]);
  resmem[0]
}
// gb_kernel_run_fast(base, K, dir, path, cache, argv2addr, resmemaddr): the tightened
// pool-hit dispatch. First call for a given K pays the export+mmap cost (cached
// thereafter); every call pays exactly sys_clone + sys_run + sys_wait4 -- the fork floor
// (see gb_fork_floor_one below), nothing else.
fn gb_kernel_run_fast(base: [i64], K: i64, dir: str, path: [i64], cache: [i64], argv2addr: i64, resmemaddr: i64) -> i64 {
  let idx = gb_cache_find(cache, K);
  let out = zeros(2);
  let _ = if idx < 0 then gb_kernel_mmap_into(base, K, dir, path, out) else 0;
  let _ = if idx < 0 then gb_cache_put(cache, K, out[0], out[1]) else 0;
  let fidx = if idx < 0 then cache[0] - 1 else idx;
  let addr = cache[1 + fidx * 3 + 1];
  let nb = cache[1 + fidx * 3 + 2];
  let args = zeros(6);
  let _ = args[0] = addr;
  let _ = args[1] = nb;
  let _ = args[2] = argv2addr;
  let _ = args[3] = resmemaddr;
  let _ = args[4] = addr_of(base);   // C1 step 1: the fence's operands, as in gb_kernel_run
  let _ = args[5] = 4194304;
  gb_kernel_run_launch2(args)
}

// gb_fork_floor_one(): the fork CEILING measurement (task item 2) -- a bare
// sys_clone+sys_exit(0)+sys_wait4, nothing else. Whatever gb_kernel_run_fast costs beyond
// this is the mmap-cache/argv/result-mmap overhead; whatever THIS costs beyond 0.1 ms is
// unreachable while sys_run is required to run inside a fork (see the comment above
// gb_kernel_run_child: entering another image's entry stub reconfigures the caller's own
// arena/signal-stack registers, unsafe in a process that must keep running -- an in-process
// sys_run is explicitly ruled out, not proposed here).
fn gb_fork_floor_child() -> i64 { sys_exit(0) }
fn gb_fork_floor_one() -> i64 {
  let pid = sys_clone(17, sys_arena_base() + 16777216);
  let _ = if pid == 0 then gb_fork_floor_child() else 0;
  let st = zeros(1);
  sys_wait4(pid, st, 0, 0)
}
