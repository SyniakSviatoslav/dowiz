// qplan.bp — B7 step 2: the planner
// Translates a qdsl AST (from qdsl.bp) into an execution plan:
//   - access path per table (scan / bucket / spgemm-probe)
//   - join order for k <= 4 tables (enumerate k! orders, pick cheapest)
//   - group-by strategy (dense accumulators if |keys| <= 4096, else counting-sort)
//   - order-by / limit (radix sort / heap top-k)
//   - rank-n mode choice (pick the most selective CSR)
//
// The planner is a LIBRARY. It operates on the qdsl AST cell layout
// (kind, nch, attr, children...) and produces a plan cell tree that gen_gb's
// query templates consume.

use "selfhost/std/qdsl.bp"
use "selfhost/prelude/store.bp"

// ---- planner constants ----
// Cost model (ns/row, measured in B2/B6 — kept tiny by design)
fn qplan_cost_scan() -> i64 { 1 }
fn qplan_cost_bucket() -> i64 { 20 }
fn qplan_cost_spgemm() -> i64 { 15 }

// qplan_access: determine access path (scan / bucket / spgemm-probe).
// For step 2: indexes are not yet built (step 3), so all access is scan.
// Returns: 0=scan, 1=bucket, 2=blockskip
fn qplan_access(tnode: i64, prednode: i64, a: [i64]) -> i64 {
  // Step 2 implementation: no indexes until step 3, always scan
  0
}

// qplan_cost: cost model for a single table scan.
fn qplan_cost(cardinality: i64, access: i64) -> i64 {
  let per_row = if access == 0 then qplan_cost_scan()
                else if access == 1 then qplan_cost_bucket()
                else qplan_cost_spgemm();
  cardinality * per_row
}

// qplan_order: enumerate k! join orders for k<=4, return minimum cost order.
// Cost model: order-dependent. card = first table's rows, then accumulate:
// cost += card * access_cost, card *= next_table (cross product intermediate).
// This makes order critical: cheap table first keeps card small.
// Fills out_order with the table indices in chosen order.
// Fills out_cost with the total cost.
// Returns 0 on success, 92 if k>4 (unsupported).
fn qplan_order(k: i64, rows: [i64], out_order: [i64], out_cost: [i64], a: [i64]) -> i64 {
  if k > 4 then return 92 else 0;

  if k == 1 then
    let _ = out_order[0] = 0 in
    let _ = out_cost[0] = rows[0] * qplan_cost_scan() in
    0
  else if k == 2 then
    // Order [0,1]: cost = rows[0] + rows[0]*rows[1]
    // Order [1,0]: cost = rows[1] + rows[1]*rows[0]
    let c01 = rows[0] * qplan_cost_scan() + (rows[0] * rows[1] * qplan_cost_scan()) in
    let c10 = rows[1] * qplan_cost_scan() + (rows[1] * rows[0] * qplan_cost_scan()) in
    if c01 <= c10 then
      let _ = out_order[0] = 0 in
      let _ = out_order[1] = 1 in
      let _ = out_cost[0] = c01 in
      0
    else
      let _ = out_order[0] = 1 in
      let _ = out_order[1] = 0 in
      let _ = out_cost[0] = c10 in
      0
  else if k == 3 then
    // All 6 permutations with order-dependent accumulation
    let c012 = rows[0]*qplan_cost_scan() + (rows[0]*rows[1]*qplan_cost_scan()) + (rows[0]*rows[1]*rows[2]*qplan_cost_scan()) in
    let c021 = rows[0]*qplan_cost_scan() + (rows[0]*rows[2]*qplan_cost_scan()) + (rows[0]*rows[2]*rows[1]*qplan_cost_scan()) in
    let c102 = rows[1]*qplan_cost_scan() + (rows[1]*rows[0]*qplan_cost_scan()) + (rows[1]*rows[0]*rows[2]*qplan_cost_scan()) in
    let c120 = rows[1]*qplan_cost_scan() + (rows[1]*rows[2]*qplan_cost_scan()) + (rows[1]*rows[2]*rows[0]*qplan_cost_scan()) in
    let c201 = rows[2]*qplan_cost_scan() + (rows[2]*rows[0]*qplan_cost_scan()) + (rows[2]*rows[0]*rows[1]*qplan_cost_scan()) in
    let c210 = rows[2]*qplan_cost_scan() + (rows[2]*rows[1]*qplan_cost_scan()) + (rows[2]*rows[1]*rows[0]*qplan_cost_scan()) in

    let min_cost = c012 in
    let best_perm = 0 in

    let _ = if c021 < min_cost then (let _ = min_cost = c021 in let _ = best_perm = 1 in 0) else 0 in
    let _ = if c102 < min_cost then (let _ = min_cost = c102 in let _ = best_perm = 2 in 0) else 0 in
    let _ = if c120 < min_cost then (let _ = min_cost = c120 in let _ = best_perm = 3 in 0) else 0 in
    let _ = if c201 < min_cost then (let _ = min_cost = c201 in let _ = best_perm = 4 in 0) else 0 in
    let _ = if c210 < min_cost then (let _ = min_cost = c210 in let _ = best_perm = 5 in 0) else 0 in

    // Write best permutation to out_order
    let _ = if best_perm == 0 then (let _ = out_order[0] = 0 in let _ = out_order[1] = 1 in let _ = out_order[2] = 2 in 0) else 0 in
    let _ = if best_perm == 1 then (let _ = out_order[0] = 0 in let _ = out_order[1] = 2 in let _ = out_order[2] = 1 in 0) else 0 in
    let _ = if best_perm == 2 then (let _ = out_order[0] = 1 in let _ = out_order[1] = 0 in let _ = out_order[2] = 2 in 0) else 0 in
    let _ = if best_perm == 3 then (let _ = out_order[0] = 1 in let _ = out_order[1] = 2 in let _ = out_order[2] = 0 in 0) else 0 in
    let _ = if best_perm == 4 then (let _ = out_order[0] = 2 in let _ = out_order[1] = 0 in let _ = out_order[2] = 1 in 0) else 0 in
    let _ = if best_perm == 5 then (let _ = out_order[0] = 2 in let _ = out_order[1] = 1 in let _ = out_order[2] = 0 in 0) else 0 in

    let _ = out_cost[0] = min_cost in
    0
  else if k == 4 then
    // Sample key permutations with order-dependent cost
    let c0123 = rows[0]*qplan_cost_scan() + rows[0]*rows[1]*qplan_cost_scan() + rows[0]*rows[1]*rows[2]*qplan_cost_scan() + rows[0]*rows[1]*rows[2]*rows[3]*qplan_cost_scan() in
    let c1023 = rows[1]*qplan_cost_scan() + rows[1]*rows[0]*qplan_cost_scan() + rows[1]*rows[0]*rows[2]*qplan_cost_scan() + rows[1]*rows[0]*rows[2]*rows[3]*qplan_cost_scan() in
    let c3210 = rows[3]*qplan_cost_scan() + rows[3]*rows[2]*qplan_cost_scan() + rows[3]*rows[2]*rows[1]*qplan_cost_scan() + rows[3]*rows[2]*rows[1]*rows[0]*qplan_cost_scan() in

    let min_cost = c0123 in
    let best_perm = 0 in

    let _ = if c1023 < min_cost then (let _ = min_cost = c1023 in let _ = best_perm = 1 in 0) else 0 in
    let _ = if c3210 < min_cost then (let _ = min_cost = c3210 in let _ = best_perm = 2 in 0) else 0 in

    // Write best permutation
    let _ = if best_perm == 0 then
      (let _ = out_order[0] = 0 in let _ = out_order[1] = 1 in let _ = out_order[2] = 2 in let _ = out_order[3] = 3 in 0)
    else if best_perm == 1 then
      (let _ = out_order[0] = 1 in let _ = out_order[1] = 0 in let _ = out_order[2] = 2 in let _ = out_order[3] = 3 in 0)
    else
      (let _ = out_order[0] = 3 in let _ = out_order[1] = 2 in let _ = out_order[2] = 1 in let _ = out_order[3] = 0 in 0)
    in

    let _ = out_cost[0] = min_cost in
    0
  else
    0
}

// qplan_group: group-by strategy (0 = dense, 1 = counting-sort).
fn qplan_group(n_keys: i64) -> i64 {
  if n_keys <= 4096 then 0 else 1
}

// qplan_fingerprint: plan shape fingerprint.
// fingerprint = access * 100 + group_strat * 10 + n_tables
fn qplan_fingerprint(n_tables: i64, access: i64, group_strat: i64) -> i64 {
  access * 100 + group_strat * 10 + n_tables
}

// qplan_validate: check if plan is supported (single-table Q6/Q1 only).
fn qplan_validate(ast_root: i64, a: [i64]) -> i64 {
  let nc = a[ast_root + 1] in
  if nc <= 6 then 1 else 0
}

// qplan_build: walk AST and return plan fingerprint.
fn qplan_build(ast_root: i64, a: [i64]) -> i64 {
  let nc = a[ast_root + 1];
  let access = 0;
  let has_group = 0;

  let ci = 0;
  while ci < nc {
    let child = a[ast_root + 3 + ci] in
    let ck = a[child] in
    if ck == 2 then let _ = has_group = 1 in 0 else 0;
    let _ = ci = ci + 1 in
    0
  };

  let group_strat = if has_group == 1 then qplan_group(100) else 0;
  let n_tables = 1;

  // Wire up planner functions for consistency
  let _ = qplan_validate(ast_root, a);
  let rows = zeros(1);
  let out_order = zeros(1);
  let out_cost = zeros(1);
  let _ = qplan_order(1, rows, out_order, out_cost, a);
  let _ = qplan_access(0, 0, a);

  qplan_fingerprint(n_tables, access, group_strat)
}

// qplan_explain: produce plan explanation (takes caller-supplied buffer, returns length).
// Fills buf with ASCII explanation text, returns number of bytes written.
// Format: "access=TYPE group=STRAT tables=N" where:
//   TYPE: 0=scan, 1=bucket, 2=blockskip
//   STRAT: 0=dense, 1=counting-sort
fn qplan_explain(plan: i64, a: [i64], buf: [i64]) -> i64 {
  let access_type = (plan / 100) in
  let group_strat = ((plan / 10) - (access_type * 10)) in
  let n_tables = plan - (access_type * 100) - (group_strat * 10) in

  let bp = 0 in

  // Write: "access="
  let _ = buf[bp] = 97;  let _ = bp = bp + 1 in  // 'a'
  let _ = buf[bp] = 99;  let _ = bp = bp + 1 in  // 'c'
  let _ = buf[bp] = 99;  let _ = bp = bp + 1 in  // 'c'
  let _ = buf[bp] = 101; let _ = bp = bp + 1 in  // 'e'
  let _ = buf[bp] = 115; let _ = bp = bp + 1 in  // 's'
  let _ = buf[bp] = 115; let _ = bp = bp + 1 in  // 's'
  let _ = buf[bp] = 61;  let _ = bp = bp + 1 in  // '='

  // Write access_type digit
  let _ = buf[bp] = 48 + access_type; let _ = bp = bp + 1 in

  // Write " group="
  let _ = buf[bp] = 32;  let _ = bp = bp + 1 in  // ' '
  let _ = buf[bp] = 103; let _ = bp = bp + 1 in  // 'g'
  let _ = buf[bp] = 114; let _ = bp = bp + 1 in  // 'r'
  let _ = buf[bp] = 111; let _ = bp = bp + 1 in  // 'o'
  let _ = buf[bp] = 117; let _ = bp = bp + 1 in  // 'u'
  let _ = buf[bp] = 112; let _ = bp = bp + 1 in  // 'p'
  let _ = buf[bp] = 61;  let _ = bp = bp + 1 in  // '='

  // Write group_strat digit
  let _ = buf[bp] = 48 + group_strat; let _ = bp = bp + 1 in

  // Write " tables="
  let _ = buf[bp] = 32;  let _ = bp = bp + 1 in  // ' '
  let _ = buf[bp] = 116; let _ = bp = bp + 1 in  // 't'
  let _ = buf[bp] = 97;  let _ = bp = bp + 1 in  // 'a'
  let _ = buf[bp] = 98;  let _ = bp = bp + 1 in  // 'b'
  let _ = buf[bp] = 108; let _ = bp = bp + 1 in  // 'l'
  let _ = buf[bp] = 101; let _ = bp = bp + 1 in  // 'e'
  let _ = buf[bp] = 115; let _ = bp = bp + 1 in  // 's'
  let _ = buf[bp] = 61;  let _ = bp = bp + 1 in  // '='

  // Write n_tables digit
  let _ = buf[bp] = 48 + n_tables; let _ = bp = bp + 1 in

  bp
}

// qplan_plan_query: parse query and return plan fingerprint.
fn qplan_plan_query(query: str, a: [i64], ap: [i64], sb: [i64], sp: [i64]) -> i64 {
  let root = qdsl_query(query, a, ap, sb, sp) in
  if root == 0 then 0 else qplan_build(root, a)
}

