// selfhost/std/interpolate.bp — linear interpolation over f64.
//
// lerp: single-segment linear interpolation a + (b - a) * t.
// lerp_array: piecewise linear interpolation over a sorted x grid (xs, ys).
//   Clamps x to [xs[0], xs[n-1]]: returns ys[0] when x <= xs[0], ys[n-1]
//   when x >= xs[n-1], else the interpolation between the two grid points
//   that bracket x. Assumes xs is sorted ascending and n >= 2 (n == 1
//   returns ys[0]).
// clampf: constrain a float x into [lo, hi].
//
// No structs: a grid is two parallel arrays xs (abscissae) and ys
// (ordinates) plus an explicit length n (no array-length builtin). Full
// f64 arithmetic; no scientific notation, no unary minus, no bitwise ops.

module core { }

// lerp: linear interpolation between a and b at parameter t.
fn lerp(a: f64, b: f64, t: f64) -> f64 {
  a + (b - a) * t
}

// clampf: constrain x into [lo, hi].
fn clampf(x: f64, lo: f64, hi: f64) -> f64 {
  if x < lo then lo else (if x > hi then hi else x)
}

// lerp_array: piecewise linear interpolation of y at x over the sorted grid
// (xs, ys) of length n. Clamps x to [xs[0], xs[n-1]].
fn lerp_array(xs: [f64], ys: [f64], n: i64, x: f64) -> f64 {
  let r = ys[0];
  let r = if x <= xs[0] then ys[0] else r;
  let r = if x >= xs[n - 1] then ys[n - 1] else r;
  let i = 0;
  let done = 0;
  let done = if n <= 1 then 1 else done;
  let done = if x <= xs[0] then 1 else done;
  let done = if x >= xs[n - 1] then 1 else done;
  while done == 0 {
    let in_seg = if x <= xs[i + 1] then 1 else 0;
    let r = if in_seg == 1 then (ys[i] + (ys[i + 1] - ys[i]) * ((x - xs[i]) / (xs[i + 1] - xs[i]))) else r;
    let done = if in_seg == 1 then 1 else (if i + 2 >= n then 1 else 0);
    let i = i + 1;
    0
  };
  r
}
