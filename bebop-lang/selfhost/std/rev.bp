// rev.bp — N2: Reversible / Conservative Logic.
// Post-von-Neumann invariant: NO destructive operations. Every arena mutation
// is an involutive (self-inverse) or invertible gate implemented from pure
// bitwise ops (XOR / mask / swap). Any arena state can be "unwound" bit-for-
// bit WITHOUT copies or memory snapshots — apply the inverse gate (which, for
// XOR/CNOT/Toffoli, is the same gate again). This buys zero-overhead debug,
// instant agent rollback to any prior state, and crash self-recovery.
//
// All gates here are exact in i64 (two's complement bitwise ops).

// rev_toggle(x, i, bit): flip bit `bit` of cell x[i]. Self-inverse: applying
// it twice restores the original. Returns bit.
fn rev_toggle(x: [i64], i: i64, bit: i64) -> i64 {
  let _ = x[i] = x[i] ^ (1 << bit);
  bit
}

// rev_cnot(x, i, j): controlled-NOT across the full 64-bit words — x[j] ^= x[i].
// Self-inverse (classical CNOT): applying it twice restores both cells.
fn rev_cnot(x: [i64], i: i64, j: i64) -> i64 {
  let _ = x[j] = x[j] ^ x[i];
  j
}

// rev_toffoli_bit(x, a, b, c, bit): Toffoli on a single bit — cell c's bit
// `bit` toggles iff BOTH a's and b's same bit are set. Self-inverse (XOR).
// Conservative: bit population of (a,b) is preserved.
fn rev_toffoli_bit(x: [i64], a: i64, b: i64, c: i64, bit: i64) -> i64 {
  let ca = (x[a] >> bit) & 1;
  let cb = (x[b] >> bit) & 1;
  let p = (ca * cb) << bit;
  let _ = x[c] = x[c] ^ p;
  bit
}

// rev_fredkin_bit(x, a, b, c, bit): Fredkin (controlled-swap) on one bit —
// if cell a's bit `bit` is set, swap b's and c's `bit`. Self-inverse;
// conservative (bit population of (b,c) preserved regardless of control).
fn rev_fredkin_bit(x: [i64], a: i64, b: i64, c: i64, bit: i64) -> i64 {
  let cb = (x[a] >> bit) & 1;
  let bbv = (x[b] >> bit) & 1;
  let cbv = (x[c] >> bit) & 1;
  let nb = bbv + (cbv - bbv) * cb;
  let nc = cbv + (bbv - cbv) * cb;
  let all1 = 0 - 1 - (1 << bit);
  let _ = x[b] = (x[b] & all1) | (nb << bit);
  let _ = x[c] = (x[c] & all1) | (nc << bit);
  bit
}

// rev_round(x, n, deltas): one reversible arena "mix" round. Each cell i is
// XORed with a delta derived from neighbor (i+1)%n; the delta itself is
// recorded into deltas[i] BEFORE the cell is touched, so the round is
// UNWINDABLE. Rewinding to the prior arena state needs no snapshot — replay
// the recorded deltas (rev_undo) in reverse; XOR is its own inverse, so the
// state returns bit-for-bit.
// deltas MUST be a zeros(n) buffer owned by the caller.
fn rev_round(x: [i64], n: i64, deltas: [i64]) -> i64 {
  let i = 0;
  while i < n {
    let j = (i + 1) % n;
    let _ = deltas[i] = x[i] ^ (x[j] + (0 - 7046029254386353131)) ^ (0 - 7723592293110705685);
    let _ = x[i] = x[i] ^ deltas[i];
    let i = i + 1;
    0
  };
  n
}

// rev_undo(x, n, deltas): re-applies the recorded round deltas in reverse
// cell order to restore the exact pre-round arena state. Involutive XOR.
fn rev_undo(x: [i64], n: i64, deltas: [i64]) -> i64 {
  let i = n - 1;
  while i >= 0 {
    let _ = x[i] = x[i] ^ deltas[i];
    let i = i - 1;
    0
  };
  n
}

// rev_mix(x, n): reversible scramble built from TWO involutive halves — call
// rev_round+rev_undo; the idle-loop-free wrapper keeps a single entry point
// and returns n. (The two-step round+undo is the canonical N2 "mutate then
// unwind" pair.)
fn rev_mix(x: [i64], n: i64, deltas: [i64]) -> i64 {
  rev_round(x, n, deltas)
}
fn main() -> i64 {
  let x = zeros(16);
  let d = zeros(16);
  let acc = 0;
  let n = 5;
  let _ = x[0] = 15;
  let _ = rev_toggle(x, 0, 3);
  let t = x[0];
  let _ = rev_toggle(x, 0, 3);
  let acc = acc * 131 + (if x[0] == 15 then 1 else 0);
  let _ = x[1] = 5;
  let _ = x[2] = 3;
  let _ = rev_cnot(x, 1, 2);
  let _ = rev_cnot(x, 1, 2);
  let acc = acc * 131 + (if x[2] == 3 then 1 else 0);
  let _ = x[1] = 3;
  let _ = x[2] = 1;
  let _ = x[3] = 0;
  let _ = rev_toffoli_bit(x, 1, 2, 3, 0);
  let acc = acc * 131 + (if x[3] == 1 then 1 else 0);
  let _ = rev_toffoli_bit(x, 1, 2, 3, 0);
  let acc = acc * 131 + (if x[3] == 0 then 1 else 0);
  let _ = x[1] = 1;
  let _ = x[2] = 1;
  let _ = x[3] = 0;
  let _ = rev_fredkin_bit(x, 1, 2, 3, 0);
  let acc = acc * 131 + (if x[3] == 1 then 1 else 0);
  let _ = rev_fredkin_bit(x, 1, 2, 3, 0);
  let acc = acc * 131 + (if x[3] == 0 then 1 else 0);
  let _ = x[0] = 1000;
  let _ = x[1] = 0;
  let _ = x[2] = 0 - 5;
  let _ = x[3] = 42;
  let _ = x[4] = 7;
  let _ = rev_round(x, n, d);
  let mid = x[2];
  let _ = rev_undo(x, n, d);
  let ok = (if x[0] == 1000 then 1 else 0) + (if x[1] == 0 then 1 else 0) + (if x[2] == 0 - 5 then 1 else 0) + (if x[3] == 42 then 1 else 0) + (if x[4] == 7 then 1 else 0) + (if mid != x[2] then 1 else 0);
  acc * 131 + ok
}
