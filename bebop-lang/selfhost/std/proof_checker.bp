// proof_checker.bp — End-to-end proof checker for QTT.
// Parses theorem statements, type-checks, and validates proofs.

module core { }

// Import kernel modules
// (In practice these would be included via module system)

#include "qtt_kernel.bp"
#include "nat_peano.bp"
#include "proof.bp"
#include "universes.bp"

// ============================================================
// Theorem parsing and checking entry point
// ============================================================

// Parse a theorem statement: theorem name : type := proof
// Returns 1 if valid, 0 if invalid

fn check_theorem_file(src: str) -> i64 {
  // Parse source into AST
  let ast = parse_theorem(src);
  if tm_code(ast) == 0 then 0 else {
    // Extract statement and proof
    let stmt = tm_fst(ast);
    let proof = tm_snd(ast);
    check_theorem(stmt, proof)
  }
}

// Parse a single theorem declaration
fn parse_theorem(src: str) -> [i64] {
  // Parse "theorem name : type := proof"
  // Returns [stmt, proof] pair or 0 on error
  // For now, return dummy
  let r = zeros(3);
  let _ = r[0] = 1;
  let _ = r[1] = tm_type(0);  // dummy stmt
  let _ = r[2] = tm_const(0, 0);  // dummy proof
  r
}

// ============================================================
// Main entry point for proof checker
// ============================================================

fn main() -> i64 {
  // Test the kernel with sample theorems
  let test1 = check_refl(tm_const(1, 0), tm_const(1, 0));  // zero = zero
  let test2 = check_refl(
    tm_app(tm_const(5, 0), tm_const(1, 0)),  // add zero zero
    tm_const(1, 0)  // zero
  );
  let test3 = check_refl(
    tm_app(tm_app(tm_const(5, 0), tm_const(1, 0)), tm_const(1, 0)),  // add zero zero
    tm_const(1, 0)
  );
  let test4 = check_refl(
    tm_app(tm_const(5, 0), tm_const(1, 0)),  // add zero zero
    tm_const(1, 0)
  );
  // Sum results
  test1 + test2 + test3 + test4
}