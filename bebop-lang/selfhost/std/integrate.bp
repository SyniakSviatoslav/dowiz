// selfhost/std/integrate.bp — numerical integration (f64).
// Midpoint rule + trapezoid rule over f(x) for fn_id in {1,2,3}:
//   fn_id 1 -> x^2,  fn_id 2 -> x^3,  fn_id 3 -> sin(x).
// No structs, no %, no scientific notation, no unary minus (use 0.0 - x).
// n <= 0 returns 0.0 (sentinel). n is the number of subintervals.

module core { }

// sin_poly: Taylor series for sin on [-pi/2, pi/2] (7 terms).
fn sin_poly(x: f64) -> f64 {
  let x2 = x * x;
  let x3 = x2 * x;
  let x5 = x3 * x2;
  let x7 = x5 * x2;
  let x9 = x7 * x2;
  let x11 = x9 * x2;
  let x13 = x11 * x2;
  x - x3 / 6.0 + x5 / 120.0 - x7 / 5040.0 + x9 / 362880.0 - x11 / 39916800.0 + x13 / 6227020800.0
}

// sin: sine of x (radians). Range-reduce into [-pi/2, pi/2] then Taylor.
fn sin(x: f64) -> f64 {
  let pi = 3.141592653589793;
  let two_pi = 6.283185307179586;
  let half_pi = 1.5707963267948966;
  let xr = x;
  while xr > pi { let xr = xr - two_pi; 0 };
  while xr < 0.0 - pi { let xr = xr + two_pi; 0 };
  let neg = 0;
  let neg = if xr < 0.0 - half_pi then 1 else neg;
  let xr = if xr > half_pi then pi - xr else xr;
  let xr = if xr < 0.0 - half_pi then xr + pi else xr;
  let s = sin_poly(xr);
  let s = if neg == 1 then 0.0 - s else s;
  s
}

// f_eval: evaluate the integrand f(x) for a given fn_id.
fn f_eval(fn_id: i64, x: f64) -> f64 {
  let r = 0.0;
  let r = if fn_id == 1 then x * x else r;
  let r = if fn_id == 2 then x * x * x else r;
  let r = if fn_id == 3 then sin(x) else r;
  r
}

// integrate_midpoint: midpoint rule, n subintervals.
fn integrate_midpoint(fn_id: i64, a: f64, b: f64, n: i64) -> f64 {
  if n <= 0 then 0.0 else (
    let h = (b - a) / n;
    let s = 0.0;
    let i = 0;
    while i < n {
      let x = a + (i + 0.5) * h;
      let s = s + f_eval(fn_id, x) * h;
      let i = i + 1;
      0
    };
    s
  )
}

// integrate_trapezoid: trapezoid rule, n subintervals.
fn integrate_trapezoid(fn_id: i64, a: f64, b: f64, n: i64) -> f64 {
  if n <= 0 then 0.0 else (
    let h = (b - a) / n;
    let s = 0.0;
    let i = 1;
    while i < n {
      let x = a + i * h;
      let s = s + f_eval(fn_id, x);
      let i = i + 1;
      0
    };
    (h * 0.5) * (f_eval(fn_id, a) + 2.0 * s + f_eval(fn_id, b))
  )
}
