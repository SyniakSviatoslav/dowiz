// selfhost/std/complexf.bp — complex arithmetic over f64 re+im pairs.
// A complex number z = (re, im) is two f64 values. A Bebop fn returns a
// single scalar, so each operation is split into a real-part and an
// imaginary-part component fn. Port of native/src/complex.c (c_add, c_mul,
// c_abs). c_abs is the magnitude sqrt(re*re + im*im); Bebop has no sqrt
// builtin, so it is computed by Newton iteration (g -> (g + s/g)/2).

module core { }

// c_add_re: real part of (ar + ai i) + (br + bi i).
fn c_add_re(ar: f64, ai: f64, br: f64, bi: f64) -> f64 { ar + br }

// c_add_im: imaginary part of (ar + ai i) + (br + bi i).
fn c_add_im(ar: f64, ai: f64, br: f64, bi: f64) -> f64 { ai + bi }

// c_mul_re: real part of (ar + ai i) * (br + bi i).
fn c_mul_re(ar: f64, ai: f64, br: f64, bi: f64) -> f64 { ar * br - ai * bi }

// c_mul_im: imaginary part of (ar + ai i) * (br + bi i).
fn c_mul_im(ar: f64, ai: f64, br: f64, bi: f64) -> f64 { ar * bi + ai * br }

// c_abs: magnitude of (ar + ai i), i.e. sqrt(ar*ar + ai*ai) via Newton.
fn c_abs(ar: f64, ai: f64) -> f64 {
  let s = ar * ar + ai * ai;
  if s == 0.0 then 0.0 else (
    let g = s;
    let i = 0;
    while i < 25 {
      let g = (g + s / g) / 2.0;
      let i = i + 1;
      0
    };
    g
  )
}
