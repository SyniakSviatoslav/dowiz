// selfhost/std/gen_gb.bp -- B3 step 2 (docs/blueprints/B3-graphblas-kernels-prejit.md section
// 3 "Generator" / section 5 step 2): string templates + generator for SPECIALISED mxv/vxm
// kernels over semirings 1-4 (or-and, any-pair, plus-times schoolbook, min-plus), one .bp
// program written per call. Library only (no main); a nested `use` inside an included file is
// NOT followed (T47b, bebop.bp:5069), so every direct user of this file must ALSO directly
// `use` sha256.bp, store.bp and gb.bp themselves (same flat pattern as gb.bp's own header).
//
// Design (coordinator, 2026-09-07): mxv and vxm reduce to the SAME row-major gather loop --
// mxv reads matrix A as stored, vxm reads its transpose AT (mathematically vxm(x,A) ==
// mxv(AT,x) exactly, associative/commutative reductions don't care about traversal order).
// The DRIVER pre-builds AT with gb.bp's own gb_transpose and seals it into the store next to
// A, so a generated vxm kernel needs no write-transaction machinery of its own -- it just picks
// root field 1 instead of field 0. This keeps the two "templates" the blueprint asks for
// (mxv/push, vxm/pull) genuinely distinct generated files while sharing one template writer.
//
// The kernel program: `use`s sha256/store/gb, st_map_ro's a store file given on argv[2], reads
// root field 0 (mxv) or 1 (vxm) for the matrix and field 2 for the input vector (an "arr i64"
// object, gb.bp convention -- arr_get(base, X, j)), runs ONE specialised row loop (the
// semiring's oplus/otimes baked in as literal text, no branch inside the inner loop -- that is
// the whole point vs gb_mxv_generic's tier-0 branch table), folds the output vector (plain sum,
// gb.bp's own gb_fold_row/arr_sum convention) and returns it (auto-printed by the runtime,
// seed.S:102).
//
// sr 1 or-and / 2 any-pair: both reduce to "does row i touch a nonzero x[j]" (gb.bp:28-31 --
// edge weights here are always positive, so AND/pair-with-the-matrix is always true) -- ONE
// body writer serves both, matching gb_mxv_generic's own sr==3/sr==4/else structure.
// sr 3 plus-times: schoolbook Q32 (`(x[j] * w) / 4294967296`, gb.bp:435) -- marked "schoolbook"
// per the blueprint until `umulh` lands (A-series, not in scope here).
// sr 4 min-plus: acc = min(acc, x[j] + w), identity = 1099511627776 (gb.bp's own `big`).
//
// mask/fmt/tr: gen_gb accepts the full (op, sr, mask, fmt, tr) parameter set the blueprint's
// section 3 names (feeds the digest-naming convention `gb_<op>_<sr>_<mask>_<fmt>_<tr>.bp`,
// Kernel-object naming is step 4) but this step only EXERCISES mask=0 (no mask), fmt=1 (CSR,
// the only format gb.bp builds) and tr=0 (transpose is already expressed as the vxm op itself,
// not a separate descriptor bit here) -- mask!=0/fmt!=1/tr!=0 are accepted into the filename
// for forward compatibility but generate the SAME unmasked/CSR/untransposed body (open item,
// not a silent wrong-answer: no driver ever calls them, and the generated body has no
// masked-write code path to be wrong).

use "selfhost/prelude/sha256.bp"
use "selfhost/prelude/store.bp"
use "selfhost/prelude/gb.bp"

// ---- text-buffer helpers: `pos` is a caller-owned 1-cell cursor (bebop.bp's own emit_cmp/pos
// idiom, not a `let`-rebind chain -- keeps every writer's live-symbol count flat regardless of
// how many pieces it emits). `dst` is caller-owned and pre-sized; no allocation in here. ----
fn wr_str(dst: [i64], pos: [i64], s: str) -> i64 {
  let off = pos[0];
  let n = str_len(s);
  let i = 0;
  while i < n {
    let _ = dst[off + i] = char(s, i);
    let i = i + 1;
    0
  };
  let _ = pos[0] = off + n;
  0
}
// wr_i64: decimal (with sign) of v, written at pos[0]; digits built high-to-low into the SAME
// destination window (off..off+24) then shifted flush against off (csr_build_profile.bp:38
// itoa's algorithm, offset-parameterised so it can write into the middle of a larger buffer).
fn wr_i64(dst: [i64], pos: [i64], v: i64) -> i64 {
  let off = pos[0];
  let neg = if v < 0 then 1 else 0;
  let m = if v < 0 then 0 - v else v;
  let p = off + 23;
  let m2 = m;
  let go = 1;
  while go == 1 {
    let d = m2 - (m2 / 10) * 10;
    let _ = dst[p] = 48 + d;
    let p = p - 1;
    let m2 = m2 / 10;
    let go = if m2 > 0 then 1 else 0;
    0
  };
  let start = p + 1;
  let len = (off + 24) - start;
  let i = 0;
  while i < len {
    let _ = dst[off + neg + i] = dst[start + i];
    let i = i + 1;
    0
  };
  let _ = if neg == 1 then (let _ = dst[off] = 45 in 0) else 0;
  let _ = pos[0] = off + len + neg;
  0
}
// op 1 mxv (root field 0, A) / 2 vxm (field 1, AT) / 3 dmxv (field 3, DA -- the directed,
// UN-symmetrised u<v matrix, coordinator review item 2) / 4 dvxm (field 4, DAT).
fn wr_opname(dst: [i64], pos: [i64], op: i64) -> i64 {
  if op == 2 then wr_str(dst, pos, "vxm")
  else if op == 3 then wr_str(dst, pos, "dmxv")
  else if op == 4 then wr_str(dst, pos, "dvxm")
  else if op == 5 then wr_str(dst, pos, "bfs")
  else if op == 6 then wr_str(dst, pos, "mbfs")
  else wr_str(dst, pos, "mxv")
}
fn op_fieldidx(op: i64) -> i64 {
  if op == 2 then 1 else if op == 3 then 3 else if op == 4 then 4 else 0
}
// wr_ch: one raw byte at pos[0] -- bebop string literals have NO backslash-escape (the
// scanner treats the first bare `"` as the terminator, scan_one_lit bebop.bp:5709), so a
// literal double-quote inside GENERATED text (the kernel's own `use "..."` lines) can only be
// written this way, never as `\"` inside a template string. Real embedded newlines inside a
// template string DO work (probed 2026-09-07: a multi-line "..." literal compiles and
// str_len/char see the raw \n byte) so template text below uses actual line breaks, not `\n`.
fn wr_ch(dst: [i64], pos: [i64], c: i64) -> i64 {
  let off = pos[0];
  let _ = dst[off] = c;
  let _ = pos[0] = off + 1;
  0
}
fn wr_use_line(dst: [i64], pos: [i64], p: str) -> i64 {
  let _ = wr_str(dst, pos, "use ");
  let _ = wr_ch(dst, pos, 34);
  let _ = wr_str(dst, pos, p);
  let _ = wr_ch(dst, pos, 34);
  wr_ch(dst, pos, 10)
}

// ---- semiring text substitutions (section 3 "Generator": oplus/otimes as text) ----
fn wr_init(dst: [i64], pos: [i64], sr: i64) -> i64 {
  if sr == 4 then wr_str(dst, pos, "1099511627776") else wr_str(dst, pos, "0")
}
// wr_row_body: the per-edge (j, w) update, sr 3 schoolbook Q32 plus-times / sr 4 min-plus /
// else (1, 2) or-and's "any live neighbour" OR-accumulate -- text-identical to gb_mxv_generic's
// own three arms (gb.bp:448-457), just with no branch left in the emitted code.
fn wr_row_body(dst: [i64], pos: [i64], sr: i64) -> i64 {
  if sr == 3 then wr_str(dst, pos, "    let acc = acc + (arr_get(base, X, j) * w) / 4294967296;
")
  else if sr == 4 then wr_str(dst, pos, "    let mp = arr_get(base, X, j) + w;
    let acc = if mp < acc then mp else acc;
")
  else wr_str(dst, pos, "    let xb = if arr_get(base, X, j) != 0 then 1 else 0;
    let acc = if acc == 1 then 1 else xb;
")
}

// gen_kernel_body: the "fn kernel_row / fn main" text only, NO `use` lines -- factored out
// (B3 step 4, coordinator, 2026-09-07) so a caller that already has sha256/store/gb inlined
// in a cached, pre-expanded prefix (selfhost/tools/gbpool.bp's own use -- use_expand's own
// internal 1.6M-cell scratch buffer, bebop.bp:5764, made 12 back-to-back use_expand calls in
// one process exhaust a 256 MB arena, probed 2026-09-07) can skip re-running use_expand and
// just concatenate this text onto that cached prefix.
fn gen_kernel_row(dst: [i64], pos: [i64], sr: i64) -> i64 {
  let _ = wr_str(dst, pos, "
fn kernel_row(base: [i64], M: i64, X: i64, i: i64) -> i64 {
  let lo = gb_row_lo(base, M, i);
  let hi = gb_row_hi(base, M, i);
  let k = lo;
  let acc = ");
  let _ = wr_init(dst, pos, sr);
  let _ = wr_str(dst, pos, ";
  while k < hi {
    let j = gb_col(base, M, k);
    let w = gb_val(base, M, k);
");
  let _ = wr_row_body(dst, pos, sr);
  let _ = wr_str(dst, pos, "    let k = k + 1;
    0
  };
  acc
}
");
  0
}
fn gen_kernel_body(dst: [i64], pos: [i64], sr: i64, fieldidx: i64) -> i64 {
  let _ = gen_kernel_row(dst, pos, sr);
  let _ = wr_str(dst, pos, "
fn main(argc: i64, argv: [str]) -> i64 {
  let path = zeros(256);
  let pl = st_str(path, argv[2]);
  let tmp = zeros(1024);
  let base = st_map_ro(path, pl, 4194304);
  let root = st_root(base, tmp);
  let M = st_ref(base, root, ");
  let _ = wr_i64(dst, pos, fieldidx);
  let _ = wr_str(dst, pos, ");
  let X = st_ref(base, root, 2);
  let n = 1000;
  let i = 0;
  let fold = 0;
  while i < n {
    let acc = kernel_row(base, M, X, i);
    let fold = fold + acc;
    let i = i + 1;
    0
  };
  fold
}
");
  0
}
// gen_kernel_body_addr: the POOL-dispatch variant (B3 step 4) -- argv[2] is a DECIMAL i64
// (an already-mmap'd store base address, gb_atoi'd via st_cells), not a path the kernel would
// mmap itself. Needed because a SECOND file-backed mmap+dereference issued from code entered
// via sys_run (A11(b)) segfaults reproducibly (probed 2026-09-07) even though the identical
// mmap+dereference works fine run directly or from a plain forked process -- gb.bp's own
// header comment on gb_atoi has the full story. The dispatcher (gb_kernel_run) mmaps the data
// store itself (a NORMAL, non-sys_run'd mmap) and hands the kernel the resulting address.
fn gen_kernel_body_addr(dst: [i64], pos: [i64], sr: i64, fieldidx: i64) -> i64 {
  let _ = gen_kernel_row(dst, pos, sr);
  let _ = wr_str(dst, pos, "
fn main(argc: i64, argv: [str]) -> i64 {
  let addr = gb_atoi(argv[2]);
  let base = st_cells(addr);
  let tmp = zeros(1024);
  let root = st_root(base, tmp);
  let M = st_ref(base, root, ");
  let _ = wr_i64(dst, pos, fieldidx);
  let _ = wr_str(dst, pos, ");
  let X = st_ref(base, root, 2);
  let n = 1000;
  let i = 0;
  let fold = 0;
  while i < n {
    let acc = kernel_row(base, M, X, i);
    let fold = fold + acc;
    let i = i + 1;
    0
  };
  fold
}
");
  0
}
// ---- op 5 "bfs": B3 step 4 design item (f) -- a COMPLETE generated program: the whole
// Beamer direction-optimising BFS level loop (push while the frontier is small, pull once
// nf*14 > n-reached -- the SAME alpha=14 switch, SAME fold formula as selfhost/std/sgraph2.bp's
// own bfs_frontier/push_step/pull_step, :318-435) baked into ONE dispatch, over a store
// GbMatrix (gb_row_lo/gb_row_hi/gb_col -- fmt/mask/tr are not used: BFS is unweighted,
// unmasked, symmetric-CSR only). Two `main` variants share the same core text (gen_bfs_core):
// _path (argv[2] = a full store PATH the kernel maps itself with st_map_ro, argv[3] = source
// vertex decimal -- for direct shell-compiled dispatch, gb_bfs_gen's gate and std_golden.sh)
// and _addr (argv[2] = an ALREADY-MAPPED store base address decimal, argv[3] = a GbMatrix cell
// OFFSET decimal (object-relative, so valid regardless of the caller's own mmap address),
// argv[4] = source vertex decimal -- for sgraph2.bp's own fork+premap+sys_run dispatcher: a
// kernel entered via sys_run must never call st_map_ro itself a SECOND time, gb_run.bp's own
// header comment on gb_kernel_run_child has the full story). fmt=2 in gen_gb(dir,5,sr,mask,fmt,tr)
// selects _addr, any other fmt selects _path -- reuses the (op,sr,mask,fmt,tr) key's existing
// "fmt accepted for forward compatibility" slot (this file's own header comment) instead of a
// new parameter.
fn gen_bfs_core(dst: [i64], pos: [i64]) -> i64 {
  wr_str(dst, pos, "
// E2 (ROADMAP): the push inner loop is BRANCHLESS -- always write, subtract later. The old loop
// read vis[u], then took two data-dependent branches per edge slot around two STORES, which is
// the one shape A2's csel cannot cover (csel selects a value, it cannot suppress a store). Here
// every neighbour is OR'ed into nx unconditionally and the level's bookkeeping is done once, in
// gbfs_settle. The set of newly-discovered vertices is unchanged by construction: nx accumulates
// N(frontier) with duplicates and already-visited vertices included, and nx & ~vis is exactly
// N(frontier) minus everything seen up to and including this frontier -- the same set the old
// per-slot test admitted, so the fold is identical. It also drops one random line touch per slot
// (the vis read/write), so a speedup here is NOT attributable to the branches alone.
fn gbfs_push(base: [i64], M: i64, fr: [i64], nx: [i64], nw: i64) -> i64 {
  let w = 0;
  while w < nw {
    while fr[w] != 0 {
      let x = fr[w];
      let low = x & (0 - x);
      let _ = fr[w] = x - low;
      let v = w * 64 + 63 - clz(low);
      let k = gb_row_lo(base, M, v);
      let hi = gb_row_hi(base, M, v);
      while k < hi {
        let u = gb_col(base, M, k);
        let _ = gb_setbit(nx, u);
        let k = k + 1;
        0
      };
      0
    };
    let w = w + 1;
    0
  };
  0
}
// gbfs_settle(vis, nx, nw, cnt): the once-per-level half of E2 -- nx &= ~vis, vis |= nx, and
// count what survived. The count is a Kernighan drain (y &= y-1) rather than a popcount builtin:
// it runs once per NEWLY DISCOVERED vertex, so it costs n over the whole BFS against the 2*e edge
// slots the push loop walks, and it needs no new instruction word. cnt is a cell, not a rebind,
// for the same reason push_step's is (cross-loop state, and the two engines disagree on rebind
// visibility past a loop).
fn gbfs_settle(vis: [i64], nx: [i64], nw: i64, cnt: [i64]) -> i64 {
  let w = 0;
  while w < nw {
    let b = nx[w] & (0 - 1 - vis[w]);
    let _ = nx[w] = b;
    let _ = vis[w] = vis[w] | b;
    let y = b;
    while y != 0 {
      let y = y & (y - 1);
      let _ = cnt[0] = cnt[0] + 1;
      0
    };
    let w = w + 1;
    0
  };
  0
}
fn gbfs_pull(base: [i64], M: i64, fr: [i64], vis: [i64], nx: [i64], n: i64, cnt: [i64]) -> i64 {
  let u = 0;
  while u < n {
    let unseen = 1 - gb_bit(vis, u);
    let k = if unseen == 1 then gb_row_lo(base, M, u) else 0;
    let hi = if unseen == 1 then gb_row_hi(base, M, u) else 0;
    let found = 0;
    while k < hi {
      let v = gb_col(base, M, k);
      let hit = gb_bit(fr, v);
      let found = if hit == 1 then 1 else found;
      let k = if hit == 1 then hi else k + 1;
      0
    };
    let _ = if found == 1 then gb_setbit(vis, u) else 0;
    let _ = if found == 1 then gb_setbit(nx, u) else 0;
    let _ = cnt[0] = cnt[0] + found;
    let u = u + 1;
    0
  };
  0
}
// gbfs_frontier: `level` is deliberately NOT tracked (write-only in the reference
// selfhost/std/sgraph2.bp's own push_step/pull_step too -- the fold only ever needs `acc`,
// never a per-vertex level) -- dropped here specifically because a forked child's arena is
// hard-capped to an 8 MiB window (sys_clone's own codegen, WORKER-CARD) and `zeros(n)` for
// `level` alone is 7.63 MiB at n=1,000,000 (selfhost/std/sgraph2.bp's own 1M-node graph),
// leaving no room for fr/nx/vis or the dispatcher's own small buffers -- see B3 step 4 (f)'s
// worker report. fr/nx/vis alone (~375 KB total at n=1M) fit comfortably.
fn gbfs_frontier(base: [i64], M: i64, n: i64, s: i64) -> i64 {
  let nw = (n + 63) >> 6;
  let fr = zeros(nw);
  let nx = zeros(nw);
  let vis = zeros(nw);
  let _ = gb_setbit(fr, s);
  let _ = gb_setbit(vis, s);
  let acc = 1;
  let reached = 1;
  let lv = 1;
  let nf = 1;
  let cnt = zeros(1);
  while nf > 0 {
    let _ = cnt[0] = 0;
    let pull = if nf * 14 > n - reached then 1 else 0;
    let _ = if pull == 1 then gbfs_pull(base, M, fr, vis, nx, n, cnt) else gbfs_push(base, M, fr, nx, nw);
    let _ = if pull == 1 then 0 else gbfs_settle(vis, nx, nw, cnt);
    let nf = cnt[0];
    let reached = reached + nf;
    let acc = acc + nf * (lv + 1);
    let w = 0;
    while w < nw {
      let _ = fr[w] = nx[w];
      let _ = nx[w] = 0;
      let w = w + 1;
      0
    };
    let lv = lv + 1;
    0
  };
  acc
}
")
}
fn gen_bfs_main_path(dst: [i64], pos: [i64]) -> i64 {
  wr_str(dst, pos, "
fn main(argc: i64, argv: [str]) -> i64 {
  let path = zeros(256);
  let pl = st_str(path, argv[2]);
  let tmp = zeros(1024);
  let base = st_map_ro(path, pl, 536870912);
  let root = st_root(base, tmp);
  let M = st_ref(base, root, 0);
  let n = st_get(base, M, 0);
  let s = gb_atoi(argv[3]);
  gbfs_frontier(base, M, n, s)
}
")
}
fn gen_bfs_main_addr(dst: [i64], pos: [i64]) -> i64 {
  wr_str(dst, pos, "
fn main(argc: i64, argv: [str]) -> i64 {
  let base = st_cells(gb_atoi(argv[2]));
  let M = gb_atoi(argv[3]);
  let n = st_get(base, M, 0);
  let s = gb_atoi(argv[4]);
  gbfs_frontier(base, M, n, s)
}
")
}
fn gen_bfs_text_path(dst: [i64], pos: [i64]) -> i64 {
  let _ = wr_use_line(dst, pos, "selfhost/prelude/sha256.bp");
  let _ = wr_use_line(dst, pos, "selfhost/prelude/store.bp");
  let _ = wr_use_line(dst, pos, "selfhost/prelude/gb.bp");
  let _ = gen_bfs_core(dst, pos);
  gen_bfs_main_path(dst, pos)
}
fn gen_bfs_text_addr(dst: [i64], pos: [i64]) -> i64 {
  let _ = wr_use_line(dst, pos, "selfhost/prelude/sha256.bp");
  let _ = wr_use_line(dst, pos, "selfhost/prelude/store.bp");
  let _ = wr_use_line(dst, pos, "selfhost/prelude/gb.bp");
  let _ = gen_bfs_core(dst, pos);
  gen_bfs_main_addr(dst, pos)
}

// ---- op 6 "mbfs": ROADMAP E1 -- S-source (S <= 64) BFS in ONE i64 cell per vertex, bit s of
// fr[v] meaning "v is in source s's frontier". The push is `nx[u] |= fr[v]` under the (OR, AND)
// semiring, so S traversals share every gather; the fold is IDENTICAL to the sum of S separate
// op=5 single-source folds by construction (every reached (vertex, source) pair contributes
// level+1). Same store GbMatrix, same push/pull shape and the SAME two main variants as op=5
// (fmt == 2 selects _addr, anything else _path); _path takes the source COUNT in argv[3] where
// op=5 takes a source vertex, because the source list is fixed (gmb_src: LCG 31337) so that the
// two kernels' folds are comparable term by term.
// MEASURED 2026-09-08 on 351c288 (so E2's branchless gbfs_push is underneath the op=5 baseline),
// n = 10^6 / 10^7 CSR slots, SHIPPED generated kernels, process-included wall, core 4 inside
// tools/slot.sh, 3 interleaved reps, fold 462119596 IDENTICAL in every arm: op=6 S=64 is
// 2730/2776/2898 ms against 64 separate op=5 runs at 17318/17265/17316 ms (6.24x) and against
// ONE op=5 run at 348/322/308 ms (8.6x). E1's gate is `64-source wall <= 4x a single-source BFS,
// i.e. >= 16x the per-source cost of running them separately` and it is NOT met in either form.
// The bit-parallel MECHANISM is not what fails -- it over-delivers. With the pull direction
// disabled on both sides (alpha = 0) this same kernel runs 763 ms at S=1 and 2583 ms at S=64:
// 64 traversals for 3.39x the time, an 18.9x sharing win, ABOVE the gate's 16x. What the gate
// actually measures is that the BASELINE gets something a 64-source traversal cannot -- DIRECTION
// OPTIMISATION. A single-source pull stops at the FIRST frontier neighbour; a 64-source pull must
// keep reading until every still-missing source's bit turns up, so it degenerates to a full row
// scan. That is worth 3.36x to op=5 (227 ms in-process against this kernel's 763 ms push-only
// S=1), and 18.9 / 3.36 = 5.6x is the measured 4.9x (in-process) to 6.2x (wall).
// alpha = 2 below, not op=5's 14: measured here, alpha 2 beats alpha 14 at EVERY S (S=1 228
// against 918 ms, S=4 615 against 1778, S=16 2310 against 3662, S=64 2877 against 4117) and beats
// alpha 0 by 3.3x at S=1 (228 against 763) while giving up 11 % to it at S=64 (2877 against
// 2583) -- the pull direction is worth almost nothing once S is large, exactly as the mechanism
// predicts. See the VERDICT line in docs/exp.journal.
fn gen_mbfs_p1(dst: [i64], pos: [i64]) -> i64 {
  wr_str(dst, pos, "
// ---- E1: S-source (S <= 64) bit-parallel BFS, one i64 frontier cell per vertex ----
// gmb_pc: SWAR popcount (no popcount builtin in this language; `>>` is LOGICAL, `>>>` is the
// arithmetic form, so the masked-shift identities below are the plain textbook ones).
fn gmb_pc(x: i64) -> i64 {
  let a = x - ((x >> 1) & 6148914691236517205);
  let b = (a & 3689348814741910323) + ((a >> 2) & 3689348814741910323);
  let c = (b + (b >> 4)) & 1085102592571150095;
  let d = c * 72340172838076673;
  (d >> 56) & 255
}
// gmb_src(i, n): source vertex i of the fixed LCG(31337) list -- the SAME list the separate
// single-source runs use, so the two folds are comparable term by term.
fn gmb_src(i: i64, n: i64) -> i64 {
  let x = 31337;
  let j = 0;
  while j <= i {
    let x = x * 6364136223846793005 + 1442695040888963407;
    let j = j + 1;
    0
  };
  (x >> 20) % n
}
// gmb_push: for every vertex v carrying frontier bits, OR those bits into every neighbour's
// next-frontier cell -- `nx[u] |= fr[v]` IS the (OR, AND) semiring push, S traversals sharing
// one gather. RP/CI are the CSR arrays hoisted OUT of the loop (gb_row_lo/gb_col would redo
// `st_ref(base, M, 4)` per slot, a second dependent load); `anx` is set UNCONDITIONALLY --
// m is never 0 for a vertex in `act`, so nx[u] is always non-zero afterwards and the
// data-dependent branch a conditional set would need is pure loss.
")
}
fn gen_mbfs_p2(dst: [i64], pos: [i64]) -> i64 {
  wr_str(dst, pos, "fn gmb_push(base: [i64], RP: ref GbArr, CI: ref GbArr, act: [i64], fr: [i64], nx: [i64], anx: [i64], nw: i64) -> i64 {
  let w = 0;
  while w < nw {
    while act[w] != 0 {
      let x = act[w];
      let low = x & (0 - x);
      let _ = act[w] = x - low;
      let v = w * 64 + 63 - clz(low);
      let m = fr[v];
      let _ = fr[v] = 0;
      let k = arr_get(base, RP, v);
      let hi = arr_get(base, RP, v + 1);
      while k < hi {
        let u = arr_get(base, CI, k);
        let _ = nx[u] = nx[u] | m;
        let _ = anx[u >> 6] = anx[u >> 6] | (1 << (u & 63));
        let k = k + 1;
        0
      };
      0
    };
    let w = w + 1;
    0
  };
  0
}
// gmb_pull_row: the bottom-up scan of u's row -- OR together the frontier bits of u's
// neighbours, stopping early only once EVERY still-missing source has been found. That early
// exit is the whole value of Beamer's pull direction and it WEAKENS as S grows: a single-source
// pull stops at the first frontier neighbour, a 64-source pull usually reads the whole row.
fn gmb_pull_row(base: [i64], RP: ref GbArr, CI: ref GbArr, fr: [i64], u: i64, need: i64) -> i64 {
  let k = arr_get(base, RP, u);
  let hi = arr_get(base, RP, u + 1);
  let got = 0;
  while k < hi {
    let v = arr_get(base, CI, k);
    let got = got | (fr[v] & need);
    let k = if got == need then hi else k + 1;
    0
  };
  got
}
fn gmb_pull(base: [i64], RP: ref GbArr, CI: ref GbArr, fr: [i64], vis: [i64], nx: [i64], anx: [i64], n: i64, full: i64) -> i64 {
  let u = 0;
  while u < n {
    let need = full & (0 - 1 - vis[u]);
    let got = if need != 0 then gmb_pull_row(base, RP, CI, fr, u, need) else 0;
    let _ = if got != 0 then (let _ = nx[u] = got in 0) else 0;
    let _ = if got != 0 then (let _ = anx[u >> 6] = anx[u >> 6] | (1 << (u & 63)) in 0) else 0;
    let u = u + 1;
    0
  };
  0
}
")
}
fn gen_mbfs_p3(dst: [i64], pos: [i64]) -> i64 {
  wr_str(dst, pos, "// gmb_drain: zero the frontier cells the pull direction read but did not consume (the push
// direction clears fr[v] as it drains act; the pull direction cannot).
fn gmb_drain(act: [i64], fr: [i64], nw: i64) -> i64 {
  let w = 0;
  while w < nw {
    while act[w] != 0 {
      let x = act[w];
      let low = x & (0 - x);
      let _ = act[w] = x - low;
      let _ = fr[w * 64 + 63 - clz(low)] = 0;
      0
    };
    let w = w + 1;
    0
  };
  0
}
// gmb_cell: settle one candidate cell. cnt[0] += newly discovered (vertex, source) PAIRS (the
// fold's level term AND the emptiness test in one accumulator), cnt[1] += new frontier
// VERTICES, cnt[2] += vertices that just became reached-from-every-source (the pull switch's
// own denominator).
fn gmb_cell(fr: [i64], vis: [i64], nx: [i64], act: [i64], u: i64, full: i64, cnt: [i64]) -> i64 {
  let ov = vis[u];
  let d = nx[u] & (0 - 1 - ov);
  let _ = nx[u] = 0;
  let _ = fr[u] = d;
  let nv = ov | d;
  let _ = vis[u] = nv;
  let hit = if d != 0 then 1 else 0;
  let fl = if nv == full then 1 else 0;
  let _ = cnt[0] = cnt[0] + gmb_pc(d);
  let _ = cnt[1] = cnt[1] + hit;
  let _ = cnt[2] = cnt[2] + hit * fl;
  let _ = act[u >> 6] = act[u >> 6] | (hit << (u & 63));
  0
}
fn gmb_settle(fr: [i64], vis: [i64], nx: [i64], anx: [i64], act: [i64], nw: i64, full: i64, cnt: [i64]) -> i64 {
  let w = 0;
  while w < nw {
    let av = anx[w];
    let _ = anx[w] = 0;
    while av != 0 {
      let low = av & (0 - av);
      let av = av - low;
      let _ = gmb_cell(fr, vis, nx, act, w * 64 + 63 - clz(low), full, cnt);
      0
    };
    let w = w + 1;
    0
  };
  0
}
")
}
fn gen_mbfs_p4(dst: [i64], pos: [i64]) -> i64 {
  wr_str(dst, pos, "fn gmb_step(base: [i64], RP: ref GbArr, CI: ref GbArr, fr: [i64], vis: [i64], nx: [i64], anx: [i64], act: [i64], n: i64, nw: i64, full: i64, pull: i64, cnt: [i64]) -> i64 {
  let _ = if pull == 1 then gmb_pull(base, RP, CI, fr, vis, nx, anx, n, full) else gmb_push(base, RP, CI, act, fr, nx, anx, nw);
  let _ = if pull == 1 then gmb_drain(act, fr, nw) else 0;
  gmb_settle(fr, vis, nx, anx, act, nw, full, cnt)
}
fn gmb_clear(fr: [i64], vis: [i64], nx: [i64], anx: [i64], act: [i64], n: i64, nw: i64) -> i64 {
  let i = 0;
  while i < n {
    let _ = fr[i] = 0;
    let _ = vis[i] = 0;
    let _ = nx[i] = 0;
    let i = i + 1;
    0
  };
  let w = 0;
  while w < nw {
    let _ = anx[w] = 0;
    let _ = act[w] = 0;
    let w = w + 1;
    0
  };
  0
}
fn gmb_seed(fr: [i64], vis: [i64], act: [i64], n: i64, S: i64, off: i64) -> i64 {
  let i = 0;
  while i < S {
    let v = gmb_src(off + i, n);
    let b = 1 << i;
    let _ = fr[v] = fr[v] | b;
    let _ = vis[v] = vis[v] | b;
    let _ = act[v >> 6] = act[v >> 6] | (1 << (v & 63));
    let i = i + 1;
    0
  };
  0
}
// gmb_run: S-source bit-parallel BFS over the source-list window off..off+S-1.
// want 0 -> the fold, IDENTICAL by construction to the sum of the S separate single-source
//           gbfs_frontier folds: every reached (vertex, source) pair contributes level+1, and
//           each source contributes 1 for itself.
// want 1 -> the number of lockstep LEVELS the loop ran (level 0 = the sources).
")
}
fn gen_mbfs_p5(dst: [i64], pos: [i64]) -> i64 {
  wr_str(dst, pos, "// The frontier is bits, so `is the frontier empty` is cnt[0] -- the popcount gmb_cell already
// pays for the fold, one SWAR popcount per SETTLED CELL (not per vertex, not per edge), plus
// the settle pass's own nw-word sweep of `anx`. Neither is a separate emptiness test.
fn gmb_run(base: [i64], M: i64, n: i64, S: i64, off: i64, want: i64, alpha: i64, fr: [i64], vis: [i64], nx: [i64], anx: [i64], act: [i64], cnt: [i64]) -> i64 {
  let nw = (n + 63) >> 6;
  let full = (0 - 1) >> (64 - S);
  let RP = st_ref(base, M, 4);
  let CI = st_ref(base, M, 5);
  let _ = gmb_clear(fr, vis, nx, anx, act, n, nw);
  let _ = gmb_seed(fr, vis, act, n, S, off);
  let acc = S;
  let lv = 1;
  let nfv = S;
  let nfull = 0;
  let go = 1;
  while go == 1 {
    let _ = cnt[0] = 0;
    let _ = cnt[1] = 0;
    let _ = cnt[2] = 0;
    let pull = if nfv * alpha > n - nfull then 1 else 0;
    let _ = gmb_step(base, RP, CI, fr, vis, nx, anx, act, n, nw, full, pull, cnt);
    let acc = acc + cnt[0] * (lv + 1);
    let nfv = cnt[1];
    let nfull = nfull + cnt[2];
    let go = if cnt[0] > 0 then 1 else 0;
    let lv = lv + go;
    0
  };
  if want == 1 then lv else acc
}
")
}
fn gen_mbfs_core(dst: [i64], pos: [i64]) -> i64 {
  let _ = gen_mbfs_p1(dst, pos);
  let _ = gen_mbfs_p2(dst, pos);
  let _ = gen_mbfs_p3(dst, pos);
  let _ = gen_mbfs_p4(dst, pos);
  gen_mbfs_p5(dst, pos)
}

fn gen_mbfs_wrap(dst: [i64], pos: [i64]) -> i64 {
  wr_str(dst, pos, "
// gmbfs_frontier(base, M, n, S): the entry point -- allocate the five S-source buffers and run
// the (OR, AND) traversal. alpha = 2, not op=5's 14: pull's early exit needs every still-missing
// source's bit, so its value decays with S and the switch has to be later (measured, E1).
fn gmbfs_frontier(base: [i64], M: i64, n: i64, S: i64) -> i64 {
  let nw = (n + 63) >> 6;
  let fr = zeros(n);
  let vis = zeros(n);
  let nx = zeros(n);
  let anx = zeros(nw);
  let act = zeros(nw);
  let cnt = zeros(4);
  gmb_run(base, M, n, S, 0, 0, 2, fr, vis, nx, anx, act, cnt)
}
")
}
fn gen_mbfs_main_path(dst: [i64], pos: [i64]) -> i64 {
  wr_str(dst, pos, "
fn main(argc: i64, argv: [str]) -> i64 {
  let path = zeros(256);
  let pl = st_str(path, argv[2]);
  let tmp = zeros(1024);
  let base = st_map_ro(path, pl, 536870912);
  let root = st_root(base, tmp);
  let M = st_ref(base, root, 0);
  let n = st_get(base, M, 0);
  let S = gb_atoi(argv[3]);
  gmbfs_frontier(base, M, n, S)
}
")
}
fn gen_mbfs_main_addr(dst: [i64], pos: [i64]) -> i64 {
  wr_str(dst, pos, "
fn main(argc: i64, argv: [str]) -> i64 {
  let base = st_cells(gb_atoi(argv[2]));
  let M = gb_atoi(argv[3]);
  let n = st_get(base, M, 0);
  let S = gb_atoi(argv[4]);
  gmbfs_frontier(base, M, n, S)
}
")
}
fn gen_mbfs_text_path(dst: [i64], pos: [i64]) -> i64 {
  let _ = wr_use_line(dst, pos, "selfhost/prelude/sha256.bp");
  let _ = wr_use_line(dst, pos, "selfhost/prelude/store.bp");
  let _ = wr_use_line(dst, pos, "selfhost/prelude/gb.bp");
  let _ = gen_mbfs_core(dst, pos);
  let _ = gen_mbfs_wrap(dst, pos);
  gen_mbfs_main_path(dst, pos)
}
fn gen_mbfs_text_addr(dst: [i64], pos: [i64]) -> i64 {
  let _ = wr_use_line(dst, pos, "selfhost/prelude/sha256.bp");
  let _ = wr_use_line(dst, pos, "selfhost/prelude/store.bp");
  let _ = wr_use_line(dst, pos, "selfhost/prelude/gb.bp");
  let _ = gen_mbfs_core(dst, pos);
  let _ = gen_mbfs_wrap(dst, pos);
  gen_mbfs_main_addr(dst, pos)
}

// gen_kernel_text: the whole compilable .bp program (3 `use` lines + gen_kernel_body).
// fieldidx: which root ref carries the matrix to read (0 = A, mxv ; 1 = AT, vxm -- gen_gb.bp's
// own store layout, see gb_gen.bp).
fn gen_kernel_text(dst: [i64], pos: [i64], sr: i64, fieldidx: i64) -> i64 {
  let _ = wr_use_line(dst, pos, "selfhost/prelude/sha256.bp");
  let _ = wr_use_line(dst, pos, "selfhost/prelude/store.bp");
  let _ = wr_use_line(dst, pos, "selfhost/prelude/gb.bp");
  gen_kernel_body(dst, pos, sr, fieldidx)
}

// gen_path: `gb_<op>_<sr>_<mask>_<fmt>_<tr>.bp` under `dir` (no trailing slash). Returns the
// path length written into the caller's `path` buffer.
fn gen_path(dir: str, op: i64, sr: i64, mask: i64, fmt: i64, tr: i64, path: [i64]) -> i64 {
  let pos = zeros(1);
  let _ = wr_str(path, pos, dir);
  let _ = wr_str(path, pos, "/gb_");
  let _ = wr_opname(path, pos, op);
  let _ = wr_str(path, pos, "_");
  let _ = wr_i64(path, pos, sr);
  let _ = wr_str(path, pos, "_");
  let _ = wr_i64(path, pos, mask);
  let _ = wr_str(path, pos, "_");
  let _ = wr_i64(path, pos, fmt);
  let _ = wr_str(path, pos, "_");
  let _ = wr_i64(path, pos, tr);
  let _ = wr_str(path, pos, ".bp");
  pos[0]
}
// gen_write: op 1-4 emit the row-reduce mxv/vxm body (gen_kernel_text); op 5 (bfs) and op 6
// (mbfs, ROADMAP E1) emit the whole generated BFS program instead -- fmt==2 selects the _addr
// main (sgraph2.bp's premapped-address dispatcher), any other fmt the _path main (direct
// shell-compiled dispatch, std_golden.sh / the gb_bfs_gen and gb_mbfs_gen gates). Flat else-if
// chain (no if-expression nested inside another branch) -- WORKER-CARD's
// nested-if-as-call-argument trap.
fn gen_write(path: [i64], plen: i64, sr: i64, op: i64, fmt: i64) -> i64 {
  let text = zeros(16384);
  let tpos = zeros(1);
  let bfsaddr = if op == 5 then fmt else 0;
  let mbaddr = if op == 6 then fmt else 0;
  let _ = if bfsaddr == 2 then gen_bfs_text_addr(text, tpos) else if op == 5 then gen_bfs_text_path(text, tpos) else if mbaddr == 2 then gen_mbfs_text_addr(text, tpos) else if op == 6 then gen_mbfs_text_path(text, tpos) else gen_kernel_text(text, tpos, sr, op_fieldidx(op));
  let fd = sys_open(path, plen, 578);
  let _ = sys_export(fd, text, tpos[0]);
  sys_close(fd)
}
// gen_gb(dir, op, sr, mask, fmt, tr): op 1 mxv / 2 vxm / 3 dmxv / 4 dvxm / 5 bfs / 6 mbfs,
// sr 1..4 (sr ignored by ops 5 and 6) -- writes the kernel .bp file under dir and returns 0.
// Digest naming (step 4's st_digest-keyed Kernel objects) is out of scope here; the filename
// itself IS the digest for step 2's purposes.
fn gen_gb(dir: str, op: i64, sr: i64, mask: i64, fmt: i64, tr: i64) -> i64 {
  let path = zeros(512);
  let plen = gen_path(dir, op, sr, mask, fmt, tr, path);
  gen_write(path, plen, sr, op, fmt)
}

// ---- directed (UN-symmetrised) test matrix, coordinator review item 2 (2026-09-07): the
// symmetric random_lcg() graph can't tell mxv from vxm (A^T == A structurally, so every fold
// pairs up) -- this keeps only (u, v) with u < v from the SAME LCG pair stream (gb.bp's
// gb_gen_random_lcg), no reverse edge added, so mxv(DA,x) and vxm(x,DA) are genuinely
// different reductions. gb_build_pairs (gb.bp) can't be reused as-is -- it always adds BOTH
// directions -- so this is gb_build_pairs' own bitmap-drain shape (ascending key = u*n+v,
// gb.bp:164-203) with the symmetrise step dropped; same dedupe-via-bitmap, same stable
// counting-sort fill (gb_csr_fill_w), same gb_matrix_seal. n=1000 fixed (gb_gen.bp's scale).
fn build_directed_lt(base: [i64], tx: [i64], tmp: [i64], dg: [i64], psrc: [i64], pdst: [i64], mp: i64) -> i64 {
  let n = 1000;
  let bm = zeros((n * n + 63) / 64);
  let k = 0;
  while k < mp {
    let u = psrc[k];
    let v = pdst[k];
    let _ = if u < v then gb_setbit(bm, u * n + v) else 0;
    let k = k + 1;
    0
  };
  let key = 0;
  let cnt = 0;
  while key < n * n {
    let cnt = cnt + gb_bit(bm, key);
    let key = key + 1;
    0
  };
  let esrc = zeros(cnt);
  let edst = zeros(cnt);
  let eval = zeros(cnt);
  let key2 = 0;
  let idx = 0;
  while key2 < n * n {
    let hit = gb_bit(bm, key2);
    let uu = key2 / n;
    let vv2 = key2 % n;
    let _ = if hit == 1 then gb_hit_store(esrc, edst, eval, idx, uu, vv2, gb_edge_weight(uu, vv2)) else 0;
    let idx = idx + hit;
    let key2 = key2 + 1;
    0
  };
  let cur = zeros(n);
  let rp = arr_alloc(base, tx, dg[0], n + 1);
  let ci = arr_alloc(base, tx, dg[1], cnt);
  let vv = arr_alloc(base, tx, dg[2], cnt);
  let _ = gb_csr_fill_w(base, esrc, edst, eval, cnt, n, rp, ci, vv, cur);
  let _ = st_seal(base, rp, tmp);
  let _ = st_seal(base, ci, tmp);
  let _ = st_seal(base, vv, tmp);
  gb_matrix_seal(base, tx, tmp, dg[3], n, n, cnt, 1, rp, ci, vv)
}

// ---- B7 step 2: query templates (scan-filter-agg / scan-group-agg) ----
// gen_gb_query(dir, op, query_id): op 10 = scan-filter-agg (Q6 shape), op 11 = scan-group-agg (Q1 shape)
// query_id: 0 = default constants (for gate), or a small integer for variant constants.
// Writes a self-contained .bp program that reads the store, runs the fused scan,
// and returns the fold. These are the generated forms of the hand-written
// bench/tq_sqlite/tpch_q6.bp / tpch_q1.bp — same fused loop, baked constants,
// branchless mask-multiply-accumulate.
fn gen_q6_text(dst: [i64], pos: [i64]) -> i64 {
  let _ = wr_use_line(dst, pos, "selfhost/prelude/sha256.bp") in
  let _ = wr_use_line(dst, pos, "selfhost/prelude/store.bp") in
  let _ = wr_str(dst, pos, "
fn q6_scan(base: [i64], ship: i64, disc: i64, qty: i64, price: i64, n: i64) -> i64 {
  let lo = 727929;   // date(1994,1,1).toordinal()
  let hi = 728294;   // date(1995,1,1).toordinal(), exclusive
  let acc = 0;
  let i = 0;
  while i < n {
    let sd = st_get(base, ship, 1 + i);
    let dc = st_get(base, disc, 1 + i);
    let q = st_get(base, qty, 1 + i);
    let m1 = if sd >= lo then (if sd < hi then 1 else 0) else 0;
    let m2 = if dc >= 5 then (if dc <= 7 then 1 else 0) else 0;
    let m3 = if q < 24 then 1 else 0;
    let hit = m1 * m2 * m3;
    let ep = st_get(base, price, 1 + i);
    let acc = acc + hit * ep * dc;
    let i = i + 1;
    0
  };
  acc
}
fn main(argc: i64, argv: [str]) -> i64 {
  let spath = zeros(256);
  let sl = st_str(spath, argv[2]);
  let size = 67108864;
  let base = st_map_ro(spath, sl, size);
  let tmp = zeros(256);
  let root = st_root(base, tmp);
  let n = st_get(base, root, 0);
  let ship = st_ref(base, root, 1);
  let disc = st_ref(base, root, 2);
  let qty = st_ref(base, root, 3);
  let price = st_ref(base, root, 4);
  let fold = q6_scan(base, ship, disc, qty, price, n);
  let _ = sys_munmap(st_addr(base), size);
  fold
}
") in
  0
}

fn gen_q1_text(dst: [i64], pos: [i64]) -> i64 {
  let _ = wr_use_line(dst, pos, "selfhost/prelude/sha256.bp") in
  let _ = wr_use_line(dst, pos, "selfhost/prelude/store.bp") in
  let _ = wr_str(dst, pos, "
fn upd(ga: [i64], flag: i64, ls: i64, q: i64, ep: i64, dc: i64) -> i64 {
  let g = flag * 2 + ls;
  let b = g * 4;
  let _ = ga[b] = ga[b] + 1;
  let _ = ga[b + 1] = ga[b + 1] + q;
  let _ = ga[b + 2] = ga[b + 2] + ep;
  let _ = ga[b + 3] = ga[b + 3] + ep * (100 - dc);
  0
}
fn q1_scan(base: [i64], ship: i64, disc: i64, qty: i64, price: i64, rf: i64, ls: i64, n: i64, ga: [i64]) -> i64 {
  let cutoff = 729634;
  let i = 0;
  while i < n {
    let sd = st_get(base, ship, 1 + i);
    let ok = if sd <= cutoff then 1 else 0;
    let flag = st_get(base, rf, 1 + i);
    let lst = st_get(base, ls, 1 + i);
    let q = st_get(base, qty, 1 + i);
    let ep = st_get(base, price, 1 + i);
    let dc = st_get(base, disc, 1 + i);
    let _ = if ok == 1 then upd(ga, flag, lst, q, ep, dc) else 0;
    let i = i + 1;
    0
  };
  0
}
fn combine24(ga: [i64]) -> i64 {
  let acc = 0;
  let k = 0;
  while k < 24 {
    let acc = acc * 1000003 + ga[k];
    let k = k + 1;
    0
  };
  acc
}
fn main(argc: i64, argv: [str]) -> i64 {
  let spath = zeros(256);
  let sl = st_str(spath, argv[2]);
  let size = 67108864;
  let base = st_map_ro(spath, sl, size);
  let tmp = zeros(256);
  let root = st_root(base, tmp);
  let n = st_get(base, root, 0);
  let ship = st_ref(base, root, 1);
  let disc = st_ref(base, root, 2);
  let qty = st_ref(base, root, 3);
  let price = st_ref(base, root, 4);
  let rf = st_ref(base, root, 5);
  let ls = st_ref(base, root, 6);
  let ga = zeros(24);
  let _ = q1_scan(base, ship, disc, qty, price, rf, ls, n, ga);
  let fold = combine24(ga);
  let _ = sys_munmap(st_addr(base), size);
  fold
}
") in
  0
}

// gen_gb_query: writes a query-kernel .bp file. op 10 = Q6 (scan-filter-agg),
// op 11 = Q1 (scan-group-agg). query_id is reserved for future constant variation.
fn gen_gb_query(dir: str, op: i64, query_id: i64) -> i64 {
  let path = zeros(512) in
  let pos = zeros(1) in
  let _ = wr_str(path, pos, dir) in
  let _ = if op == 11 then wr_str(path, pos, "/q1_query.bp") else wr_str(path, pos, "/q6_query.bp") in
  let plen = pos[0] in
  let text = zeros(16384) in
  let tpos = zeros(1) in
  let _ = if op == 11 then gen_q1_text(text, tpos) else gen_q6_text(text, tpos) in
  let fd = sys_open(path, plen, 578) in
  let _ = sys_export(fd, text, tpos[0]) in
  sys_close(fd)
}
