// selfhost/std/interval.bp — integer interval arithmetic over i64.
// Intervals are closed [lo, hi]; empty if lo > hi. No floats/u64/structs
// in Bebop, so an interval is passed as its two endpoints.

module core { }

// contains: 1 if point x lies in [lo, hi], else 0.
fn contains(lo: i64, hi: i64, x: i64) -> i64 {
  (if lo <= x then 1 else 0) * (if x <= hi then 1 else 0)
}

// overlaps: 1 if [alo, ahi] and [blo, bhi] share at least one point, else 0.
fn overlaps(alo: i64, ahi: i64, blo: i64, bhi: i64) -> i64 {
  (if alo <= bhi then 1 else 0) * (if blo <= ahi then 1 else 0)
}

// intersection_len: length (number of integer points) of the overlap of two
// intervals; 0 if they are disjoint.
fn intersection_len(alo: i64, ahi: i64, blo: i64, bhi: i64) -> i64 {
  let l = if alo > blo then alo else blo;
  let h = if ahi < bhi then ahi else bhi;
  if l <= h then (h - l + 1) else 0
}

// union_len: length (number of integer points) covered by the union of two
// intervals. Disjoint gaps are not counted as covered.
fn union_len(alo: i64, ahi: i64, blo: i64, bhi: i64) -> i64 {
  let la = ahi - alo + 1;
  let lb = bhi - blo + 1;
  la + lb - intersection_len(alo, ahi, blo, bhi)
}

// clamp: constrain x into [lo, hi] (assumes lo <= hi).
fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
  if x < lo then lo else (if x > hi then hi else x)
}
