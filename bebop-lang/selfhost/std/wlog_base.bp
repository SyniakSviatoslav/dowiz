// wlog_base.bp -- the first half of selfhost/std/wlog.bp (ROADMAP B8), split out by W-BATGREEN
// 2026-09-29 because wlog.bp had grown to 959 lines against the 800-line cap for .bp files
// (tools/arch_check.py file-size). A pure MOVE, in the original order: the decimal parser, the
// CSR counting sort, event generation, the tail-log accessors, and the q1/q3 queries. wlog.bp
// `use`s this file right after its own four `use` lines, and `use` splices a file's text ahead of
// the user's body in use order, so the compiled program is the same function sequence as before
// -- CHECKED: the wlog binary compiled from the split pair is byte-identical to the one compiled
// from the single 959-line file (same compiler), and the wlog_* gates read the same values.
use "selfhost/prelude/store.bp"
use "selfhost/prelude/sha256.bp"
use "selfhost/std/ordfsm.bp"
use "selfhost/std/money.bp"
// parse(s): decimal string -> i64. NOT a builtin -- every std program defines its own
// (selfhost/std/sgraph2.bp:1143, sgraph.bp:150). wlog.bp called it without defining it, so
// every invocation that passed argv[4] died with `trap 87: call to an unresolved function`;
// the `if argc >= 5` guard meant the call never executed until n/k were first passed.
fn parse(s: str) -> i64 {
  let n = str_len(s);
  let i = 0;
  let v = 0;
  while i < n {
    let v = v * 10 + (char(s, i) - 48);
    let i = i + 1;
    0
  };
  v
}

// CSR three-pass counting sort
fn csr_passes(src: [i64], dst: [i64], m: i64, n: i64, cur: [i64], prp: [i64], pci: [i64]) -> i64 {
  let z = 0;
  while z < n + 2 {
    let _ = prp[z] = 0;
    let z = z + 1;
    0
  };
  let _ = prp[0] = n + 1;
  let i = 0;
  while i < m {
    let a = src[i];
    let _ = prp[2 + a] = prp[2 + a] + 1;
    let i = i + 1;
    0
  };
  let v = 0;
  while v < n {
    let _ = prp[2 + v] = prp[2 + v] + prp[1 + v];
    let _ = cur[v] = prp[1 + v];
    let v = v + 1;
    0
  };
  let _ = pci[0] = m;
  let j = 0;
  while j < m {
    let a = src[j];
    let s = cur[a];
    let _ = pci[1 + s] = dst[j];
    let _ = cur[a] = s + 1;
    let j = j + 1;
    0
  };
  0
}

// pick_set(m, r): the index of the r-th SET bit of m (12-bit masks).
fn pick_set(m: i64, r: i64) -> i64 {
  let kk = zeros(1);
  let chosen = zeros(1);
  let j = 0;
  while j < 12 {
    let bit = (m >> j) & 1;
    let _ = if bit == 1 then (
      let _ = if kk[0] == r then (let _ = chosen[0] = j in 0) else 0 in
      let _ = kk[0] = kk[0] + 1 in
      0
    ) else 0;
    let j = j + 1;
    0
  };
  chosen[0]
}

// gen_events: WALK the FSM from state 0 per order, ~1% injected illegal steps.
// A legal step picks from adj[cur]'s set bits, so decide() returns 0.
// An illegal step picks from the FORBIDDEN pool = complement of adj[cur], minus the
// current state (decide would say 1 SameStatus) and minus state 8 (it would say 2
// ScaffoldDisabled) -- 3839 is exactly the non-scaffold 12-bit mask. So an injected
// step returns 3 IllegalTransition and nothing else does, which is what makes
// injected == found a real equality. An illegal step does NOT advance cur.
fn gen_events(order_id: [i64], from: [i64], to: [i64], t: [i64], amount: [i64],
              n: i64, k: i64, adj: [i64], illegal_count: [i64]) -> i64 {
  let ev = zeros(1);
  let oid = zeros(1);
  let cur = zeros(1);
  let lcg_st = zeros(1);
  let _ = lcg_st[0] = 1234;
  while oid[0] < n {
    let _ = cur[0] = 0;
    let ek = 0;
    while ek < k {
      let _ = if adj[cur[0]] == 0 then (let _ = cur[0] = 0 in 0) else 0;
      let mask = adj[cur[0]];
      let _ = lcg_st[0] = ((lcg_st[0] * 1103515245) + 12345) & 2147483647;
      let lv = lcg_st[0];
      let ill = if (lv % 100) == 0 then 1 else 0;
      let selfbit = 1 << cur[0];
      let forb = ((mask ^ 4095) & (selfbit ^ 4095)) & 3839;
      let pool = if ill == 1 then forb else mask;
      let np = pc12(pool);
      let r = if np == 0 then 0 else (lv / 100) % np;
      let nxt = pick_set(pool, r);
      let _ = order_id[ev[0]] = oid[0];
      let _ = from[ev[0]] = cur[0];
      let _ = to[ev[0]] = nxt;
      let _ = t[ev[0]] = (ek * 1000) + (lv % 1000);
      let _ = amount[ev[0]] = (lv % 100) + 1;
      let _ = if ill == 1 then (let _ = illegal_count[0] = illegal_count[0] + 1 in 0) else 0;
      let _ = if ill == 0 then (let _ = cur[0] = nxt in 0) else 0;
      let _ = ev[0] = ev[0] + 1;
      let ek = ek + 1;
      0
    };
    let _ = oid[0] = oid[0] + 1;
    0
  };
  ev[0]
}

// Phase q1: fold through events using CSR,  return sum of final states
// ---- ROADMAP B4: the tiered tail ----
// Updates used to rewrite the ENTIRE log -- every array, both CSRs, the root -- for a batch of
// any size, which is O(m) per append and quadratic over a run. B4's shape (the same one
// sgraph2.bp's phase_log uses) is a small TAIL that appends absorb, promoted into the main
// arrays only when it fills.
//
// TAIL object: {cap, n, then n records of 5 cells (oid, from, to, t, amount)}.
// The tail is COPIED ONCE per transaction (copy-on-write) and appended into, so an append
// costs O(cap) rather than O(m). When cap would be exceeded the tail is PROMOTED: the main
// arrays and both indexes are rebuilt over main + tail, and the tail is emptied.
//
// Every read path folds main FIRST and the tail SECOND, which is the correct order because the
// tail holds strictly later events.
fn tl_cap() -> i64 { 4096 }
fn tl_n(base: [i64], tl: i64) -> i64 { st_get(base, tl, 1) }
fn tl_oid(base: [i64], tl: i64, i: i64) -> i64 { st_get(base, tl, 2 + 5 * i) }
fn tl_from(base: [i64], tl: i64, i: i64) -> i64 { st_get(base, tl, 3 + 5 * i) }
fn tl_to(base: [i64], tl: i64, i: i64) -> i64 { st_get(base, tl, 4 + 5 * i) }
fn tl_t(base: [i64], tl: i64, i: i64) -> i64 { st_get(base, tl, 5 + 5 * i) }
fn tl_amt(base: [i64], tl: i64, i: i64) -> i64 { st_get(base, tl, 6 + 5 * i) }

// apply every tail event to a per-order state array, in tail order
fn tl_apply(base: [i64], tl: i64, adj: [i64], state: [i64], upto_t: i64) -> i64 {
  let tn = tl_n(base, tl);
  let i = 0;
  while i < tn {
    let oid = tl_oid(base, tl, i);
    let f = tl_from(base, tl, i);
    let t = tl_to(base, tl, i);
    let tv = tl_t(base, tl, i);
    let ok = decide(adj, f, t);
    let okz = if ok == 0 then 1 else 0;
    let inwin = if tv < upto_t then 1 else 0;
    let _ = if okz * inwin == 1 then (let _ = state[oid] = t in 0) else 0;
    let i = i + 1;
    0
  };
  tn
}

fn phase_q1(base: [i64], tmp: [i64], n: i64, adj: [i64]) -> i64 {
  let g = st_root(base, tmp);
  let m = st_get(base, g, 0);
  let order_id = st_ref(base, g, 1);
  let from_st = st_ref(base, g, 2);
  let to_st = st_ref(base, g, 3);
  let rp = st_ref(base, g, 6);
  let ci = st_ref(base, g, 7);
  let state = zeros(n + 1);
  let oid = 0;
  while oid < n {
    let lo = st_get(base, rp, 1 + oid);
    let hi = st_get(base, rp, 2 + oid);
    let ev_idx = lo;
    while ev_idx < hi {
      let ev = st_get(base, ci, 1 + ev_idx);
      let f = st_get(base, from_st, ev);
      let t = st_get(base, to_st, ev);
      let ok_code = decide(adj, f, t);
      let _ = if ok_code == 0 then state[oid] = t else 0;
      let ev_idx = ev_idx + 1;
      0
    };
    let oid = oid + 1;
    0
  };
  let _ = tl_apply(base, st_ref(base, g, 10), adj, state, 999999999);
  let fold_h = 0;
  let i = 0;
  while i < n {
    let fold_h = fold_h + state[i];
    let i = i + 1;
    0
  };
  fold_h
}

// Phase q3: count decide codes per argv[3]: '0'=ok, '1'=same, '2'=scaffold, '3'=illegal
fn phase_q3(base: [i64], tmp: [i64], adj: [i64], which: i64) -> i64 {
  let g = st_root(base, tmp);
  let m = st_get(base, g, 0);
  let from_st = st_ref(base, g, 2);
  let to_st = st_ref(base, g, 3);
  let c = zeros(4);
  let ev = 0;
  while ev < m {
    let f = st_get(base, from_st, ev);
    let t = st_get(base, to_st, ev);
    let code = decide(adj, f, t);
    let idx = if code == 0 then 0 else (if code == 1 then 1 else (if code == 2 then 2 else 3));
    let _ = c[idx] = c[idx] + 1;
    let ev = ev + 1;
    0
  };
  let tl = st_ref(base, g, 10);
  let tn = tl_n(base, tl);
  let ti = 0;
  while ti < tn {
    let code = decide(adj, tl_from(base, tl, ti), tl_to(base, tl, ti));
    let idx = if code == 0 then 0 else (if code == 1 then 1 else (if code == 2 then 2 else 3));
    let _ = c[idx] = c[idx] + 1;
    let ti = ti + 1;
    0
  };
  if which == 48 then c[0] else (if which == 49 then c[1] else (if which == 50 then c[2] else (if which == 51 then c[3] else 0)))
}
