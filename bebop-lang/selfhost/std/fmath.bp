// selfhost/std/fmath.bp — scalar f64 math: sqrt, exp, ln.
// Port of native/src/math_native.c (math_sqrt / math_exp / math_ln) into pure
// Bebop f64 arithmetic. sqrt uses Newton's method, exp uses the Taylor series,
// and ln range-reduces into [0.5, 1.5] by powers of two before a Taylor series
// around 1 (plus the k·ln2 correction). Bebop has no NaN/±Inf, so domain errors
// are sentinels: sqrt(x<=0) = 0.0, ln(x<=0) = -1e18 (stands in for -inf).

module core { }

// sqrt: Newton iteration r = 0.5 * (r + x / r), 20 rounds (x > 0; else 0.0).
fn sqrt(x: f64) -> f64 {
  if x <= 0.0 then 0.0 else (
    let r = x;
    let i = 0;
    while i < 20 { let r = 0.5 * (r + x / r); let i = i + 1; 0 };
    r
  )
}

// exp: Taylor series exp(x) = sum_{i>=0} x^i / i!, 19 terms (faithful port).
fn exp(x: f64) -> f64 {
  let r = 1.0;
  let t = 1.0;
  let i = 1;
  while i < 20 { let t = t * (x / i); let r = r + t; let i = i + 1; 0 };
  r
}

// ln: natural log via range reduction + Taylor series around 1.
fn ln(x: f64) -> f64 {
  if x <= 0.0 then (0.0 - 1000000000000000000.0) else (
    let k = 0;
    let y = x;
    while y > 1.5 { let y = y * 0.5; let k = k + 1; 0 };
    while y < 0.5 { let y = y * 2.0; let k = k - 1; 0 };
    let r = y - 1.0;
    let t = r;
    let s = r;
    let i = 2;
    while i < 40 { let t = t * (0.0 - r); let s = s + t / i; let i = i + 1; 0 };
    s + k * 0.6931471805599453
  )
}
