// selfhost/std/search.bp — linear + binary search over [i64].

module core { }

// linear_search: index of first x in arr[0..n), else -1.
fn linear_search(arr: [i64], n: i64, x: i64) -> i64 {
  let i = 0;
  let res = 0 - 1;
  let done = if i >= n then 1 else 0;
  while done == 0 {
    let hit = if arr[i] == x then 1 else 0;
    let res = if hit == 1 then i else res;
    let i = i + 1;
    let done = if hit == 1 then 1 else (if i >= n then 1 else 0);
    0
  };
  res
}

// binary_search: index of x in sorted arr[0..n), else -1.
fn binary_search(arr: [i64], n: i64, x: i64) -> i64 {
  let lo = 0;
  let hi = n - 1;
  let res = 0 - 1;
  let done = if lo > hi then 1 else 0;
  while done == 0 {
    let mid = (lo + hi) / 2;
    let v = arr[mid];
    let eq = if v == x then 1 else 0;
    let lt = if v < x then 1 else 0;
    let lo = if eq == 1 then lo else (if lt == 1 then mid + 1 else lo);
    let hi = if eq == 1 then hi else (if lt == 1 then hi else mid - 1);
    let res = if eq == 1 then mid else res;
    let done = if eq == 1 then 1 else (if lo > hi then 1 else 0);
    0
  };
  res
}
