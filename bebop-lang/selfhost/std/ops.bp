// selfhost/std/ops.bp — arithmetic stand-ins for bitwise/logic helpers.
// Bebop has no native bitwise operators or division, so these express
// boolean and bit-level predicates using only +, -, *.

module core { }

// Logical AND over 0/1 truth values: a * b.
fn land(a: i64, b: i64) -> i64 { a * b }

// Logical OR over 0/1 truth values: a + b - a*b.
fn lor(a: i64, b: i64) -> i64 { a + b - (a * b) }

// Logical XOR over 0/1 truth values: a + b - 2*a*b.
fn lxor(a: i64, b: i64) -> i64 { a + b - (2 * (a * b)) }

// Logical NOT over a 0/1 truth value: 1 - a.
fn lnot(a: i64) -> i64 { 1 - a }

// is_even(x): 1 if x is even, else 0 (parity via repeated subtraction).
fn is_even(x: i64) -> i64 {
  let r = x;
  let done = 0;
  while done == 0 {
    let r = if r >= 2 then r - 2 else r;
    let done = if r >= 2 then 0 else 1;
    0
  };
  if r == 0 then 1 else 0
}

// is_pow2(x): 1 if x is a positive power of two, else 0.
fn is_pow2(x: i64) -> i64 {
  if x <= 0 then 0 else (
    let p = 1;
    let ok = 0;
    let done = 0;
    while done == 0 {
      let eq = if p == x then 1 else 0;
      let ok = if eq == 1 then 1 else ok;
      let p = p * 2;
      let done = if eq == 1 then 1 else (if p > x then 1 else 0);
      0
    };
    ok
  )
}
