// selfhost/match_eval.bp — pattern-match dispatch via linear scan.
// match_tag(scrut, n_arms, arm_tags, arm_bodies): return the body of the
// first arm whose tag equals scrut. A linear scan over parallel arrays;
// no pattern is guaranteed unique, so the first match (lowest index) wins.
// No arm matches -> 0.

module core { }

fn match_tag(scrut:i64, n_arms:i64, arm_tags:[i64], arm_bodies:[i64])->i64 {
  let i = 0;
  let result = 0;
  let found = 0;
  while i < n_arms {
    let hit = if arm_tags[i] == scrut then 1 else 0;
    let result = if found == 0 then (if hit == 1 then arm_bodies[i] else result) else result;
    let found = if hit == 1 then 1 else found;
    let i = i + 1;
    0
  };
  result
}

// Self-test: tags [0,1,2] -> bodies [10,20,30]. match_tag(2, ...) == 30.
fn main() -> i64 {
  let tags = [0, 1, 2];
  let bodies = [10, 20, 30];
  match_tag(2, 3, tags, bodies)
}
