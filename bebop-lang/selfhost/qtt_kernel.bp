module core { }

// ty_eq: 6-param recursive type equality
// ki,kj=kind, ai,aj=dom, bi,bj=cod (for PI/VEC: dom/cod refer to sub-type kinds)
fn ty_eq(ki: i64, kj: i64, ai: i64, aj: i64, bi: i64, bj: i64) -> i64 {
  if ki == kj then
    (if ki == 0 then 1
     else if ki == 5 then 1
     else if ki == 11 then ty_eq(ai, aj, 0, 0, 0, 0)
     else if ki == 8 then (let d = ty_eq(ai, aj, 0, 0, 0, 0) in
                           (let c = ty_eq(bi, bj, 0, 0, 0, 0) in
                            if d == 1 then c else 0))
     else 0)
  else 0
}

// test: I64==I64 (1), BOOL==I64 (0), PI(I64,BOOL)==PI(I64,BOOL) (1)
fn test_ty_eq(x: i64) -> i64 {
  let eq1 = ty_eq(0, 0, 0, 0, 0, 0);
  let eq2 = ty_eq(0, 5, 0, 0, 0, 0);
  let eq3 = ty_eq(8, 8, 0, 0, 5, 5);
  eq1 + eq3
}
