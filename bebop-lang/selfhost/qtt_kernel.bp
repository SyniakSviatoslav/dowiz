module core { }

// ty_eq: recursive structural equality using Vec params
fn ty_eq(tk:[i64],ta:[i64],tb:[i64],i:i64,j:i64)->i64 {
  let ki = tk[i];
  let kj = tk[j];
  let keq = if ki == kj then 1 else 0;
  let base = if ki == 0 then 1 else (if ki == 5 then 1 else 0);
  let pid = if ki == 8 then ty_eq(tk,ta,tb,ta[i],ta[j]) else 0;
  let pic = if ki == 8 then ty_eq(tk,ta,tb,tb[i],tb[j]) else 0;
  let pi_ok = pid * pic;
  if keq == 1 then base + pi_ok else 0
}

// infer: determine type of an expression node
// ekind: node kind (0=lit, 1=var, 2=binop)
// ea[i]=left child, eb[i]=right child, ec[i]=extra
fn infer(ek:[i64],ea:[i64],eb:[i64],i:i64)->i64 {
  let k = ek[i];
  if k == 0 then 0 else
  (if k == 2 then infer(ek,ea,eb,ea[i]) else 0)
}

// test: build type pool + expr tree, run inference + equality
fn test(x:i64)->i64 {
  let tk = [0,5,8,8];
  let ta = [0,0,0,0];
  let tb = [0,0,5,5];
  let r = ty_eq(tk,ta,tb,2,3);
  r + infer([0],[0],[0],0)
}
