module core { }

fn ty_eq(tk:[i64],ta:[i64],tb:[i64],i:i64,j:i64)->i64 {
  let ki=tk[i];let kj=tk[j];let keq=if ki==kj then 1 else 0;
  let base=if ki==0 then 1 else(if ki==5 then 1 else 0);
  let pid=if ki==8 then ty_eq(tk,ta,tb,ta[i],ta[j]) else 0;
  let pic=if ki==8 then ty_eq(tk,ta,tb,tb[i],tb[j]) else 0;
  if keq==1 then base+pid*pic else 0
}

fn eval(ek:[i64],ev:[i64],ea:[i64],eb:[i64],i:i64)->i64 {
  let k=ek[i];
  if k==0 then ev[i] else
  (if k==2 then(let l=eval(ek,ev,ea,eb,ea[i])in(let r=eval(ek,ev,ea,eb,eb[i])in l+r))else 0)
}

fn check(ek:[i64],ev:[i64],ea:[i64],eb:[i64],i:i64,want:i64)->i64 {
  let k=ek[i];
  if k==0 then(if want==0 then 1 else 0) else
  (if k==2 then(let cl=check(ek,ev,ea,eb,ea[i],0)in
                (if cl==1 then check(ek,ev,ea,eb,eb[i],0) else 0)) else 0)
}

fn test(x:i64)->i64 {
  let ek=[0,2,0,0];let ev=[5,0,3,2];
  let ea=[0,0,2,0];let eb=[0,0,3,0];
  let v=eval(ek,ev,ea,eb,1);
  let c=check(ek,ev,ea,eb,1,0);
  v+c
}
