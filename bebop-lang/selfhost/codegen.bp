module core { }
fn movz(dst:i64,imm:i64)->i64 { 3531603968+(imm*32)+dst }
fn add_imm(dst:i64,src:i64,imm:i64)->i64 { 2432696320+(imm*1024)+(src*32)+dst }
fn ret()->i64 { 3596551104 }
fn sub_imm(dst:i64,src:i64,imm:i64)->i64 { 3506438144+(imm*1024)+(src*32)+dst }
fn ldr_imm(dst:i64,src:i64,byte_off:i64)->i64 { 4177526784+(byte_off*128)+(src*32)+dst }
fn str_imm(src_reg:i64,dst_base:i64,byte_off:i64)->i64 { 4179656704+(byte_off*128)+(dst_base*32)+src_reg }
fn mov_reg(dst:i64,src:i64)->i64 { 2852126720+(src*16)+dst }
fn emit_expr(ek:[i64],ev:[i64],ea:[i64],eb:[i64],i:i64)->i64 {
  let k=ek[i];
  let mz=if k==0 then movz(0,ev[i]) else 0;
  let ad=if k==2 then emit_expr(ek,ev,ea,eb,ea[i])+emit_expr(ek,ev,ea,eb,eb[i]) else 0;
  let su=if k==3 then emit_expr(ek,ev,ea,eb,ea[i])+emit_expr(ek,ev,ea,eb,eb[i]) else 0;
  let mu=if k==4 then emit_expr(ek,ev,ea,eb,ea[i])+emit_expr(ek,ev,ea,eb,eb[i]) else 0;
  let va=if k==5 then ev[i] else 0;
  let ap=if k==6 then emit_expr(ek,ev,ea,eb,ea[i])+emit_expr(ek,ev,ea,eb,eb[i]) else 0;
  mz+ad+su+mu+va+ap
}
fn count_instrs(ek:[i64],i:i64)->i64 {
  let k=ek[i];
  let lit=if k==0 then 1 else 0;
  let ad=if k==2 then count_instrs(ek,ea[i])+count_instrs(ek,eb[i])+1 else 0;
  let su=if k==3 then count_instrs(ek,ea[i])+count_instrs(ek,eb[i])+1 else 0;
  let mu=if k==4 then count_instrs(ek,ea[i])+count_instrs(ek,eb[i])+1 else 0;
  lit+ad+su+mu
}
fn checksum(ek:[i64],ev:[i64],ea:[i64],eb:[i64],i:i64)->i64 {
  let k=ek[i];
  let c_lit=if k==0 then movz(0,ev[i]) else 0;
  let c_add=if k==2 then checksum(ek,ev,ea,eb,ea[i])+checksum(ek,ev,ea,eb,eb[i])+add_imm(0,0,ev[i]) else 0;
  let c_sub=if k==3 then checksum(ek,ev,ea,eb,ea[i])+checksum(ek,ev,ea,eb,eb[i])+sub_imm(0,0,ev[i]) else 0;
  let c_mul=if k==4 then checksum(ek,ev,ea,eb,ea[i])+checksum(ek,ev,ea,eb,eb[i])+add_imm(0,0,0) else 0;
  c_lit+c_add+c_sub+c_mul
}
fn emit_entry(ek:[i64],ev:[i64],ea:[i64],eb:[i64],i:i64)->i64 {
  let cs=checksum(ek,ev,ea,eb,i); cs+ret()
}
fn emit_byte_size(ek:[i64],i:i64)->i64 {
  count_instrs(ek,i)*4
}
fn const_fold(ek:[i64],ev:[i64],ea:[i64],eb:[i64],i:i64)->i64 {
  let k=ek[i];
  let c_lit=if k==0 then ev[i] else 0;
  let c_add=if k==2 then const_fold(ek,ev,ea,eb,ea[i])+const_fold(ek,ev,ea,eb,eb[i]) else 0;
  c_lit+c_add
}
fn test(x:i64)->i64 { let ek=[0,0,2];let ev=[3,2,0];let ea=[0,0,0];let eb=[0,0,1]; const_fold(ek,ev,ea,eb,2) }
