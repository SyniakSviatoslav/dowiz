use "selfhost/prelude/sha256.bp"

// selfhost/tcheck.bp — F6: standalone certificate checker for Bebop's
// certificate format (docs/CERTIFICATE-FORMAT.md).
//
// This is a TRUSTED program: it reads a text certificate (p/c/r/d/x records),
// walks the hinted resolution chains, and verifies the sha256 obligation
// binding (15.1). No unit propagation, no search, no watched literals --
// hints make checking a loop.
//
// Usage: tcheck <certificate> [<obligation.obl>]
//
// With an obligation file the 15.1 binding is enforced: sha256 over the
// obligation's canonical text must equal the certificate's `x` line.
// Without it the derivation is still checked but the certificate is unbound.
//
// Standalone program, own 511-fn cap, never inside bebop.bp.
// Target audience: the gate chain (tools/chain.sh), not the compiler.

module core { }

// caps (SCAFFOLD: sized for the QF_ABV bit-blasted certificates we expect;
// literals inline, Bebop has no top-level consts)
//   nvars       <= 8192
//   clauses     <= 16384
//   lits/clause <= 32
//   hints/step  <= 64
//   line        <= 4096 bytes

// --- hex ---
fn nibble_to_hex(v: i64) -> i64 {
  let lo = if v < 10 then 1 else 0;
  lo * (v + 48) + (1 - lo) * (v - 10 + 97)
}

fn hex_u32(val: i64, buf: [i64], at: i64) -> i64 {
  let v = val & 4294967295;
  let i = 0;
  while i < 8 {
    let sh = (7 - i) * 4;
    let _ = buf[at + i] = nibble_to_hex((v >> sh) & 15);
    let i = i + 1;
    0
  };
  at + 8
}

// --- text-buffer writers (wr_s/wr_num: the gen_gb.bp:47-88 idiom verbatim).
// `pos` is a caller-owned 1-cell cursor; `dst` caller-owned and pre-sized;
// no allocation in here. sys_write packs low bytes of the cells. ---
fn wr_s(dst: [i64], pos: [i64], s: str) -> i64 {
  let off = pos[0];
  let n = str_len(s);
  let i = 0;
  while i < n {
    let _ = dst[off + i] = char(s, i);
    let i = i + 1;
    0
  };
  let _ = pos[0] = off + n;
  0
}

fn wr_num(dst: [i64], pos: [i64], v: i64) -> i64 {
  let off = pos[0];
  let neg = if v < 0 then 1 else 0;
  let m = if v < 0 then 0 - v else v;
  let p = off + 23;
  let m2 = m;
  let go = 1;
  while go == 1 {
    let d = m2 - (m2 / 10) * 10;
    let _ = dst[p] = 48 + d;
    let p = p - 1;
    let m2 = m2 / 10;
    let go = if m2 > 0 then 1 else 0;
    0
  };
  let start = p + 1;
  let len = (off + 24) - start;
  let i = 0;
  while i < len {
    let _ = dst[off + neg + i] = dst[start + i];
    let i = i + 1;
    0
  };
  let _ = if neg == 1 then (let _ = dst[off] = 45 in 0) else 0;
  let _ = pos[0] = off + len + neg;
  0
}

fn wr_ch(dst: [i64], pos: [i64], c: i64) -> i64 {
  let off = pos[0];
  let _ = dst[off] = c;
  let _ = pos[0] = off + 1;
  0
}

// --- line reader ---
// read one line (without the newline) from src into line[0..maxlen), NUL
// terminate, advance pos[0] past the newline; returns the byte count
fn read_line(src: str, pos: [i64], line: [i64], maxlen: i64) -> i64 {
  let started = pos[0];
  let n = 0;
  let src_len = str_len(src);
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= src_len then 1 else 0;
    let c = if at_end == 1 then 10 else char(src, pos[0]);
    let is_nl = if c == 10 then 1 else 0;
    let keep = (1 - is_nl) * (1 - at_end);
    let room = if n < maxlen then 1 else 0;
    let _ = if keep * room == 1 then (let _ = line[n] = c in 0) else 0;
    let n = n + keep * room;
    let _ = pos[0] = pos[0] + keep + is_nl * (1 - at_end);
    let done = is_nl + at_end;
    0
  };
  let _ = line[n] = 0;
  // -1 = EOF (no chars consumed); 0 = legitimate blank line
  if pos[0] == started then (0 - 1) else n
}

// --- tokenizer ---
// split a NUL-terminated line into whitespace-separated tokens; store token
// start offsets in toks[0..n), return the token count
fn tokenize(line: [i64], toks: [i64], maxtok: i64) -> i64 {
  let n = 0;
  let i = 0;
  let in_tok = 0;
  let done = 0;
  while done == 0 {
    let c = line[i];
    let is_end = if c == 0 then 1 else 0;
    let is_sp = (if c == 32 then 1 else 0) + (if c == 9 then 1 else 0);
    let entering = (1 - in_tok) * (1 - is_sp) * (1 - is_end);
    let _ = if entering == 1 then (if n < maxtok then (let _ = toks[n] = i in 0) else 0) else 0;
    let n = n + entering * (if n < maxtok then 1 else 0);
    let in_tok = entering + in_tok * (1 - is_sp) * (1 - is_end);
    let i = i + 1;
    let done = is_end;
    0
  };
  n
}

// --- integer parsing ---
// parse a decimal integer (optionally negative) from line starting at
// line[at]; the token must be a digit or '-'
fn parse_int(line: [i64], at: i64) -> i64 {
  let neg = if line[at] == 45 then 1 else 0;
  let at = at + neg;
  let v = 0;
  let done = 0;
  while done == 0 {
    let c = line[at];
    let is_d = (if c >= 48 then 1 else 0) * (if c <= 57 then 1 else 0);
    let v = v * 10 + (c - 48) * is_d;
    let at = at + is_d;
    let done = 1 - is_d;
    0
  };
  if neg == 1 then (0 - v) else v
}

// --- clause database ---
// slot-layered flat arrays: c_id[slot], c_len[slot],
// c_lits[slot*32 + 0..len). deleted slots keep c_id = -1.
fn clause_lookup(c_id: [i64], n: i64, id: i64) -> i64 {
  let i = 0;
  let found = 0 - 1;
  while i < n {
    let _ = if c_id[i] == id then (let _ = found = i in 0) else 0;
    let i = i + 1;
    0
  };
  found
}

fn clause_del(c_id: [i64], n: i64, id: i64) -> i64 {
  let i = 0;
  while i < n {
    let _ = if c_id[i] == id then (let _ = c_id[i] = 0 - 1 in 0) else 0;
    let i = i + 1;
    0
  };
  n
}

// --- assignment (direct-mapped: assign[var] in {-1,0,1}) ---
fn asgn_get(a: [i64], v: i64) -> i64 {
  let idx = if v >= 0 then v else (0 - v);
  if idx >= 32768 then 0 else a[idx]
}

fn asgn_set(a: [i64], v: i64, val: i64) -> i64 {
  let idx = if v >= 0 then v else (0 - v);
  let _ = if idx < 32768 then a[idx] = val else 0;
  0
}

// extend the assignment with the single unassigned literal of clause slot
fn asgn_unit(assign: [i64], c_lits: [i64], slot: i64) -> i64 {
  let j = 0;
  while j < 32 {
    let lv = c_lits[slot * 32 + j];
    let sv = if lv > 0 then lv else (0 - lv);
    let cur = asgn_get(assign, sv);
    let _ = if (lv != 0) * (cur == 0) == 1 then (let _ = asgn_set(assign, sv, if lv > 0 then 1 else (0 - 1)) in 0) else 0;
    let j = j + 1;
    0
  };
  0
}

// --- the whole check, and it is a loop ---
// assume the negation of the claimed clause, walk each hint in order: it must
// be unit (extend assignment) or falsified (conflict -> chain verified)
fn check_chain(c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64],
               lits: [i64], nl: i64, hints: [i64], nh: i64, assign: [i64]) -> i64 {
  let k = 0;
  while k < 32768 {
    let _ = assign[k] = 0;
    let k = k + 1;
    0
  };
  let i = 0;
  while i < nl {
    let v = lits[i];
    let _ = asgn_set(assign, v, if v > 0 then (0 - 1) else 1);
    let i = i + 1;
    0
  };
  let conflict = 0;
  let hi = 0;
  while (hi < nh) * (conflict == 0) == 1 {
    let hid = hints[hi];
    let slot = clause_lookup(c_id, n_cl[0], hid);
    let _ = if slot >= 0 then 0 else sys_exit(2);
    let hc_len = if slot >= 0 then c_len[slot] else 0;
    let satisfied = 0;
    let unassigned = 0;
    let j = 0;
    while j < hc_len {
      let lv = c_lits[slot * 32 + j];
      let sv = if lv >= 0 then lv else (0 - lv);
      let want = if lv > 0 then 1 else (0 - 1);
      let cur = asgn_get(assign, sv);
      let is_sat = (if cur == want then 1 else 0) * (1 - satisfied);
      let satisfied = satisfied + is_sat;
      let unassigned = unassigned + (if cur == 0 then 1 else 0);
      let j = j + 1;
      0
    };
    let _ = if satisfied == 0 then 0 else sys_exit(2);
    let _ = if unassigned > 1 then sys_exit(2) else 0;
    let conflict = conflict + (1 - conflict) * (if unassigned == 0 then 1 else 0);
    let _ = if (conflict == 0) * (unassigned == 1) == 1 then (let _ = asgn_unit(assign, c_lits, slot) in 0) else 0;
    let hi = hi + 1;
    0
  };
  let _ = if conflict == 1 then 0 else sys_exit(2);
  0
}

// --- record processors ---

fn add_input(c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64],
             line: [i64], toks: [i64], nt: i64) -> i64 {
  // The clause store is a FIXED window and these three writers index it by
  // n_cl[0] with no bound of their own -- c_id[n_cl[0]], c_len[n_cl[0]] and
  // c_lits[n_cl[0] * 32 + j] all walked past the end once a certificate carried
  // more than the store holds.  A certificate that overruns the store is
  // REFUSED (exit 2), which is the same answer the checker already gives every
  // other malformed input; it is never accepted on a truncated read.
  let ccap = if n_cl[1] > 0 then n_cl[1] else 16384;
  let _ = if n_cl[0] < ccap then 0 else sys_exit(2);
  let cid = parse_int(line, toks[1]);
  let nl = 0;
  let k = 2;
  while k < nt {
    let v = parse_int(line, toks[k]);
    let isz = if v == 0 then 1 else 0;
    // 32 is the clause STRIDE of c_lits, so a longer clause cannot be stored
    // at all.  Refuse it (exit 2) rather than truncating: a truncated clause is
    // a DIFFERENT clause, and checking against it would be checking the wrong
    // formula.  Measured on the first real `mul` obligation: 17 literals max.
    let _ = if isz == 0 then (if nl < 32 then (let _ = c_lits[n_cl[0] * 32 + nl] = v in 0) else sys_exit(2)) else 0;
    let nl = nl + (if isz == 0 then 1 else 0);
    let k = k + 1;
    0
  };
  let _ = c_id[n_cl[0]] = cid;
  let _ = c_len[n_cl[0]] = nl;
  let _ = n_cl[0] = n_cl[0] + 1;
  0
}

fn add_derived(c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64],
               assign: [i64], st: [i64], lits: [i64], hints: [i64],
               line: [i64], toks: [i64], nt: i64) -> i64 {
  // same fixed-window refusal as add_input, for the derived-clause writer.
  let ccap = if n_cl[1] > 0 then n_cl[1] else 16384;
  let _ = if n_cl[0] < ccap then 0 else sys_exit(2);
  let cid = parse_int(line, toks[1]);
  let nl = 0;
  let nh = 0;
  let in_h = 0;
  let k = 2;
  while k < nt {
    let v = parse_int(line, toks[k]);
    let isz = if v == 0 then 1 else 0;
    // HINT CAP, raised 64 -> 1024 and made LOUD, 2026-09-14.  The first real
    // multiplication obligation (x*3 == x + (x<<1), 2846 input + 1712 derived
    // clauses) has a step with 497 antecedents.  At 64 this reader TRUNCATED the
    // hint list in silence, then failed to reach a conflict and exited 2 -- a
    // valid certificate refused for a reason nothing printed, while the Python
    // reference checker verified all 1712 steps.  A cap that is too small must
    // SAY SO, so both buffers now refuse instead of truncating.
    let _ = if in_h == 0 then (if isz == 1 then (let _ = in_h = 1 in 0) else (if nl < 32 then (let _ = lits[nl] = v in 0) else sys_exit(2))) else (if isz == 1 then 0 else (if nh < 1024 then (let _ = hints[nh] = v in 0) else sys_exit(2)));
    let _ = if (isz == 0) * (in_h == 0) == 1 then (let _ = nl = nl + 1 in 0) else 0;
    let _ = if (isz == 0) * (in_h == 1) == 1 then (let _ = nh = nh + 1 in 0) else 0;
    let k = k + 1;
    0
  };
  let _ = if nh > 0 then 0 else sys_exit(2);
  let _ = check_chain(c_id, c_len, c_lits, n_cl, lits, nl, hints, nh, assign);
  let _ = c_id[n_cl[0]] = cid;
  let _ = c_len[n_cl[0]] = nl;
  let j = 0;
  while j < nl {
    let _ = c_lits[n_cl[0] * 32 + j] = lits[j];
    let j = j + 1;
    0
  };
  let _ = st[3] = st[3] + 1;
  let _ = if nl == 0 then (let _ = st[2] = 1 in 0) else 0;
  let _ = n_cl[0] = n_cl[0] + 1;
  0
}

fn del_clauses(c_id: [i64], line: [i64], toks: [i64], nt: i64, n_cl: [i64]) -> i64 {
  let k = 1;
  while k < nt {
    let id = parse_int(line, toks[k]);
    let _ = clause_del(c_id, n_cl[0], id);
    let k = k + 1;
    0
  };
  0
}

fn set_oid(line: [i64], toks: [i64], nt: i64, oid: [i64], oid_len: [i64]) -> i64 {
  let n = if nt >= 2 then 64 else 0;
  let j = 0;
  while j < n {
    let _ = oid[j] = line[toks[1] + j];
    let j = j + 1;
    0
  };
  let _ = if n == 64 then (let _ = oid_len[0] = 64 in 0) else 0;
  0
}

fn process_rec(c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64], assign: [i64],
               lits: [i64], hints: [i64], line: [i64], toks: [i64], nt: i64,
               oid: [i64], oid_len: [i64], st: [i64]) -> i64 {
  let tag = if nt > 0 then line[toks[0]] else 0;
  let _ = if tag == 112 then (let _ = st[0] = parse_int(line, toks[1]) in (let _ = st[1] = parse_int(line, toks[2]) in 0)) else 0;
  let _ = if tag == 99 then add_input(c_id, c_len, c_lits, n_cl, line, toks, nt) else 0;
  let _ = if tag == 114 then add_derived(c_id, c_len, c_lits, n_cl, assign, st, lits, hints, line, toks, nt) else 0;
  let _ = if tag == 100 then del_clauses(c_id, line, toks, nt, n_cl) else 0;
  let _ = if tag == 120 then set_oid(line, toks, nt, oid, oid_len) else 0;
  let unk = (if tag == 112 then 1 else 0) + (if tag == 37 then 1 else 0) + (if tag == 99 then 1 else 0) + (if tag == 114 then 1 else 0) + (if tag == 100 then 1 else 0) + (if tag == 120 then 1 else 0);
  let _ = if unk == 0 then sys_exit(2) else 0;
  0
}

// --- canonical text (15.1) ---
// MUST match tools/certgen.py and tools/certcheck.py exactly: LF only,
// comments and blank lines removed, single spaces between tokens.
fn wout(out: [i64], oat: [i64], c: i64, maxout: i64) -> i64 {
  let _ = if oat[0] < maxout then (let _ = out[oat[0]] = c in (let _ = oat[0] = oat[0] + 1 in 0)) else 0;
  0
}

fn copy_token(lineb: [i64], s: i64, out: [i64], oat: [i64], maxout: i64) -> i64 {
  let j = s;
  let done = 0;
  while done == 0 {
    let c = lineb[j];
    let is_sp = (if c == 32 then 1 else 0) + (if c == 9 then 1 else 0);
    let is_end = if c == 0 then 1 else 0;
    let _ = if (is_sp == 0) * (is_end == 0) == 1 then wout(out, oat, c, maxout) else 0;
    let j = j + 1;
    let done = is_sp + is_end;
    0
  };
  0
}

fn wjoin_line(lineb: [i64], toks: [i64], nt: i64, out: [i64], oat: [i64], maxout: i64) -> i64 {
  let t = 0;
  while t < nt {
    let _ = if t > 0 then wout(out, oat, 32, maxout) else 0;
    let _ = copy_token(lineb, toks[t], out, oat, maxout);
    let t = t + 1;
    0
  };
  0
}

fn canonical_text(src: str, out: [i64], maxout: i64) -> i64 {
  let src_len = str_len(src);
  let ip = [0];
  let oat = [0];
  let lineb = zeros(4096);
  let toks = zeros(256);
  let any = 0;
  while ip[0] < src_len {
    let nline = read_line(src, ip, lineb, 4096);
    let nt = if nline > 0 then tokenize(lineb, toks, 256) else 0;
    let is_comment = if nt > 0 then (if lineb[toks[0]] == 37 then 1 else 0) else 0;
    let skip = is_comment + (if nt > 0 then 0 else 1);
    let _ = if skip == 0 then (let _ = if any == 1 then wout(out, oat, 10, maxout) else 0 in (let _ = wjoin_line(lineb, toks, nt, out, oat, maxout) in 0)) else 0;
    let any = any + (1 - any) * (1 - skip);
    0
  };
  let _ = wout(out, oat, 10, maxout);
  oat[0]
}

fn bind_oid(obl: str, oid: [i64]) -> i64 {
  let ob_ct = zeros(1048576);
  let clen = canonical_text(obl, ob_ct, 1048576);
  let h = zeros(8);
  let _ = sha256_words(ob_ct, clen, h);
  let obuf = zeros(65);
  let _ = hex_u32(h[0], obuf, 0);
  let _ = hex_u32(h[1], obuf, 8);
  let _ = hex_u32(h[2], obuf, 16);
  let _ = hex_u32(h[3], obuf, 24);
  let _ = hex_u32(h[4], obuf, 32);
  let _ = hex_u32(h[5], obuf, 40);
  let _ = hex_u32(h[6], obuf, 48);
  let _ = hex_u32(h[7], obuf, 56);
  let j = 0;
  while j < 64 {
    let _ = if obuf[j] == oid[j] then 0 else sys_exit(2);
    let j = j + 1;
    0
  };
  1
}

// --- bit-blaster and Tseitin encoder ---

fn fresh_var(nv: [i64]) -> i64 {
  let v = nv[0];
  let cap = if nv[1] > 0 then nv[1] else 32768;
  let _ = if v < cap then (let _ = nv[0] = v + 1 in 0) else sys_exit(1);
  v + 1
}

// the ONE clause appender.  It always advances n_cl[0] -- so n_cl[0] is the
// true clause DEMAND -- but only writes while the slot is inside the store,
// which turns an overflow into a measurable number instead of a stray write.
// ln is the literal count (1..3); unused literal slots are ignored.
fn bb_emit(c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64], ln: i64, l0: i64, l1: i64, l2: i64) -> i64 {
  let slot = n_cl[0];
  // n_cl[1] carries the clause-store capacity (0 = the 16384 the certificate
  // format documents).  main sets it to sz_c, so a bigger arena widens the
  // window that is actually WRITTEN while the count above stays the true demand.
  let cap = if n_cl[1] > 0 then n_cl[1] else 16384;
  let _ = if slot < cap then (let _ = c_id[slot] = 0 - (slot + 1) in
                                let _ = c_len[slot] = ln in
                                let _ = c_lits[slot * 32 + 0] = l0 in
                                let _ = if ln > 1 then (let _ = c_lits[slot * 32 + 1] = l1 in 0) else 0 in
                                let _ = if ln > 2 then (let _ = c_lits[slot * 32 + 2] = l2 in 0) else 0 in 0) else 0;
  let _ = n_cl[0] = slot + 1;
  0
}

fn bb_not(a: i64) -> i64 { 0 - a }

// --- Tseitin-level constant folding ---
// Literal 1 is CONST_TRUE and literal -1 is CONST_FALSE for the whole encoder
// (bb_reset allocates variable 1 first and pins it with a unit clause).  Each
// *_fold below returns the DETERMINED output literal, or 0 -- never a legal
// literal, since variable numbering starts at 1 -- meaning "emit the gate".
// A folded gate costs no variable and no clause, which is what makes a
// shift-and-add multiplier affordable: every row whose multiplier bit is
// CONST_FALSE, and every low bit of every partial-product add, vanishes.
fn bb_and_fold(a: i64, b: i64) -> i64 {
  let f = 0 - 1;
  if a == f then f else (
  if b == f then f else (
  if a == 1 then b else (
  if b == 1 then a else (
  if a == b then a else (
  if a == (0 - b) then f else 0)))))
}

fn bb_or_fold(a: i64, b: i64) -> i64 {
  let f = 0 - 1;
  if a == 1 then 1 else (
  if b == 1 then 1 else (
  if a == f then b else (
  if b == f then a else (
  if a == b then a else (
  if a == (0 - b) then 1 else 0)))))
}

fn bb_xor_fold(a: i64, b: i64) -> i64 {
  let f = 0 - 1;
  if a == f then b else (
  if b == f then a else (
  if a == 1 then (0 - b) else (
  if b == 1 then (0 - a) else (
  if a == b then f else (
  if a == (0 - b) then 1 else 0)))))
}

fn bb_mux_fold(s: i64, t: i64, e: i64) -> i64 {
  let f = 0 - 1;
  if s == 1 then t else (
  if s == f then e else (
  if t == e then t else (
  if t == 1 then (if e == f then s else 0) else (
  if t == f then (if e == 1 then (0 - s) else 0) else 0))))
}

fn bb_and(a: i64, b: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let fd = bb_and_fold(a, b);
  if fd != 0 then fd else (
    let o = fresh_var(nv) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, 0 - a, 0 - b, o) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 2, a, 0 - o, 0) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 2, b, 0 - o, 0) in
    o)
}

fn bb_or(a: i64, b: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let fd = bb_or_fold(a, b);
  if fd != 0 then fd else (
    let o = fresh_var(nv) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, a, b, 0 - o) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 2, 0 - a, o, 0) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 2, 0 - b, o, 0) in
    o)
}

fn bb_xor(a: i64, b: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let fd = bb_xor_fold(a, b);
  if fd != 0 then fd else (
    let o = fresh_var(nv) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, 0 - a, 0 - b, 0 - o) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, a, b, 0 - o) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, a, 0 - b, o) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, 0 - a, b, o) in
    o)
}

fn bb_mux(s: i64, t: i64, e: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let fd = bb_mux_fold(s, t, e);
  if fd != 0 then fd else (
    let o = fresh_var(nv) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, 0 - s, t, 0 - o) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, 0 - s, 0 - t, o) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, s, e, 0 - o) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, s, 0 - e, o) in
    o)
}

// majority-of-three -- the carry OUT of a full adder.  Direct Tseitin costs 6
// ternary clauses and ONE variable where and/and/or costs 9 and THREE, and any
// constant input collapses it to a single two-input gate (which then folds in
// turn).  BCP-complete: with all three inputs assigned, one of the six clauses
// is always unit on o.
fn bb_maj(a: i64, b: i64, c: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let f = 0 - 1;
  if c == f then bb_and(a, b, nv, c_id, c_len, c_lits, n_cl) else (
  if c == 1 then bb_or(a, b, nv, c_id, c_len, c_lits, n_cl) else (
  if a == f then bb_and(b, c, nv, c_id, c_len, c_lits, n_cl) else (
  if a == 1 then bb_or(b, c, nv, c_id, c_len, c_lits, n_cl) else (
  if b == f then bb_and(a, c, nv, c_id, c_len, c_lits, n_cl) else (
  if b == 1 then bb_or(a, c, nv, c_id, c_len, c_lits, n_cl) else (
  if a == b then a else (
  if a == (0 - b) then c else (
  if a == c then a else (
  if a == (0 - c) then b else (
  if b == c then b else (
  if b == (0 - c) then a else (
    let o = fresh_var(nv) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, a, b, 0 - o) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, a, c, 0 - o) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, b, c, 0 - o) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, 0 - a, 0 - b, o) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, 0 - a, 0 - c, o) in
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 3, 0 - b, 0 - c, o) in
    o))))))))))))
}

fn bb_not64(a: [i64], a_base: i64, r: [i64], r_base: i64) -> i64 {
  let i = 0;
  while i < 64 {
    let _ = r[r_base + i] = bb_not(a[a_base + i]);
    let i = i + 1;
    0
  };
  0
}

fn bb_and64(a: [i64], a_base: i64, b: [i64], b_base: i64, r: [i64], r_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let i = 0;
  while i < 64 {
    let _ = r[r_base + i] = bb_and(a[a_base + i], b[b_base + i], nv, c_id, c_len, c_lits, n_cl);
    let i = i + 1;
    0
  };
  0
}

fn bb_or64(a: [i64], a_base: i64, b: [i64], b_base: i64, r: [i64], r_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let i = 0;
  while i < 64 {
    let _ = r[r_base + i] = bb_or(a[a_base + i], b[b_base + i], nv, c_id, c_len, c_lits, n_cl);
    let i = i + 1;
    0
  };
  0
}

fn bb_xor64(a: [i64], a_base: i64, b: [i64], b_base: i64, r: [i64], r_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let i = 0;
  while i < 64 {
    let _ = r[r_base + i] = bb_xor(a[a_base + i], b[b_base + i], nv, c_id, c_len, c_lits, n_cl);
    let i = i + 1;
    0
  };
  0
}

// ripple-carry add with an explicit carry-in literal.  cin0 = -1 (CONST_FALSE)
// is a plain add; cin0 = 1 (CONST_TRUE) together with a complemented b word is
// a subtract, and the constant folding above makes every bit where b is a
// constant collapse to nothing.
fn bb_addc64(a: [i64], a_base: i64, b: [i64], b_base: i64, cin0: i64, r: [i64], r_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let cin = cin0;
  let i = 0;
  while i < 64 {
    let a_i = a[a_base + i];
    let b_i = b[b_base + i];
    let axb = bb_xor(a_i, b_i, nv, c_id, c_len, c_lits, n_cl);
    let sum = bb_xor(axb, cin, nv, c_id, c_len, c_lits, n_cl);
    let _ = r[r_base + i] = sum;
    // a wrapping 64-bit add discards the carry out of bit 63, so do not pay
    // three gates to compute it.
    let cin = if i < 63 then bb_maj(a_i, b_i, cin, nv, c_id, c_len, c_lits, n_cl) else (0 - 1);
    let i = i + 1;
    0
  };
  0
}

fn bb_add64(a: [i64], a_base: i64, b: [i64], b_base: i64, r: [i64], r_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  bb_addc64(a, a_base, b, b_base, 0 - 1, r, r_base, nv, c_id, c_len, c_lits, n_cl)
}

fn bb_sub64(a: [i64], a_base: i64, b: [i64], b_base: i64, r: [i64], r_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let bnot = zeros(64);
  let _ = bb_not64(b, b_base, bnot, 0);
  let temp = zeros(64);
  let _ = bb_add64(a, a_base, bnot, 0, temp, 0, nv, c_id, c_len, c_lits, n_cl);
  let one = zeros(64);
  let i = 0;
  while i < 64 {
    let _ = one[i] = 0 - 1;
    let i = i + 1;
    0
  };
  let _ = one[0] = 1;
  let _ = bb_add64(temp, 0, one, 0, r, r_base, nv, c_id, c_len, c_lits, n_cl);
  0
}

fn bb_eq64(a: [i64], a_base: i64, b: [i64], b_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let i = 0;
  let eq = 1;
  while i < 64 {
    let a_i = a[a_base + i];
    let b_i = b[b_base + i];
    let xor_i = bb_xor(a_i, b_i, nv, c_id, c_len, c_lits, n_cl);
    let not_xor = bb_not(xor_i);
    let eq = bb_and(eq, not_xor, nv, c_id, c_len, c_lits, n_cl);
    let i = i + 1;
    0
  };
  eq
}

fn bb_ult64(a: [i64], a_base: i64, b: [i64], b_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let i = 63;
  let lt = 0 - 1;
  let eq = 1;
  while i >= 0 {
    let a_i = a[a_base + i];
    let b_i = b[b_base + i];
    let not_a_i = bb_not(a_i);
    let lt_i = bb_and(not_a_i, b_i, nv, c_id, c_len, c_lits, n_cl);
    let xor_i = bb_xor(a_i, b_i, nv, c_id, c_len, c_lits, n_cl);
    let not_xor = bb_not(xor_i);
    let eq_i = not_xor;
    let lt_here = bb_and(eq, lt_i, nv, c_id, c_len, c_lits, n_cl);
    let lt = bb_or(lt, lt_here, nv, c_id, c_len, c_lits, n_cl);
    let eq = bb_and(eq, eq_i, nv, c_id, c_len, c_lits, n_cl);
    let i = i - 1;
    0
  };
  lt
}

fn bb_slt64(a: [i64], a_base: i64, b: [i64], b_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let i = 62;
  let lt = 0 - 1;
  let eq = 1;
  while i >= 0 {
    let a_i = a[a_base + i];
    let b_i = b[b_base + i];
    let not_a_i = bb_not(a_i);
    let lt_i = bb_and(not_a_i, b_i, nv, c_id, c_len, c_lits, n_cl);
    let xor_i = bb_xor(a_i, b_i, nv, c_id, c_len, c_lits, n_cl);
    let not_xor = bb_not(xor_i);
    let eq_i = not_xor;
    let lt_here = bb_and(eq, lt_i, nv, c_id, c_len, c_lits, n_cl);
    let lt = bb_or(lt, lt_here, nv, c_id, c_len, c_lits, n_cl);
    let eq = bb_and(eq, eq_i, nv, c_id, c_len, c_lits, n_cl);
    let i = i - 1;
    0
  };
  let a_sign = a[a_base + 63];
  let b_sign = b[b_base + 63];
  // signed: if the signs DIFFER the negative one is smaller, so the answer is
  // a_sign itself; if they agree the low-63-bit unsigned compare decides.
  let signs_differ = bb_xor(a_sign, b_sign, nv, c_id, c_len, c_lits, n_cl);
  bb_mux(signs_differ, a_sign, lt, nv, c_id, c_len, c_lits, n_cl)
}

fn bb_shl64(a: [i64], a_base: i64, shamt: [i64], shamt_base: i64, r: [i64], r_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let stage = zeros(64);
  let i = 0;
  while i < 64 {
    let _ = stage[i] = a[a_base + i];
    let i = i + 1;
    0
  };
  let shift_bit = 0;
  while shift_bit < 6 {
    let shift_amt = 1;
    let j = 0;
    while j < shift_bit {
      let _ = shift_amt = shift_amt * 2;
      let j = j + 1;
      0
    };
    let sel = shamt[shamt_base + shift_bit];
    let next_stage = zeros(64);
    let i = 0;
    while i < 64 {
      let shifted_idx = i - shift_amt;
      let val_if_shifted = if shifted_idx >= 0 then stage[shifted_idx] else (0 - 1);
      let next_val = bb_mux(sel, val_if_shifted, stage[i], nv, c_id, c_len, c_lits, n_cl);
      let _ = next_stage[i] = next_val;
      let i = i + 1;
      0
    };
    let i = 0;
    while i < 64 {
      let _ = stage[i] = next_stage[i];
      let i = i + 1;
      0
    };
    let shift_bit = shift_bit + 1;
    0
  };
  let i = 0;
  while i < 64 {
    let _ = r[r_base + i] = stage[i];
    let i = i + 1;
    0
  };
  0
}

fn bb_lshr64(a: [i64], a_base: i64, shamt: [i64], shamt_base: i64, r: [i64], r_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let stage = zeros(64);
  let i = 0;
  while i < 64 {
    let _ = stage[i] = a[a_base + i];
    let i = i + 1;
    0
  };
  let shift_bit = 0;
  while shift_bit < 6 {
    let shift_amt = 1;
    let j = 0;
    while j < shift_bit {
      let _ = shift_amt = shift_amt * 2;
      let j = j + 1;
      0
    };
    let sel = shamt[shamt_base + shift_bit];
    let next_stage = zeros(64);
    let i = 0;
    while i < 64 {
      let shifted_idx = i + shift_amt;
      let val_if_shifted = if shifted_idx < 64 then stage[shifted_idx] else (0 - 1);
      let next_val = bb_mux(sel, val_if_shifted, stage[i], nv, c_id, c_len, c_lits, n_cl);
      let _ = next_stage[i] = next_val;
      let i = i + 1;
      0
    };
    let i = 0;
    while i < 64 {
      let _ = stage[i] = next_stage[i];
      let i = i + 1;
      0
    };
    let shift_bit = shift_bit + 1;
    0
  };
  let i = 0;
  while i < 64 {
    let _ = r[r_base + i] = stage[i];
    let i = i + 1;
    0
  };
  0
}

fn bb_ashr64(a: [i64], a_base: i64, shamt: [i64], shamt_base: i64, r: [i64], r_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let stage = zeros(64);
  let i = 0;
  while i < 64 {
    let _ = stage[i] = a[a_base + i];
    let i = i + 1;
    0
  };
  let sign = a[a_base + 63];
  let shift_bit = 0;
  while shift_bit < 6 {
    let shift_amt = 1;
    let j = 0;
    while j < shift_bit {
      let _ = shift_amt = shift_amt * 2;
      let j = j + 1;
      0
    };
    let sel = shamt[shamt_base + shift_bit];
    let next_stage = zeros(64);
    let i = 0;
    while i < 64 {
      let shifted_idx = i + shift_amt;
      let val_if_shifted = if shifted_idx < 64 then stage[shifted_idx] else sign;
      let next_val = bb_mux(sel, val_if_shifted, stage[i], nv, c_id, c_len, c_lits, n_cl);
      let _ = next_stage[i] = next_val;
      let i = i + 1;
      0
    };
    let i = 0;
    while i < 64 {
      let _ = stage[i] = next_stage[i];
      let i = i + 1;
      0
    };
    let shift_bit = shift_bit + 1;
    0
  };
  let i = 0;
  while i < 64 {
    let _ = r[r_base + i] = stage[i];
    let i = i + 1;
    0
  };
  0
}

fn bb_mux64(s: i64, t: [i64], t_base: i64, e: [i64], e_base: i64, r: [i64], r_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let i = 0;
  while i < 64 {
    let _ = r[r_base + i] = bb_mux(s, t[t_base + i], e[e_base + i], nv, c_id, c_len, c_lits, n_cl);
    let i = i + 1;
    0
  };
  0
}

fn bb_mul64(a: [i64], a_base: i64, b: [i64], b_base: i64, r: [i64], r_base: i64, nv: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let acc = zeros(64);
  let i = 0;
  while i < 64 {
    let _ = acc[i] = 0 - 1;
    let i = i + 1;
    0
  };
  // one scratch row, reused: a fresh zeros(64) per multiplier bit was 128
  // dead arrays per multiply.
  let shifted = zeros(64);
  let bit = 0;
  while bit < 64 {
    let sel = b[b_base + bit];
    // A CONST_FALSE multiplier bit contributes NOTHING -- not even the AND
    // gates -- so skip the whole row.  (A CONST_TRUE one needs no ANDs either;
    // bb_and_fold returns a[j] for it.)
    let skip = if sel == (0 - 1) then 1 else 0;
    let j = 0;
    while j < 64 {
      // Only the low 64 bits of the product are mul64's result, so column j of
      // row `bit` comes from a[j - bit] and the columns below `bit` are
      // CONST_FALSE: exactly 64-bit AND gates per row instead of 64, and the
      // partial products that would only have fed bits 64..127 are never built.
      let lo = if j < bit then 1 else 0;
      let _ = shifted[j] = if (skip + lo) > 0 then (0 - 1) else bb_and(a[a_base + j - bit], sel, nv, c_id, c_len, c_lits, n_cl);
      let j = j + 1;
      0
    };
    let _ = if skip == 1 then 0 else bb_add64(acc, 0, shifted, 0, acc, 0, nv, c_id, c_len, c_lits, n_cl);
    let bit = bit + 1;
    0
  };
  let i = 0;
  while i < 64 {
    let _ = r[r_base + i] = acc[i];
    let i = i + 1;
    0
  };
  0
}

fn bb_bcp(assign: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64]) -> i64 {
  let changed = 1;
  let rounds = 0;
  while (changed * (if rounds < 200 then 1 else 0)) == 1 {
    let _ = changed = 0;
    let i = 0;
    while i < n_cl[0] {
      let nfalse = 0;
      let nunassigned = 0;
      let lastfree = 0;
      let sat = 0;
      let j = 0;
      while j < c_len[i] {
        let lv = c_lits[i * 32 + j];
        let sv = if lv > 0 then lv else (0 - lv);
        let want = if lv > 0 then 1 else (0 - 1);
        let cur = asgn_get(assign, sv);
        let _ = if cur == 0 then (let _ = nunassigned = nunassigned + 1 in let _ = lastfree = lv in 0) else 0;
        let _ = if cur == want then (let _ = sat = 1 in 0) else 0;
        let _ = if (if cur != 0 then 1 else 0) * (if cur != want then 1 else 0) == 1 then (let _ = nfalse = nfalse + 1 in 0) else 0;
        let j = j + 1;
        0
      };
      let force = (if sat == 0 then 1 else 0) * (if nunassigned == 1 then 1 else 0);
      let _ = if force == 1 then (let sv2 = if lastfree > 0 then lastfree else (0 - lastfree) in (let _ = asgn_set(assign, sv2, if lastfree > 0 then 1 else (0 - 1)) in let _ = changed = 1 in 0)) else 0;
      let i = i + 1;
      0
    };
    let rounds = rounds + 1;
    0
  };
  rounds
}

// --- main verification ---
fn verify_cert(cert: str, obl: str, obl_given: i64) -> i64 {
  let c_id = zeros(16384);
  let c_len = zeros(16384);
  let c_lits = zeros(524288);
  let assign = zeros(32768);
  let st = zeros(8);
  let n_cl = zeros(2);
  let oid = zeros(65);
  let oid_len = [0];
  let pos = [0];
  let line = zeros(4096);
  let toks = zeros(512);
  let lits = zeros(32);
  let hints = zeros(1024);
  let done = 0;
  while done == 0 {
    let nread = read_line(cert, pos, line, 4096);
    let done = if nread < 0 then 1 else 0;
    let _ = if nread > 0 then (let nt = tokenize(line, toks, 512) in (let _ = process_rec(c_id, c_len, c_lits, n_cl, assign, lits, hints, line, toks, nt, oid, oid_len, st) in 0)) else 0;
    0
  };
  // post-loop checks: p header seen, empty clause derived, x line present
  let _ = if st[0] >= 0 then 0 else sys_exit(2);
  let _ = if st[2] == 1 then 0 else sys_exit(2);
  let _ = if oid_len[0] == 64 then 0 else sys_exit(2);
  let bound = if obl_given == 1 then bind_oid(obl, oid) else 0;
  // output
  let obuf = zeros(256);
  let opos = [0];
  let _ = wr_s(obuf, opos, "certcheck: OK");
  let _ = wr_ch(obuf, opos, 10);
  let _ = wr_s(obuf, opos, "steps=");
  let _ = wr_num(obuf, opos, st[3]);
  let _ = wr_s(obuf, opos, " (hinted)");
  let _ = wr_ch(obuf, opos, 10);
  let _ = wr_s(obuf, opos, "empty=yes");
  let _ = wr_ch(obuf, opos, 10);
  let _ = wr_s(obuf, opos, "oid=");
  let a5 = opos[0];
  let j = 0;
  while j < 64 {
    let _ = obuf[a5 + j] = oid[j];
    let j = j + 1;
    0
  };
  let _ = opos[0] = a5 + 64;
  let _ = wr_ch(obuf, opos, 10);
  let _ = wr_s(obuf, opos, "binding=");
  let _ = if bound == 1 then wr_s(obuf, opos, "bound") else wr_s(obuf, opos, "UNBOUND");
  let _ = wr_ch(obuf, opos, 10);
  let _ = sys_write(1, obuf, opos[0]);
  0
}

// --- bit-blaster selftest infrastructure ---

fn bb_reset(c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64], assign: [i64], nv: [i64], used: i64) -> i64 {
  let i = 0;
  while i < used {
    let _ = c_id[i] = 0;
    let _ = c_len[i] = 0;
    let i = i + 1;
    0
  };
  let i = 0;
  while i < used * 32 {
    let _ = c_lits[i] = 0;
    let i = i + 1;
    0
  };
  let i = 0;
  while i < 32768 {
    let _ = assign[i] = 0;
    let i = i + 1;
    0
  };
  let _ = n_cl[0] = 0;
  let _ = nv[0] = 0;
  // Variable 1 is CONST_TRUE for the whole encoder: it is allocated first and
  // pinned by a unit clause, so from here on literal 1 IS constant-true and
  // literal -1 IS constant-false.  Raw ints 0/1 are NOT literals; before this
  // existed, `let eq = 1` meant "variable 1" and `let lt = 0` meant nothing at
  // all (0 is not a variable, so BCP could never assign it).
  let _ = fresh_var(nv);
  let _ = bb_emit(c_id, c_len, c_lits, n_cl, 1, 1, 0, 0);
  1
}

fn bb_pin_const(c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64], base: i64, val: i64) -> i64 {
  let bit = 0;
  while bit < 64 {
    let bit_val = (val >> bit) & 1;
    let var_idx = base + bit;
    let lit = if bit_val == 1 then var_idx else (0 - var_idx);
    let _ = bb_emit(c_id, c_len, c_lits, n_cl, 1, lit, 0, 0);
    let bit = bit + 1;
    0
  };
  0
}

fn bb_pin_bit(c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64], lit: i64) -> i64 {
  let _ = bb_emit(c_id, c_len, c_lits, n_cl, 1, lit, 0, 0);
  0
}

fn bb_lit_val(assign: [i64], lit: i64) -> i64 {
  let sv = if lit > 0 then lit else (0 - lit);
  let v = asgn_get(assign, sv);
  let want = if lit > 0 then 1 else (0 - 1);
  if v == want then 1 else 0
}

// read a 64-bit result out of an array of OUTPUT LITERALS (not a contiguous
// variable range: every bb_*64 op overwrites r[] with freshly allocated
// Tseitin outputs).  bit 63 carries the two's-complement sign weight.
fn bb_eval_word(assign: [i64], lits: [i64]) -> i64 {
  let result = 0;
  let bit = 0;
  while bit < 63 {
    let bv = bb_lit_val(assign, lits[bit]);
    let _ = result = result + (bv * (1 << bit));
    let bit = bit + 1;
    0
  };
  let hb = bb_lit_val(assign, lits[63]);
  let _ = result = result + (hb * (0 - 4611686018427387904 - 4611686018427387904));
  result
}

// allocate 64 consecutive fresh variables into w[0..64); returns the base var
fn bb_alloc_word(w: [i64], nv: [i64]) -> i64 {
  let base = nv[0] + 1;
  let i = 0;
  while i < 64 {
    let _ = w[i] = base + i;
    let _ = fresh_var(nv);
    let i = i + 1;
    0
  };
  base
}

fn bb_row(obuf: [i64], opos: [i64], nm: str, val: i64, ncl: i64, nvr: i64, rds: i64) -> i64 {
  let _ = opos[0] = 0;
  let _ = wr_s(obuf, opos, nm);
  let _ = wr_s(obuf, opos, " = ");
  let _ = wr_num(obuf, opos, val);
  let _ = wr_s(obuf, opos, "  clauses=");
  let _ = wr_num(obuf, opos, ncl);
  let _ = wr_s(obuf, opos, " vars=");
  let _ = wr_num(obuf, opos, nvr);
  let _ = wr_s(obuf, opos, " bcp_rounds=");
  let _ = wr_num(obuf, opos, rds);
  let _ = wr_ch(obuf, opos, 10);
  let _ = sys_write(1, obuf, opos[0]);
  0
}

fn bb_selftest(obuf: [i64], opos: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64], assign: [i64], nv: [i64], a: [i64], b: [i64], r: [i64], sh: [i64]) -> i64 {
  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 5);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 3);
  let _ = bb_add64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "01 bb_add64(5,3)  want 8", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 5);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 3);
  let _ = bb_sub64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "02 bb_sub64(5,3)  want 2", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 6);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 3);
  let _ = bb_and64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "03 bb_and64(6,3)  want 2", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 6);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 3);
  let _ = bb_or64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "04 bb_or64(6,3)   want 7", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 6);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 3);
  let _ = bb_xor64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "05 bb_xor64(6,3)  want 5", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 0);
  let _ = bb_not64(a, 0, r, 0);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "06 bb_not64(0)    want -1", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 7);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 7);
  let ol = bb_eq64(a, 0, b, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "07 bb_eq64(7,7)   want 1", bb_lit_val(assign, ol), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 7);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 8);
  let ol = bb_eq64(a, 0, b, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "08 bb_eq64(7,8)   want 0", bb_lit_val(assign, ol), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 3);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 5);
  let ol = bb_ult64(a, 0, b, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "09 bb_ult64(3,5)  want 1", bb_lit_val(assign, ol), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 5);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 3);
  let ol = bb_ult64(a, 0, b, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "10 bb_ult64(5,3)  want 0", bb_lit_val(assign, ol), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 0 - 1);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 1);
  let ol = bb_slt64(a, 0, b, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "11 bb_slt64(-1,1) want 1", bb_lit_val(assign, ol), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let s_base = bb_alloc_word(sh, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 1);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, s_base, 4);
  let _ = bb_shl64(a, 0, sh, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "12 bb_shl64(1,4)  want 16", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let s_base = bb_alloc_word(sh, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 16);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, s_base, 4);
  let _ = bb_lshr64(a, 0, sh, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "13 bb_lshr64(16,4) want 1", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let s_base = bb_alloc_word(sh, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 0 - 16);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, s_base, 4);
  let _ = bb_ashr64(a, 0, sh, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "14 bb_ashr64(-16,4) want -1", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let sl = fresh_var(nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 7);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 9);
  let _ = bb_pin_bit(c_id, c_len, c_lits, n_cl, sl);
  let _ = bb_mux64(sl, a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "15 bb_mux64(1,7,9) want 7", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let sl = fresh_var(nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 7);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 9);
  let _ = bb_pin_bit(c_id, c_len, c_lits, n_cl, 0 - sl);
  let _ = bb_mux64(sl, a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "16 bb_mux64(0,7,9) want 9", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 0 - 1);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 0 - 1);
  let _ = bb_and64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "16a pin probe bb_and64(-1,-1)  want -1", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 0 - 16);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 0 - 1);
  let _ = bb_and64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "16b pin probe bb_and64(-16,-1) want -16", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 1);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 0 - 1);
  let ol = bb_slt64(a, 0, b, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "11a bb_slt64(1,-1)  want 0", bb_lit_val(assign, ol), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 0 - 2);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 0 - 1);
  let ol = bb_slt64(a, 0, b, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "11b bb_slt64(-2,-1) want 1", bb_lit_val(assign, ol), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 1);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 0);
  let _ = bb_add64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "01a carry-in probe bb_add64(1,0) want 1", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 6);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 7);
  // SIZING RUN: lift the fresh_var cap so it COUNTS instead of exiting.
  // bb_emit already counts every clause and only writes the in-bounds
  // ones, so n_cl[0]/nv[0] below are the true demand of bb_mul64.  No
  // bcp: assign is only 8192 wide and only the counts are wanted.
  let _ = nv[1] = 1000000000;
  let _ = bb_mul64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "SIZE bb_mul64(6,7) true demand, no bcp", 0, n_cl[0], nv[0], 0);
  let _ = nv[1] = 0;

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 6);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 7);
  let _ = bb_row(obuf, opos, "17 bb_mul64(6,7)  ENTERING (pre-call counts)", 0, n_cl[0], nv[0], 0);
  let _ = bb_mul64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "17 bb_mul64(6,7)  want 42", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  // mul64 beyond the one pair: a zero row, an identity row, a two-bit
  // multiplier, both signs of all-ones, and a product that crosses bit 32 so
  // the carry chain past the word midpoint is exercised rather than assumed.

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 0);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 7);
  let _ = bb_mul64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "18 bb_mul64(0,7)   want 0", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 1);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 7);
  let _ = bb_mul64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "19 bb_mul64(1,7)   want 7", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 3);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 5);
  let _ = bb_mul64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "20 bb_mul64(3,5)   want 15", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 0 - 1);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 1);
  let _ = bb_mul64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "21 bb_mul64(-1,1)  want -1", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 0 - 1);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 0 - 1);
  let _ = bb_mul64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "22 bb_mul64(-1,-1) want 1", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 65537);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 65537);
  let _ = bb_mul64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let rd = bb_bcp(assign, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "23 bb_mul64(65537,65537) want 4295098369", bb_eval_word(assign, r), n_cl[0], nv[0], rd);

  0
}

// --- the word-level `ring` rule: polynomial normal form over Z/2^64 ---
// Operator ruling 2026-09-09: the three flagship theorems (`fp_mul`, `isqrt`,
// `money.bp`'s `mulov`) are multiplier-equivalence miters, the known-hard case
// for CDCL, so the kernel carries ONE word-level rule alongside the SAT route.
// This is that rule.  A polynomial is a SPARSE, CANONICAL list of
// (monomial key, coefficient) pairs in one flat arena R.  The key packs four
// exponents as four base-16 nibbles, so multiplying two monomials is ONE
// integer add of their keys -- and an exponent overflowing its nibble is
// RECORDED (R[1], R[3]) instead of silently wrapping into a different
// monomial.  Coefficients are plain i64, which IS Z/2^64: two's-complement
// wraparound is the ring itself, not an approximation of it, so polynomial
// identity over i64 arithmetic is decided by comparing canonical forms.
//
// R layout:  R[0] next free offset   R[1] reject code (0 = clean)
//            R[2] arena cells        R[3] monomial-overflow count
//            offset 8 is the NULL polynomial (cap 0: every push to it is
//            refused, so an exhausted arena cannot write out of bounds)
//            polynomials start at offset 16; poly at `base` is
//            R[base] = nterms, R[base+1] = cap, then key/coeff pairs.
// Reject codes: 71 arena/term capacity, 72 monomial exponent overflow.
// MONOMIAL REPRESENTATION (widened 2026-09-14, operator ruling): a monomial is
// mn_w() consecutive i64 cells, each packing mn_nv() exponents as base-16
// nibbles.  Raising mn_w() is the ONE change that widens the variable budget:
// 1 word -> 15 variables, 2 -> 30, 3 -> 45.  Why 15 nibbles and not 16: the
// canonical sort orders monomials with `>` on each word, so a word must stay
// NON-NEGATIVE, and a 16th nibble occupies the sign bit.  Why fixed width
// rather than a sparse (variable, exponent) pair list: fixed-width records keep
// rg_canon's sort an in-place swap of equal-sized slots and keep the arena a
// flat bump allocator with no monomial pool and no compaction -- a pair list
// would need both, and Law L8 (no allocation inside a while body) makes a pool
// with per-term offsets the only shape it could take.  The price of the widening
// is paid in exactly two places: mn_cmp turns rg_canon's single integer compare
// into an mn_w()-word lexicographic loop, and mn_mul turns the single integer
// add of two packed keys into mn_w() * mn_nv() nibble adds -- which is the loop
// the previous key-multiply already ran over 4 nibbles, so it is a widening of
// an existing loop, not a new algorithm.  At mn_w() = 1 a term record is 1
// monomial word plus 1 coefficient = 2 cells, exactly the old (key, coeff)
// pair, and variable vi still occupies nibble vi, so every key, every sort
// order and every arena figure is bit-for-bit what it was before the widening.
fn mn_w() -> i64 { 1 }
fn mn_nv() -> i64 { 15 }

// R layout:  R[0] next free offset   R[1] reject code (0 = clean)
//            R[2] arena cells        R[3] monomial-overflow count
//            R[4] R[5] R[6] row diagnostics
//            offset 8 is the NULL polynomial (cap 0: every append to it is
//            refused, so an exhausted arena cannot write out of bounds)
//            offset 10..15 is the TRASH monomial a refused append returns, so a
//            caller that fills it without checking corrupts nothing.  That is 6
//            cells, so mn_w() <= 6 without moving the polynomial start.
//            polynomials start at offset 16; poly at `base` is
//            R[base] = nterms, R[base+1] = cap, then nterms records of
//            mn_w() monomial words followed by one coefficient.
// Reject codes: 71 arena/term capacity, 72 monomial exponent or variable
//               overflow, 73 zero divisor, 74 floor-bound violation,
//               75 order transfer not licensed.
fn rg_init(R: [i64], cells: i64) -> i64 {
  let _ = R[0] = 16;
  let _ = R[1] = 0;
  let _ = R[2] = cells;
  let _ = R[3] = 0;
  let _ = R[8] = 0;
  let _ = R[9] = 0;
  0
}

fn mn_zero(R: [i64], p: i64) -> i64 {
  let w = 0;
  while w < mn_w() { let _ = R[p + w] = 0; let w = w + 1; 0 };
  0
}

fn mn_copy(R: [i64], src: i64, dst: i64) -> i64 {
  let w = 0;
  while w < mn_w() { let _ = R[dst + w] = R[src + w]; let w = w + 1; 0 };
  0
}

// lexicographic, most significant word first: 1 if a > b, -1 if a < b, 0 equal
fn mn_cmp(R: [i64], pa: i64, pb: i64) -> i64 {
  let res = 0;
  let w = mn_w() - 1;
  while w >= 0 {
    let av = R[pa + w];
    let bv = R[pb + w];
    let _ = if res == 0 then (
        let _ = if av > bv then (let _ = res = 1 in 0) else 0 in
        let _ = if av < bv then (let _ = res = 0 - 1 in 0) else 0 in 0)
      else 0;
    let w = w - 1;
    0
  };
  res
}

fn mn_eq(R: [i64], pa: i64, pb: i64) -> i64 {
  if mn_cmp(R, pa, pb) == 0 then 1 else 0
}

// variable vi to the first power: nibble (vi mod mn_nv()) of word (vi / mn_nv())
fn mn_setvar(R: [i64], p: i64, vi: i64) -> i64 {
  let _ = mn_zero(R, p);
  let w = vi / mn_nv();
  let nb = vi - w * mn_nv();
  let _ = R[p + w] = 1 << (nb * 4);
  0
}

// multiply two monomials: add the nibbles word by word, and LOUDLY record any
// exponent that would leave its nibble rather than letting it carry into the
// next variable's exponent.  po must not alias pa or pb.
fn mn_mul(R: [i64], pa: i64, pb: i64, po: i64) -> i64 {
  let w = 0;
  while w < mn_w() {
    let ka = R[pa + w];
    let kb = R[pb + w];
    let key = 0;
    let i = 0;
    while i < mn_nv() {
      let sh = i * 4;
      let e = ((ka >> sh) & 15) + ((kb >> sh) & 15);
      let _ = if e > 15 then (let _ = R[1] = 72 in let _ = R[3] = R[3] + 1 in 0) else 0;
      let _ = key = key + ((e & 15) << sh);
      let i = i + 1;
      0
    };
    let _ = R[po + w] = key;
    let w = w + 1;
    0
  };
  0
}

fn rg_new(R: [i64], cap: i64) -> i64 {
  let base = R[0];
  let need = base + 2 + cap * (mn_w() + 1);
  let over = if need > R[2] then 1 else 0;
  let _ = if over == 1 then (let _ = R[1] = 71 in 0) else (
      let _ = R[0] = need in
      let _ = R[base] = 0 in
      let _ = R[base + 1] = cap in 0);
  if over == 1 then 8 else base
}

// append a term with coefficient `coeff` and a ZEROED monomial; return the new
// term's MONOMIAL offset, which the caller then fills.  A refused append
// returns the trash monomial at offset 10 and records 71.
fn rg_term(R: [i64], base: i64, coeff: i64) -> i64 {
  let n = R[base];
  let cap = R[base + 1];
  let ok = if n < cap then 1 else 0;
  let _ = if ok == 0 then (let _ = R[1] = 71 in 0) else 0;
  let toff = if ok == 1 then (base + 2 + n * (mn_w() + 1)) else 10;
  let _ = if ok == 1 then (
      let _ = R[toff + mn_w()] = coeff in
      let _ = R[base] = n + 1 in 0) else 0;
  let _ = mn_zero(R, toff);
  toff
}

// sort by monomial, then combine equal monomials and drop zero coefficients.
// The sort is insertion by ADJACENT SWAP, which needs no scratch monomial; the
// write cursor w never overtakes the read cursor i, so the combine is in place.
fn rg_canon(R: [i64], base: i64) -> i64 {
  let n = R[base];
  let st = mn_w() + 1;
  let i = 1;
  while i < n {
    let j = i;
    while (if j > 0 then 1 else 0) * (if mn_cmp(R, base + 2 + (j - 1) * st, base + 2 + j * st) > 0 then 1 else 0) == 1 {
      let c = 0;
      while c < st {
        let t = R[base + 2 + (j - 1) * st + c];
        let _ = R[base + 2 + (j - 1) * st + c] = R[base + 2 + j * st + c];
        let _ = R[base + 2 + j * st + c] = t;
        let c = c + 1;
        0
      };
      let j = j - 1;
      0
    };
    let i = i + 1;
    0
  };
  let w = 0;
  let i = 0;
  while i < n {
    let acc = R[base + 2 + i * st + mn_w()];
    let j = i + 1;
    while (if j < n then 1 else 0) * (if mn_eq(R, base + 2 + i * st, base + 2 + j * st) == 1 then 1 else 0) == 1 {
      let _ = acc = acc + R[base + 2 + j * st + mn_w()];
      let j = j + 1;
      0
    };
    let _ = if acc != 0 then (
        let _ = mn_copy(R, base + 2 + i * st, base + 2 + w * st) in
        let _ = R[base + 2 + w * st + mn_w()] = acc in
        let _ = w = w + 1 in 0) else 0;
    let i = j;
    0
  };
  let _ = R[base] = w;
  w
}

fn rg_const(R: [i64], out: i64, c: i64) -> i64 {
  let _ = R[out] = 0;
  let _ = if c != 0 then (let _ = rg_term(R, out, c) in 0) else 0;
  out
}

fn rg_var(R: [i64], out: i64, vi: i64) -> i64 {
  let _ = R[out] = 0;
  let cap = mn_w() * mn_nv();
  let _ = if vi < cap then (let t = rg_term(R, out, 1) in let _ = mn_setvar(R, t, vi) in 0)
          else (let _ = R[1] = 72 in 0);
  out
}

// out must not alias x or y.
fn rg_add(R: [i64], x: i64, y: i64, out: i64) -> i64 {
  let st = mn_w() + 1;
  let _ = R[out] = 0;
  let i = 0;
  while i < R[x] {
    let t = rg_term(R, out, R[x + 2 + i * st + mn_w()]);
    let _ = mn_copy(R, x + 2 + i * st, t);
    let i = i + 1;
    0
  };
  let i = 0;
  while i < R[y] {
    let t = rg_term(R, out, R[y + 2 + i * st + mn_w()]);
    let _ = mn_copy(R, y + 2 + i * st, t);
    let i = i + 1;
    0
  };
  let _ = rg_canon(R, out);
  out
}

fn rg_scale(R: [i64], x: i64, k: i64, out: i64) -> i64 {
  let st = mn_w() + 1;
  let _ = R[out] = 0;
  let i = 0;
  while i < R[x] {
    let t = rg_term(R, out, R[x + 2 + i * st + mn_w()] * k);
    let _ = mn_copy(R, x + 2 + i * st, t);
    let i = i + 1;
    0
  };
  let _ = rg_canon(R, out);
  out
}

fn rg_sub(R: [i64], x: i64, y: i64, neg: i64, out: i64) -> i64 {
  let _ = rg_scale(R, y, 0 - 1, neg);
  rg_add(R, x, neg, out)
}

// out must not alias x or y.
fn rg_mul(R: [i64], x: i64, y: i64, out: i64) -> i64 {
  let st = mn_w() + 1;
  let _ = R[out] = 0;
  let i = 0;
  while i < R[x] {
    let j = 0;
    while j < R[y] {
      let t = rg_term(R, out, R[x + 2 + i * st + mn_w()] * R[y + 2 + j * st + mn_w()]);
      let _ = mn_mul(R, x + 2 + i * st, y + 2 + j * st, t);
      let j = j + 1;
      0
    };
    let i = i + 1;
    0
  };
  let _ = rg_canon(R, out);
  out
}

// THE rule: two word-level terms are equal over Z/2^64 iff their canonical
// polynomials are identical.  Any internal rejection answers 0 ("not proved"),
// never 1, so an exhausted arena or an overflowed exponent can never manufacture
// a proof.
fn rg_eq(R: [i64], x: i64, y: i64) -> i64 {
  let st = mn_w() + 1;
  let _ = rg_canon(R, x);
  let _ = rg_canon(R, y);
  let nx = R[x];
  let ny = R[y];
  let same = if nx == ny then 1 else 0;
  let i = 0;
  while i < nx {
    let _ = if i < ny then (
        let _ = if mn_eq(R, x + 2 + i * st, y + 2 + i * st) == 0 then (let _ = same = 0 in 0) else 0 in
        let _ = if R[x + 2 + i * st + mn_w()] != R[y + 2 + i * st + mn_w()] then (let _ = same = 0 in 0) else 0 in 0)
      else 0;
    let i = i + 1;
    0
  };
  if R[1] == 0 then same else 0
}

fn rg_row(obuf: [i64], opos: [i64], nm: str, val: i64, R: [i64]) -> i64 {
  let _ = opos[0] = 0;
  let _ = wr_s(obuf, opos, nm);
  let _ = wr_s(obuf, opos, " = ");
  let _ = wr_num(obuf, opos, val);
  let _ = wr_s(obuf, opos, "  reject=");
  let _ = wr_num(obuf, opos, R[1]);
  let _ = wr_s(obuf, opos, " terms=");
  let _ = wr_num(obuf, opos, R[4]);
  let _ = wr_s(obuf, opos, " arena=");
  let _ = wr_num(obuf, opos, R[0]);
  let _ = wr_s(obuf, opos, " monovf=");
  let _ = wr_num(obuf, opos, R[3]);
  let _ = wr_ch(obuf, opos, 10);
  let _ = sys_write(1, obuf, opos[0]);
  0
}

// Every row prints the DECISION (1 = proved equal, 0 = not proved), the reject
// code, the canonical term count of the left side, the arena cells consumed and
// the monomial-overflow count.  The R4/R5 rows are NEGATIVE controls: a rule
// that answered 1 to everything would be caught by them, not by the positives.
fn rg_selftest(obuf: [i64], opos: [i64], R: [i64], cells: i64) -> i64 {
  // R1: (x+y)*(x+y) == x*x + 2*x*y + y*y
  let _ = rg_init(R, cells);
  let px = rg_var(R, rg_new(R, 4), 0);
  let py = rg_var(R, rg_new(R, 4), 1);
  let sxy = rg_add(R, px, py, rg_new(R, 8));
  let lhs = rg_mul(R, sxy, sxy, rg_new(R, 16));
  let xx = rg_mul(R, px, px, rg_new(R, 8));
  let yy = rg_mul(R, py, py, rg_new(R, 8));
  let xy = rg_mul(R, px, py, rg_new(R, 8));
  let xy2 = rg_scale(R, xy, 2, rg_new(R, 8));
  let t1 = rg_add(R, xx, xy2, rg_new(R, 16));
  let rhs = rg_add(R, t1, yy, rg_new(R, 16));
  let _ = R[4] = R[lhs];
  let _ = rg_row(obuf, opos, "R1 ring (x+y)^2 == x^2+2xy+y^2   want 1", rg_eq(R, lhs, rhs), R);

  // R2: x*(y+z) == x*y + x*z
  let _ = rg_init(R, cells);
  let px = rg_var(R, rg_new(R, 4), 0);
  let py = rg_var(R, rg_new(R, 4), 1);
  let pz = rg_var(R, rg_new(R, 4), 2);
  let syz = rg_add(R, py, pz, rg_new(R, 8));
  let lhs = rg_mul(R, px, syz, rg_new(R, 16));
  let xy = rg_mul(R, px, py, rg_new(R, 8));
  let xz = rg_mul(R, px, pz, rg_new(R, 8));
  let rhs = rg_add(R, xy, xz, rg_new(R, 16));
  let _ = R[4] = R[lhs];
  let _ = rg_row(obuf, opos, "R2 ring x*(y+z) == x*y+x*z       want 1", rg_eq(R, lhs, rhs), R);

  // R3: (x+1)*(x-1) == x*x - 1  -- the shape of an overflow-free mulov miter
  let _ = rg_init(R, cells);
  let px = rg_var(R, rg_new(R, 4), 0);
  let c1 = rg_const(R, rg_new(R, 4), 1);
  let cm1 = rg_const(R, rg_new(R, 4), 0 - 1);
  let xp1 = rg_add(R, px, c1, rg_new(R, 8));
  let xm1 = rg_add(R, px, cm1, rg_new(R, 8));
  let lhs = rg_mul(R, xp1, xm1, rg_new(R, 16));
  let xx = rg_mul(R, px, px, rg_new(R, 8));
  let rhs = rg_add(R, xx, cm1, rg_new(R, 16));
  let _ = R[4] = R[lhs];
  let _ = rg_row(obuf, opos, "R3 ring (x+1)*(x-1) == x^2-1     want 1", rg_eq(R, lhs, rhs), R);

  // R4 NEGATIVE CONTROL: x*y is NOT y*y
  let _ = rg_init(R, cells);
  let px = rg_var(R, rg_new(R, 4), 0);
  let py = rg_var(R, rg_new(R, 4), 1);
  let lhs = rg_mul(R, px, py, rg_new(R, 8));
  let rhs = rg_mul(R, py, py, rg_new(R, 8));
  let _ = R[4] = R[lhs];
  let _ = rg_row(obuf, opos, "R4 ring x*y == y*y  NEG           want 0", rg_eq(R, lhs, rhs), R);

  // R5 NEGATIVE CONTROL: the cross term really is required
  let _ = rg_init(R, cells);
  let px = rg_var(R, rg_new(R, 4), 0);
  let py = rg_var(R, rg_new(R, 4), 1);
  let sxy = rg_add(R, px, py, rg_new(R, 8));
  let lhs = rg_mul(R, sxy, sxy, rg_new(R, 16));
  let xx = rg_mul(R, px, px, rg_new(R, 8));
  let yy = rg_mul(R, py, py, rg_new(R, 8));
  let rhs = rg_add(R, xx, yy, rg_new(R, 16));
  let _ = R[4] = R[lhs];
  let _ = rg_row(obuf, opos, "R5 ring (x+y)^2 == x^2+y^2  NEG   want 0", rg_eq(R, lhs, rhs), R);

  // R6: the coefficient ring really is Z/2^64 -- 2^63 * 2 == 0
  let _ = rg_init(R, cells);
  let hi = rg_const(R, rg_new(R, 4), 0 - 4611686018427387904 - 4611686018427387904);
  let two = rg_const(R, rg_new(R, 4), 2);
  let lhs = rg_mul(R, hi, two, rg_new(R, 8));
  let zero = rg_const(R, rg_new(R, 4), 0);
  let _ = R[4] = R[lhs];
  let _ = rg_row(obuf, opos, "R6 ring 2^63*2 == 0 (mod 2^64)   want 1", rg_eq(R, lhs, zero), R);

  // R7: x*(y-z) == x*y - x*z, with a subtraction built through rg_sub
  let _ = rg_init(R, cells);
  let px = rg_var(R, rg_new(R, 4), 0);
  let py = rg_var(R, rg_new(R, 4), 1);
  let pz = rg_var(R, rg_new(R, 4), 2);
  let dyz = rg_sub(R, py, pz, rg_new(R, 8), rg_new(R, 8));
  let lhs = rg_mul(R, px, dyz, rg_new(R, 16));
  let xy = rg_mul(R, px, py, rg_new(R, 8));
  let xz = rg_mul(R, px, pz, rg_new(R, 8));
  let rhs = rg_sub(R, xy, xz, rg_new(R, 8), rg_new(R, 16));
  let _ = R[4] = R[lhs];
  let _ = rg_row(obuf, opos, "R7 ring x*(y-z) == x*y-x*z       want 1", rg_eq(R, lhs, rhs), R);

  // R8: the exponent guard FIRES rather than wrapping x^16 into a lie.
  // want 0 with monovf > 0 -- the rule refuses, it does not answer wrongly.
  let _ = rg_init(R, cells);
  let px = rg_var(R, rg_new(R, 4), 0);
  let x2 = rg_mul(R, px, px, rg_new(R, 4));
  let x4 = rg_mul(R, x2, x2, rg_new(R, 4));
  let x8 = rg_mul(R, x4, x4, rg_new(R, 4));
  let x16 = rg_mul(R, x8, x8, rg_new(R, 4));
  let _ = R[4] = R[x16];
  let _ = rg_row(obuf, opos, "R8 ring x^16 degree guard        want 0 monovf>0", rg_eq(R, x16, px), R);

  0
}

// --- the two floor-division lemmas ---
// The other half of the operator's 2026-09-09 ruling.  The `ring` rule above
// decides polynomial identity over Z/2^64; it has no notion of DIVISION, and
// the three flagship theorems each compare a 64x64 multiplication OR A 64-BIT
// DIVISION against a different arithmetic decomposition (docs/
// RESEARCH-PROOF-DESIGN-2026-09-09.md:280 for `mulov`: "`a * b / bs == a`
// compared to the 128-bit product fits ... `ring` + floor lemmas route").  Two
// lemmas bridge the gap, and they are the standard div/mod pair:
//
//   LEMMA D1 (floor Euclidean decomposition) -- for d != 0,
//       x == d * (x fdiv d) + (x fmod d)   with   0 <= (x fmod d) < d  for d > 0
//                                          and   d < (x fmod d) <= 0  for d < 0.
//     This is what ELIMINATES the division operator: the quotient becomes an
//     ordinary polynomial and the leftover is a bounded remainder, both of which
//     the ring rule can normalise.
//
//   LEMMA D2 (exact cancellation and order transfer) -- for d > 0,
//       (a * d) fdiv d == a          whenever the remainder is identically 0,
//       q <= x fdiv d   <==>   q * d <= x.
//     This is what DISCHARGES the result without re-introducing a division:
//     the equality half is exactly the shape `mulov` tests, and the order half
//     rewrites a comparison-against-a-quotient into a division-free comparison.
//
// MEASURED PREREQUISITE (tmp/divprobe.bp, this box, today): Bebop's `/`
// TRUNCATES toward zero -- 7/3=2 r=1, -7/3=-2 r=-1, -1/3=0 r=-1, 7/-3=-2 r=1 --
// so the FLOOR quotient is NOT the machine quotient and the correction below is
// the arithmetic content of D1, not decoration.  Without it the r bound is
// violated on every negative dividend, which is why dv_split re-checks the
// bound on every coefficient and records 74 if it ever fails.
//
// SCOPE, stated rather than discovered later: the divisor is an integer
// CONSTANT.  Division of a polynomial by another polynomial is not in the ring,
// so a symbolic divisor (`mulov`'s general `b`) is out of scope and is reported,
// not approximated.  Reject codes: 73 zero divisor, 74 floor-bound violation,
// 75 order transfer not licensed (divisor not positive).
fn dv_fdiv(a: i64, d: i64) -> i64 {
  let qt = a / d;
  let rt = a - qt * d;
  let sr = if rt < 0 then 1 else 0;
  let sd = if d < 0 then 1 else 0;
  let opp = (if rt != 0 then 1 else 0) * (if sr != sd then 1 else 0);
  qt - opp
}

fn dv_frem(a: i64, d: i64) -> i64 { a - dv_fdiv(a, d) * d }

// LEMMA D1 machinery: split polynomial x by the integer constant d into a
// quotient polynomial q and a remainder polynomial r, coefficient by
// coefficient, with FLOOR semantics.  q and r must not alias x.
fn dv_split(R: [i64], x: i64, d: i64, q: i64, r: i64) -> i64 {
  let _ = if d == 0 then (let _ = R[1] = 73 in 0) else 0;
  let dd = if d == 0 then 1 else d;
  let _ = R[q] = 0;
  let _ = R[r] = 0;
  let st = mn_w() + 1;
  let i = 0;
  while i < R[x] {
    let c = R[x + 2 + i * st + mn_w()];
    let qc = dv_fdiv(c, dd);
    let rc = c - qc * dd;
    // live bound check -- this FIRES if the floor correction above is ever wrong
    let bad = if dd > 0 then ((if rc < 0 then 1 else 0) + (if rc >= dd then 1 else 0))
                        else ((if rc > 0 then 1 else 0) + (if rc <= dd then 1 else 0));
    let _ = if bad > 0 then (let _ = R[1] = 74 in 0) else 0;
    let tq = rg_term(R, q, qc);
    let _ = mn_copy(R, x + 2 + i * st, tq);
    let tr = rg_term(R, r, rc);
    let _ = mn_copy(R, x + 2 + i * st, tr);
    let i = i + 1;
    0
  };
  let _ = rg_canon(R, q);
  let _ = rg_canon(R, r);
  let _ = R[5] = R[q];
  let _ = R[6] = R[r];
  0
}

// LEMMA D1 decision: does the decomposition actually hold?  x == d*q + r,
// decided by the ring rule.  s1 and s2 are scratch polynomials.
fn dv_euclid(R: [i64], x: i64, d: i64, q: i64, r: i64, s1: i64, s2: i64) -> i64 {
  let _ = rg_scale(R, q, d, s1);
  let _ = rg_add(R, s1, r, s2);
  rg_eq(R, x, s2)
}

// LEMMA D2, equality half: the division is EXACT (remainder identically zero),
// so x fdiv d == q with no rounding at all.  This is the `(a*b)/b == a`
// cancellation that `mulov`'s generic branch is built on.
fn dv_exact(R: [i64], r: i64) -> i64 {
  let _ = rg_canon(R, r);
  let z = if R[r] == 0 then 1 else 0;
  if R[1] == 0 then z else 0
}

// LEMMA D2, order half: rewrite `q <= x fdiv d` into the division-free
// `q * d <= x`, licensed only for d > 0.  `out` receives x - q*d, whose SIGN is
// the rewritten comparison.  Deciding that sign symbolically is NOT the ring
// rule's job -- a polynomial normal form has no order -- so this returns only
// whether the ELIMINATION is licensed, and the division-free comparison it
// produces is what the SAT route is then handed.
fn dv_transfer(R: [i64], q: i64, d: i64, x: i64, s1: i64, s2: i64, out: i64) -> i64 {
  let lic = if d > 0 then 1 else 0;
  let _ = if lic == 1 then 0 else (let _ = R[1] = 75 in 0);
  let _ = rg_scale(R, q, d, s1);
  let _ = rg_sub(R, x, s1, s2, out);
  let _ = R[5] = R[out];
  let _ = R[6] = 0;
  if R[1] == 0 then lic else 0
}

fn dv_row(obuf: [i64], opos: [i64], nm: str, val: i64, R: [i64]) -> i64 {
  let _ = opos[0] = 0;
  let _ = wr_s(obuf, opos, nm);
  let _ = wr_s(obuf, opos, " = ");
  let _ = wr_num(obuf, opos, val);
  let _ = wr_s(obuf, opos, "  reject=");
  let _ = wr_num(obuf, opos, R[1]);
  let _ = wr_s(obuf, opos, " qterms=");
  let _ = wr_num(obuf, opos, R[5]);
  let _ = wr_s(obuf, opos, " rterms=");
  let _ = wr_num(obuf, opos, R[6]);
  let _ = wr_s(obuf, opos, " arena=");
  let _ = wr_num(obuf, opos, R[0]);
  let _ = wr_ch(obuf, opos, 10);
  let _ = sys_write(1, obuf, opos[0]);
  0
}

// D3, D4, D6 and D8 are NEGATIVE CONTROLS: without them D1/D2/D5/D7 are just a
// procedure that prints 1, which is the failure shape this file has paid for.
fn dv_selftest(obuf: [i64], opos: [i64], R: [i64], cells: i64) -> i64 {
  // D1: x = 7a + 5 split by 3 -> q = 2a+1, r = a+2, and 3*q + r == x
  let _ = rg_init(R, cells);
  let pa = rg_var(R, rg_new(R, 4), 0);
  let x7 = rg_scale(R, pa, 7, rg_new(R, 4));
  let c5 = rg_const(R, rg_new(R, 4), 5);
  let x = rg_add(R, x7, c5, rg_new(R, 8));
  let q = rg_new(R, 8);
  let r = rg_new(R, 8);
  let _ = dv_split(R, x, 3, q, r);
  let _ = dv_row(obuf, opos, "D1 fdiv Euclid (7a+5) = 3*q + r      want 1", dv_euclid(R, x, 3, q, r, rg_new(R, 16), rg_new(R, 16)), R);

  // D2: the TRUNCATION TRAP.  x = -1, d = 3.  Bebop's `/` gives q=0 r=-1, which
  // breaks 0 <= r < d; the floor correction gives q=-1 r=2 and the identity holds.
  let _ = rg_init(R, cells);
  let x = rg_const(R, rg_new(R, 4), 0 - 1);
  let q = rg_new(R, 4);
  let r = rg_new(R, 4);
  let _ = dv_split(R, x, 3, q, r);
  let _ = dv_row(obuf, opos, "D2 fdiv Euclid (-1) = 3*(-1) + 2     want 1", dv_euclid(R, x, 3, q, r, rg_new(R, 8), rg_new(R, 8)), R);

  // D3 NEG: a WRONG quotient (doubled) must not satisfy the decomposition
  let _ = rg_init(R, cells);
  let pa = rg_var(R, rg_new(R, 4), 0);
  let x7 = rg_scale(R, pa, 7, rg_new(R, 4));
  let c5 = rg_const(R, rg_new(R, 4), 5);
  let x = rg_add(R, x7, c5, rg_new(R, 8));
  let q = rg_new(R, 8);
  let r = rg_new(R, 8);
  let _ = dv_split(R, x, 3, q, r);
  let qbad = rg_scale(R, q, 2, rg_new(R, 8));
  let _ = dv_row(obuf, opos, "D3 fdiv Euclid wrong q  NEG          want 0", dv_euclid(R, x, 3, qbad, r, rg_new(R, 16), rg_new(R, 16)), R);

  // D4 NEG: a zero divisor is refused, not divided by
  let _ = rg_init(R, cells);
  let x = rg_const(R, rg_new(R, 4), 7);
  let q = rg_new(R, 4);
  let r = rg_new(R, 4);
  let _ = dv_split(R, x, 0, q, r);
  let _ = dv_row(obuf, opos, "D4 fdiv zero divisor  NEG            want 0 reject=73", dv_euclid(R, x, 1, q, r, rg_new(R, 8), rg_new(R, 8)), R);

  // D5 LEMMA D2: (100*a) fdiv 100 == a exactly -- the `mulov` cancellation shape
  let _ = rg_init(R, cells);
  let pa = rg_var(R, rg_new(R, 4), 0);
  let x = rg_scale(R, pa, 100, rg_new(R, 4));
  let q = rg_new(R, 4);
  let r = rg_new(R, 4);
  let _ = dv_split(R, x, 100, q, r);
  let ex = dv_exact(R, r);
  let _ = dv_row(obuf, opos, "D5 exact (100a)/100 == a  r==0       want 1", ex * rg_eq(R, q, pa), R);

  // D6 NEG: one off the multiple and the cancellation is gone
  let _ = rg_init(R, cells);
  let pa = rg_var(R, rg_new(R, 4), 0);
  let x100 = rg_scale(R, pa, 100, rg_new(R, 4));
  let c1 = rg_const(R, rg_new(R, 4), 1);
  let x = rg_add(R, x100, c1, rg_new(R, 8));
  let q = rg_new(R, 8);
  let r = rg_new(R, 8);
  let _ = dv_split(R, x, 100, q, r);
  let _ = dv_row(obuf, opos, "D6 exact (100a+1)/100  NEG           want 0", dv_exact(R, r), R);

  // D7 LEMMA D2 order half: q <= x/3 becomes q*3 <= x, licensed for d > 0.
  // qterms below is the term count of the division-free difference x - q*3.
  let _ = rg_init(R, cells);
  let pa = rg_var(R, rg_new(R, 4), 0);
  let x = rg_scale(R, pa, 7, rg_new(R, 4));
  let qq = rg_var(R, rg_new(R, 4), 1);
  let _ = dv_row(obuf, opos, "D7 transfer q<=x/3 -> q*3<=x         want 1", dv_transfer(R, qq, 3, x, rg_new(R, 8), rg_new(R, 8), rg_new(R, 8)), R);

  // D8 NEG: a non-positive divisor flips the inequality, so the rewrite is NOT
  // licensed and must be refused rather than silently applied
  let _ = rg_init(R, cells);
  let pa = rg_var(R, rg_new(R, 4), 0);
  let x = rg_scale(R, pa, 7, rg_new(R, 4));
  let qq = rg_var(R, rg_new(R, 4), 1);
  let _ = dv_row(obuf, opos, "D8 transfer d=-3 not licensed  NEG   want 0 reject=75", dv_transfer(R, qq, 0 - 3, x, rg_new(R, 8), rg_new(R, 8), rg_new(R, 8)), R);

  0
}

// --- ONE REAL OBLIGATION PUT THROUGH THE RULE ---
// Chosen: `mulov`'s generic branch, selfhost/std/money.bp:30-41, at the literal
// call site money.bp:98 `mulov(c1, 100)`.  mulov computes p = a*b (WRAPPING),
// q = p / b, and reports overflow when q != a.  So its correctness claim on the
// no-overflow side is exactly `(a * 100) / 100 == a`, which is LEMMA D2 with a
// CONSTANT divisor -- the one shape the lemmas cover.  The general `mulov(a,b)`
// with symbolic b is NOT covered and is reported, not faked.
//
// The wrapping is the whole point and the ring rule cannot see it: Z/2^64 IS the
// ring, so `a*100` never "overflows" there.  What the rule discharges is the
// no-overflow branch; the overflow branch is decided by the instances below,
// where the wrapped coefficient is computed in the ring and compared to `a`.
fn ob_selftest(obuf: [i64], opos: [i64], R: [i64], cells: i64) -> i64 {
  // M1 SYMBOLIC, the generic-branch identity: (100*c1)/100 == c1
  let _ = rg_init(R, cells);
  let pc = rg_var(R, rg_new(R, 4), 0);
  let x = rg_scale(R, pc, 100, rg_new(R, 4));
  let q = rg_new(R, 4);
  let r = rg_new(R, 4);
  let _ = dv_split(R, x, 100, q, r);
  let _ = dv_row(obuf, opos, "M1 mulov(c1,100) no-ovf (100c)/100==c  want 1", dv_exact(R, r) * rg_eq(R, q, pc), R);

  // M2 CONCRETE, no overflow: a = 12345, p = 1234500, q = 12345 == a -> ok
  let _ = rg_init(R, cells);
  let pa = rg_const(R, rg_new(R, 4), 12345);
  let x = rg_scale(R, pa, 100, rg_new(R, 4));
  let q = rg_new(R, 4);
  let r = rg_new(R, 4);
  let _ = dv_split(R, x, 100, q, r);
  let _ = dv_row(obuf, opos, "M2 mulov(12345,100) q==a  no ovf       want 1", dv_exact(R, r) * rg_eq(R, q, pa), R);

  // M3 CONCRETE, OVERFLOWS: a = 2^62+1, a*100 wraps to 100, so q = 1 != a and
  // mulov's `gen` flag is 1 -- overflow correctly reported.
  let _ = rg_init(R, cells);
  let pa = rg_const(R, rg_new(R, 4), 4611686018427387905);
  let x = rg_scale(R, pa, 100, rg_new(R, 4));
  let q = rg_new(R, 4);
  let r = rg_new(R, 4);
  let _ = dv_split(R, x, 100, q, r);
  let _ = dv_row(obuf, opos, "M3 mulov(2^62+1,100) q==a  OVF        want 0", rg_eq(R, q, pa), R);

  // M4 CONCRETE, OVERFLOWS to exactly zero: a = 2^62, a*100 == 25 * 2^64 == 0,
  // so q = 0 != a.  The degenerate wrap, which a coefficient-only rule could
  // have mistaken for an exact division.
  let _ = rg_init(R, cells);
  let pa = rg_const(R, rg_new(R, 4), 4611686018427387904);
  let x = rg_scale(R, pa, 100, rg_new(R, 4));
  let q = rg_new(R, 4);
  let r = rg_new(R, 4);
  let _ = dv_split(R, x, 100, q, r);
  let _ = dv_row(obuf, opos, "M4 mulov(2^62,100) q==a  OVF wrap=0   want 0", rg_eq(R, q, pa), R);

  // M5/M6 THE SOUNDNESS SEPARATION, in two numbers.  3 is a UNIT in Z/2^64, so
  // the ring rule proves 3 * inv3 == 1 (M5 = 1).  If the floor lemma were
  // implemented by multiplying by that inverse -- the obvious mistake -- it
  // would answer `1/3 == inv3`.  It divides COEFFICIENTS instead, so it refuses
  // (M6 = 0, remainder 1).  M5 and M6 together are why the two rules must stay
  // separate: modular inversion is not floor division.
  let _ = rg_init(R, cells);
  let c3 = rg_const(R, rg_new(R, 4), 3);
  let ci = rg_const(R, rg_new(R, 4), 0 - 6148914691236517205);
  let pr = rg_mul(R, c3, ci, rg_new(R, 4));
  let c1 = rg_const(R, rg_new(R, 4), 1);
  let _ = R[5] = R[pr];
  let _ = R[6] = 0;
  let _ = dv_row(obuf, opos, "M5 ring 3*inv3 == 1 in Z/2^64         want 1", rg_eq(R, pr, c1), R);

  let _ = rg_init(R, cells);
  let x = rg_const(R, rg_new(R, 4), 1);
  let q = rg_new(R, 4);
  let r = rg_new(R, 4);
  let _ = dv_split(R, x, 3, q, r);
  let _ = dv_row(obuf, opos, "M6 fdiv 1/3 exact?  NEG (not inv3)   want 0", dv_exact(R, r), R);

  0
}

// The SAT route's side of the SAME obligation, as a DEMAND measurement only.
// `mulov` compares a 64x64 multiply AND a 64-bit divide against a 128-bit
// product; the bit-blaster has no divider at all, so this measures the cheapest
// lower bound that exists in the tree -- the two symbolic 64x64 multiplies the
// miter's two sides need.  NO bcp: past sz_c the clauses are COUNTED but not
// WRITTEN (bb_emit's documented design), so only the counts are meaningful, and
// this changes neither bb_mul64 nor any cap.
fn ob_satsize(obuf: [i64], opos: [i64], c_id: [i64], c_len: [i64], c_lits: [i64], n_cl: [i64], assign: [i64], nv: [i64], a: [i64], b: [i64], r: [i64], r2: [i64]) -> i64 {
  let _ = bb_reset(c_id, c_len, c_lits, n_cl, assign, nv, 4096);
  let a_base = bb_alloc_word(a, nv);
  let b_base = bb_alloc_word(b, nv);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, a_base, 6);
  let _ = bb_pin_const(c_id, c_len, c_lits, n_cl, b_base, 7);
  let _ = nv[1] = 1000000000;
  let _ = bb_mul64(a, 0, b, 0, r, 0, nv, c_id, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "SAT1 mulov miter, ONE symbolic mul, demand", 0, n_cl[0], nv[0], 0);
  let _ = bb_mul64(a, 0, b, 0, r2, 0, nv, c_id, c_len, c_lits, n_cl);
  let _ = bb_row(obuf, opos, "SAT2 mulov miter, TWO symbolic muls, demand", 0, n_cl[0], nv[0], 0);
  let _ = nv[1] = 32768;
  0
}

// --- the widened key, and fp_mul ---
// W1/W2 exercise the representation itself: variable 14 is the top nibble of
// word 0 and must work exactly like variable 0, and variable 15 is past
// mn_w() * mn_nv() and must be REFUSED (72) rather than aliasing variable 0 of
// the next word that does not exist.
//
// F1..F5 put `fp_mul` (selfhost/prelude/fp.bp:6-29) through the rule.  fp_mul is
// a Q32 fixed-point multiply: it splits both operands at bit 32, then splits the
// low halves again at bit 16, and every one of those splits is a FLOOR DIVISION,
// so lemma D1 introduces a fresh quotient variable per split.  Free variables
// after full substitution: a1, ah, al, b1, bh, bl, plus q1 = floor(al*bl/2^16),
// q2 = floor((ah*bl + al*bh + q1)/2^16), and Q = floor(a0*b0/2^32) -- NINE, at
// degree 2.  That is why the 4-variable key had to be widened, and it is also
// why widening was not sufficient: see F3.
fn fp_selftest(obuf: [i64], opos: [i64], R: [i64], cells: i64) -> i64 {
  // W1: the top variable of the word behaves like any other
  let _ = rg_init(R, cells);
  let px = rg_var(R, rg_new(R, 4), 0);
  let pw = rg_var(R, rg_new(R, 4), 14);
  let sxw = rg_add(R, px, pw, rg_new(R, 8));
  let lhs = rg_mul(R, sxw, sxw, rg_new(R, 16));
  let xx = rg_mul(R, px, px, rg_new(R, 8));
  let ww = rg_mul(R, pw, pw, rg_new(R, 8));
  let xw = rg_mul(R, px, pw, rg_new(R, 8));
  let xw2 = rg_scale(R, xw, 2, rg_new(R, 8));
  let t1 = rg_add(R, xx, xw2, rg_new(R, 16));
  let rhs = rg_add(R, t1, ww, rg_new(R, 16));
  let _ = R[4] = R[lhs];
  let _ = rg_row(obuf, opos, "W1 key var14 (x+v14)^2 expands    want 1", rg_eq(R, lhs, rhs), R);

  // W2 NEG: variable 15 is out of the 15-variable budget and must be refused
  let _ = rg_init(R, cells);
  let px = rg_var(R, rg_new(R, 4), 0);
  let pv = rg_var(R, rg_new(R, 4), 15);
  let _ = R[4] = R[pv];
  let _ = rg_row(obuf, opos, "W2 key var15 past budget  NEG     want 0 reject=72", rg_eq(R, pv, px), R);

  // F1: the bit-32 split recombines, AND the high half vanishes.  Over Z/2^64 the
  // a1*b1 term carries 2^32 * 2^32 == 2^64 == 0, so it is dropped by canon -- the
  // ring rule demonstrating, rather than being told, that it cannot see overflow.
  let _ = rg_init(R, cells);
  let a1 = rg_var(R, rg_new(R, 4), 0);
  let ah = rg_var(R, rg_new(R, 4), 1);
  let al = rg_var(R, rg_new(R, 4), 2);
  let b1 = rg_var(R, rg_new(R, 4), 3);
  let bh = rg_var(R, rg_new(R, 4), 4);
  let bl = rg_var(R, rg_new(R, 4), 5);
  let ahs = rg_scale(R, ah, 65536, rg_new(R, 4));
  let a0 = rg_add(R, ahs, al, rg_new(R, 8));
  let bhs = rg_scale(R, bh, 65536, rg_new(R, 4));
  let b0 = rg_add(R, bhs, bl, rg_new(R, 8));
  let a1s = rg_scale(R, a1, 4294967296, rg_new(R, 4));
  let aa = rg_add(R, a1s, a0, rg_new(R, 8));
  let b1s = rg_scale(R, b1, 4294967296, rg_new(R, 4));
  let ab = rg_add(R, b1s, b0, rg_new(R, 8));
  let lhs = rg_mul(R, aa, ab, rg_new(R, 32));
  let a1b0 = rg_mul(R, a1, b0, rg_new(R, 8));
  let a0b1 = rg_mul(R, a0, b1, rg_new(R, 8));
  let mid = rg_add(R, a1b0, a0b1, rg_new(R, 16));
  let mids = rg_scale(R, mid, 4294967296, rg_new(R, 16));
  let a0b0 = rg_mul(R, a0, b0, rg_new(R, 16));
  let rhs = rg_add(R, mids, a0b0, rg_new(R, 32));
  let _ = R[4] = R[lhs];
  let _ = rg_row(obuf, opos, "F1 fp split aa*ab == mid*2^32+a0*b0  want 1", rg_eq(R, lhs, rhs), R);

  // F1n NEG: one off and the recombination is gone
  let _ = rg_init(R, cells);
  let a1 = rg_var(R, rg_new(R, 4), 0);
  let ah = rg_var(R, rg_new(R, 4), 1);
  let al = rg_var(R, rg_new(R, 4), 2);
  let b1 = rg_var(R, rg_new(R, 4), 3);
  let bh = rg_var(R, rg_new(R, 4), 4);
  let bl = rg_var(R, rg_new(R, 4), 5);
  let ahs = rg_scale(R, ah, 65536, rg_new(R, 4));
  let a0 = rg_add(R, ahs, al, rg_new(R, 8));
  let bhs = rg_scale(R, bh, 65536, rg_new(R, 4));
  let b0 = rg_add(R, bhs, bl, rg_new(R, 8));
  let a1s = rg_scale(R, a1, 4294967296, rg_new(R, 4));
  let aa = rg_add(R, a1s, a0, rg_new(R, 8));
  let b1s = rg_scale(R, b1, 4294967296, rg_new(R, 4));
  let ab = rg_add(R, b1s, b0, rg_new(R, 8));
  let lhs = rg_mul(R, aa, ab, rg_new(R, 32));
  let a1b0 = rg_mul(R, a1, b0, rg_new(R, 8));
  let a0b1 = rg_mul(R, a0, b1, rg_new(R, 8));
  let mid = rg_add(R, a1b0, a0b1, rg_new(R, 16));
  let mids = rg_scale(R, mid, 4294967296, rg_new(R, 16));
  let a0b0 = rg_mul(R, a0, b0, rg_new(R, 16));
  let one = rg_const(R, rg_new(R, 4), 1);
  let t = rg_add(R, mids, a0b0, rg_new(R, 32));
  let rhs = rg_add(R, t, one, rg_new(R, 32));
  let _ = R[4] = R[lhs];
  let _ = rg_row(obuf, opos, "F1n fp split off by one   NEG        want 0", rg_eq(R, lhs, rhs), R);

  // F2: the bit-16 split of the low halves recombines
  let _ = rg_init(R, cells);
  let ah = rg_var(R, rg_new(R, 4), 1);
  let al = rg_var(R, rg_new(R, 4), 2);
  let bh = rg_var(R, rg_new(R, 4), 4);
  let bl = rg_var(R, rg_new(R, 4), 5);
  let ahs = rg_scale(R, ah, 65536, rg_new(R, 4));
  let a0 = rg_add(R, ahs, al, rg_new(R, 8));
  let bhs = rg_scale(R, bh, 65536, rg_new(R, 4));
  let b0 = rg_add(R, bhs, bl, rg_new(R, 8));
  let lhs = rg_mul(R, a0, b0, rg_new(R, 16));
  let ahbh = rg_mul(R, ah, bh, rg_new(R, 8));
  let hi = rg_scale(R, ahbh, 4294967296, rg_new(R, 8));
  let ahbl = rg_mul(R, ah, bl, rg_new(R, 8));
  let albh = rg_mul(R, al, bh, rg_new(R, 8));
  let cr = rg_add(R, ahbl, albh, rg_new(R, 16));
  let crs = rg_scale(R, cr, 65536, rg_new(R, 16));
  let albl = rg_mul(R, al, bl, rg_new(R, 8));
  let t = rg_add(R, hi, crs, rg_new(R, 16));
  let rhs = rg_add(R, t, albl, rg_new(R, 16));
  let _ = R[4] = R[lhs];
  let _ = rg_row(obuf, opos, "F2 fp split a0*b0 at bit 16          want 1", rg_eq(R, lhs, rhs), R);

  // F2n NEG: the cross term really is required
  let _ = rg_init(R, cells);
  let ah = rg_var(R, rg_new(R, 4), 1);
  let al = rg_var(R, rg_new(R, 4), 2);
  let bh = rg_var(R, rg_new(R, 4), 4);
  let bl = rg_var(R, rg_new(R, 4), 5);
  let ahs = rg_scale(R, ah, 65536, rg_new(R, 4));
  let a0 = rg_add(R, ahs, al, rg_new(R, 8));
  let bhs = rg_scale(R, bh, 65536, rg_new(R, 4));
  let b0 = rg_add(R, bhs, bl, rg_new(R, 8));
  let lhs = rg_mul(R, a0, b0, rg_new(R, 16));
  let ahbh = rg_mul(R, ah, bh, rg_new(R, 8));
  let hi = rg_scale(R, ahbh, 4294967296, rg_new(R, 8));
  let albl = rg_mul(R, al, bl, rg_new(R, 8));
  let rhs = rg_add(R, hi, albl, rg_new(R, 16));
  let _ = R[4] = R[lhs];
  let _ = rg_row(obuf, opos, "F2n fp split no cross term  NEG      want 0", rg_eq(R, lhs, rhs), R);

  // F3 THE MITER, and the real answer for fp_mul.  fp_mul's result is
  //   p    = a1*b1*2^32 + (a1*b0 + a0*b1) + (ah*bh + q2)
  // and the claim compares it against
  //   (aa*ab) >> 32 = a1*b1*2^32 + (a1*b0 + a0*b1) + Q,   Q = floor(a0*b0/2^32).
  // Everything cancels except `ah*bh + q2 == Q`, which is NOT a polynomial
  // identity: q2 and Q are independent D1 quotient variables and equating them
  // needs the NESTED-FLOOR law floor(floor(x/m)/n) == floor(x/(m*n)), an ORDER
  // fact about remainder bounds.  So the rule REFUSES, and the term count below
  // is the residual it is left holding.
  let _ = rg_init(R, cells);
  let a1 = rg_var(R, rg_new(R, 4), 0);
  let ah = rg_var(R, rg_new(R, 4), 1);
  let al = rg_var(R, rg_new(R, 4), 2);
  let b1 = rg_var(R, rg_new(R, 4), 3);
  let bh = rg_var(R, rg_new(R, 4), 4);
  let bl = rg_var(R, rg_new(R, 4), 5);
  let q2 = rg_var(R, rg_new(R, 4), 7);
  let bq = rg_var(R, rg_new(R, 4), 8);
  let ahs = rg_scale(R, ah, 65536, rg_new(R, 4));
  let a0 = rg_add(R, ahs, al, rg_new(R, 8));
  let bhs = rg_scale(R, bh, 65536, rg_new(R, 4));
  let b0 = rg_add(R, bhs, bl, rg_new(R, 8));
  let a1b1 = rg_mul(R, a1, b1, rg_new(R, 8));
  let hi = rg_scale(R, a1b1, 4294967296, rg_new(R, 8));
  let a1b0 = rg_mul(R, a1, b0, rg_new(R, 8));
  let a0b1 = rg_mul(R, a0, b1, rg_new(R, 8));
  let mid = rg_add(R, a1b0, a0b1, rg_new(R, 16));
  let ahbh = rg_mul(R, ah, bh, rg_new(R, 8));
  let low = rg_add(R, ahbh, q2, rg_new(R, 8));
  let t = rg_add(R, hi, mid, rg_new(R, 16));
  let pfp = rg_add(R, t, low, rg_new(R, 32));
  let tg = rg_add(R, t, bq, rg_new(R, 32));
  let res = rg_sub(R, pfp, tg, rg_new(R, 32), rg_new(R, 32));
  let _ = R[4] = R[res];
  let _ = rg_row(obuf, opos, "F3 fp_mul p == (a*b)>>32 MITER       want 0", rg_eq(R, pfp, tg), R);

  // F4 RESIDUAL ISOLATION (a diagnostic, NOT a proof): hand the rule the
  // nested-floor law's conclusion Q := ah*bh + q2 and the miter closes.  F3 = 0
  // and F4 = 1 together say the residual after ring + D1 is EXACTLY that one
  // law and nothing else -- and that the rule cannot get there itself, because
  // deciding identity is not the same as reasoning from hypotheses.
  let _ = rg_init(R, cells);
  let a1 = rg_var(R, rg_new(R, 4), 0);
  let ah = rg_var(R, rg_new(R, 4), 1);
  let al = rg_var(R, rg_new(R, 4), 2);
  let b1 = rg_var(R, rg_new(R, 4), 3);
  let bh = rg_var(R, rg_new(R, 4), 4);
  let bl = rg_var(R, rg_new(R, 4), 5);
  let q2 = rg_var(R, rg_new(R, 4), 7);
  let ahs = rg_scale(R, ah, 65536, rg_new(R, 4));
  let a0 = rg_add(R, ahs, al, rg_new(R, 8));
  let bhs = rg_scale(R, bh, 65536, rg_new(R, 4));
  let b0 = rg_add(R, bhs, bl, rg_new(R, 8));
  let a1b1 = rg_mul(R, a1, b1, rg_new(R, 8));
  let hi = rg_scale(R, a1b1, 4294967296, rg_new(R, 8));
  let a1b0 = rg_mul(R, a1, b0, rg_new(R, 8));
  let a0b1 = rg_mul(R, a0, b1, rg_new(R, 8));
  let mid = rg_add(R, a1b0, a0b1, rg_new(R, 16));
  let ahbh = rg_mul(R, ah, bh, rg_new(R, 8));
  let low = rg_add(R, ahbh, q2, rg_new(R, 8));
  let t = rg_add(R, hi, mid, rg_new(R, 16));
  let pfp = rg_add(R, t, low, rg_new(R, 32));
  let tg = rg_add(R, t, low, rg_new(R, 32));
  let _ = R[4] = R[pfp];
  let _ = rg_row(obuf, opos, "F4 fp_mul with nested-floor GIVEN    want 1", rg_eq(R, pfp, tg), R);

  // F4n NEG: a wrong residual must not close it
  let _ = rg_init(R, cells);
  let ah = rg_var(R, rg_new(R, 4), 1);
  let bh = rg_var(R, rg_new(R, 4), 4);
  let q2 = rg_var(R, rg_new(R, 4), 7);
  let ahbh = rg_mul(R, ah, bh, rg_new(R, 8));
  let low = rg_add(R, ahbh, q2, rg_new(R, 8));
  let one = rg_const(R, rg_new(R, 4), 1);
  let bad = rg_add(R, low, one, rg_new(R, 8));
  let _ = R[4] = R[low];
  let _ = rg_row(obuf, opos, "F4n fp_mul wrong residual  NEG       want 0", rg_eq(R, low, bad), R);

  // F5: the missing law, CHECKED where it is checkable -- on a constant, with
  // the floor lemmas that already exist.  floor(floor(x/2^16)/2^16) computed by
  // two D1 splits must equal floor(x/2^32) computed by one.  This is the law
  // fp_mul needs; what the rule cannot do is establish it SYMBOLICALLY.
  let _ = rg_init(R, cells);
  let x = rg_const(R, rg_new(R, 4), 123456789012345);
  let q1 = rg_new(R, 4);
  let r1 = rg_new(R, 4);
  let _ = dv_split(R, x, 65536, q1, r1);
  let q2 = rg_new(R, 4);
  let r2 = rg_new(R, 4);
  let _ = dv_split(R, q1, 65536, q2, r2);
  let q3 = rg_new(R, 4);
  let r3 = rg_new(R, 4);
  let _ = dv_split(R, x, 4294967296, q3, r3);
  let _ = rg_row(obuf, opos, "F5 nested floor /2^16/2^16 == /2^32  want 1", rg_eq(R, q2, q3), R);

  // F5n NEG: the composition is 2^16 * 2^16, not 2^31
  let _ = rg_init(R, cells);
  let x = rg_const(R, rg_new(R, 4), 123456789012345);
  let q1 = rg_new(R, 4);
  let r1 = rg_new(R, 4);
  let _ = dv_split(R, x, 65536, q1, r1);
  let q2 = rg_new(R, 4);
  let r2 = rg_new(R, 4);
  let _ = dv_split(R, q1, 65536, q2, r2);
  let q4 = rg_new(R, 4);
  let r4 = rg_new(R, 4);
  let _ = dv_split(R, x, 2147483648, q4, r4);
  let _ = rg_row(obuf, opos, "F5n nested floor vs /2^31   NEG      want 0", rg_eq(R, q2, q4), R);

  0
}

// --- path helpers ---
fn str_to_cells(dst: [i64], src: str) -> i64 {
  let i = 0;
  let done = 0;
  while done == 0 {
    let c = char(src, i);
    let _ = dst[i] = c;
    let done = if c == 0 then 1 else 0;
    let i = i + 1;
    0
  };
  i
}

fn load_obl(path: str) -> str {
  let lp = str_len(path);
  let pp = zeros(lp + 1);
  let _ = str_to_cells(pp, path);
  let fd = sys_open(pp, lp, 0);
  let _ = if fd >= 0 then 0 else sys_exit(90);
  let s = sys_slurp(fd, 4000000);
  let _ = sys_close(fd);
  s
}

// --- entry point ---
// argv[0] = seed loader, argv[1] = this .bin (see gbpool.bp:22 convention), so
// the user certificate starts at argv[2].
fn main(argc: i64, argv: [str]) -> i64 {
  let _ = if argc >= 3 then 0 else sys_exit(64);
  let cpath = argv[2];
  let lc = str_len(cpath);
  let pc = zeros(lc + 1);
  let _ = str_to_cells(pc, cpath);
  // argv[2] == "selftest" runs the bit-blaster selftest instead of the
  // certificate check.  Every array the selftest needs is allocated HERE:
  // nothing below main calls zeros().
  let st_mode = if lc == 8 then (if pc[0] == 115 then (if pc[1] == 101 then (if pc[2] == 108 then (if pc[3] == 102 then 1 else 0) else 0) else 0) else 0) else 0;
  // The selftest arena, sized for the widest single obligation the blaster
  // builds -- a symbolic 64x64 bb_mul64, whose folded demand is measured in
  // the SIZE row below.  sz_l MUST be sz_c * 32 (bb_emit's clause stride).
  // These are arena numbers only; the certificate FORMAT limits in the header
  // comment are unchanged.
  let sz_c = if st_mode == 1 then 65536 else 1;
  let sz_l = if st_mode == 1 then 2097152 else 1;
  let sz_a = if st_mode == 1 then 32768 else 1;
  let sz_w = if st_mode == 1 then 64 else 1;
  let sc_id = zeros(sz_c);
  let sc_len = zeros(sz_c);
  let sc_lits = zeros(sz_l);
  let sassign = zeros(sz_a);
  let sobuf = zeros(256);
  let sopos = [0];
  let snv = zeros(2);
  let sn_cl = zeros(2);
  let _ = sn_cl[1] = sz_c;
  let _ = snv[1] = sz_a;
  let sa = zeros(sz_w);
  let sb = zeros(sz_w);
  let sr = zeros(sz_w);
  let ssh = zeros(sz_w);
  let sz_r = if st_mode == 1 then 8192 else 1;
  let sring = zeros(sz_r);
  let _ = if st_mode == 1 then bb_selftest(sobuf, sopos, sc_id, sc_len, sc_lits, sn_cl, sassign, snv, sa, sb, sr, ssh) else 0;
  let _ = if st_mode == 1 then rg_selftest(sobuf, sopos, sring, sz_r) else 0;
  let _ = if st_mode == 1 then dv_selftest(sobuf, sopos, sring, sz_r) else 0;
  let _ = if st_mode == 1 then ob_selftest(sobuf, sopos, sring, sz_r) else 0;
  let _ = if st_mode == 1 then fp_selftest(sobuf, sopos, sring, sz_r) else 0;
  let _ = if st_mode == 1 then ob_satsize(sobuf, sopos, sc_id, sc_len, sc_lits, sn_cl, sassign, snv, sa, sb, sr, ssh) else 0;
  let _ = if st_mode == 1 then sys_exit(0) else 0;
  let fd = sys_open(pc, lc, 0);
  let _ = if fd >= 0 then 0 else sys_exit(90);
  let cert = sys_slurp(fd, 4000000);
  let _ = sys_close(fd);
  let og = if argc >= 4 then 1 else 0;
  let obl = if og == 1 then load_obl(argv[3]) else 0;
  verify_cert(cert, obl, og)
}