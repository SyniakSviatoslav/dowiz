module core { }

// Instruction emitter: growable i64 instruction buffer + AArch64 movz encoder.

fn emit(insns: [i64], count: i64, word: i64) -> i64 {
  let _ = insns[count] = word;
  count + 1
}

fn emit_buf(insns: [i64], count: i64) -> i64 { count }

fn movz(d: i64, imm: i64) -> i64 { 3523215360 + d + imm * 32 }
