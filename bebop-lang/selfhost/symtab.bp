// selfhost/symtab.bp — linear-probe symbol table via flat [i64] array.
// Each entry: 2 slots (name_hash, ty). Entry i at tbl[2*i], tbl[2*i+1].
// n = number of entries; array length must be >= 2*n for insert.
// djb2 hash: h = h*33 + c (implemented in djb2.bp).

module core { }

// symtab_lookup: linear scan for name_hash, returns index (0..n-1) or -1.
fn symtab_lookup(tbl: [i64], n: i64, name_hash: i64) -> i64 {
  let i = 0;
  let result = 0 - 1;
  while i < n {
    let h = tbl[i * 2];
    let result = if h == name_hash then i else result;
    let i = i + 1;
    0
  };
  result
}

// symtab_insert: append (name_hash, ty) at position n, return new n.
fn symtab_insert(tbl: [i64], n: i64, name_hash: i64, ty: i64) -> i64 {
  let _ = tbl[n * 2] = name_hash;
  let _ = tbl[n * 2 + 1] = ty;
  n + 1
}