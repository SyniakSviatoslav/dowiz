// sys_arena_base(): mov x0, x27 — the seed loader's arena cursor
// (post-argv). x27/x28 are reserved by the register protocol and survive
// into the program; callers derive shared cell addresses as
// sys_arena_base() + idx * 8. Assembler-verified (m6.s).
fn emit_sys_arena_base(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
