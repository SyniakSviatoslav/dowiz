  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 3);
  let _ = pop(insns, n, 2);
  let _ = pop(insns, n, 1);
  let _ = pop(insns, n, 0);
  let _ = em(insns, n, 3019898976);
  let _ = em(insns, n, 2332167201);
  let _ = em(insns, n, 4177526819);
  let _ = em(insns, n, 2854159328);
  let _ = push(insns, n);
  n[0]
}

