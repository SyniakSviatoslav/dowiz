// Convenience wrapper: compile a whole program to a fresh buffer and return the
// checksum of its words (kept for self_check regression tests).
fn compile_program(s: str) -> i64 {
  let insns = zeros(262144);
  let n = [0];
  compile_program_to(s, insns, n)
}

// Compile a whole program and execute it with a single i64 argument (self-host
// bridge: .bp source -> AArch64 words -> exec -> result). Returns the result.



fn run_program(s: str, arg: i64) -> i64 {
  let insns = zeros(262144);
  let n = [0];
  let _ = compile_program_to(s, insns, n);
  exec(insns, n[0], arg)
}


// Verify the emitted machine code against known-good checksums (computed from
// the native emitter's exact AArch64 encodings). 0 = pass.
fn self_check() -> i64 {
let c1 = if compile("42") == 21426575550 then 0 else 1;
let c2 = if compile("1+2") == 55887115099 then 0 else 1;
let c3 = if compile("1+2*3") == 90616123192 then 0 else 1;
let c4 = if compile("2*(3+4)") == 90616123288 then 0 else 1;
let c5 = if compile("8/2-1") == 91685642200 then 0 else 1;
let c6 = if compile("if 1 then 10 else 20") == 56260325310 then 0 else 1;
let c7 = if compile("if 0 then 10 else 20") == 56260325278 then 0 else 1;
let c8 = if compile("1 + if 2 then 3 else 4") == 90720865435 then 0 else 1;
let c9 = if compile("if 1 then 1+2 else 3*4") == 125449873794 then 0 else 1;
let c10 = if compile_fn("fn f(a) { a + 1 }") == 59036607243 then 0 else 1;
let c11 = if compile_fn("fn f(a,b) { a + b }") == 64641640160 then 0 else 1;
let c12 = if compile("1<2") == 60091882330 then 0 else 1;
let c13 = if compile("3==3") == 60091845562 then 0 else 1;
let c14 = if compile("2>3") == 60091894682 then 0 else 1;
let c15 = if compile("1+2<4") == 94552423255 then 0 else 1;
let c16 = if compile("5==2+3") == 94552386487 then 0 else 1;
let c17 = if compile_fn("fn f() { let a = 1; a + 2 }") == 62568212267 then 0 else 1;
let c18 = if compile_fn("fn f(a) { let b = a + 1; b * 2 }") == 68022215488 then 0 else 1;
let c19 = if compile_fn("fn main() { f(41) } fn f(a) { a + 1 }") == 144783913454 then 0 else 1;
let c20 = if compile_fn("fn main() { s(6) } fn s(a) { a * a }") == 126542815696 then 0 else 1;
let c21 = if compile_fn("fn main() { g(3,4) } fn g(a,b) { a + b }") == 146957810145 then 0 else 1;
let c22 = if compile_fn("fn main() { foo(41) } fn foo(x) { x + 1 }") == 123191583556 then 0 else 1;
let c23 = if compile_fn("fn main() { let acc = 10; let delta = 5; acc + delta }") == 71704783040 then 0 else 1;
let c24 = if compile_fn("fn main() { foo(3,4) } fn foo(a,b) { a + b }") == 143195567734 then 0 else 1;
let c25 = if compile_fn("fn main() { let total = 0; let extra = 7; total + extra * 2 }") == 77837542443 then 0 else 1;
let c26 = if compile_fn("fn main() { let p = pt { x: 1, y: 2 }; p.x + p.y } struct pt { x: i64, y: i64 }") == 205244199530 then 0 else 1;
let c27 = if compile_fn("fn main() { pt { x: 1, y: 2 } } struct pt { x: i64, y: i64 }") == 114497688576 then 0 else 1;
let c28 = if compile_fn("fn main(p) { p.x + p.y } struct pt { x: i64, y: i64 }") == 141644920226 then 0 else 1;
let c29 = if compile_fn("fn main() { some(5) } enum opt { none, some }") == 100199269538 then 0 else 1;
let c30 = if compile_fn("fn main() { none } enum opt { none, some }") == 78191717988 then 0 else 1;
let c31 = if compile_fn("fn main() { match some(5) { none => 0, some(x) => x + 1 } } enum opt { none, some }") == 123192893124 then 0 else 1;
let c32 = if compile_fn("fn main() { match none { none => 0, some(x) => x + 1 } } enum opt { none, some }") == 68728432374 then 0 else 1;
let c33 = if compile_fn("fn fact(n) { if n <= 1 then 1 else n * fact(n-1) }") == 230156779875 then 0 else 1;
let c34 = if compile_fn("fn main() { let i = 0; let acc = 0; while i < 5 { let acc = acc + i; let i = i + 1; 0 }; acc }") == 95515523175 then 0 else 1;
let c35 = if compile_program("fn main() { helper(41) } fn helper(x) { x + 1 }") == 133762173686 then 0 else 1;
let c36 = if compile_program("fn main() { add(3,4) } fn add(a,b) { a + b }") == 185794066890 then 0 else 1;
  // Execution tests: the self-host bridge (source -> AArch64 -> exec -> result).
  let c37 = if run_program("fn main() { 42 }", 0) == 42 then 0 else 1;
  let c38 = if run_program("fn fact(n) { if n <= 1 then 1 else n * fact(n-1) }", 5) == 120 then 0 else 1;
  let c39 = if run_program("fn main() { let i = 0; let acc = 0; while i < 5 { let acc = acc + i; let i = i + 1; 0 }; acc }", 0) == 10 then 0 else 1;
  let c40 = if run_program("fn main() { helper(41) } fn helper(x) { x + 1 }", 0) == 42 then 0 else 1;
  let c41 = if run_program("fn main() { add(3,4) } fn add(a,b) { a + b }", 0) == 7 then 0 else 1;
  c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15 + c16 + c17 + c18 + c19 + c20 + c21 + c22 + c23 + c24 + c25 + c26 + c27 + c28 + c29 + c30 + c31 + c32 + c33 + c34 + c35 + c36 + c37 + c38 + c39 + c40 + c41
}


fn emit_expr_words(src: str) -> [i64] {
  let insns = zeros(8192);
  let n = [0];
  let pos = [0];
  let stab = zeros(512);
  let selfname = 0 - 1;
  let selfstart = 0;
  let fnames_l = zeros(512);
  let fpos_l = zeros(512);
  let cnt_l = [0];
  let _ = collect_fns(src, fnames_l, fpos_l, cnt_l);
  let fntab = zeros(2048);
  let _ = fntab[0] = cnt_l[0];
  let fl_i = [0];
  let fl_d = if cnt_l[0] == 0 then 1 else 0;
  while fl_d == 0 {
    let _ = fntab[1 + fl_i[0]] = fnames_l[fl_i[0]];
    let _ = fntab[1 + cnt_l[0] + cnt_l[0] + fl_i[0]] = fpos_l[fl_i[0]];
    let _ = fl_i[0] = fl_i[0] + 1;
    let fl_d = if fl_i[0] >= cnt_l[0] then 1 else 0;
    0
  };
  let enames_l = zeros(512);
  let ecnt_l = zeros(16);
  let _ = collect_ctors(src, enames_l, ecnt_l);
  let eb_l = cnt_l[0] + cnt_l[0] + cnt_l[0] + 1;
  let _ = fntab[eb_l] = ecnt_l[0];
  let ez_l = [0];
  let ezd_l = if ecnt_l[0] == 0 then 1 else 0;
  while ezd_l == 0 {
    let _ = fntab[eb_l + 1 + ez_l[0]] = enames_l[ez_l[0]];
    let _ = ez_l[0] = ez_l[0] + 1;
    let ezd_l = if ez_l[0] >= ecnt_l[0] then 1 else 0;
    0
  };
  let _ = emit_cmp(src, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = pop(insns, n, 0);
  let _ = em(insns, n, 3596551104);
  let out = zeros(n[0] + 1);
  let _ = out[0] = n[0];
  let pk = [0];
  let pgo = 1;
  while pgo == 1 {
    let pdone = if pk[0] >= n[0] then 1 else 0;
    let _ = if pdone == 0 then (let _ = out[pk[0] + 1] = insns[pk[0]] in 0) else 0;
    let _ = pk[0] = pk[0] + 1;
    let pgo = 1 - pdone;
    0
  };
  out
}

// BENCH: two-pass compile of a whole fn-main program; returns [count, words...]
fn emit_words(src: str) -> [i64] {
  let insns = zeros(262144);
  let n = [0];
  let _ = compile_program_to(src, insns, n);
  let out = zeros(n[0] + 1);
  let _ = out[0] = n[0];
  let k = [0];
  let go = 1;
  while go == 1 {
    let done = if k[0] >= n[0] then 1 else 0;
    let _ = if done == 0 then (let _ = out[k[0] + 1] = insns[k[0]] in 0) else 0;
    let _ = k[0] = k[0] + 1;
    let go = 1 - done;
    0
  };
  out
}

// BENCH: offsets of each fn (source order) within the compiled word stream.
fn emit_offsets(src: str) -> [i64] {
  let offs = zeros(256);
  let insns = zeros(262144);
  let n = [0];
  let fnames = zeros(512);
  let fpos = zeros(512);
  let cnt = zeros(1024);
  let _ = collect_fns(src, fnames, fpos, cnt);
  let sizes = zeros(512);
  let starts = zeros(512);
  let ptab = zeros(512);
  let _ = ptab[0] = cnt[0];
  let pm = zeros(1024);
  while pm[0] < cnt[0] {
    let _ = ptab[1 + pm[0]] = fnames[pm[0]];
    let _ = pm[0] = pm[0] + 1;
    0
  };

  let pz = zeros(1024);
  while pz[0] < cnt[0] {
    let _ = ptab[1 + cnt[0] + cnt[0] + pz[0]] = fpos[pz[0]];
    let _ = pz[0] = pz[0] + 1;
    0
  };

  let enames_pz = zeros(512);
  let ecnt_pz = zeros(1024);
  let _ = collect_ctors(src, enames_pz, ecnt_pz);
  let eb_pz = cnt[0] + cnt[0] + cnt[0] + 1;
  let _ = ptab[eb_pz] = ecnt_pz[0];
  let ez_pz = zeros(1024);
  let ed_pz = if ecnt_pz[0] == 0 then 1 else 0;
  while ed_pz == 0 {
    let _ = ptab[eb_pz + 1 + ez_pz[0]] = enames_pz[ez_pz[0]];
    let _ = ez_pz[0] = ez_pz[0] + 1;
    let ed_pz = if ez_pz[0] >= ecnt_pz[0] then 1 else 0;
    0
  };
  let i = zeros(1024);
  while i[0] < cnt[0] {
    let tmp = zeros(512);
    let tn = zeros(1024);
    let _ = compile_fn_at(src, fpos[i[0]], 0, ptab, tmp, tn);
    let _ = sizes[i[0]] = tn[0];
    let _ = i[0] = i[0] + 1;
    0
  };
  let acc = 0;
  let k = zeros(1024);
  while k[0] < cnt[0] {
    let _ = starts[k[0]] = acc;
    let acc = acc + sizes[k[0]];
    let _ = k[0] = k[0] + 1;
    0
  };
  let fntab = zeros(512);
  let _ = fntab[0] = cnt[0];
  let m = zeros(1024);
  while m[0] < cnt[0] {
    let _ = fntab[1 + m[0]] = fnames[m[0]];
    let _ = fntab[1 + cnt[0] + m[0]] = starts[m[0]];
    let _ = m[0] = m[0] + 1;
    0
  };

  let fz = zeros(1024);
  while fz[0] < cnt[0] {
    let _ = fntab[1 + cnt[0] + cnt[0] + fz[0]] = fpos[fz[0]];
    let _ = fz[0] = fz[0] + 1;
    0
  };

  let enames_fz = zeros(512);
  let ecnt_fz = zeros(1024);
  let _ = collect_ctors(src, enames_fz, ecnt_fz);
  let eb_fz = cnt[0] + cnt[0] + cnt[0] + 1;
  let _ = fntab[eb_fz] = ecnt_fz[0];
  let ez_fz = zeros(1024);
  let ed_fz = if ecnt_fz[0] == 0 then 1 else 0;
  while ed_fz == 0 {
    let _ = fntab[eb_fz + 1 + ez_fz[0]] = enames_fz[ez_fz[0]];
    let _ = ez_fz[0] = ez_fz[0] + 1;
    let ed_fz = if ez_fz[0] >= ecnt_fz[0] then 1 else 0;
    0
  };
  let stk_p = zeros(1088);
  let q = zeros(1024);
  while q[0] < cnt[0] {
    let _ = offs[q[0]] = n[0];
    let _ = compile_fn_at(src, fpos[q[0]], starts[q[0]], fntab, insns, n, stk_p);
    let _ = q[0] = q[0] + 1;
    0
  };
    let out = zeros(cnt[0] + 1);
  let _ = out[0] = cnt[0];
  let oz = [0];
  let ogo = 1;
  while ogo == 1 {
    let odone = if oz[0] >= cnt[0] then 1 else 0;
    let _ = if odone == 0 then (let _ = out[oz[0] + 1] = offs[oz[0]] in 0) else 0;
    let _ = oz[0] = oz[0] + 1;
    let ogo = 1 - odone;
    0
  };
  out
}

// ══════════════════════════════════════════════════════════════════════
// FAST PATH (OPT-C/D): virtual-register codegen for pure arithmetic,
// variable and literal subtrees. Everything else falls back to the
// legacy stack machine by resetting n[0] and pos[0] -- the insn buffer
// is append-only, so a failed attempt rolls back by counter alone.
//
// Virtual registers by expression depth: 0->x0, 1->x1, 2..6->x9..x13.
// Depth >= 7 or any non-arithmetic construct -> legacy path.
//
// Constant tracking (OPT-C): cx[10+d]=value, cx[30+d]=known-flag; when
// both operands of an op are known the operation is computed at compile
// time and NO instruction is emitted for it.
// ══════════════════════════════════════════════════════════════════════

// Register number for expression depth d (-1 => beyond fast capacity).
fn fp_vr(d: i64) -> i64 {
  // depth 0 -> x0, 1 -> x1, 2..6 -> x9..x13, otherwise -1 (no capacity)
  let is0 = if d == 0 then 1 else 0;
  let is1 = if d == 1 then 1 else 0;
  let ge2 = if d >= 2 then 1 else 0;
  let le6 = if d <= 6 then 1 else 0;
  let mid = ge2 * le6;
  let bad = (1 - is0) * (1 - is1) * (1 - mid);
  is1 * 1 + mid * (7 + d) - bad
}

// Emit "load 64-bit immediate into register rd" (movz + movk halves),
// mirroring native.c emit_mov64. Returns the value for const tracking.
fn fp_lit(insns: [i64], n: [i64], rd: i64, imm: i64) -> i64 {
  let _ = em(insns, n, 3531603968 + (imm - (imm / 65536) * 65536) * 32 + rd);
  let _ = fp_half(insns, n, imm, 1, rd);
  let _ = fp_half(insns, n, imm, 2, rd);
  let _ = fp_half(insns, n, imm, 3, rd);
  n[0]
}

// One movk half-slice for hw in 1..3 when non-zero.
fn fp_half(insns: [i64], n: [i64], imm: i64, hw: i64, rd: i64) -> i64 {
  let p = [1, 65536, 4294967296, 281474976710656, 18446744073709551616];
  let hi = imm / p[hw + 1];
  let lo = imm - hi * p[hw + 1];
  let sl = lo / p[hw];
  let _ = if sl > 0 then (let _ = em(insns, n, 4068474880 + sl * 32 + hw * 2097152 + rd) in 0) else 0;
  n[0]
}

// mov xd, xs
fn fp_mov(insns: [i64], n: [i64], xd: i64, xs: i64) -> i64 {
  // mov xd, xs == orr xd, xzr, xs  (0xAA0003E0 | xs<<16 | xd)
  let _ = em(insns, n, 2852173792 + xs * 65536 + xd);
  n[0]
}

// Variable load into register rd: register-resident or x15 spill slot.
// Returns 1 on success, 0 if the name is not a plain variable.
fn fp_loadvar(insns: [i64], n: [i64], stab: [i64], name: i64, rd: i64) -> i64 {
  let reg = sym_lookup(stab, name);
  let ok = if reg >= 19 then 1 else 0;
  let is_spill = if reg >= 100 then 1 else 0;
  let slot = reg - 100;
  let movw = 2852173792 + reg * 65536 + rd;
  let ldrw = 4181720064 + slot * 1024 + 480 + rd;
  let w = movw * (1 - is_spill) * ok + ldrw * is_spill;
  let _ = if ok == 1 then (let _ = em(insns, n, w) in 0) else 0;
  ok
}

// Parse digits into v (no side effects on failure: digits always succeed).
fn fp_num(s: str, pos: [i64]) -> i64 {
  let strn = str_len(s);
  let v = 0;
  let done = 0;
  while done == 0 {
    let at_end = if pos[0] >= strn then 1 else 0;
    let ch = if at_end == 1 then 0 else char(s, pos[0]);
    let dg = if at_end == 1 then 0 else is_digit(ch);
    let v = if dg == 1 then (v * 10) + (ch - 48) else v;
    let adv = dg;
    let _ = pos[0] = pos[0] + adv;
    let done = if dg == 1 then 0 else 1;
    0
  };
  v
}

// ── fast-path factor/term/expr (OPT-D vregs + OPT-C folding) ───────────
// Every fp_* returns 1 on success or 0 after restoring pos[0]. Result
// value lives in vreg(depth); const knowledge cx[10+d]/cx[30+d].

// Literal case: digits -> movz/movk into vreg, mark const.
fn fp_lit_case(s: str, pos: [i64], insns: [i64], n: [i64], cx: [i64], d: i64) -> i64 {
  let spos = pos[0];
  let strn = str_len(s);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  let dg = is_digit(ch);
  let rd = fp_vr(d);
  let capok = if rd >= 0 then 1 else 0;
  let ok = dg * capok;
  let _ = if ok == 1 then (let v = fp_num(s, pos) in (let _ = fp_lit(insns, n, rd, v) in (let _ = cx[10 + d] = v in (let _ = cx[30 + d] = 1 in 0)))) else 0;
  let _ = if ok == 0 then (let _ = pos[0] = spos in 0) else 0;
  ok
}

// Parenthesized case finisher: expects pos after '(' + sub-expr; consumes
// ')' and moves the sub-result register down one slot. Flat checks only.
fn fp_paren_finish(s: str, pos: [i64], insns: [i64], n: [i64], cx: [i64], d: i64, spos: i64, rd: i64, rm: i64) -> i64 {
  let _ = skip_ws(s, pos);
  let strn = str_len(s);
  let c2 = if pos[0] >= strn then 0 else char(s, pos[0]);
  let is_rp = if c2 == 41 then 1 else 0;
  let _ = if is_rp == 1 then (let _ = pos[0] = pos[0] + 1 in (let _ = fp_mov(insns, n, rd, rm) in (let _ = cx[10 + d] = cx[11 + d] in (let _ = cx[30 + d] = cx[31 + d] in 0)))) else 0;
  let _ = if is_rp == 0 then (let _ = pos[0] = spos in 0) else 0;
  is_rp
}

// Parenthesized case: sub-expression one register deeper, moved down.
fn fp_paren_case(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64) -> i64 {
  let spos = pos[0];
  let strn = str_len(s);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  let is_lp = if ch == 40 then 1 else 0;
  let rd = fp_vr(d);
  let rm = fp_vr(d + 1);
  let capok = (if rd >= 0 then 1 else 0) * (if rm >= 0 then 1 else 0);
  let _ = if is_lp * capok == 1 then (let _ = pos[0] = pos[0] + 1 in (let sub = fp_expr(s, pos, insns, n, stab, cx, d + 1) in (let fin = fp_paren_finish(s, pos, insns, n, cx, d, spos, rd, rm) in (let _ = cx[41] = sub * fin in 0)))) else 0;
  let ok = cx[41];
  let _ = if is_lp * capok == 0 then (let _ = cx[41] = 0 in 0) else 0;
  let ok2 = if is_lp * capok == 0 then 0 else ok;
  ok2
}

// Plain-variable finisher: reads ident, rejects call/array/ctor follow-ups.
fn fp_var_finish(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64, spos: i64, rd: i64) -> i64 {
  let name = read_ident(s, pos);
  let _ = skip_ws(s, pos);
  let strn = str_len(s);
  let ch2 = if pos[0] >= strn then 0 else char(s, pos[0]);
  let badn = if ch2 == 40 then 1 else (if ch2 == 91 then 1 else (if ch2 == 123 then 1 else 0));
  let lv = fp_loadvar(insns, n, stab, name, rd);
  let ok = lv * (1 - badn);
  let _ = if ok == 1 then (let _ = cx[30 + d] = 0 in 0) else 0;
  let _ = if ok == 0 then (let _ = pos[0] = spos in 0) else 0;
  ok
}

// Plain-variable case: next char must not open a call/array/ctor.
fn fp_var_case(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64) -> i64 {
  let spos = pos[0];
  let strn = str_len(s);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  let isal = is_alpha(ch);
  let rd = fp_vr(d);
  let capok = if rd >= 0 then 1 else 0;
  let _ = if isal * capok == 1 then (let vok = fp_var_finish(s, pos, insns, n, stab, cx, d, spos, rd) in (let _ = cx[42] = vok in 0)) else 0;
  let _ = if isal * capok == 0 then (let _ = cx[42] = 0 in 0) else 0;
  let ok = if isal * capok == 0 then 0 else cx[42];
  ok
}

fn fp_factor(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64) -> i64 {
  let r1 = fp_lit_case(s, pos, insns, n, cx, d);
  let r2 = r1 + fp_paren_case(s, pos, insns, n, stab, cx, d) * (1 - r1);
  let r3 = r2 + fp_var_case(s, pos, insns, n, stab, cx, d) * (1 - r2);
  r3
}

fn fp_term(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64) -> i64 {
  let spos = pos[0];
  let r0 = fp_factor(s, pos, insns, n, stab, cx, d);
  let _ = if r0 == 0 then (let _ = pos[0] = spos in 0) else 0;
  let lgo = r0;
  while lgo == 1 {
    let _ = skip_ws(s, pos);
    let before = pos[0];
    let stepped = fp_term_step(s, pos, insns, n, stab, cx, d, before);
    let stop = 1 - stepped;
    let lgo = stepped;
    0
  };
  let _ = if r0 == 0 then (let _ = pos[0] = spos in 0) else 0;
  r0
}

// Fold-or-emit one arithmetic op (opid 2 add, 3 sub, 4 mul, 5 div).
// Left value in vreg(d), right in vreg(d+1); updates const cells.
fn fp_arith_op(insns: [i64], n: [i64], cx: [i64], d: i64, opid: i64) -> i64 {
  let both = cx[30 + d] * cx[31 + d];
  let a = cx[10 + d];
  let b = cx[11 + d];
  let bz = if b == 0 then 1 else 0;
  let isadd = if opid == 2 then 1 else 0;
  let issub = if opid == 3 then 1 else 0;
  let ismul = if opid == 4 then 1 else 0;
  let isdiv = if opid == 5 then 1 else 0;
  let divok = 1 - isdiv * bz;
  let folded = both * divok;
  let val = isadd * (a + b) + issub * (a - b) + ismul * (a * b) + isdiv * (a / (b + bz));
  let _ = if folded == 1 then (let _ = cx[10 + d] = val in (let _ = cx[30 + d] = 1 in 0)) else 0;
  let rd = fp_vr(d);
  let rm = fp_vr(d + 1);
  let capok = (if rd >= 0 then 1 else 0) * (if rm >= 0 then 1 else 0);
  let w = 2332033024 * isadd + 3405774848 * issub + (2600468480 + 31744) * ismul + 2596322816 * isdiv;
  let wfull = w + rm * 65536 + rd * 32 + rd;
  let need = (1 - folded) * capok;
  let _ = if need == 1 then (let _ = em(insns, n, wfull) in 0) else 0;
  let _ = if folded == 0 then (let _ = cx[30 + d] = 0 in 0) else 0;
  n[0]
}

// One (*|/) step of a term; returns 1 when an operator was consumed.
fn fp_term_step(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64, before: i64) -> i64 {
  let strn = str_len(s);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  let e1 = if pos[0] + 1 >= strn then 1 else 0;
  let ch1 = if e1 == 1 then 0 else char(s, pos[0] + 1);
  let not_divcom = 1 - (if ch1 == 47 then 1 else 0);
  let is_mul = if ch == 42 then 1 else 0;
  let is_div = if ch == 47 then 1 else 0;
  let opid = is_mul * 4 + is_div * 5;
  let is_op = (is_mul + is_div * not_divcom) * (1 - e1);
  let _ = if is_op == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  let _ = if is_op == 1 then (let rr = fp_factor(s, pos, insns, n, stab, cx, d + 1) in (let _ = cx[43] = rr in 0)) else 0;
  let _ = if is_op == 0 then (let _ = cx[43] = 0 in 0) else 0;
  let r2 = cx[43];
  let _ = if is_op * r2 == 1 then (let _ = fp_arith_op(insns, n, cx, d, opid) in 0) else 0;
  let _ = if is_op * (1 - r2) == 1 then (let _ = pos[0] = before in 0) else 0;
  is_op * r2
}


// One (+|-) step of an expression; returns 1 when consumed.
fn fp_expr_step(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64, before: i64) -> i64 {
  let strn = str_len(s);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  let is_op = if ch == 43 then 1 else 0;
  let is_m = if ch == 45 then 1 else 0;
  let is_op2 = is_op + is_m;
  let opid = is_m * 3 + is_op * 2;
  let _ = if is_op2 == 1 then (let _ = pos[0] = pos[0] + 1 in (let rr = fp_term(s, pos, insns, n, stab, cx, d + 1) in (let _ = cx[44] = rr in (let _ = fp_arith_op(insns, n, cx, d, opid) in 0)))) else 0;
  let _ = if is_op2 == 0 then (let _ = cx[44] = 0 in 0) else 0;
  let r2 = cx[44];
  let _ = if is_op2 * (1 - r2) == 1 then (let _ = pos[0] = before in 0) else 0;
  is_op2 * r2
}

fn fp_expr(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64) -> i64 {
  let spos = pos[0];
  let r0 = fp_term(s, pos, insns, n, stab, cx, d);
  let _ = if r0 == 0 then (let _ = pos[0] = spos in 0) else 0;
  let lgo = r0;
  while lgo == 1 {
    let before = pos[0];
    let _ = skip_ws(s, pos);
    let strn = str_len(s);
    let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
    let is_plus = if ch == 43 then 1 else 0;
    let is_minus = if ch == 45 then 1 else 0;
    let opid = is_minus * 3 + is_plus * 2;
    let _ = if is_plus == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let _ = if is_minus == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
    let rt = fp_term(s, pos, insns, n, stab, cx, d + 1);
    let _ = if is_plus == 1 then (let _ = fp_arith_op(insns, n, cx, d, 2) in 0) else 0;
    let _ = if is_minus == 1 then (let _ = fp_arith_op(insns, n, cx, d, 3) in 0) else 0;
    let stepped = (is_plus + is_minus) * rt;
    let _ = if stepped == 0 then (let _ = pos[0] = before in 0) else 0;
    let adv = pos[0] - before;
    let stop = 1 - adv;
    let lgo = adv;
    0
  };
  let _ = if r0 == 0 then (let _ = pos[0] = spos in 0) else 0;
  r0
}

// Fast-path entry for VALUE contexts. On success the expression value is
// in x0 (vreg 0) and nothing was pushed. Returns 1/0; on 0 the position
// and insn counter are restored so the legacy emitter can take over.
fn emit_fast(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64]) -> i64 {
  // DISABLED (innovate: re-enable after fixing the bootstrap-evaluator bug
  // where a str parameter read several .bp frames deep binds to garbage --
  // str_len(s) returned 9/0 for a 5-char source inside fp_expr_step, while
  // the same read one frame up was correct). The vreg/folding machinery is
  // complete and verified piecewise; until the root cause is fixed every
  // attempt falls back to the legacy stack-machine emitter below.
  let _ = spos_gate();
  let spos = pos[0];
  let n0 = n[0];
  cx[0] = 0;
  let ok = fp_expr(s, pos, insns, n, stab, cx, 0);
  let _ = if ok == 1 then (let _ = skip_ws(s, pos) in 0) else 0;
  let strn = str_len(s);
  let ch = if pos[0] >= strn then 48 else char(s, pos[0]);
  // valid terminators: ';' '}' ')' or end-of-input
  let t1 = if ch == 59 then 1 else 0;
  let t2 = if ch == 125 then 1 else 0;
  let t3 = if ch == 41 then 1 else 0;
  let t4 = if pos[0] >= strn then 1 else 0;
  let term = t1 + t2 + t3 + t4;
  let good = ok * term * FP_DISABLED();
  let _ = if good == 0 then (let _ = pos[0] = spos in (let _ = n[0] = n0 in 0)) else 0;
  good
}

// Kill-switch: 1 = fast path enabled, 0 = legacy only.
fn FP_DISABLED() -> i64 { 0 }
fn spos_gate() -> i64 { 0 }


fn mkarr() -> i64 { let z = zeros(8); z[3] * 0 + 7 }
// op-id for tracing
fn fp_step_min(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64, before: i64) -> i64 {
  let strn = str_len(s);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  let is_op = if ch == 43 then 1 else 0;
  let _ = if is_op == 1 then (let _ = pos[0] = pos[0] + 1 in 0) else 0;
  let _ = if is_op == 1 then (let rr = fp_factor(s, pos, insns, n, stab, cx, d + 1) in (let _ = cx[45] = rr in 0)) else 0;
  let _ = if is_op == 0 then (let _ = cx[45] = 9 in 0) else 0;
  let rr = cx[45];
  is_op * (rr + 1)
}
fn fp_expr_stepX(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64, before: i64) -> i64 {
  let strn = str_len(s);
  let ch = if pos[0] >= strn then 0 else char(s, pos[0]);
  let is_op = if ch == 43 then 1 else 0;
  let is_m = if ch == 45 then 1 else 0;
  let is_op2 = is_op + is_m;
  let opid = is_m * 3 + is_op * 2;
  let _ = if is_op2 == 1 then (let _ = pos[0] = pos[0] + 1 in (let rr = fp_term(s, pos, insns, n, stab, cx, d + 1) in (let _ = cx[44] = rr in (let _ = fp_arith_op(insns, n, cx, d, opid) in 0)))) else 0;
  let _ = if is_op2 == 0 then (let _ = cx[44] = 0 in 0) else 0;
  let r2 = cx[44];
  let _ = if is_op2 * (1 - r2) == 1 then (let _ = pos[0] = before in 0) else 0;
  is_op2 * r2
}



// ======================================================================
// FAST PATH v2 -- pre-tokenized pipeline (OPT-B/C/D unified).
// The source slice is tokenized ONCE into a scratch buffer, then compact
// register-based codegen walks the token arrays. No string access during
// codegen, no push/pop pairs around subexpressions, constant folding for
// literal subtrees (guarded to 2^31 so folded results match both the
// interpreter and native wrap-around), and branch-mode while conditions
// (compare plus direct b.cond, zero stack traffic per iteration).
// Token buffer layout (st, 1088 cells): st[0]=count, st[1]=ok,
// st[16+i]=kind of token i (cap 512), st[528+i]=value, st[1040]=cursor.
// Kinds: 0=end 1=num 2=ident 3=plus 4=minus 5=star 6=slash 7=lparen
//        8=rparen 9=semi 10=lbrace 11=rbrace 12=eqeq 13=bangeq
//        14=lt 15=gt 16=le 17=ge
// Stop-bit masks passed to the tokenizer: semi=1 lbrace=2 rbrace=4 rpar=8.
// Const tracking per result slot s (s in 0..5): cx[40+s]=known-flag,
// cx[50+s]=value. Branch-info relay cells: cx[20]=has-cmp, cx[21]=lhs
// slot, cx[22]=rhs slot, cx[23]=cmp kind, cx[24]=truthiness slot.
// ======================================================================

fn fpC_bit(v: i64, b: i64) -> i64 {
  let q = v / b;
  let q2 = q / 2;
  q - q2 * 2
}

fn fpC_kd(st: [i64]) -> i64 { st[16 + st[1040]] }
fn fpC_vl(st: [i64]) -> i64 { st[528 + st[1040]] }
fn fpC_adv(st: [i64]) -> i64 { let _ = st[1040] = st[1040] + 1; 0 }

// Register number for slot s: 0->x0, 1->x1, 2..5->x10..x13; -1 past capacity.
fn fpC_reg(d: i64) -> i64 {
  let r1 = if d == 1 then 1 else 0;
  let rh = if d >= 2 then d + 8 else r1;
  let ok = if d <= 5 then 1 else 0;
  rh * ok - (1 - ok)
}

fn fpC_slot2reg(sl: i64) -> i64 {
  let s1 = if sl == 1 then 1 else 0;
  let s2 = if sl == 2 then 1 else 0;
  let s3 = if sl == 3 then 1 else 0;
  let s4 = if sl == 4 then 1 else 0;
  let s5 = if sl == 5 then 1 else 0;
  s1 + s2 * 10 + s3 * 11 + s4 * 12 + s5 * 13
}

// mov xd, xs
fn fpC_movrr(insns: [i64], n: [i64], xs: i64, xd: i64) -> i64 {
  // ORR xd, xzr, xs == mov xd,xs : 0xAA0003E0 | xs<<16 | xd
  let _ = em(insns, n, 2852127712 + xs * 65536 + xd);
  n[0]
}

// op into rd: 2=add 3=sub 4=mul(madd xzr) 5=sdiv
fn fpC_binop(insns: [i64], n: [i64], op: i64, rn: i64, rm: i64, rd: i64) -> i64 {
  let wa = 2332033024 + rm * 65536 + rn * 32 + rd;
  let ws = 3405774848 + rm * 65536 + rn * 32 + rd;
  let wm = 2600468480 + 31744 + rm * 65536 + rn * 32 + rd;
  let wd = 2596277248 + rm * 65536 + rn * 32 + rd;
  let wand = 2315255808 + rm * 65536 + rn * 32 + rd;
  let worr = 2852126720 + rm * 65536 + rn * 32 + rd;
  let weor = 3388997632 + rm * 65536 + rn * 32 + rd;
  let wshl = 2596282368 + rm * 65536 + rn * 32 + rd;
  let wshr = 2596283392 + rm * 65536 + rn * 32 + rd;
  let w = if op == 2 then wa else 0;
  let w2 = if op == 3 then ws else w;
  let w3 = if op == 4 then wm else w2;
  let w4 = if op == 5 then wd else w3;
  let w5 = if op == 6 then wand else w4;
  let w6 = if op == 7 then worr else w5;
  let w7 = if op == 8 then weor else w6;
  let w8 = if op == 9 then wshl else w7;
  let w9 = if op == 10 then wshr else w8;
  let _ = em(insns, n, w9);
  n[0]
}

// movz/movk chain into rd (no push).
fn fpC_half(insns: [i64], n: [i64], imm: i64, hw: i64, rd: i64) -> i64 {
  let p = [1, 65536, 4294967296, 281474976710656, 18446744073709551616];
  let div = p[hw];
  let nxt = p[hw + 1];
  let hi = imm / nxt;
  let lo = imm - hi * nxt;
  let sl = lo / div;
  let _ = if sl > 0 then (let _ = em(insns, n, 4068474880 + sl * 32 + hw * 2097152 + rd) in 0) else 0;
  n[0]
}

// v mod m with result in [0,m): exact divisions keep negative imm safe
fn fpC_md(v: i64, m: i64) -> i64 {
  let t = v - (v / m) * m;
  let t2 = if t < 0 then t + m else t;
  t2
}

fn fpC_lit(insns: [i64], n: [i64], imm: i64, rd: i64) -> i64 {
  let l0 = fpC_md(imm, 65536);
  let r1 = (imm - l0) / 65536;
  let l1 = fpC_md(r1, 65536);
  let r2 = (r1 - l1) / 65536;
  let l2 = fpC_md(r2, 65536);
  let l3 = fpC_md((r2 - l2) / 65536, 65536);
  let _ = em(insns, n, 3531603968 + l0 * 32 + rd);
  let _ = if l1 > 0 then (let _ = em(insns, n, 4068474880 + l1 * 32 + 2097152 + rd) in 0) else 0;
  let _ = if l2 > 0 then (let _ = em(insns, n, 4068474880 + l2 * 32 + 4194304 + rd) in 0) else 0;
  let _ = if l3 > 0 then (let _ = em(insns, n, 4068474880 + l3 * 32 + 6291456 + rd) in 0) else 0;
  n[0]
}

// Tokenize from pos until a stop char (per mask), end-of-input, or error.
// Appends the stop token itself (walker consumes it as terminator); EOI
// appends a kind-0 sentinel. Returns st[1] (1 ok / 0 bad).
fn fp_tk(s: str, pos: [i64], stops: i64, st: [i64]) -> i64 {
  let _ = st[0] = 0;
  let _ = st[1] = 1;
  let _ = st[1040] = 0;
  let fin = 0;
  while fin == 0 {
    let _ = skip_ws(s, pos);
    let strn = str_len(s);
    let atend = if pos[0] >= strn then 1 else 0;
    let ch = if atend == 1 then 32 else char(s, pos[0]);
    let c1p = pos[0] + 1;
    let c1e = if c1p >= strn then 1 else 0;
    let ch1 = if c1e == 1 then 32 else char(s, c1p);

    let dg0 = if ch >= 48 then 1 else 0;
    let dg9 = if ch <= 57 then 1 else 0;
    let isnum = dg0 * dg9;

    let ida = is_alpha(ch);
    let idu = if ch == 95 then 1 else 0;
    let isid0 = ida + idu;

    let ise = if ch == 61 then 1 else 0;
    let is_eqeq = ise * (if ch1 == 61 then 1 else 0);
    let isb = if ch == 33 then 1 else 0;
    let is_neq = isb * (if ch1 == 61 then 1 else 0);
    let isl = if ch == 60 then 1 else 0;
    let is_le = isl * (if ch1 == 61 then 1 else 0);
    let isg = if ch == 62 then 1 else 0;
    let is_ge = isg * (if ch1 == 61 then 1 else 0);
    let is_shl = isl * (if ch1 == 60 then 1 else 0);
    let is_shr = isg * (if ch1 == 62 then 1 else 0);
    let is_two = is_eqeq + is_neq + is_le + is_ge + is_shl + is_shr;

    let t3 = if ch == 43 then 1 else 0;
    let t4 = if ch == 45 then 1 else 0;
    let t5 = if ch == 42 then 1 else 0;
    let t6 = if ch == 47 then 1 else 0;
    let t7 = if ch == 40 then 1 else 0;
    let t8 = if ch == 41 then 1 else 0;
    let t9 = if ch == 59 then 1 else 0;
    let t10 = if ch == 123 then 1 else 0;
    let t11 = if ch == 125 then 1 else 0;
    let t14 = isl * (1 - is_shl);
    let t15 = isg * (1 - is_shr);
    let t24 = if ch == 38 then 1 else 0;
    let t25 = if ch == 124 then 1 else 0;
    let t26 = if ch == 94 then 1 else 0;
    let is_one = t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10 + t11 + t14 + t15 + t24 + t25 + t26;

    let kind = isnum + isid0 * 2 + is_eqeq * 12 + is_neq * 13 + is_le * 16 + is_ge * 17
      + is_shl * 27 + is_shr * 28
      + t3 * 3 + t4 * 4 + t5 * 5 + t6 * 6 + t7 * 7 + t8 * 8 + t9 * 9
      + t10 * 10 + t11 * 11 + t14 * 14 + t15 * 15
      + t24 * 24 + t25 * 25 + t26 * 26;

    // number scan
    let numv = 0;
    let ndone = 0;
    while ndone == 0 {
      let sn = str_len(s);
      let ae = if pos[0] >= sn then 1 else 0;
      let c = if ae == 1 then 32 else char(s, pos[0]);
      let g = if c >= 48 then 1 else 0;
      let l = if c <= 57 then 1 else 0;
      let dgc = g * l;
      let numv = if dgc == 1 then numv * 10 + (c - 48) else numv;
      let _ = pos[0] = pos[0] + dgc;
      let ndone = 1 - dgc;
      0
    };

    // ident scan (hash identical to read_ident)
    let idh = 0;
    let idone = 0;
    while idone == 0 {
      let sn = str_len(s);
      let ae = if pos[0] >= sn then 1 else 0;
      let c = if ae == 1 then 32 else char(s, pos[0]);
      let au = is_alpha(c) + (if c == 95 then 1 else 0);
      let gd = if c >= 48 then 1 else 0;
      let ld = if c <= 57 then 1 else 0;
      let isc = au + gd * ld;
      let idh = if isc == 1 then (idh * 131 + c) else idh;
      let _ = pos[0] = pos[0] + isc;
      let idone = 1 - isc;
      0
    };

    // keywords: an ident whose hash matches a language keyword poisons the
    // whole tokenization so the construct falls back to the legacy parser
    // keyword kinds: if/then/else -> 20/21/22 (fast branch-mode); the rest
    // of the keywords stay poisoned -> clean legacy fallback
    let q1 = if idh == 13857 then 1 else 0;
    let q2 = if idh == 262576641 then 1 else 0;
    let q3 = if idh == 228925745 then 1 else 0;
    let q4 = if idh == 35281108217 then 1 else 0;
    let q5 = if idh == 1866735 then 1 else 0;
    let q6 = if idh == 13472 then 1 else 0;
    let badw = q4 + q5 + q6;
    let _ = st[1] = st[1] * (1 - badw);
    let kindk = kind + isid0 * (q1 * 18 + q2 * 19 + q3 * 20);
    let t23 = if ch == 44 then 1 else 0;

    let idx = st[0];
    let over = if idx >= 512 then 1 else 0;
    let _ = st[1] = st[1] * (1 - over);
    let _ = st[16 + idx] = kindk + t23 * 23;
    let _ = st[528 + idx] = numv + idh;
    let _ = st[0] = idx + 1 - over;

    let hit_semi = t9 * (1 - is_two) * fpC_bit(stops, 1);
    let hit_lbr = t10 * (1 - is_two) * fpC_bit(stops, 2);
    let hit_rbr = t11 * (1 - is_two) * fpC_bit(stops, 4);
    let hit_rpa = t8 * (1 - is_two) * fpC_bit(stops, 8);
    let stophit = hit_semi + hit_lbr + hit_rbr + hit_rpa;

    let adv2 = is_two * 2;
    // num/ident scans already advanced pos themselves; only operator chars
    // need an explicit step here
    let adv1 = (is_one + t23) * (1 - is_two) * (1 - stophit);
    let _ = pos[0] = pos[0] + adv1 + adv2;

    let tot = isnum + isid0 + is_two + is_one;
    let unk = (1 - atend) * (1 - tot);
    let _ = st[1] = st[1] * (1 - unk);

    let eoi = atend;
    let _ = if eoi == 1 then (let _ = st[16 + idx + 1 - over] = 0 in (let _ = st[528 + idx + 1 - over] = 0 in (let _ = st[0] = idx + 2 - over in 0))) else 0;

    let fin = eoi + hit_semi + hit_lbr + hit_rbr + hit_rpa + over + unk;
    0
  };
  st[1]
}


// ---- codegen walkers over tokens ----
// Each returns ok*8 + slot; the result value always lands in the register
// for slot d (fpC_reg(d)). Const tracking: cx[40+s] flag / cx[50+s] value.

// push/pop of an arbitrary register across a bl boundary (callee clobbers
// everything except x19-x28; our accumulator slots live in the clobber set)
fn fpC_pushr(insns: [i64], n: [i64], rs: i64) -> i64 {
  let _ = em(insns, n, 3506455551);
  let _ = em(insns, n, 4177527776 + rs);
  n[0]
}

// Branch-mode if-expression: cond evaluated without boolean materialization,
// both arms targeted at the SAME destination register, two patched branches.
// Token kinds: 20=if 21=then 22=else. Returns ok flag (result lands in slot d).
fn fpC_ifcore(st: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64, fntab: [i64]) -> i64 {
  let _ = fpC_adv(st);
  let cnd = fpC_cond(st, insns, n, stab, cx, d + 1, fntab);
  let cok = cnd / 8;
  let hasc = cx[20] * cok;
  let lsl = cx[21];
  let rsl = cx[22];
  let ccv = cx[23];
  let nsl = cx[24];
  let lreg = fpC_reg(lsl);
  let rreg = fpC_reg(rsl);
  let nreg = fpC_reg(nsl);
  let y12 = if ccv == 12 then 1 else 0;
  let y14 = if ccv == 14 then 1 else 0;
  let y15 = if ccv == 15 then 1 else 0;
  let y16 = if ccv == 16 then 1 else 0;
  let y17 = if ccv == 17 then 1 else 0;
  let xcc = y12 * 1 + y14 * 10 + y15 * 13 + y16 * 12 + y17 * 11;
  let exitcc = hasc * xcc;
  let clc2 = cx[40 + lsl] * hasc;
  let crc2 = cx[40 + rsl] * hasc;
  let crv2 = cx[50 + rsl];
  let crim2 = crc2 * (if crv2 >= 0 then 1 else 0) * (if crv2 < 4096 then 1 else 0);
  let wcpi2 = 4043309056 + crv2 * 1024 + lreg * 32 + 31;
  let cns = cx[40 + nsl] * (1 - hasc);
  let _ = if clc2 == 1 then (let _ = fpC_lit(insns, n, cx[50 + lsl], lreg) in 0) else 0;
  let _ = if crc2 * (1 - crim2) == 1 then (let _ = fpC_lit(insns, n, cx[50 + rsl], rreg) in 0) else 0;
  let _ = if hasc == 1 then (let _ = em(insns, n, 3942645760 + 31 + rreg * 65536 + lreg * 32) in 0) else 0;
  let _ = if hasc * crim2 == 1 then (let _ = em(insns, n, wcpi2) in 0) else 0;
  let _ = if cns == 1 then (let _ = fpC_lit(insns, n, cx[50 + nsl], nreg) in 0) else 0;
  let _ = if cok * (1 - hasc) == 1 then (let _ = em(insns, n, 3942645760 + 31 + 992 + nreg * 32) in 0) else 0;
  let kth = fpC_kd(st);
  let isthen = if kth == 21 then 1 else 0;
  let _ = if cok * isthen == 1 then fpC_adv(st) else 0;
  let go = cok * isthen;
  let _ = if go == 1 then (let _ = em(insns, n, 1409286144 + exitcc) in 0) else 0;
  let p_else = n[0] - 1;
  let ra = if go == 1 then fpC_expr(st, insns, n, stab, cx, d, fntab) else 0;
  let aok = ra / 8;
  let rd0 = fpC_reg(d);
  let acst = cx[40 + d] * go * aok;
  let _ = if acst == 1 then (let _ = fpC_lit(insns, n, cx[50 + d], rd0) in 0) else 0;
  let _ = if go * aok == 1 then (let _ = em(insns, n, 335544320) in 0) else 0;
  let p_end = n[0] - 1;
  let _ = if go * aok == 1 then (let _ = insns[p_else] = 1409286144 + exitcc + (n[0] - p_else) * 32 in 0) else 0;
  let kel = fpC_kd(st);
  let iselse = if kel == 22 then 1 else 0;
  let _ = if go * aok * iselse == 1 then fpC_adv(st) else 0;
  let rb = if go * aok * iselse == 1 then fpC_expr(st, insns, n, stab, cx, d, fntab) else 0;
  let bok = rb / 8 * iselse;
  let bcst = cx[40 + d] * go * aok * bok;
  let _ = if bcst == 1 then (let _ = fpC_lit(insns, n, cx[50 + d], rd0) in 0) else 0;
  let _ = if go * aok * bok == 1 then (let _ = insns[p_end] = 335544320 + (n[0] - p_end) in 0) else 0;
  let _ = cx[25] = go * aok * bok;
  go * aok * bok
}

fn fpC_factor(st: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64, fntab: [i64]) -> i64 {
  let k = fpC_kd(st);
  let isnum = if k == 1 then 1 else 0;
  let isidn = if k == 2 then 1 else 0;
  let islpar = if k == 7 then 1 else 0;
  let isneg = if k == 4 then 1 else 0;
  let rd = fpC_reg(d);
  let capok = if rd >= 0 then 1 else 0;
  let parcap = if d <= 4 then 1 else 0;

  // numeric literal -> const known, value rides in cx cells until a consumer
  // materializes it (lazy folding: fully-constant subtrees emit ZERO words)
  let nv = fpC_vl(st);
  let _ = if isnum * capok == 1 then fpC_adv(st) else 0;
  let num_ok = isnum * capok;

  // identifier -> reg copy; or a resolved bl call when followed by '('
  let nid_next = st[16 + st[1040] + 1];
  let call_ahead = isidn * (if nid_next == 7 then 1 else 0);
  let iv = fpC_vl(st);
  let ireg = sym_lookup(stab, iv);
  let ge19 = if ireg >= 19 then 1 else 0;
  let le28 = if ireg <= 28 then 1 else 0;
  let id_ok = isidn * ge19 * le28 * (1 - call_ahead) * capok;
  let _ = if id_ok == 1 then (let _ = fpC_movrr(insns, n, ireg, rd) in 0) else 0;
  let _ = if id_ok == 1 then fpC_adv(st) else 0;

  // ---- fast bl call: args evaluated into ABI regs x0..x7 ----
  let cttag = ft_ctor_tag(fntab, iv);
  let tf = fntab_lookup(fntab, iv);
  let iss = if iv == cx[26] then 1 else 0;
  let tgt = iss * cx[27] + (1 - iss) * tf;
  let tgtok = if tgt >= 0 then 1 else 0;
  let isct = if cttag >= 0 then 1 else 0;
  let ccap = if d <= 4 then 1 else 0;
  let call_go = call_ahead * tgtok * (1 - isct) * ccap * capok;
  let _ = if call_go == 1 then fpC_adv(st) else 0;
  // spill live ancestor accumulators (slots 0..d-1) up front: arg evaluation
  // may freely use every caller-saved register afterwards
  let sp_i = 0;
  while sp_i < d {
    let rs = fpC_reg(sp_i);
    let _ = if call_go == 1 then (let _ = fpC_pushr(insns, n, rs) in 0) else 0;
    let sp_i = sp_i + 1;
    0
  };
  let _ = if call_go == 1 then fpC_adv(st) else 0;
  let kd0 = fpC_kd(st);
  let isr0 = if kd0 == 8 then 1 else 0;
  let anargs = 0;
  let acont = call_go * (1 - isr0);
  while acont == 1 {
    // first two args evaluate directly in their ABI registers (x0, x1):
    // every live caller value is already spilled across the call
    let adirect = if anargs < 2 then 1 else 0;
    let aslot = anargs * adirect + (d + 1) * (1 - adirect);
    let ar = fpC_val(st, insns, n, stab, cx, aslot, fntab);
    let aok2 = ar / 8;
    let scr = fpC_reg(aslot);
    let acst = cx[40 + aslot];
    let _ = if acont * aok2 * acst == 1 then (let _ = fpC_lit(insns, n, cx[50 + aslot], scr) in 0) else 0;
    let need_mv = adirect * (1 - anargs) * 0 + (1 - adirect) + adirect * anargs;
    let _ = if acont * aok2 * need_mv == 1 then (let _ = fpC_movrr(insns, n, scr, anargs) in 0) else 0;
    let kdc = fpC_kd(st);
    let iscma = if kdc == 23 then 1 else 0;
    let _ = if acont * aok2 * iscma == 1 then fpC_adv(st) else 0;
    let anargs = anargs + aok2;
    let alim = if anargs < 8 then 1 else 0;
    let acont = acont * aok2 * iscma * alim;
    0
  };
  let kd8 = fpC_kd(st);
  let isrparen = if kd8 == 8 then 1 else 0;
  let _ = if call_go * isrparen == 1 then fpC_adv(st) else 0;
  let _ = if call_go * isrparen == 1 then emit_bl(insns, n, tgt) else 0;
  let dis0 = if d > 0 then 1 else 0;
  let _ = if call_go * isrparen * dis0 == 1 then (let _ = fpC_movrr(insns, n, 0, rd) in 0) else 0;
  let us_i = d - 1;
  while us_i >= 0 {
    let rr = fpC_reg(us_i);
    let _ = if call_go * isrparen == 1 then (let _ = pop(insns, n, rr) in 0) else 0;
    let us_i = us_i - 1;
    0
  };
  let call_ok = call_go * isrparen;

  // ---- branch-mode if-expression ----
  let isifk = if k == 20 then 1 else 0;
  let ifcap = if d <= 3 then 1 else 0;
  let _ = cx[25] = 0;
  let _ = if isifk * capok * ifcap == 1 then fpC_ifcore(st, insns, n, stab, cx, d, fntab) else 0;
  let ifok = cx[25];

  // parenthesized subexpression
  let _ = if islpar * capok * parcap == 1 then fpC_adv(st) else 0;
  let inner = if islpar * capok * parcap == 1 then fpC_expr(st, insns, n, stab, cx, d + 1, fntab) else 0;
  let iok = inner / 8;
  let closek = fpC_kd(st);
  let closed = if closek == 8 then 1 else 0;
  let _ = if islpar * capok * parcap * iok * closed == 1 then fpC_adv(st) else 0;
  let par_ok = islpar * capok * parcap * iok * closed;
  let isrc = fpC_reg(d + 1);
  // pure-constant inner expression: value rides in cx cells, no reg move
  let pin = cx[40 + d + 1];
  let _ = if par_ok * (1 - pin) == 1 then (let _ = fpC_movrr(insns, n, isrc, rd) in 0) else 0;

  // unary minus
  let _ = if isneg * capok == 1 then fpC_adv(st) else 0;
  let sub = if isneg * capok == 1 then fpC_factor(st, insns, n, stab, cx, d, fntab) else 0;
  let sok = sub / 8;
  let neg_ok = isneg * capok * sok;
  let sreg = fpC_reg(d);
  let opconst = cx[40 + d];
  let _ = if neg_ok * (1 - opconst) == 1 then (let _ = em(insns, n, 3405774848 + sreg * 65536 + 992 + sreg) in 0) else 0;

  // combine const flags/values (cases are mutually exclusive)
  let pf = cx[40 + d + 1];
  let pv = cx[50 + d + 1];
  let nf = cx[40 + d];
  let nv2 = cx[50 + d];
  let fflag = num_ok + id_ok * 0 + par_ok * pin * 0 + par_ok * pf + neg_ok * nf + call_ok * 0 + ifok * 0;
  let fval = num_ok * nv + par_ok * pv - neg_ok * nv2 * nf;
  let _ = cx[40 + d] = fflag;
  let _ = cx[50 + d] = fval;
  (num_ok + id_ok + par_ok + neg_ok + call_ok + ifok) * 8 + d
}

// Bit-level tier: & | ^ << >> (kinds 24..28), binding tighter than mul.
fn fpC_bitlvl(st: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64, fntab: [i64]) -> i64 {
  let left = fpC_factor(st, insns, n, stab, cx, d, fntab);
  let lok = left / 8;
  let cont = lok;
  while cont == 1 {
    let k = fpC_kd(st);
    let isand = if k == 24 then 1 else 0;
    let isorr = if k == 25 then 1 else 0;
    let iseor = if k == 26 then 1 else 0;
    let isshl = if k == 27 then 1 else 0;
    let isshr = if k == 28 then 1 else 0;
    let isop = isand + isorr + iseor + isshl + isshr;
    let opid = isand * 6 + isorr * 7 + iseor * 8 + isshl * 9 + isshr * 10;
    let _ = if cont * isop == 1 then fpC_adv(st) else 0;
    let right = if cont * isop == 1 then fpC_bitlvl(st, insns, n, stab, cx, d + 1, fntab) else 0;
    let rok = right / 8;
    let lreg = fpC_reg(d);
    let rreg = fpC_reg(d + 1);
    // bit ops never constant-fold (shift semantics on negatives differ
    // between arbitrary-precision and two's-complement views); both sides
    // must be materialized into registers first
    let blc = cx[40 + d];
    let brc = cx[40 + d + 1];
    let _ = if cont * isop * rok * blc == 1 then (let _ = fpC_lit(insns, n, cx[50 + d], lreg) in 0) else 0;
    let _ = if cont * isop * rok * brc == 1 then (let _ = fpC_lit(insns, n, cx[50 + d + 1], rreg) in 0) else 0;
    let _ = if cont * isop * rok == 1 then (let _ = cx[40 + d] = 0 in 0) else 0;
    let _ = if cont * isop * rok == 1 then (let _ = fpC_binop(insns, n, opid, lreg, rreg, lreg) in 0) else 0;
    let cont = cont * isop * rok;
    0
  };
  lok * 8 + d
}

fn fpC_term(st: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64, fntab: [i64]) -> i64 {
  let left = fpC_bitlvl(st, insns, n, stab, cx, d, fntab);
  let lok = left / 8;
  let cont = lok;
  while cont == 1 {
    let k = fpC_kd(st);
    let ismul = if k == 5 then 1 else 0;
    let isdiv = if k == 6 then 1 else 0;
    let isop = ismul + isdiv;
    let op = ismul * 4 + isdiv * 5;
    let _ = if cont * isop == 1 then fpC_adv(st) else 0;
    let right = if cont * isop == 1 then fpC_bitlvl(st, insns, n, stab, cx, d + 1, fntab) else 0;
    let rok = right / 8;
    let lreg = fpC_reg(d);
    let rreg = fpC_reg(d + 1);
    let lc = cx[40 + d];
    let rc2 = cx[40 + d + 1];
    let lv2 = cx[50 + d];
    let rv2 = cx[50 + d + 1];
    let bothc = lc * rc2;
    let magl = if lv2 < 0 then 0 - lv2 else lv2;
    let magr = if rv2 < 0 then 0 - rv2 else rv2;
    let mokl = if magl < 2147483648 then 1 else 0;
    let mokr = if magr < 2147483648 then 1 else 0;
    let divz = isdiv * (if rv2 == 0 then 1 else 0);
    let foldable = bothc * (1 - divz) * mokl * mokr;
    let fadd = lv2 + rv2;
    let fsub = lv2 - rv2;
    let fmul = lv2 * rv2;
    let fdiv = if rv2 == 0 then 0 else lv2 / rv2;
    let fv1 = if op == 4 then fmul else 0;
    let fv2 = if op == 5 then fdiv else fv1;
    let fv3 = if op == 2 then fadd else fv2;
    let fv = if op == 3 then fsub else fv3;
    let _ = if cont * isop * rok * foldable == 1 then (let _ = cx[50 + d] = fv in 0) else 0;
    let _ = if cont * isop * rok * (1 - foldable) * rc2 == 1 then (let _ = fpC_lit(insns, n, rv2, rreg) in 0) else 0;
    let _ = if cont * isop * rok * (1 - foldable) * lc == 1 then (let _ = fpC_lit(insns, n, lv2, lreg) in 0) else 0;
    let _ = if cont * isop * rok * (1 - foldable) == 1 then (let _ = fpC_binop(insns, n, op, lreg, rreg, lreg) in 0) else 0;
    let _ = if cont * isop * rok * (1 - foldable) == 1 then (let _ = cx[40 + d] = 0 in 0) else 0;
    let cont = cont * isop * rok;
    0
  };
  lok * 8 + d
}

fn fpC_expr(st: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64, fntab: [i64]) -> i64 {
  let left = fpC_term(st, insns, n, stab, cx, d, fntab);
  let lok = left / 8;
  let cont = lok;
  while cont == 1 {
    let k = fpC_kd(st);
    let isp = if k == 3 then 1 else 0;
    let ism = if k == 4 then 1 else 0;
    let isop = isp + ism;
    let op = isp * 2 + ism * 3;
    let _ = if cont * isop == 1 then fpC_adv(st) else 0;
    let right = if cont * isop == 1 then fpC_term(st, insns, n, stab, cx, d + 1, fntab) else 0;
    let rok = right / 8;
    let lreg = fpC_reg(d);
    let rreg = fpC_reg(d + 1);
    let lc = cx[40 + d];
    let rc2 = cx[40 + d + 1];
    let lv2 = cx[50 + d];
    let rv2 = cx[50 + d + 1];
    let foldable = lc * rc2;
    let magl = if lv2 < 0 then 0 - lv2 else lv2;
    let magr = if rv2 < 0 then 0 - rv2 else rv2;
    let mokl = if magl < 2147483648 then 1 else 0;
    let mokr = if magr < 2147483648 then 1 else 0;
    let foldok = foldable * mokl * mokr;
    let fva = if op == 2 then lv2 + rv2 else 0;
    let fv = if op == 3 then lv2 - rv2 else fva;
    let _ = if cont * isop * rok * foldok == 1 then (let _ = cx[50 + d] = fv in 0) else 0;
    let rim = rc2 * (if rv2 >= 0 then 1 else 0) * (if rv2 < 4096 then 1 else 0);
    let wai = 2432696320 + rv2 * 1024 + lreg * 32 + lreg;
    let wsi = 3506438144 + rv2 * 1024 + lreg * 32 + lreg;
    let wi = isp * wai + ism * wsi;
    let _ = if cont * isop * rok * (1 - foldok) * (1 - rim) * rc2 == 1 then (let _ = fpC_lit(insns, n, rv2, rreg) in 0) else 0;
    let _ = if cont * isop * rok * (1 - foldok) * lc == 1 then (let _ = fpC_lit(insns, n, lv2, lreg) in 0) else 0;
    let _ = if cont * isop * rok * (1 - foldok) * rim == 1 then (let _ = em(insns, n, wi) in 0) else 0;
    let _ = if cont * isop * rok * (1 - foldok) * (1 - rim) == 1 then (let _ = fpC_binop(insns, n, op, lreg, rreg, lreg) in 0) else 0;
    let _ = if cont * isop * rok * (1 - foldok) == 1 then (let _ = cx[40 + d] = 0 in 0) else 0;
    let cont = cont * isop * rok;
    0
  };
  lok * 8 + d
}

// Full value expression: comparisons materialize as booleans (cmp+csinc).
fn fpC_val(st: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64, fntab: [i64]) -> i64 {
  let e = fpC_expr(st, insns, n, stab, cx, d, fntab);
  let eok = e / 8;
  let k = fpC_kd(st);
  let c12 = if k == 12 then 1 else 0;
  let c13 = if k == 13 then 1 else 0;
  let c14 = if k == 14 then 1 else 0;
  let c15 = if k == 15 then 1 else 0;
  let c16 = if k == 16 then 1 else 0;
  let c17 = if k == 17 then 1 else 0;
  let iscmp = c12 + c13 + c14 + c15 + c16 + c17;
  let cc = c12 * 12 + c13 * 13 + c14 * 14 + c15 * 15 + c16 * 16 + c17 * 17;
  let _ = if eok * iscmp == 1 then fpC_adv(st) else 0;
  let rhs = if eok * iscmp == 1 then fpC_expr(st, insns, n, stab, cx, d + 1, fntab) else 0;
  let rok = rhs / 8;
  let rn = fpC_reg(d);
  let rm = fpC_reg(d + 1);
  let clc = cx[40 + d];
  let crc = cx[40 + d + 1];
  let crv = cx[50 + d + 1];
  let crim = crc * (if crv >= 0 then 1 else 0) * (if crv < 4096 then 1 else 0);
  let wcpi = 4043309056 + crv * 1024 + rn * 32 + 31;
  let _ = if eok * iscmp * rok * (1 - crim) == 1 then (let _ = fpC_lit(insns, n, crv, rm) in 0) else 0;
  let _ = if eok * iscmp * rok * clc == 1 then (let _ = fpC_lit(insns, n, cx[50 + d], rn) in 0) else 0;
  let _ = if eok * iscmp * rok * crim == 1 then (let _ = em(insns, n, wcpi) in 0) else 0;
  let _ = if eok * iscmp * rok * (1 - crim) == 1 then (let _ = em(insns, n, 3942645760 + 31 + rm * 65536 + rn * 32) in 0) else 0;
  let fcc = c12 * 1 + c13 * 0 + c14 * 10 + c15 * 13 + c16 * 12 + c17 * 11;
  let _ = if eok * iscmp * rok == 1 then (let _ = em(insns, n, 2594113504 + fcc * 4096 + rn) in 0) else 0;
  // constant-fold comparison when both sides known
  let lc = cx[40 + d];
  let rc2 = cx[40 + d + 1];
  let lv2 = cx[50 + d];
  let rv2 = cx[50 + d + 1];
  let eqb = if lv2 == rv2 then 1 else 0;
  let ltb = if lv2 < rv2 then 1 else 0;
  let gtb = if lv2 > rv2 then 1 else 0;
  let boolv = c12 * eqb + c13 * (1 - eqb) + c14 * ltb + c15 * gtb + c16 * (1 - gtb) + c17 * (1 - ltb);
  let foldable = lc * rc2;
  let _ = if eok * iscmp * rok * foldable == 1 then (let _ = fpC_lit(insns, n, boolv, rn) in 0) else 0;
  let _ = if eok * iscmp * rok == 1 then (let _ = cx[40 + d] = foldable in 0) else 0;
  let _ = if eok * iscmp * rok * foldable == 1 then (let _ = cx[50 + d] = boolv in 0) else 0;
  (eok * (iscmp * rok + (1 - iscmp))) * 8 + d
}

// Condition expression for branch-mode: no boolean materialization; relays
// compare info via cells cx[20..24] (written at THIS fn top level).
fn fpC_cond(st: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], d: i64, fntab: [i64]) -> i64 {
  let e = fpC_expr(st, insns, n, stab, cx, d, fntab);
  let eok = e / 8;
  let k = fpC_kd(st);
  let c12 = if k == 12 then 1 else 0;
  let c13 = if k == 13 then 1 else 0;
  let c14 = if k == 14 then 1 else 0;
  let c15 = if k == 15 then 1 else 0;
  let c16 = if k == 16 then 1 else 0;
  let c17 = if k == 17 then 1 else 0;
  let iscmp = c12 + c13 + c14 + c15 + c16 + c17;
  let cc = c12 * 12 + c13 * 13 + c14 * 14 + c15 * 15 + c16 * 16 + c17 * 17;
  let _ = if eok * iscmp == 1 then fpC_adv(st) else 0;
  let rhs = if eok * iscmp == 1 then fpC_expr(st, insns, n, stab, cx, d + 1, fntab) else 0;
  let rok = rhs / 8;
  let hasc = eok * iscmp * rok;
  let _ = cx[20] = hasc;
  let _ = cx[21] = d;
  let _ = cx[22] = d + 1;
  let _ = cx[23] = cc;
  let _ = cx[24] = d;
  hasc * 8 + d
}

// mode 1 = value (stops semi/rbrace), mode 2 = condition (stop lbrace).
// On failure restores pos and n so the legacy emitter re-parses cleanly.
fn emit_fast_v2(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], cx: [i64], st: [i64], mode: i64, fntab: [i64]) -> i64 {
  let psave = pos[0];
  let nsave = n[0];
  let stops = if mode == 2 then 2 else 5;
  let tok = fp_tk(s, pos, stops, st);
  let _ = st[1040] = 0;
  let isc = if mode == 2 then 1 else 0;
  let resc = if tok * isc == 1 then fpC_cond(st, insns, n, stab, cx, 0, fntab) else 0;
  let resv = if tok * (1 - isc) == 1 then fpC_val(st, insns, n, stab, cx, 0, fntab) else 0;
  let res = resc + resv;
  let rok = res / 8;
  let curk = fpC_kd(st);
  let t9 = if curk == 9 then 1 else 0;
  let t10 = if curk == 10 then 1 else 0;
  let t11 = if curk == 11 then 1 else 0;
  let term_ok = (2 - mode) * (t9 + t11) + (mode - 1) * t10;
  let good = tok * rok * term_ok;
  // fully-folded constant expression: no word was emitted; materialize --
  // unless the enclosing context discards values (while-body void slot)
  let em0 = if n[0] == nsave then 1 else 0;
  let _ = if good * (1 - isc) * em0 * cx[40] * (1 - cx[28]) == 1 then (let _ = fpC_lit(insns, n, cx[50], 0) in 0) else 0;
  let bad = 1 - good;
  let _ = if bad == 1 then (let _ = pos[0] = psave in 0) else 0;
  let _ = if bad == 1 then (let _ = n[0] = nsave in 0) else 0;
  good
}
