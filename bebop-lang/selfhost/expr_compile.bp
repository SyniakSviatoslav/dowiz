  let _ = em(insns, n, 2853962720);
  let _ = push(insns, n);
  n[0]
}

// sys_clone(flags, stack_top): raw clone. x0=flags, x1=stack_top, x2..x5=0.
// Returns child tid in the parent, 0 in the child. The child continues at
// the same instruction stream with the caller's registers (VM shared), so
// the worker must branch on r==0 and finish with sys_exit_thread.
// Register table: x0=flags (arg0), x1=stack_top (arg1), x2..x5=xzr, x8=220.
fn emit_sys_clone(s: str, pos: [i64], insns: [i64], n: [i64], stab: [i64], selfname: i64, selfstart: i64, fntab: [i64]) -> i64 {
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = emit_cmp(s, pos, insns, n, stab, selfname, selfstart, fntab);
  let _ = skip_ws(s, pos);
  let _ = pos[0] = pos[0] + 1;
  let _ = pop(insns, n, 1);
  let _ = pop(insns, n, 0);
  let _ = em(insns, n, 2854159330);
  let _ = em(insns, n, 2854159331);
  let _ = em(insns, n, 2854159332);
  let _ = em(insns, n, 2854159333);
  let _ = em(insns, n, 2457660449);
  let _ = em(insns, n, 3531611016);
  let _ = em(insns, n, 3556769793);
  let _ = em(insns, n, 3036676256);
  let _ = em(insns, n, 2432959471);
  let _ = em(insns, n, 2433483758);
  let _ = em(insns, n, 2437940219);
  let _ = em(insns, n, 2438988796);
  let _ = push(insns, n);
  n[0]
}

// sys_cond_set(cond, arr, idx, val): *arr[idx] = val iff cond != 0.
// Real cbz inside: both threads may execute it, only the guard-matching
// one writes — no branchless speculation, no lost updates on shared cells.
// Register table: x0=cond (arg0), x1=arr (arg1), x2=idx (arg2),
// x3=val (arg3); cbz x0,+3; add x1,x1,x2<<3; str x3,[x1]; mov x0,xzr.
