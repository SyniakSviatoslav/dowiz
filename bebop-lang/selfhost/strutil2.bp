// selfhost/strutil2.bp — string substring, compare, reverse.
// Built on str_len / char loops, chr(), and ++ concatenation.

module core { }

// substr: extract s[start .. start+n) as a new string, clamping to [0, len).
// Out-of-range indices (negative or past the end) contribute nothing, so the
// result is the overlap of [start, start+n) with the string. n <= 0 -> "".
fn substr(s: str, start: i64, n: i64) -> str {
  let len = str_len(s);
  let out = "";
  let i = 0;
  while i < n {
    let idx = start + i;
    let inrange = if idx >= 0 then 1 else 0;
    let inrange = if idx < len then inrange else 0;
    let c = if inrange == 1 then char(s, idx) else 0;
    let out = if inrange == 1 then (out ++ chr(c)) else out;
    let i = i + 1;
    0
  };
  out
}

// str_compare: lexicographic compare of a and b — 0 if equal, -1 if a < b,
// 1 if a > b. Compares char-by-char; the shorter string compares less when one
// is a prefix of the other.
fn str_compare(a: str, b: str) -> i64 {
  let na = str_len(a);
  let nb = str_len(b);
  let i = 0;
  let result = 0;
  let done = 0;
  while done == 0 {
    let ea = if i >= na then 1 else 0;
    let eb = if i >= nb then 1 else 0;
    let ca = if ea == 1 then 0 else char(a, i);
    let cb = if eb == 1 then 0 else char(b, i);
    let less = if ca < cb then 1 else 0;
    let more = if ca > cb then 1 else 0;
    let result = if less == 1 then (0 - 1) else (if more == 1 then 1 else result);
    let i = i + 1;
    let done = if (less + more + ea + eb) > 0 then 1 else 0;
    0
  };
  if result == 0 then (if na > nb then 1 else (if na < nb then (0 - 1) else 0)) else result
}

// str_reverse: return the reversed string (single-pass accumulator).
fn str_reverse(s: str) -> str {
  let n = str_len(s);
  let out = "";
  let i = 0;
  while i < n {
    let c = char(s, n - 1 - i);
    let out = out ++ chr(c);
    let i = i + 1;
    0
  };
  out
}
