// selfhost/prelude/gb.bp -- B3 step 1 (docs/blueprints/B3-graphblas-kernels-prejit.md section
// 3): GraphBLAS objects over the store. Library only (no main), `use`d by every driver that
// needs it -- and because a nested `use` inside an included file is NOT followed (T47b,
// bebop.bp:5069), every direct user of this file must ALSO directly `use` sha256.bp and
// store.bp itself (same flat pattern as selfhost/std/sgraph2.bp's own two `use` lines).
//
// Objects (store cells, all `ref` fields object-relative via st_ref/st_link, store.bp:197-198):
//   GbMatrix {n, m, nnz, fmt, ref rp, ref ci, ref vv, ref mask, gen, ref prev}  -- 10 fields,
//     0 n  1 m  2 nnz  3 fmt (1 CSR, 2 bitmap, 3 iso-CSR/no vv, 4 hypersparse)
//     4 ref rp  5 ref ci  6 ref vv (0 = none, iso)  7 ref mask (0 = none)  8 gen  9 ref prev
//   B4 (row-block CoW, RESEARCH-GRAPHBLAS-2026-09-06.md section 2.2) appends `ref blocktab`
//   as field 10 (a NEW digest/layout version) -- fields 0..9 never move, so no relayout of
//   any object sealed under today's digest; `prev` (field 9) is already the version-chain
//   slot section 2.2 wants, so B4 only needs the one new tail field.
//   GbVector {n, nnz, fmt, ref idx, ref val}  -- 5 fields: fmt 1 dense (val only), 2 sparse
//     (idx sorted + val), 3 bitmap (idx = the bitmap words, val unused/0).
// RP/CI/VV/bitmap/dense-val objects all use the store's existing "arr i64" convention
// (sgraph2.bp RP/CI/LOG/TB, csr.bp): field 0 = element count, fields 1.. = the values;
// arr_get/arr_put below are that convention's accessors, used everywhere in this file.
//
// Formats implemented: CSR (fmt 1, the only one built here), the bitmap/iso ideas are
// carried by GbVector fmt 3 and by omitting vv (ref 0) -- hypersparse (fmt 4) is out of
// scope for step 1 (no test graph here needs it: LAGraph-prep graphs are all dense-degree).
// Masks: a GbVector fmt 3 bitmap, tested with gb_vec_test(base, V, i, complement) --
// complement is a plain XOR of the bit, matching the blueprint's "AND the bitmap word in
// the loop" note (section 3, "descriptor").
//
// Semirings (id: oplus, otimes; RESEARCH-GRAPHBLAS-2026-09-06.md section 1.1): 1 or-and,
// 2 any-pair, 3 plus-times (schoolbook Q32 fp_mul -- `umulh` is the A9 builtin that
// replaces the division-by-2^32 below once it lands), 4 min-plus. gb_mxv_generic is the
// tier-0 kernel: one function, sr as a runtime parameter, branch inside the loop.
//
// The three graphs gb_build_* produce match bench/oracles/lag_common.py's ring_chords(),
// random_lcg(seed=42) and grid10x10() bit-for-bit; self-loops and duplicate (u,v) pairs are
// dropped the same way _adj() does (a python `set`) via a dedupe bitmap of n*n bits, and the
// final CSR row order matches python's `sorted(s)` because the dedupe bitmap is drained by
// ascending key = u*n+v.
// CORRECTION (2026-09-07, B3 step 2 review): `%` is bebop's LANGUAGE-DEFINED signed remainder
// (sdiv+msub, C-style truncation toward zero -- tools/bpref.py mirrors this with `a-(a/b)*b`;
// objdump-verified 0x9AC00C00 = SDIV, not UDIV). The PRIOR version of this comment claimed `%`
// was unsigned remainder matching python's `x % n` on the 2**64-masked word -- that was never
// true and gb_gen_random_lcg below SIGSEGV'd at n=1000 (negative `u*n+v` dedupe-bitmap index)
// the first time anyone actually called it (never exercised before B3 step 2). gb_umod(x, n, K)
// below corrects a signed `%` result to the unsigned residue python computes (K = 2**64 mod n,
// gb_mod64_k(n)); ring_chords()/grid10x10() never needed it since their `%` operands are always
// small nonnegative sums.

use "selfhost/prelude/sha256.bp"
use "selfhost/prelude/store.bp"

// ---- "arr i64" accessors (field 0 = count, fields 1.. = values) ----
fn arr_get(base: [i64], o: i64, i: i64) -> i64 { st_get(base, o, 1 + i) }
fn arr_put(base: [i64], o: i64, i: i64, v: i64) -> i64 { st_put(base, o, 1 + i, v) }
fn arr_n(base: [i64], o: i64) -> i64 { st_get(base, o, 0) }
fn arr_alloc(base: [i64], tx: [i64], dg: i64, nvals: i64) -> i64 {
  let o = st_alloc(base, tx, nvals + 1, dg);
  let _ = st_put(base, o, 0, nvals);
  o
}
// arr_sum(base, o, n): sum of the first n values of an "arr i64" object (rp/ci/vv digest,
// caller passes its own n -- an arr object never lies about its own count via arr_n, but a
// slice sum needs a caller-chosen bound, e.g. rp has n+1 live cells for an n-row matrix).
fn arr_sum(base: [i64], o: i64, n: i64) -> i64 {
  let i = 0;
  let acc = 0;
  while i < n {
    let acc = acc + arr_get(base, o, i);
    let i = i + 1;
    0
  };
  acc
}

// ---- bitmaps (plain [i64] cell buffers, 64 bits/cell; also used inside a GbVector) ----
fn gb_bit(bm: [i64], i: i64) -> i64 { (bm[i >> 6] >> (i & 63)) & 1 }
fn gb_setbit(bm: [i64], i: i64) -> i64 {
  let _ = bm[i >> 6] = bm[i >> 6] | (1 << (i & 63));
  0
}

// gb_digests(dg): fills dg[0..4) with the layout digests used by every builder below --
// dg[0] GbRP, dg[1] GbCI, dg[2] GbVV, dg[3] GbMatrix. Call once per store/tx.
fn gb_digests(dg: [i64]) -> i64 {
  let _ = dg[0] = st_digest("GbRP{arr i64}");
  let _ = dg[1] = st_digest("GbCI{arr i64}");
  let _ = dg[2] = st_digest("GbVV{arr i64}");
  let _ = dg[3] = st_digest("GbMatrix{i64,i64,i64,i64,ref GbRP,ref GbCI,ref GbVV,ref GbBM,i64,ref GbMatrix}");
  let _ = dg[4] = st_digest("GbBM{arr i64}");
  let _ = dg[5] = st_digest("GbVector{i64,i64,i64,ref GbBM,ref GbVL}");
  0
}

// gb_csr_fill_w(base, src, dst, val, m, n, rp, ci, vv, cur): counting sort (stable) of m
// directed edges (src[j],dst[j],val[j]) into pre-allocated rp (n+1 vals, zero-fresh),
// ci/vv (m vals each); cur is a caller-owned [n] scratch array (fully overwritten below
// before it is read, so it needs no pre-zeroing). This is sgraph2.bp:24 csr_build plus a
// carried payload (vv), so a transpose or a fresh build can both go through one function.
fn gb_csr_fill_w(base: [i64], src: [i64], dst: [i64], val: [i64], m: i64, n: i64, rp: i64, ci: i64, vv: i64, cur: [i64]) -> i64 {
  let i = 0;
  while i < m {
    let a = src[i];
    let _ = arr_put(base, rp, a + 1, arr_get(base, rp, a + 1) + 1);
    let i = i + 1;
    0
  };
  let v = 0;
  while v < n {
    let _ = arr_put(base, rp, v + 1, arr_get(base, rp, v + 1) + arr_get(base, rp, v));
    let _ = cur[v] = arr_get(base, rp, v);
    let v = v + 1;
    0
  };
  let j = 0;
  while j < m {
    let a = src[j];
    let s = cur[a];
    let _ = arr_put(base, ci, s, dst[j]);
    let _ = arr_put(base, vv, s, val[j]);
    let _ = cur[a] = s + 1;
    let j = j + 1;
    0
  };
  0
}

// gb_matrix_seal: allocate+fill+seal a 10-field GbMatrix header over already-sealed rp/ci/vv.
fn gb_matrix_seal(base: [i64], tx: [i64], tmp: [i64], dgm: i64, n: i64, m: i64, nnz: i64, fmt: i64, rp: i64, ci: i64, vv: i64) -> i64 {
  let mx = st_alloc(base, tx, 10, dgm);
  let _ = st_put(base, mx, 0, n);
  let _ = st_put(base, mx, 1, m);
  let _ = st_put(base, mx, 2, nnz);
  let _ = st_put(base, mx, 3, fmt);
  let _ = st_link(base, mx, 4, rp);
  let _ = st_link(base, mx, 5, ci);
  let _ = st_link(base, mx, 6, vv);
  let _ = st_put(base, mx, 7, 0);
  let _ = st_put(base, mx, 8, 0);
  let _ = st_put(base, mx, 9, 0);
  let _ = st_seal(base, mx, tmp);
  mx
}

// gb_edge_weight(u,v): the SSSP edge weight (bench/oracles/lag_common.py:135-142), symmetric
// (order-independent) so it can be recomputed on either the forward or the transposed CSR.
fn gb_edge_weight(u: i64, v: i64) -> i64 {
  let a = if u < v then u else v;
  let b = if u < v then v else u;
  1 + ((a * 1000003 + b * 7919) % 9)
}

// gb_build_pairs(base, tx, tmp, n, mp, psrc, pdst, cur, bm, dg): build a GbMatrix (fmt 1,
// CSR) from mp raw UNDIRECTED (u,v) pairs (self-loops and duplicates allowed, dropped the
// same way lag_common.py's _adj() does: a set, both directions added). cur: [n] scratch.
// bm: [ (n*n+63)/64 ] scratch bitmap, must be caller-zeroed (allocated fresh with zeros()
// is already zero). dg: gb_digests() output.
// gb_hit_store: the fill loop's per-hit body, gated by the caller (`if hit == 1 then
// gb_hit_store(...) else 0`) -- coordinator finding 2026-09-07: an EARLIER draft wrote
// esrc[idx]/edst[idx]/eval[idx] unconditionally every key2, only advancing idx on a hit.
// That looked harmless (a miss's write to a not-yet-advanced idx is overwritten by the
// next real hit before idx moves) but breaks on the LAST hit: every miss AFTER it still
// writes esrc[idx]=edst[idx]=eval[idx] at idx==cnt, one cell past each zeros(cnt)
// allocation -- esrc's overrun lands in edst[0] (the next arena object), edst's overrun in
// eval[0], silently (no bounds check in the native codegen). bpref.py caught it correctly
// (IndexError on the OOB store); the fix is to only ever touch idx when hit == 1.
fn gb_hit_store(esrc: [i64], edst: [i64], eval: [i64], idx: i64, uu: i64, vv2: i64, w: i64) -> i64 {
  let _ = esrc[idx] = uu;
  let _ = edst[idx] = vv2;
  let _ = eval[idx] = w;
  0
}
fn gb_build_pairs(base: [i64], tx: [i64], tmp: [i64], n: i64, mp: i64, psrc: [i64], pdst: [i64], cur: [i64], bm: [i64], dg: [i64]) -> i64 {
  let k = 0;
  while k < mp {
    let u = psrc[k];
    let v = pdst[k];
    let same = if u == v then 1 else 0;
    let _ = if same == 1 then 0 else gb_setbit(bm, u * n + v);
    let _ = if same == 1 then 0 else gb_setbit(bm, v * n + u);
    let k = k + 1;
    0
  };
  let key = 0;
  let cnt = 0;
  while key < n * n {
    let cnt = cnt + gb_bit(bm, key);
    let key = key + 1;
    0
  };
  let esrc = zeros(cnt);
  let edst = zeros(cnt);
  let eval = zeros(cnt);
  let key2 = 0;
  let idx = 0;
  while key2 < n * n {
    let hit = gb_bit(bm, key2);
    let uu = key2 / n;
    let vv2 = key2 % n;
    let _ = if hit == 1 then gb_hit_store(esrc, edst, eval, idx, uu, vv2, gb_edge_weight(uu, vv2)) else 0;
    let idx = idx + hit;
    let key2 = key2 + 1;
    0
  };
  let rp = arr_alloc(base, tx, dg[0], n + 1);
  let ci = arr_alloc(base, tx, dg[1], cnt);
  let vv = arr_alloc(base, tx, dg[2], cnt);
  let _ = gb_csr_fill_w(base, esrc, edst, eval, cnt, n, rp, ci, vv, cur);
  let _ = st_seal(base, rp, tmp);
  let _ = st_seal(base, ci, tmp);
  let _ = st_seal(base, vv, tmp);
  gb_matrix_seal(base, tx, tmp, dg[3], n, n, cnt, 1, rp, ci, vv)
}

// ---- the 3 lag_common.py graphs (bench/oracles/lag_common.py:38-63) ----
fn gb_gen_ring_chords(psrc: [i64], pdst: [i64]) -> i64 {
  let n = 64;
  let i = 0;
  while i < n {
    let _ = psrc[i] = i;
    let _ = pdst[i] = (i + 1) % n;
    let i = i + 1;
    0
  };
  let j = 0;
  while j < n / 2 {
    let _ = psrc[n + j] = j;
    let _ = pdst[n + j] = (j + n / 2) % n;
    let j = j + 1;
    0
  };
  n + n / 2
}
// gb_gen_ring2 / gb_build_ring2 (B3 step 3 coordinator review, 2026-09-07): a ring with chords
// of length 1 AND 2 -- edges (i,i+1 mod n) and (i,i+2 mod n) -- gives every i a real triangle
// {i,i+1,i+2}, exactly n=64 of them (mirrors bench/oracles/lag_common.py's ring2() bit-for-bit:
// same edge list, same undirected-set dedupe via gb_build_pairs). Unlike gb_build_ring_chords
// (0 triangles) this gives gb_tc a fold with real distinguishing power.
fn gb_gen_ring2(psrc: [i64], pdst: [i64]) -> i64 {
  let n = 64;
  let i = 0;
  while i < n {
    let _ = psrc[i] = i;
    let _ = pdst[i] = (i + 1) % n;
    let i = i + 1;
    0
  };
  let j = 0;
  while j < n {
    let _ = psrc[n + j] = j;
    let _ = pdst[n + j] = (j + 2) % n;
    let j = j + 1;
    0
  };
  n + n
}
fn gb_build_ring2(base: [i64], tx: [i64], tmp: [i64], dg: [i64]) -> i64 {
  let n = 64;
  let mp = 128;
  let psrc = zeros(mp);
  let pdst = zeros(mp);
  let _ = gb_gen_ring2(psrc, pdst);
  let cur = zeros(n);
  let bm = zeros((n * n + 63) / 64);
  gb_build_pairs(base, tx, tmp, n, mp, psrc, pdst, cur, bm, dg)
}
fn gb_lcg(x: i64) -> i64 { x * 6364136223846793005 + 1442695040888963407 }
// gb_mod64_k(n): 2**64 mod n via 64 doublings mod n (no native `%` needed, so this works for
// any n without itself needing the correction it computes).
fn gb_mod64_k(n: i64) -> i64 {
  let k = 1;
  let i = 0;
  while i < 64 {
    let k2 = k * 2;
    let k = if k2 >= n then k2 - n else k2;
    let i = i + 1;
    0
  };
  k
}
// gb_umod(x, n, K): x's 64-bit pattern mod n treating it as UNSIGNED (K = gb_mod64_k(n)).
// `%` is signed (see header correction above): x % n has the sign of x, magnitude < n. When
// x < 0 the true unsigned value is x + 2**64, so the true residue is (x%n + K) corrected back
// into [0, n) -- x%n in (-n, 0], K in [0, n) => (x%n + K) in (-n, n); a further +n if still
// negative lands in (0, n) exactly.
fn gb_umod(x: i64, n: i64, K: i64) -> i64 {
  let base = x % n;
  let adj = if x < 0 then base + K else base;
  if adj < 0 then adj + n else adj
}
fn gb_gen_random_lcg(psrc: [i64], pdst: [i64]) -> i64 {
  let n = 1000;
  let m = 4000;
  let K = gb_mod64_k(n);
  let x = 42;
  let k = 0;
  while k < m {
    let x = gb_lcg(x);
    let u = gb_umod(x, n, K);
    let x = gb_lcg(x);
    let v = gb_umod(x, n, K);
    let _ = psrc[k] = u;
    let _ = pdst[k] = v;
    let k = k + 1;
    0
  };
  m
}
// grid10x10: absent right/down neighbours are padded as a self-loop (i,i) -- gb_build_pairs
// drops self-loops unconditionally, so this needs no conditional write (avoids a
// multi-statement if-branch; AGENTS.md ladder T0 -- keep branches single-expression).
fn gb_gen_grid10x10(psrc: [i64], pdst: [i64]) -> i64 {
  let rows = 10;
  let cols = 10;
  let r = 0;
  let cnt = 0;
  while r < rows {
    let c = 0;
    while c < cols {
      let i = r * cols + c;
      let hasr = if c + 1 < cols then 1 else 0;
      let _ = psrc[cnt] = i;
      let _ = pdst[cnt] = if hasr == 1 then i + 1 else i;
      let cnt = cnt + 1;
      let hasd = if r + 1 < rows then 1 else 0;
      let _ = psrc[cnt] = i;
      let _ = pdst[cnt] = if hasd == 1 then i + cols else i;
      let cnt = cnt + 1;
      let c = c + 1;
      0
    };
    let r = r + 1;
    0
  };
  cnt
}
fn gb_build_ring_chords(base: [i64], tx: [i64], tmp: [i64], dg: [i64]) -> i64 {
  let n = 64;
  let mp = 96;
  let psrc = zeros(mp);
  let pdst = zeros(mp);
  let _ = gb_gen_ring_chords(psrc, pdst);
  let cur = zeros(n);
  let bm = zeros((n * n + 63) / 64);
  gb_build_pairs(base, tx, tmp, n, mp, psrc, pdst, cur, bm, dg)
}
fn gb_build_random_lcg(base: [i64], tx: [i64], tmp: [i64], dg: [i64]) -> i64 {
  let n = 1000;
  let mp = 4000;
  let psrc = zeros(mp);
  let pdst = zeros(mp);
  let _ = gb_gen_random_lcg(psrc, pdst);
  let cur = zeros(n);
  let bm = zeros((n * n + 63) / 64);
  gb_build_pairs(base, tx, tmp, n, mp, psrc, pdst, cur, bm, dg)
}
fn gb_build_grid10x10(base: [i64], tx: [i64], tmp: [i64], dg: [i64]) -> i64 {
  let n = 100;
  let mp = 200;
  let psrc = zeros(mp);
  let pdst = zeros(mp);
  let _ = gb_gen_grid10x10(psrc, pdst);
  let cur = zeros(n);
  let bm = zeros((n * n + 63) / 64);
  gb_build_pairs(base, tx, tmp, n, mp, psrc, pdst, cur, bm, dg)
}

// ---- extract (row) / reduce (row, = degree) / transpose ----
fn gb_row_lo(base: [i64], A: i64, i: i64) -> i64 { arr_get(base, st_ref(base, A, 4), i) }
fn gb_row_hi(base: [i64], A: i64, i: i64) -> i64 { arr_get(base, st_ref(base, A, 4), i + 1) }
fn gb_degree(base: [i64], A: i64, i: i64) -> i64 { gb_row_hi(base, A, i) - gb_row_lo(base, A, i) }
fn gb_col(base: [i64], A: i64, k: i64) -> i64 { arr_get(base, st_ref(base, A, 5), k) }
fn gb_val(base: [i64], A: i64, k: i64) -> i64 { arr_get(base, st_ref(base, A, 6), k) }
// gb_fold_row(base, A, i): sum of column ids in row i (the G9a "extract a row and fold" op).
fn gb_fold_row(base: [i64], A: i64, i: i64) -> i64 {
  let lo = gb_row_lo(base, A, i);
  let hi = gb_row_hi(base, A, i);
  let k = lo;
  let acc = 0;
  while k < hi {
    let acc = acc + gb_col(base, A, k);
    let k = k + 1;
    0
  };
  acc
}
// gb_fold_matrix(base, A): sum of gb_fold_row over every row (works from any mapping/base).
fn gb_fold_matrix(base: [i64], A: i64) -> i64 {
  let n = st_get(base, A, 0);
  let i = 0;
  let acc = 0;
  while i < n {
    let acc = acc + gb_fold_row(base, A, i);
    let i = i + 1;
    0
  };
  acc
}
// gb_transpose(base, tx, tmp, A, dg) = csr_build over (dst, src): a fresh GbMatrix whose
// row i holds every j with A[j,i] != 0 (RESEARCH-GRAPHBLAS-2026-09-06.md section 1.1).
fn gb_transpose(base: [i64], tx: [i64], tmp: [i64], A: i64, dg: [i64]) -> i64 {
  let n = st_get(base, A, 0);
  let nnz = st_get(base, A, 2);
  let esrc = zeros(nnz);
  let edst = zeros(nnz);
  let eval = zeros(nnz);
  let i = 0;
  let idx = 0;
  while i < n {
    let lo = gb_row_lo(base, A, i);
    let hi = gb_row_hi(base, A, i);
    let k = lo;
    while k < hi {
      let _ = esrc[idx] = gb_col(base, A, k);
      let _ = edst[idx] = i;
      let _ = eval[idx] = gb_val(base, A, k);
      let idx = idx + 1;
      let k = k + 1;
      0
    };
    let i = i + 1;
    0
  };
  let cur = zeros(n);
  let rp = arr_alloc(base, tx, dg[0], n + 1);
  let ci = arr_alloc(base, tx, dg[1], nnz);
  let vv = arr_alloc(base, tx, dg[2], nnz);
  let _ = gb_csr_fill_w(base, esrc, edst, eval, nnz, n, rp, ci, vv, cur);
  let _ = st_seal(base, rp, tmp);
  let _ = st_seal(base, ci, tmp);
  let _ = st_seal(base, vv, tmp);
  gb_matrix_seal(base, tx, tmp, dg[3], n, n, nnz, 1, rp, ci, vv)
}

// gb_extract_rows(base, tx, tmp, A, lo, hi, dg) = a csr_scan-style row-range slice [lo,hi)
// of A into a NEW GbMatrix (n' = hi-lo rows, same m columns as A). CSR rows are stored
// contiguously, so rows lo..hi-1's ci/vv are exactly A's own contiguous slice
// [rp[lo], rp[hi]) -- no scratch buffers, no counting sort, just an offset copy.
fn gb_extract_rows(base: [i64], tx: [i64], tmp: [i64], A: i64, lo: i64, hi: i64, dg: [i64]) -> i64 {
  let m = st_get(base, A, 1);
  let n2 = hi - lo;
  let off = gb_row_lo(base, A, lo);
  let nnz2 = gb_row_lo(base, A, hi) - off;
  let rp2 = arr_alloc(base, tx, dg[0], n2 + 1);
  let ci2 = arr_alloc(base, tx, dg[1], nnz2);
  let vv2 = arr_alloc(base, tx, dg[2], nnz2);
  let i = 0;
  while i <= n2 {
    let _ = arr_put(base, rp2, i, gb_row_lo(base, A, lo + i) - off);
    let i = i + 1;
    0
  };
  let k = 0;
  while k < nnz2 {
    let _ = arr_put(base, ci2, k, gb_col(base, A, off + k));
    let _ = arr_put(base, vv2, k, gb_val(base, A, off + k));
    let k = k + 1;
    0
  };
  let _ = st_seal(base, rp2, tmp);
  let _ = st_seal(base, ci2, tmp);
  let _ = st_seal(base, vv2, tmp);
  gb_matrix_seal(base, tx, tmp, dg[3], n2, m, nnz2, 1, rp2, ci2, vv2)
}

// ---- GbVector bitmap (fmt 3) -- mask + complement ----
fn gb_vec_bitmap_alloc(base: [i64], tx: [i64], dgbm: i64, dgvec: i64, n: i64) -> i64 {
  let nw = (n + 63) / 64;
  let bm = arr_alloc(base, tx, dgbm, nw);
  let vec = st_alloc(base, tx, 5, dgvec);
  let _ = st_put(base, vec, 0, n);
  let _ = st_put(base, vec, 1, 0);
  let _ = st_put(base, vec, 2, 3);
  let _ = st_link(base, vec, 3, bm);
  let _ = st_put(base, vec, 4, 0);
  vec
}
fn gb_vec_bit(base: [i64], V: i64, i: i64) -> i64 {
  let bm = st_ref(base, V, 3);
  (arr_get(base, bm, i >> 6) >> (i & 63)) & 1
}
fn gb_vec_setbit(base: [i64], V: i64, i: i64) -> i64 {
  let bm = st_ref(base, V, 3);
  let w = arr_get(base, bm, i >> 6);
  arr_put(base, bm, i >> 6, w | (1 << (i & 63)))
}
// gb_vec_test(base, V, i, complement): the mask descriptor -- C<M> when complement=0,
// C<!M> when complement=1 (a plain XOR of the bit, RESEARCH-GRAPHBLAS section 1.1 "descriptor").
fn gb_vec_test(base: [i64], V: i64, i: i64, complement: i64) -> i64 {
  gb_vec_bit(base, V, i) ^ complement
}
fn gb_vec_seal(base: [i64], V: i64, tmp: [i64]) -> i64 {
  let _ = st_seal(base, st_ref(base, V, 3), tmp);
  st_seal(base, V, tmp)
}

// ---- tier-0 generic mxv (section 3, "Instant start, three tiers", tier 2): one function,
// semiring id as a runtime parameter, branch inside the loop. sr: 1 or-and, 2 any-pair
// (both reduce to "does row i touch a nonzero x[j]" on 0/1 vectors -- any-pair's ⊗ = pair
// ignores the edge value the same way or-and's ⊗ = and does when every edge weight is
// nonzero, which is always true here), 3 plus-times (schoolbook Q32: (x*w)/2^32, `umulh`
// is the A9 builtin that replaces the division), 4 min-plus. x, y: dense [i64] length n
// (fmt-1-CSR-shaped kernels; a real bitmap/GbVector-backed x is a thin wrapper the caller
// can add without touching this loop -- gb_bit/gb_vec_bit already exist for that).
// hasmk/mk/cpl: the mask descriptor (0 mk = no mask; mk is only read when hasmk = 1).
fn gb_mxv_generic(base: [i64], A: i64, sr: i64, x: [i64], y: [i64], n: i64, hasmk: i64, mk: [i64], cpl: i64) -> i64 {
  let big = 1099511627776;
  let i = 0;
  while i < n {
    let mbit = if hasmk == 1 then gb_bit(mk, i) else 1;
    let active = mbit ^ cpl;
    let lo = gb_row_lo(base, A, i);
    let hi = gb_row_hi(base, A, i);
    let isminplus = if sr == 4 then 1 else 0;
    let k = lo;
    let acc = isminplus * big;
    while k < hi {
      let j = gb_col(base, A, k);
      let w = gb_val(base, A, k);
      let xb = if x[j] != 0 then 1 else 0;
      let pt = acc + (x[j] * w) / 4294967296;
      let mp = x[j] + w;
      let acc = if sr == 3 then pt else if sr == 4 then (if mp < acc then mp else acc) else (if acc == 1 then 1 else xb);
      let k = k + 1;
      0
    };
    let _ = if active == 1 then (let _ = y[i] = acc in 0) else 0;
    let i = i + 1;
    0
  };
  0
}

// ==== B3 step 3 (docs/blueprints/B3-graphblas-kernels-prejit.md section 3/5 step 3): tier-0
// mxm/eWiseAdd/eWiseMult/select/apply/reduce, generic over semirings 1-4 plus 7 (plus-pair).
// Semiring 7 plus-pair: oplus = +, otimes = pair (a CONSTANT 1, ignoring both operand values --
// the GraphBLAS PAIR binary op; used by triangle counting via mxm(L,L,plus-pair)). sr 3
// plus-times stays the schoolbook Q32 division gb_mxv_generic already uses (`umulh` is out of
// scope, A-series). gb_sr_mul/gb_sr_add below are the shared oplus/otimes used by BOTH mxm's
// SPA inner loop and eWiseAdd/eWiseMult's merge -- one otimes/oplus definition per semiring,
// text-identical to gb_mxv_generic's own sr==3/sr==4/else arms wherever they overlap.
fn gb_sr_mul(sr: i64, a: i64, b: i64) -> i64 {
  if sr == 3 then (a * b) / 4294967296
  else if sr == 4 then a + b
  else 1
}
fn gb_sr_add(sr: i64, a: i64, b: i64) -> i64 {
  if sr == 4 then (if a < b then a else b)
  else if sr == 1 then 1
  else if sr == 2 then 1
  else a + b
}

// ---- mxm: Gustavson + SPA (dense accumulator, m cells -- one per B-column -- allocated ONCE
// by the caller (gb_mxm) OUTSIDE both row loops, L8). PONYTAIL simplification vs the
// blueprint's literal "touched list": the reset trick still avoids ever zeroing the dense
// arrays (a monotonic per-row stamp `s`, `rs` the running counter cristallized cell) but the
// row's output columns are recovered by a dense scan of `stamp` in gb_mxm_write_row rather
// than a touched-list + sort -- at this tier's scale (n <= 1000, gb_mxm's own callers) an m-cell
// scan per row costs the same order as the double-loop accumulate itself and comes with CSR's
// required ascending column order for free, no sort routine to get subtly wrong. Ceiling: a
// 1M-row mxm would want the touched list back (avoid the O(n*m) write-side scan) -- step 4's
// specialised/pooled kernels are the place for that, not this tier-0 fallback.
fn gb_mxm_row(base: [i64], A: i64, B: i64, sr: i64, i: i64, stamp: [i64], acc: [i64], rs: [i64], cnt: [i64]) -> i64 {
  let s = rs[0] + 1;
  let _ = rs[0] = s;
  let _ = cnt[0] = 0;
  let lo = gb_row_lo(base, A, i);
  let hi = gb_row_hi(base, A, i);
  let k = lo;
  while k < hi {
    let kk = gb_col(base, A, k);
    let wa = gb_val(base, A, k);
    let lo2 = gb_row_lo(base, B, kk);
    let hi2 = gb_row_hi(base, B, kk);
    let p = lo2;
    while p < hi2 {
      let jj = gb_col(base, B, p);
      let wb = gb_val(base, B, p);
      let contrib = gb_sr_mul(sr, wa, wb);
      let first = if stamp[jj] != s then 1 else 0;
      let _ = if first == 1 then (let _ = stamp[jj] = s in 0) else 0;
      let _ = if first == 1 then (let _ = acc[jj] = contrib in 0) else 0;
      let _ = if first == 0 then (let _ = acc[jj] = gb_sr_add(sr, acc[jj], contrib) in 0) else 0;
      let _ = cnt[0] = cnt[0] + first;
      let p = p + 1;
      0
    };
    let k = k + 1;
    0
  };
  cnt[0]
}
// gb_mxm_write_row: dense ascending scan of stamp[0..m) for the columns this row's SPA pass
// touched (stamp[j] == s), writing ci/vv from offset `off` (= rp[i]) upward via the running
// cursor `p` (caller-owned [1] cell, reset by the caller before this call).
fn gb_mxm_write_row(base: [i64], ci: i64, vv: i64, m: i64, s: i64, stamp: [i64], acc: [i64], p: [i64]) -> i64 {
  let j = 0;
  while j < m {
    let hit = if stamp[j] == s then 1 else 0;
    let _ = if hit == 1 then arr_put(base, ci, p[0], j) else 0;
    let _ = if hit == 1 then arr_put(base, vv, p[0], acc[j]) else 0;
    let _ = p[0] = p[0] + hit;
    let j = j + 1;
    0
  };
  0
}
// gb_mxm(base, tx, tmp, A, B, sr, dg): C = A *sr* B (A: n x k CSR, B: k x m CSR, both column-
// ascending per the CSR contract). Two-pass count/fill (pass 1 builds rp via gb_mxm_row's
// return count; pass 2 recomputes each row -- rs's monotonic stamp makes this safe to call
// gb_mxm_row twice per row with the SAME stamp/acc scratch -- and writes it out).
fn gb_mxm(base: [i64], tx: [i64], tmp: [i64], A: i64, B: i64, sr: i64, dg: [i64]) -> i64 {
  let n = st_get(base, A, 0);
  let m = st_get(base, B, 1);
  let stamp = zeros(m);
  let acc = zeros(m);
  let rs = zeros(1);
  let cnt = zeros(1);
  let rp = arr_alloc(base, tx, dg[0], n + 1);
  let i = 0;
  while i < n {
    let c = gb_mxm_row(base, A, B, sr, i, stamp, acc, rs, cnt);
    let _ = arr_put(base, rp, i + 1, c);
    let i = i + 1;
    0
  };
  let v = 0;
  while v < n {
    let _ = arr_put(base, rp, v + 1, arr_get(base, rp, v + 1) + arr_get(base, rp, v));
    let v = v + 1;
    0
  };
  let nnz = arr_get(base, rp, n);
  let ci = arr_alloc(base, tx, dg[1], nnz);
  let vv = arr_alloc(base, tx, dg[2], nnz);
  let wp = zeros(1);
  let i2 = 0;
  while i2 < n {
    let _ = gb_mxm_row(base, A, B, sr, i2, stamp, acc, rs, cnt);
    let s2 = rs[0];
    let _ = wp[0] = arr_get(base, rp, i2);
    let _ = gb_mxm_write_row(base, ci, vv, m, s2, stamp, acc, wp);
    let i2 = i2 + 1;
    0
  };
  let _ = st_seal(base, rp, tmp);
  let _ = st_seal(base, ci, tmp);
  let _ = st_seal(base, vv, tmp);
  gb_matrix_seal(base, tx, tmp, dg[3], n, m, nnz, 1, rp, ci, vv)
}

// ---- eWiseMult (intersection, two-pointer merge of sorted rows) / eWiseAdd (union) ----
fn gb_ewm_merge_row(base: [i64], A: i64, B: i64, sr: i64, ka0: i64, hia: i64, kb0: i64, hib: i64, ci: i64, vv: i64, w: [i64]) -> i64 {
  let ka = ka0;
  let kb = kb0;
  while (ka < hia) * (kb < hib) == 1 {
    let ca = gb_col(base, A, ka);
    let cb = gb_col(base, B, kb);
    let eq = if ca == cb then 1 else 0;
    let lt = if ca < cb then 1 else 0;
    let _ = if eq == 1 then arr_put(base, ci, w[0], ca) else 0;
    let _ = if eq == 1 then arr_put(base, vv, w[0], gb_sr_mul(sr, gb_val(base, A, ka), gb_val(base, B, kb))) else 0;
    let _ = w[0] = w[0] + eq;
    let ka = ka + eq + lt;
    let kb = kb + eq + (1 - eq) * (1 - lt);
    0
  };
  0
}
// gb_ewise_mult(base, tx, tmp, A, B, sr, dg): C[i,j] = A[i,j] otimes B[i,j] where BOTH exist
// (structural intersection per row) -- A, B same n x m shape. Single pass: `w[0]` is a running
// GLOBAL cursor (never reset between rows), so rp[i+1] = w[0] right after row i is already the
// cumulative offset -- no separate prefix-sum pass needed (unlike mxm/select, whose row counts
// aren't known until the row is done being merged AGAINST an unrelated second matrix's shape).
fn gb_ewise_mult(base: [i64], tx: [i64], tmp: [i64], A: i64, B: i64, sr: i64, dg: [i64]) -> i64 {
  let n = st_get(base, A, 0);
  let m = st_get(base, A, 1);
  let nnzA = st_get(base, A, 2);
  let nnzB = st_get(base, B, 2);
  let cap = nnzA + nnzB;
  let rp = arr_alloc(base, tx, dg[0], n + 1);
  let ci = arr_alloc(base, tx, dg[1], cap);
  let vv = arr_alloc(base, tx, dg[2], cap);
  let w = zeros(1);
  let i = 0;
  while i < n {
    let ka = gb_row_lo(base, A, i);
    let hia = gb_row_hi(base, A, i);
    let kb = gb_row_lo(base, B, i);
    let hib = gb_row_hi(base, B, i);
    let _ = gb_ewm_merge_row(base, A, B, sr, ka, hia, kb, hib, ci, vv, w);
    let _ = arr_put(base, rp, i + 1, w[0]);
    let i = i + 1;
    0
  };
  let _ = st_seal(base, rp, tmp);
  let _ = st_seal(base, ci, tmp);
  let _ = st_seal(base, vv, tmp);
  gb_matrix_seal(base, tx, tmp, dg[3], n, m, w[0], 1, rp, ci, vv)
}
fn gb_ewa_merge_row(base: [i64], A: i64, B: i64, sr: i64, ka0: i64, hia: i64, kb0: i64, hib: i64, ci: i64, vv: i64, w: [i64]) -> i64 {
  let ka = ka0;
  let kb = kb0;
  while (ka < hia) * (kb < hib) == 1 {
    let ca = gb_col(base, A, ka);
    let cb = gb_col(base, B, kb);
    let eq = if ca == cb then 1 else 0;
    let lt = if ca < cb then 1 else 0;
    let col = if lt == 1 then ca else cb;
    let val = if eq == 1 then gb_sr_add(sr, gb_val(base, A, ka), gb_val(base, B, kb)) else if lt == 1 then gb_val(base, A, ka) else gb_val(base, B, kb);
    let _ = arr_put(base, ci, w[0], col);
    let _ = arr_put(base, vv, w[0], val);
    let _ = w[0] = w[0] + 1;
    let ka = ka + eq + lt;
    let kb = kb + eq + (1 - eq) * (1 - lt);
    0
  };
  let ka2 = ka;
  while ka2 < hia {
    let _ = arr_put(base, ci, w[0], gb_col(base, A, ka2));
    let _ = arr_put(base, vv, w[0], gb_val(base, A, ka2));
    let _ = w[0] = w[0] + 1;
    let ka2 = ka2 + 1;
    0
  };
  let kb2 = kb;
  while kb2 < hib {
    let _ = arr_put(base, ci, w[0], gb_col(base, B, kb2));
    let _ = arr_put(base, vv, w[0], gb_val(base, B, kb2));
    let _ = w[0] = w[0] + 1;
    let kb2 = kb2 + 1;
    0
  };
  0
}
// gb_ewise_add(base, tx, tmp, A, B, sr, dg): C[i,j] = A[i,j] oplus B[i,j] (union: a column
// present in only one side passes its value through unchanged, present in both combines via
// oplus) -- same single-pass running-cursor construction as gb_ewise_mult.
fn gb_ewise_add(base: [i64], tx: [i64], tmp: [i64], A: i64, B: i64, sr: i64, dg: [i64]) -> i64 {
  let n = st_get(base, A, 0);
  let m = st_get(base, A, 1);
  let nnzA = st_get(base, A, 2);
  let nnzB = st_get(base, B, 2);
  let cap = nnzA + nnzB;
  let rp = arr_alloc(base, tx, dg[0], n + 1);
  let ci = arr_alloc(base, tx, dg[1], cap);
  let vv = arr_alloc(base, tx, dg[2], cap);
  let w = zeros(1);
  let i = 0;
  while i < n {
    let ka = gb_row_lo(base, A, i);
    let hia = gb_row_hi(base, A, i);
    let kb = gb_row_lo(base, B, i);
    let hib = gb_row_hi(base, B, i);
    let _ = gb_ewa_merge_row(base, A, B, sr, ka, hia, kb, hib, ci, vv, w);
    let _ = arr_put(base, rp, i + 1, w[0]);
    let i = i + 1;
    0
  };
  let _ = st_seal(base, rp, tmp);
  let _ = st_seal(base, ci, tmp);
  let _ = st_seal(base, vv, tmp);
  gb_matrix_seal(base, tx, tmp, dg[3], n, m, w[0], 1, rp, ci, vv)
}

// ---- select: 2-pass count/fill. pred: 1 value != 0, 2 col > row (strict upper triangle),
// 3 value >= thresh. Column order is preserved for free (a filtered subsequence of an already
// column-ascending row never needs re-sorting).
fn gb_select_test(pred: i64, row: i64, col: i64, val: i64, thresh: i64) -> i64 {
  if pred == 2 then (if col > row then 1 else 0)
  else if pred == 3 then (if val >= thresh then 1 else 0)
  else (if val != 0 then 1 else 0)
}
fn gb_select(base: [i64], tx: [i64], tmp: [i64], A: i64, pred: i64, thresh: i64, dg: [i64]) -> i64 {
  let n = st_get(base, A, 0);
  let m = st_get(base, A, 1);
  let rp = arr_alloc(base, tx, dg[0], n + 1);
  let i = 0;
  while i < n {
    let lo = gb_row_lo(base, A, i);
    let hi = gb_row_hi(base, A, i);
    let k = lo;
    let c = 0;
    while k < hi {
      let hit = gb_select_test(pred, i, gb_col(base, A, k), gb_val(base, A, k), thresh);
      let c = c + hit;
      let k = k + 1;
      0
    };
    let _ = arr_put(base, rp, i + 1, c);
    let i = i + 1;
    0
  };
  let v = 0;
  while v < n {
    let _ = arr_put(base, rp, v + 1, arr_get(base, rp, v + 1) + arr_get(base, rp, v));
    let v = v + 1;
    0
  };
  let nnz = arr_get(base, rp, n);
  let ci = arr_alloc(base, tx, dg[1], nnz);
  let vv = arr_alloc(base, tx, dg[2], nnz);
  let p = zeros(1);
  let i2 = 0;
  while i2 < n {
    let _ = p[0] = arr_get(base, rp, i2);
    let lo = gb_row_lo(base, A, i2);
    let hi = gb_row_hi(base, A, i2);
    let k = lo;
    while k < hi {
      let col = gb_col(base, A, k);
      let val = gb_val(base, A, k);
      let hit = gb_select_test(pred, i2, col, val, thresh);
      let _ = if hit == 1 then arr_put(base, ci, p[0], col) else 0;
      let _ = if hit == 1 then arr_put(base, vv, p[0], val) else 0;
      let _ = p[0] = p[0] + hit;
      let k = k + 1;
      0
    };
    let i2 = i2 + 1;
    0
  };
  let _ = st_seal(base, rp, tmp);
  let _ = st_seal(base, ci, tmp);
  let _ = st_seal(base, vv, tmp);
  gb_matrix_seal(base, tx, tmp, dg[3], n, m, nnz, 1, rp, ci, vv)
}

// ---- apply: unary op on values, structure UNCHANGED -- rp/ci are shared (linked, not
// copied) with A, since apply never touches the sparsity pattern. op: 1 identity, 2 v+1,
// 3 negate (0-v).
fn gb_apply_op(op: i64, v: i64) -> i64 {
  if op == 2 then v + 1 else if op == 3 then 0 - v else v
}
fn gb_apply(base: [i64], tx: [i64], tmp: [i64], A: i64, op: i64, dg: [i64]) -> i64 {
  let n = st_get(base, A, 0);
  let m = st_get(base, A, 1);
  let nnz = st_get(base, A, 2);
  let vv = arr_alloc(base, tx, dg[2], nnz);
  let k = 0;
  while k < nnz {
    let _ = arr_put(base, vv, k, gb_apply_op(op, gb_val(base, A, k)));
    let k = k + 1;
    0
  };
  let _ = st_seal(base, vv, tmp);
  gb_matrix_seal(base, tx, tmp, dg[3], n, m, nnz, 1, st_ref(base, A, 4), st_ref(base, A, 5), vv)
}

// ---- reduce: row (sum of a row's VALUES, not gb_fold_row's column-id sum) / column (via the
// TRANSPOSED CSR -- pass gb_transpose(A) as AT, reduce its row j) / scalar (sum of every value).
fn gb_reduce_row(base: [i64], A: i64, i: i64) -> i64 {
  let lo = gb_row_lo(base, A, i);
  let hi = gb_row_hi(base, A, i);
  let k = lo;
  let acc = 0;
  while k < hi {
    let acc = acc + gb_val(base, A, k);
    let k = k + 1;
    0
  };
  acc
}
fn gb_reduce_col(base: [i64], AT: i64, j: i64) -> i64 { gb_reduce_row(base, AT, j) }
fn gb_reduce_scalar(base: [i64], A: i64) -> i64 {
  let nnz = st_get(base, A, 2);
  arr_sum(base, st_ref(base, A, 6), nnz)
}
