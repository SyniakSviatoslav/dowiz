use "selfhost/prelude/sha256.bp"
// selfhost/prelude/merkle.bp -- the bebop reader of a receipt's price certificate (LV-PCD-C,
// docs/design/SPEC-PCD-2026-10-27.md; RFC 9162 §2.1). The fourth reader beside
// crates/bebop-store/src/merkle.rs (native), crates/bebop-wasm/src/verify.rs (wasm32) and
// crates/bebop-wasm/oracle_verify.py; crates/bebop-wasm/verify.sh holds all four to
// crates/bebop-wasm/fixtures/verify.expected.
//
//   cert  := 'V' || field(id) || field(price i64) || field(index u64) || field(n u64)
//            || field(root, 32) || field(path, 32 k)        field := len(u64 LE) || bytes
//   leaf  = sha256(0x00 || field(id) || field(price))  -- the cert's own bytes 1 .. price end
//   node  = sha256(0x01 || left || right)
//
// Bytes live ONE PER CELL (the shape sha256_words takes). A hash is 32 byte cells. Status:
// 0 the path climbs to the named root, 50 malformed, 51 mismatch. `>>` is logical.

// mk_u64: the 8 little-endian bytes at b[at..at+8) as one cell.
fn mk_u64(b: [i64], at: i64) -> i64 {
  let v = 0;
  let i = 0;
  while i < 8 {
    let v = v | ((b[at + i] & 255) << (8 * i));
    let i = i + 1;
    0
  };
  v
}

// mk_hash: sha256 of n byte cells of src into 32 byte cells at out[0..32).
fn mk_hash(src: [i64], n: i64, out: [i64]) -> i64 {
  let h = zeros(8);
  let _ = sha256_words(src, n, h);
  let i = 0;
  while i < 8 {
    let _ = out[4 * i] = (h[i] >> 24) & 255;
    let _ = out[4 * i + 1] = (h[i] >> 16) & 255;
    let _ = out[4 * i + 2] = (h[i] >> 8) & 255;
    let _ = out[4 * i + 3] = h[i] & 255;
    let i = i + 1;
    0
  };
  0
}

// mk_node: r := sha256(0x01 || l || r_or_sib) where `sib_left` = 1 puts sib on the left of r.
fn mk_node(r: [i64], sib: [i64], so: i64, sib_left: i64) -> i64 {
  let buf = zeros(65);
  let _ = buf[0] = 1;
  let i = 0;
  while i < 32 {
    let _ = if sib_left == 1 then (
      let _ = buf[1 + i] = sib[so + i] in
      buf[33 + i] = r[i]
    ) else (
      let _ = buf[1 + i] = r[i] in
      buf[33 + i] = sib[so + i]
    );
    let i = i + 1;
    0
  };
  mk_hash(buf, 65, r)
}

// mk_field: the field at b[at..): checks its length against max and the end; returns the offset of
// its bytes, or -1. fl[0] receives its length.
fn mk_field(b: [i64], at: i64, end: i64, max: i64, fl: [i64]) -> i64 {
  let ln = if at + 8 <= end then mk_u64(b, at) else 0 - 1;
  let ok = if ln >= 0 then (if ln <= max then (if at + 8 + ln <= end then 1 else 0) else 0) else 0;
  let _ = fl[0] = ln;
  if ok == 1 then at + 8 else 0 - 1
}

// mk_unwind: while fn is even and not zero, halve fn and sn (RFC 9162 step 3.2).
fn mk_unwind(fs: [i64]) -> i64 {
  let go = if (fs[0] & 1) == 0 then (if fs[0] != 0 then 1 else 0) else 0;
  while go == 1 {
    let _ = fs[0] = fs[0] >> 1;
    let _ = fs[1] = fs[1] >> 1;
    let go = if (fs[0] & 1) == 0 then (if fs[0] != 0 then 1 else 0) else 0;
    0
  };
  0
}

// mk_step: one sibling at b[so..so+32) folded into r; fs[2] := 1 when the path outruns the tree.
fn mk_step(fs: [i64], r: [i64], b: [i64], so: i64) -> i64 {
  let left = if (fs[0] & 1) == 1 then 1 else (if fs[0] == fs[1] then 1 else 0);
  let _ = if fs[1] == 0 then (fs[2] = 1) else (
    let _ = mk_node(r, b, so, left) in
    let _ = if left == 1 then mk_unwind(fs) else 0 in
    let _ = fs[0] = fs[0] >> 1 in
    fs[1] = fs[1] >> 1
  );
  0
}

// mk_check: verify the n-byte certificate in b; the climbed root goes to r[0..32) (zeros when
// malformed). Returns 0, 50 or 51.
fn mk_check(b: [i64], n: i64, r: [i64]) -> i64 {
  let fl = zeros(1);
  let o = zeros(6);
  let l = zeros(6);
  let maxes = [256, 8, 8, 8, 32, 2048];
  let at = 1;
  let bad = if n < 1 then 1 else (if b[0] != 86 then 1 else 0);
  let k = 0;
  while k < 6 {
    let p = if bad == 0 then mk_field(b, at, n, maxes[k], fl) else 0 - 1;
    let bad = if p < 0 then 1 else bad;
    let _ = o[k] = p;
    let _ = l[k] = fl[0];
    let at = if p < 0 then at else p + fl[0];
    let k = k + 1;
    0
  };
  let bad = if bad == 0 then (if at != n then 1 else (if l[1] != 8 then 1 else (if l[2] != 8 then 1 else (if l[3] != 8 then 1 else (if l[4] != 32 then 1 else (if (l[5] & 31) != 0 then 1 else 0)))))) else 1;
  let index = if bad == 0 then mk_u64(b, o[2]) else 0;
  let cnt = if bad == 0 then mk_u64(b, o[3]) else 0;
  let depth = l[5] / 32;
  // u64 compare index < cnt: both are cells; a top-bit value is negative here, and refused
  let bad = if bad == 0 then (if index < 0 then 1 else (if cnt <= 0 then 1 else (if index >= cnt then 1 else 0))) else 1;
  // the leaf: 0x00 || the cert's bytes from field(id) through field(price)
  let pre = o[1] + 8 - 1;
  let lb = zeros(pre + 1);
  let _ = lb[0] = 0;
  let i = 1;
  while i <= pre {
    let _ = lb[i] = if bad == 0 then b[i] else 0;
    let i = i + 1;
    0
  };
  let _ = if bad == 0 then mk_hash(lb, pre + 1, r) else 0;
  // RFC 9162 §2.1.3.2 with fs[0] = fn, fs[1] = sn, fs[2] = bad (one-cell mutables)
  let fs = zeros(3);
  let _ = fs[0] = index;
  let _ = fs[1] = cnt - 1;
  let _ = fs[2] = bad;
  let j = 0;
  while j < depth {
    let _ = if fs[2] == 0 then mk_step(fs, r, b, o[5] + 32 * j) else 0;
    let j = j + 1;
    0
  };
  let bad = if fs[2] == 0 then (if fs[1] != 0 then 1 else 0) else 1;
  let same = zeros(1);
  let _ = same[0] = 1;
  let q = 0;
  while q < 32 {
    let _ = if bad == 0 then (if r[q] != b[o[4] + q] then (same[0] = 0) else 0) else 0;
    let q = q + 1;
    0
  };
  let z = 0;
  while z < 32 {
    let _ = if bad == 1 then (r[z] = 0) else 0;
    let z = z + 1;
    0
  };
  if bad == 1 then 50 else (if same[0] == 1 then 0 else 51)
}

// mk_word: root word w (0..3) of r as a big-endian 64-bit cell (the line's hex, 16 digits each).
fn mk_word(r: [i64], w: i64) -> i64 {
  let v = 0;
  let i = 0;
  while i < 8 {
    let v = (v << 8) | r[8 * w + i];
    let i = i + 1;
    0
  };
  v
}
