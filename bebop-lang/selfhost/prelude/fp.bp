// selfhost/prelude/fp.bp — Q32 fixed-point core shared by every fp gate (T38).
// Textual include: a gate whose first line is `// prelude: fp ...` gets this file
// prepended by tools/gen_selfsrc.sh std (L9 mechanism until T47 `use`).
// fp_mul: signed 64x64 -> Q32 product via 32/16-bit limbs (no i128, no >> on
// negatives); isqrt: clz-seeded Newton descent (T105), exact floor(sqrt).
fn fp_mul(a: i64, b: i64) -> i64 {
  let na = if a < 0 then 1 else 0;
  let aa = if na == 1 then 0 - a else a;
  let nb = if b < 0 then 1 else 0;
  let ab = if nb == 1 then 0 - b else b;
  let a1 = aa >> 32;
  let a0 = aa - (a1 << 32);
  let b1 = ab >> 32;
  let b0 = ab - (b1 << 32);
  let hi = a1 * b1;
  let mid = a1 * b0 + a0 * b1;
  let ah = a0 >> 16;
  let al = a0 - (ah << 16);
  let bh = b0 >> 16;
  let bl = b0 - (bh << 16);
  let ll_h = ah * bh;
  let ll_m = ah * bl + al * bh;
  let ll_l = al * bl;
  let low = ll_h + ((ll_m + (ll_l >> 16)) >> 16);
  let p = (hi << 32) + mid + low;
  let flip = na + nb;
  let flip = flip - (flip / 2) * 2;
  let p = if flip == 1 then 0 - p else p;
  p
}
// isqrt(s): floor(sqrt(s)) for 0 <= s < 2^62 (T105, 2026-09-05: Newton from a
// clz seed 2^ceil(bits/2) >= sqrt(s), monotone descent, <= 6 sdiv steps;
// bit-exact against math.isqrt on 1.2M values incl. every 2^k+-1 and r^2+-1,
// scratch t105chk.py). Was the 31-step restoring loop.
fn isqrt(s: i64) -> i64 {
  let x = 1 << ((65 - clz(s)) >> 1);
  let y = (x + s / x) >> 1;
  while y < x {
    let x = y;
    let y = (x + s / x) >> 1;
    0
  };
  if s <= 0 then 0 else x
}
