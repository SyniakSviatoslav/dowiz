// selfhost/prelude/store.bp — T111 store library (docs/LANG-DB-DESIGN.md §4, D10/D11-H).
// The file: page 0 = superblock A (cells 0..15), page 1 = superblock B (cells
// 512..527), cells 1024.. = append-only bump arena of objects. Every object =
// h0 (layout_digest_lo32 << 32 | length_in_cells), h1 (crc32(payload LE bytes)
// << 32 | generation), payload. A `ref` field = OBJECT-relative signed cell
// offset (target = this_object_start + off), 0 = null. Nothing in the file is an
// address: the mapping may land at any base. st_cells/st_addr are the ONLY
// i64 <-> [i64] casts in the tree (the mapping base), allowlisted by name in
// tools/typecheck.py; everything else stays under the T48 census. Superblock (16 cells): 0 magic
// "BEBOPST1", 1 version, 2 generation, 3 root, 4 arena_used, 5 layout_table,
// 6 migration_table, 7 live_cells, 8 superseded_cells, 9 reserved (B1 `anc`),
// 10 commit-object offset (C3), 11 heads-table offset (C3), 12..14 zero, 15 crc32 of
// cells 0..14. A reader picks the valid superblock with the higher generation.
//
// PartTab (B5 step 1, P=1 degenerate case): the live superblock's `root` cell (3)
// points at a PartTab object. PartTab = 16 + 3*P cells; for P=1 that is 19 cells.
//   cells 0..15   = exactly the live superblock's 16 cells (magic..crc) — a snapshot
//                    of the superblock AS WRITTEN by the committing thread, so a reader
//                    that copies PartTab gets a self-consistent superblock + partition
//                    table in one object whose crc covers both.
//   cells 16..18  = P=1 partition entry: [root_p, used_p, gen_p] (3 cells).
//                    root_p = the partition's root object offset (== superblock root
//                    for P=1), used_p = the partition's arena cursor (== superblock
//                    arena_used for P=1), gen_p = the partition's generation (==
//                    superblock generation for P=1).
// The superblock's cell 3 (root) names this PartTab; cells 4 (arena_used) and 2
// (generation) are now DERIVED from PartTab for P=1 (same values, read-through
// for byte-identical behaviour). st_begin reads used_p from PartTab; st_commit
// writes a new PartTab' with (root_p, used_p, gen_p+1) and bumps the global
// superblock generation too (still gen+1, same as today).
//
// Transaction tx (6 cells): 0 live sb, 1 mark, 2 cursor, 3 live delta,
// 4 superseded delta, 5 next generation. Commit = write the OTHER superblock.
// crc32 is crc32x over the raw little-endian bytes of the cells (no staging).
fn st_cells(a: i64) -> [i64] { a }
fn st_addr(base: [i64]) -> i64 { base }
fn st_magic() -> i64 { 3554557610294396226 }
fn st_str(dst: [i64], s: str) -> i64 {
  let n = str_len(s);
  let i = 0;
  while i < n {
    let _ = dst[i] = char(s, i);
    let i = i + 1;
    0
  };
  n
}
fn st_bytes(src: [i64], off: i64, n: i64, out: [i64]) -> i64 {
  let i = 0;
  while i < n {
    let v = src[off + i];
    let j = 0;
    while j < 8 {
      let _ = out[i * 8 + j] = (v >> (j * 8)) & 255;
      let j = j + 1;
      0
    };
    let i = i + 1;
    0
  };
  n * 8
}
// st_crc: zlib crc32 of the raw little-endian bytes of n cells (crc32x, T109b); tmp is
// kept in the signatures for the API but no longer used (staging 8*len bytes into a
// 256-cell tmp overflowed the arena on the first million-slot root, G4).
fn st_crc(src: [i64], off: i64, n: i64, tmp: [i64]) -> i64 {
  crc32x(src, off, n)
}
fn st_sb_write(base: [i64], sb: i64, gen: i64, root: i64, used: i64, live: i64, sup: i64, tmp: [i64]) -> i64 {
  st_sb_write_m(base, sb, gen, root, used, live, sup, 0, tmp)
}
// st_sb_write_m: the same with the migration-table object offset (cell 6, T114).
fn st_sb_write_m(base: [i64], sb: i64, gen: i64, root: i64, used: i64, live: i64, sup: i64, mig: i64, tmp: [i64]) -> i64 {
  let _ = base[sb] = st_magic();
  let _ = base[sb + 1] = 1;
  let _ = base[sb + 2] = gen;
  let _ = base[sb + 3] = root;
  let _ = base[sb + 4] = used;
  let _ = base[sb + 5] = 0;
  let _ = base[sb + 6] = mig;
  let _ = base[sb + 7] = live;
  let _ = base[sb + 8] = sup;
  let k = 9;
  while k < 15 {
    let _ = base[sb + k] = 0;
    let k = k + 1;
    0
  };
  let _ = base[sb + 15] = st_crc(base, sb, 15, tmp);
  0
}
fn st_sb_valid(base: [i64], sb: i64, tmp: [i64]) -> i64 {
  if base[sb] == st_magic() then (if base[sb + 15] == st_crc(base, sb, 15, tmp) then 1 else 0) else 0
}
// st_pick(base, tmp): the live superblock cell index (0 or 512), -1 if neither is valid.
fn st_pick(base: [i64], tmp: [i64]) -> i64 {
  let va = st_sb_valid(base, 0, tmp);
  let vb = st_sb_valid(base, 512, tmp);
  if va + vb == 2 then (if base[514] > base[2] then 512 else 0) else if va == 1 then 0 else if vb == 1 then 512 else 0 - 1
}
// st_verify(base, upto, tmp): reopen-time trust check for one superblock's whole
// object arena, cells 1024..upto (append-only, so this is every object that
// generation's root chain could ever reach -- no per-type ref/layout table
// needed, and it is strictly stronger than a root-only walk since it also
// covers superseded objects, harmless since those are only ever written once).
// Closes the B1 torn-write gap (docs/blueprints/B1-durability-torn-write.md):
// a torn/zeroed PAYLOAD page can leave a superblock whose OWN crc is fully
// valid (two independent pages -- st_pick alone cannot see this). A torn
// object HEADER (h0's length word) is itself untrusted: `len >= 1` is
// required (st_compact enforces the same invariant elsewhere, exit 84 on
// len < 1 -- no real object is ever length 0), which is what actually
// catches a zeroed page: an all-zero h0/h1 looks like a trivially "valid"
// zero-length object whose crc-of-nothing (0) matches its own zeroed crc
// field, so without this check a torn/zeroed run is silently stepped over
// two cells at a time and never flagged. A length that would run the scan
// past `upto` (torn to something merely large, not zero) also stops it
// immediately and counts as bad -- the scan can never read past the
// caller's own arena bound, however garbled the length word. Inlines
// st_len/st_check (via st_crc, already defined above) rather than calling
// them, so this can sit before st_open without a forward reference.
// Returns (bad_count << 32) | objects_visited.
// st_verify_range(base, from, upto, tmp): the same walk, bounded BELOW as well (B1 recovery,
// 2026-09-09). `from` must be an object boundary; the only value ever passed is the OTHER
// superblock's arena_used cell, which IS that generation's bump cursor and therefore always one.
// Why a lower bound is sound: the arena is append-only and a commit's range is made durable
// BEFORE the superblock that names it (st_commit_sync: msync range, toggle superblock, msync
// superblock). So when the fallback generation's superblock is crc-valid, every byte below its
// cursor was durable before the failing commit's crash window even opened, and the only bytes a
// crash can leave inconsistent with a valid superblock are [fallback_cursor, live_cursor).
// Re-crc-ing everything below that on EVERY open is paranoia, not durability: it is the same
// bytes, re-read, every time the file is opened.
fn st_verify_range(base: [i64], from: i64, upto: i64, tmp: [i64]) -> i64 {
  let off = from;
  let bad = 0;
  let n = 0;
  while off < upto {
    let len = base[off] & 4294967295;
    let fits = if len >= 1 then (if off + 2 + len <= upto then 1 else 0) else 0;
    let ok = if fits == 1 then (if (base[off + 1] >> 32) == st_crc(base, off + 2, len, tmp) then 1 else 0) else 0;
    let bad = bad + (1 - ok);
    let n = n + 1;
    let off = if fits == 1 then off + 2 + len else upto;
    0
  };
  (bad << 32) | n
}
// st_verify: the WHOLE arena, unchanged in meaning and still the fail-stop check used on the
// fallback path and by any caller that wants full coverage (a fsck, not a reopen).
fn st_verify(base: [i64], upto: i64, tmp: [i64]) -> i64 { st_verify_range(base, 1024, upto, tmp) }
// st_reopen_lo(base, sb, tmp): the lower bound for the reopen scan -- the OTHER superblock's
// cursor when that superblock is crc-valid and its cursor does not run past ours, else 1024
// (full scan). A generation with no valid sibling has no evidence below its own cursor, so it
// gets the whole scan; that is the conservative direction.
fn st_reopen_lo(base: [i64], sb: i64, tmp: [i64]) -> i64 {
  let other = if sb == 0 then 512 else 0;
  let ov = st_sb_valid(base, other, tmp);
  let ou = if ov == 1 then base[other + 4] else 1024;
  if ou >= 1024 then (if ou <= base[sb + 4] then ou else 1024) else 1024
}
// st_reopen_verify(base, tmp): called by st_open on every non-fresh open.
// st_pick only checks a superblock's OWN crc -- it will happily pick a
// generation whose superblock survived a crash intact while its payload was
// independently torn (the B1 gap). Re-verify the picked superblock's object
// arena; on failure, stamp that superblock's magic word to 0 IN THE MAPPING
// (self-heals the file: every future reader, this process or any other,
// including a tool that only checks a superblock's own crc, now sees it as
// invalid and skips it -- MAP_SHARED writes are visible to any process that
// reads the same file afterward, no fsync needed for that, only for crash
// durability) and re-pick. One retry is enough: the fallback generation's
// payload range was written and made durable several commits before the one
// that tore. Returns the superblock finally selected (matches st_pick's
// return convention, -1 if both copies fail verification).
fn st_reopen_verify(base: [i64], tmp: [i64]) -> i64 {
  let sb = st_pick(base, tmp);
  let bad = st_verify_range(base, st_reopen_lo(base, sb, tmp), base[sb + 4], tmp) >> 32;
  let _ = if bad > 0 then base[sb] = 0 else 0;
  let sb2 = if bad > 0 then st_pick(base, tmp) else sb;
  // The FALLBACK is scanned in FULL on purpose: we have just proved that a valid superblock did
  // NOT imply a durable payload for the generation we rejected, so the ordering argument that
  // licenses the bounded scan no longer applies to this file, and the fallback's own crcs are
  // the only evidence left. This is why the `recover` row cannot be made fast without weakening
  // the guarantee, while the clean `reopen` row can.
  let bad2 = if bad > 0 then (if sb2 < 0 then 0 else st_verify(base, base[sb2 + 4], tmp) >> 32) else 0;
  let _ = if bad2 > 0 then base[sb2] = 0 else 0;
  sb2
}
// st_open(path, plen, size, tmp): create/extend, map MAP_SHARED RW, init superblock A
// when the file is fresh; on a real (non-fresh) open, verify-and-heal per
// st_reopen_verify above. Returns the base (index it as cells).
fn st_open(path: [i64], plen: i64, size: i64, tmp: [i64]) -> [i64] {
  let fd = sys_open(path, plen, 66);
  let _ = sys_ftruncate(fd, size);
  let base = st_cells(sys_mmap(0, size, 3, 1, fd, 0));
  let _ = sys_close(fd);
  let fresh = if st_pick(base, tmp) < 0 then 1 else 0;
  // LOUD (trap 86), and it must come BEFORE st_reopen_verify: that walks the object chain,
  // so on a store whose content was cut off it dies with trap 82 inside the walk, one
  // function away from the cause. Checking the claimed extent first turns the same failure
  // into a named one at the line that caused it.
  // fires when an existing file is opened at the WRONG size -- st_open ftruncates to `size`,
  // so that silently cuts the arena off mid-object and every later read traps 82 somewhere
  // far from the cause. Measured 2026-09-12: nine gb gates were red for exactly this, and the
  // fires when an existing file is opened at the WRONG size -- st_open ftruncates to `size`,
  // so that silently cuts the arena off mid-object. Measured 2026-09-12: nine gb gates were
  // red for exactly this and the symptom was an empty `got=`, which reads as a miscompile.
  let live_sb = if fresh == 1 then 0 else st_pick(base, tmp);
  let _ = if fresh == 0 then (if base[live_sb + 4] * 8 > size then sys_exit(86) else 0) else 0;
  let _ = if fresh == 1 then st_sb_write(base, 0, 0, 0, 1024, 0, 0, tmp) else st_reopen_verify(base, tmp);
  base
}
// st_map_ro(path, plen, size): a reader's mapping (PROT_READ, MAP_SHARED).
fn st_map_ro(path: [i64], plen: i64, size: i64) -> [i64] {
  let fd = sys_open(path, plen, 0);
  let base = st_cells(sys_mmap(0, size, 1, 1, fd, 0));
  let _ = sys_close(fd);
  base
}
// st_parttab_cells(p: i64): number of cells in a PartTab for P=p partitions (16 + 3*P).
fn st_parttab_cells(p: i64) -> i64 { 16 + p * 3 }

// st_parttab_write(base, pt_off, sb, gen, root, used, tmp): write a PartTab object
// at pt_off. For P=1: cells 0..15 = superblock copy (magic..crc), cell 16 = root_p,
// cell 17 = used_p, cell 18 = gen_p. The crc (cell 15) covers ALL 19 cells.
// pt_off is an arena object offset (same type as st_alloc returns).
fn st_parttab_write(base: [i64], pt_off: i64, sb: i64, gen: i64, root: i64, used: i64, tmp: [i64]) -> i64 {
  // superblock copy into PartTab payload cells 0..15 (with +2 skip for header)
  let _ = base[pt_off + 2] = base[sb];
  let _ = base[pt_off + 3] = base[sb + 1];
  let _ = base[pt_off + 4] = base[sb + 2];
  let _ = base[pt_off + 5] = base[sb + 3];
  let _ = base[pt_off + 6] = base[sb + 4];
  let _ = base[pt_off + 7] = base[sb + 5];
  let _ = base[pt_off + 8] = base[sb + 6];
  let _ = base[pt_off + 9] = base[sb + 7];
  let _ = base[pt_off + 10] = base[sb + 8];
  let _ = base[pt_off + 11] = base[sb + 9];
  let _ = base[pt_off + 12] = base[sb + 10];
  let _ = base[pt_off + 13] = base[sb + 11];
  let _ = base[pt_off + 14] = base[sb + 12];
  let _ = base[pt_off + 15] = base[sb + 13];
  let _ = base[pt_off + 16] = base[sb + 14];
  let _ = base[pt_off + 17] = base[sb + 15];
  // P=1 partition entry at payload cells 16..18 (with +2 skip)
  let _ = base[pt_off + 18] = root;   // root_p
  let _ = base[pt_off + 19] = used;   // used_p
  let _ = base[pt_off + 20] = gen;    // gen_p
  // re-crc over all 19 payload cells (the superblock copy is now stale; crc must cover
  // the full PartTab including the partition entry)
  let _ = base[pt_off + 2 + 15] = st_crc(base, pt_off + 2, 19, tmp);
  pt_off
}

// st_parttab_used(base, sb, pt_off: i64): read used_p from a PartTab (cell 17 for P=1).
// When pt_off == 0 (no PartTab yet, e.g. fresh store before first commit),
// fall back to the superblock's cell 4 directly for byte-identical behaviour.
// `sb` is the live superblock index (0 or 512), already picked.
fn st_parttab_used(base: [i64], sb: i64, pt_off: i64) -> i64 {
  if pt_off == 0 then base[sb + 4] else base[pt_off + 19]
}

// st_parttab_gen(base, sb, pt_off: i64): read gen_p from a PartTab (cell 18 for P=1).
// When pt_off == 0, fall back to the superblock's cell 2.
fn st_parttab_gen(base: [i64], sb: i64, pt_off: i64) -> i64 {
  if pt_off == 0 then base[sb + 2] else base[pt_off + 20]
}

// st_parttab_root(base, pt_off: i64): read root_p from a PartTab (cell 16 for P=1).
// When pt_off == 0, return 0 (no root yet).
fn st_parttab_root(base: [i64], pt_off: i64) -> i64 {
  if pt_off == 0 then 0 else base[pt_off + 18]
}

fn st_begin(base: [i64], tx: [i64], tmp: [i64]) -> i64 {
  let sb = st_pick(base, tmp);
  let _ = tx[0] = sb;
  // B5 step 1: read used_p from PartTab instead of sb+4 directly.
  // For P=1, PartTab is at base[sb+3] (the root cell), and used_p (cell 17)
  // equals the old sb+4 value — byte-identical behaviour.
  let pt = base[sb + 3];
  let _ = tx[1] = st_parttab_used(base, sb, pt);
  let _ = tx[2] = st_parttab_used(base, sb, pt);
  let _ = tx[3] = 0;
  let _ = tx[4] = 0;
  // next generation: gen_p + 1 (== sb+2 + 1 for P=1)
  let _ = tx[5] = st_parttab_gen(base, sb, pt) + 1;
  sb
}
// st_alloc(base, tx, len, digest): bump-allocate an object of len payload cells;
// writes h0 and h1 (crc 0 until st_seal). Returns the object's cell offset.
fn st_alloc(base: [i64], tx: [i64], len: i64, digest: i64) -> i64 {
  let off = tx[2];
  let _ = base[off] = ((digest & 4294967295) << 32) | len;
  let _ = base[off + 1] = tx[5];
  let _ = tx[2] = off + 2 + len;
  let _ = tx[3] = tx[3] + 2 + len;
  off
}
fn st_len(base: [i64], off: i64) -> i64 { base[off] & 4294967295 }
fn st_seal(base: [i64], off: i64, tmp: [i64]) -> i64 {
  // LOUD (trap 85): a length this large is not an object length, it is a header cell that
  // something overwrote. Without this guard st_crc simply walks it: measured 2026-09-12, a
  // clobbered PartTab header gave len = 1329743170 -- the low word of the store magic -- and
  // the crc walked 10.6 GB out of a 64 KB mapping, so the process died with trap 82 in a
  // completely different function from the one with the bug.
  let n = st_len(base, off);
  let _ = if n > 268435456 then sys_exit(85) else 0;
  let crc = st_crc(base, off + 2, n, tmp);
  let _ = base[off + 1] = (crc << 32) | (base[off + 1] & 4294967295);
  crc
}
fn st_check(base: [i64], off: i64, tmp: [i64]) -> i64 {
  if (base[off + 1] >> 32) == st_crc(base, off + 2, st_len(base, off), tmp) then 1 else 0
}
// st_supersede(base, tx, off): accounting for an object replaced by a new version.
fn st_supersede(base: [i64], tx: [i64], off: i64) -> i64 {
  let _ = tx[4] = tx[4] + 2 + st_len(base, off);
  0
}
fn st_commit(base: [i64], tx: [i64], root: i64, tmp: [i64]) -> i64 {
  st_commit_m(base, tx, root, base[tx[0] + 6], tmp)
}
// st_commit_m: commit with a (new) migration-table object offset; 0 clears it.
fn st_commit_m(base: [i64], tx: [i64], root: i64, mig: i64, tmp: [i64]) -> i64 {
  let sb = tx[0];
  let live = base[sb + 7] + tx[3] - tx[4];
  let sup = base[sb + 8] + tx[4];
  // B5 step 1: write a new PartTab object in the arena (allocated in the OTHER
  // superblock's region, since we're toggling). The PartTab carries the new
  // (root, used, gen+1) for P=1. For P=1, root_p = root, used_p = tx[2] (the
  // new cursor after all allocations), gen_p = tx[5] (the new generation).
  //
  // The PartTab replaces the superblock's root cell: the new superblock's cell 3
  // points at this PartTab. Cells 4 (used) and 2 (gen) in the superblock are
  // still set to the same values for backward compatibility (readers that don't
  // know about PartTab still see correct values), but the authority for P>=1
  // moves to the PartTab.
  // The PartTab lives in the FREE TAIL OF ITS OWN SUPERBLOCK'S PAGE, not in the arena.
  // A superblock occupies 16 of the 512 cells reserved for it, so cells sb+16 .. sb+511 are
  // free, and 2 + st_parttab_cells(1) = 21 fits with room to spare. Three consequences, all
  // of them the reason for doing it this way (operator decision 2026-09-12, architecture over
  // expedience): the arena layout is unchanged by B5 step 1, so every golden frozen before it
  // is correct again; nothing grows by 21 cells per commit; and consecutive generations'
  // PartTabs land on DIFFERENT PAGES, exactly as the two superblocks do, so a single page tear
  // can no longer destroy both -- which is what made scrash_torn 50 invalid reopens out of 50.
  let pt = (512 - sb) + 16;
  let _ = base[pt] = ((st_digest("PartTab") & 4294967295) << 32) | st_parttab_cells(1);
  let _ = base[pt + 1] = tx[5];
  let _ = st_parttab_write(base, pt, sb, tx[5], root, tx[2], tmp);
  let _ = st_seal(base, pt, tmp);
  // Write the OTHER superblock with root = PartTab offset, used = tx[2] (same
  // as before for byte-compat), gen = tx[5] (same as before).
  let _ = st_sb_write_m(base, 512 - sb, tx[5], pt, tx[2], live, sup, mig, tmp);
  tx[5]
}

// B5 step 2: Multi-partition store API
// New functions for P-partition transactional store with per-partition locking
// and 2-phase cross-partition commit.

// st_parttab_write_p(base, pt_off, sb, roots, useds, gens, pcount, tmp):
// Write a PartTab object for P partitions at pt_off.
// Cells 0..15 = superblock copy, then pcount entries of 3 cells: [root_p, used_p, gen_p].
fn st_parttab_write_p(base: [i64], pt_off: i64, sb: i64, locks: [i64], pcount: i64, tmp: [i64]) -> i64 {
  let _ = base[pt_off + 2] = base[sb];
  let _ = base[pt_off + 3] = base[sb + 1];
  let _ = base[pt_off + 4] = base[sb + 2];
  let _ = base[pt_off + 5] = base[sb + 3];
  let _ = base[pt_off + 6] = base[sb + 4];
  let _ = base[pt_off + 7] = base[sb + 5];
  let _ = base[pt_off + 8] = base[sb + 6];
  let _ = base[pt_off + 9] = base[sb + 7];
  let _ = base[pt_off + 10] = base[sb + 8];
  let _ = base[pt_off + 11] = base[sb + 9];
  let _ = base[pt_off + 12] = base[sb + 10];
  let _ = base[pt_off + 13] = base[sb + 11];
  let _ = base[pt_off + 14] = base[sb + 12];
  let _ = base[pt_off + 15] = base[sb + 13];
  let _ = base[pt_off + 16] = base[sb + 14];
  let _ = base[pt_off + 17] = base[sb + 15];
  let q = 0;
  while q < pcount {
    let off = pt_off + 18 + q * 3;
    let _ = base[off] = locks[pcount + 1 + q];
    let _ = base[off + 1] = locks[2 * pcount + 1 + q];
    let _ = base[off + 2] = locks[3 * pcount + 1 + q];
    let q = q + 1;
    0
  };
  let _ = base[pt_off + 2 + 15] = st_crc(base, pt_off + 2, 16 + pcount * 3, tmp);
  pt_off
}

// st_parttab_root_p(base, pt_off, p): read root_p[p] from multi-partition PartTab
fn st_parttab_root_p(base: [i64], pt_off: i64, p: i64) -> i64 {
  if pt_off == 0 then 0 else base[pt_off + 18 + p * 3]
}

// st_parttab_used_p(base, pt_off, p): read used_p[p] from multi-partition PartTab
fn st_parttab_used_p(base: [i64], pt_off: i64, p: i64) -> i64 {
  if pt_off == 0 then 1024 else base[pt_off + 18 + p * 3 + 1]
}

// st_parttab_gen_p(base, pt_off, p): read gen_p[p] from multi-partition PartTab
fn st_parttab_gen_p(base: [i64], pt_off: i64, p: i64) -> i64 {
  if pt_off == 0 then 0 else base[pt_off + 18 + p * 3 + 2]
}

// st_region_start(p, pcount, arena_cells): start cell of partition p's region
fn st_region_start(p: i64, pcount: i64, arena_cells: i64) -> i64 {
  1024 + p * (arena_cells / pcount)
}

// st_region_end(p, pcount, arena_cells): end cell of partition p's region
fn st_region_end(p: i64, pcount: i64, arena_cells: i64) -> i64 {
  st_region_start(p, pcount, arena_cells) + arena_cells / pcount
}

// st_tmp_p(tmps, p): get the per-writer scratch buffer (256 cells = 2048 bytes)
fn st_tmp_p(tmps: [i64], p: i64) -> [i64] {
  st_cells(st_addr(tmps) + p * 2048)
}

// st_tx_p(txs, p): get the per-writer tx buffer (8 cells = 64 bytes)
fn st_tx_p(txs: [i64], p: i64) -> [i64] {
  st_cells(st_addr(txs) + p * 64)
}

// st_lock_p(locks, p): acquire partition p's lock via CAS-loop
fn st_lock_p(locks: [i64], p: i64) -> i64 {
  let spin = 1;
  while spin == 1 {
    let old = sys_atomic_add(locks, p, 1);
    let spin = if old == 0 then 0 else 1;
    let _ = if spin == 1 then sys_atomic_add(locks, p, 0 - 1) else 0;
    0
  };
  0
}

// st_unlock_p(locks, p): release partition p's lock
fn st_unlock_p(locks: [i64], p: i64) -> i64 {
  let _ = sys_atomic_add(locks, p, 0 - 1);
  let _ = sys_futex_wake(locks, p, 64);
  0
}

// st_lock_g(locks, pcount): acquire the global superblock lock
fn st_lock_g(locks: [i64], pcount: i64) -> i64 {
  let spin = 1;
  while spin == 1 {
    let old = sys_atomic_add(locks, pcount, 1);
    let spin = if old == 0 then 0 else 1;
    let _ = if spin == 1 then sys_atomic_add(locks, pcount, 0 - 1) else 0;
    0
  };
  0
}

// st_unlock_g(locks, pcount): release global lock
fn st_unlock_g(locks: [i64], pcount: i64) -> i64 {
  let _ = sys_atomic_add(locks, pcount, 0 - 1);
  let _ = sys_futex_wake(locks, pcount, 64);
  0
}

// st_begin_p(base, tx, p, tmp): begin transaction for partition p
fn st_begin_p(base: [i64], tx: [i64], p: i64, tmp: [i64]) -> i64 {
  let sb = st_pick(base, tmp);
  let _ = tx[0] = sb;
  let pt = base[sb + 3];
  let _ = tx[1] = st_parttab_used_p(base, pt, p);
  let _ = tx[2] = st_parttab_used_p(base, pt, p);
  // tx[3] is the ALLOCATED-CELLS accumulator (st_alloc_p does tx[3] = tx[3] + 2 + len),
  // exactly as in st_begin/st_alloc. It used to be seeded with the partition's current
  // root, which st_alloc_p then overwrote on the first allocation -- the root was never
  // readable from the tx and 2PC had nowhere to get it from.
  let _ = tx[3] = 0;
  let _ = tx[4] = 0;
  let _ = tx[5] = st_parttab_gen_p(base, pt, p) + 1;
  sb
}

// st_alloc_p(base, tx, p, len, digest, pcount, arena_cells): allocate in partition p
fn st_alloc_p(base: [i64], tx: [i64], p: i64, len: i64, digest: i64, pcount: i64, arena_cells: i64) -> i64 {
  let off = tx[2];
  let region_end = st_region_end(p, pcount, arena_cells);
  let _ = if off + 2 + len >= region_end then sys_exit(80) else 0;
  let _ = base[off] = ((digest & 4294967295) << 32) | len;
  let _ = base[off + 1] = tx[5];
  let _ = tx[2] = off + 2 + len;
  let _ = tx[3] = tx[3] + 2 + len;
  off
}

// st_commit_p(base, tx, p, root, locks, pcount, arena_cells, roots, useds, gens, tmp):
// Single-partition commit with partition lock + global lock for superblock toggle
// CONTRACT (2026-09-12): the CALLER holds partition p's lock across the whole
// transaction (begin -> alloc -> commit) and this function only takes the GLOBAL
// lock, exactly like st_commit_2pc. Taking st_lock_p here as well self-deadlocked
// every writer: st_lock_p is a non-recursive fetch-add spin lock, so a caller that
// already held p spun forever on its own lock. It also has to be the caller's,
// because the cross-partition path must acquire two partition locks in ascending
// order BEFORE the transaction begins.
// st_init_p(base, locks, pcount, arena_cells, tmp, ptdig): seed a store for MULTI-PARTITION
// use. Call ONCE after st_open and BEFORE any writer starts.
//
// Why this has to exist (measured 2026-09-12). st_begin_p reads partition p's cursor with
// st_parttab_used_p, whose no-PartTab fallback is the single-partition constant 1024. On a
// fresh store every partition therefore begins at 1024 -- a two-partition probe returned
// used_p(0) = 1024 AND used_p(1) = 1024 -- so every writer allocates from the start of
// partition 0's region and the partitions overwrite each other. Disjointness, which is the
// whole premise of B5's G10 gate, never held.
//
// This writes the initial PartTab with each partition's cursor at ITS OWN region start
// (st_region_start), so st_begin_p returns a disjoint cursor per partition from the first
// transaction onward. The PartTab itself lives at the base of partition 0's region, so
// partition 0's cursor starts just past it.
fn st_init_p(base: [i64], locks: [i64], pcount: i64, arena_cells: i64, tmp: [i64], ptdig: i64) -> i64 {
  let sb = st_pick(base, tmp);
  let pt_off = (512 - sb) + 16;
  let n = st_parttab_cells(pcount);
  let _ = base[pt_off] = ((ptdig & 4294967295) << 32) | n;
  let _ = base[pt_off + 1] = base[sb + 2] + 1;
  let q = 0;
  while q < pcount {
    let _ = locks[pcount + 1 + q] = 0;
    let _ = locks[2 * pcount + 1 + q] = st_region_start(q, pcount, arena_cells);
    let _ = locks[3 * pcount + 1 + q] = base[sb + 2] + 1;
    let q = q + 1;
    0
  };
  let _ = st_parttab_write_p(base, pt_off, sb, locks, pcount, tmp);
  let _ = st_seal(base, pt_off, tmp);
  let _ = st_sb_write_m(base, 512 - sb, base[sb + 2] + 1, pt_off, 1024, 0, 0, 0, tmp);
  pt_off
}

fn st_commit_p(base: [i64], tx: [i64], p: i64, root: i64, locks: [i64], pcount: i64, arena_cells: i64, tmp: [i64], ptdig: i64) -> i64 {
  let _ = st_lock_g(locks, pcount);
  let sb = st_pick(base, tmp);
  let pt = base[sb + 3];
  let q = 0;
  while q < pcount {
    let _ = locks[pcount + 1 + q] = st_parttab_root_p(base, pt, q);
    let _ = locks[2 * pcount + 1 + q] = st_parttab_used_p(base, pt, q);
    let _ = locks[3 * pcount + 1 + q] = st_parttab_gen_p(base, pt, q);
    let q = q + 1;
    0
  };
  let _ = locks[pcount + 1 + p] = root;
  // PartTab in the free tail of its own superblock's page (see st_commit_m).
  let pt_off = (512 - sb) + 16;
  let _ = base[pt_off] = ((ptdig & 4294967295) << 32) | st_parttab_cells(pcount);
  let _ = base[pt_off + 1] = base[sb + 2] + 1;
  let _ = locks[2 * pcount + 1 + p] = tx[2];
  let _ = locks[3 * pcount + 1 + p] = base[sb + 2] + 1;
  let _ = st_parttab_write_p(base, pt_off, sb, locks, pcount, tmp);
  let _ = st_seal(base, pt_off, tmp);
  let other = 512 - sb;
  let new_gen = base[sb + 2] + 1;
  let _ = base[other] = base[sb];
  let _ = base[other + 1] = 1;
  let _ = base[other + 2] = new_gen;
  let _ = base[other + 3] = pt_off;
  let _ = base[other + 4] = tx[2];
  let _ = base[other + 5] = 0;
  let _ = base[other + 6] = 0;
  let _ = base[other + 7] = base[sb + 7];
  let _ = base[other + 8] = base[sb + 8];
  let k = 9;
  while k < 15 {
    let _ = base[other + k] = 0;
    let k = k + 1;
    0
  };
  let _ = base[other + 15] = st_crc(base, other, 15, tmp);
  let _ = st_unlock_g(locks, pcount);
  new_gen
}

// st_commit_2pc(base, txs, roots, locks, pcount, arena_cells, tmp, ptdig):
// cross-partition commit. `txs` holds pcount transactions of 6 cells each (tx q at
// txs[q*6..q*6+5]); `roots[q]` is partition q's NEW root, or 0 to leave that partition
// unchanged. Every participating partition's root, cursor and generation move together
// under ONE global lock and ONE superblock toggle, so a reader sees either all of the
// transaction or none of it.
//
// What was here before (measured 2026-09-12): the function re-read every partition's
// root/used/gen out of the CURRENT PartTab, wrote those same values back, and toggled the
// superblock. It took no roots argument and read nothing from `txs` except partition 0's
// cursor, so it committed NOTHING. A probe that staged a new root in partition 0 and in
// partition 1 and then read both back returned 00 -- neither root moved.
fn st_commit_2pc(base: [i64], txs: [i64], roots: [i64], locks: [i64], pcount: i64, arena_cells: i64, tmp: [i64], ptdig: i64) -> i64 {
  let _ = st_lock_g(locks, pcount);
  let sb = st_pick(base, tmp);
  let pt = base[sb + 3];
  let new_gen = base[sb + 2] + 1;
  // Phase 0 -- VALIDATE the read set (ROADMAP B5: "STM validation of read-sets for
  // cross-partition transactions"). st_begin_p recorded, in tx[5], one past the generation
  // the transaction OBSERVED for its partition. If any participant's generation has moved
  // since, another writer committed underneath this transaction and publishing would lose
  // that writer's work. Abort instead, returning 0, and leave the store untouched; the
  // caller retries. This is what makes the cross-partition path safe without holding every
  // partition's lock for the whole transaction.
  let stale = 0;
  let q = 0;
  while q < pcount {
    let takes = if roots[q] == 0 then 0 else 1;
    let seen = txs[q * 6 + 5] - 1;
    let now = st_parttab_gen_p(base, pt, q);
    let stale = stale + takes * (if now == seen then 0 else 1);
    let q = q + 1;
    0
  };
  let _ = if stale > 0 then st_unlock_g(locks, pcount) else 0;
  if stale > 0 then 0 else st_commit_2pc_go(base, txs, roots, locks, pcount, arena_cells, tmp, ptdig, sb, pt, new_gen)
}

// st_commit_2pc_go: the publish half, reached only when the read set validated.
fn st_commit_2pc_go(base: [i64], txs: [i64], roots: [i64], locks: [i64], pcount: i64, arena_cells: i64, tmp: [i64], ptdig: i64, sb: i64, pt: i64, new_gen: i64) -> i64 {
  // Phase 1 -- collect: start from the committed state, then overlay each participant.
  let q = 0;
  while q < pcount {
    let _ = locks[pcount + 1 + q] = st_parttab_root_p(base, pt, q);
    let _ = locks[2 * pcount + 1 + q] = st_parttab_used_p(base, pt, q);
    let _ = locks[3 * pcount + 1 + q] = st_parttab_gen_p(base, pt, q);
    let q = q + 1;
    0
  };
  let q = 0;
  while q < pcount {
    let takes = if roots[q] == 0 then 0 else 1;
    let _ = if takes == 1 then (let _ = locks[pcount + 1 + q] = roots[q] in 0) else 0;
    let _ = if takes == 1 then (let _ = locks[2 * pcount + 1 + q] = txs[q * 6 + 2] in 0) else 0;
    let _ = if takes == 1 then (let _ = locks[3 * pcount + 1 + q] = new_gen in 0) else 0;
    let q = q + 1;
    0
  };
  // Phase 2 -- publish: one PartTab carrying every participant's new state, then one
  // superblock toggle. The PartTab is allocated in the LOWEST PARTICIPATING partition, not
  // in partition 0: a transaction between partitions 1 and 2 leaves partition 0's tx slot
  // untouched, so txs[0*6+2] is 0 and the PartTab would be written at offset 0, straight
  // over the superblock. Measured 2026-09-12: a 1+2 cross-partition commit returned 00,
  // neither root committed, until the home partition was taken from `roots`.
  let home = 0 - 1;
  let q = pcount - 1;
  while q >= 0 {
    let home = if roots[q] == 0 then home else q;
    let q = q - 1;
    0
  };
  let th = st_cells(st_addr(txs) + home * 6);
  // PartTab in the free tail of its own superblock's page (see st_commit_m).
  let pt_off = (512 - sb) + 16;
  let _ = base[pt_off] = ((ptdig & 4294967295) << 32) | st_parttab_cells(pcount);
  let _ = base[pt_off + 1] = new_gen;
  let _ = locks[2 * pcount + 1 + home] = th[2];
  let _ = st_parttab_write_p(base, pt_off, sb, locks, pcount, tmp);
  let _ = st_seal(base, pt_off, tmp);
  let other = 512 - sb;
  let _ = base[other] = base[sb];
  let _ = base[other + 1] = 1;
  let _ = base[other + 2] = new_gen;
  let _ = base[other + 3] = pt_off;
  let _ = base[other + 4] = th[2];
  let _ = base[other + 5] = 0;
  let _ = base[other + 6] = 0;
  let _ = base[other + 7] = base[sb + 7];
  let _ = base[other + 8] = base[sb + 8];
  let k = 9;
  while k < 15 {
    let _ = base[other + k] = 0;
    let k = k + 1;
    0
  };
  let _ = base[other + 15] = st_crc(base, other, 15, tmp);
  let _ = sys_msync(st_addr(base), 8192, 4);
  let _ = st_unlock_g(locks, pcount);
  new_gen
}

fn st_mig(base: [i64], tmp: [i64]) -> i64 { base[st_pick(base, tmp) + 6] }
// st_snapshot(base, snap, tmp): copy the live superblock into snap (16 cells) and
// validate the crc on the COPY -- a reader racing a writer's superblock toggle sees
// either a whole superblock or a torn one that fails its crc (then the other is
// tried). Returns the superblock index taken, -1 if neither copy validated.
//
// B5 step 1: this function copies ONLY the superblock (32 cells: two copies).
// The PartTab copy is done by st_snapshot_pt, which requires a 51-cell snap buffer
// (32 superblock + 19 PartTab). Old callers (G5/G6/G7/G8) keep using st_snapshot
// with zeros(32) — their behaviour is byte-identical. New B5 code uses
// st_snapshot_pt to get the PartTab too.
fn st_snapshot(base: [i64], snap: [i64], tmp: [i64]) -> i64 {
  let k = 0;
  while k < 32 {
    let _ = snap[k] = base[(k / 16) * 512 + k % 16];
    let k = k + 1;
    0
  };
  let va = if snap[0] == st_magic() then (if snap[15] == st_crc(snap, 0, 15, tmp) then 1 else 0) else 0;
  let vb = if snap[16] == st_magic() then (if snap[31] == st_crc(snap, 16, 15, tmp) then 1 else 0) else 0;
  let pick = if va + vb == 2 then (if snap[18] > snap[2] then 512 else 0) else if va == 1 then 0 else if vb == 1 then 512 else 0 - 1;
  let j = 0;
  while j < 16 * (if pick == 512 then 1 else 0) {
    let _ = snap[j] = snap[16 + j];
    let j = j + 1;
    0
  };
  pick
}

// st_snapshot_pt(base, snap, tmp): full snapshot including PartTab (B5 step 1).
// snap must have at least 51 cells: 32 for two superblock copies, 19 for the
// PartTab (P=1). Copies the live superblock (as st_snapshot), then copies the
// live PartTab (from the root cell) into snap[32..50] and validates its crc
// (cell 15 of PartTab = snap[47], crc over 19 cells starting at snap[32]).
// If the PartTab crc fails, the superblock copy is invalidated (snap[0] = 0)
// so the caller retries. Returns the superblock index taken.
fn st_snapshot_pt(base: [i64], snap: [i64], tmp: [i64]) -> i64 {
  let pick = st_snapshot(base, snap, tmp);
  let pt = snap[3];
  // Copy PartTab cells 0..18 into snap[32..50] when pt != 0.
  // When pt == 0, the loop bound is 0 so nothing is copied.
  let q = 0;
  while q < (if pt == 0 then 0 else 19) {
    let _ = snap[32 + q] = base[pt + q];
    let q = q + 1;
    0
  };
  // Validate PartTab crc on the copy when pt != 0; invalidate snapshot on failure.
  let _ = if pt != 0 then (
    if snap[47] != st_crc(snap, 32, 19, tmp) then snap[0] = 0 else 0
  ) else 0;
  // If snapshot was invalidated, return -1.
  if pick < 0 then pick else (
    if snap[0] == st_magic() then pick else 0 - 1
  )
}
// st_sync(base, nbytes): msync(MS_SYNC = 4) the first nbytes of the mapping (T110) — the
// durable-commit row: call it on the appended range before st_commit and on the
// superblock pages after (process-crash consistency never needs it, §4g).
fn st_sync(base: [i64], nbytes: i64) -> i64 {
  sys_msync(st_addr(base), nbytes, 4)
}
// st_commit_sync: msync the pages appended by this transaction [mark, cursor), toggle
// the superblock, msync pages 0-1 (msync of the whole arena cost 444 us per commit).
fn st_commit_sync(base: [i64], tx: [i64], root: i64, tmp: [i64]) -> i64 {
  let lo = (tx[1] * 8) - (tx[1] * 8) % 4096;
  let _ = sys_msync(st_addr(base) + lo, tx[2] * 8 - lo, 4);
  let g = st_commit(base, tx, root, tmp);
  let _ = st_sync(base, 8192);
  g
}
// st_commit_batch(base, tx, first_mark, tmp): group commit (B1 blueprint section 3). The
// caller runs N sub-transactions each committed with plain `st_commit` (no per-commit
// sync -- st_begin picks the live sb and toggles it every time, so N commits alternate
// slots and each one's root/gen/cursor is durable-ORDERED but not yet msync'ed), then
// calls this ONCE: msync the union of every page appended across the whole batch
// (`first_mark` = tx[1] right after the batch's FIRST st_begin, before any allocation --
// tx[1] itself only holds the LAST sub-transaction's mark by the time this runs), THEN
// msync both superblock pages (8192 bytes, same as st_commit_sync). Correctness: nothing
// in the batch is durable until this one grouped msync of the superblock pages returns,
// so a crash mid-batch can only ever reveal the pre-batch generation (self-consistent,
// same guarantee st_commit_sync gives one commit at a time) -- never a torn mix of the
// batch's N sub-commits, because none of their superblock writes were individually
// synced (blueprint section 8: "group commit hides a torn middle transaction" -- it
// can't, because "hidden" here means "not yet published to a crash image at all").
fn st_commit_batch(base: [i64], tx: [i64], first_mark: i64, tmp: [i64]) -> i64 {
  let lo = (first_mark * 8) - (first_mark * 8) % 4096;
  let _ = sys_msync(st_addr(base) + lo, tx[2] * 8 - lo, 4);
  st_sync(base, 8192)
}
fn st_abort(tx: [i64]) -> i64 {
  let _ = tx[2] = tx[1];
  let _ = tx[3] = 0;
  let _ = tx[4] = 0;
  0
}
fn st_root(base: [i64], tmp: [i64]) -> i64 {
  let sb = st_pick(base, tmp);
  let pt = base[sb + 3];
  st_parttab_root(base, pt)
}
fn st_gen(base: [i64], tmp: [i64]) -> i64 { base[st_pick(base, tmp) + 2] }
fn st_get(base: [i64], obj: i64, i: i64) -> i64 { base[obj + 2 + i] }
fn st_put(base: [i64], obj: i64, i: i64, v: i64) -> i64 {
  let _ = base[obj + 2 + i] = v;
  v
}
// st_ref(base, obj, i): deref field i of obj (an object-relative offset) -> target offset.
fn st_ref(base: [i64], obj: i64, i: i64) -> i64 { obj + base[obj + 2 + i] }
fn st_link(base: [i64], obj: i64, i: i64, target: i64) -> i64 {
  let _ = base[obj + 2 + i] = target - obj;
  target - obj
}
// st_digest(s): layout digest of a types-only layout string, low 32 bits of sha256.
fn st_digest(s: str) -> i64 {
  let b = zeros(256);
  let n = st_str(b, s);
  sha256_lo64(b, n) & 4294967295
}
// ---- C3: commit chain (superblock cell 10), heads table (cell 11), st_open_at(gen) ----
// "Memory as Git" is ALREADY this store's design (append-only arena, two superblocks,
// root swap, CoW MVCC with a `prev` edge, Cheney compaction, the mapping itself as the
// reader token). This block closes the three gaps only: the superblock kept generation g
// and g-1 alone, so "check out generation k" was not expressible for the store as a
// whole; there was one unnamed root; and a reader could take the live root or nothing.
// Reader registration is deliberately NOT here -- the kernel's inode refcount already
// releases a reader's mapping -- and there is no undo log, no redo log and no reader
// table to make MVCC expensive (docs/blueprints/C3-commit-chain-and-heads.md:24-28).
// Cell ORDER: B1's follow-up card claims cell 9 for its `anc` verification anchor
// (docs/blueprints/B1-durability-torn-write.md:146,163), so C3 starts at 10. Cells 9,
// 12, 13 and 14 stay zero.
//   cell 10 = `commit` : offset of the live generation's commit OBJECT.
//   cell 11 = `heads`  : offset of the heads table, 0 = one unnamed head (today).
// Commit object C: payload [gen, ref root, ref prev_commit] (3 cells), refmask 6.
// Heads table  H: payload [ref C x 8 | name x 8] (16 cells), refmask 255 -- FIXED width
// so the table is ONE object with a CONSTANT refmask under st_compact's layout rules (a
// mask is per-digest, so a variable-length name/ref interleave has no legal mask); an
// empty slot holds ref 0 and `name` is an st_digest of the branch name. 8 branches cap.
// Both cells are ZERO in every store written by plain st_commit/st_commit_m, so this row
// changes no existing store's bytes, and it adds nothing to the open path: st_open,
// st_pick, st_verify and st_reopen_verify are UNCHANGED and never read cell 10 or 11 --
// the chain is written, never read, on the hot path.
fn st_sb_write_ch(base: [i64], sb: i64, com: i64, heads: i64, tmp: [i64]) -> i64 {
  let _ = base[sb + 10] = com;
  let _ = base[sb + 11] = heads;
  let _ = base[sb + 15] = st_crc(base, sb, 15, tmp);
  0
}
// st_cobj(base, tx, root, cdig, tmp): append this transaction's commit object, chained to
// the live superblock's commit (cell 10). Sealed like any other object, so st_verify and
// st_check cover it and a torn commit object is caught at reopen exactly like a torn node.
fn st_cobj(base: [i64], tx: [i64], root: i64, cdig: i64, tmp: [i64]) -> i64 {
  let p = base[tx[0] + 10];
  let c = st_alloc(base, tx, 3, cdig);
  let _ = st_put(base, c, 0, tx[5]);
  let _ = if root == 0 then st_put(base, c, 1, 0) else st_link(base, c, 1, root);
  let _ = if p == 0 then st_put(base, c, 2, 0) else st_link(base, c, 2, p);
  let _ = st_seal(base, c, tmp);
  c
}
// st_publish(base, tx, root, c, heads, tmp): st_commit, then stamp cells 10/11 into the
// superblock that commit just wrote and re-seal its crc (cell 15) LAST. Crash windows:
// before the stamp -> a valid superblock whose cell 10 is 0 (st_sb_write_m zeroes 9..14),
// i.e. the new generation is live with no chain entry; between the stamp and the crc ->
// that superblock fails its own crc, st_pick skips it and the PREVIOUS generation stays
// live. Neither state is torn, so this is never worse than a plain st_commit.
fn st_publish(base: [i64], tx: [i64], root: i64, c: i64, heads: i64, tmp: [i64]) -> i64 {
  let sb = tx[0];
  let _ = st_commit(base, tx, root, tmp);
  let _ = st_sb_write_ch(base, 512 - sb, c, heads, tmp);
  tx[5]
}
// st_commit_c: commit + chain, heads table carried over unchanged.
fn st_commit_c(base: [i64], tx: [i64], root: i64, cdig: i64, tmp: [i64]) -> i64 {
  let c = st_cobj(base, tx, root, cdig, tmp);
  let h = base[tx[0] + 11];
  st_publish(base, tx, root, c, h, tmp)
}
// st_head_slot(base, heads, name): the slot already holding `name`, else the first free
// slot, else -1 (all 8 branches used). heads == 0 -> slot 0.
fn st_head_slot(base: [i64], heads: i64, name: i64) -> i64 {
  let i = 0;
  let hit = 0 - 1;
  let fre = 0 - 1;
  while i < 8 {
    let r = if heads == 0 then 0 else st_get(base, heads, i);
    let nm = if heads == 0 then 0 else st_get(base, heads, 8 + i);
    let same = if r == 0 then 0 else (if nm == name then 1 else 0);
    let hit = if same == 1 then i else hit;
    let emp = if r == 0 then (if fre < 0 then 1 else 0) else 0;
    let fre = if emp == 1 then i else fre;
    let i = i + 1;
    0
  };
  if hit >= 0 then hit else fre
}
// st_heads_set(base, tx, old, slot, name, c, hdig, tmp): append a NEW heads table (CoW,
// like every other object here) = `old` with `slot` repointed at commit c under `name`.
// Returns its offset; hand it to st_publish. old == 0 starts an empty table.
fn st_heads_set(base: [i64], tx: [i64], old: i64, slot: i64, name: i64, c: i64, hdig: i64, tmp: [i64]) -> i64 {
  let h = st_alloc(base, tx, 16, hdig);
  let i = 0;
  while i < 8 {
    let r = if old == 0 then 0 else st_get(base, old, i);
    let e = if r == 0 then 0 else st_ref(base, old, i);
    let t = if i == slot then c else e;
    let _ = if t == 0 then st_put(base, h, i, 0) else st_link(base, h, i, t);
    let nm = if old == 0 then 0 else st_get(base, old, 8 + i);
    let nv = if i == slot then name else nm;
    let _ = st_put(base, h, 8 + i, nv);
    let i = i + 1;
    0
  };
  let _ = st_seal(base, h, tmp);
  h
}
// st_head(base, name, tmp): the commit object the named head points at, 0 if absent.
fn st_head(base: [i64], name: i64, tmp: [i64]) -> i64 {
  let h = base[st_pick(base, tmp) + 11];
  let s = st_head_slot(base, h, name);
  let ok = if h == 0 then 0 else (if s < 0 then 0 else (if st_get(base, h, s) == 0 then 0 else 1));
  if ok == 1 then st_ref(base, h, s) else 0
}
// st_commit_head(base, tmp): the live generation's commit object (cell 10), 0 = no chain.
fn st_commit_head(base: [i64], tmp: [i64]) -> i64 { base[st_pick(base, tmp) + 10] }
// st_croot(base, c): the root a commit object points at (0 = null commit or null root).
fn st_croot(base: [i64], c: i64) -> i64 {
  let r = if c == 0 then 0 else st_get(base, c, 1);
  if r == 0 then 0 else st_ref(base, c, 1)
}
// st_commit_at(base, c, gen): walk the chain back from commit c to generation `gen`; 0 if
// the chain does not reach it. `cur` never becomes 0 INSIDE the loop on purpose: stepping
// onto 0 and then reading st_get(base, 0, 0) would read superblock A's cell 2, which IS a
// generation number and would match by accident.
fn st_commit_at(base: [i64], c: i64, gen: i64) -> i64 {
  let cur = c;
  let go = if c == 0 then 0 else 1;
  while go == 1 {
    let g = st_get(base, cur, 0);
    let p = st_get(base, cur, 2);
    let hit = if g == gen then 1 else 0;
    let nxt = if p == 0 then 0 else st_ref(base, cur, 2);
    let step = (1 - hit) * (if nxt == 0 then 0 else 1);
    let cur = if step == 1 then nxt else cur;
    let go = step;
    0
  };
  let g = if c == 0 then 0 - 1 else st_get(base, cur, 0);
  cur * (if g == gen then 1 else 0)
}
// st_open_at(base, gen, tmp): the ROOT of generation `gen`, reached by walking the commit
// chain back from the live commit. 0 when the chain does not reach that generation --
// never written, or dropped by a compaction that no head protected. O(commits walked):
// the honest cost of a linked list, and the reason a heads table exists at all.
fn st_open_at(base: [i64], gen: i64, tmp: [i64]) -> i64 {
  let c = st_commit_at(base, base[st_pick(base, tmp) + 10], gen);
  st_croot(base, c)
}
// st_sever(old, c, h): zero the `prev` cell (payload cell 2 = old[c + 4]) of the live
// commit and of every commit a head names, in st_compact's MAP_PRIVATE view of the OLD
// file only (CoW; the old inode is never modified, same channel the forwarding pointers
// already use). Compaction therefore retains exactly the commits a head names plus the
// live one and drops the history behind them: keeping every ancestor would pin every
// generation forever and compaction would free nothing at all
// (docs/RESEARCH-BYOK-ECS-DATAFLOW-2026-09-08.md:272). The severed 0 is a null ref, so
// st_compact's scan does not follow it, and the crc the scan recomputes over the copy
// covers the severed payload.
fn st_sever(old: [i64], c: i64, h: i64) -> i64 {
  let _ = if c == 0 then 0 else (let _ = old[c + 4] = 0 in 0);
  let i = 0;
  while i < 8 {
    let r = if h == 0 then 0 else st_get(old, h, i);
    let e = if r == 0 then 0 else st_ref(old, h, i);
    let _ = if e == 0 then 0 else (let _ = old[e + 4] = 0 in 0);
    let i = i + 1;
    0
  };
  0
}
// ---- compaction = Cheney copy into <store>.tmp + rename (T113, §4e) ----
// lay = [digest32, refmask] pairs (nlay pairs): bit i of refmask = payload cell i is
// a ref; refmask -1 = a ref ARRAY (cell 0 = count, cells 1.. are refs). Forwarding is
// written into the OLD file's MAP_PRIVATE view (h0 := 0, payload cell 0 := new
// offset; CoW pages vanish at munmap, the old inode is never modified), so every
// object must have >= 1 payload cell (exit 84 otherwise). While an object waits in
// the new arena its h1 holds (old_offset << 32 | generation); the scan rewrites its
// refs, recomputes the crc and restores h1 = crc << 32 | generation.
fn st_refmask(lay: [i64], nlay: i64, digest: i64) -> i64 {
  let i = 0;
  let m = 0;
  while i < nlay {
    let m = if lay[i * 2] == digest then lay[i * 2 + 1] else m;
    let i = i + 1;
    0
  };
  m
}
fn st_copy_obj(old: [i64], new: [i64], cur: [i64], o: i64) -> i64 {
  let len = st_len(old, o);
  let _ = if len < 1 then sys_exit(84) else 0;
  let at = cur[0];
  let _ = new[at] = old[o];
  let _ = new[at + 1] = (o << 32) | (old[o + 1] & 4294967295);
  let i = 0;
  while i < len {
    let _ = new[at + 2 + i] = old[o + 2 + i];
    let i = i + 1;
    0
  };
  let _ = old[o] = 0;
  let _ = old[o + 2] = at;
  let _ = cur[0] = at + 2 + len;
  at
}
// st_forward(old, new, cur, o): the new offset of old object o, copying it on demand.
fn st_forward(old: [i64], new: [i64], cur: [i64], o: i64) -> i64 {
  if old[o] == 0 then old[o + 2] else st_copy_obj(old, new, cur, o)
}
// Fsync the directory that holds `path` (B1 step 1). The `sys_rename` at the end of
// `st_compact` publishes the compacted store by name; the NAME lives in the directory's inode block, so
// only an fsync of the DIRECTORY fd makes the publish survive a power cut --
// fsyncing the file itself flushes data, never the parent's entry. dlen = one
// past the last '/', so "/a/b" -> "/a/" and "a/b" -> "a/"; no '/' at all -> ".".
// The fd is closed on every path (fsync/close of a negative fd are harmless
// EBADF no-ops, so an sys_open failure leaks nothing). Returns the fsync result.
fn st_fsync_dir(path: [i64], plen: i64) -> i64 {
  let dpath = zeros(plen + 2);
  let dlen = 0;
  let i = 0;
  while i < plen {
    let dlen = if path[i] == 47 then i + 1 else dlen;
    let i = i + 1;
    0
  };
  let j = 0;
  while j < dlen {
    let _ = dpath[j] = path[j];
    let j = j + 1;
    0
  };
  let _ = if dlen == 0 then (let _ = dpath[0] = 46 in 0) else 0;
  let n = if dlen == 0 then 1 else dlen;
  let dfd = sys_open(dpath, n, 0);
  let rc = sys_fsync(dfd);
  let _ = sys_close(dfd);
  rc
}

fn st_compact(path: [i64], plen: i64, size: i64, lay: [i64], nlay: i64, tmp: [i64]) -> i64 {
  let fd = sys_open(path, plen, 0);
  let old = st_cells(sys_mmap(0, size, 3, 2, fd, 0));
  let _ = sys_close(fd);
  let sb = st_pick(old, tmp);
  let pt0 = old[sb + 3];
  let is_pt = if pt0 == 0 then 0 else (if (old[pt0] >> 32) == st_digest("PartTab") then 1 else 0);
  let root = if is_pt == 1 then st_parttab_root(old, pt0) else pt0;
  let gen = old[sb + 2];
  let mig = old[sb + 6];
  let com = old[sb + 10];
  let hds = old[sb + 11];
  let _ = st_sever(old, com, hds);
  let tp = zeros(plen + 5);
  let i = 0;
  while i < plen {
    let _ = tp[i] = path[i];
    let i = i + 1;
    0
  };
  let _ = tp[plen] = 46;
  let _ = tp[plen + 1] = 116;
  let _ = tp[plen + 2] = 109;
  let _ = tp[plen + 3] = 112;
  let nfd = sys_open(tp, plen + 4, 578);
  let _ = sys_ftruncate(nfd, size);
  let new = st_cells(sys_mmap(0, size, 3, 1, nfd, 0));
  let cur = [1024];
  let nroot = if root == 0 then 0 else st_copy_obj(old, new, cur, root);
  let nmig = if mig == 0 then 0 else st_copy_obj(old, new, cur, mig);
  let ncom = if com == 0 then 0 else st_copy_obj(old, new, cur, com);
  let nhds = if hds == 0 then 0 else st_copy_obj(old, new, cur, hds);
  let scan = 1024;
  while scan < cur[0] {
    let len = st_len(new, scan);
    let oself = new[scan + 1] >> 32;
    let g = new[scan + 1] & 4294967295;
    let mask = st_refmask(lay, nlay, new[scan] >> 32);
    let i = if mask == 0 - 1 then 1 else 0;
    let stop = len;
    while i < stop {
      let isref = if mask == 0 - 1 then 1 else (mask >> i) & 1;
      let rel = new[scan + 2 + i];
      let live = isref * (if rel == 0 then 0 else 1) * (if i < len then 1 else 0);
      let _ = if live == 1 then (let _ = new[scan + 2 + i] = st_forward(old, new, cur, oself + rel) - scan in 0) else 0;
      let i = i + 1;
      0
    };
    let crc = st_crc(new, scan + 2, len, tmp);
    let _ = new[scan + 1] = (crc << 32) | g;
    let scan = scan + 2 + len;
    0
  };
  // B5 step 1 put a PartTab's offset in superblock cell 3, not the root's. The old
  // PartTab must NOT be copied verbatim: its root_p is an offset into the OLD file, and
  // st_refmask returns 0 for a digest absent from the layout table, so the relocation
  // loop never touches it (measured 2026-09-12: root_p came back 21077, out of bounds in
  // the compacted file, and st_len on it trapped 82). Write a FRESH PartTab describing
  // the compacted file instead, the way st_commit_m does. It is appended AFTER the scan
  // loop, so its own cells are never walked by the relocation pass.
  let live = cur[0] - 1024;
  let _ = st_sb_write_m(new, 0, gen + 1, 16, cur[0], live, 0, nmig, tmp);
  let npt = 16;
  let _ = new[npt] = ((st_digest("PartTab") & 4294967295) << 32) | st_parttab_cells(1);
  let _ = new[npt + 1] = gen + 1;
  let _ = st_parttab_write(new, npt, 0, gen + 1, nroot, cur[0], tmp);
  let _ = st_seal(new, npt, tmp);

  let _ = st_sb_write_ch(new, 0, ncom, nhds, tmp);
  let k = 512;
  while k < 528 {
    let _ = new[k] = 0;
    let k = k + 1;
    0
  };
  let _ = sys_munmap(st_addr(new), size);
  let _ = sys_ftruncate(nfd, cur[0] * 8);
  let _ = sys_close(nfd);
  let _ = sys_munmap(st_addr(old), size);
  let _ = sys_rename(tp, plen + 4, path, plen);
  let _ = st_fsync_dir(path, plen);
  live
}
