// selfhost/glyph.bp — Bebop glyph encoder (self-host module #6)
// Encodes δ-outline pen moves for the glyphic surface.
module core { }

fn pen_dx(c: i64) -> i64 {
  let d0 = if c == 0 then 0 else 0;
  let d1 = if c == 1 then 1 else 0;
  let d2 = if c == 2 then 0 else 0;
  let d3 = if c == 3 then -1 else 0;
  let d4 = if c == 4 then 1 else 0;
  let d5 = if c == 5 then 2 else 0;
  d0 + d1 + d2 + d3 + d4 + d5
}

fn pen_dy(c: i64) -> i64 {
  let d0 = if c == 0 then 2 else 0;
  let d1 = if c == 1 then 1 else 0;
  let d2 = if c == 2 then 1 else 0;
  let d3 = if c == 3 then 1 else 0;
  let d4 = if c == 4 then -1 else 0;
  let d5 = if c == 5 then -1 else 0;
  d0 + d1 + d2 + d3 + d4 + d5
}

fn glyph_outline(id: i64) -> i64 { id }